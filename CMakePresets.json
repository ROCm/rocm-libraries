{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 2
    },
    "configurePresets": [
        {
            "name": "opt-rocm:all",
            "displayName": "Release build (all libraries)",
            "description": "Standard release build for all libraries",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "/opt/rocm/bin/amdclang++",
                "CMAKE_C_COMPILER": "/opt/rocm/bin/amdclang",
                "CMAKE_PREFIX_PATH": "/opt/rocm",
                "CMAKE_INSTALL_PREFIX": "/opt/rocm"
            },
            "environment": {
                "ROCM_PATH": "/opt/rocm"
            }
        },
        {
            "name": "rocroller",
            "inherits": ["opt-rocm:all"],
            "cacheVariables": {
                "ROCM_LIBRARIES_DISABLE_ALL": "ON",
                "ENABLE_MXDATAGENERATOR": "ON",
                "ENABLE_ROCROLLER": "ON"
            }
        },
        {
            "name": "rocprim",
            "inherits": ["opt-rocm:all"],
            "cacheVariables": {
                "ROCM_LIBRARIES_DISABLE_ALL": "ON",
                "ENABLE_ROCPRIM": "ON"
            }
        },
        {
            "name": "rocrand",
            "inherits": ["opt-rocm:all"],
            "cacheVariables": {
                "ROCM_LIBRARIES_DISABLE_ALL": "ON",
                "ENABLE_ROCRAND": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "displayName": "Build (Release) default GPU",
            "description": "Build using the opt-rocm:all configure preset",
            "configurePreset": "opt-rocm:all"
        }
    ]
}