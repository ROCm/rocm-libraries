#   rocke_pack_out/    -> rocke_build/build_rocke_attention_pack.sh (from rocke_pack_src/)
#   app/build/         -> cmake + ninja on app/CMakeLists.txt

# compiled flyDSL kernels
*.hsaco
*.o
*.so
# rocKE packed kernel tree (binary .kpack + generated descriptors) — regenerate from rocke_pack_src/
