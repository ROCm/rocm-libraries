# flyDSL POC scratch — track SOURCE only, never binaries/artifacts.
# Kernel binaries (regenerated by compiling the .py kernel sources with flyDSL).
*.hsaco
*.o
*.so
# Compiled host harnesses (built from the .cpp sources checked in here).
run_hsaco
run_rmsnorm
# CMake / ninja build trees.
app/build/
build/
# flyDSL compiler IR dumps (regenerated on demand from the kernel sources).
ir_dump/
ir_rms/
module_dump.mlir
# Python + logs.
__pycache__/
*.pyc
*.log
