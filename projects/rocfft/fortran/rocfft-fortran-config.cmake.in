# Config package for the rocFFT Fortran bindings.
#
#   find_package(rocfft-fortran REQUIRED)
#   target_link_libraries(my_app PRIVATE roc::rocfft_fortran)
#
# One archive and .mod set is installed per Fortran compiler. Set
# ROCFFT_FORTRAN_COMPILER_DIR before find_package to pick one explicitly.

@PACKAGE_INIT@

set(_rocfft_built_dir "@ROCFFT_FORTRAN_COMPILER_DIR@")

# Absolute, relocatable paths written by PATH_VARS (see PACKAGE_INIT above).
set(_rocfft_libdir "@PACKAGE_ROCFFT_FORTRAN_LIBDIR@")
set(_rocfft_incdir "@PACKAGE_ROCFFT_FORTRAN_INCLUDEDIR@")

set(rocfft_FORTRAN_FOUND FALSE)

if(NOT CMAKE_Fortran_COMPILER_LOADED)
  set(rocfft-fortran_FOUND FALSE)
  string(CONCAT rocfft-fortran_NOT_FOUND_MESSAGE
      "The rocFFT Fortran bindings need Fortran enabled before find_package: "
      "add Fortran to your project() languages, or call enable_language(Fortran).")
  return()
endif()

# Accepts FC itself or FC plus a separator and suffix (gfortran-13). Not a regex:
# FC may be an arbitrary basename, and CMake has no regex-escape.
function(_rocfft_dir_matches DIR FC OUT)
  set(${OUT} FALSE PARENT_SCOPE)
  if(DIR STREQUAL FC)
    set(${OUT} TRUE PARENT_SCOPE)
    return()
  endif()
  string(LENGTH "${FC}" _n)
  string(LENGTH "${DIR}" _dn)
  if(_dn GREATER _n)
    string(SUBSTRING "${DIR}" 0 ${_n} _head)
    string(SUBSTRING "${DIR}" ${_n} 1 _sep)
    if(_head STREQUAL FC AND _sep MATCHES "^[-._]$")
      set(${OUT} TRUE PARENT_SCOPE)
    endif()
  endif()
endfunction()

file(GLOB _rocfft_avail RELATIVE "${_rocfft_incdir}" "${_rocfft_incdir}/*")

set(_rocfft_dir "")
if(DEFINED ROCFFT_FORTRAN_COMPILER_DIR)
  if(NOT EXISTS "${_rocfft_incdir}/${ROCFFT_FORTRAN_COMPILER_DIR}/rocfft.mod" OR
     NOT EXISTS "${_rocfft_libdir}/${ROCFFT_FORTRAN_COMPILER_DIR}/librocfft_fortran.a")
    set(rocfft-fortran_FOUND FALSE)
    string(CONCAT rocfft-fortran_NOT_FOUND_MESSAGE
        "ROCFFT_FORTRAN_COMPILER_DIR is '${ROCFFT_FORTRAN_COMPILER_DIR}', but "
        "no rocfft.mod and librocfft_fortran.a are installed under "
        "${_rocfft_incdir}/${ROCFFT_FORTRAN_COMPILER_DIR} and "
        "${_rocfft_libdir}/${ROCFFT_FORTRAN_COMPILER_DIR}. Available: "
        "${_rocfft_avail}.")
    return()
  endif()
  set(_rocfft_dir "${ROCFFT_FORTRAN_COMPILER_DIR}")
else()
  # Must mirror the mapping in projects/rocfft/fortran/CMakeLists.txt.
  if(CMAKE_Fortran_COMPILER_ID STREQUAL "GNU")
    set(_rocfft_fc "gfortran")
  elseif(CMAKE_Fortran_COMPILER_ID MATCHES "Flang")
    set(_rocfft_fc "amdflang")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Cray")
    set(_rocfft_fc "ftn")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "IntelLLVM")
    set(_rocfft_fc "ifx")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Intel")
    set(_rocfft_fc "ifort")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "NVHPC")
    set(_rocfft_fc "nvfortran")
  else()
    get_filename_component(_rocfft_fc "${CMAKE_Fortran_COMPILER}" NAME_WE)
    string(TOLOWER "${_rocfft_fc}" _rocfft_fc)
  endif()

  # A prefix can hold several compilers' artifacts; the recorded one is a fallback.
  if(EXISTS "${_rocfft_incdir}/${_rocfft_fc}/rocfft.mod")
    set(_rocfft_dir "${_rocfft_fc}")
  else()
    _rocfft_dir_matches("${_rocfft_built_dir}" "${_rocfft_fc}" _rocfft_ok)
    if(_rocfft_ok)
      set(_rocfft_dir "${_rocfft_built_dir}")
    endif()
  endif()

  if(NOT _rocfft_dir)
    set(rocfft-fortran_FOUND FALSE)
    string(CONCAT rocfft-fortran_NOT_FOUND_MESSAGE
        "This project builds with ${_rocfft_fc}, but no rocfft.mod for it is "
        "installed under ${_rocfft_incdir}. Available: "
        "${_rocfft_avail}. A Fortran .mod cannot be shared across compilers; "
        "rebuild the bindings with ${_rocfft_fc}, or set "
        "ROCFFT_FORTRAN_COMPILER_DIR to the directory to use.")
    return()
  endif()
endif()

# Written TRUE only when the archive links roc::rocfft, which must be imported
# before the targets file. hip's config needs C or CXX enabled (FindThreads).
if(@ROCFFT_FORTRAN_NEEDS_C_PACKAGE@)
  if(NOT TARGET roc::rocfft)
    if(NOT CMAKE_C_COMPILER_LOADED AND NOT CMAKE_CXX_COMPILER_LOADED)
      enable_language(C)
    endif()
    include(CMakeFindDependencyMacro)
    find_dependency(rocfft)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/rocfft-fortran-targets.cmake")

# The targets file hardcodes the directory the package was built with.
if(NOT _rocfft_dir STREQUAL "${_rocfft_built_dir}")
  set_target_properties(roc::rocfft_fortran PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_rocfft_incdir}/${_rocfft_dir}")
  get_target_property(_rocfft_cfgs roc::rocfft_fortran IMPORTED_CONFIGURATIONS)
  foreach(_rocfft_c IN LISTS _rocfft_cfgs)
    set_target_properties(roc::rocfft_fortran PROPERTIES
      IMPORTED_LOCATION_${_rocfft_c}
        "${_rocfft_libdir}/${_rocfft_dir}/librocfft_fortran.a")
  endforeach()
endif()

set(rocfft_FORTRAN_FOUND TRUE)

check_required_components(rocfft-fortran)
