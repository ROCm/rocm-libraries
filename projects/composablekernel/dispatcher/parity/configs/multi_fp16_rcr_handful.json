{
    "_comment": "A handful of fp16 rcr configs for T1.2 kernel-name round-trip coverage.",
    "_comment2": "Covers: compv3/compv4/preshufflev2 pipelines, intrawave/interwave schedulers (where valid), padding flags, persistent flag, split_k.",
    "datatype": "fp16",
    "layout": "rcr",
    "gpu_target": "gfx942",
    "block_size": 256,
    "k_block_per_cu": 1,
    "tile_config": {
        "tile_m": {"values": [128, 256]},
        "tile_n": {"values": [128]},
        "tile_k": {"values": [32]},
        "warp_m": {"values": [2, 4]},
        "warp_n": {"values": [1, 2]},
        "warp_k": {"values": [1]},
        "warp_tile_m": {"values": [32]},
        "warp_tile_n": {"values": [32]},
        "warp_tile_k": {"values": [16]}
    },
    "trait_config": {
        "pipeline": {"values": ["compv3", "compv4", "preshufflev2"]},
        "epilogue": {"values": ["default", "cshuffle"]},
        "scheduler": {"values": ["intrawave"]},
        "pad_m": {"values": [false, true]},
        "pad_n": {"values": [false]},
        "pad_k": {"values": [false]},
        "persistent": {"values": [false, true]}
    }
}
