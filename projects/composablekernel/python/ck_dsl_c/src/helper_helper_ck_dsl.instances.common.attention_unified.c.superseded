#include "ckc/helper_helper_ck_dsl.instances.common.attention_unified.h"

#include <math.h>
#include <stdio.h>
#include <string.h>

#include "ckc/helper_ck_dsl.helpers.transforms.h" /* magic div, naive desc     */

/* ===================================================================== leaves */

/* _next_power_of_2(x) = 1 if x<=1 else 1 << (x-1).bit_length(). */
static int ckc__next_power_of_2(int x)
{
    if (x <= 1)
        return 1;
    int bits = 0;
    int v    = x - 1;
    while (v > 0)
    {
        bits++;
        v >>= 1;
    }
    return 1 << bits;
}

static int ckc__ceil_div(int a, int b)
{
    return (a + b - 1) / b;
}

/* _magic_div(b, dividend, divisor): dividend // divisor via CK Tile magic. */
static ckc_value_t* ckc__magic_div(ckc_ir_builder_t* b,
                                   ckc_value_t* dividend,
                                   int divisor)
{
    uint64_t mult = 0;
    int shift     = 0;
    if (!ckc_calculate_magic_numbers(b, divisor, &mult, &shift))
        return NULL;
    return ckc_do_magic_division(b, dividend, mult, shift);
}

/* _magic_div_mod(b, dividend, divisor) -> (quot, rem). */
static void ckc__magic_div_mod(ckc_ir_builder_t* b,
                               ckc_value_t* dividend,
                               int divisor,
                               ckc_value_t** out_quot,
                               ckc_value_t** out_rem)
{
    ckc_value_t* quot = ckc__magic_div(b, dividend, divisor);
    ckc_value_t* rem  = ckc_b_sub(
        b, dividend, ckc_b_mul(b, quot, ckc_b_const_i32(b, divisor)));
    if (out_quot)
        *out_quot = quot;
    if (out_rem)
        *out_rem = rem;
}

/* apply_softcap_log2(b, score_log2, softcap) ported inline (see header). */
static ckc_value_t* ckc__apply_softcap(ckc_ir_builder_t* b,
                                       ckc_value_t* score_log2,
                                       ckc_value_t* softcap)
{
    ckc_value_t* sdiv = ckc_b_fdiv(b, score_log2, softcap);
    ckc_value_t* p1   = ckc_b_exp2(b, sdiv);
    ckc_value_t* p2   = ckc_b_exp2(b, ckc_b_fneg(b, sdiv));
    return ckc_b_fmul(
        b, softcap,
        ckc_b_fmul(b, ckc_b_fsub(b, p1, p2),
                   ckc_b_rcp(b, ckc_b_fadd(b, p1, p2))));
}

/* dtype_ir: "fp16" -> f16, "bf16" -> bf16, else NULL (ValueError). */
static const ckc_type_t* ckc__dtype_ir(const ckc_unified_attention_problem_t* p)
{
    if (p->dtype && strcmp(p->dtype, "fp16") == 0)
        return ckc_f16();
    if (p->dtype && strcmp(p->dtype, "bf16") == 0)
        return ckc_bf16();
    return NULL;
}

/* ----- element-unit descriptors (TensorDescriptor.naive) ----- */

/* _q_descriptor(p): (token, head, dim) over [max_seqlen_q+1, H, D]. */
static ckc_tensor_descriptor_t* ckc__q_descriptor(
    ckc_ir_builder_t* b, const ckc_unified_attention_problem_t* p)
{
    int lengths[3]            = {p->max_seqlen_q + 1, p->num_query_heads, p->head_size};
    const char* coords[3]     = {"token", "head", "dim"};
    return ckc_tensor_descriptor_naive(b, "Q", lengths, 3, NULL, coords, 3);
}

/* _segm_descriptors(p, num_segments): (ml_desc, out_desc). */
static void ckc__segm_descriptors(ckc_ir_builder_t* b,
                                  const ckc_unified_attention_problem_t* p,
                                  int num_segments,
                                  ckc_tensor_descriptor_t** out_ml,
                                  ckc_tensor_descriptor_t** out_out)
{
    int ml_lengths[3]        = {p->max_seqlen_q + 1, p->num_query_heads, num_segments};
    const char* ml_coords[3] = {"token", "head", "seg"};
    int o_lengths[4]         = {p->max_seqlen_q + 1, p->num_query_heads, num_segments,
                                p->head_size};
    const char* o_coords[4]  = {"token", "head", "seg", "dim"};
    *out_ml  = ckc_tensor_descriptor_naive(b, "segm_ml", ml_lengths, 3, NULL,
                                           ml_coords, 3);
    *out_out = ckc_tensor_descriptor_naive(b, "segm_output", o_lengths, 4, NULL,
                                           o_coords, 4);
}

/* PagedKvDescriptor.offset (element units): block_size strides
 *   stride_0 = block_size * num_kv_heads * head_size
 *   stride_1 = num_kv_heads * head_size
 *   stride_2 = head_size
 *   stride_3 = 1
 * offset = physical_block*stride_0 + token_in_block*stride_1
 *          + kv_head*stride_2 + dim. */
static ckc_value_t* ckc__paged_kv_offset(ckc_ir_builder_t* b,
                                         const ckc_unified_attention_problem_t* p,
                                         ckc_value_t* physical_block,
                                         ckc_value_t* token_in_block,
                                         ckc_value_t* kv_head,
                                         ckc_value_t* dim)
{
    int s0 = p->block_size * p->num_kv_heads * p->head_size;
    int s1 = p->num_kv_heads * p->head_size;
    int s2 = p->head_size;
    ckc_value_t* off = ckc_b_mul(b, physical_block, ckc_b_const_i32(b, s0));
    off = ckc_b_add(b, off, ckc_b_mul(b, token_in_block, ckc_b_const_i32(b, s1)));
    off = ckc_b_add(b, off, ckc_b_mul(b, kv_head, ckc_b_const_i32(b, s2)));
    off = ckc_b_add(b, off, dim);
    return off;
}

/* _q_descriptor.offset(token, head, dim) -> linear element offset. */
static ckc_value_t* ckc__q_offset(ckc_ir_builder_t* b,
                                  const ckc_tensor_descriptor_t* q_desc,
                                  ckc_value_t* token,
                                  ckc_value_t* head,
                                  ckc_value_t* dim)
{
    const char* names[3]   = {"token", "head", "dim"};
    ckc_value_t* vals[3]   = {token, head, dim};
    ckc_value_t* offset    = NULL;
    ckc_value_t* valid     = NULL;
    if (!ckc_transforms_descriptor_offset(b, q_desc, names, vals, 3, &offset, &valid))
        return NULL;
    return offset;
}

/* segm ml_desc.offset(token, head, seg). */
static ckc_value_t* ckc__ml_offset(ckc_ir_builder_t* b,
                                   const ckc_tensor_descriptor_t* ml_desc,
                                   ckc_value_t* token,
                                   ckc_value_t* head,
                                   ckc_value_t* seg)
{
    const char* names[3] = {"token", "head", "seg"};
    ckc_value_t* vals[3] = {token, head, seg};
    ckc_value_t* offset  = NULL;
    ckc_value_t* valid   = NULL;
    if (!ckc_transforms_descriptor_offset(b, ml_desc, names, vals, 3, &offset, &valid))
        return NULL;
    return offset;
}

/* segm out_desc.offset(token, head, seg, dim). */
static ckc_value_t* ckc__segout_offset(ckc_ir_builder_t* b,
                                       const ckc_tensor_descriptor_t* out_desc,
                                       ckc_value_t* token,
                                       ckc_value_t* head,
                                       ckc_value_t* seg,
                                       ckc_value_t* dim)
{
    const char* names[4] = {"token", "head", "seg", "dim"};
    ckc_value_t* vals[4] = {token, head, seg, dim};
    ckc_value_t* offset  = NULL;
    ckc_value_t* valid   = NULL;
    if (!ckc_transforms_descriptor_offset(b, out_desc, names, vals, 4, &offset, &valid))
        return NULL;
    return offset;
}

/* ============================================ UnifiedAttentionProblem helpers */

ckc_unified_attention_problem_t ckc_unified_attention_problem_default(void)
{
    ckc_unified_attention_problem_t p;
    memset(&p, 0, sizeof(p));
    p.dtype           = NULL;
    p.q_dtype         = NULL;
    p.sliding_window  = 0;
    p.softcap         = 0.0;
    p.use_sinks       = false;
    p.use_alibi       = false;
    p.use_qq_bias     = false;
    p.use_fp8         = false;
    p.num_sms         = 120;
    p.waves_per_eu    = 0;
    p.waves_per_eu_set = false;
    p.compile_backend = NULL;
    p.num_kv_blocks   = 0;
    return p;
}

int ckc_unified_attention_problem_num_queries_per_kv(
    const ckc_unified_attention_problem_t* p)
{
    if (p == NULL || p->num_kv_heads == 0)
        return -1;
    if (p->num_query_heads % p->num_kv_heads)
        return -1;
    return p->num_query_heads / p->num_kv_heads;
}

bool ckc_unified_attention_problem_all_decode(
    const ckc_unified_attention_problem_t* p)
{
    return p != NULL && p->max_seqlen_q == 1;
}

/* ======================================================= kernel_name helpers */

/* "fp16"/"bf16" -> the manifest io dtype string ("f16"/"bf16"). */
static const char* ckc__io_dtype(const char* dtype)
{
    if (dtype && strcmp(dtype, "fp16") == 0)
        return "f16";
    return "bf16";
}

ckc_status_t ckc_unified_attention_2d_scalar_kernel_name(
    const ckc_unified_attention_problem_t* p,
    const char* name,
    char* out,
    size_t out_cap)
{
    if (p == NULL || out == NULL)
        return CKC_ERR_VALUE;
    const char* prefix = name ? name : "ck_dsl_unified_attention_2d_scalar";

    char qbuf[32], hbuf[32], kvbuf[32], dbuf[32], bbuf[32];
    snprintf(qbuf, sizeof(qbuf), "q%d", p->total_q);
    snprintf(hbuf, sizeof(hbuf), "h%d", p->num_query_heads);
    snprintf(kvbuf, sizeof(kvbuf), "kv%d", p->num_kv_heads);
    snprintf(dbuf, sizeof(dbuf), "d%d", p->head_size);
    snprintf(bbuf, sizeof(bbuf), "b%d", p->block_size);

    const char* parts[6] = {qbuf, hbuf, kvbuf, dbuf, bbuf,
                            p->dtype ? p->dtype : ""};
    /* flags={"sink": use_sinks, "sw": sliding_window>0, "softcap": softcap>0} */
    const char* flag_names[3] = {"sink", "sw", "softcap"};
    int flag_on[3]            = {p->use_sinks ? 1 : 0,
                                 p->sliding_window > 0 ? 1 : 0,
                                 p->softcap > 0.0 ? 1 : 0};
    return ckc_kernel_name_join(prefix, parts, 6, flag_names, flag_on, 3,
                                out, out_cap, NULL);
}

ckc_status_t ckc_unified_attention_3d_scalar_kernel_name(
    const ckc_unified_attention_problem_t* p,
    const char* name,
    int num_segments,
    char* out,
    size_t out_cap)
{
    if (p == NULL || out == NULL)
        return CKC_ERR_VALUE;
    const char* prefix = name ? name : "ck_dsl_unified_attention_3d_scalar";

    char qbuf[32], hbuf[32], kvbuf[32], dbuf[32], bbuf[32], segbuf[32];
    snprintf(qbuf, sizeof(qbuf), "q%d", p->total_q);
    snprintf(hbuf, sizeof(hbuf), "h%d", p->num_query_heads);
    snprintf(kvbuf, sizeof(kvbuf), "kv%d", p->num_kv_heads);
    snprintf(dbuf, sizeof(dbuf), "d%d", p->head_size);
    snprintf(bbuf, sizeof(bbuf), "b%d", p->block_size);
    snprintf(segbuf, sizeof(segbuf), "seg%d", num_segments);

    const char* parts[7] = {qbuf, hbuf, kvbuf, dbuf, bbuf, segbuf,
                            p->dtype ? p->dtype : ""};
    return ckc_kernel_name_join(prefix, parts, 7, NULL, NULL, 0,
                                out, out_cap, NULL);
}

ckc_status_t ckc_unified_attention_reduce_scalar_kernel_name(
    const ckc_unified_attention_problem_t* p,
    const char* name,
    int num_segments,
    char* out,
    size_t out_cap)
{
    if (p == NULL || out == NULL)
        return CKC_ERR_VALUE;
    const char* prefix = name ? name : "ck_dsl_unified_attention_reduce_scalar";

    char qbuf[32], hbuf[32], dbuf[32], segbuf[32];
    snprintf(qbuf, sizeof(qbuf), "q%d", p->total_q);
    snprintf(hbuf, sizeof(hbuf), "h%d", p->num_query_heads);
    snprintf(dbuf, sizeof(dbuf), "d%d", p->head_size);
    snprintf(segbuf, sizeof(segbuf), "seg%d", num_segments);

    const char* parts[5] = {qbuf, hbuf, dbuf, segbuf,
                            p->dtype ? p->dtype : ""};
    return ckc_kernel_name_join(prefix, parts, 5, NULL, NULL, 0,
                                out, out_cap, NULL);
}

/* ================================================================== grids */

void ckc_unified_attention_2d_scalar_grid(
    const ckc_unified_attention_problem_t* p, int out[3])
{
    if (p == NULL || out == NULL)
        return;
    out[0] = p->total_q;
    out[1] = p->num_query_heads;
    out[2] = p->head_size;
}

void ckc_unified_attention_3d_scalar_grid(
    const ckc_unified_attention_problem_t* p, int num_segments, int out[3])
{
    if (p == NULL || out == NULL)
        return;
    out[0] = p->total_q;
    out[1] = p->num_query_heads;
    out[2] = num_segments * p->head_size;
}

void ckc_unified_attention_reduce_scalar_grid(
    const ckc_unified_attention_problem_t* p, int out[3])
{
    if (p == NULL || out == NULL)
        return;
    out[0] = p->total_q;
    out[1] = p->num_query_heads;
    out[2] = p->head_size;
}

/* ============================================================= signature */

/* _attn_signature(dtype, include_bt_stride=False) -- the 2D scalar ABI. */
ckc_status_t ckc_unified_attention_2d_scalar_signature(
    const ckc_unified_attention_problem_t* p,
    ckc_arena_t* arena,
    const ckc_sig_entry_t** out_items,
    size_t* out_count)
{
    if (p == NULL || arena == NULL || out_items == NULL || out_count == NULL)
        return CKC_ERR_VALUE;
    const char* io = ckc__io_dtype(p->dtype);

    ckc_signature_builder_t sb;
    ckc_status_t st = ckc_signature_builder_init(&sb, arena);
    if (st != CKC_OK)
        return st;

    ckc_signature_builder_ptr(&sb, "output_ptr", io, NULL);
    ckc_signature_builder_ptr(&sb, "query_ptr", io, NULL);
    ckc_signature_builder_ptr(&sb, "key_cache_ptr", io, NULL);
    ckc_signature_builder_ptr(&sb, "value_cache_ptr", io, NULL);
    ckc_signature_builder_ptr(&sb, "sink_ptr", io, NULL);
    ckc_signature_builder_ptr(&sb, "block_tables_ptr", "i32", NULL);
    ckc_signature_builder_ptr(&sb, "seq_lens_ptr", "i32", NULL);
    ckc_signature_builder_ptr(&sb, "alibi_slopes_ptr", "f32", NULL);
    ckc_signature_builder_ptr(&sb, "qq_bias_ptr", "f32", NULL);
    ckc_signature_builder_ptr(&sb, "query_start_len_ptr", "i32", NULL);
    ckc_signature_builder_scalar(&sb, "scale", "f32");
    ckc_signature_builder_scalar(&sb, "k_scale", "f32");
    ckc_signature_builder_scalar(&sb, "v_scale", "f32");
    ckc_signature_builder_scalar(&sb, "out_scale", "f32");
    ckc_signature_builder_scalar(&sb, "softcap", "f32");
    ckc_signature_builder_scalar(&sb, "num_seqs", "i32");
    /* include_bt_stride=False, include_qq_bias_stride=False => no tail scalars */

    return ckc_signature_builder_build(&sb, out_items, out_count);
}

/* ============================================== shared param-declare helpers */

/* One pointer param with noalias + readonly/writeonly + align. */
static ckc_value_t* ckc__param_ptr(ckc_ir_builder_t* b,
                                   const char* name,
                                   const ckc_type_t* pointee,
                                   bool noalias,
                                   bool readonly,
                                   bool writeonly,
                                   int align)
{
    const ckc_type_t* ptr_ty = ckc_ptr_type(b, pointee, "global");
    ckc_param_opts_t opts;
    memset(&opts, 0, sizeof(opts));
    if (noalias)
    {
        opts.noalias     = true;
        opts.noalias_set = true;
    }
    if (readonly)
    {
        opts.readonly     = true;
        opts.readonly_set = true;
    }
    if (writeonly)
    {
        opts.writeonly     = true;
        opts.writeonly_set = true;
    }
    opts.align     = align;
    opts.align_set = true;
    return ckc_b_param(b, name, ptr_ty, &opts);
}

/* Shared scalar-attention ABI prefix (_declare_scalar_attn_params).
 * Returns the SSA values by slot into the supplied struct. */
typedef struct ckc__scalar_abi
{
    ckc_value_t* query;
    ckc_value_t* key;
    ckc_value_t* value;
    ckc_value_t* sink;
    ckc_value_t* block_tables;
    ckc_value_t* seq_lens;
    ckc_value_t* alibi;
    ckc_value_t* qq_bias;
    ckc_value_t* cu_q;
    ckc_value_t* scale;
    ckc_value_t* k_scale;
    ckc_value_t* v_scale;
} ckc__scalar_abi_t;

static void ckc__declare_scalar_attn_params(ckc_ir_builder_t* b,
                                            const ckc_type_t* dtype_ir,
                                            ckc__scalar_abi_t* abi)
{
    abi->query = ckc__param_ptr(b, "query_ptr", dtype_ir, true, true, false, 16);
    abi->key   = ckc__param_ptr(b, "key_cache_ptr", dtype_ir, true, true, false, 16);
    abi->value = ckc__param_ptr(b, "value_cache_ptr", dtype_ir, true, true, false, 16);
    abi->sink  = ckc__param_ptr(b, "sink_ptr", dtype_ir, false, true, false, 16);
    abi->block_tables =
        ckc__param_ptr(b, "block_tables_ptr", ckc_i32(), false, true, false, 4);
    abi->seq_lens =
        ckc__param_ptr(b, "seq_lens_ptr", ckc_i32(), false, true, false, 4);
    abi->alibi =
        ckc__param_ptr(b, "alibi_slopes_ptr", ckc_f32(), false, true, false, 4);
    abi->qq_bias =
        ckc__param_ptr(b, "qq_bias_ptr", ckc_f32(), false, true, false, 4);
    abi->cu_q =
        ckc__param_ptr(b, "query_start_len_ptr", ckc_i32(), false, true, false, 4);
    abi->scale   = ckc_b_param(b, "scale", ckc_f32(), NULL);
    abi->k_scale = ckc_b_param(b, "k_scale", ckc_f32(), NULL);
    abi->v_scale = ckc_b_param(b, "v_scale", ckc_f32(), NULL);
}

/* _physical_block_and_token(b, p, block_tables, seq_idx, kpos). */
static void ckc__physical_block_and_token(ckc_ir_builder_t* b,
                                          const ckc_unified_attention_problem_t* p,
                                          ckc_value_t* block_tables,
                                          ckc_value_t* seq_idx,
                                          ckc_value_t* kpos,
                                          ckc_value_t** out_physical,
                                          ckc_value_t** out_token)
{
    ckc_value_t* block_idx = NULL;
    ckc_value_t* token     = NULL;
    ckc__magic_div_mod(b, kpos, p->block_size, &block_idx, &token);
    int max_blocks = ckc__ceil_div(p->max_seqlen_k, p->block_size);
    ckc_value_t* lin =
        ckc_b_add(b, ckc_b_mul(b, seq_idx, ckc_b_const_i32(b, max_blocks)), block_idx);
    ckc_value_t* physical = ckc_b_global_load_i32(b, block_tables, lin, 4);
    if (out_physical)
        *out_physical = physical;
    if (out_token)
        *out_token = token;
}

/* _emit_qk_score(...): per-(q_tok,q_head) QK dot product, log2-domain. */
static ckc_value_t* ckc__emit_qk_score(ckc_ir_builder_t* b,
                                       const ckc_unified_attention_problem_t* p,
                                       const ckc_type_t* dtype,
                                       const ckc_tensor_descriptor_t* q_desc,
                                       ckc_value_t* query,
                                       ckc_value_t* key,
                                       ckc_value_t* block_tables,
                                       ckc_value_t* seq_idx,
                                       ckc_value_t* q_tok,
                                       ckc_value_t* q_head,
                                       ckc_value_t* kv_head,
                                       ckc_value_t* kpos,
                                       ckc_value_t* scale,
                                       ckc_value_t* rcp_ln2)
{
    ckc_value_t* score    = ckc_b_const_f32(b, 0.0);
    ckc_value_t* physical = NULL;
    ckc_value_t* token    = NULL;
    ckc__physical_block_and_token(b, p, block_tables, seq_idx, kpos, &physical, &token);

    ckc_value_t* c0 = ckc_b_const_i32(b, 0);
    ckc_value_t* q_off_base =
        ckc__q_offset(b, q_desc, q_tok, q_head, c0);
    ckc_value_t* k_off_base =
        ckc__paged_kv_offset(b, p, physical, token, kv_head, c0);

    const int VEC = 8;
    int n_vec     = p->head_size / VEC;
    for (int d8 = 0; d8 < n_vec; ++d8)
    {
        ckc_value_t* d_base = ckc_b_const_i32(b, d8 * VEC);
        ckc_value_t* qv     = ckc_b_global_load_vN(
            b, query, ckc_b_add(b, q_off_base, d_base), dtype, VEC, 16);
        ckc_value_t* kv = ckc_b_global_load_vN(
            b, key, ckc_b_add(b, k_off_base, d_base), dtype, VEC, 16);
        for (int i = 0; i < VEC; ++i)
        {
            ckc_value_t* qe = ckc_b_cast_to_f32(b, ckc_b_vec_extract(b, qv, i));
            ckc_value_t* ke = ckc_b_cast_to_f32(b, ckc_b_vec_extract(b, kv, i));
            score           = ckc_b_fadd(b, score, ckc_b_fmul(b, qe, ke));
        }
    }
    /* Tail scalar fold for head_size % 8 != 0 (empty for the supported set). */
    for (int d = n_vec * VEC; d < p->head_size; ++d)
    {
        ckc_value_t* d_v   = ckc_b_const_i32(b, d);
        ckc_value_t* q_off = ckc__q_offset(b, q_desc, q_tok, q_head, d_v);
        ckc_value_t* k_off =
            ckc__paged_kv_offset(b, p, physical, token, kv_head, d_v);
        ckc_value_t* qv_s =
            ckc_b_cast_to_f32(b, ckc_b_global_load(b, query, q_off, dtype, 2));
        ckc_value_t* kv_s =
            ckc_b_cast_to_f32(b, ckc_b_global_load(b, key, k_off, dtype, 2));
        score = ckc_b_fadd(b, score, ckc_b_fmul(b, qv_s, kv_s));
    }
    return ckc_b_fmul(b, ckc_b_fmul(b, score, scale), rcp_ln2);
}

/* _emit_v_load(...). */
static ckc_value_t* ckc__emit_v_load(ckc_ir_builder_t* b,
                                     const ckc_unified_attention_problem_t* p,
                                     const ckc_type_t* dtype,
                                     ckc_value_t* value,
                                     ckc_value_t* block_tables,
                                     ckc_value_t* seq_idx,
                                     ckc_value_t* kv_head,
                                     ckc_value_t* kpos,
                                     ckc_value_t* dim)
{
    ckc_value_t* physical = NULL;
    ckc_value_t* token    = NULL;
    ckc__physical_block_and_token(b, p, block_tables, seq_idx, kpos, &physical, &token);
    ckc_value_t* v_off =
        ckc__paged_kv_offset(b, p, physical, token, kv_head, dim);
    return ckc_b_cast_to_f32(b, ckc_b_global_load(b, value, v_off, dtype, 2));
}

/* _emit_find_seq_idx_scan: per-token seq index. The Python defers to the shared
 * binary_search_seq_idx helper (not yet exported by the C attention layer); we
 * use the numerically identical inline linear scan (largest i with
 * cu_q[i] <= q_tok) that build_unified_attention_2d itself uses.
 * TODO(port): swap to ckc_binary_search_seq_idx once the helper lands. */
static ckc_value_t* ckc__emit_find_seq_idx_scan(ckc_ir_builder_t* b,
                                                ckc_value_t* cu_q,
                                                ckc_value_t* q_tok,
                                                ckc_value_t* num_seqs)
{
    ckc_value_t* seq_init = ckc_b_const_i32(b, 0);
    ckc_iter_arg_t iter[1];
    iter[0].name = "seq_idx";
    iter[0].init = seq_init;
    ckc_for_t scan = ckc_b_scf_for_iter(b, ckc_b_const_i32(b, 0), num_seqs,
                                        ckc_b_const_i32(b, 1), iter, 1, "si",
                                        false, false);
    ckc_b_region_enter(b, scan.body);
    {
        ckc_value_t* si      = scan.iv;
        ckc_value_t* seq_idx = scan.iter_vars[0];
        ckc_value_t* start_i = ckc_b_global_load_i32(b, cu_q, si, 4);
        ckc_value_t* le      = ckc_b_cmp_le(b, start_i, q_tok);
        ckc_value_t* next    = ckc_b_select(b, le, si, seq_idx);
        ckc_value_t* y[1]    = {next};
        ckc_b_scf_yield(b, y, 1);
    }
    ckc_b_region_leave(b);
    return (scan.op != NULL) ? scan.op->results[0] : NULL;
}

/* ================================================== build_unified_attention_2d */

ckc_kernel_def_t* ckc_build_unified_attention_2d_scalar(
    ckc_ir_builder_t* b,
    const ckc_unified_attention_problem_t* p,
    const char* name)
{
    if (b == NULL || p == NULL)
        return NULL;
    const ckc_type_t* dtype = ckc__dtype_ir(p);
    if (dtype == NULL) /* unsupported dtype (Python ValueError) */
        return NULL;

    ckc_kernel_def_t* k = ckc_ir_builder_kernel(b);
    ckc_attr_set_int(b, &k->attrs, "max_workgroup_size", 64);

    ckc_value_t* output =
        ckc__param_ptr(b, "output_ptr", dtype, true, false, true, 16);
    ckc__scalar_abi_t abi;
    ckc__declare_scalar_attn_params(b, dtype, &abi);
    ckc_value_t* query        = abi.query;
    ckc_value_t* key          = abi.key;
    ckc_value_t* value        = abi.value;
    ckc_value_t* sinks        = abi.sink;
    ckc_value_t* block_tables = abi.block_tables;
    ckc_value_t* seq_lens     = abi.seq_lens;
    ckc_value_t* cu_q         = abi.cu_q;
    ckc_value_t* scale        = abi.scale;
    (void)ckc_b_param(b, "out_scale", ckc_f32(), NULL);
    ckc_value_t* softcap  = ckc_b_param(b, "softcap", ckc_f32(), NULL);
    ckc_value_t* num_seqs = ckc_b_param(b, "num_seqs", ckc_i32(), NULL);

    ckc_value_t* q_tok = ckc_b_block_id_x(b);
    ckc_value_t* q_head = ckc_b_block_id_y(b);
    ckc_value_t* dim    = ckc_b_block_id_z(b);
    ckc_value_t* tid    = ckc_b_thread_id_x(b);
    ckc_value_t* active = ckc_b_cmp_eq(b, tid, ckc_b_const_i32(b, 0));

    /* Find seq_idx via linear cu_q scan. */
    ckc_value_t* seq_init = ckc_b_const_i32(b, 0);
    ckc_iter_arg_t sc_iter[1];
    sc_iter[0].name = "seq_idx";
    sc_iter[0].init = seq_init;
    ckc_for_t scan  = ckc_b_scf_for_iter(b, ckc_b_const_i32(b, 0), num_seqs,
                                         ckc_b_const_i32(b, 1), sc_iter, 1, "si",
                                         false, false);
    ckc_b_region_enter(b, scan.body);
    {
        ckc_value_t* si      = scan.iv;
        ckc_value_t* seq_idx = scan.iter_vars[0];
        ckc_value_t* start_i = ckc_b_global_load_i32(b, cu_q, si, 4);
        ckc_value_t* le      = ckc_b_cmp_le(b, start_i, q_tok);
        ckc_value_t* next    = ckc_b_select(b, le, si, seq_idx);
        ckc_value_t* y[1]    = {next};
        ckc_b_scf_yield(b, y, 1);
    }
    ckc_b_region_leave(b);
    ckc_value_t* seq_idx = (scan.op != NULL) ? scan.op->results[0] : NULL;

    ckc_value_t* cu_start = ckc_b_global_load_i32(b, cu_q, seq_idx, 4);
    ckc_value_t* cu_stop =
        ckc_b_global_load_i32(b, cu_q, ckc_b_add(b, seq_idx, ckc_b_const_i32(b, 1)), 4);
    ckc_value_t* q_len     = ckc_b_sub(b, cu_stop, cu_start);
    ckc_value_t* query_pos = ckc_b_sub(b, q_tok, cu_start);
    ckc_value_t* kv_len    = ckc_b_global_load_i32(b, seq_lens, seq_idx, 4);
    ckc_value_t* context_len = ckc_b_sub(b, kv_len, q_len);
    int nqpk                 = ckc_unified_attention_problem_num_queries_per_kv(p);
    ckc_value_t* kv_head     = ckc__magic_div(b, q_head, nqpk);

    ckc_value_t* neg_inf = ckc_b_const_f32(b, -INFINITY);
    ckc_value_t* zero_f  = ckc_b_const_f32(b, 0.0);
    ckc_value_t* one_f   = ckc_b_const_f32(b, 1.0);
    ckc_value_t* rcp_ln2 = ckc_b_const_f32(b, 1.4426950408889634);

    ckc_value_t* init_m;
    ckc_value_t* init_l;
    if (p->use_sinks)
    {
        ckc_value_t* sink_h = ckc_b_global_load(b, sinks, q_head, dtype, 2);
        init_m = ckc_b_fmul(b, ckc_b_cast_to_f32(b, sink_h), rcp_ln2);
        init_l = one_f;
    }
    else
    {
        init_m = neg_inf;
        init_l = one_f;
    }
    ckc_value_t* init_acc = zero_f;

    ckc_tensor_descriptor_t* q_desc = ckc__q_descriptor(b, p);

    ckc_iter_arg_t loop_iter[3];
    loop_iter[0].name = "m";
    loop_iter[0].init = init_m;
    loop_iter[1].name = "l";
    loop_iter[1].init = init_l;
    loop_iter[2].name = "acc";
    loop_iter[2].init = init_acc;
    ckc_for_t loop = ckc_b_scf_for_iter(b, ckc_b_const_i32(b, 0), kv_len,
                                        ckc_b_const_i32(b, 1), loop_iter, 3,
                                        "kpos", false, false);
    ckc_b_region_enter(b, loop.body);
    {
        ckc_value_t* kpos    = loop.iv;
        ckc_value_t* m_val   = loop.iter_vars[0];
        ckc_value_t* l_val   = loop.iter_vars[1];
        ckc_value_t* acc_val = loop.iter_vars[2];

        ckc_value_t* physical = NULL;
        ckc_value_t* token    = NULL;
        ckc__physical_block_and_token(b, p, block_tables, seq_idx, kpos, &physical,
                                      &token);

        ckc_value_t* score = ckc_b_const_f32(b, 0.0);
        ckc_value_t* c0    = ckc_b_const_i32(b, 0);
        ckc_value_t* q_off_base = ckc__q_offset(b, q_desc, q_tok, q_head, c0);
        ckc_value_t* k_off_base =
            ckc__paged_kv_offset(b, p, physical, token, kv_head, c0);
        const int VEC = 8;
        int n_vec     = p->head_size / VEC;
        for (int d8 = 0; d8 < n_vec; ++d8)
        {
            ckc_value_t* d_base = ckc_b_const_i32(b, d8 * VEC);
            ckc_value_t* qv     = ckc_b_global_load_vN(
                b, query, ckc_b_add(b, q_off_base, d_base), dtype, VEC, 16);
            ckc_value_t* kv = ckc_b_global_load_vN(
                b, key, ckc_b_add(b, k_off_base, d_base), dtype, VEC, 16);
            for (int i = 0; i < VEC; ++i)
            {
                ckc_value_t* qe = ckc_b_cast_to_f32(b, ckc_b_vec_extract(b, qv, i));
                ckc_value_t* ke = ckc_b_cast_to_f32(b, ckc_b_vec_extract(b, kv, i));
                score = ckc_b_fadd(b, score, ckc_b_fmul(b, qe, ke));
            }
        }
        for (int d = n_vec * VEC; d < p->head_size; ++d)
        {
            ckc_value_t* d_v   = ckc_b_const_i32(b, d);
            ckc_value_t* q_off = ckc__q_offset(b, q_desc, q_tok, q_head, d_v);
            ckc_value_t* k_off =
                ckc__paged_kv_offset(b, p, physical, token, kv_head, d_v);
            ckc_value_t* qv_s =
                ckc_b_cast_to_f32(b, ckc_b_global_load(b, query, q_off, dtype, 2));
            ckc_value_t* kv_s =
                ckc_b_cast_to_f32(b, ckc_b_global_load(b, key, k_off, dtype, 2));
            score = ckc_b_fadd(b, score, ckc_b_fmul(b, qv_s, kv_s));
        }

        score = ckc_b_fmul(b, ckc_b_fmul(b, score, scale), rcp_ln2);
        if (p->softcap > 0.0)
            score = ckc_b_fmul(b, ckc__apply_softcap(b, score, softcap), rcp_ln2);

        ckc_value_t* causal_ok =
            ckc_b_cmp_le(b, kpos, ckc_b_add(b, context_len, query_pos));
        if (p->sliding_window > 0)
        {
            ckc_value_t* dist =
                ckc_b_sub(b, ckc_b_add(b, context_len, query_pos), kpos);
            ckc_value_t* sw_ok =
                ckc_b_cmp_lt(b, dist, ckc_b_const_i32(b, p->sliding_window));
            causal_ok = ckc_b_land(b, causal_ok, sw_ok);
        }
        score = ckc_b_select(b, causal_ok, score, neg_inf);
        ckc_value_t* new_m_raw = ckc_b_fmax(b, m_val, score);
        ckc_value_t* is_finite = ckc_b_fcmp(b, "ogt", new_m_raw, neg_inf);
        ckc_value_t* new_m     = ckc_b_select(b, is_finite, new_m_raw, zero_f);
        ckc_value_t* alpha     = ckc_b_exp2(b, ckc_b_fsub(b, m_val, new_m));
        ckc_value_t* prob      = ckc_b_exp2(b, ckc_b_fsub(b, score, new_m));
        ckc_value_t* new_l =
            ckc_b_fadd(b, ckc_b_fmul(b, l_val, alpha), prob);
        ckc_value_t* v_off =
            ckc__paged_kv_offset(b, p, physical, token, kv_head, dim);
        ckc_value_t* vv =
            ckc_b_cast_to_f32(b, ckc_b_global_load(b, value, v_off, dtype, 2));
        ckc_value_t* new_acc = ckc_b_fadd(
            b, ckc_b_fmul(b, acc_val, alpha), ckc_b_fmul(b, prob, vv));
        ckc_value_t* y[3] = {new_m, new_l, new_acc};
        ckc_b_scf_yield(b, y, 3);
    }
    ckc_b_region_leave(b);

    ckc_value_t* res_l   = (loop.op != NULL) ? loop.op->results[1] : NULL;
    ckc_value_t* res_acc = (loop.op != NULL) ? loop.op->results[2] : NULL;
    ckc_value_t* out_val = ckc_b_fmul(b, res_acc, ckc_b_rcp(b, res_l));
    ckc_value_t* out_cast = ckc_b_cast_f32_to(b, out_val, dtype);
    ckc_value_t* out_off  = ckc__q_offset(b, q_desc, q_tok, q_head, dim);
    ckc_value_t* valid =
        ckc_b_land(b, active, ckc_b_cmp_lt(b, dim, ckc_b_const_i32(b, p->head_size)));
    ckc_if_t iff = ckc_b_scf_if(b, valid);
    ckc_b_region_enter(b, iff.then_region);
    {
        ckc_b_global_store(b, output, out_off, out_cast, 2);
    }
    ckc_b_region_leave(b);

    (void)q_len;
    (void)name;
    return ckc_ir_builder_ok(b) ? k : NULL;
}

/* ================================================== build_unified_attention_3d */

ckc_kernel_def_t* ckc_build_unified_attention_3d_scalar(
    ckc_ir_builder_t* b,
    const ckc_unified_attention_problem_t* p,
    const char* name,
    int num_segments)
{
    if (b == NULL || p == NULL)
        return NULL;
    const ckc_type_t* dtype = ckc__dtype_ir(p);
    if (dtype == NULL)
        return NULL;

    ckc_kernel_def_t* k = ckc_ir_builder_kernel(b);
    ckc_attr_set_int(b, &k->attrs, "max_workgroup_size", 64);

    ckc_value_t* segm_output =
        ckc__param_ptr(b, "segm_output_ptr", ckc_f32(), true, false, true, 16);
    ckc_value_t* segm_max =
        ckc__param_ptr(b, "segm_max_ptr", ckc_f32(), true, false, true, 16);
    ckc_value_t* segm_expsum =
        ckc__param_ptr(b, "segm_expsum_ptr", ckc_f32(), true, false, true, 16);

    ckc__scalar_abi_t abi;
    ckc__declare_scalar_attn_params(b, dtype, &abi);
    ckc_value_t* query        = abi.query;
    ckc_value_t* key          = abi.key;
    ckc_value_t* value        = abi.value;
    ckc_value_t* block_tables = abi.block_tables;
    ckc_value_t* seq_lens     = abi.seq_lens;
    ckc_value_t* cu_q         = abi.cu_q;
    ckc_value_t* scale        = abi.scale;
    (void)ckc_b_param(b, "softcap", ckc_f32(), NULL);
    ckc_value_t* num_seqs = ckc_b_param(b, "num_seqs", ckc_i32(), NULL);

    ckc_value_t* q_tok  = ckc_b_block_id_x(b);
    ckc_value_t* q_head = ckc_b_block_id_y(b);
    ckc_value_t* zd     = ckc_b_block_id_z(b);
    ckc_value_t* segm_idx = NULL;
    ckc_value_t* dim      = NULL;
    ckc__magic_div_mod(b, zd, p->head_size, &segm_idx, &dim);
    ckc_value_t* tid    = ckc_b_thread_id_x(b);
    ckc_value_t* active = ckc_b_cmp_eq(b, tid, ckc_b_const_i32(b, 0));

    ckc_value_t* seq_idx = ckc__emit_find_seq_idx_scan(b, cu_q, q_tok, num_seqs);
    ckc_value_t* cu_start = ckc_b_global_load_i32(b, cu_q, seq_idx, 4);
    ckc_value_t* cu_stop =
        ckc_b_global_load_i32(b, cu_q, ckc_b_add(b, seq_idx, ckc_b_const_i32(b, 1)), 4);
    ckc_value_t* q_len     = ckc_b_sub(b, cu_stop, cu_start);
    ckc_value_t* query_pos = ckc_b_sub(b, q_tok, cu_start);
    ckc_value_t* kv_len    = ckc_b_global_load_i32(b, seq_lens, seq_idx, 4);
    ckc_value_t* context_len = ckc_b_sub(b, kv_len, q_len);
    int nqpk             = ckc_unified_attention_problem_num_queries_per_kv(p);
    ckc_value_t* kv_head = ckc__magic_div(b, q_head, nqpk);

    int seg_div = num_segments * p->block_size;
    ckc_value_t* tiles_per_segment = ckc__magic_div(
        b, ckc_b_add(b, kv_len, ckc_b_const_i32(b, seg_div - 1)), seg_div);
    ckc_value_t* seg_start = ckc_b_mul(
        b, segm_idx, ckc_b_mul(b, tiles_per_segment, ckc_b_const_i32(b, p->block_size)));
    ckc_value_t* seg_stop_i = ckc_b_mul(
        b, ckc_b_add(b, segm_idx, ckc_b_const_i32(b, 1)),
        ckc_b_mul(b, tiles_per_segment, ckc_b_const_i32(b, p->block_size)));
    seg_stop_i = ckc_b_select(b, ckc_b_cmp_lt(b, seg_stop_i, kv_len), seg_stop_i, kv_len);

    ckc_value_t* neg_inf = ckc_b_const_f32(b, -INFINITY);
    ckc_value_t* zero_f  = ckc_b_const_f32(b, 0.0);
    ckc_value_t* rcp_ln2 = ckc_b_const_f32(b, 1.4426950408889634);
    ckc_value_t* init_m  = neg_inf;
    ckc_value_t* init_l  = zero_f;
    ckc_value_t* init_acc = zero_f;

    ckc_tensor_descriptor_t* q_desc = ckc__q_descriptor(b, p);

    ckc_iter_arg_t loop_iter[3];
    loop_iter[0].name = "m";
    loop_iter[0].init = init_m;
    loop_iter[1].name = "l";
    loop_iter[1].init = init_l;
    loop_iter[2].name = "acc";
    loop_iter[2].init = init_acc;
    ckc_for_t loop = ckc_b_scf_for_iter(b, seg_start, seg_stop_i,
                                        ckc_b_const_i32(b, 1), loop_iter, 3,
                                        "kpos", false, false);
    ckc_b_region_enter(b, loop.body);
    {
        ckc_value_t* kpos    = loop.iv;
        ckc_value_t* m_val   = loop.iter_vars[0];
        ckc_value_t* l_val   = loop.iter_vars[1];
        ckc_value_t* acc_val = loop.iter_vars[2];

        ckc_value_t* score = ckc__emit_qk_score(b, p, dtype, q_desc, query, key,
                                                block_tables, seq_idx, q_tok, q_head,
                                                kv_head, kpos, scale, rcp_ln2);
        ckc_value_t* causal_ok =
            ckc_b_cmp_le(b, kpos, ckc_b_add(b, context_len, query_pos));
        score = ckc_b_select(b, causal_ok, score, neg_inf);
        ckc_value_t* new_m = ckc_b_fmax(b, m_val, score);
        ckc_value_t* alpha = ckc_b_exp2(b, ckc_b_fsub(b, m_val, new_m));
        ckc_value_t* prob  = ckc_b_exp2(b, ckc_b_fsub(b, score, new_m));
        ckc_value_t* new_l = ckc_b_fadd(b, ckc_b_fmul(b, l_val, alpha), prob);
        ckc_value_t* vv    = ckc__emit_v_load(b, p, dtype, value, block_tables,
                                              seq_idx, kv_head, kpos, dim);
        ckc_value_t* new_acc = ckc_b_fadd(
            b, ckc_b_fmul(b, acc_val, alpha), ckc_b_fmul(b, prob, vv));
        ckc_value_t* y[3] = {new_m, new_l, new_acc};
        ckc_b_scf_yield(b, y, 3);
    }
    ckc_b_region_leave(b);

    ckc_tensor_descriptor_t* ml_desc  = NULL;
    ckc_tensor_descriptor_t* out_desc = NULL;
    ckc__segm_descriptors(b, p, num_segments, &ml_desc, &out_desc);

    ckc_value_t* res_m   = (loop.op != NULL) ? loop.op->results[0] : NULL;
    ckc_value_t* res_l   = (loop.op != NULL) ? loop.op->results[1] : NULL;
    ckc_value_t* res_acc = (loop.op != NULL) ? loop.op->results[2] : NULL;

    ckc_value_t* base =
        ckc__segout_offset(b, out_desc, q_tok, q_head, segm_idx, dim);
    ckc_if_t iff = ckc_b_scf_if(b, active);
    ckc_b_region_enter(b, iff.then_region);
    {
        ckc_b_global_store(b, segm_output, base, res_acc, 4);
        ckc_value_t* is_dim0 = ckc_b_cmp_eq(b, dim, ckc_b_const_i32(b, 0));
        ckc_if_t iff0        = ckc_b_scf_if(b, is_dim0);
        ckc_b_region_enter(b, iff0.then_region);
        {
            ckc_value_t* segm_base =
                ckc__ml_offset(b, ml_desc, q_tok, q_head, segm_idx);
            ckc_b_global_store(b, segm_max, segm_base, res_m, 4);
            ckc_b_global_store(b, segm_expsum, segm_base, res_l, 4);
        }
        ckc_b_region_leave(b);
    }
    ckc_b_region_leave(b);

    (void)name;
    return ckc_ir_builder_ok(b) ? k : NULL;
}

/* ============================================== build_unified_attention_reduce */

ckc_kernel_def_t* ckc_build_unified_attention_reduce_scalar(
    ckc_ir_builder_t* b,
    const ckc_unified_attention_problem_t* p,
    int num_segments,
    const char* name)
{
    if (b == NULL || p == NULL)
        return NULL;
    const ckc_type_t* dtype =
        (p->dtype && strcmp(p->dtype, "fp16") == 0) ? ckc_f16() : ckc_bf16();

    ckc_kernel_def_t* k = ckc_ir_builder_kernel(b);
    ckc_attr_set_int(b, &k->attrs, "max_workgroup_size", 64);

    ckc_value_t* out =
        ckc__param_ptr(b, "output_ptr", dtype, true, false, true, 16);
    ckc_value_t* segm_output =
        ckc__param_ptr(b, "segm_output_ptr", ckc_f32(), false, true, false, 16);
    ckc_value_t* segm_max =
        ckc__param_ptr(b, "segm_max_ptr", ckc_f32(), false, true, false, 16);
    ckc_value_t* segm_expsum =
        ckc__param_ptr(b, "segm_expsum_ptr", ckc_f32(), false, true, false, 16);
    (void)ckc__param_ptr(b, "seq_lens_ptr", ckc_i32(), false, true, false, 4);
    (void)ckc__param_ptr(b, "query_start_len_ptr", ckc_i32(), false, true, false, 4);

    ckc_value_t* q_tok  = ckc_b_block_id_x(b);
    ckc_value_t* q_head = ckc_b_block_id_y(b);
    ckc_value_t* dim    = ckc_b_block_id_z(b);
    ckc_value_t* tid    = ckc_b_thread_id_x(b);
    ckc_value_t* active = ckc_b_cmp_eq(b, tid, ckc_b_const_i32(b, 0));
    ckc_value_t* neg_inf = ckc_b_const_f32(b, -INFINITY);
    ckc_value_t* zero    = ckc_b_const_f32(b, 0.0);

    ckc_tensor_descriptor_t* ml_desc      = NULL;
    ckc_tensor_descriptor_t* seg_out_desc = NULL;
    ckc__segm_descriptors(b, p, num_segments, &ml_desc, &seg_out_desc);
    ckc_tensor_descriptor_t* q_desc = ckc__q_descriptor(b, p);

    /* Pass 1: overall max over segments. */
    ckc_iter_arg_t mx_iter[1];
    mx_iter[0].name = "mx";
    mx_iter[0].init = neg_inf;
    ckc_for_t max_loop = ckc_b_scf_for_iter(b, ckc_b_const_i32(b, 0),
                                            ckc_b_const_i32(b, num_segments),
                                            ckc_b_const_i32(b, 1), mx_iter, 1,
                                            "seg", false, false);
    ckc_b_region_enter(b, max_loop.body);
    {
        ckc_value_t* seg = max_loop.iv;
        ckc_value_t* mx  = max_loop.iter_vars[0];
        ckc_value_t* idx = ckc__ml_offset(b, ml_desc, q_tok, q_head, seg);
        ckc_value_t* mv  = ckc_b_global_load_f32(b, segm_max, idx, 4);
        ckc_value_t* y[1] = {ckc_b_fmax(b, mx, mv)};
        ckc_b_scf_yield(b, y, 1);
    }
    ckc_b_region_leave(b);
    ckc_value_t* overall = (max_loop.op != NULL) ? max_loop.op->results[0] : NULL;

    /* Pass 2: weighted reduce. */
    ckc_iter_arg_t red_iter[2];
    red_iter[0].name = "den";
    red_iter[0].init = zero;
    red_iter[1].name = "acc";
    red_iter[1].init = zero;
    ckc_for_t red = ckc_b_scf_for_iter(b, ckc_b_const_i32(b, 0),
                                       ckc_b_const_i32(b, num_segments),
                                       ckc_b_const_i32(b, 1), red_iter, 2,
                                       "seg2", false, false);
    ckc_b_region_enter(b, red.body);
    {
        ckc_value_t* seg = red.iv;
        ckc_value_t* den = red.iter_vars[0];
        ckc_value_t* acc = red.iter_vars[1];
        ckc_value_t* idx = ckc__ml_offset(b, ml_desc, q_tok, q_head, seg);
        ckc_value_t* mv  = ckc_b_global_load_f32(b, segm_max, idx, 4);
        ckc_value_t* lv  = ckc_b_global_load_f32(b, segm_expsum, idx, 4);
        ckc_value_t* factor = ckc_b_exp2(b, ckc_b_fsub(b, mv, overall));
        ckc_value_t* den2   = ckc_b_fadd(b, den, ckc_b_fmul(b, lv, factor));
        ckc_value_t* out_idx =
            ckc__segout_offset(b, seg_out_desc, q_tok, q_head, seg, dim);
        ckc_value_t* ov   = ckc_b_global_load_f32(b, segm_output, out_idx, 4);
        ckc_value_t* acc2 = ckc_b_fadd(b, acc, ckc_b_fmul(b, ov, factor));
        ckc_value_t* y[2] = {den2, acc2};
        ckc_b_scf_yield(b, y, 2);
    }
    ckc_b_region_leave(b);

    ckc_value_t* red_den = (red.op != NULL) ? red.op->results[0] : NULL;
    ckc_value_t* red_acc = (red.op != NULL) ? red.op->results[1] : NULL;
    ckc_value_t* result  = ckc_b_fmul(b, red_acc, ckc_b_rcp(b, red_den));
    ckc_value_t* cast    = ckc_b_cast_f32_to(b, result, dtype);
    ckc_value_t* out_idx = ckc__q_offset(b, q_desc, q_tok, q_head, dim);
    ckc_if_t iff = ckc_b_scf_if(b, active);
    ckc_b_region_enter(b, iff.then_region);
    {
        ckc_b_global_store(b, out, out_idx, cast, 2);
    }
    ckc_b_region_leave(b);

    (void)name;
    return ckc_ir_builder_ok(b) ? k : NULL;
}
