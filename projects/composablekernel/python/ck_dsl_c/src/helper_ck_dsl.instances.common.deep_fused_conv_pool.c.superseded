/* ------------------------------------------------------------------ *
 * Builder-emit helpers
 * ------------------------------------------------------------------ *
 *
 * The bodies below need peer ports (WarpGrid, MmaOp layouts,
 * CoalescedTileLoader, distribution/cshuffle). Each routes a structured error
 * through the sticky-error IRBuilder and documents the Python sequence to
 * reproduce. They are bounded stubs per the port brief; verify+fix completes
 * them when the peer accessors land. */

static void dfcp_todo(ckc_ir_builder_t* b, const char* what)
{
    if (b == NULL)
    {
        return;
    }
    /* Set the sticky builder error so callers observe the unported dependency
     * instead of silently emitting wrong IR. The message names the helper. */
    (void)ckc_i_set_err(b, CKC_ERR_VALUE,
                        "deep_fused_conv_pool: builder-emit helper %s not yet "
                        "ported (needs WarpGrid/MmaOp/loader/distribution peer)",
                        what != NULL ? what : "?");
}

