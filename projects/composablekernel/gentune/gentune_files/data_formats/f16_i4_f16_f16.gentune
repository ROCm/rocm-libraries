# generic templates for all instances using f16_i4_f16_f16 data types

#CACHE_BEST_RESULTS

PARAMS:
ADataType_; CDataType_; CShuffleDataType_ GEN 
half_t 
CONDITION 
is_same_v<ADataType, half_t> &&
is_same_v<CDataType, half_t>
PREPROCESSOR CK_ENABLE_F16

BDataType_ GEN 
pk_i4_t 
CONDITION 
is_same_v<BDataType, pk_i4_t>
# kabraham: int4 dosen't seem to have a preprocessor define?

PROFILER_DATATYPE_ID: 8

ComputeTypeA GEN half_t
ComputeTypeB GEN half_t
