# generic templates for all instances using bf16_bf16_bf16_bf16 data types

#CACHE_BEST_RESULTS


PARAMS:
ADataType_; BDataType_; CDataType_; CShuffleDataType_ GEN 
bhalf_t 
CONDITION 
is_same_v<ADataType, bhalf_t> && 
is_same_v<BDataType, bhalf_t> &&
is_same_v<CDataType, bhalf_t>
PREPROCESSOR CK_ENABLE_BF16

ComputeTypeA GEN bhalf_t
ComputeTypeB GEN bhalf_t

PROFILER_DATATYPE_ID: 2
