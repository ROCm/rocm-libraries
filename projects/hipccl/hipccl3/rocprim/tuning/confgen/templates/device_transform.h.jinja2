{% extends "common/base.h.jinja2" %}

{% block tparams -%}
class value_type
{%- endblock %}

{% block config_guard scoped %}
    ({{ mk_type_trait_guard(type.value_type) }}(sizeof(value_type) <= {{ type.value_type.size }})
    {% if type.value_type.size_min > 0 %}&& (sizeof(value_type) > {{ type.value_type.size_min }}){% endif %})
{%- endblock %}

{% block config_constructor scoped -%}
transform_config_params{ { {{ config.block_size_x }}, {{ config.ipt }} } }
{%- endblock %}

{% block config_base_type -%}
transform_config_params_base<value_type>
{%- endblock %}
