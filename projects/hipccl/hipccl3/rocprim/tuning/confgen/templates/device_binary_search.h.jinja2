{% extends "common/base.h.jinja2" %}


{% block tparams %}
class value_type, class output_type
{% endblock %}

{% block params_type -%}transform_config_params{% endblock -%}


{% block config_guard scoped %}
{{ mk_type_trait_guard(type.value_type) }}{{ mk_type_sz_check(type.value_type) }}{% if type.output_type.size_min > 0 %} && (sizeof(output_type) > {{ type.output_type.size_min }}){% endif %} && (sizeof(output_type) <= {{ type.output_type.size }})
{% endblock %}

{% block config_constructor -%}
transform_config_params{ { {{ config.block_size_x }}, {{ config.ipt }} } }
{%- endblock %}

{% block config_base_type -%}
binary_search_config_params_base<value_type, output_type>
{%- endblock %}
