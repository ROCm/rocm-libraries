{% extends "common/base.cpp.jinja2" %}
{% block config_constructor -%}
    rocprim::adjacent_find_config<{{ config.block_size_x }}, {{ config.ipt }}>
{%- endblock %}

{% block benchmark_type %}
{% endblock %}

{% block type_definitions %}
    using input_type = {{ input_type }};
{% endblock %}


{% block benchmark_queue %}
    executor.queue<device_adjacent_find_benchmark<input_type, 1 , config>>();
    executor.queue<device_adjacent_find_benchmark<input_type, 5 , config>>();
    executor.queue<device_adjacent_find_benchmark<input_type, 9 , config>>();
{% endblock %}
