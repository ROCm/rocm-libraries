{% block includes %}
// Include utils for {{algo_name}}_config<...>.
#include "rocprim/device/detail/device_config_helper.hpp"
// Include 'rocprim::empty_type'.
#include "rocprim/types.hpp"
{% block benchmarking_include %}
// Include main benchmarking logic {{algo_type}}_{{algo_name}}_benchmark.
#include "benchmark_{{algo_type}}_{{algo_name}}.hpp"
{% endblock %}
// Include primbench executor.
#include "primbench.hpp"
// Include fixed-width integers for interop with python.
#include <cstdint>
// Include std::log and std::exp for the score.
#include <cmath>
#include <fstream>
#include <sstream>
#include <string>
#include <vector>

// Expands a tune parameter (a macro defined by kernel tuner) to its text, for file names.
#define TUNING_STRINGIFY_IMPL(x) #x
#define TUNING_STRINGIFY(x) TUNING_STRINGIFY_IMPL(x)

// Returns whether any case in a primbench JSON output hit the noise timeout.
inline bool tuning_has_noise_timeout(const std::string& json_path)
{
    std::ifstream     file(json_path);
    std::stringstream contents;
    contents << file.rdbuf();
    return contents.str().find("\"noise_timeout\":true") != std::string::npos;
}
{% endblock %}

{% block extern_c_wrapper %}
extern "C" float {{algo_type}}_{{algo_name}}_wrapper(
    {% block arguments %}
    uint64_t bytes_size
    {% endblock %}
)
{
    // Flush is required for fancy primbench printing due to use
    // of terminal control characters.
    std::cout << std::flush;

    using config = {% block config_constructor scoped required %}{% endblock -%};

    {% block type_definitions %}
    using key_type = {{key_type}};
    {% if value_type %}
    using value_type = {{value_type}};
    {% else %}
    using value_type = rocprim::empty_type;
    {% endif %}
    {% endblock %}

    {% block benchmark_type %}
    using benchmark_type = {{algo_type}}_{{algo_name}}_benchmark<key_type, value_type, config>;
    {% endblock %}

    // Per-case results of this candidate are written to
    // <case_results_dir>/<config>_size<bytes>.json, one file per size.
    const std::string case_results_prefix = std::string("{{ case_results_dir }}/")
    {% for name in config %}
        + "{{ name }}=" + TUNING_STRINGIFY({{ config[name] }}){% if not loop.last %} + "_"{% endif %}

    {% endfor %}
        ;

    // primbench uses one input size per executor, so run every queued case once per size.
    const std::vector<size_t> sizes = { {{ sizes | join(", ") }} };
    (void)bytes_size; // The sizes are rendered into the wrapper instead.

    // If a case hits primbench's noise timeout, all cases of that size are re-run up to
    // noise_retries times. If it still times out, the tuner drops this config.
    constexpr int noise_retries = {{ noise_retries }};

    std::vector<double> all_bytes_per_second;
    for(const size_t size : sizes)
    {
        const std::string json_out = case_results_prefix + "_size" + std::to_string(size) + ".json";
        std::vector<double> size_bytes_per_second;
        for(int attempt = 0;; attempt++)
        {
            {% block primbench_settings %}
            auto settings = primbench::settings();
            settings.json_out = json_out;
            settings.max_warming_secs = 90;
            settings.max_cooling_secs = 90;
            settings.size = size;
            settings.skip_header = true;
            {% endblock %}

            {% block primbench_args %}
            char* args[] = { "benchmark-executable" /* primbench requires an executable name for exposing --help */ };
            {% endblock %}

            {% block primbench_executor %}
            auto executor = primbench::executor(1, args, settings);
            {% endblock %}

            {% block benchmark_queue %}
            executor.queue<benchmark_type>();
            {% endblock %}

            executor.run();

            size_bytes_per_second = executor.get_all_bytes_per_second();
            if(attempt >= noise_retries || !tuning_has_noise_timeout(json_out))
            {
                break;
            }
            std::cout << "Noise timeout, retrying (" << attempt + 1 << "/" << noise_retries
                      << ")" << std::endl;
        }
        all_bytes_per_second.insert(all_bytes_per_second.end(),
                                    size_bytes_per_second.begin(),
                                    size_bytes_per_second.end());
    }

    {% block get_time %}
    // Geometric mean of ms/GiB over all sizes and queued benchmarks, so every size and
    // shape counts equally. With a single size and benchmark this is just its time.
    double log_sum = 0;
    double n       = 0;
    for(const double& x : all_bytes_per_second)
    {
        log_sum += std::log((1000.0 * primbench::GiB) / x);
        n++;
    }
    return std::exp(log_sum / n);
    {% endblock %}
}
{% endblock %}
