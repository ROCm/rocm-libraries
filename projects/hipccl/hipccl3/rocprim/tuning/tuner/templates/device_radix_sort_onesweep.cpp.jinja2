{% extends "common/base.cpp.jinja2" %}
{% block config_constructor -%}
rocprim::radix_sort_onesweep_config<
    rocprim::kernel_config<{{ config.block_size_x }}, {{ config.ipt }}>,
    rocprim::kernel_config<{{ config.sort_block_size_x }}, {{ config.sort_ipt }}>,
    {{ config.radix_bits }},
    rocprim::{{ config.algo }}
>
{%- endblock %}
{% block benchmark_type %}
using benchmark_type = device_radix_sort_onesweep_benchmark<key_type, value_type, config>;
{% endblock %}
{% block type_definitions %}
using key_type = {{ key_type }};
using value_type = {{ value_type }};
{% endblock %}
