// __swap_out_circular_buffer relocates the objects in [__begin_, __end_) into the front of __v and swaps the buffers of
// *this and __v. It is assumed that __v provides space for exactly (__end_ - __begin_) objects in the front. This
// function has a strong exception guarantee.
template <class _Tp>
__device__ _LIBGPU_CONSTEXPR_SINCE_CXX20 void
vector<_Tp>::__swap_out_circular_buffer(__split_buffer<value_type> &__v) {

    auto __new_begin = __v.__begin_ - (__end_ - __begin_);
    gpu::__uninitialized_allocator_relocate(gpu::__to_address(__begin_), gpu::__to_address(__end_),
                                            gpu::__to_address(__new_begin));
    __v.__begin_ = __new_begin;
    __end_       = __begin_; // All the objects have been destroyed by relocating them.
    gpu::swap(this->__begin_, __v.__begin_);
    gpu::swap(this->__end_, __v.__end_);
    gpu::swap(this->__end_cap(), __v.__end_cap());
    __v.__first_ = __v.__begin_;
}

// __swap_out_circular_buffer relocates the objects in [__begin_, __p) into the front of __v, the objects in
// [__p, __end_) into the back of __v and swaps the buffers of *this and __v. It is assumed that __v provides space for
// exactly (__p - __begin_) objects in the front and space for at least (__end_ - __p) objects in the back. This
// function has a strong exception guarantee if __begin_ == __p || __end_ == __p.
template <class _Tp>
__device__ _LIBGPU_CONSTEXPR_SINCE_CXX20 typename vector<_Tp>::pointer
vector<_Tp>::__swap_out_circular_buffer(__split_buffer<value_type> &__v, pointer __p) {
    pointer __ret = __v.__begin_;

    // Relocate [__p, __end_) first to avoid having a hole in [__begin_, __end_)
    // in case something in [__begin_, __p) throws.
    gpu::__uninitialized_allocator_relocate(gpu::__to_address(__p), gpu::__to_address(__end_),
                                            gpu::__to_address(__v.__end_));
    __v.__end_ += (__end_ - __p);
    __end_           = __p; // The objects in [__p, __end_) have been destroyed by relocating them.
    auto __new_begin = __v.__begin_ - (__p - __begin_);

    gpu::__uninitialized_allocator_relocate(gpu::__to_address(__begin_), gpu::__to_address(__p),
                                            gpu::__to_address(__new_begin));
    __v.__begin_ = __new_begin;
    __end_       = __begin_; // All the objects have been destroyed by relocating them.

    gpu::swap(this->__begin_, __v.__begin_);
    gpu::swap(this->__end_, __v.__end_);
    gpu::swap(this->__end_cap(), __v.__end_cap());
    __v.__first_ = __v.__begin_;
    return __ret;
}

