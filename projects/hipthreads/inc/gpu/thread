#pragma clang diagnostic push
#pragma clang diagnostic ignored "-Wcuda-compat" // Suppress "ignored 'inline' attribute on kernel function" warnings

inline __global__ void threading_main() {
    // TODO: Because invokeNext can return false even if there's work waiting (because somebody else snagged the job
    // before we could - see popWorkNodeFromMainQueue and popWorkNodeFromCpuQueue), and we don't increment
    // activeVcoreCount until AFTER we pop work from the queues, it's theoretically possible for a vcore to exit before
    // all the work is done. I don't know if this is a big enough concern to be worth fixing or not.
    for (bool workFound = true; workFound || !finishing || atomicAdd(&activeVcoreCount, 0) != 0;) {
        // TODO: why do we need this when blockDim.x == MAX_THREAD_WIDTH == warpSize?
        __syncthreads();
        workFound = invokeNext();
        if (!workFound)
            __builtin_amdgcn_s_sleep(8);
    }
}

template <class Callable_t>
__global__ void insertWorkNodeFromHost(WorkNode_Header *worknode) {
    worknode->wrapper_fn = wrapper<Callable_t>;
    WorkNode_Header **currentTail = lockAndFetchTail();
    insertWorkNode(currentTail, worknode);
    setAndUnlockTail(&(worknode->next));
}

inline __global__ void detachWorkNode(WorkNode_Header *oldWorkNode, uint32_t worknodeSize) {
    WorkNode_Header *newWorkNode = static_cast<WorkNode_Header *>(::malloc(worknodeSize));
    WorkNode_Header **currentTail = lockAndFetchTail();

    if (oldWorkNode->link_to_self == nullptr) {
        // It's already finished, so oldWorkNode is not in the list, nor in currentWorkNode[]. Thus, we don't have to
        // worry about updating its state or copying it. Just return so gpu::thread can free oldWorkNode.
        setAndUnlockTail(currentTail);
        ::free(newWorkNode);
        return;
    }

    *(oldWorkNode->link_to_self) = newWorkNode;
    oldWorkNode->link_to_self = nullptr;
    gpu::memcpy(newWorkNode, oldWorkNode, worknodeSize);

    // Not equivalent to `oldWorkNode->next == nullptr` b/c pseudo_yield uses oldWorkNode->next to store a pointer to
    // the yielding thread
    if (currentTail == &(oldWorkNode->next)) {
        setAndUnlockTail(&(newWorkNode->next));
    } else {
        // Using oldWorkNode to access next means nothing in this function requires a read from newWorkNode. Not sure if
        // that matters
        if (oldWorkNode->next != nullptr && oldWorkNode->next->link_to_self != nullptr)
            oldWorkNode->next->link_to_self = &(newWorkNode->next);
        setAndUnlockTail(currentTail);
    }
}

