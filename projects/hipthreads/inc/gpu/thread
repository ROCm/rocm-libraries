template <class Fn_t, class... Args_t>
inline __host__ thread::thread(uint32_t width, Fn_t &&typed_fn, Args_t &&...args) {
    if (width > MAX_THREAD_WIDTH) {
        throw std::length_error("thread::thread: width must not exceed " + std::to_string(MAX_THREAD_WIDTH));
    }
    std::unique_ptr worknode_h = make_worknode(width, std::forward<Fn_t>(typed_fn), std::forward<Args_t>(args)...);
    // First two are prerequisites for the third, and produce more user-friendly error messages
    // Note: is_trivially_copyable can behave strangely for extended lambdas. See
    // https://docs.nvidia.com/cuda/cuda-c-programming-guide/index.html 14.7.2.18 Extended Lambda Restrictions
    static_assert(std::is_trivially_copyable_v<std::remove_reference_t<Fn_t>>);
    static_assert((std::is_trivially_copyable_v<std::remove_reference_t<Args_t>> && ...));
    // We're about to memcpy the WorkNode from host to device memory. Make sure that's ok.
    // TODO: could these requirements be relaxed to is_trivially_destructible<T> and
    // is_trivially_constructible<remove_ref<T>, decltype(t)> (i.e. is_trivially_move_constructible or
    // is_trivially_copy_constructible depending on if T is rvalue or lvalue ref)?
    // Note: Do we need to worry about non-object Fn_t's?
    static_assert(std::is_trivially_copyable_v<typename decltype(worknode_h)::element_type>);

#ifdef __HIP_DEVICE_COMPILE__
    // Need to make sure that the insertWorkNodeFromHost template is always instantiated
    hipLaunchKernelGGL(insertWorkNodeFromHost<decltype(worknode_h->fn)>, dim3(1), dim3(1), 0, getEnqueingStream(), worknode_d);
#else
    {
        WorkNode_Header *temp_ptr;
        // TODO: do we even want to move the worknode into device memory, or just leave it in pinned host memory?
        __LIBGPU_HIP_CHECK__(hipMallocAsync(&temp_ptr, sizeof(*worknode_h), getEnqueingStream()));
        worknode_d = std::shared_ptr<WorkNode_Header>(temp_ptr, [](WorkNode_Header *ptr) {
            // WorkNode<T> is trivially destructible (implied by std::is_trivially_copyable).
            __LIBGPU_HIP_CHECK__(hipFreeAsync(ptr, getEnqueingStream()));
        });
    }

    worknodeSize = sizeof(*worknode_h);

    // Pointer to the last worknode_d we constructed that had the same Fn_t and Args_t template arguments.
    static std::weak_ptr<WorkNode_Header> previous_worknode_weak;
    std::shared_ptr<WorkNode_Header> previous_worknode = previous_worknode_weak.lock();
    previous_worknode_weak = worknode_d;
    if (previous_worknode == nullptr) {
        sendWorkNodeViaKernel<decltype(worknode_h->fn)>(std::move(worknode_h));
    } else {
        sendWorkNodeViaBuffer<decltype(worknode_h->fn)>(std::move(worknode_h), std::move(previous_worknode));
    }
#endif //!__HIP_DEVICE_COMPILE__
}

template <class Callable_t>
inline __host__ void
thread::sendWorkNodeViaKernel(std::unique_ptr<internal::WorkNode<Callable_t>> worknode_h [[maybe_unused]]) {
#ifndef __HIP_DEVICE_COMPILE__
    // Maybe we want to do this memcpy in the kernel?
    __LIBGPU_HIP_CHECK__(hipMemcpyAsync(worknode_d.get(), worknode_h.get(), sizeof(*worknode_h), hipMemcpyHostToDevice, getEnqueingStream()));

    hipEvent_t event; // Create a synchronization point after hipMemcpyAsync, so we can make sure the copy is finished before unregistering and/or freeing worknode_h.
    __LIBGPU_HIP_CHECK__(hipEventCreate(&event));
    __LIBGPU_HIP_CHECK__(hipEventRecord(event, getEnqueingStream()));

    hipLaunchKernelGGL(insertWorkNodeFromHost<decltype(worknode_h->fn)>, dim3(1), dim3(1), 0, getEnqueingStream(), worknode_d.get());

    // Make sure that the copy is finished before worknode_h goes out of scope and gets unregistered and/or destroyed.
    __LIBGPU_HIP_CHECK__(hipEventSynchronize(event));
    __LIBGPU_HIP_CHECK__(hipEventDestroy(event));
#endif //!__HIP_DEVICE_COMPILE__
}

template <class Callable_t>
inline __host__ void
thread::sendWorkNodeViaBuffer(std::unique_ptr<internal::WorkNode<Callable_t>> worknode_h [[maybe_unused]],
                              std::shared_ptr<WorkNode_Header> previous_worknode [[maybe_unused]]) {
#ifndef __HIP_DEVICE_COMPILE__
    const uint32_t myCount = cpuWorkQueueIndex_push++;
    const size_t myIndex = myCount % CPU_WORK_QUEUE_SIZE;

    // Set worknode_h->link_to_self = &cpuWorkQueue[myIndex];
    worknode_h->header.link_to_self = getCPUWorkQueueAddr() + myIndex;

    // TODO: set worknode_h->vthread_id

    // Initialize worknode_d using worknode_h
    __LIBGPU_HIP_CHECK__(hipMemcpyAsync(worknode_d.get(), worknode_h.get(), sizeof(*worknode_h), hipMemcpyHostToDevice, getEnqueingStream()));

    // Set worknode_d->wrapper_fn by copying it from previous_worknode
    static_assert(offsetof(WorkNode_Header, wrapper_fn) == 0);
    __LIBGPU_HIP_CHECK__(hipMemcpyAsync(worknode_d.get(), previous_worknode.get(), sizeof(worknode_d->wrapper_fn), hipMemcpyDeviceToDevice, getEnqueingStream()));

    hipEvent_t event; // Create a synchronization point so we can make sure both copies are finished before worknode_h and previous_worknode go out of scope.
    __LIBGPU_HIP_CHECK__(hipEventCreate(&event));
    __LIBGPU_HIP_CHECK__(hipEventRecord(event, getEnqueingStream()));

    insertWorkNodeIntoCPUQueue(worknode_d.get(), myCount);

    // Make sure that we're finished with worknode_h and previous_worknode before they go out of scope.
    __LIBGPU_HIP_CHECK__(hipEventSynchronize(event));
    __LIBGPU_HIP_CHECK__(hipEventDestroy(event));
#endif
}

template <class Fn_t, class... Args_t>
inline __device__ thread::thread(uint32_t width [[maybe_unused]], Fn_t &&typed_fn [[maybe_unused]], Args_t &&...args [[maybe_unused]]) {
#ifdef __HIP_DEVICE_COMPILE__
    assert(width <= MAX_THREAD_WIDTH);
    assert(threadIdx.x == 0);
    auto typed_worknode_ptr = make_worknode(width, std::forward<Fn_t>(typed_fn), std::forward<Args_t>(args)...);

    // First two are prerequisites for the third, and produce more user-friendly error messages
    static_assert(std::is_trivially_destructible_v<Fn_t>);
    static_assert((std::is_trivially_destructible_v<Args_t> && ...));
    // gpu::thread loses the information about what type WorkNode<Callable_t> is, so can't call the destructor
    static_assert(std::is_trivially_destructible_v<decltype(*typed_worknode_ptr)>);

    // Because of pointer-interconvertability of WorkNode<Callable_t> and WorkNode<Callable_t>::header, reading from
    // worknode_d shouldn't result in a strict-aliasing violation.
    worknode_d = reinterpret_cast<WorkNode_Header *>(typed_worknode_ptr);
    // TODO: Should we bother initializing worknodeSize? It's never used in device code...

    insertWorkNodeIntoMainQueue(worknode_d);
#endif // __HIP_DEVICE_COMPILE__
}

