using internal::thread;

namespace this_thread {
static inline __device__ gpu::thread::id get_id() noexcept {
    using namespace internal;
    return currentWorkNode[blockIdx.x]->vthread_id + threadIdx.x;
}

static inline __device__ void pseudo_yield() {
    using namespace internal;

    // TODO: This won't work if the new thread has a width greater than the current one.
    // What happens if we just force the Exec mask to all 1s using inline asm?

    // TODO: what kind of synchronization do we need here? Is this good enough?
    __threadfence();

    invokeNext();
}
static inline __device__ unsigned int get_width() noexcept {
    using namespace internal;
    return currentWorkNode[blockIdx.x]->width;
}
static inline __device__ unsigned int get_lane_id() noexcept {
    using namespace internal;
    return threadIdx.x;
}

} // namespace this_thread

static inline __host__ void start() {
    using namespace internal;
    if (started) {
        throw std::logic_error("gpu::start() called twice");
    }
    started = true;
    // TODO: investigate using hipExtStreamCreateWithCUMask for this
    __LIBGPU_HIP_CHECK__(hipStreamCreateWithFlags(&mainStream, hipStreamNonBlocking));
    hipLaunchKernelGGL(threading_main, dim3(thread::hardware_concurrency()), dim3(MAX_THREAD_WIDTH), 0, mainStream);
}

static inline __host__ void finish(bool blocking = true) {
    using namespace internal;
    if (!started) {
        throw std::logic_error("called gpu::finish() before calling gpu::start()");
    }
    bool temp = true;
    __LIBGPU_HIP_CHECK__(hipMemcpyToSymbolAsync(HIP_SYMBOL(finishing), &temp, sizeof(bool), 0, hipMemcpyHostToDevice, getEnqueingStream()));
    if (blocking) {
        // We could wait for the memcpy to finish (with hipStreamSynchronize(enqueingStream)) before
        // synchronizing on mainStream, but there's no need.
        __LIBGPU_HIP_CHECK__(hipStreamSynchronize(mainStream));
        __LIBGPU_HIP_CHECK__(hipStreamDestroy(mainStream));
        // Don't destroy enqueingStream because unlike mainStream we won't re-create it if the user decides to 're-start the GPU'
    }
}

[[gnu::const]]
inline __host__ unsigned int thread::hardware_concurrency() noexcept {
    try {
        uint32_t temp;
        __LIBGPU_HIP_CHECK__(hipMemcpyFromSymbol(&temp, HIP_SYMBOL(numVcores), sizeof(temp), 0, hipMemcpyDeviceToHost));
        return temp;
    }
    catch (...) {
        std::cerr << "Exception while fetching numVcores\n";
        return 1;
    }
}

__host__ __device__ inline thread::id thread::get_id(uint32_t index) const {
    if (!joinable()) {
        return {};
    }

#ifdef __HIP_DEVICE_COMPILE__
    // Don't need to lock because it's illegal for gpu::thread::detach to be called at the same time as any other
    // gpu::thread method, so we know worknode_d won't change while we're in this function.
    // Also, since vthread_id doesn't change, we don't need to force a fetch from memory, a cached value is fine.
    assert(index < worknode_d->width);
    return worknode_d->vthread_id + index;
#else
    // Don't need to lock because it's illegal for gpu::thread::detach to be called at the same time as any other
    // gpu::thread method, so we know worknode_d won't change while we're in this function.
    // Also, since the memcpy happens in the same stream as the thread constructor launches insertWorkNodeFromHost, we
    // know the memcpy happens after the vthread_id has been assigned.
    // TODO: Is there any way for insertWorkNodeFromHost to be finished and for the write to worknode_d->vthread_id to
    // still be waiting in a cache somewhere? I'm pretty sure the answer is no.
    WorkNode_Header hdr;
    // Copy just the parts we need. Almost guaranteed to copy 2 uint32_ts of data starting at &(worknode_d->width).
    // TODO: Do we want to store a copy of the vthread_id in gpu::thread (and only fetch from worknode_d->vthread_id if the cached copy is invalid)?
    if constexpr (offsetof(WorkNode_Header, width) < offsetof(WorkNode_Header, vthread_id)) {
        constexpr size_t size = (offsetof(WorkNode_Header, vthread_id) - offsetof(WorkNode_Header, width)) + sizeof(worknode_d->vthread_id);
        __LIBGPU_HIP_CHECK__(hipMemcpyAsync(&(hdr.width), &(worknode_d->width), size, hipMemcpyDeviceToHost, getEnqueingStream()));
    } else {
        constexpr size_t size = (offsetof(WorkNode_Header, width) - offsetof(WorkNode_Header, vthread_id)) + sizeof(worknode_d->width);
        __LIBGPU_HIP_CHECK__(hipMemcpyAsync(&(hdr.vthread_id), &(worknode_d->vthread_id), size, hipMemcpyDeviceToHost, getEnqueingStream()));
    }
    __LIBGPU_HIP_CHECK__(hipStreamSynchronize(getEnqueingStream()));

    if (index >= hdr.width) {
        throw std::out_of_range("thread::get_id: index is greater than thread width");
    }
    return hdr.vthread_id + index;
#endif // !__HIP_DEVICE_COMPILE__
}

__host__ __device__ inline thread &thread::operator=(thread &&other) noexcept {
#ifdef __HIP_DEVICE_COMPILE__
    if (joinable()) {
        assert(!joinable() && "Attempted to assign to a gpu::thread object that still has an associated thread");
    }

    worknode_d = other.worknode_d;
    other.worknode_d = nullptr;
    // We can skip setting worknodeSize b/c it's only needed for thread::detach in host code.
#else
    if (joinable()) {
        std::terminate();
    }

    worknode_d = std::move(other.worknode_d);
    worknodeSize = other.worknodeSize;
#endif // !__HIP_DEVICE_COMPILE__
    return *this;
}

template <class Fn_t, class... Args_t>
inline __host__ thread::thread(uint32_t width, Fn_t &&typed_fn, Args_t &&...args) {
    if (width > MAX_THREAD_WIDTH) {
        throw std::length_error("thread::thread: width must not exceed " + std::to_string(MAX_THREAD_WIDTH));
    }
    std::unique_ptr worknode_h = make_worknode(width, std::forward<Fn_t>(typed_fn), std::forward<Args_t>(args)...);
    // First two are prerequisites for the third, and produce more user-friendly error messages
    // Note: is_trivially_copyable can behave strangely for extended lambdas. See
    // https://docs.nvidia.com/cuda/cuda-c-programming-guide/index.html 14.7.2.18 Extended Lambda Restrictions
    static_assert(std::is_trivially_copyable_v<std::remove_reference_t<Fn_t>>);
    static_assert((std::is_trivially_copyable_v<std::remove_reference_t<Args_t>> && ...));
    // We're about to memcpy the WorkNode from host to device memory. Make sure that's ok.
    // TODO: could these requirements be relaxed to is_trivially_destructible<T> and
    // is_trivially_constructible<remove_ref<T>, decltype(t)> (i.e. is_trivially_move_constructible or
    // is_trivially_copy_constructible depending on if T is rvalue or lvalue ref)?
    // Note: Do we need to worry about non-object Fn_t's?
    static_assert(std::is_trivially_copyable_v<typename decltype(worknode_h)::element_type>);

#ifdef __HIP_DEVICE_COMPILE__
    // Need to make sure that the insertWorkNodeFromHost template is always instantiated
    hipLaunchKernelGGL(insertWorkNodeFromHost<decltype(worknode_h->fn)>, dim3(1), dim3(1), 0, getEnqueingStream(), worknode_d);
#else
    {
        WorkNode_Header *temp_ptr;
        // TODO: do we even want to move the worknode into device memory, or just leave it in pinned host memory?
        __LIBGPU_HIP_CHECK__(hipMallocAsync(&temp_ptr, sizeof(*worknode_h), getEnqueingStream()));
        worknode_d = std::shared_ptr<WorkNode_Header>(temp_ptr, [](WorkNode_Header *ptr) {
            // WorkNode<T> is trivially destructible (implied by std::is_trivially_copyable).
            __LIBGPU_HIP_CHECK__(hipFreeAsync(ptr, getEnqueingStream()));
        });
    }

    worknodeSize = sizeof(*worknode_h);

    // Pointer to the last worknode_d we constructed that had the same Fn_t and Args_t template arguments.
    static std::weak_ptr<WorkNode_Header> previous_worknode_weak;
    std::shared_ptr<WorkNode_Header> previous_worknode = previous_worknode_weak.lock();
    previous_worknode_weak = worknode_d;
    if (previous_worknode == nullptr) {
        sendWorkNodeViaKernel<decltype(worknode_h->fn)>(std::move(worknode_h));
    } else {
        sendWorkNodeViaBuffer<decltype(worknode_h->fn)>(std::move(worknode_h), std::move(previous_worknode));
    }
#endif //!__HIP_DEVICE_COMPILE__
}

template <class Callable_t>
inline __host__ void
thread::sendWorkNodeViaKernel(std::unique_ptr<internal::WorkNode<Callable_t>> worknode_h [[maybe_unused]]) {
#ifndef __HIP_DEVICE_COMPILE__
    // Maybe we want to do this memcpy in the kernel?
    __LIBGPU_HIP_CHECK__(hipMemcpyAsync(worknode_d.get(), worknode_h.get(), sizeof(*worknode_h), hipMemcpyHostToDevice, getEnqueingStream()));

    hipEvent_t event; // Create a synchronization point after hipMemcpyAsync, so we can make sure the copy is finished before unregistering and/or freeing worknode_h.
    __LIBGPU_HIP_CHECK__(hipEventCreate(&event));
    __LIBGPU_HIP_CHECK__(hipEventRecord(event, getEnqueingStream()));

    hipLaunchKernelGGL(insertWorkNodeFromHost<decltype(worknode_h->fn)>, dim3(1), dim3(1), 0, getEnqueingStream(), worknode_d.get());

    // Make sure that the copy is finished before worknode_h goes out of scope and gets unregistered and/or destroyed.
    __LIBGPU_HIP_CHECK__(hipEventSynchronize(event));
    __LIBGPU_HIP_CHECK__(hipEventDestroy(event));
#endif //!__HIP_DEVICE_COMPILE__
}

template <class Callable_t>
inline __host__ void
thread::sendWorkNodeViaBuffer(std::unique_ptr<internal::WorkNode<Callable_t>> worknode_h [[maybe_unused]],
                              std::shared_ptr<WorkNode_Header> previous_worknode [[maybe_unused]]) {
#ifndef __HIP_DEVICE_COMPILE__
    const uint32_t myCount = cpuWorkQueueIndex_push++;
    const size_t myIndex = myCount % CPU_WORK_QUEUE_SIZE;

    // Set worknode_h->link_to_self = &cpuWorkQueue[myIndex];
    static WorkNode_Header ** const cpuWorkQueueAddr = static_cast<WorkNode_Header **>([](){
        void *temp;
        __LIBGPU_HIP_CHECK__(hipGetSymbolAddress(&temp, HIP_SYMBOL(cpuWorkQueue)));
        return temp;
    }());
    worknode_h->header.link_to_self = &cpuWorkQueueAddr[myIndex];

    // TODO: set worknode_h->vthread_id

    // Initialize worknode_d using worknode_h
    __LIBGPU_HIP_CHECK__(hipMemcpyAsync(worknode_d.get(), worknode_h.get(), sizeof(*worknode_h), hipMemcpyHostToDevice, getEnqueingStream()));

    // Set worknode_d->wrapper_fn by copying it from previous_worknode
    static_assert(offsetof(WorkNode_Header, wrapper_fn) == 0);
    __LIBGPU_HIP_CHECK__(hipMemcpyAsync(worknode_d.get(), previous_worknode.get(), sizeof(worknode_d->wrapper_fn), hipMemcpyDeviceToDevice, getEnqueingStream()));

    hipEvent_t event; // Create a synchronization point so we can make sure both copies are finished before worknode_h and previous_worknode go out of scope.
    __LIBGPU_HIP_CHECK__(hipEventCreate(&event));
    __LIBGPU_HIP_CHECK__(hipEventRecord(event, getEnqueingStream()));

    // Make sure we aren't about to overwrite an existing piece of work in cpuWorkQueue
    for (uint32_t deviceIndex = 0; myCount - deviceIndex >= CPU_WORK_QUEUE_SIZE; ) {
        // TODO: should we put this in a different stream so the copy from Device to Host can happen at the same time as other copies from Host to Device?
        __LIBGPU_HIP_CHECK__(hipMemcpyFromSymbolAsync(&deviceIndex, HIP_SYMBOL(cpuWorkQueueIndex_pop), sizeof(deviceIndex), 0, hipMemcpyDeviceToHost, getEnqueingStream()));
        __LIBGPU_HIP_CHECK__(hipStreamSynchronize(getEnqueingStream()));
        // Maybe sleep or yield here? On the other hand, hipStreamSynchronize is a blocking call that is likely to take a while
    }

    static WorkNode_Header *raw_ptrs[CPU_WORK_QUEUE_SIZE] = {};
    raw_ptrs[myIndex] = worknode_d.get();
    // Set cpuWorkQueue[myIndex] = worknode_d;
    __LIBGPU_HIP_CHECK__(hipMemcpyToSymbolAsync(HIP_SYMBOL(cpuWorkQueue), &raw_ptrs[myIndex], sizeof(void*), myIndex * sizeof(void*), hipMemcpyHostToDevice, getEnqueingStream()));

    // Make sure that we're finished with worknode_h and previous_worknode before they go out of scope.
    __LIBGPU_HIP_CHECK__(hipEventSynchronize(event));
    __LIBGPU_HIP_CHECK__(hipEventDestroy(event));
#endif
}

template <class Fn_t, class... Args_t>
inline __device__ thread::thread(uint32_t width [[maybe_unused]], Fn_t &&typed_fn [[maybe_unused]], Args_t &&...args [[maybe_unused]]) {
#ifdef __HIP_DEVICE_COMPILE__
    assert(width <= MAX_THREAD_WIDTH);
    assert(threadIdx.x == 0);
    auto typed_worknode_ptr = make_worknode(width, std::forward<Fn_t>(typed_fn), std::forward<Args_t>(args)...);

    // First two are prerequisites for the third, and produce more user-friendly error messages
    static_assert(std::is_trivially_destructible_v<Fn_t>);
    static_assert((std::is_trivially_destructible_v<Args_t> && ...));
    // gpu::thread loses the information about what type WorkNode<Callable_t> is, so can't call the destructor
    static_assert(std::is_trivially_destructible_v<decltype(*typed_worknode_ptr)>);

    // Because of pointer-interconvertability of WorkNode<Callable_t> and WorkNode<Callable_t>::header, reading from
    // worknode_d shouldn't result in a strict-aliasing violation.
    worknode_d = reinterpret_cast<WorkNode_Header *>(typed_worknode_ptr);
    // TODO: Should we bother initializing worknodeSize? It's never used in device code...

    WorkNode_Header **currentTail = lockAndFetchTail();
    insertWorkNode(currentTail, worknode_d);
    setAndUnlockTail(&(worknode_d->next));
#endif // __HIP_DEVICE_COMPILE__
}

__host__ __device__ inline thread::~thread() {
    if (joinable()) {
#ifdef __HIP_DEVICE_COMPILE__
        assert(!joinable() && "Attempted to destroy a gpu::thread object that still has an associated thread");
#else
        std::terminate();
#endif
    }
}

__host__ __device__ inline void thread::join() {
#ifdef __HIP_DEVICE_COMPILE__
    // TODO: check that the user has called gpu::start(), in case they use a hip kernel launch to get here
    if (!joinable()) {
        assert(joinable() && "Attempted to join a gpu::thread object that doesn't have an associated thread");
    }
    // This is safe b/c if we call join on ourself, then 1) we were the ones to write to currentWorkNode[blockIdx.x], so
    // a cached value is ok. 2) Nobody else can call detach on us, so currentWorkNode[blockIdx.x] won't get updated.
    if (currentWorkNode[blockIdx.x] == worknode_d) {
        assert(false && "Attempted to join the gpu::thread object associated with the active thread");
    }
    // We don't need to lock here because we know nobody is going to call detach on worknode_d, but we do need to make
    // sure that this does a load from memory and not a cache, so we use an atomicAdd(..., 0).
    //
    // Note that link_to_self == nullptr implies the thread has finished, since we can't possibly have called detach
    while (atomicAdd(reinterpret_cast<uintptr_t *>(&(worknode_d->link_to_self)), 0) != 0) {
        // spin while we wait for it to finish.
        __builtin_amdgcn_s_sleep(8);
    }

    // WorkNode<T> is trivially destructible (checked in gpu::thread constructor), so we can safely use free instead
    // of delete
    ::free(worknode_d);
    worknode_d = nullptr;
#else
    if (!started) {
        throw std::logic_error("called gpu::thread::join() before calling gpu::start()");
    }
    if (!joinable()) {
        throw std::system_error(std::error_code(EINVAL, std::system_category()), "thread::join failed");
    }

    // We don't have to worry about worknode_d getting invalidated by detach because we would have to be the one calling detach
    for (WorkNode_Header **link_to_self = reinterpret_cast<WorkNode_Header **>(1); link_to_self != nullptr;) {
        __LIBGPU_HIP_CHECK__(hipMemcpyAsync(&link_to_self, &(worknode_d->link_to_self), sizeof(worknode_d->link_to_self), hipMemcpyDeviceToHost, getEnqueingStream()));
        __LIBGPU_HIP_CHECK__(hipStreamSynchronize(getEnqueingStream()));
        // Maybe sleep or yield here? On the other hand, hipStreamSynchronize is a blocking call that is likely to take a while
    }
    worknode_d = nullptr;
#endif // !__HIP_DEVICE_COMPILE__
}

__host__ __device__ inline void thread::detach() {
#ifndef __HIP_DEVICE_COMPILE__
    if (!joinable()) {
        throw std::system_error(std::error_code(EINVAL, std::system_category()), "thread::detach failed");
    }
    hipLaunchKernelGGL(detachWorkNode, dim3(1), dim3(1), 0, getEnqueingStream(), worknode_d.get(), worknodeSize);
    worknode_d = nullptr;
#else
    if (!joinable()) {
        assert(joinable() && "Attempted to detach a gpu::thread object that doesn't have an associated thread");
    }
    WorkNode_Header **currentTail;
    if (threadIdx.x == 0)
        currentTail = lockAndFetchTail();

    if (worknode_d->link_to_self == nullptr) {
        // It's already finished, so we have the only pointer to worknode_d. Thus, we can just free the memory.
        ::free(worknode_d);
    } else {
        worknode_d->link_to_self = nullptr;
        // Since the gpu::thread instance is in device memory, we know the gpu did the allocation for worknode_d, no need to
        // copy the data to memory the gpu can free on its own.
    }

    if (threadIdx.x == 0)
        setAndUnlockTail(currentTail);

    worknode_d = nullptr;
#endif // __HIP_DEVICE_COMPILE__
}

