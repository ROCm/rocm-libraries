#----------------------------------------------------------------------------------
# Basic project info
#----------------------------------------------------------------------------------
PROJECT_NAME           = "hipThreads"
PROJECT_BRIEF          = "HIP-based GPU threading primitives"
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO

# If you keep a high‑level intro in docs/index.md use:
USE_MDFILE_AS_MAINPAGE = docs/index.md

#----------------------------------------------------------------------------------
# Inputs
#----------------------------------------------------------------------------------
INPUT                  = inc src docs/index.md README.md docs/standard_api docs/setup.md docs/releases.md
LAYOUT_FILE            = docs/doxygen_layout.xml
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.hh *.hxx *.inl *.ipp *.c *.cc *.cxx *.cpp *.dox *.md \
                          mutex pseudo_mutex pseudo_condition_variable 
EXTENSION_MAPPING      = no_extension=C++
EXCLUDE                = build
EXCLUDE_PATTERNS       = */CMakeFiles/* */_deps/*

#----------------------------------------------------------------------------------
# Source parsing
#----------------------------------------------------------------------------------
EXTRACT_ALL            = YES          # Turn off later if you only want documented API
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = NO
MULTILINE_CPP_IS_BRIEF = YES
INLINE_INHERITED_MEMB  = NO

#----------------------------------------------------------------------------------
# Warnings
#----------------------------------------------------------------------------------
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO
WARN_IF_DOC_ERROR      = YES
QUIET                  = NO

#----------------------------------------------------------------------------------
# Preprocessing (important for HIP / CUDA style qualifiers)
#----------------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
PREDEFINED             = \
  __host__= \
  __device__= \
  __global__= \
  __launch_bounds__(x)= \
  __forceinline__=inline \
  _LIBHIPTHREADS_EXPORTED_FROM_ABI= \
  __HIP_DEVICE_COMPILE__ \
  __shared__= \
  __constant__= \
  __managed__= \
  HIP_SYMBOL(x)=x \
  __LIBHIPTHREADS_HIP_CHECK__(x)=x \
  _LIBHIPTHREADS_TEMPLATE_VIS= \
  _LIBHIPTHREADS_TYPE_VIS= \
  _LIBHIPTHREADS_THREAD_SAFETY_ANNOTATION(x)= \
  _LIBHIPTHREADS_CONSTEXPR=constexpr \
  _LIBHIPTHREADS_HIDE_FROM_ABI= \
  _LIBHIPTHREADS_NODISCARD_EXT= \
  _LIBHIPTHREADS_CTAD_SUPPORTED_FOR_TYPE(x)= \
  _LIBHIPTHREADS_METHOD_TEMPLATE_IMPLICIT_INSTANTIATION_VIS \
  _NOEXCEPT=noexcept \
  cuda=hip 

# If some headers depend on these existing:
#  __AMDGCN__  __linux__  __cplusplus=202002L

# Ignore assert-like or logging macros from polluting docs (add as needed):
EXPAND_AS_DEFINED      = \
  assert

#----------------------------------------------------------------------------------
# Formatting / output
#----------------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
DISABLE_INDEX          = NO

GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO

SHOW_NAMESPACES = NO
SHOW_FILES = NO
SHOW_DIRECTORIES = NO
SHOW_GROUPED_MEMB_INC = NO

SOURCE_BROWSER         = NO
INLINE_SOURCES         = NO
VERBATIM_HEADERS       = NO
SHOW_INCLUDE_FILES     = NO

#----------------------------------------------------------------------------------
# Diagrams (enable Graphviz later if you want call/class graphs)
#----------------------------------------------------------------------------------
HAVE_DOT               = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
CLASS_DIAGRAMS         = NO

#----------------------------------------------------------------------------------
# Misc
#----------------------------------------------------------------------------------
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
SORT_GROUP_NAMES       = YES
SORT_BY_SCOPE_NAME     = YES
JAVADOC_AUTOBRIEF      = YES
TAB_SIZE               = 4
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

#----------------------------------------------------------------------------------
# Future knobs you may enable later (left here as reminders):
# GENERATE_XML        = YES
# HAVE_DOT            = YES
# CALL_GRAPH          = YES
# CLASS_DIAGRAMS      = YES
