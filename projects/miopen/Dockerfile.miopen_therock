ENV DEBIAN_FRONTEND=noninteractive
ENV HIP_PLATFORM=amd
ARG GPU_ARCHS=none
ARG PROJ="miopen"

# Install DVC + other dependencies
RUN apt-get update && apt-get install -y --allow-unauthenticated \
    apt-utils \
    ca-certificates \
    curl \
    libnuma-dev \
    gnupg2 \
    build-essential \
    # clang-format-12 \
    doxygen \
    git \
    gdb \
    gfortran \
    git-lfs \
    # half \
    lbzip2 \
    lcov \
    libncurses5-dev \
    cmake \
    g++ \
    pkg-config \
    xxd \
    patchelf \
    automake \
    python3-venv \
    python3-dev \
    libegl1-mesa-dev \
    curl \
    unzip \
    patchelf \
    libtool \
    python3-pip \
    vim \
    rsync \
    ca-certificates \
    wget \
    texinfo \
    bison \
    flex \
    stunnel \
    pkg-config \
    python3-dev \
