#include <miopen/db_path.hpp>
#include <miopen/env.hpp>
#include <miopen/stringutils.hpp>
#include <miopen/expanduser.hpp>
#include <miopen/filesystem_checker.hpp>
#include <miopen/logger.hpp>
#include <miopen/filesystem.hpp>

#include <cstdlib>
#include <string>
#ifdef __linux__
#include <dlfcn.h>
#endif
#ifdef _WIN32
#ifndef WIN32_LEAN_AND_MEAN
#define WIN32_LEAN_AND_MEAN
#endif
#include <windows.h>
#endif

MIOPEN_DECLARE_ENV_VAR_STR(MIOPEN_SYSTEM_DB_PATH)
MIOPEN_DECLARE_ENV_VAR_STR(MIOPEN_USER_DB_PATH)
MIOPEN_DECLARE_ENV_VAR_BOOL(MIOPEN_DEBUG_DISABLE_SYSTEM_DB)
MIOPEN_DECLARE_ENV_VAR_BOOL(MIOPEN_DEBUG_DISABLE_USER_DB)

namespace miopen {

#ifdef __linux__
fs::path GetLibPath()
{
    fs::path path;
    Dl_info info;

    if(dladdr(reinterpret_cast<void*>(miopenCreate), &info) != 0)
    {
        path = fs::canonical(fs::path{info.dli_fname});
        MIOPEN_LOG_I2("Lib Path: " << path);
        if(!path.has_parent_path())
            return path;

        path = path.parent_path();
    }
    return path;
}
#endif

#ifdef _WIN32
fs::path GetLibPath()
{
    // Mirrors GetOwningModuleDirectory() in src/solver/ck_impl_lib_loader.cpp: locate the module
    // that owns a known MIOpen symbol, so the result follows MIOpen.dll rather than the process
    // that loaded it.
    HMODULE hmod = nullptr;
    if(GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
                              GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
                          reinterpret_cast<LPCWSTR>(miopenCreate),
                          &hmod) != 0)
    {
        // Windows paths top out at 32767 wide characters even with long-path support, so the
        // buffer never needs to grow past that. Capping it keeps a misbehaving
        // GetModuleFileNameW (one that keeps reporting "buffer too small") from looping until
        // the allocation fails, at the cost of giving up on a path that cannot exist.
        constexpr size_t max_module_path = 32768;
        std::wstring module_path(MAX_PATH, L'\0');
        while(true)
        {
            const auto len = GetModuleFileNameW(
                hmod, module_path.data(), static_cast<DWORD>(module_path.size()));
            if(len == 0)
                break;
            if(len < module_path.size())
            {
                module_path.resize(len);
                auto path = miopen::weakly_canonical(fs::path{module_path}).parent_path();
                MIOPEN_LOG_I2("Lib Path: " << path);
                return path;
            }
            if(module_path.size() >= max_module_path)
            {
                MIOPEN_LOG_W("Module path exceeds " << max_module_path << " characters");
                break;
            }
            // Not std::min: this TU pulls in windows.h without NOMINMAX, so its min() macro
            // breaks the std:: call.
            const auto grown = module_path.size() * 2;
            module_path.resize(grown < max_module_path ? grown : max_module_path);
        }
    }
    return {};
}
#endif

fs::path GetSystemDbPath()
{
    auto p = env::value(MIOPEN_SYSTEM_DB_PATH);
    if(!p.empty())
        return p;
#if MIOPEN_BUILD_DEV
    // Development builds read the databases straight out of the build tree.
    return "${MIOPEN_SYSTEM_DB_PATH}";
#elif defined(_WIN32)
    // On Windows the databases are installed alongside MIOpen.dll (DATABASE_INSTALL_DIR is "bin"),
    // so resolve them relative to the loaded module. Falling back to the configured value would
    // make the lookup relative to the current working directory, which only finds the databases
    // when the process happens to be started from the install directory.
    static const auto lib_path = GetLibPath();
    if(lib_path.empty())
        return "${MIOPEN_SYSTEM_DB_PATH}";
    return lib_path;
#else
    // Get the module path and construct the db path
    static const auto lib_path = GetLibPath().parent_path() / "share/miopen/db";
    return lib_path;
#endif
}

/// \note env::enabled() reads the process environment exactly once, when the variable is first
/// touched, so neither predicate follows a setenv() issued after that point. What remains mutable
/// is the in-library override behind miopen::debug::env::UpdateEnvVariable(), which the tests use
/// to toggle the switches. Database objects therefore latch the answer at construction
/// (PlainTextDb::disable_file_io, SQLiteBase::disable_file_io) instead of re-querying it per
/// operation, so that a single instance cannot change its mind between its constructor and its
/// operations, nor in the middle of one.

bool IsSystemDbDisabled()
{
    return MIOPEN_DISABLE_SYSDB || env::enabled(MIOPEN_DEBUG_DISABLE_SYSTEM_DB);
}

bool IsUserDbDisabled()
{
    return MIOPEN_DISABLE_USERDB || env::enabled(MIOPEN_DEBUG_DISABLE_USER_DB);
}

namespace {
fs::path PrepareUserDbPath()
{
    /// If MIOPEN_USER_DB_PATH is set in the environment, then assume that the user wants
    /// the library to use exactly that path.
    const auto p = env::value(MIOPEN_USER_DB_PATH);
    if(!p.empty())
    {
        auto result = ExpandUser(p);
        return result;
    }
    /// \anchor nfs-detection
    /// Otherwise, check if the user-db-path denotes a network filesystem. If this is the case, then
    /// let's assume that the library is running on a cluster system, where home directory is shared
    /// between all the nodes. In order to prevent the slowdown due to concurrent file access, let's
    /// use the local temporary directory.
    /// WARNING: This makes all the library's user databases non-persistent. However, for now, we
    /// assume that the performance hit associated with the usage of shared home dir is worse than
    /// the deletion of user databases.
    auto result = ExpandUser("${MIOPEN_USER_DB_PATH}");
#if !MIOPEN_BUILD_DEV
    if(GetFilesystemChecker().IsNetworkedFilesystem(result))
    {
        result = fs::temp_directory_path() / ".config" / "miopen";
    }
#endif
    return result;
}
} // namespace

std::string GetUserDbSuffix() { return "${MIOPEN_USER_DB_SUFFIX}"; }

std::string GetSystemFindDbSuffix() { return "${MIOPEN_SYSTEM_FIND_DB_SUFFIX}"; }

namespace {
// Use static local variable to avoid non-const globals while allowing reset for testing
const fs::path*& UserDbPathPtrRef()
{
    static const fs::path* ptr = nullptr;
    return ptr;
}

const fs::path& GetUserDbPathInternal()
{
    auto& ptr = UserDbPathPtrRef();
    if(ptr == nullptr)
        ptr = new fs::path(PrepareUserDbPath());
    return *ptr;
}
} // namespace

const fs::path& GetUserDbPath() { return GetUserDbPathInternal(); }

#ifdef MIOPEN_BUILD_TESTING
namespace testing {
void ResetUserDbPath()
{
    delete UserDbPathPtrRef();
    UserDbPathPtrRef() = nullptr;
}
} // namespace testing
#endif

} // namespace miopen
