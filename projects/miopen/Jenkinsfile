def projDir = "projects"
def miopenDir = "${projDir}/miopen"
def ckDir = "${projDir}/composablekernel"

def rocmnode(name) {
    return '(rocmtest || miopen) && (' + name + ')'
}

// Returns the original PR branch tip SHA (pullHash) or branch HEAD SHA (hash)
// from the Jenkins SCMRevisionAction, which is recorded before any local merge.
// Returns null for non-SCM triggers; caller should handle fall back.
@NonCPS
String getGitHubCommitHash(def build)
{
    def scmAction = build?.actions.find { action ->
        action instanceof jenkins.scm.api.SCMRevisionAction
    }
    if (scmAction?.revision instanceof org.jenkinsci.plugins.github_branch_source.PullRequestSCMRevision)
    {
        return scmAction.revision.pullHash
    }
    else if (scmAction?.revision instanceof jenkins.plugins.git.AbstractGitSCMSource$SCMRevisionImpl)
    {
        return scmAction.revision.hash
    }
    return null
}

def get_branch_name(){
    def shared_library_branch = scm.branches[0].name
    if (shared_library_branch .contains("*/")) {
        shared_library_branch  = shared_library_branch.split("\\*/")[1]
    }
    echo "${shared_library_branch}"
    return shared_library_branch
}

/// Stage name format:
/// [DataType] Backend[/Compiler] BuildType [TestSet] [Target]
///
/// The only mandatory elements are Backend and BuildType; others are optional.
///
/// DataType := { Fp16 | Bf16 | Int8 | Fp32 }
/// Backend := { Hip | HipNoGPU}
/// Compiler := { Clang* | GCC* }
///   * "Clang" is the default for the Hip backend, and implies hip-clang compiler.
///   * The default compiler is usually not specified.
/// BuildType := { Release* | Debug | Install } [ BuildTypeModifier ]
///   * BuildTypeModifier := { NOCOMGR | Embedded | Static | Normal-Find | Fast-Find
///                            NOCK | NOMLIR | Tensile | Tensile-Latest | Package | ... }
/// TestSet := { All | Smoke* | <Performance Dataset> | Build-only }
///   * "All" corresponds to "cmake -DMIOPEN_TEST_ALL=On".
///   * "Smoke" (-DMIOPEN_TEST_ALL=Off) is the default and usually not specified.
///   * "Performance Dataset" is a performance test with a specified dataset.
/// Target := { gfx908 | gfx90a | gfx942 } [ Xnack+ ]

utils = null

// Removes the ASAN image from the local Docker daemon after the test stage.
// Falls back to ci_asan for normal CI runs where no candidate was built.
def cleanupAsanImage() {
    def imageToRemove = env.ASAN_CANDIDATE_IMAGE ?: "${env.MIOPEN_DOCKER_IMAGE_URL}:ci_asan"
    sh label: 'Remove ASAN Docker image', script: "docker rmi ${imageToRemove} || true"
}

def runPackageAndStaticChecksParallel() {
    def branches = [failFast: true]

    branches['HIP Package'] = {
        node(rocmnode("nogpu")) {
            try {
                runHipClangStage(package_build: true, needs_gpu: false, gpu_family: "ci")
            } finally { cleanWs() }
        }
    }
    branches['Clang Format'] = {
        node(rocmnode("nogpu")) {
            try {
                runHipClangStage(make_targets: "check_format", needs_gpu: false, gpu_family: "ci")
            } finally { cleanWs() }
        }
    }
    branches['Check GTest Format'] = {
        node(rocmnode("nogpu")) {
            try {
                withWorkingDir {
                    sh 'cd ./test/utils && python3 gtest_formating_checks.py'
                }
            } finally { cleanWs() }
        }
    }
    if (params.TARGET_NOGPU) {
        branches['HipNoGPU Debug Build Test'] = {
            node(rocmnode("nogpu")) {
                try {
                    runHipClangStage(build_type: 'debug',
                        setup_flags: "-DMIOPEN_BACKEND=HIPNOGPU -DMIOPEN_INSTALL_CXX_HEADERS=On",
                        build_cmd: "make -j\$(nproc)",
                        needs_gpu: false, gpu_family: "ci")
                } finally { cleanWs() }
            }
        }
    }
    branches['Tuna Fin Build Test'] = {
        node(rocmnode("nogpu")) {
            try {
                runHipClangStage(setup_flags: "-DMIOPEN_BACKEND=HIPNOGPU",
                    make_targets: "all", build_fin: "ON",
                    needs_gpu: false, build_install: true, gpu_family: "ci")
            } finally { cleanWs() }
        }
    }
    branches['Fp32 Hip Debug NOCK Build-Only'] = {
        node(rocmnode("nogpu")) {
            try {
                runHipClangStage(build_type: 'debug',
                    setup_flags: "-DMIOPEN_USE_COMPOSABLEKERNEL=Off",
                    make_targets: "", build_install: true,
                    needs_gpu: false, gpu_family: "ci")
            } finally { cleanWs() }
        }
    }

    parallel(branches)
}

def runFullTestsParallel() {
    def branches = [failFast: true]

    if (!params.BUILD_ASAN_DOCKER) {
        branches['Hip Tidy'] = {
            node(rocmnode("nogpu")) {
                try {
                    runHipClangStage(
                        setup_cmd: "CXX='/opt/rocm/llvm/bin/clang++' cmake -DCMAKE_PREFIX_PATH=/opt/rocm -DMIOPEN_BACKEND=HIP -DBUILD_DEV=On .. ",
                        build_cmd: "make -j\$(nproc) -k analyze",
                        needs_gpu: false, gpu_family: "ci")
                } finally { cleanWs() }
            }
        }
    }

    // GFX90A Tests
    if (params.DBSYNC_TEST && params.TARGET_GFX90A && !params.BUILD_ASAN_DOCKER) {
        branches['Dbsync gfx90a'] = {
            node(rocmnode("gfx90a")) {
                try { runDbSyncJob(gfx90a_flags, "ci") } finally { cleanWs() }
            }
        }
    }
    if (params.TARGET_GFX90A && params.DATATYPE_BF16 && !params.BUILD_ASAN_DOCKER) {
        branches['Bf16 Hip Install All gfx90a'] = {
            node(rocmnode("gfx90a")) {
                try {
                    runBuildAndSingleGtestJob(flags: Full_test + Bf16_flags + gfx90a_flags, build_timeout_minutes: Build_timeout_minutes, gpu_family: "ci")
                } finally { cleanWs() }
            }
        }
    }
    if (params.TARGET_GFX90A && params.DATATYPE_FP16 && !params.BUILD_ASAN_DOCKER) {
        branches['Fp16 Hip Install All gfx90a'] = {
            node(rocmnode("gfx90a")) {
                try {
                    runBuildAndSingleGtestJob(flags: Full_test + Fp16_flags + gfx90a_flags, build_timeout_minutes: Build_timeout_minutes, gpu_family: "ci")
                } finally { cleanWs() }
            }
        }
    }
    if (params.TARGET_GFX90A && params.DATATYPE_FP32 && !params.BUILD_ASAN_DOCKER) {
        branches['Fp32 Hip Install All gfx90a'] = {
            node(rocmnode("gfx90a")) {
                try {
                    runBuildAndSingleGtestJob(flags: Full_test + gfx90a_flags, build_timeout_minutes: Build_timeout_minutes, gpu_family: "ci")
                } finally { cleanWs() }
            }
        }
    }

    // GFX942 Tests — ASAN declared first so it enters the gfx942 queue sooner
    if (params.TARGET_GFX942 || params.BUILD_ASAN_DOCKER) {
        branches['ASAN Hip Install All gfx942'] = {
            node(rocmnode("gfx942")) {
                try {
                    runAsanTests("gfx942", "gfx942")
                } finally {
                    archiveArtifacts artifacts: 'shard_logs/asan_shard_*.log', allowEmptyArchive: true
                    cleanupAsanImage()
                    cleanWs()
                }
            }
        }
    }
    if (params.DBSYNC_TEST && (params.TARGET_GFX942 || params.WORKAROUND__TARGET_GFX942_MINIMUM_TEST_ENABLE) && !params.BUILD_ASAN_DOCKER) {
        branches['Dbsync gfx942'] = {
            node(rocmnode("gfx942")) {
                try { runDbSyncJob(gfx942_flags, "ci") } finally { cleanWs() }
            }
        }
    }
    if (params.TARGET_GFX942 && params.DATATYPE_BF16 && !params.BUILD_ASAN_DOCKER) {
        branches['Bf16 Hip Install All gfx942'] = {
            node(rocmnode("gfx942")) {
                try {
                    runBuildAndSingleGtestJob(flags: Full_test + Bf16_flags + gfx942_flags, build_timeout_minutes: Build_timeout_minutes, gpu_family: "ci")
                } finally { cleanWs() }
            }
        }
    }
    if (params.TARGET_GFX942 && params.DATATYPE_FP16 && !params.BUILD_ASAN_DOCKER) {
        branches['Fp16 Hip Install All gfx942'] = {
            node(rocmnode("gfx942")) {
                try {
                    runBuildAndSingleGtestJob(flags: Full_test + Fp16_flags + gfx942_flags, build_timeout_minutes: Build_timeout_minutes, gpu_family: "ci")
                } finally { cleanWs() }
            }
        }
    }
    if (params.TARGET_GFX942 && params.DATATYPE_FP32 && !params.BUILD_ASAN_DOCKER) {
        branches['Fp32 Hip Install All gfx942'] = {
            node(rocmnode("gfx942")) {
                try {
                    runBuildAndSingleGtestJob(flags: Full_test + gfx942_flags, build_timeout_minutes: Build_timeout_minutes, gpu_family: "ci")
                } finally { cleanWs() }
            }
        }
    }
    if (params.TARGET_GFX942 && params.DATATYPE_TF32 && !params.BUILD_ASAN_DOCKER) {
        branches['TF32 Hip Install All gfx942'] = {
            node(rocmnode("gfx942")) {
                try {
                    runBuildAndSingleGtestJob(flags: Full_test + Tf32_flags + gfx942_flags, build_timeout_minutes: Build_timeout_minutes, gpu_family: "ci")
                } finally { cleanWs() }
            }
        }
    }

    // GFX1101 Tests
    if (params.TARGET_NAVI32 && params.DATATYPE_FP16 && !params.BUILD_ASAN_DOCKER) {
        branches['Fp16 Hip Install All gfx1101'] = {
            node(rocmnode("navi32")) {
                try {
                    runBuildAndSingleGtestJob(flags: Full_test + Fp16_flags + gfx1101_flags, build_timeout_minutes: Build_timeout_minutes, gpu_family: "ci")
                } finally { cleanWs() }
            }
        }
    }
    if (params.TARGET_NAVI32 && params.DATATYPE_FP32 && !params.BUILD_ASAN_DOCKER) {
        branches['Fp32 Hip Install All gfx1101'] = {
            node(rocmnode("navi32")) {
                try {
                    runBuildAndSingleGtestJob(flags: Full_test + gfx1101_flags, build_timeout_minutes: Build_timeout_minutes, gpu_family: "ci")
                } finally { cleanWs() }
            }
        }
    }

    parallel(branches)
}

def show_node_info() {
    sh """
        echo "NODE_NAME = \$NODE_NAME"
        lsb_release -sd
        uname -r
        cat /sys/module/amdgpu/version
        ls /opt/ -la
    """
}

def cloneUpdateRefRepo() {
    def refRepoPath = "/var/jenkins/ref-repo/rocm-libraries"
    def lockLabel = "git ref repo lock - ${env.NODE_NAME}"
    def folderExists = sh(
        script: "test -d ${refRepoPath}/refs",
        returnStatus: true
    ) == 0

    if (!folderExists) {
        echo "rocm-libraries repo does not exist at ${refRepoPath}, creating mirror clone..."
        echo "locking on label: ${lockLabel}"
        lock(lockLabel) {
            def cloneCommand = """
                set -ex
                rm -rf ${refRepoPath} && mkdir -p ${refRepoPath}
                git clone --mirror https://github.com/ROCm/rocm-libraries.git ${refRepoPath}
            """
            sh(script: cloneCommand, label: "clone ref repo")
        }
        echo "Completed git clone, lock released"
    }
    echo "rocm-libraries repo exists at ${refRepoPath}, performing git remote update..."
    echo "locking on label: ${lockLabel}"
    lock(lockLabel) {
        def fetchCommand = """
            set -ex
            cd ${refRepoPath}
            git remote prune origin
            git remote update
        """
        sh(script: fetchCommand, label: "update ref repo")
    }
    echo "Completed git ref repo fetch, lock released"
}

def checkoutRepo()
{
    //update ref repo
    cloneUpdateRefRepo()
    def scmVars = checkout scm
    // getGitHubCommitHash reads SCMRevisionAction recorded before any local merge,
    // giving the true PR branch tip (pullHash) or branch HEAD (hash).
    // Falls back to ORIG_HEAD (pre-merge HEAD set by git merge) when SCMRevisionAction
    // is unavailable, then to HEAD for branch builds where no merge occurred.
    env.GIT_COMMIT = getGitHubCommitHash(currentBuild.rawBuild) ?: sh(returnStdout: true, script: '''
        git rev-parse ORIG_HEAD 2>/dev/null || git rev-parse HEAD
    ''').trim()
}

def withWorkingDir(Closure body) {
    show_node_info()
    checkoutRepo()
    dir("${env.WORKSPACE}/${env.MIOPEN_DIR}") {
        if (utils == null) {
            utils = load "vars/utils.groovy"
        }
        body()
    }
}

def runDbSyncJob(def flags, def gpu_family)
{
    script {
        withWorkingDir {
            utils.buildHipClangJob(dvc_pull: true,
                                setup_flags: "-DMIOPEN_TEST_DBSYNC=1" + flags,
                                make_targets: 'test_db_sync',
                                execute_cmd: './bin/test_db_sync',
                                needs_gpu:false,
                                build_install: true,
                                gpu_family: gpu_family
                                )
        }
    }
}

def runBuildAndSingleGtestJob(Map conf=[:])
{
    def flags = conf.get('flags', '')
    def build_timeout_minutes = (conf.get('build_timeout_minutes', 420) as Integer)
    def gpu_family = conf.get('gpu_family', null)

    script {
        withWorkingDir {
            def single_gtest_flags = " -DMIOPEN_TEST_DISCRETE=OFF -DGTEST_PARALLEL_LEVEL=4 "
            utils.buildHipClangJob(
                setup_flags: single_gtest_flags + flags, 
                build_cmd: "LLVM_PATH=/opt/rocm/llvm CTEST_PARALLEL_LEVEL=4 make -j\$(nproc) install miopen_gtest check",
                build_install:true,
                build_timeout:build_timeout_minutes,
                gpu_family: gpu_family)
        }
    }
}

def runHipClangStage(Map conf=[:]) {
    script {
        withWorkingDir {
            utils.buildHipClangJob(conf)
        }
    }
}

def runAsanTests(String gpuLabel, String gfxFamily) {
    withWorkingDir {
        def variant = env.STAGE_NAME
        def asanImage = env.ASAN_CANDIDATE_IMAGE?.trim() ? env.ASAN_CANDIDATE_IMAGE : "${env.MIOPEN_DOCKER_IMAGE_URL}:asan"
        def video_id = sh(returnStdout: true, script: 'getent group video | cut -d: -f3').trim()
        def render_id = sh(returnStdout: true, script: 'getent group render | cut -d: -f3').trim()
        def dockerOpts = "--user root " +
                         "--device=/dev/kfd --device=/dev/dri " +
                         "--group-add video --group-add render " +
                         "--cap-add=SYS_PTRACE --security-opt seccomp=unconfined " +
                         "--group-add=${video_id} --group-add=${render_id} " +
                         "-v ${env.WORKSPACE}:${env.WORKSPACE}"
        utils.setGithubStatus(variant, 'pending', 'In progress')
        try {
            withDockerRegistry([credentialsId: "docker_test_cred", url: ""]) {
                docker.image(asanImage).pull()
            }
            withDockerContainer(image: asanImage, args: dockerOpts) {
                timeout(time: 420, unit: 'MINUTES') {
                    sh label: 'Build MIOpen with ASAN', script: """
                        set -e
                        echo "Running as: \$(whoami)"
                        cd ${env.WORKSPACE}/${env.MIOPEN_DIR}
                        LOGNAME=temp-user dvc pull -v
                        rm -rf build && mkdir build && cd build

                        export LD_LIBRARY_PATH=\$LD_LIBRARY_PATH:\$(dirname \$(\${ROCM_PATH}/llvm/bin/clang --print-file-name libclang_rt.asan-x86_64.so))

                        CXX=\${ROCM_PATH}/llvm/bin/clang++ cmake \\
                            -DMIOPEN_TEST_FLAGS="--disable-verification-cache" \\
                            -DCMAKE_BUILD_TYPE=RelWithDebInfo \\
                            -DCMAKE_CXX_FLAGS_RELWITHDEBINFO="-O2 -g1" \\
                            -DCMAKE_CXX_FLAGS="-fsanitize=address -fno-omit-frame-pointer -g -shared-libasan" \\
                            -DCMAKE_INSTALL_PREFIX=\${ROCM_PATH} \\
                            -DCMAKE_PREFIX_PATH="\${ROCM_PATH};\${ROCM_PATH}/lib" \\
                            -DMIOPEN_USE_MLIR=OFF \\
                            -DMIOPEN_USE_COMPOSABLEKERNEL=ON \\
                            -DMIOPEN_TEST_DISCRETE=OFF \\
                            -DMIOPEN_GPU_SYNC=OFF \\
                            -DGTEST_PARALLEL_LEVEL=4 \\
                            -DMIOPEN_INSTALL_GPU_DATABASES=${gfxFamily} \\
                            -DGPU_TARGETS="${gfxFamily}:xnack+" \\
                            -DHIP_PLATFORM=amd \\
                            -DBUILD_TESTING=ON \\
                            -DENABLE_ASAN_PACKAGING=ON \\
                            -DTHEROCK_SANITIZER=ASAN \\
                            ..

                        ASAN_OPTIONS=detect_leaks=0 make -j\$(nproc) install
                    """.stripIndent()
                    def shardExit = sh label: 'Run ASAN shard tests', returnStatus: true, script: """#!/bin/bash
                        export LD_PRELOAD=\$(\${ROCM_PATH}/llvm/bin/clang --print-file-name libclang_rt.asan-x86_64.so)
                        export ASAN_OPTIONS="\${ASAN_OPTIONS}:print_stats=1"
                        . /opt/venv/bin/activate
                        cd /TheRock
                        SHARD_LOGS_DIR=${env.WORKSPACE}/shard_logs
                        mkdir -p \$SHARD_LOGS_DIR
                        overall_exit=0
                        pids=()
                        for i in \$(seq 1 4); do
                            (
                                THEROCK_BIN_DIR=\${ROCM_PATH}/bin \\
                                AMDGPU_FAMILIES=${gfxFamily} \\
                                TEST_TYPE=full \\
                                SHARD_INDEX=\$i \\
                                TOTAL_SHARDS=4 \\
                                python build_tools/github_actions/test_executable_scripts/test_miopen.py
                                echo \$? > \$SHARD_LOGS_DIR/asan_shard_\$i.exit
                            ) 2>&1 | tee \$SHARD_LOGS_DIR/asan_shard_\$i.log | sed "s/^/[shard \$i] /" &
                            pids+=(\$!)
                        done
                        for pid in "\${pids[@]}"; do
                            wait \$pid
                        done
                        for i in \$(seq 1 4); do
                            shard_exit=\$(cat \$SHARD_LOGS_DIR/asan_shard_\$i.exit 2>/dev/null || echo 1)
                            if [ "\$shard_exit" != "0" ]; then
                                echo "[shard \$i] FAILED with exit code \$shard_exit"
                                overall_exit=1
                            fi
                        done
                        exit \$overall_exit
                    """.stripIndent()
                    // Always fix permissions so cleanWs() can delete root-owned files,
                    // even when shards failed
                    sh label: 'Fix workspace permissions', script: "chmod -R a+w ${env.WORKSPACE} || true"
                    if (shardExit != 0) {
                        error("ASAN shard tests failed")
                    }
                }
            }
            utils.setGithubStatus(variant, 'success', 'Completed successfully')
        }
        catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException e) {
            utils.setGithubStatus(variant, 'error', 'Job cancelled or aborted')
            throw e
        }
        catch (Exception ex) {
            utils.setGithubStatus(variant, 'failure', 'Stage failed')
            throw ex
        }
    }
}

// Wraps the ASAN Docker build node+withWorkingDir+cleanWs boilerplate.
def runAsanDockerBuild() {
    node(rocmnode("docker")) {
        try {
            withWorkingDir {
                def candidateTag = buildAsanDockerImage(amdgpuFamilies: "gfx94X-dcgpu", amdgpuArchs: "gfx942")
                env.ASAN_CANDIDATE_IMAGE = candidateTag
            }
        } finally {
            sh "docker buildx rm ci-builder || true"
            sh "docker rmi ${env.ASAN_CANDIDATE_IMAGE} || true"
            cleanWs()
        }
    }
}

def promoteAsanDockerImage() {
    def variant = env.STAGE_NAME
    def candidateTag = "${env.MIOPEN_DOCKER_IMAGE_URL}:ci_asan_candidate"
    def finalTag = "${env.MIOPEN_DOCKER_IMAGE_URL}:asan"
    utils.setGithubStatus(variant, 'pending', 'In progress')
    try {
        withDockerRegistry([credentialsId: "docker_test_cred", url: ""]) {
            sh """
                docker pull ${candidateTag}
                docker tag ${candidateTag} ${finalTag}
                docker push ${finalTag}
            """.stripIndent()
        }
        utils.setGithubStatus(variant, 'success', 'Completed successfully')
    }
    catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException e) {
        utils.setGithubStatus(variant, 'error', 'Job cancelled or aborted')
        throw e
    }
    catch (Exception ex) {
        utils.setGithubStatus(variant, 'failure', 'Stage failed')
        throw ex
    }
}

def runAsanDockerPromote() {
    node(rocmnode("docker")) {
        try {
            withWorkingDir {
                promoteAsanDockerImage()
            }
        } finally {
            sh "docker rmi ${env.MIOPEN_DOCKER_IMAGE_URL}:ci_asan_candidate || true"
            sh "docker rmi ${env.MIOPEN_DOCKER_IMAGE_URL}:asan || true"
            cleanWs()
        }
    }
}

def buildAsanDockerImage(Map conf=[:]) {
    def variant = env.STAGE_NAME
    env.DOCKER_BUILDKIT = 1
    def asanTag = "${env.MIOPEN_DOCKER_IMAGE_URL}:ci_asan_candidate"
    def cacheRef = "${env.MIOPEN_DOCKER_IMAGE_URL}-ci-docker:asan_source_cache"
    def amdgpuFamilies = conf.get("amdgpuFamilies", "gfx94X-dcgpu")
    def amdgpuArchs = conf.get("amdgpuArchs", "gfx942")

    // Read TheRock hash from the single source of truth (same pattern as buildTheRockDockerImage)
    def theRockHash = sh(
        script: """
            grep -A 2 'therock-ref:' ${env.WORKSPACE}/.github/actions/ci-env/action.yml \
            | grep 'value:' | awk '{print \$2}' | tr -d '"'
        """.stripIndent(),
        returnStdout: true
    ).trim()

    def dockerArgs = "--build-arg BUILD_TYPE=source_build " +
                     "--build-arg AMDGPU_FAMILIES=\"${amdgpuFamilies}\" " +
                     "--build-arg GPU_ARCHS=\"${amdgpuArchs}\" " +
                     "--build-arg THEROCK_GIT_HASH=\"${theRockHash}\" " +
                     "--build-arg ASAN_SCCACHE_CACHE_BUSTER=\"MiOpen-ASAN-Docker-CK\" " +
                     " -f ${env.WORKSPACE}/${env.MIOPEN_DIR}/Dockerfile.ASAN "
    // Build context is projects/ so both composablekernel and miopen are reachable
    def buildContext = "${env.WORKSPACE}/${env.PROJ_DIR}/."
    def dockerCacheArgs = "--cache-from type=registry,ref=${cacheRef} " +
                          "--cache-to type=registry,ref=${cacheRef},compression=zstd,mode=min "

    echo "Building ASAN image ${asanTag} from source (TheRock=${theRockHash}, families=${amdgpuFamilies})"
    utils.setGithubStatus(variant, 'pending', 'In progress')
    try {
        withDockerRegistry([credentialsId: "docker_test_cred", url: ""]) {
            sh label: 'Set up Docker Buildx', script: """
                docker buildx inspect ci-builder >/dev/null 2>&1 || \
                docker buildx create --name ci-builder --driver docker-container --use
                docker buildx use ci-builder
                docker buildx inspect --bootstrap
            """.stripIndent()
            sh label: 'Build and push ASAN Docker image', script: """
                DOCKER_BUILDKIT=1 docker buildx build \
                  --push \
                  --tag ${asanTag} \
                  ${dockerCacheArgs} \
                  ${dockerArgs} \
                  ${buildContext}
            """.stripIndent()
        }
        utils.setGithubStatus(variant, 'success', 'Completed successfully')
    }
    catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException e) {
        utils.setGithubStatus(variant, 'error', 'Job cancelled or aborted')
        throw e
    }
    catch (Exception ex) {
        utils.setGithubStatus(variant, 'failure', 'Stage failed')
        throw ex
    }
    return asanTag
}

def runDockerBuild(String gpuFamily) {
    node(rocmnode("docker")) {
        try {
            withWorkingDir {
                def (dockerImage, imageName) = utils.getDockerImageWithStatus(gpu_family: gpuFamily)
                // Expose the built CI image name so Publish Dev Image can retag it directly.
                if (gpuFamily == "ci") {
                    env.CI_DOCKER_IMAGE = imageName
                }
            }
        } finally {
            cleanWs()
        }
    }
}

def runTheRockDockerBuild() {
    node(rocmnode("docker")) {
        try {
            withWorkingDir {
                def result = utils.buildTheRockDockerImage()
                // Expose values to subsequent stages via pipeline-scoped env vars.
                env.THEROCK_CANDIDATE_IMAGE = result.image    ?: ""
                env.THEROCK_FULL_HASH       = result.fullHash ?: ""
                env.THEROCK_SHORT_HASH      = result.shortHash ?: ""
                // "true" means the hash is already live on :therock - Promote stage is skipped.
                env.THEROCK_SKIP_UPDATE     = result.skip ? "true" : "false"
            }
        } finally {
            cleanWs()
        }
    }
}

def runDevImagePublish() {
    node(rocmnode("docker")) {
        try {
            withWorkingDir {
                utils.publishDevDockerImage()
            }
        } finally {
            cleanWs()
        }
    }
}

def runTheRockDockerPromote() {
    node(rocmnode("docker")) {
        try {
            withWorkingDir {
                utils.promoteTheRockDockerImage(
                    env.THEROCK_CANDIDATE_IMAGE,
                    env.THEROCK_FULL_HASH
                )
            }
        } finally {
            cleanWs()
        }
    }
}

//launch develop branch nightly/weekly jobs
CRON_SETTINGS = BRANCH_NAME == "develop" ? '''
0 0 * * * % RUN_NIGHTLY_TESTS=true;BUILD_PACKAGE_AND_CHECKS=false;BUILD_FULL_TESTS=false;TARGET_GFX908=false;TARGET_GFX90A=true;TARGET_GFX942=true
0 1 * * * % NONCRITICAL_HW_NIGHTLY=true;BUILD_PACKAGE_AND_CHECKS=false;BUILD_FULL_TESTS=false;TARGET_GFX908=true;TARGET_NAVI35=true;TARGET_GFX90A=false;TARGET_GFX942=false
0 22 * * * % BUILD_THEROCK_DOCKER=true
0 23 * * 0 % BUILD_ASAN_DOCKER=true;BUILD_DOCKER=false;BUILD_PACKAGE_AND_CHECKS=false;BUILD_FULL_TESTS=false
''' : ""


pipeline {
    agent none
    options {
        skipDefaultCheckout()
        parallelsAlwaysFailFast()
        // disable stage-wise timeout due to long wait with queue (limited resources)
        // timeout(time: 90, unit:'MINUTES')
    }
    triggers{
        parameterizedCron(CRON_SETTINGS)
    }
    parameters {
        booleanParam(
            name: "BUILD_DOCKER",
            defaultValue: true,
            description: "")
        booleanParam(
            name: "BUILD_THEROCK_DOCKER",
            defaultValue: false,
            description: "")
        booleanParam(
            name: "BUILD_SMOKE_FP32",
            defaultValue: true,
            description: "")
        booleanParam(
            name: "BUILD_SMOKE_AUX1",
            defaultValue: true,
            description: "")
        booleanParam(
            name: "BUILD_SMOKE_FP16_BF16_INT8",
            defaultValue: true,
            description: "")
        booleanParam(
            name: "BUILD_FULL_TESTS",
            defaultValue: true,
            description: "")
        booleanParam(
            name: "BUILD_PACKAGE_AND_CHECKS",
            defaultValue: true,
            description: "")
        booleanParam(
            name: "TARGET_NOGPU",
            defaultValue: true,
            description: "")
        booleanParam(
            name: "TARGET_GFX908",
            defaultValue: false,
            description: "")
        booleanParam(
            name: "TARGET_GFX90A",
            defaultValue: true,
            description: "")
        booleanParam(
            name: "TARGET_GFX942",
            defaultValue: true,
            description: "")
        booleanParam(
            name: "TARGET_NAVI32",
            defaultValue: false,
            description: "Navi3 currently fails to build with instruction not supported on this GPU error")
        booleanParam(
            name: "TARGET_NAVI35",
            defaultValue: false,
            description: "Navi3.5 Strix Halo")
        booleanParam(
            name: "TARGET_NAVI4",
            defaultValue: false,
            description: "Navi4 currently fails to build with instruction not supported on this GPU error")
        booleanParam(
            name: "DATATYPE_NA",
            defaultValue: true,
            description: "")
        booleanParam(
            name: "DATATYPE_FP32",
            defaultValue: true,
            description: "")
        booleanParam(
            name: "DATATYPE_TF32",
            defaultValue: true,
            description: "")
        booleanParam(
            name: "DATATYPE_FP16",
            defaultValue: true,
            description: "")
        booleanParam(
            name: "DATATYPE_BF16",
            defaultValue: true,
            description: "")
        booleanParam(
            name: "DATATYPE_INT8",
            defaultValue: true,
            description: "")
        booleanParam(
            name: "DBSYNC_TEST",
            defaultValue: true,
            description: "Enable database synchronization testing stages")
        string(name: "DOCKER_IMAGE_OVERRIDE",
            defaultValue: '',
            description: "")
        booleanParam(
            name: "WORKAROUND__TARGET_GFX942_MINIMUM_TEST_ENABLE",
            defaultValue: false,
            description: "")
        booleanParam(
            name: "USE_SCCACHE_DOCKER",
            defaultValue: true,
            description: "Use the sccache for building CK in the Docker Image (default: ON)")
        booleanParam(
            name: "BUILD_ASAN_DOCKER",
            defaultValue: false,
            description: "Build and push rocm/miopen-dev:ci_asan_candidate ASAN Docker image (run weekly on Sundays)")
        booleanParam(
            name: "RUN_NIGHTLY_TESTS",
            defaultValue: false,
            description: "Run the nightly tests (default: OFF)")
        booleanParam(
            name: "NONCRITICAL_HW_NIGHTLY",
            defaultValue: false,
            description: "Nightly builds for non-critical hardware (gfx908, Navi 3.5) (default: OFF)")
    }

    environment{
        extra_log_env   = " MIOPEN_LOG_LEVEL=5 "
        Fp16_flags      = " -DMIOPEN_TEST_HALF=On"
        Bf16_flags      = " -DMIOPEN_TEST_BFLOAT16=On"
        Int8_flags      = " -DMIOPEN_TEST_INT8=On"
        Full_test       = " -DMIOPEN_TEST_ALL=On"
        Tf32_flags      = " -DMIOPEN_TEST_TF32=On"

        gfx908_flags    = " -DMIOPEN_INSTALL_GPU_DATABASES=gfx908"
        gfx90a_flags    = " -DMIOPEN_INSTALL_GPU_DATABASES=gfx90a"
        gfx942_flags    = " -DMIOPEN_INSTALL_GPU_DATABASES=gfx942"
        gfx1151_flags   = " -DMIOPEN_INSTALL_GPU_DATABASES=gfx1151"
        gfx1101_flags   = " -DMIOPEN_INSTALL_GPU_DATABASES=gfx1101"

        Smoke_targets   = " check MIOpenDriver"
        NOCOMGR_flags   = " -DMIOPEN_USE_COMGR=Off"
        NOMLIR_flags    = " -DMIOPEN_USE_MLIR=Off"
        CK_DIR          = "${ckDir}"
        MIOPEN_DIR      = "${miopenDir}"
        PROJ_DIR        = "${projDir}"

        Build_timeout_minutes = 420
    }
    stages{
        // Builds rocm/miopen:therock-<hash> if the pinned hash changed; sets THEROCK_CANDIDATE_IMAGE.
        stage('Build TheRock Docker: Build') {
            when {
                expression { params.BUILD_THEROCK_DOCKER }
            }
            steps {
                script {
                    runTheRockDockerBuild()
                }
            }
        }
        // Always runs when BUILD_THEROCK_DOCKER=true, even if the TheRock hash is unchanged.
        // This is intentional: nightly CI catches CK regressions and produces the dev image
        // regardless of whether TheRock itself advanced.
        stage('Build Docker'){
            when {
                expression {
                    params.BUILD_THEROCK_DOCKER \
                    || (params.BUILD_DOCKER && params.TARGET_NOGPU && params.DATATYPE_NA)
                }
            }
            parallel {
                stage('Build Docker for CI') { steps { script { runDockerBuild('ci') } } } // Unified docker build for CI
                // stage('Build Docker gfx90X') { steps { script { runDockerBuild('gfx90X') } } }
                // stage('Build Docker gfx942, gfx950') { steps { script { runDockerBuild('gfx942_gfx950') } } }
                // stage('Build Docker Navi(gfx1101, gfx1151)') { steps { script { runDockerBuild('navi') } } }
            }
        }
        stage("Package and Static checks") {
            when {
                expression {
                    params.BUILD_THEROCK_DOCKER \
                    || (params.BUILD_PACKAGE_AND_CHECKS && params.TARGET_NOGPU && params.DATATYPE_NA)
                }
            }
            steps {
                script {
                    runPackageAndStaticChecksParallel()
                }
            }
        }
        stage('Build ASAN Docker for gfx942') {
            when {
                expression { params.BUILD_ASAN_DOCKER }
            }
            steps {
                script {
                    runAsanDockerBuild()
                }
            }
        }
        stage("Full Tests") {
            when {
                expression {
                    params.BUILD_FULL_TESTS || params.BUILD_THEROCK_DOCKER || params.BUILD_ASAN_DOCKER
                }
            }
            steps {
                script {
                    runFullTestsParallel()
                }
            }
        }
        // Promotes the candidate to :therock only after all CI stages pass.
        stage('Build TheRock Docker: Promote') {
            when {
                expression {
                    params.BUILD_THEROCK_DOCKER && env.THEROCK_SKIP_UPDATE != 'true' && !params.BUILD_ASAN_DOCKER
                }
            }
            steps {
                script {
                    runTheRockDockerPromote()
                }
            }
        }
        // Promotes ci_asan_candidate to :asan only after the ASAN test in Full Tests passes.
        stage('Promote ASAN Docker') {
            when {
                expression { params.BUILD_ASAN_DOCKER }
            }
            steps {
                script {
                    runAsanDockerPromote()
                }
            }
        }
        // Publishes rocm/miopen-dev:multiarch_dev_<date> and :latest after CI passes.
        stage('Publish Dev Image') {
            when {
                expression { params.BUILD_THEROCK_DOCKER && !params.BUILD_ASAN_DOCKER }
            }
            steps {
                script {
                    runDevImagePublish()
                }
            }
        }
        stage("Nightly Tests") {
            when {
                expression { params.RUN_NIGHTLY_TESTS }
            }
            parallel{
                stage('Mark Build As Nightly') {
                    agent{ label rocmnode("nogpu") }
                    steps{
                        script {
                            withWorkingDir {
                                // Adds a comment under the jenkins build number so you can tell it is a nightly build.
                                currentBuild.description = "Nightly Build"
                            }
                        }
                    }
                    post {
                        always {
                            cleanWs()
                        }
                    }
                }
                // GFX90A Tests
                stage('Fp32 Hip Debug NOMLIR gfx90a') {
                    when {
                        beforeAgent true
                        expression { params.TARGET_GFX90A }
                    }
                    agent{ label rocmnode("gfx90a") }
                    environment{
                        // Can be removed altogether with when WORKAROUND_SWDEV_290754.
                        NOMLIR_build_cmd = "CTEST_PARALLEL_LEVEL=4 MIOPEN_LOG_LEVEL=5 make -j\$(nproc) check"
                    }
                    steps{
                        runHipClangStage(build_type: 'debug', setup_flags: NOMLIR_flags + gfx90a_flags, build_cmd: NOMLIR_build_cmd, test_flags: ' --verbose ', build_install: true, gpu_family: "ci")
                    }
                    post {
                        always {
                            cleanWs()
                        }
                    }
                }
                stage('Fp32 Hip Static gfx90a') {
                    when {
                        beforeAgent true
                        expression { params.TARGET_GFX90A }
                    }
                    agent{ label rocmnode("gfx90a") }
                    steps{
                        runHipClangStage(setup_flags: "-DBUILD_SHARED_LIBS=Off" + gfx90a_flags, mlir_build: 'OFF', build_install: true, gpu_family: "ci")
                    }
                    post {
                        always {
                            cleanWs()
                        }
                    }
                }
                stage('Fp32 Hip Normal-Find gfx90a') {
                    when {
                        beforeAgent true
                        expression { params.TARGET_GFX90A }
                    }
                    agent{ label rocmnode("gfx90a") }
                    environment{
                        make_targets = "test_conv2d"
                        execute_cmd = "bin/test_conv2d --disable-verification-cache"
                    }
                    steps{
                        runHipClangStage(setup_flags: gfx90a_flags, make_targets: make_targets, execute_cmd: execute_cmd, find_mode: "Normal", build_install: true, gpu_family: "ci")
                    }
                    post {
                        always {
                            cleanWs()
                        }
                    }
                }
                stage('Fp32 Hip Fast-Find gfx90a') {
                    when {
                        beforeAgent true
                        expression { params.TARGET_GFX90A }
                    }
                    agent{ label rocmnode("gfx90a") }
                    environment{
                        make_targets =   "test_conv2d"
                        execute_cmd = "MIOPEN_FIND_MODE=2 CTEST_PARALLEL_LEVEL=4 bin/test_conv2d --disable-verification-cache"
                    }
                    steps{
                        runHipClangStage(setup_flags: gfx90a_flags, make_targets: make_targets, execute_cmd: execute_cmd, build_install: true, gpu_family: "ci")
                    }
                    post {
                        always {
                            cleanWs()
                        }
                    }
                }
                stage('Fp32 Hip SqlitePerfdb gfx90a') {
                    when {
                        beforeAgent true
                        expression { params.TARGET_GFX90A }
                    }
                    agent{ label rocmnode("gfx90a") }
                    steps{
                        runHipClangStage(make_targets: Smoke_targets, setup_flags: "-DMIOPEN_USE_SQLITE_PERF_DB=On" + gfx90a_flags, build_install: true, gpu_family: "ci")
                    }
                    post {
                        always {
                            cleanWs()
                        }
                    }
                }
                stage('Fp32 Hip Fin Interface gfx90a') {
                    when {
                        beforeAgent true
                        expression { params.TARGET_GFX90A }
                    }
                    agent{ label rocmnode("gfx90a") }
                    steps{
                        runHipClangStage(setup_flags: "-DMIOPEN_ENABLE_FIN_INTERFACE=On" + gfx90a_flags,
                                         make_targets: "test_unit_FinInterface",
                                         execute_cmd: "bin/test_unit_FinInterface",
                                         gpu_family: "ci")
                    }
                    post {
                        always {
                            cleanWs()
                        }
                    }
                }
                stage('Fp32 Hip Debug gfx90a') {
                    when {
                        beforeAgent true
                        expression { params.TARGET_GFX90A }
                    }
                    agent{ label rocmnode("gfx90a") }
                    steps{
                        runHipClangStage(setup_flags: gfx90a_flags, build_type: 'debug', make_targets: Smoke_targets, build_install: true, gpu_family: "ci")
                    }
                    post {
                        always {
                            cleanWs()
                        }
                    }
                }
                // GFX942 Tests
                stage('Fp32 Hip Debug gfx942') {
                    when {
                        beforeAgent true
                        expression { params.TARGET_GFX942 || params.WORKAROUND__TARGET_GFX942_MINIMUM_TEST_ENABLE }
                    }
                    agent{ label rocmnode("gfx942") }
                    steps{
                        runHipClangStage(setup_flags: gfx942_flags, build_type: 'debug', make_targets: Smoke_targets, build_install: true, gpu_family: "ci")
                    }
                    post {
                        always {
                            cleanWs()
                        }
                    }
                }
            }
        }
        stage("Non-Critical HW Nightly Tests") {
            when {
                expression { params.NONCRITICAL_HW_NIGHTLY }
            }
            parallel{
                stage('Mark Build As Nightly') {
                    agent{ label rocmnode("nogpu") }
                    steps{
                        script {
                            withWorkingDir {
                                // Adds a comment under the jenkins build number so you can tell it is a nightly build.
                                currentBuild.description = "Non-Critical HW Nightly Build"
                            }
                        }
                    }
                    post {
                        always {
                            cleanWs()
                        }
                    }
                }
                // GFX908 Tests
                stage('Dbsync gfx908') {
                    when {
                        beforeAgent true
                        expression { params.DBSYNC_TEST && params.TARGET_GFX908 }
                    }
                    agent{ label rocmnode("gfx908") }
                    steps{
                        runDbSyncJob(gfx908_flags, "ci")
                    }
                    post {
                        always {
                            cleanWs()
                        }
                    }
                }
                stage('Bf16 Hip Install All gfx908') {
                    when {
                        beforeAgent true
                        expression { params.TARGET_GFX908 && params.DATATYPE_BF16 }
                    }
                    agent{ label rocmnode("gfx908") }
                    steps{
                        runBuildAndSingleGtestJob(flags: Full_test + Bf16_flags + gfx908_flags, build_timeout_minutes: Build_timeout_minutes, gpu_family: "ci")
                    }
                    post {
                        always {
                            cleanWs()
                        }
                    }
                }
                stage('Fp16 Hip Install All gfx908') {
                    when {
                        beforeAgent true
                        expression { params.TARGET_GFX908 && params.DATATYPE_FP16 }
                    }
                    agent{ label rocmnode("gfx908") }
                    steps{
                        runBuildAndSingleGtestJob(flags: Full_test + Fp16_flags + gfx908_flags, build_timeout_minutes: Build_timeout_minutes, gpu_family: "ci")
                    }
                    post {
                        always {
                            cleanWs()
                        }
                    }
                }
                stage('Fp32 Hip Install All gfx908') {
                    when {
                        beforeAgent true
                        expression { params.TARGET_GFX908 && params.DATATYPE_FP32 }
                    }
                    agent{ label rocmnode("gfx908") }
                    steps{
                        runBuildAndSingleGtestJob(flags: Full_test + gfx908_flags, build_timeout_minutes: Build_timeout_minutes, gpu_family: "ci")
                    }
                    post {
                        always {
                            cleanWs()
                        }
                    }
                }
                stage('Fp32 Hip Debug gfx908') {
                    when {
                        beforeAgent true
                        expression { params.TARGET_GFX908 }
                    }
                    agent{ label rocmnode("gfx908") }
                    steps{
                        runHipClangStage(setup_flags: gfx908_flags, build_type: 'debug', make_targets: Smoke_targets, build_install: true, gpu_family: "ci")
                    }
                    post {
                        always {
                            cleanWs()
                        }
                    }
                }
                // GFX115X Strix Halo Tests
                stage('Bf16 Hip Install All gfx115X') {
                    when {
                        beforeAgent true
                        expression { params.TARGET_NAVI35 && params.DATATYPE_BF16 }
                    }
                    agent{ label rocmnode("strix") }
                    environment{
                        gfx115x_filter_flags = " -DMIOPEN_TEST_GFX115X=On "
                    }
                    steps{
                        runBuildAndSingleGtestJob(flags: gfx115x_filter_flags + Full_test + Bf16_flags + gfx1151_flags, build_timeout_minutes: Build_timeout_minutes, gpu_family: "ci")
                    }
                    post {
                        always {
                            cleanWs()
                        }
                    }
                }
                stage('Fp16 Hip Install All gfx115X') {
                    when {
                        beforeAgent true
                        expression { params.TARGET_NAVI35 && params.DATATYPE_FP16 }
                    }
                    agent{ label rocmnode("strix") }
                    environment{
                        gfx115x_filter_flags = " -DMIOPEN_TEST_GFX115X=On "
                        build_timeout_minutes = 420
                    }
                    steps{
                        runBuildAndSingleGtestJob(flags: gfx115x_filter_flags + Full_test + Fp16_flags + gfx1151_flags, build_timeout_minutes: Build_timeout_minutes, gpu_family: "ci")
                    }
                    post {
                        always {
                            cleanWs()
                        }
                    }
                }
                stage('Fp32 Hip Install All gfx115X') {
                    when {
                        beforeAgent true
                        expression { params.TARGET_NAVI35 && params.DATATYPE_FP32 }
                    }
                    agent{ label rocmnode("strix") }
                    environment{
                        gfx115x_filter_flags = " -DMIOPEN_TEST_GFX115X=On "
                        build_timeout_minutes = 420
                    }
                    steps{
                        runBuildAndSingleGtestJob(flags: gfx115x_filter_flags + Full_test + gfx1151_flags, build_timeout_minutes: Build_timeout_minutes, gpu_family: "ci")
                    }
                    post {
                        always {
                            cleanWs()
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                node {
                    utils.setGithubStatus('Math CI Summary', 'success', 'All checks have passed')
                }
            }
        }
        failure {
            script {
                node {
                    utils.setGithubStatus('Math CI Summary', 'failure', 'Some checks have failed')
                    utils.sendTeamsFailureNotification(buildTheRock: params.BUILD_THEROCK_DOCKER)
                }
            }
        }
    }
}
