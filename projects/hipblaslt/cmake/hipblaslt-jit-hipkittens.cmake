# The HipKittens JIT backend. The kernel template and the HipKittens headers it
# includes are compiled into the library; the headers come from the pinned
# HipKittens archive. Offline builds set FETCHCONTENT_SOURCE_DIR_HIPKITTENS to an
# unpacked archive of the pinned commit.
option(HIPBLASLT_JIT_ENABLE_HIPKITTENS "Build the JIT HipKittens backend." ON)
if(NOT HIPBLASLT_JIT_ENABLE_HIPKITTENS)
    return()
endif()
if(HIPBLASLT_ENABLE_YAML)
    message(WARNING "HIPBLASLT_JIT_ENABLE_HIPKITTENS: a build that reads YAML libraries has no "
                    "JIT library; building without the HipKittens backend")
    return()
endif()

set(_hk_gfx950 ${GPU_TARGETS})
list(FILTER _hk_gfx950 INCLUDE REGEX "^gfx950(:|$)")
if(NOT _hk_gfx950)
    message(WARNING "HIPBLASLT_JIT_ENABLE_HIPKITTENS: HipKittens has no kernel for "
                    "GPU_TARGETS (${GPU_TARGETS}); building without the HipKittens backend")
    return()
endif()

set(_hk_commit be1c91841b817c9690aa3af22ea771f8e3624bf4)
set(_hk_archive_sha256 036c8d9e4af25b1f25335567c4bcf4cb5b7f02fac6aa383a028c361aaff18b08)

include(FetchContent)
FetchContent_Declare(hipkittens
    URL https://github.com/HazyResearch/HipKittens/archive/${_hk_commit}.tar.gz
    URL_HASH SHA256=${_hk_archive_sha256}
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE
    SOURCE_SUBDIR do-not-configure)
FetchContent_MakeAvailable(hipkittens)

rocm_install(FILES "${hipkittens_SOURCE_DIR}/LICENSE"
    DESTINATION "${CMAKE_INSTALL_DOCDIR}/third-party/hipkittens"
    COMPONENT runtime)

set(_hk_include "${hipkittens_SOURCE_DIR}/include")
file(GLOB_RECURSE _hk_headers RELATIVE "${_hk_include}" "${_hk_include}/cdna4/*")
list(APPEND _hk_headers kittens.cuh pyutils/util.cuh)
list(SORT _hk_headers)

set(_hk_source "${PROJECT_SOURCE_DIR}/library/src/amd_detail")
set(_hk_template "${_hk_source}/hipkittens/gemm_tn_256x256x64_gfx950.hip")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_hk_template}")
file(READ "${_hk_template}" _hk_template_bytes HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _hk_template_bytes "${_hk_template_bytes}")
set(_hk_arrays "")
set(_hk_rows "")
set(_hk_index 0)
foreach(_hk_header IN LISTS _hk_headers)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_hk_include}/${_hk_header}")
    file(READ "${_hk_include}/${_hk_header}" _hk_bytes HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _hk_bytes "${_hk_bytes}")
    string(APPEND _hk_arrays "const unsigned char header${_hk_index}[] = {${_hk_bytes}};\n")
    string(APPEND _hk_rows "header(\"${_hk_header}\", header${_hk_index}),\n")
    math(EXPR _hk_index "${_hk_index} + 1")
endforeach()
set(_hk_resources "${CMAKE_CURRENT_BINARY_DIR}/hipblaslt-jit-hipkittens-resources.cpp")
file(CONFIGURE OUTPUT "${_hk_resources}" CONTENT [=[
// Generated by cmake/hipblaslt-jit-hipkittens.cmake; do not edit.
#include "hipblaslt-jit-hipkittens.hpp"

namespace hipblaslt_ext::experimental::jit::hipkittens::detail
{
    namespace
    {
        const unsigned char source[] = {@_hk_template_bytes@};
        @_hk_arrays@
        template <size_t Size>
        hipblaslt_jit::Artifact header(const char* name, const unsigned char (&bytes)[Size])
        {
            hipblaslt_jit::Artifact made;
            made.name  = name;
            made.bytes = {bytes, bytes + Size};
            return made;
        }
    }

    const Resources& resources()
    {
        static const Resources value{{source, source + sizeof(source)}, {@_hk_rows@}};
        return value;
    }
}
]=] @ONLY)

target_sources(hipblaslt PRIVATE "${_hk_source}/hipblaslt-jit-hipkittens.cpp" "${_hk_resources}")
set_source_files_properties("${_hk_resources}" TARGET_DIRECTORY hipblaslt
    PROPERTIES INCLUDE_DIRECTORIES "${_hk_source}")
target_compile_definitions(hipblaslt PRIVATE HIPBLASLT_JIT_HIPKITTENS)
