include(CMakeFindDependencyMacro)

find_dependency(hip)

if(@HIPBLASLT_ENABLE_HOST@)
    find_dependency(hipblas-common)
endif()
# Origami is bundled with hipBLASLt, not distributed as an independent ROCm
# package. Resolve the co-installed config even when the caller supplies only
# hipblaslt_DIR instead of the whole prefix in CMAKE_PREFIX_PATH.
find_dependency(origami CONFIG
    PATHS "${CMAKE_CURRENT_LIST_DIR}/../origami"
          "${CMAKE_CURRENT_LIST_DIR}/origami"
    NO_DEFAULT_PATH)

if(@HIPBLASLT_CONFIG_NEEDS_ZLIB@)
    find_dependency(ZLIB)
endif()

if(@HIPBLASLT_CONFIG_NEEDS_LLVM@)
    find_dependency(LLVM)
elseif(@HIPBLASLT_CONFIG_NEEDS_SERIALIZATION@)
    if(@HIPBLASLT_CONFIG_USES_MSGPACK_CXX@)
        find_dependency(msgpack-cxx CONFIG)
    else()
        find_dependency(msgpackc-cxx CONFIG NAMES msgpackc-cxx msgpack)
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/hipblaslt-targets.cmake")

if(@HIPBLASLT_BUNDLE_PYTHON_DEPS@)
    include("${CMAKE_CURRENT_LIST_DIR}/hipblaslt_codegen.cmake")
endif()
