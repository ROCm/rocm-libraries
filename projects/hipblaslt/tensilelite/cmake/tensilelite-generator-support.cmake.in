@PACKAGE_INIT@

set_and_check(_native_python "@PACKAGE_CMAKE_INSTALL_LIBDIR@/hipblaslt")
set_and_check(_native_metadata "${CMAKE_CURRENT_LIST_DIR}/tensilelite-generator-metadata.json")
set_and_check(_rocisa_file "${_native_python}/rocisa/$<TARGET_FILE_NAME:_rocisa>")
set(_runtime_dirs "@PACKAGE_CMAKE_INSTALL_LIBDIR@" "@PACKAGE_CMAKE_INSTALL_BINDIR@"
    "${_native_python}/rocisa")
# Track the installed rocisa shims and extension. A staged native update must
# invalidate an already generated library, just like a wheel update.
file(GLOB_RECURSE _native_dependencies CONFIGURE_DEPENDS LIST_DIRECTORIES false
    "${_native_python}/rocisa/*.py" "${_native_python}/rocisa/*.so"
    "${_native_python}/rocisa/*.pyd" "${_native_python}/rocisa/*.dll")
list(APPEND _native_dependencies "${_rocisa_file}")
