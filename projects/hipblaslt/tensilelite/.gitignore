.tox/

# Package build outputs. setup.py stamps _build_info.py only into build/lib and
# sdists; the entry guards against a stray copy in the source tree. Ignoring
# them also keeps a build from marking the tree dirty for the next build.
/dist/
tensilelite/_build_info.py

# mutmut mutation-testing artifacts (copy dir + cache)
mutants/
.mutmut-cache
mutmut-stats.json

# coverage.py data files (incl. multiprocessing per-pid shards from mutmut stats)
.coverage
.coverage.*
# per-suite data files the coverage-unit lane combines (characterization / unit)
.cov_char
.cov_unit

# characterization: generated analysis docs / coverage dumps (the tests are the deliverable, not these)
tensilelite/Tests/unit/characterization/**/target.md
tensilelite/Tests/unit/characterization/**/recommendations.md
tensilelite/Tests/unit/characterization/**/resistance.md
tensilelite/Tests/unit/characterization/**/survey.md
tensilelite/Tests/unit/characterization/**/coverage-before.txt
tensilelite/Tests/unit/characterization/**/coverage-after.txt
tensilelite/Tests/unit/characterization/**/walkthrough.html
tensilelite/Tests/unit/characterization/**/walkthrough.pdf

# test / coverage run outputs
coverage.xml
coverage.json
char.json
unit.json
unit_tests.xml
char_tests.xml
common_tests.xml
MatchTable.yaml

# FFM runtime artifacts (generated at client runtime; not source)
hsakmt_counters.csv
hierarchy_runtime_params.conf
out_runtime_params.conf
