#include <winver.h>

#ifdef DEBUG
#define VER_DEBUG VS_FF_DEBUG
#else
#define VER_DEBUG 0
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @hipblaslt_VERSION_MAJOR@,@hipblaslt_VERSION_MINOR@,@hipblaslt_VERSION_PATCH@,0
PRODUCTVERSION  @hipblaslt_VERSION_MAJOR@,@hipblaslt_VERSION_MINOR@,@hipblaslt_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       VER_DEBUG
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Advanced Micro Devices, Inc."
            VALUE "FileDescription",  "AMD hipBLASLt - Lightweight BLAS Library for GPU Computing"
            VALUE "FileVersion",      "@hipblaslt_VERSION_MAJOR@.@hipblaslt_VERSION_MINOR@.@hipblaslt_VERSION_PATCH@.0"
            VALUE "InternalName",     "hipblaslt"
            VALUE "LegalCopyright",   "Copyright (C) @HIPBLASLT_COPYRIGHT_YEAR@ Advanced Micro Devices, Inc."
            VALUE "OriginalFilename", "libhipblaslt.dll"
            VALUE "ProductName",      "AMD ROCm hipBLASLt @hipblaslt_VERSION_MAJOR@.@hipblaslt_VERSION_MINOR@ (@hipblaslt_VERSION_TWEAK@)"
            VALUE "ProductVersion",   "@hipblaslt_VERSION_MAJOR@.@hipblaslt_VERSION_MINOR@.@hipblaslt_VERSION_PATCH@.0"
            VALUE "Comments",         "Git commit: @hipblaslt_VERSION_COMMIT_ID@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
