# Config package for the hipFFTW Fortran bindings.
#
#   find_package(hipfftw-fortran REQUIRED)
#   target_link_libraries(my_app PRIVATE hip::hipfftw_fortran)
#
# One archive and .mod set is installed per Fortran compiler. Set
# HIPFFTW_FORTRAN_COMPILER_DIR before find_package to pick one explicitly.

@PACKAGE_INIT@

set(_hipfftw_built_dir "@HIPFFTW_FORTRAN_COMPILER_DIR@")

# Absolute, relocatable paths written by PATH_VARS (see PACKAGE_INIT above).
set(_hipfftw_libdir "@PACKAGE_HIPFFTW_FORTRAN_LIBDIR@")
set(_hipfftw_incdir "@PACKAGE_HIPFFTW_FORTRAN_INCLUDEDIR@")

set(hipfftw_FORTRAN_FOUND FALSE)

if(NOT CMAKE_Fortran_COMPILER_LOADED)
  set(hipfftw-fortran_FOUND FALSE)
  string(CONCAT hipfftw-fortran_NOT_FOUND_MESSAGE
      "The hipFFTW Fortran bindings need Fortran enabled before find_package: "
      "add Fortran to your project() languages, or call enable_language(Fortran).")
  return()
endif()

# Accepts FC itself or FC plus a separator and suffix (gfortran-13). Not a regex:
# FC may be an arbitrary basename, and CMake has no regex-escape. Prefixed per
# package: hipfft- and hipfftw-fortran-config.cmake are often loaded together.
function(_hipfftw_dir_matches DIR FC OUT)
  set(${OUT} FALSE PARENT_SCOPE)
  if(DIR STREQUAL FC)
    set(${OUT} TRUE PARENT_SCOPE)
    return()
  endif()
  string(LENGTH "${FC}" _n)
  string(LENGTH "${DIR}" _dn)
  if(_dn GREATER _n)
    string(SUBSTRING "${DIR}" 0 ${_n} _head)
    string(SUBSTRING "${DIR}" ${_n} 1 _sep)
    if(_head STREQUAL FC AND _sep MATCHES "^[-._]$")
      set(${OUT} TRUE PARENT_SCOPE)
    endif()
  endif()
endfunction()

file(GLOB _hipfftw_avail RELATIVE "${_hipfftw_incdir}" "${_hipfftw_incdir}/*")

set(_hipfftw_dir "")
if(DEFINED HIPFFTW_FORTRAN_COMPILER_DIR)
  if(NOT EXISTS "${_hipfftw_incdir}/${HIPFFTW_FORTRAN_COMPILER_DIR}/hipfftw.mod" OR
     NOT EXISTS "${_hipfftw_libdir}/${HIPFFTW_FORTRAN_COMPILER_DIR}/libhipfftw_fortran.a")
    set(hipfftw-fortran_FOUND FALSE)
    string(CONCAT hipfftw-fortran_NOT_FOUND_MESSAGE
        "HIPFFTW_FORTRAN_COMPILER_DIR is '${HIPFFTW_FORTRAN_COMPILER_DIR}', but "
        "no hipfftw.mod and libhipfftw_fortran.a are installed under "
        "${_hipfftw_incdir}/${HIPFFTW_FORTRAN_COMPILER_DIR} and "
        "${_hipfftw_libdir}/${HIPFFTW_FORTRAN_COMPILER_DIR}. Available: "
        "${_hipfftw_avail}.")
    return()
  endif()
  set(_hipfftw_dir "${HIPFFTW_FORTRAN_COMPILER_DIR}")
else()
  # Must mirror the mapping in projects/hipfft/fortran/CMakeLists.txt.
  if(CMAKE_Fortran_COMPILER_ID STREQUAL "GNU")
    set(_hipfftw_fc "gfortran")
  elseif(CMAKE_Fortran_COMPILER_ID MATCHES "Flang")
    set(_hipfftw_fc "amdflang")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Cray")
    set(_hipfftw_fc "ftn")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "IntelLLVM")
    set(_hipfftw_fc "ifx")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Intel")
    set(_hipfftw_fc "ifort")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "NVHPC")
    set(_hipfftw_fc "nvfortran")
  else()
    get_filename_component(_hipfftw_fc "${CMAKE_Fortran_COMPILER}" NAME_WE)
    string(TOLOWER "${_hipfftw_fc}" _hipfftw_fc)
  endif()

  # A prefix can hold several compilers' artifacts; the recorded one is a fallback.
  if(EXISTS "${_hipfftw_incdir}/${_hipfftw_fc}/hipfftw.mod")
    set(_hipfftw_dir "${_hipfftw_fc}")
  else()
    _hipfftw_dir_matches("${_hipfftw_built_dir}" "${_hipfftw_fc}" _hipfftw_ok)
    if(_hipfftw_ok)
      set(_hipfftw_dir "${_hipfftw_built_dir}")
    endif()
  endif()

  if(NOT _hipfftw_dir)
    set(hipfftw-fortran_FOUND FALSE)
    string(CONCAT hipfftw-fortran_NOT_FOUND_MESSAGE
        "This project builds with ${_hipfftw_fc}, but no hipfftw.mod for it is "
        "installed under ${_hipfftw_incdir}. Available: "
        "${_hipfftw_avail}. A Fortran .mod cannot be shared across compilers; "
        "rebuild the bindings with ${_hipfftw_fc}, or set "
        "HIPFFTW_FORTRAN_COMPILER_DIR to the directory to use.")
    return()
  endif()
endif()

# Written TRUE only when the archive links hip::hipfftw, which must be imported
# before the targets file. hip's config needs C or CXX enabled (FindThreads).
if(@HIPFFTW_FORTRAN_NEEDS_HIPFFT_PACKAGE@)
  if(NOT TARGET hip::hipfftw)
    if(NOT CMAKE_C_COMPILER_LOADED AND NOT CMAKE_CXX_COMPILER_LOADED)
      enable_language(C)
    endif()
    include(CMakeFindDependencyMacro)
    find_dependency(hipfft)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/hipfftw-fortran-targets.cmake")

# The targets file hardcodes the directory the package was built with.
if(NOT _hipfftw_dir STREQUAL "${_hipfftw_built_dir}")
  set_target_properties(hip::hipfftw_fortran PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_hipfftw_incdir}/${_hipfftw_dir}")
  get_target_property(_hipfftw_cfgs hip::hipfftw_fortran IMPORTED_CONFIGURATIONS)
  foreach(_hipfftw_c IN LISTS _hipfftw_cfgs)
    set_target_properties(hip::hipfftw_fortran PROPERTIES
      IMPORTED_LOCATION_${_hipfftw_c}
        "${_hipfftw_libdir}/${_hipfftw_dir}/libhipfftw_fortran.a")
  endforeach()
endif()

set(hipfftw_FORTRAN_FOUND TRUE)

check_required_components(hipfftw-fortran)
