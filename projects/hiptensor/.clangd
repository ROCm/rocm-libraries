CompileFlags:
  Add:
    - -std=c++20
    - -I/projects/rocm-libraries/projects/hiptensor/library/include
    - -I/projects/rocm-libraries/projects/hiptensor/library/src/include
    - -I/projects/rocm-libraries/projects/hiptensor/test/01_contraction
    - -I/projects/rocm-libraries/projects/hiptensor/test/02_elementwise
    - -I/projects/rocm-libraries/projects/hiptensor/test/03_reduction
    - -I/opt/rocm/include
    - -I/opt/rocm/include/ck
    - -I/opt/rocm/include/ck/utility
    - -I/opt/rocm/include/ck/tensor_description
    - -I/opt/rocm/include/ck/tensor
    - -I/opt/rocm/include/ck/problem_transform
    - -I/opt/rocm/include/ck/tensor_operation/gpu/device
    - -I/opt/rocm/include/ck/tensor_operation/gpu/device/impl
    - -I/opt/rocm/include/ck/tensor_operation/gpu/grid
    - -I/opt/rocm/include/ck/tensor_operation/gpu/block
    - -I/opt/rocm/include/ck/tensor_operation/gpu/warp
    - -I/opt/rocm/include/ck/tensor_operation/gpu/thread
    - -I/opt/rocm/include/ck/tensor_operation/gpu/element
    - -I/opt/rocm/include/ck/library/utility
    - -I/opt/rocm/include/ck/library/tensor_operation_instance
    - -I/opt/rocm/include/ck/library/tensor_operation_instance/gpu
    - -I/opt/rocm/include/ck/library/tensor_operation_instance/gpu/quantization
    - -I/opt/rocm/include/ck/library/tensor_operation_instance/gpu/softmax
    - -isystem
    - /opt/rocm/include
    - -D__HIP_PLATFORM_AMD__=1
    - -DHIPTENSOR_DEFAULT_STRIDES_COL_MAJOR=1
    - -DUSE_PROF_API=1
    - -D__HIP_DEVICE_COMPILE__=0
    - -D__HIPCC_RTC__=0
    - -DCK_CODE_GEN_RTC=0
    - -DCK_WORKAROUND_SWDEV_383542=0
    - -D__HOST_DEVICE__=
    - -D__device__=
    - -D__host__=
    - -D__forceinline__=inline
    - -D__CLANG_HIP_RUNTIME_WRAPPER_INCLUDED__=1
    - -D__CLANGD__=1
    - --rocm-path=/opt/rocm
    - --rocm-device-lib-path=/opt/rocm/lib
    - -nogpulib
    - -ferror-limit=0
    - -Wno-inconsistent-missing-override
    - -Wno-redundant-decls
  Remove:
    - -x
    - hip
    - -fno-offload-uniform-block
    - -mllvm
    - --offload-arch=*
    - --offload-compress

Diagnostics:
  Suppress:
    - drv_no_rocm_device_lib
    - constexpr_redecl
    - function_redefinition
    - inconsistent_missing_override
    - redundant_decls
  ClangTidy:
    Remove:
      - readability-*
      - google-*
      - modernize-*

Index:
  Background: Build
