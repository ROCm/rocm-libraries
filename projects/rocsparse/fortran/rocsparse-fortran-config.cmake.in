# Config package for the rocSPARSE Fortran bindings.
#
#   find_package(rocsparse-fortran REQUIRED)
#   target_link_libraries(my_app PRIVATE roc::rocsparse_fortran)
#
# One archive and .mod set is installed per Fortran compiler. Set
# ROCSPARSE_FORTRAN_COMPILER_DIR before find_package to pick one explicitly.

@PACKAGE_INIT@

set(_rocsparse_built_dir "@ROCSPARSE_FORTRAN_COMPILER_DIR@")

# Absolute, relocatable paths written by PATH_VARS (see PACKAGE_INIT above).
set(_rocsparse_libdir "@PACKAGE_ROCSPARSE_FORTRAN_LIBDIR@")
set(_rocsparse_incdir "@PACKAGE_ROCSPARSE_FORTRAN_INCLUDEDIR@")

set(rocsparse_FORTRAN_FOUND FALSE)

if(NOT CMAKE_Fortran_COMPILER_LOADED)
  set(rocsparse-fortran_FOUND FALSE)
  string(CONCAT rocsparse-fortran_NOT_FOUND_MESSAGE
      "The rocSPARSE Fortran bindings need Fortran enabled before find_package: "
      "add Fortran to your project() languages, or call enable_language(Fortran).")
  return()
endif()

# Accepts FC itself or FC plus a separator and suffix (gfortran-13). Not a regex:
# FC may be an arbitrary basename, and CMake has no regex-escape.
function(_rocsparse_dir_matches DIR FC OUT)
  set(${OUT} FALSE PARENT_SCOPE)
  if(DIR STREQUAL FC)
    set(${OUT} TRUE PARENT_SCOPE)
    return()
  endif()
  string(LENGTH "${FC}" _n)
  string(LENGTH "${DIR}" _dn)
  if(_dn GREATER _n)
    string(SUBSTRING "${DIR}" 0 ${_n} _head)
    string(SUBSTRING "${DIR}" ${_n} 1 _sep)
    if(_head STREQUAL FC AND _sep MATCHES "^[-._]$")
      set(${OUT} TRUE PARENT_SCOPE)
    endif()
  endif()
endfunction()

file(GLOB _rocsparse_avail RELATIVE "${_rocsparse_incdir}" "${_rocsparse_incdir}/*")

set(_rocsparse_dir "")
if(DEFINED ROCSPARSE_FORTRAN_COMPILER_DIR)
  if(NOT EXISTS "${_rocsparse_incdir}/${ROCSPARSE_FORTRAN_COMPILER_DIR}/rocsparse.mod" OR
     NOT EXISTS "${_rocsparse_libdir}/${ROCSPARSE_FORTRAN_COMPILER_DIR}/librocsparse_fortran.a")
    set(rocsparse-fortran_FOUND FALSE)
    string(CONCAT rocsparse-fortran_NOT_FOUND_MESSAGE
        "ROCSPARSE_FORTRAN_COMPILER_DIR is '${ROCSPARSE_FORTRAN_COMPILER_DIR}', but "
        "no rocsparse.mod and librocsparse_fortran.a are installed under "
        "${_rocsparse_incdir}/${ROCSPARSE_FORTRAN_COMPILER_DIR} and "
        "${_rocsparse_libdir}/${ROCSPARSE_FORTRAN_COMPILER_DIR}. Available: "
        "${_rocsparse_avail}.")
    return()
  endif()
  set(_rocsparse_dir "${ROCSPARSE_FORTRAN_COMPILER_DIR}")
else()
  # Must mirror the mapping in projects/rocsparse/fortran/CMakeLists.txt.
  if(CMAKE_Fortran_COMPILER_ID STREQUAL "GNU")
    set(_rocsparse_fc "gfortran")
  elseif(CMAKE_Fortran_COMPILER_ID MATCHES "Flang")
    set(_rocsparse_fc "amdflang")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Cray")
    set(_rocsparse_fc "ftn")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "IntelLLVM")
    set(_rocsparse_fc "ifx")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Intel")
    set(_rocsparse_fc "ifort")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "NVHPC")
    set(_rocsparse_fc "nvfortran")
  else()
    get_filename_component(_rocsparse_fc "${CMAKE_Fortran_COMPILER}" NAME_WE)
    string(TOLOWER "${_rocsparse_fc}" _rocsparse_fc)
  endif()

  # A prefix can hold several compilers' artifacts; the recorded one is a fallback.
  if(EXISTS "${_rocsparse_incdir}/${_rocsparse_fc}/rocsparse.mod")
    set(_rocsparse_dir "${_rocsparse_fc}")
  else()
    _rocsparse_dir_matches("${_rocsparse_built_dir}" "${_rocsparse_fc}" _rocsparse_ok)
    if(_rocsparse_ok)
      set(_rocsparse_dir "${_rocsparse_built_dir}")
    endif()
  endif()

  if(NOT _rocsparse_dir)
    set(rocsparse-fortran_FOUND FALSE)
    string(CONCAT rocsparse-fortran_NOT_FOUND_MESSAGE
        "This project builds with ${_rocsparse_fc}, but no rocsparse.mod for it is "
        "installed under ${_rocsparse_incdir}. Available: "
        "${_rocsparse_avail}. A Fortran .mod cannot be shared across compilers; "
        "rebuild the bindings with ${_rocsparse_fc}, or set "
        "ROCSPARSE_FORTRAN_COMPILER_DIR to the directory to use.")
    return()
  endif()
endif()

# Written TRUE only when the archive links roc::rocsparse, which must be imported
# before the targets file. hip's config needs C or CXX enabled (FindThreads).
if(@ROCSPARSE_FORTRAN_NEEDS_C_PACKAGE@)
  if(NOT TARGET roc::rocsparse)
    if(NOT CMAKE_C_COMPILER_LOADED AND NOT CMAKE_CXX_COMPILER_LOADED)
      enable_language(C)
    endif()
    include(CMakeFindDependencyMacro)
    find_dependency(rocsparse)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/rocsparse-fortran-targets.cmake")

# The targets file hardcodes the directory the package was built with.
if(NOT _rocsparse_dir STREQUAL "${_rocsparse_built_dir}")
  set_target_properties(roc::rocsparse_fortran PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_rocsparse_incdir}/${_rocsparse_dir}")
  get_target_property(_rocsparse_cfgs roc::rocsparse_fortran IMPORTED_CONFIGURATIONS)
  foreach(_rocsparse_c IN LISTS _rocsparse_cfgs)
    set_target_properties(roc::rocsparse_fortran PROPERTIES
      IMPORTED_LOCATION_${_rocsparse_c}
        "${_rocsparse_libdir}/${_rocsparse_dir}/librocsparse_fortran.a")
  endforeach()
endif()

set(rocsparse_FORTRAN_FOUND TRUE)

check_required_components(rocsparse-fortran)
