# Anywhere {branch} is used, the branch name will be substituted.
# These comments will also be removed.
defaults:
  numbered: False
  maxdepth: 6
root: index
subtrees:

- caption: Install
  entries:
  - file: install/rpp-install.rst
    title: Install RPP
  - file: install/rpp-build.rst
    title: Build from source

- caption: Reference
  entries:
