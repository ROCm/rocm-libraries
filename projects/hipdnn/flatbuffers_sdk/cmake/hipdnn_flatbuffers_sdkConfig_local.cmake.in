@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(hipdnn_data_sdk @HIPDNN_FLATBUFFERS_SDK_DATA_SDK_MIN_VERSION@ CONFIG REQUIRED)

# Reflects how hipDNN was built; not consumer-overridable, since the imported
# target's compile definitions are already baked in.
set(HIPDNN_FLATBUFFERS_SDK_SKIP_JSON_LIB @HIPDNN_FLATBUFFERS_SDK_SKIP_JSON_LIB@)

# nlohmann_json is optional based on HIPDNN_FLATBUFFERS_SDK_SKIP_JSON_LIB
if(NOT HIPDNN_FLATBUFFERS_SDK_SKIP_JSON_LIB)
    find_dependency(nlohmann_json REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/hipdnn_flatbuffers_sdkTargets.cmake")

# In the local build, FlatBuffers is bundled (no find_dependency call above), so
# flatbuffers_VERSION isn't populated by CMake. Pin it from the version hipDNN
# was built against for the status message below.
set(flatbuffers_VERSION "@HIPDNN_FLATBUFFERS_VERSION@")

message(STATUS "hipDNN Flatbuffers SDK: Using local FlatBuffers ${flatbuffers_VERSION} headers")
