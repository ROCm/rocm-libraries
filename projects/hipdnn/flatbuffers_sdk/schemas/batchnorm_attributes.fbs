// See graph.fbs for the semantics of this annotation.
attribute "cache_uid";

namespace hipdnn_flatbuffers_sdk.data_objects;

table BatchnormAttributes {
    x_tensor_uid: long (cache_uid);
    scale_tensor_uid: long (cache_uid);
    bias_tensor_uid: long (cache_uid);
    epsilon_tensor_uid: long (cache_uid);
    peer_stats_tensor_uid: [long] (cache_uid);
    prev_running_mean_tensor_uid: long = null (cache_uid);
    prev_running_variance_tensor_uid: long = null (cache_uid);
    momentum_tensor_uid: long = null (cache_uid);
    y_tensor_uid: long (cache_uid);
    mean_tensor_uid: long = null (cache_uid);
    inv_variance_tensor_uid: long = null (cache_uid);
    next_running_mean_tensor_uid: long = null (cache_uid);
    next_running_variance_tensor_uid: long = null (cache_uid);
}
