include "data_types.fbs";

// See graph.fbs for the semantics of these annotations.
attribute "cache_uid";
attribute "umd_opcode";
attribute "umd_input_tensor";
attribute "umd_output_tensor";
attribute "umd_name";

namespace hipdnn_flatbuffers_sdk.data_objects;

enum ReductionMode : byte {
    NOT_SET = 0,
    ADD = 1,
    MUL = 2,
    MIN_OP = 3, // MIN is reserved
    MAX_OP = 4, // MAX is reserved
    AMAX = 5,
    AVG = 6,
    NORM1 = 7,
    NORM2 = 8,
    MUL_NO_ZEROS = 9
}

table ReductionAttributes (umd_opcode: "reduction") {
    mode: ReductionMode;
    in_tensor_uid: long (cache_uid, umd_input_tensor, umd_name: "in");
    out_tensor_uid: long (cache_uid, umd_output_tensor, umd_name: "out");
    is_deterministic: bool = false;
}
