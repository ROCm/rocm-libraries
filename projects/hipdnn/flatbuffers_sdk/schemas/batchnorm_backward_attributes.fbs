// See graph.fbs for the semantics of these annotations.
attribute "cache_uid";
attribute "matcher_opcode";
attribute "matcher_input_tensor";
attribute "matcher_output_tensor";
attribute "matcher_name";

namespace hipdnn_flatbuffers_sdk.data_objects;

table BatchnormBackwardAttributes (matcher_opcode: "batchnorm_bwd") {
    dy_tensor_uid: long (cache_uid, matcher_input_tensor, matcher_name: "dy");
    x_tensor_uid: long (cache_uid, matcher_input_tensor, matcher_name: "x");
    mean_tensor_uid: long = null (cache_uid, matcher_input_tensor, matcher_name: "mean");
    inv_variance_tensor_uid: long = null (cache_uid, matcher_input_tensor, matcher_name: "inv_variance");
    scale_tensor_uid: long (cache_uid, matcher_input_tensor, matcher_name: "scale");
    peer_stats_tensor_uid: [long] (cache_uid, matcher_input_tensor);
    dx_tensor_uid: long (cache_uid, matcher_output_tensor, matcher_name: "dx");
    dscale_tensor_uid: long (cache_uid, matcher_output_tensor, matcher_name: "dscale");
    dbias_tensor_uid: long (cache_uid, matcher_output_tensor, matcher_name: "dbias");
}
