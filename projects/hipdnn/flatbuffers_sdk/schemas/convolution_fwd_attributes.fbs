include "convolution_common.fbs";

// See graph.fbs for the semantics of these annotations.
attribute "cache_uid";
attribute "matcher_opcode";
attribute "matcher_input_tensor";
attribute "matcher_output_tensor";
attribute "matcher_name";

namespace hipdnn_flatbuffers_sdk.data_objects;

table ConvolutionFwdAttributes (matcher_opcode: "convolution_fwd") {
    // Input/Output tensor UIDs
    x_tensor_uid: long (cache_uid, matcher_input_tensor, matcher_name: "x");   // Input tensor
    w_tensor_uid: long (cache_uid, matcher_input_tensor, matcher_name: "w");   // Weights/filter tensor
    y_tensor_uid: long (cache_uid, matcher_output_tensor, matcher_name: "y");  // Output tensor

    // Convolution parameters (N-dimensional support)
    pre_padding: [long];         // Padding before each dimension
    post_padding: [long];        // Padding after each dimension
    stride: [long];              // Stride for each dimension
    dilation: [long];            // Dilation for each dimension

    // Algorithm/mode selection
    conv_mode: ConvMode;
}
