include "sdpa_attributes.fbs";

// See graph.fbs for the semantics of this annotation.
attribute "cache_uid";

namespace hipdnn_flatbuffers_sdk.data_objects;

table SdpaBackwardAttributes {
    // Required input tensor UIDs
    q_tensor_uid:              long (cache_uid);
    k_tensor_uid:              long (cache_uid);
    v_tensor_uid:              long (cache_uid);
    o_tensor_uid:              long (cache_uid);
    do_tensor_uid:             long (cache_uid);
    stats_tensor_uid:          long (cache_uid);

    // Required output tensor UIDs
    dq_tensor_uid:             long (cache_uid);
    dk_tensor_uid:             long (cache_uid);
    dv_tensor_uid:             long (cache_uid);

    // Optional input tensor UIDs
    scale_tensor_uid:          long = null (cache_uid);  // Attention scale tensor (Attn_scale)
    attn_mask_tensor_uid:      long = null (cache_uid);  // Additive attention bias (Bias)
    seq_len_q_tensor_uid:      long = null (cache_uid);
    seq_len_kv_tensor_uid:     long = null (cache_uid);
    seed_tensor_uid:           long = null (cache_uid);  // Dropout seed
    offset_tensor_uid:         long = null (cache_uid);  // Dropout offset
    dropout_mask_tensor_uid:   long = null (cache_uid);
    dropout_scale_tensor_uid:  long = null (cache_uid);
    dropout_scale_inv_tensor_uid: long = null (cache_uid);

    // Optional output tensor UIDs
    dbias_tensor_uid:          long = null (cache_uid);  // Gradient of additive attention bias

    // Boolean flags
    alibi_mask:                bool = false;
    padding_mask:              bool = false;
    causal_mask:               bool = false;              // Deprecated
    causal_mask_bottom_right:  bool = false;              // Deprecated

    // Scalar attributes
    dropout_probability:       float = null;
    attn_scale_value:          float = null;
    left_bound:                long = null;
    right_bound:               long = null;

    // Enum attributes
    diagonal_alignment:        DiagonalAlignment = TOP_LEFT;
}
