namespace hipdnn_flatbuffers_sdk.data_objects;

enum DataType : byte {
    UNSET = 0,
    FLOAT = 1,
    HALF = 2,
    BFLOAT16 = 3,
    DOUBLE = 4,
    UINT8 = 5,
    INT32 = 6,
    INT8 = 7,
    FP8_E4M3 = 8,
    FP8_E5M2 = 9,
    FP8_E8M0 = 10,
    FP4_E2M1 = 11,
    FP6_E2M3 = 12,
    FP6_E3M2 = 13,
    INT4 = 14,
    INT64 = 15,
    BOOLEAN = 16,
    FP8_E4M3_FNUZ = 17,
    FP8_E5M2_FNUZ = 18,
}

// UMD binding annotations (RFC 0018 Appendix B). Declared once here, in the shared
// include, and applied to each op's attribute table. `umd_opcode` is a table-level
// attribute giving the op's UMD-facing shorthand (e.g. "sdpa_fwd"); a UMD file's
// node `op` names it, and the registry keys on it (falling back to the table type
// name when absent). `umd_operand` / `umd_result` mark a tensor-UID edge and
// `umd_name` gives the name a UMD binds it by; the operand/result flag already
// fixes that the binding is a tensor, so no separate type attribute is carried.
// Unannotated fields are scalar attributes.
attribute "umd_opcode";
attribute "umd_operand";
attribute "umd_result";
attribute "umd_name";
