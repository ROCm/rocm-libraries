// See graph.fbs for the semantics of this annotation.
attribute "cache_uid";

namespace hipdnn_flatbuffers_sdk.data_objects;

// Mixture-of-experts routing: turns per-token expert choices into the group boundaries and
// row indices that MoeGroupedMatmul GATHER / SCATTER consume (cuDNN leaves this to the caller,
// so the backend names carry the _EXT suffix). topk_ids is [S, top_k]. Each pair (s, k) with
// expert e = topk_ids[s, k] in [0, num_experts) becomes one routed row; rows are ordered by
// expert, then by s, then by k. For routed row r:
//   token_index[r] = s,  token_ks[r] = k
//   first_token_offset[e] = number of routed rows with expert < e  (e in [0, num_experts])
// Ids outside [0, num_experts) are not routed (expert parallelism), so the last boundary may
// be below S * top_k; the trailing token_index / token_ks rows are then left unwritten.
table MoeRoutingAttributes {
    topk_ids_tensor_uid:           long (cache_uid);  // [S, top_k], INT32
    first_token_offset_tensor_uid: long (cache_uid);  // output [num_experts + 1, 1, 1], INT32 or INT64
    token_index_tensor_uid:        long (cache_uid);  // output [1, S * top_k, 1], INT32
    token_ks_tensor_uid:           long (cache_uid);  // output [1, S * top_k, 1], INT32

    num_experts: long;
}
