include "data_types.fbs";

namespace hipdnn_flatbuffers_sdk.data_objects;

enum DiagonalAlignment : byte {
    TOP_LEFT     = 0,
    BOTTOM_RIGHT = 1,
}

enum AttentionImplementation : byte {
    AUTO      = 0,
    COMPOSITE = 1,
    UNIFIED   = 2,
}

table SdpaAttributes {
    // Required input tensor UIDs
    q_tensor_uid:             long (umd_operand, umd_name: "Q");
    k_tensor_uid:             long (umd_operand, umd_name: "K");
    v_tensor_uid:             long (umd_operand, umd_name: "V");

    // Required output tensor UID
    o_tensor_uid:             long (umd_result, umd_name: "O");

    // Optional input tensor UIDs
    attn_mask_tensor_uid:     long = null (umd_operand, umd_name: "attn_mask");      // Additive attention bias (Bias)
    scale_tensor_uid:         long = null (umd_operand, umd_name: "scale");          // Attention scale tensor (Attn_scale)
    seq_len_q_tensor_uid:     long = null (umd_operand, umd_name: "seq_len_q");
    seq_len_kv_tensor_uid:    long = null (umd_operand, umd_name: "seq_len_kv");
    seed_tensor_uid:          long = null (umd_operand, umd_name: "seed");           // Dropout seed
    offset_tensor_uid:        long = null (umd_operand, umd_name: "offset");         // Dropout offset
    dropout_mask_tensor_uid:  long = null (umd_operand, umd_name: "dropout_mask");
    dropout_scale_tensor_uid: long = null (umd_operand, umd_name: "dropout_scale");
    page_table_k_tensor_uid:  long = null (umd_operand, umd_name: "page_table_k");
    page_table_v_tensor_uid:  long = null (umd_operand, umd_name: "page_table_v");
    block_mask_tensor_uid:    long = null (umd_operand, umd_name: "block_mask");
    sink_token_tensor_uid:    long = null (umd_operand, umd_name: "sink_token");

    // FP8-specific input tensor UIDs
    descale_q_tensor_uid:     long = null (umd_operand, umd_name: "descale_q");
    descale_k_tensor_uid:     long = null (umd_operand, umd_name: "descale_k");
    descale_v_tensor_uid:     long = null (umd_operand, umd_name: "descale_v");
    descale_s_tensor_uid:     long = null (umd_operand, umd_name: "descale_s");
    scale_s_tensor_uid:       long = null (umd_operand, umd_name: "scale_s");
    scale_o_tensor_uid:       long = null (umd_operand, umd_name: "scale_o");

    // Optional output tensor UIDs
    stats_tensor_uid:         long = null (umd_result, umd_name: "stats");
    max_tensor_uid:           long = null (umd_result, umd_name: "max");             // Logit max (Max)
    sum_exp_tensor_uid:       long = null (umd_result, umd_name: "sum_exp");         // Score sum exp (Sum_exp)
    rng_dump_tensor_uid:      long = null (umd_result, umd_name: "rng_dump");        // RNG dump for dropout debugging

    // FP8-specific output tensor UIDs
    amax_s_tensor_uid:        long = null (umd_result, umd_name: "amax_s");          // Absolute max for attention scores
    amax_o_tensor_uid:        long = null (umd_result, umd_name: "amax_o");          // Absolute max for output tensor

    // Boolean flags
    generate_stats:           bool = null;
    alibi_mask:               bool = false;
    padding_mask:             bool = false;
    causal_mask:              bool = false;              // Deprecated
    causal_mask_bottom_right: bool = false;              // Deprecated

    // Scalar attributes
    dropout_probability:      float = null;
    attn_scale_value:         float = null;
    left_bound:               long = null;
    right_bound:              long = null;
    max_seq_len_kv:           int = null;

    // Enum attributes
    diagonal_alignment:       DiagonalAlignment = TOP_LEFT;
    mma_core_mode:            DataType = UNSET;
    implementation:           AttentionImplementation = AUTO;
}
