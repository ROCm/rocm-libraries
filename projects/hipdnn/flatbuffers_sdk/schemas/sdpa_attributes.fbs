include "data_types.fbs";

// See graph.fbs for the semantics of these annotations.
attribute "cache_uid";
attribute "matcher_opcode";
attribute "matcher_input_tensor";
attribute "matcher_output_tensor";
attribute "matcher_name";
attribute "work_data_dependent";

namespace hipdnn_flatbuffers_sdk.data_objects;

enum DiagonalAlignment : byte {
    TOP_LEFT     = 0,
    BOTTOM_RIGHT = 1,
}

enum AttentionImplementation : byte {
    AUTO      = 0,
    COMPOSITE = 1,
    UNIFIED   = 2,
}

table SdpaAttributes (matcher_opcode: "sdpa") {
    // Required input tensor UIDs
    q_tensor_uid:             long (cache_uid, matcher_input_tensor, matcher_name: "q");
    k_tensor_uid:             long (cache_uid, matcher_input_tensor, matcher_name: "k");
    v_tensor_uid:             long (cache_uid, matcher_input_tensor, matcher_name: "v");

    // Required output tensor UID
    o_tensor_uid:             long (cache_uid, matcher_output_tensor, matcher_name: "o");

    // Optional input tensor UIDs
    // Not work_data_dependent: the bias is added to every score whatever its values, so
    // masking through it (-inf entries) still computes the full score matrix.
    attn_mask_tensor_uid:     long = null (cache_uid, matcher_input_tensor, matcher_name: "attn_mask");      // Additive attention bias (Bias)
    scale_tensor_uid:         long = null (cache_uid, matcher_input_tensor, matcher_name: "scale");          // Attention scale tensor (Attn_scale)
    // Per-batch valid lengths: only the first seq_len rows/columns of each sequence are
    // attended, so the values, not the padded Q/K dims, decide the score count.
    seq_len_q_tensor_uid:     long = null (cache_uid, work_data_dependent, matcher_input_tensor, matcher_name: "seq_len_q");
    seq_len_kv_tensor_uid:    long = null (cache_uid, work_data_dependent, matcher_input_tensor, matcher_name: "seq_len_kv");
    seed_tensor_uid:          long = null (cache_uid, matcher_input_tensor, matcher_name: "seed");           // Dropout seed
    offset_tensor_uid:        long = null (cache_uid, matcher_input_tensor, matcher_name: "offset");         // Dropout offset
    dropout_mask_tensor_uid:  long = null (cache_uid, matcher_input_tensor, matcher_name: "dropout_mask");
    dropout_scale_tensor_uid: long = null (cache_uid, matcher_input_tensor, matcher_name: "dropout_scale");
    // Paged KV cache: K/V dims describe the page pool, and the table's entries decide
    // which pages -- and so how many keys -- each sequence attends to.
    page_table_k_tensor_uid:  long = null (cache_uid, work_data_dependent, matcher_input_tensor, matcher_name: "page_table_k");
    page_table_v_tensor_uid:  long = null (cache_uid, work_data_dependent, matcher_input_tensor, matcher_name: "page_table_v");
    // Block-sparse attention (cuDNN parity): each entry selects whether a 128x128 score
    // tile is computed or skipped, so the values decide the score count.
    block_mask_tensor_uid:    long = null (cache_uid, work_data_dependent, matcher_input_tensor, matcher_name: "block_mask");
    sink_token_tensor_uid:    long = null (cache_uid, matcher_input_tensor, matcher_name: "sink_token");

    // FP8-specific input tensor UIDs
    descale_q_tensor_uid:     long = null (cache_uid, matcher_input_tensor, matcher_name: "descale_q");
    descale_k_tensor_uid:     long = null (cache_uid, matcher_input_tensor, matcher_name: "descale_k");
    descale_v_tensor_uid:     long = null (cache_uid, matcher_input_tensor, matcher_name: "descale_v");
    descale_s_tensor_uid:     long = null (cache_uid, matcher_input_tensor, matcher_name: "descale_s");
    scale_s_tensor_uid:       long = null (cache_uid, matcher_input_tensor, matcher_name: "scale_s");
    scale_o_tensor_uid:       long = null (cache_uid, matcher_input_tensor, matcher_name: "scale_o");

    // Optional output tensor UIDs
    stats_tensor_uid:         long = null (cache_uid, matcher_output_tensor, matcher_name: "stats");
    max_tensor_uid:           long = null (cache_uid, matcher_output_tensor, matcher_name: "max");       // Logit max (Max)
    sum_exp_tensor_uid:       long = null (cache_uid, matcher_output_tensor, matcher_name: "sum_exp");   // Score sum exp (Sum_exp)
    rng_dump_tensor_uid:      long = null (cache_uid, matcher_output_tensor, matcher_name: "rng_dump");  // RNG dump for dropout debugging

    // FP8-specific output tensor UIDs
    amax_s_tensor_uid:        long = null (cache_uid, matcher_output_tensor, matcher_name: "amax_s");  // Absolute max for attention scores
    amax_o_tensor_uid:        long = null (cache_uid, matcher_output_tensor, matcher_name: "amax_o");  // Absolute max for output tensor

    // Boolean flags
    generate_stats:           bool = null;
    alibi_mask:               bool = false;
    padding_mask:             bool = false;
    causal_mask:              bool = false;              // Deprecated
    causal_mask_bottom_right: bool = false;              // Deprecated

    // Scalar attributes
    dropout_probability:      float = null;
    attn_scale_value:         float = null;
    left_bound:               long = null;
    right_bound:              long = null;
    max_seq_len_kv:           int = null;

    // Enum attributes
    diagonal_alignment:       DiagonalAlignment = TOP_LEFT;
    mma_core_mode:            DataType = UNSET;
    implementation:           AttentionImplementation = AUTO;
}
