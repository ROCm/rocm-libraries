namespace hipdnn_flatbuffers_sdk.data_objects;

/// @brief Adapter type for UHD model evaluation.
///
/// Determines how the heuristic computes scores for kernel candidates.
enum UhdAdapter : byte {
    /// Rank by static fields (priority, id). No model artifact needed.
    STATIC_ORDER = 0,

    /// GBDT tree walker over FlatBuffer tree_data artifact. Default shipping path.
    TREE_DATA = 1,

    /// Lookup table indexed by problem bucket hash.
    TABLE = 2,

    /// ONNX Runtime inference. Requires onnxruntime dependency.
    ONNX = 3,

    /// Custom compiled scorer loaded via dlopen. Engine supplies .so artifact.
    CUSTOM_LIBRARY = 4,
}

/// @brief Score metadata for UHD predictions.
///
/// Describes the units and calibration of scores for cross-engine comparison.
table UhdScoreMetadata {
    /// Score units (e.g., "tflops", "ms", "relative").
    units: string;

    /// True if scores are calibrated to real performance and cross-engine comparable.
    calibrated: bool = false;

    /// Transform applied to raw model output (e.g., "identity", "log1p", "exp").
    transform: string;
}

/// @brief Universal Heuristic Descriptor (UHD).
///
/// A kernel-selection model owned by an engine (UED). Given candidate kernels
/// that match a graph, the UHD ranks them by predicted performance and picks
/// the best one. It is the data form of ranking logic that replaces hand-coded
/// dispatch.
///
/// The UHD is one per engine, owned by the UED. Many KDPs may join the same
/// engine and share its one UHD. The UHD ranks on KMD fields ($kernel.*) plus
/// problem properties ($q.*) and device properties ($device.*).
///
/// RFC 0019: Universal Heuristic Descriptor
table UHD {
    /// Unique identifier (UUID/GUID).
    id: string (required);

    /// Human-readable display name.
    name: string;

    /// Adapter type determining how scores are computed.
    adapter: UhdAdapter = STATIC_ORDER;

    /// Ordered list of feature expressions (JsonLogic format).
    /// Each expression references $device.*, $kernel.*, or $q.* variables.
    /// Order must match training; the contract is frozen at model export.
    features_signature: [string];

    /// SHA-256 hash of features_signature for contract validation.
    /// Must match the features_hash embedded in the model artifact.
    features_hash: string;

    /// Optimization objective: "max" (higher is better) or "min" (lower is better).
    objective: string;

    /// Score metadata for cross-engine comparison.
    score: UhdScoreMetadata;

    /// Relative path to model artifact (for TREE_DATA, ONNX, CUSTOM_LIBRARY adapters).
    /// Resolved relative to the engine descriptor set location.
    model_artifact_path: string;

    /// Checksum of model artifact for integrity validation.
    model_hash: string;

    /// For STATIC_ORDER adapter: field names to sort by in order (e.g., ["priority", "id"]).
    static_order_fields: [string];

    /// For CUSTOM_LIBRARY adapter: symbol name of the scorer function in the .so.
    custom_library_symbol: string;
}

root_type UHD;

file_identifier "HUHD";  // HipDNN Universal Heuristic Descriptor
