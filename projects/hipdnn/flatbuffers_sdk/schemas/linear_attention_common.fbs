namespace hipdnn_flatbuffers_sdk.data_objects;

// How the g tensor of a linear-attention node (GDN, KDA) encodes the decay alpha.
enum GateDomain : byte {
    LOG    = 0,  // g holds ln(alpha)
    LINEAR = 1,  // g holds alpha in (0, 1]
}
