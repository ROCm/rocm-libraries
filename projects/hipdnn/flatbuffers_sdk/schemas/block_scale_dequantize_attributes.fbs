attribute "cache_uid";
attribute "output_tensor";

namespace hipdnn_flatbuffers_sdk.data_objects;

table BlockScaleDequantizeAttributes {
    x_tensor_uid: long (cache_uid);
    scale_tensor_uid: long (cache_uid);
    y_tensor_uid: long (cache_uid, output_tensor);
    block_size: [int];
    is_negative_scale: bool = false;
