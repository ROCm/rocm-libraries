// See graph.fbs for the semantics of this annotation.
attribute "cache_uid";

namespace hipdnn_flatbuffers_sdk.data_objects;

// The long attributes are keys to the tensor_attributes->uid
table BatchnormInferenceAttributes {
    x_tensor_uid: long (cache_uid);
    mean_tensor_uid: long (cache_uid);
    inv_variance_tensor_uid: long (cache_uid);
    scale_tensor_uid: long (cache_uid);
    bias_tensor_uid: long (cache_uid);
    y_tensor_uid: long (cache_uid);
}
