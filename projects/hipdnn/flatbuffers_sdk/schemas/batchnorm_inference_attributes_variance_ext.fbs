// See graph.fbs for the semantics of these annotations.
attribute "cache_uid";
attribute "output_tensor";

namespace hipdnn_flatbuffers_sdk.data_objects;

// Note
// This is an additional version of batchnorm inference that uses a variance tensor
// instead of inv_variance tensor.

// The long attributes are keys to the tensor_attributes->uid
table BatchnormInferenceAttributesVarianceExt {
    x_tensor_uid: long (cache_uid);
    mean_tensor_uid: long (cache_uid);
    variance_tensor_uid: long (cache_uid);
    scale_tensor_uid: long (cache_uid);
    bias_tensor_uid: long (cache_uid);
    y_tensor_uid: long (cache_uid, output_tensor);
    epsilon_tensor_uid: long (cache_uid);
}
