include "norm_common.fbs";

// See graph.fbs for the semantics of these annotations.
attribute "cache_uid";
attribute "output_tensor";

namespace hipdnn_flatbuffers_sdk.data_objects;

table LayernormBackwardAttributes {
    dy_tensor_uid:           long (cache_uid);
    x_tensor_uid:            long (cache_uid);
    scale_tensor_uid:        long (cache_uid);
    mean_tensor_uid:         long = null (cache_uid);
    inv_variance_tensor_uid: long = null (cache_uid);
    epsilon_tensor_uid:      long = null (cache_uid);
    dx_tensor_uid:           long (cache_uid, output_tensor);
    dscale_tensor_uid:       long (cache_uid, output_tensor);
    dbias_tensor_uid:        long (cache_uid, output_tensor);
    normalized_dim_count:    long;
}
