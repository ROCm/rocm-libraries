namespace hipdnn_flatbuffers_sdk.data_objects;

// Typed arrays for the split/leaf encoding. A union field records which one an array is
// stored as, so the model itself says how each of its arrays is laid out: the writer picks
// the narrowest type its values fit, and the reader decodes whatever the tag names. A tag
// the reader does not know is refused by name rather than misread.
table Int8Array { values: [int8]; }
table UInt8Array { values: [uint8]; }
table Int16Array { values: [int16]; }
table UInt16Array { values: [uint16]; }
table Int32Array { values: [int32]; }
table Float32Array { values: [float32]; }
table Float64Array { values: [float64]; }

union IntegerArray { Int8Array, UInt8Array, Int16Array, UInt16Array, Int32Array }
union RealArray { Float32Array, Float64Array }

/// @brief A single decision tree in the GBDT ensemble, in one of two encodings.
///
/// Node arrays (the first seven fields): one entry per node, split or leaf.
/// Node i is internal if left_children[i] >= 0; leaf if left_children[i] == -1.
/// Traversal: start at node 0, compare features[feature_indices[i]] against
/// thresholds[i], go left (left_children[i]) if less-or-equal (or less, if
/// decision_lte at i is false) or if missing and default_left,
/// else right (right_children[i]). At a leaf, return leaf_values[i].
///
/// Split/leaf arrays (the `split_*` fields and `leaves`): splits and leaves are stored
/// apart, each array in the narrowest type it fits. A child >= 0 is a split index; a child
/// c < 0 is leaf ~c (-1 is leaf 0). Traversal starts at split 0, or at leaf 0 when the
/// tree has no splits. A split's threshold is GbdtModel.threshold_table[split_thresholds[i]].
/// A tree uses exactly one encoding; `leaves` present selects this one.
table GbdtTree {
    /// Feature index to split on at each internal node.
    feature_indices: [int32];

    /// Split threshold at each internal node.
    thresholds: [double];

    /// Left child index for each node. -1 indicates this is a leaf.
    left_children: [int32];

    /// Right child index for each node. -1 indicates this is a leaf.
    right_children: [int32];

    /// Leaf value at each leaf node. Ignore for internal nodes.
    leaf_values: [double];

    /// Default direction for missing values: true = go left, false = go right.
    default_left: [bool];

    /// Comparison per node: true = use <= (LightGBM default), false = use <.
    /// If absent, defaults to all true (<=) for LightGBM compatibility.
    decision_lte: [bool];

    /// Split/leaf encoding: feature index per split.
    split_features: IntegerArray;

    /// Split/leaf encoding: index into GbdtModel.threshold_table per split.
    split_thresholds: IntegerArray;

    /// Split/leaf encoding: left child per split (>= 0 split, < 0 leaf ~c).
    split_left: IntegerArray;

    /// Split/leaf encoding: right child per split (>= 0 split, < 0 leaf ~c).
    split_right: IntegerArray;

    /// Split/leaf encoding: missing-value direction per split. Absent means every split
    /// goes `default_left_fill`.
    split_default_left: [bool];

    /// Split/leaf encoding: comparison per split, as decision_lte. Absent means `<=`.
    split_decision_lte: [bool];

    /// Split/leaf encoding: every split's missing-value direction when split_default_left
    /// is absent.
    default_left_fill: bool = false;

    /// Split/leaf encoding: prediction per leaf.
    leaves: RealArray;
}

/// Layer 2 of a grouped model: the trees that rank candidates *within* one group.
///
/// A grouped model answers two questions -- which group, then which candidate inside it --
/// which is one question more than a single tree ensemble can express. MIOpen is the case
/// that needs it (many solvers, each with its own perf-configs), but nothing here names an
/// engine: a group is whatever value the grouping feature takes.
table GbdtGroup {
    /// The grouping feature's value that selects this ensemble.
    value: double;

    /// Trees ranking candidates within this group. Same evaluation as GbdtModel.trees.
    trees: [GbdtTree];
}

/// @brief GBDT (Gradient Boosted Decision Tree) model for the tree_data adapter.
///
/// This is the model artifact format for UHD's default shipping path. The model
/// is exported from LightGBM or XGBoost training and converted to this FlatBuffer
/// format at build time.
///
/// Prediction: sum leaf_values from all trees after traversal, then add base_score:
///     score = base_score + sum(leaf_values)
///
/// learning_rate is metadata only and must NOT be applied here. LightGBM's
/// dump_model() already folds it into leaf_values, so multiplying again double-counts
/// it. A producer whose leaf values exclude the learning rate must scale them before
/// serializing. See TreeDataAdapter::score, which implements this formula.
table GbdtModel {
    /// Array of decision trees in the ensemble.
    trees: [GbdtTree];

    /// Number of input features expected.
    num_features: int32;

    /// SHA-256 hash of the features_signature this model was trained on.
    /// Must match UHD.features_hash at load time.
    features_hash: string;

    /// Base prediction (bias term).
    base_score: double = 0.0;

    /// Learning rate (shrinkage factor). Usually 1.0 for inference.
    learning_rate: double = 1.0;

    /// Optional model metadata.
    framework: string;          // "lightgbm", "xgboost", etc.
    training_date: string;      // ISO 8601 timestamp
    num_training_samples: int64;
    training_objective: string; // "regression", "lambdarank", etc.

    /// Model provenance (RFC 0019 §8.3, §13).
    /// GPU architectures the model was trained on (e.g., ["gfx942", "gfx1100"]).
    /// The runtime compares the device's architecture against this list; on an unseen
    /// architecture it withholds the calibrated engine estimate and still ranks kernels
    /// with the model, logging a warning.
    training_arches: [string];

    /// Semantic version of the model (e.g., "1.0.0").
    model_version: string;

    /// Index into the feature row of the value that names a candidate's group, or -1 for a
    /// single-layer model. When absent, -1 identifies a single-layer model.
    group_by_feature_index: int32 = -1;

    /// Layer 2, one entry per group value. Empty for a single-layer model. `trees` above is
    /// layer 1 either way: alone it ranks candidates, and with these it ranks the groups.
    groups: [GbdtGroup];

    /// The distinct split thresholds that split/leaf-encoded trees index. Absent when no
    /// tree uses that encoding.
    threshold_table: RealArray;
}

root_type GbdtModel;

file_identifier "HGBM";  // HipDNN GBDT Model
