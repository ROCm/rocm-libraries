include "norm_common.fbs";

// See graph.fbs for the semantics of these annotations.
attribute "cache_uid";
attribute "matcher_opcode";
attribute "matcher_input_tensor";
attribute "matcher_output_tensor";
attribute "matcher_name";

namespace hipdnn_flatbuffers_sdk.data_objects;

table RMSNormAttributes (matcher_opcode: "rmsnorm") {
    x_tensor_uid: long (cache_uid, matcher_input_tensor, matcher_name: "x");
    scale_tensor_uid: long (cache_uid, matcher_input_tensor, matcher_name: "scale");
    epsilon_tensor_uid: long (cache_uid, matcher_input_tensor, matcher_name: "epsilon");
    y_tensor_uid: long (cache_uid, matcher_output_tensor, matcher_name: "y");
    bias_tensor_uid: long = null (cache_uid, matcher_input_tensor, matcher_name: "bias");
    inv_rms_tensor_uid: long = null (cache_uid, matcher_output_tensor, matcher_name: "inv_rms");
    forward_phase: NormFwdPhase = NOT_SET;
}
