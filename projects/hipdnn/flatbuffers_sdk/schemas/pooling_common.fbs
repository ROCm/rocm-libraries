namespace hipdnn_flatbuffers_sdk.data_objects;

enum PoolingMode : byte {
    UNSET = 0,
    MAX_POOLING = 1,
    AVERAGE = 2,
    AVERAGE_INCLUSIVE = 3
}

enum PaddingMode : byte {
    PADDING_NOT_SET = 0,
    NEG_INF_PAD = 1,
    ZERO_PAD = 2
}
