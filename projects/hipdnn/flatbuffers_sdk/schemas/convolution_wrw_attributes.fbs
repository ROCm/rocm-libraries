include "convolution_common.fbs";

// See graph.fbs for the semantics of these annotations.
attribute "cache_uid";
attribute "umd_opcode";
attribute "umd_input_tensor";
attribute "umd_output_tensor";
attribute "umd_name";

namespace hipdnn_flatbuffers_sdk.data_objects;

table ConvolutionWrwAttributes (umd_opcode: "convolution_bwd_filter") {
    // Input/Output tensor UIDs
    x_tensor_uid: long (cache_uid, umd_input_tensor, umd_name: "x");     // Input tensor
    dy_tensor_uid: long (cache_uid, umd_input_tensor, umd_name: "dy");   // Gradient of output tensor (DY)
    dw_tensor_uid: long (cache_uid, umd_output_tensor, umd_name: "dw");  // Gradient of weights tensor (DW)

    // Convolution parameters (N-dimensional support)
    pre_padding: [long];         // Padding before each dimension
    post_padding: [long];        // Padding after each dimension
    stride: [long];              // Stride for each dimension
    dilation: [long];            // Dilation for each dimension

    // Algorithm/mode selection
    conv_mode: ConvMode;
}
