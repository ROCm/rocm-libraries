include "linear_attention_common.fbs";

// See graph.fbs for the semantics of this annotation.
attribute "cache_uid";

namespace hipdnn_flatbuffers_sdk.data_objects;

// Gated DeltaNet (GDN) forward. Mirrors the cudnn-frontend Python graph op
// graph.gdn (cudnn.linear_attention); cuDNN has no C++ node for it, so the
// backend names carry the _EXT suffix. Per token t and head, with recurrent
// state S [V, K] and scalar decay alpha_t:
//   S_t = alpha_t (I - beta_t k_t^T k_t) S_{t-1} + beta_t k_t^T v_t
//   o_t = scale q_t S_t
//
// Layout (dims are logical; memory layout comes from tensor strides):
//   cu_seqlens present: token-packed, as cuDNN. q [T, H, K], k [T, HK, K],
//     v [T, HV, V], g and beta [T, HO], o [T, HO, V]. T = total tokens,
//     N = sequences = cu_seqlens length - 1.
//   cu_seqlens absent (hipDNN extension): dense batch of N equal-length
//     sequences, each tensor above with a leading N dim, e.g. q [N, T, H, K].
//   HK is H or HV; HO = max(H, HV).
//   initial_state and final_state [N, HO, V, K]; with state_indices [N] they
//     are a pool [P, HO, V, K] addressed per sequence.
table GdnAttributes {
    // Required input tensor UIDs
    q_tensor_uid:    long (cache_uid);
    k_tensor_uid:    long (cache_uid);
    v_tensor_uid:    long (cache_uid);
    g_tensor_uid:    long (cache_uid);  // scalar decay per token and head
    beta_tensor_uid: long (cache_uid);  // write strength (post-sigmoid by default)

    // Optional input tensor UIDs
    cu_seqlens_tensor_uid:    long = null (cache_uid);  // [N + 1]
    initial_state_tensor_uid: long = null (cache_uid);  // absent: zero state
    a_log_tensor_uid:         long = null (cache_uid);  // [HO], safe_gate only
    dt_bias_tensor_uid:       long = null (cache_uid);  // [HO], safe_gate only
    state_indices_tensor_uid: long = null (cache_uid);  // [N], state pool rows

    // Required output tensor UID
    o_tensor_uid: long (cache_uid);

    // Optional output tensor UIDs
    final_state_tensor_uid:       long = null (cache_uid);
    state_checkpoints_tensor_uid: long = null (cache_uid);  // [C, HO, V, K]

    // Scalar attributes
    scale:                     float = null;  // absent: 1/sqrt(K)
    output_final_state:        bool = false;
    use_qk_l2norm:             bool = false;  // L2-normalize q and k rows
    checkpoint_every_n_tokens: long = 0;      // > 0 emits state_checkpoints
    use_beta_sigmoid:          bool = false;  // beta holds logits
    allow_neg_eigval:          bool = false;  // 2 * sigmoid(beta); needs use_beta_sigmoid
    safe_gate:                 bool = false;  // g holds logits: -exp(a_log) * softplus(g + dt_bias)
    gate_domain:               GateDomain = LOG;
    batch_invariant:           bool = false;
    overwrite_initial_state:   bool = false;  // final_state written into initial_state
}
