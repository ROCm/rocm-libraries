include "linear_attention_common.fbs";

// See graph.fbs for the semantics of these annotations.
attribute "cache_uid";
attribute "matcher_opcode";
attribute "matcher_input_tensor";
attribute "matcher_output_tensor";
attribute "matcher_name";

namespace hipdnn_flatbuffers_sdk.data_objects;

// Gated DeltaNet (GDN) forward. Mirrors the cudnn-frontend Python graph op
// graph.gdn (cudnn.linear_attention); cuDNN has no C++ node for it, so the
// backend names carry the _EXT suffix. Per token t and head, with recurrent
// state S [V, K], scalar decay alpha_t, and column vectors k_t, v_t, q_t:
//   S_t = alpha_t S_{t-1} (I - beta_t k_t k_t^T) + beta_t v_t k_t^T
//   o_t = scale S_t q_t
//
// Layout (dims are logical; memory layout comes from tensor strides). Inputs
// are token-packed, as in cuDNN: q [T, H, K], k [T, HK, K], v [T, HV, V],
// g and beta [T, HO], o [T, HO, V]. T = total tokens; cu_seqlens [N + 1]
// holds the sequence offsets, so a dense batch of equal-length sequences is
// cu_seqlens = [0, L, 2L, ...]. HK is H or HV; HO = max(H, HV).
// initial_state and final_state are [N, HO, V, K]; with state_indices [N]
// they are a pool [P, HO, V, K] addressed per sequence. A K-major state is
// passed as transposed strides on the [..., V, K] dims.
//
// Cross-field rules (they match cuDNN). Neither this schema nor the backend
// checks them; they are to be enforced by the frontend:
//   - output_final_state <=> final_state_tensor_uid present.
//   - checkpoint_every_n_tokens > 0 <=> state_checkpoints_tensor_uid present.
//   - state_indices requires initial_state, is [N], and cannot combine with
//     checkpoint_every_n_tokens > 0.
//   - gate_domain = LINEAR is invalid with safe_gate.
//   - a_log and dt_bias require safe_gate.
//   - allow_neg_eigval requires use_beta_sigmoid.
//   - overwrite_initial_state requires initial_state and final_state; the
//     caller binds both UIDs to one device buffer (hipDNN requires unique
//     tensor UIDs, not unique device pointers).
//   - state_checkpoints [C, HO, V, K]: each non-empty sequence of length L
//     gets (L - 1) // n + 1 rows, row 0 being its incoming state, packed by
//     sequence; C = max(T // n + N, 1) rows are allocated
//     (n = checkpoint_every_n_tokens).
table GdnAttributes (matcher_opcode: "gdn") {
    // Required input tensor UIDs
    q_tensor_uid:          long (cache_uid, matcher_input_tensor, matcher_name: "q");
    k_tensor_uid:          long (cache_uid, matcher_input_tensor, matcher_name: "k");
    v_tensor_uid:          long (cache_uid, matcher_input_tensor, matcher_name: "v");
    g_tensor_uid:          long (cache_uid, matcher_input_tensor, matcher_name: "g");  // scalar decay per token and head
    beta_tensor_uid:       long (cache_uid, matcher_input_tensor, matcher_name: "beta");  // write strength (post-sigmoid by default)
    cu_seqlens_tensor_uid: long (cache_uid, matcher_input_tensor, matcher_name: "cu_seqlens");  // [N + 1] sequence offsets

    // Optional input tensor UIDs
    initial_state_tensor_uid: long = null (cache_uid, matcher_input_tensor, matcher_name: "initial_state");  // absent: zero state
    a_log_tensor_uid:         long = null (cache_uid, matcher_input_tensor, matcher_name: "a_log");  // [HO], safe_gate only
    dt_bias_tensor_uid:       long = null (cache_uid, matcher_input_tensor, matcher_name: "dt_bias");  // [HO], safe_gate only
    state_indices_tensor_uid: long = null (cache_uid, matcher_input_tensor, matcher_name: "state_indices");  // [N], state pool rows

    // Required output tensor UID
    o_tensor_uid: long (cache_uid, matcher_output_tensor, matcher_name: "o");

    // Optional output tensor UIDs
    final_state_tensor_uid:       long = null (cache_uid, matcher_output_tensor, matcher_name: "final_state");
    state_checkpoints_tensor_uid: long = null (cache_uid, matcher_output_tensor, matcher_name: "state_checkpoints");  // [C, HO, V, K]

    // Scalar attributes
    scale:                     float = null;  // absent: 1/sqrt(K)
    output_final_state:        bool = false;
    use_qk_l2norm:             bool = false;  // L2-normalize q and k rows
    checkpoint_every_n_tokens: long = 0;      // > 0 emits state_checkpoints
    use_beta_sigmoid:          bool = false;  // beta holds logits
    allow_neg_eigval:          bool = false;  // 2 * sigmoid(beta); needs use_beta_sigmoid
    safe_gate:                 bool = false;  // g holds logits: -exp(a_log) * softplus(g + dt_bias)
    gate_domain:               GateDomain = LOG;
    batch_invariant:           bool = false;
    overwrite_initial_state:   bool = false;  // in-place: final_state shares initial_state's buffer
}
