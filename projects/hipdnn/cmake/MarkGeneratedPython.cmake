# Opens every flatc-generated Python module under OUTPUT_DIR with `# fmt: off`, so the
# repository's formatter leaves generated code as flatc wrote it and the two never fight
# over the committed bindings. scripts/run_flatc.py applies the same line, so a build and
# the pre-commit hook produce identical files.
# Usage: cmake -DOUTPUT_DIR=<dir> -P MarkGeneratedPython.cmake
if(NOT DEFINED OUTPUT_DIR)
    message(FATAL_ERROR "OUTPUT_DIR is required")
endif()

set(_generated_header "# automatically generated by the FlatBuffers compiler")
file(GLOB_RECURSE _modules "${OUTPUT_DIR}/*.py")
foreach(_module IN LISTS _modules)
    file(READ "${_module}" _text)
    string(FIND "${_text}" "${_generated_header}" _at)
    if(_at EQUAL 0)
        # Ended the way the module's own first line is.
        set(_newline "\n")
        string(REGEX MATCH "^[^\n]*\r\n" _crlf_first_line "${_text}")
        if(_crlf_first_line)
            set(_newline "\r\n")
        endif()
        file(WRITE "${_module}" "# fmt: off${_newline}${_text}")
    endif()
endforeach()
