#ifndef HIPDNN_TEST_SDK_VERSION_H
#define HIPDNN_TEST_SDK_VERSION_H

// MAJOR/MINOR/PATCH live in version_number.h, which carries no git hash and so
// stays untouched across commits. Include that instead when the numbers are enough.
#include <hipdnn_test_sdk/version_number.h>

// clang-format off
// NOLINTBEGIN(modernize-macro-to-enum)
#define HIPDNN_TEST_SDK_VERSION_TWEAK "@HIPDNN_TEST_SDK_VERSION_TWEAK@"
#define HIPDNN_TEST_SDK_VERSION_STRING "@HIPDNN_TEST_SDK_VERSION_STRING@"
// NOLINTEND(modernize-macro-to-enum)
// clang-format on

#endif // HIPDNN_TEST_SDK_VERSION_H
