namespace hipdnn_data_sdk.data_objects;

enum NormFwdPhase : byte {
    NOT_SET = 0,
    INFERENCE = 1,
    TRAINING = 2,
}

table LayernormAttributes {
    x_tensor_uid:              long;
    scale_tensor_uid:          long;
    bias_tensor_uid:           long;
    epsilon_tensor_uid:        long;
    y_tensor_uid:              long;
    mean_tensor_uid:           long = null;
    inv_variance_tensor_uid:   long = null;
    forward_phase:             NormFwdPhase = NOT_SET;
}
