# Example reduction sweep (RUNBOOK stage 6): one arm, the whole selection's install,
# measured over the benchmark corpus and, when the user supplied owner data, the
# ground_truth corpus. Copy, edit, and run:
#
#   <venv-python> $GEN/tools/sweep.py --config my-sweep.yaml
#
# Paths, architecture/engine IDs, counts and run settings below are illustrative,
# not defaults to copy blindly. Replace them with real inputs for your run.
#
# DATA, NOT CODE: read with a safe YAML loader that refuses duplicate and non-string
# keys, never sourced, expanded or executed. Paths resolve relative to THIS FILE's
# directory, and commands are argument ARRAYS -- no quoting, no word splitting, no
# shell. `tools/README-sweeps.md` specifies every key's full contract and the gates.

# One root holding everything this sweep reads and writes. Must already exist and be
# visible on the local execution host, or on the execution node for scheduled/remote
# runs: a submit-host-only path fails when the job lands elsewhere.
sweep_root: /shared/sweeps/ingestor

# Where this run's evidence lands: a dedicated child of sweep_root overlapping no input
# root, since the driver hashes every input to decide whether a phase may be resumed.
output_dir: /shared/sweeps/ingestor/results

# Existing root holding one directory per corpus; every corpus path must be inside it.
corpus_dir: /shared/sweeps/ingestor/corpora

# The exact architecture this sweep claims, checked against rocminfo on the running
# machine and the benchmark's reported gpu_arch. A family or marketing name is refused.
arch: gfx950

# engine_ued_name is what the INSTALLED ENGINE registry advertises; discovery resolves
# it to a numeric engine ID. List both with
#   LD_LIBRARY_PATH=<install>/lib <install>/bin/hipdnn_list_engines \
#     --plugin-dir <install>/lib/hipdnn_plugins/engines
# which prints e.g. `hipkernel:Gfx950AttentionDense (0x89C9139111D7C3A5)`.
# engine_name is a label of that engine, matched exactly (a prefix match would credit a
# sibling engine's work to this one): the UED name, or engine_<hex ID> with the ID
# unsigned (engine_0x89c9139111d7c3a5) or signed (engine_-0x7636ec6eee283c5b, what
# dnn-benchmark writes for an ingestor engine). Result rows carrying any of the three
# are attributed when their engine_id is the discovered ID.
engine_name: hipkernel:Gfx950AttentionDense
engine_ued_name: hipkernel:Gfx950AttentionDense

# Corpora are measured separately and never merged. Delete the ground_truth entry when
# no owner data was supplied.
#
# expected_graphs is a gate: a corpus that grew or shrank between runs is not the same
# experiment, and resume binds the CONTENT of every graph file.
corpora:
  - name: bench
    path: /shared/sweeps/ingestor/corpora/bench
    expected_graphs: 283
  - name: ground_truth
    path: /shared/sweeps/ingestor/corpora/ground_truth
    expected_graphs: 40

# expected_descriptors is the total of KDP `kernelDescriptors` entries the install tree
# MUST have, test content included, so a different number means a different install.
# Recount it after every reinstall.
arms:
  - name: selection
    install_tree: /shared/sweeps/ingestor/install
    expected_descriptors: 840

# The arm to run once and DISCARD, so round 1 does not measure a cool device. Name the
# arm above or an explicit null; an absent key is refused rather than defaulted.
warmup_arm: selection

# variant_reduce derives its noise floor from round-to-round spread, so a reduction
# sweep needs at least 2 rounds.
rounds: 2

# A phase serving fewer than this many graphs through the ingestor FAILS. This catches a
# dropped engine; the descriptor count cannot, being a property of files on disk while
# the engine is rejected at load. Set it near the expected served count.
min_served: 30

# Tensor names whose presence makes a graph UNSERVABLE by the kernel under test.
# Unsupported graphs may fall through to another engine, and a device fault invalidates
# subsequent measurements. For attention that class is backward graphs, marked by their
# gradient tensors; the filename is not authoritative.
#
# BOTH spellings are required -- `sample_sdpa_backward` names its gradients
# `dq`/`dk`/`dv`/`do` -- and this value must always match `tools/mine_shapes.py`'s
# `BACKWARD_GRADIENT_TENSOR_NAMES`, enforced by `tests/test_sweep_configs.py`.
#
# REQUIRED, with no default: defaulting to attention's names would silently no-op the
# gate for any other op. An op with no such class must say the string `none`.
exclude_tensors:
  - d_query
  - d_key
  - d_value
  - d_output
  - dq
  - dk
  - dv
  - do

# The benchmark as an argument array. argv[0] must be a real executable, not a shell
# launcher: "the config named a program" and "the config named a script that runs
# programs" are different claims about what was measured.
#
# The driver OWNS --graph, --plugin-path, --engine, --warmup, --iters, -o/--output,
# --validate, --backend, --autotune and --hipdnn-cache-dir (the cache the rankings are
# read from), and refuses a config passing any of them.
benchmark:
  argv:
    - /shared/sweeps/ingestor/bench-venv/bin/dnn-benchmark
  warmup: 25
  iters: 200

# A SEPARATE phase against a real reference provider, run after timing so a comparison
# never perturbs a measurement; its warmup/iters are lower because it compares numbers
# rather than timing them. Enabled, a phase passes only if the reference provider ran and
# every served graph carries a genuine tolerance match -- a skipped reference leaves a
# null tolerance_match, which the benchmark suite counts as a pass. `enabled: false`
# leaves the run reporting SWEEP_TIMING_ONLY: publishable, but not a correctness claim.
correctness:
  enabled: true
  reference: pytorch
  warmup: 3
  iters: 10

# Optional argument array pinning the comparand environment (library shas, versions) into
# the log and the resume fingerprint. Absent, the run is valid but cannot answer "which
# build produced this number" later. Delete the key entirely to omit it.
# probe_env:
#   - /shared/sweeps/ingestor/probe-env
