# Sweep config for the gfx950 attention_dense engine. Copy, edit as needed, and run:
#   SWEEP_CONFIG=configs/gfx950_attention_dense.sweep.env tools/sweep.sh
#
# ARMS, expect_for() and EXCLUDE_TENSORS below are derived from the real profile
# (configs/gfx950_attention_dense.profile.yaml) and the real shipping shape corpus
# (configs/gfx950_attention_dense.shipping-shapes.json) -- see the header of
# sweep-isolation.env.example for what this file's surface is and is not. Everything
# marked NEEDS HUMAN DECISION below depends on a real device machine, a staged graph
# corpus, or a chosen install tree, none of which exist in a config-authoring pass.

# NEEDS HUMAN DECISION: point this at a filesystem the compute node running the sweep
# can actually see (not merely one your shell can see -- see README-sweeps.md).
SWEEP_ROOT=${SWEEP_ROOT:-$HOME/ingestor-sweeps-gfx950}

OUT=$SWEEP_ROOT/results
CORPUS_DIR=$SWEEP_ROOT/corpora

# Same two corpus categories as the worked example (sweep-isolation.env.example):
# what real callers send, and what the kernel owners judge themselves against. See
# README-sweeps.md for how to stage each one for gfx950.
CORPORA="published servable"

# NEEDS HUMAN DECISION: the graph count each staged corpus MUST have, once a real
# gfx950 corpus is staged under $CORPUS_DIR. There is no gfx950 corpus in this
# repository to count, so this cannot be derived here -- an invented number would
# either always fail (too high) or gate nothing (too low).
# EXPECT_GRAPHS_published=<set after staging>
# EXPECT_GRAPHS_servable=<set after staging>

# Tensor names whose presence makes a graph UNSERVABLE by the kernel under test, and
# therefore dangerous: such a graph falls through to whichever engine will take it,
# and one such path faulted the device mid-warmup with every later phase then
# measuring dead hardware. For attention that class is backward graphs, marked by
# their gradient tensors -- the filename is not authoritative.
#
# BOTH gradient spellings are required, not one. `d_query`/`d_key`/`d_value`/
# `d_output` alone let a real backward graph through this gate once: a graph
# spelling its gradients `dq`/`dk`/`dv`/`do` was caught only incidentally, by its
# dtype, rather than by this filter -- see `tools/mine_shapes.py`'s
# `BACKWARD_GRADIENT_TENSOR_NAMES`, the one other place this marker list is
# declared, which this value must always match exactly (`tests/test_sweep_configs.py`
# enforces that).
EXCLUDE_TENSORS=d_query,d_key,d_value,d_output,dq,dk,dv,do

# ARMS RUN IN THIS ORDER, EVERY ROUND, NEVER ROTATED -- see sweep-isolation.env.example
# for why. These are the isolation arms `knob_sweep.py --isolate` emits for the real
# gfx950 profile against the real shipping-shapes corpus: block_n and waves_per_eu are
# occupancy knobs with a stated hazard (see the profile's `sweep:` block), and
# interleave is the boustrophedon query-block order, live only for large-Sq
# persistent shapes.
ARMS="parity block_n128 waves_per_eu4 interleaveTrue"

WARMUP_ARM=parity

ROUNDS=3

# NEEDS HUMAN DECISION: the ingestor-served floor below which a phase FAILS. Set it
# near the expected served count once a real corpus is staged, not to 1 -- see
# sweep-isolation.env.example, which sets 60 against its own 142/283-graph corpora.
MIN_SERVED=1

tree_for() {
    # NEEDS HUMAN DECISION: these must be real install trees built from
    # cmake --install for each arm (parity = the unmodified build; the other three =
    # a build with that one knob's non-default value forced). Placeholder paths
    # below follow the $SWEEP_ROOT/arm-<label> convention so the config is at least
    # structurally complete; sweep.sh's descriptor-count gate (expect_for) will fail
    # loudly if a tree does not exist or was built from the wrong arm.
    case $1 in
        parity)            echo "$SWEEP_ROOT/arm-parity" ;;
        block_n128)        echo "$SWEEP_ROOT/arm-block_n128" ;;
        waves_per_eu4)     echo "$SWEEP_ROOT/arm-waves_per_eu4" ;;
        interleaveTrue)    echo "$SWEEP_ROOT/arm-interleave" ;;
    esac
}

# The descriptor count each tree MUST have. Derived by running `knob_sweep.py
# --isolate` against the real gfx950 profile and shipping-shapes corpus: none of
# block_n, waves_per_eu or interleave changes which shapes resolve, so every arm
# (including parity) emits the same 84-kernel catalog. A different number means the
# arm was built from a different corpus or profile than this sweep's.
expect_for() {
    case $1 in
        parity|block_n128|waves_per_eu4|interleaveTrue) echo 84 ;;
    esac
}

# Optional: a script that pins the comparand environment (library shas, versions)
# into the log. NEEDS HUMAN DECISION if you want one.
# PROBE_ENV=$SWEEP_ROOT/probe-env.sh
