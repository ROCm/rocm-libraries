            "strides": "packed",
            "stride_order": [0, 2, 1, 3],
            "data_type": "${dtype}",
            "virtual": false
        },
        {
            "uid": 2,
            "name": "key",
            "dims": [
                "${batch}",
                "${nhead_k}",
                "${seqlen_k}",
                "${hdim_q}"
