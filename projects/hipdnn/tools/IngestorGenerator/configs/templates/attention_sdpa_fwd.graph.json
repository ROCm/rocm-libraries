            "attributes": {
                "generate_stats": null,
                "alibi_mask": false,
                "padding_mask": false,
                "causal_mask": false,
                "causal_mask_bottom_right": false,
                "dropout_probability": null,
                "attn_scale_value": null,
                "left_bound": null,
                "right_bound": null,
                "max_seq_len_kv": null,
                "diagonal_alignment": "TOP_LEFT",
