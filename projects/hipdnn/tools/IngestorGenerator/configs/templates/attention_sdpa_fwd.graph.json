            "strides": "packed",
            "stride_order": [0, 2, 1, 3],
            "data_type": "${dtype}",
            "virtual": false
        },
        {
            "uid": 3,
            "name": "value",
            "dims": [
                "${batch}",
                "${nhead_k}",
                "${seqlen_k}",
                "${hdim_v}"
            ],
            "strides": "packed",
            "stride_order": [0, 2, 1, 3],
            "data_type": "${dtype}",
            "virtual": false
        },
        {
            "uid": 4,
            "name": "output",
            "dims": [
                "${batch}",
                "${nhead_q}",
                "${seqlen_q}",
                "${hdim_v}"
            ],
            "strides": "packed",
            "stride_order": [0, 2, 1, 3],
            "data_type": "${dtype}",
            "virtual": false
