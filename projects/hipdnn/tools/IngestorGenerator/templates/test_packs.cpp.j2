/**
 * @file Test{{ config.engine.pascal_name }}Packs.cpp
 * @brief The engine's descriptor data: shape, cross-references, and engine id --
 *        a pack-shape census reading the INSTALLED descriptors via
 *        hip_kernel_provider::kernel_ingestor_engine::discoverDescriptorSets()
 *        rather than a hand-built twin, so a broken shipped descriptor fails this
 *        fast suite instead of only the slow GPU integration test.
 *
 * Generated by IngestorGenerator -- complete, not a stub: every assertion below is a
 * pure function of the config that produced this bundle.
 */
namespace
{

using namespace hip_kernel_provider::kernel_ingestor_engine;

/// The descriptor set this engine ships, read from the installed tree.
const hipdnn_plugin_sdk::ingestor::DescriptorSet& loadedSet()
{
    const auto& sets = discoverDescriptorSets();
    const auto match = std::find_if(sets.begin(), sets.end(), [](const auto& set) {
        return set.engine.name == "{{ config.engine.name }}";
    });
    // Fatal rather than a returned optional: every caller here would only
    // dereference it, and a missing set means the descriptors were never
    // installed or never registered -- itself the failure this test exists
    // to catch.
    if(match == sets.end())
    {
        ADD_FAILURE() << "descriptor set '{{ config.engine.name }}' is not installed";
        static const hipdnn_plugin_sdk::ingestor::DescriptorSet empty{};
        return empty;
    }
    return *match;
}

TEST(Test{{ config.engine.pascal_name }}Packs, ShipsExactlyTheConfiguredPackCount)
{
    const auto& set = loadedSet();
    EXPECT_EQ(set.packs.size(), {{ config.packs | length }}U);
}
{% for pack in config.packs %}

TEST(Test{{ config.engine.pascal_name }}Packs, Pack{{ pack.pascal_name }}ShipsItsConfiguredKernels)
{
    const auto& set = loadedSet();
    const auto match = std::find_if(set.packs.begin(), set.packs.end(), [](const auto& p) {
        return p.name == "{{ config.engine.name }}:{{ pack.name }}";
    });
    ASSERT_NE(match, set.packs.end());
    EXPECT_EQ(match->kernels.size(), {{ pack.kernels | length }}U);
}
{% endfor %}

TEST(Test{{ config.engine.pascal_name }}Packs, ExposesTheConfiguredKnobs)
{
    const auto& set = loadedSet();
    ASSERT_EQ(set.engine.knobs.size(), {{ config.engine.knobs | length }}U);
{% for knob in config.engine.knobs %}
    EXPECT_NE(std::find(set.engine.knobs.begin(), set.engine.knobs.end(), "{{ knob }}"),
              set.engine.knobs.end());
{% endfor %}
}

{% if config.is_multi_pack %}
/// UMD policy check, this engine's shape: a MULTI-pack engine carries one
/// graph-scoped operation matcher per pack, on top of the one shared kernel-scoped
/// matcher -- the opposite of the single-pack case, which carries zero.
TEST(Test{{ config.engine.pascal_name }}Packs, CarriesOneGraphScopedMatcherPerPack)
{
    const auto& set = loadedSet();
    const auto graphScoped = std::count_if(set.matchers.begin(), set.matchers.end(), [](const auto& matcher) {
        return matcher.scope == hipdnn_plugin_sdk::ingestor::MatchScope::GRAPH;
    });
    EXPECT_EQ(graphScoped, {{ config.packs | length }});
}
{% else %}
/// UMD policy check, this engine's shape: a SINGLE-pack engine has nothing to
/// discriminate between, so it carries no graph-scoped criterion at all -- the
/// engine's own graph_match both admits the node type and validates shape in one
/// pass. Mirrors TestConvFwdPack.cpp's HasAGraphMatchAndOneKernelMatcher.
TEST(Test{{ config.engine.pascal_name }}Packs, CarriesNoGraphScopedMatcher)
{
    const auto& set = loadedSet();
    EXPECT_FALSE(set.engine.graphMatchNativeSymbol.empty());
    const auto graphScoped = std::count_if(set.matchers.begin(), set.matchers.end(), [](const auto& matcher) {
        return matcher.scope == hipdnn_plugin_sdk::ingestor::MatchScope::GRAPH;
    });
    EXPECT_EQ(graphScoped, 0);
}
{% endif %}

TEST(Test{{ config.engine.pascal_name }}Packs, CarriesExactlyOneSharedKernelScopedMatcher)
{
    const auto& set = loadedSet();
    const auto kernelScoped = std::count_if(set.matchers.begin(), set.matchers.end(), [](const auto& matcher) {
        return matcher.scope == hipdnn_plugin_sdk::ingestor::MatchScope::KERNEL;
    });
    EXPECT_EQ(kernelScoped, 1);
}
