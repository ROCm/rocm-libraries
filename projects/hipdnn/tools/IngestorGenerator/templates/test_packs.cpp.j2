TEST(Test{{ config.engine.pascal_name }}Packs, EveryKernelNamesItsPacksEmbeddedSource)
{
    const auto& set = loadedSet();
    for(const auto& pack : set.packs)
    {
        for(const auto& kernel : pack.kernels)
        {
            EXPECT_EQ(kernel.source.kind, hipdnn_plugin_sdk::ingestor::KernelSourceKind::EMBEDDED_SOURCE);
        }
    }
}

