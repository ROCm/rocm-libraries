/**
 * @file Test{{ config.engine.pascal_name }}Packs.cpp
 * @brief A census of what {{ config.engine.name }} ACTUALLY LOADS, read through
 *        hip_kernel_provider::kernel_ingestor_engine::discoverDescriptorSets(),
 *        which runs the provider's real typed registration before validating and
 *        loading, so a pack whose native symbols do not register drops out here
 *        rather than at first dispatch on a device.
 *
 * The expectations are rendered from the FINALIZED emitted-bundle inventory -- names,
 * counts, runtime source kind, SDK version and architecture coverage of the documents
 * this run wrote, after metadata resolution, the resolved-knob check and engine-wide
 * de-duplication -- not from the authored config, whose pack file stems are not the
 * pack names the loader reports.
 *
 * This file belongs to the census binary, hip_kernel_provider_census_tests, NOT to the
 * ordinary unit binary: every case below needs a descriptor shard and the census
 * environment, which an ordinary unit run has no business requiring. The generated
 * matcher test is the one that stays in hip_kernel_provider_tests.
 *
 * Register one entry with hkp_register_census_tests(TARGET ... PACK_NAME ... ARCHES ...
 * SUITES Test{{ config.engine.pascal_name }}Packs EXPECTED_CASES ...) in
 * src/tests/CMakeLists.txt, beside hkp_verify_embedded_sources(). CMake registers one
 * native process per ELIGIBLE arch -- the arches this bundle emitted, intersected with
 * the ones the pack target was wired for -- supplying the shard's
 * HIPDNN_DESCRIPTOR_DIR, HIPDNN_TEST_EXPECTED_ARCH (from the caller, never detected)
 * and HIPDNN_TEST_CENSUS_SUITE. An arch this bundle ships nothing for is not registered
 * at all, rather than registered against another arch's shard. Every registered case
 * must then execute and pass without skipping in every iteration, so declare a suite
 * only where every case reads one pack target's shard.
 *
 * This proves registration, loading and inventory, and nothing about dispatch.
 *
 * Generated by IngestorGenerator -- complete, not a stub.
 */
namespace
{

using namespace hip_kernel_provider::kernel_ingestor_engine;
namespace ingestor = hipdnn_plugin_sdk::ingestor;

/// One architecture's row of the emitted inventory.
struct ExpectedInventory
{
    std::set<std::string> packNames;
    std::set<std::string> kernelNames;
};

/// Wildcard key: descriptors naming no architecture ship for every device, so they
/// cannot be filed under a concrete id.
constexpr const char* ARCH_WILDCARD = "*";

/// The emitted inventory, keyed by architecture.
const std::map<std::string, ExpectedInventory>& expectedByArch()
{
    static const std::map<std::string, ExpectedInventory> s_expected = {
{% for arch, entry in emitted.arches.items() %}
        {"{{ arch | cpp_escape }}",
         ExpectedInventory{
             {
{% for stem in entry.pack_names %}
                 "{{ config.engine.namespace | cpp_escape }}:{{ stem | cpp_escape }}",
{% endfor %}
             },
             {
{% for name in entry.descriptor_names %}
                 "{{ name | cpp_escape }}",
{% endfor %}
             },
         }},
{% endfor %}
    };
    return s_expected;
}

/// The runtime source kind every kernel must declare at the loader. A packaged bundle
/// is lowered to a kpack archive first, so the authored builder kind is not what
/// arrives.
constexpr ingestor::KernelSourceKind EXPECTED_SOURCE_KIND
    = ingestor::KernelSourceKind::{{ {'embedded_source': 'EMBEDDED_SOURCE',
                                      'kpack': 'KPACK',
                                      'hsaco_file': 'HSACO_FILE'}[emitted.source_kind] }};

/// A pack or kernel naming no architecture inherits/wildcards; one that names
/// architectures must name the requested one, or this is the wrong shard.
bool coversArch(const std::vector<std::string>& declared, const std::string& arch)
{
    return declared.empty() || std::find(declared.begin(), declared.end(), arch) != declared.end();
}

class Test{{ config.engine.pascal_name }}Packs : public ::testing::Test
{
protected:
    void SetUp() override
    {
        _arch = hipdnn_data_sdk::utilities::getEnv("HIPDNN_TEST_EXPECTED_ARCH");
        ASSERT_FALSE(_arch.empty())
            << "HIPDNN_TEST_EXPECTED_ARCH is unset, so this census has no expectation to "
               "check against. The architecture is supplied explicitly by the caller; it "
               "is never detected from a device and never taken from the descriptors "
               "being censused.";

        const auto& table = expectedByArch();
        auto row = table.find(_arch);
        if(row == table.end())
        {
            row = table.find(ARCH_WILDCARD);
        }
        ASSERT_NE(row, table.end())
            << "this bundle emitted no descriptors for architecture '" << _arch
            << "' and no architecture-independent ones either, so there is no expected "
               "identity to check. Either the wrong architecture was requested or the "
               "generation that produced this bundle did not cover it.";
        _expected = &row->second;

        const auto& sets = discoverDescriptorSets();
        const auto match = std::find_if(sets.begin(), sets.end(), [](const auto& set) {
            return set.engine.name == "{{ config.engine.name | cpp_escape }}";
        });
        ASSERT_NE(match, sets.end())
            << "descriptor set '{{ config.engine.name | cpp_escape }}' did not load. Either its "
               "descriptors were never installed under the tree this binary reads, or "
               "its pack failed to register its native symbols and every descriptor "
               "naming one of them was dropped.";
        _set = &*match;
    }

    std::string _arch;
    const ExpectedInventory* _expected = nullptr;
    const ingestor::DescriptorSet* _set = nullptr;
};

TEST_F(Test{{ config.engine.pascal_name }}Packs, LoadsExactlyTheEmittedPacks)
{
    std::set<std::string> loaded;
    for(const auto& pack : _set->packs)
    {
        loaded.insert(pack.name);
    }
    // Set equality, not a count: a missing pack and an extra one cancel in a count.
    EXPECT_EQ(loaded, _expected->packNames);
}

TEST_F(Test{{ config.engine.pascal_name }}Packs, LoadsExactlyTheEmittedKernels)
{
    std::set<std::string> loaded;
    for(const auto& pack : _set->packs)
    {
        for(const auto& kernel : pack.kernels)
        {
            loaded.insert(kernel.name);
        }
    }
    EXPECT_EQ(loaded, _expected->kernelNames);
}

TEST_F(Test{{ config.engine.pascal_name }}Packs, EveryLoadedDescriptorCoversTheRequestedArch)
{
    for(const auto& pack : _set->packs)
    {
        EXPECT_TRUE(coversArch(pack.arch, _arch))
            << "pack '" << pack.name << "' does not cover '" << _arch
            << "', so this is not that architecture's shard";
        for(const auto& kernel : pack.kernels)
        {
            EXPECT_TRUE(coversArch(kernel.arch, _arch))
                << "kernel '" << kernel.name << "' does not cover '" << _arch << "'";
        }
    }
}

TEST_F(Test{{ config.engine.pascal_name }}Packs, EveryKernelDeclaresTheEmittedRuntimeSourceKind)
{
    for(const auto& pack : _set->packs)
    {
        for(const auto& kernel : pack.kernels)
        {
            EXPECT_EQ(kernel.source.kind, EXPECTED_SOURCE_KIND)
                << "kernel '" << kernel.name << "' reached the loader as a different "
                << "source kind than this bundle ships";
        }
    }
}

TEST_F(Test{{ config.engine.pascal_name }}Packs, DeclaresTheConfiguredSdkVersion)
{
    EXPECT_EQ(_set->engine.sdkVersion,
              hipdnn_data_sdk::utilities::Version{std::string("{{ emitted.sdk_version | cpp_escape }}")});
}

TEST_F(Test{{ config.engine.pascal_name }}Packs, ExposesTheConfiguredKnobs)
{
    ASSERT_EQ(_set->engine.knobs.size(), {{ config.engine.knobs | length }}U);
{% for knob in config.engine.knobs %}
    EXPECT_NE(std::find(_set->engine.knobs.begin(), _set->engine.knobs.end(), "{{ knob | cpp_escape }}"),
              _set->engine.knobs.end());
{% endfor %}
}

{% if config.engine.has_heuristic %}
/// The engine ships a ranking model, so its score symbol must be REGISTERED, not merely
/// named: a descriptor naming an unregistered one is dropped, and the engine then ranks
/// on priority as if no model existed.
TEST_F(Test{{ config.engine.pascal_name }}Packs, RanksThroughItsRegisteredScoreSymbol)
{
    ASSERT_TRUE(_set->heuristic.has_value());
    EXPECT_EQ(_set->heuristic->payload, "{{ config.score_symbol | cpp_escape }}");
    EXPECT_TRUE(ingestor::ScoreRegistry::isRegistered("{{ config.score_symbol | cpp_escape }}"));
}
{% else %}
/// heuristic: none. The engine ranks on priority then descriptor id, so it ships no UHD
/// and registers no score symbol. Loading cannot show the second half, so the registry
/// is asked directly.
TEST_F(Test{{ config.engine.pascal_name }}Packs, ShipsNoHeuristicAndRegistersNoScoreSymbol)
{
    EXPECT_FALSE(_set->heuristic.has_value());
    EXPECT_FALSE(ingestor::ScoreRegistry::isRegistered("{{ config.score_symbol | cpp_escape }}"));
}
{% endif %}

{% if config.is_multi_pack %}
/// UMD policy, this engine's shape: a MULTI-pack engine carries one graph-scoped
/// operation matcher per pack, on top of the one shared kernel-scoped matcher.
TEST_F(Test{{ config.engine.pascal_name }}Packs, CarriesOneGraphScopedMatcherPerPack)
{
    const auto graphScoped
        = std::count_if(_set->matchers.begin(), _set->matchers.end(), [](const auto& matcher) {
              return matcher.scope == ingestor::MatchScope::GRAPH;
          });
    EXPECT_EQ(static_cast<size_t>(graphScoped), _expected->packNames.size());
}
{% else %}
/// UMD policy, this engine's shape: a SINGLE-pack engine carries no graph-scoped
/// criterion -- its own graph_match admits the node type and validates shape. Mirrors
/// TestConvFwdPack.cpp's HasAGraphMatchAndOneKernelMatcher.
TEST_F(Test{{ config.engine.pascal_name }}Packs, CarriesNoGraphScopedMatcher)
{
    EXPECT_FALSE(_set->engine.graphMatchNativeSymbol.empty());
    const auto graphScoped
        = std::count_if(_set->matchers.begin(), _set->matchers.end(), [](const auto& matcher) {
              return matcher.scope == ingestor::MatchScope::GRAPH;
          });
    EXPECT_EQ(graphScoped, 0);
}
{% endif %}

TEST_F(Test{{ config.engine.pascal_name }}Packs, CarriesExactlyOneSharedKernelScopedMatcher)
{
    const auto kernelScoped
        = std::count_if(_set->matchers.begin(), _set->matchers.end(), [](const auto& matcher) {
              return matcher.scope == ingestor::MatchScope::KERNEL;
          });
    EXPECT_EQ(kernelScoped, 1);
}
