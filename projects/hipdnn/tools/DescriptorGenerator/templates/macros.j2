{#- Shared Jinja2 macros for DescriptorGenerator templates. -#}

{#- Derives the constant name for a vector data field's test value.
    Uses test_constant_name if set, otherwise derives from the field name
    using the operation's tensor_const_prefix for consistent naming.

    Usage: {{ vector_const_name(df, op) }}
-#}
{%- macro vector_const_name(df, op) -%}
{%- if df.test_constant_name -%}
{{ df.test_constant_name }}
{%- else -%}
{{ op.tensor_const_prefix }}{{ df.name | upper }}
{%- endif -%}
{%- endmacro -%}

{#- Emits an assignment for a frontend DataField. Existing handwritten
    attribute classes expose some fields as public members rather than setter
    methods, so generated tests must mirror the configured access pattern. -#}
{%- macro assign_frontend_data_field(object_name, field, value) -%}
{%- if field.frontend_uses_member_access -%}
{{ object_name }}.{{ field.frontend_member_name }} = {{ value }};
{%- else -%}
{{ object_name }}.{{ field.frontend_setter_name }}({{ value }});
{%- endif -%}
{%- endmacro -%}

{#- Renders YAML scalar values as C++ literals for generated test setup. -#}
{%- macro cpp_literal(value) -%}
{%- if value is sameas true -%}
true
{%- elif value is sameas false -%}
false
{%- else -%}
{{ value }}
{%- endif -%}
{%- endmacro -%}
