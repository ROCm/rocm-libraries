// Exercises JSON serialization and deserialization for each mode, including
// canonicalization of mode-irrelevant frontend attributes.
TEST_F(Integration{{ op.frontend.attributes_filename or op.name }}DescriptorLifting, JsonRoundTripsAllModeScenarios)
{
{% set mf = op.mode_fields[0] %}
{% for scenario in op.mode_integration_scenarios %}
    {
        auto attrs = createAttributes();
        attrs.set_name("test_json_{{ scenario.name }}");
        {{ assign_frontend_data_field("attrs", mf, mf.effective_frontend_type ~ "::" ~ scenario.mode) }}
{% for df in op.data_fields if df.is_scalar %}
{% set value = scenario.scalar_overrides.get(df.name, df.test_value if df.test_value is not none else op.test_data.field_values.get(df.name, 0)) %}
        {{ assign_frontend_data_field("attrs", df, cpp_literal(value)) }}
{% endfor %}

        auto originalGraph = buildGraph(
            std::move(attrs)
{% for param in op.frontend.graph_method_params if param.optional %}
            , {{ "true" if (param.tensor_name or param.name) in scenario.provided_optional_inputs else "false" }}
{% endfor %}
            );

        auto result = originalGraph->validate();
        ASSERT_EQ(result.code, ErrorCode::OK) << result.err_msg;

        std::string jsonData;
        result = originalGraph->serialize(jsonData);
        ASSERT_EQ(result.code, ErrorCode::OK) << result.err_msg;
        ASSERT_FALSE(jsonData.empty());

        auto liftedGraph = std::make_shared<TestableGraphLifting>();
        result = liftedGraph->deserialize(_handle, jsonData);
        ASSERT_EQ(result.code, ErrorCode::OK) << result.err_msg;

        const auto tensorMap = liftedGraph->getTensorsByUid();
        ASSERT_EQ(tensorMap.size(), {{ (op.required_tensor_fields | length) + (scenario.expected_optional_inputs | length) }}u);
        auto& subNodes = liftedGraph->getSubNodes();
        ASSERT_EQ(subNodes.size(), 1u);
        auto* opNode = dynamic_cast<{{ op.frontend.node_class }}*>(subNodes[0].get());
        ASSERT_NE(opNode, nullptr);
        EXPECT_EQ(opNode->attributes.{{ mf.frontend_getter }},
                  {{ mf.effective_frontend_type }}::{{ scenario.mode }});
{% for tf in op.optional_tensor_fields %}
{% set ft = op.tensor_field_frontend_map.get(tf.name) %}
{% if ft %}
{% if tf.name in scenario.expected_optional_inputs %}
        ASSERT_NE(opNode->attributes.{{ ft.effective_getter_name }}(), nullptr);
{% else %}
        EXPECT_EQ(opNode->attributes.{{ ft.effective_getter_name }}(), nullptr);
{% endif %}
{% endif %}
{% endfor %}
{% for df in op.data_fields if df.is_scalar %}
{% set input_value = scenario.scalar_overrides.get(df.name, df.test_value if df.test_value is not none else op.test_data.field_values.get(df.name, 0)) %}
{% set expected_value = scenario.expected_scalar_values.get(df.name, input_value) %}
        EXPECT_EQ(opNode->attributes.{{ df.frontend_getter }},
                  {{ cpp_literal(expected_value) }});
{% endfor %}
    }
{% endfor %}
}

