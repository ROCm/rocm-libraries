// Lifts a frontend graph via build_operation_graph(handle), then
// reconstructs it with fromBackendDescriptor() for verification.
class Integration{{ op.frontend.attributes_filename or op.name }}DescriptorLifting : public IntegrationTestFixture
{
protected:
    /// Builds a standard {{ op.name }} graph for round-trip testing.
    static {{ op.frontend.attributes_class }}
        createAttributes(DataType operationComputeDataType = DataType::NOT_SET)
    {
        {{ op.frontend.attributes_class }} attrs;
        attrs.set_name("test_op");
{% if op.mode_fields %}
{% set mf = op.mode_fields[0] %}
{% set value = mf.effective_frontend_type ~ '::' ~ baseline_mode_name(op, mf) %}
        {{ assign_frontend_data_field("attrs", mf, value) }}
{% endif %}
{% for df in op.data_fields if df.is_vector and df.required %}
{% if df.name in op.test_data.field_values %}
{% set const_name = vector_const_name(df, op) %}
        {{ assign_frontend_data_field("attrs", df, "toVec(" ~ const_name ~ ")") }}
{% endif %}
{% endfor %}
{% for df in op.data_fields if df.is_scalar %}
{% set value = baseline_scalar_value(op, df) %}
        {{ assign_frontend_data_field("attrs", df, value) }}
{% endfor %}
        if(operationComputeDataType != DataType::NOT_SET)
        {
            attrs.set_compute_data_type(operationComputeDataType);
        }
        return attrs;
    }

    static std::shared_ptr<TestableGraphLifting> buildGraph(
        {{ op.frontend.attributes_class }} attrs
{% for param in op.frontend.graph_method_params if param.optional %}
        , bool include{{ param.name[0] | upper }}{{ param.name[1:] }} = false
{% endfor %}
        )
    {
        auto graph = std::make_shared<TestableGraphLifting>();
        graph->set_name("{{ op.name }}LiftingTestGraph")
            .set_compute_data_type(DataType::FLOAT)
            .set_intermediate_data_type(DataType::FLOAT)
            .set_io_data_type(DataType::FLOAT);

{% set rmap = op.frontend_to_tensor_field_map %}
{% for param in op.frontend.graph_method_params %}
{% set tf_name = rmap.get(param.tensor_name, param.tensor_name) %}
{% set tc = op.test_data.tensor_configs.get(tf_name) %}
{% if param.optional %}
        std::shared_ptr<TensorAttributes> {{ param.name }};
        if(include{{ param.name[0] | upper }}{{ param.name[1:] }})
        {
            {{ param.name }} = std::make_shared<TensorAttributes>();
            {{ param.name }}->set_uid({{ op.tensor_const_prefix }}TENSOR_{{ tf_name | upper }}_UID)
                .set_name("{{ param.tensor_name }}")
                .set_data_type(DataType::{{ tc.data_type if tc else "FLOAT" }});
{% if tc %}
            {{ param.name }}->set_dim(toVec({{ op.tensor_const_prefix }}TENSOR_{{ tf_name | upper }}_DIMS))
                .set_stride(toVec({{ op.tensor_const_prefix }}TENSOR_{{ tf_name | upper }}_STRIDES));
{% endif %}
        }
{% else %}
        auto {{ param.name }} = std::make_shared<TensorAttributes>();
        {{ param.name }}->set_uid({{ op.tensor_const_prefix }}TENSOR_{{ tf_name | upper }}_UID)
            .set_name("{{ param.tensor_name }}")
            .set_data_type(DataType::{{ tc.data_type if tc else "FLOAT" }});
{% if tc %}
        {{ param.name }}->set_dim(toVec({{ op.tensor_const_prefix }}TENSOR_{{ tf_name | upper }}_DIMS))
            .set_stride(toVec({{ op.tensor_const_prefix }}TENSOR_{{ tf_name | upper }}_STRIDES));
{% endif %}
{% endif %}

{% endfor %}
{% if op.frontend.graph_return_type == 'single' %}
{% set out_name = op.frontend.graph_return_outputs[0] %}
{% set out_tf_name = rmap.get(out_name, out_name) %}
        auto {{ out_name }} = graph->{{ op.frontend.graph_method_name }}(
{% for param in op.frontend.graph_method_params %}
            {{ param.name }},
{% endfor %}
            std::move(attrs));
        {{ out_name }}->set_uid({{ op.tensor_const_prefix }}TENSOR_{{ out_tf_name | upper }}_UID)
            .set_output(true)
            .set_name("{{ out_name }}");
{% elif op.frontend.graph_return_type == 'array' %}
{% set out_name = op.frontend.graph_return_outputs[0] %}
{% set out_tf_name = rmap.get(out_name, out_name) %}
        auto results = graph->{{ op.frontend.graph_method_name }}(
{% for param in op.frontend.graph_method_params %}
            {{ param.name }},
{% endfor %}
            std::move(attrs));
        results[0]->set_uid({{ op.tensor_const_prefix }}TENSOR_{{ out_tf_name | upper }}_UID)
            .set_output(true)
            .set_name("{{ out_name }}");
{% endif %}

        return graph;
    }
};

// Builds a standard {{ op.name }} graph, lowers via build_operation_graph(handle),
// lifts back with fromBackendDescriptor(), and performs comprehensive field-by-field
// validation of graph data types, tensor attributes, and operation parameters.
TEST_F(Integration{{ op.frontend.attributes_filename or op.name }}DescriptorLifting, Basic{{ op.name }}RoundTrip)
{
    auto originalGraph = buildGraph(createAttributes());

    auto liftedGraph = liftGraph(*originalGraph, _handle);
    ASSERT_NE(liftedGraph, nullptr);

    // Verify graph-level data types
    EXPECT_EQ(liftedGraph->get_compute_data_type(), DataType::FLOAT);
    EXPECT_EQ(liftedGraph->get_intermediate_data_type(), DataType::FLOAT);
    EXPECT_EQ(liftedGraph->get_io_data_type(), DataType::FLOAT);

    // Verify tensors by UID
    auto tensorMap = liftedGraph->getTensorsByUid();
    ASSERT_EQ(tensorMap.size(), {{ op.required_tensor_fields | length }}u);

{% for tf in op.required_tensor_fields %}
{% set tf_upper = tf.name | upper %}
{% set tc = op.test_data.tensor_configs.get(tf.name) %}
    // Verify {{ tf.name }} tensor
    ASSERT_NE(tensorMap.count({{ op.tensor_const_prefix }}TENSOR_{{ tf_upper }}_UID), 0u);
    EXPECT_EQ(tensorMap[{{ op.tensor_const_prefix }}TENSOR_{{ tf_upper }}_UID]->get_uid(), {{ op.tensor_const_prefix }}TENSOR_{{ tf_upper }}_UID);
{% if tc %}
    EXPECT_EQ(tensorMap[{{ op.tensor_const_prefix }}TENSOR_{{ tf_upper }}_UID]->get_dim(), toVec({{ op.tensor_const_prefix }}TENSOR_{{ tf_upper }}_DIMS));
    EXPECT_EQ(tensorMap[{{ op.tensor_const_prefix }}TENSOR_{{ tf_upper }}_UID]->get_stride(), toVec({{ op.tensor_const_prefix }}TENSOR_{{ tf_upper }}_STRIDES));
{% endif %}
    EXPECT_EQ(tensorMap[{{ op.tensor_const_prefix }}TENSOR_{{ tf_upper }}_UID]->get_data_type(), DataType::{{ tc.data_type if tc else "FLOAT" }});
{% set ft = op.tensor_field_frontend_map.get(tf.name) %}
    EXPECT_EQ(tensorMap[{{ op.tensor_const_prefix }}TENSOR_{{ tf_upper }}_UID]->get_name(), "{{ ft.name if ft else tf.name }}");

{% endfor %}
    // Verify sub-node count and type
    auto& subNodes = liftedGraph->getSubNodes();
    ASSERT_EQ(subNodes.size(), 1u) << "Expected 1 operation node in lifted graph"; // NOLINT(readability-implicit-bool-conversion)

    auto* opNode = dynamic_cast<{{ op.frontend.node_class }}*>(subNodes[0].get());
    ASSERT_NE(opNode, nullptr) << "Expected a {{ op.frontend.node_class }}"; // NOLINT(readability-implicit-bool-conversion)

{% if op.mode_fields %}
{% set mf = op.mode_fields[0] %}
    // Verify mode
    EXPECT_EQ(opNode->attributes.{{ mf.frontend_getter }}, {{ mf.effective_frontend_type }}::{{ baseline_mode_name(op, mf) }});
{% endif %}

{% for df in op.data_fields if df.is_vector and df.required %}
{% if df.name in op.test_data.field_values %}
{% set const_name = vector_const_name(df, op) %}
    // Verify {{ df.name }}
    EXPECT_EQ(opNode->attributes.{{ df.frontend_getter }}, toVec({{ const_name }}));
{% endif %}
{% endfor %}
{% for df in op.data_fields if df.is_scalar %}
{% set value = baseline_scalar_value(op, df) %}
    EXPECT_EQ(opNode->attributes.{{ df.frontend_getter }}, {{ value }});
{% endfor %}

    // Verify operation name
    EXPECT_EQ(opNode->attributes.get_name(), "test_op");
}

