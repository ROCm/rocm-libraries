    EXPECT_EQ(opNode->attributes.{{ ft.effective_getter_name }}()->get_stride(), toVec({{ op.tensor_const_prefix }}TENSOR_{{ tf.name | upper }}_STRIDES));
    EXPECT_EQ(opNode->attributes.{{ ft.effective_getter_name }}()->get_name(), "{{ ft.name }}");
{% endif %}
