TEST_F(TestGraphDescriptor{{ op.name }}, BuildWith{{ taf.test_label or taf.name | replace('_', ' ') | title | replace(' ', '') }}TensorArray)
{
{% for tf in op.tensor_fields %}
{% set tc = op.test_data.tensor_configs.get(tf.name) %}
{% if tc %}
    auto {{ tf.local_desc_name }} = createFinalizedTensor({{ op.test_data.tensor_uids.get(tf.name, loop.index) }}, {{ '{' }}{{ tc.dims | join(', ') }}{{ '}' }}, {{ '{' }}{{ tc.strides | join(', ') }}{{ '}' }});
{% else %}
    auto {{ tf.local_desc_name }} = createFinalizedTensor({{ op.test_data.tensor_uids.get(tf.name, loop.index) }});
{% endif %}
{% endfor %}
{% for uid in taf.test_uids %}
    auto {{ taf.name }}Desc{{ loop.index0 }} = createFinalizedTensor({{ uid }});
{% endfor %}

    std::vector<HipdnnBackendDescriptor*> {{ taf.name }}Descs = {{ '{' }}{% for uid in taf.test_uids %}{{ taf.name }}Desc{{ loop.index0 }}.get(){% if not loop.last %}, {% endif %}{% endfor %}{{ '}' }};
    auto opDesc = createFinalized{{ op.name }}Op({% for tf in op.tensor_fields %}{{ tf.local_desc_name }}.get(){% if not loop.last %}, {% endif %}{% endfor %}, {{ taf.name }}Descs);

    auto desc = getDescriptor();
    setHandle();

    std::array<HipdnnBackendDescriptor*, 1> ops = {opDesc.get()};
    ASSERT_NO_THROW(desc->setAttribute(
        HIPDNN_ATTR_OPERATIONGRAPH_OPS, HIPDNN_TYPE_BACKEND_DESCRIPTOR, 1, ops.data()));
    ASSERT_NO_THROW(desc->finalize());

    auto serialized = desc->getSerializedGraph();
    auto graphT = GetGraph(serialized.ptr)->UnPack();

    ASSERT_EQ(graphT->nodes.size(), 1);

    auto* attrs = graphT->nodes[0]->attributes.As{{ op.fbs_table }}();
    ASSERT_NE(attrs, nullptr);

    // Verify {{ taf.name }} tensor array UIDs
    ASSERT_EQ(attrs->{{ taf.fbs_field }}.size(), {{ taf.test_uids | length }}u);
{% for uid in taf.test_uids %}
    EXPECT_EQ(attrs->{{ taf.fbs_field }}[{{ loop.index0 }}], {{ uid }});
{% endfor %}
}
{% endif %}
{% endfor %}

