{% for scenario in op.mode_integration_scenarios %}
// Verifies the canonical serialized footprint for {{ scenario.mode }} mode.
// Surplus frontend attributes are accepted for cuDNN compatibility and omitted
// when the selected mode does not serialize them.
TEST_F(Integration{{ op.frontend.attributes_filename or op.name }}DescriptorLowering, ModeScenario{{ scenario.pascal_name }})
{
    {{ op.frontend.attributes_class }} attrs;
    attrs.set_name("test_{{ scenario.name }}");
{% set mf = op.mode_fields[0] %}
    {{ assign_frontend_data_field("attrs", mf, mf.effective_frontend_type ~ "::" ~ scenario.mode) }}
{% for df in op.data_fields if df.is_vector and df.required %}
{% if df.name in op.test_data.field_values %}
{% set const_name = vector_const_name(df, op) %}
    {{ assign_frontend_data_field("attrs", df, "toVec(" ~ const_name ~ ")") }}
{% endif %}
{% endfor %}
{% for df in op.data_fields if df.is_scalar %}
{% set value = scenario.scalar_overrides.get(df.name, df.test_value if df.test_value is not none else op.test_data.field_values.get(df.name, 0)) %}
    {{ assign_frontend_data_field("attrs", df, cpp_literal(value)) }}
{% endfor %}

    auto graphT = buildAndDeserialize(
        attrs
{% for param in op.frontend.graph_method_params if param.optional %}
        , {{ "true" if (param.tensor_name or param.name) in scenario.provided_optional_inputs else "false" }}
{% endfor %}
        );

    ASSERT_EQ(graphT.tensors.size(), {{ (op.required_tensor_fields | length) + (scenario.expected_optional_inputs | length) }}u);
    ASSERT_EQ(graphT.nodes.size(), 1u);
    const auto* opNode = graphT.nodes[0]->attributes.As{{ op.fbs_table }}();
    ASSERT_NE(opNode, nullptr);
    EXPECT_EQ(opNode->{{ mf.fbs_field }}, {{ mf.enum_short_type }}Sdk::{{ scenario.mode }});
{% for tf in op.optional_tensor_fields %}
{% set uid_const = op.tensor_const_prefix ~ "TENSOR_" ~ (tf.name | upper) ~ "_UID" %}
{% if tf.name in scenario.expected_optional_inputs %}
    ASSERT_TRUE(opNode->{{ tf.uid_field }}.has_value());
    EXPECT_EQ(*opNode->{{ tf.uid_field }}, {{ uid_const }});
{% else %}
    EXPECT_FALSE(opNode->{{ tf.uid_field }}.has_value());
{% endif %}
{% endfor %}
{% for df in op.data_fields if df.is_scalar %}
{% set input_value = scenario.scalar_overrides.get(df.name, df.test_value if df.test_value is not none else op.test_data.field_values.get(df.name, 0)) %}
{% set expected_value = scenario.expected_scalar_values.get(df.name, input_value) %}
    EXPECT_EQ(opNode->{{ df.fbs_field }}, {{ cpp_literal(expected_value) }});
{% endfor %}
}
{% endfor %}

{% if op.frontend.graph_return_type == 'single' %}
// Verifies that lowering assigns unique UIDs when callers omit them.
TEST_F(Integration{{ op.frontend.attributes_filename or op.name }}DescriptorLowering, AutoAssignedUidsPreservedInRoundTrip)
{
    {{ op.frontend.attributes_class }} attrs;
    attrs.set_name("test_auto_uid");
{% if op.mode_fields %}
{% set mf = op.mode_fields[0] %}
{% set value = mf.effective_frontend_type ~ '::' ~ baseline_mode_name(op, mf) %}
    {{ assign_frontend_data_field("attrs", mf, value) }}
{% endif %}
{% for df in op.data_fields if df.is_vector and df.required %}
{% if df.name in op.test_data.field_values %}
{% set const_name = vector_const_name(df, op) %}
    {{ assign_frontend_data_field("attrs", df, "toVec(" ~ const_name ~ ")") }}
{% endif %}
{% endfor %}
{% for df in op.data_fields if df.is_scalar %}
{% set value = baseline_scalar_value(op, df) %}
    {{ assign_frontend_data_field("attrs", df, value) }}
{% endfor %}

    auto graphT = buildAndDeserialize(
        attrs
{% for param in op.frontend.graph_method_params if param.optional %}
        , false
{% endfor %}
        , false);

    ASSERT_EQ(graphT.tensors.size(), {{ op.required_tensor_fields | length }}u);
    std::unordered_set<int64_t> uids;
    for(const auto& tensor : graphT.tensors)
    {
        uids.insert(tensor->uid);
    }
    ASSERT_EQ(uids.size(), {{ op.required_tensor_fields | length }}u);

    ASSERT_EQ(graphT.nodes.size(), 1u);
    const auto* opNode = graphT.nodes[0]->attributes.As{{ op.fbs_table }}();
    ASSERT_NE(opNode, nullptr);
{% for tf in op.required_tensor_fields %}
    EXPECT_TRUE(uids.count(opNode->{{ tf.uid_field }}) > 0);
{% endfor %}
}
{% endif %}

