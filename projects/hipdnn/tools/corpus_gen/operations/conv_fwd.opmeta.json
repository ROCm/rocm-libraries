{
  "schema_version": "1.0",
  "operation": "conv_fwd",
  "display_name": "Convolution Forward",
  "description": "Forward convolution, NCHW input and KCRS filter, 2-D spatial.",
  "parameters": {
    "N": {
      "type": "int64",
      "description": "Batch"
    },
    "C": {
      "type": "int64",
      "description": "Input channels"
    },
    "K": {
      "type": "int64",
      "description": "Output channels"
    },
    "groups": {
      "type": "int64",
      "range": [
        1,
        null
      ],
      "description": "Convolution groups. Not a schema field: the frontend derives it as xDims[1] / wDims[1], so it is said by giving the filter C/groups input channels. groups == C is a depthwise convolution."
    },
    "H": {
      "type": "int64",
      "description": "Input height"
    },
    "W": {
      "type": "int64",
      "description": "Input width"
    },
    "R": {
      "type": "int64",
      "description": "Filter height"
    },
    "S": {
      "type": "int64",
      "description": "Filter width"
    },
    "pad_h": {
      "type": "int64",
      "range": [
        0,
        null
      ],
      "description": "Padding; 0 is unpadded"
    },
    "pad_w": {
      "type": "int64",
      "range": [
        0,
        null
      ],
      "description": "Padding; 0 is unpadded"
    },
    "stride_h": {
      "type": "int64"
    },
    "stride_w": {
      "type": "int64"
    },
    "dilation_h": {
      "type": "int64"
    },
    "dilation_w": {
      "type": "int64"
    },
    "dtype": {
      "type": "enum",
      "values": [
        "float32",
        "float16",
        "bfloat16",
        "fp8_e4m3",
        "fp8_e5m2",
        "fp8_e4m3_fnuz",
        "fp8_e5m2_fnuz",
        "int8"
      ],
      "description": "Element type of x, w and y. The list is the subset of the backend's eighteen convertible types that a convolution is actually run in: the float types, the fp8 pairs including the FNUZ spellings AMD hardware uses, and int8 for quantized inference. Types reached only through block scaling (fp4, fp6, int4) are declared on the quantize operations that produce them, not here."
    }
  },
  "stratification_axis": "arithmetic_intensity",
  "regimes": {
    "batch": {
      "parameter": "N",
      "buckets": [
        1,
        4,
        16,
        64,
        256
      ]
    },
    "channels": {
      "parameter": "C",
      "buckets": [
        3,
        64,
        256,
        512,
        1024
      ]
    },
    "out_channels": {
      "parameter": "K",
      "buckets": [
        1,
        64,
        256,
        512,
        1024
      ]
    },
    "spatial_h": {
      "parameter": "H",
      "buckets": [
        7,
        14,
        28,
        56,
        112,
        224
      ]
    },
    "spatial_w": {
      "parameter": "W",
      "buckets": [
        7,
        14,
        28,
        56,
        112,
        224
      ]
    },
    "filter_h": {
      "parameter": "R",
      "buckets": [
        1,
        3,
        5,
        7
      ]
    },
    "filter_w": {
      "parameter": "S",
      "buckets": [
        1,
        3,
        5,
        7
      ]
    },
    "stride": {
      "parameter": "stride_h",
      "buckets": [
        1,
        2
      ]
    },
    "dilation": {
      "parameter": "dilation_h",
      "buckets": [
        1,
        2
      ]
    }
  },
  "graph_builder": {
    "function": "convolutionForward",
    "source": "hipdnn_corpus_gen/GraphBuilders.hpp",
    "arguments": [
      {
        "name": "xDims",
        "kind": "expr",
        "value": [
          "$q.N",
          "$q.C",
          "$q.H",
          "$q.W"
        ]
      },
      {
        "name": "xStrides",
        "kind": "strides_of",
        "of": "xDims"
      },
      {
        "name": "wDims",
        "kind": "expr",
        "value": [
          "$q.K",
          {
            "/": [
              "$q.C",
              "$q.groups"
            ]
          },
          "$q.R",
          "$q.S"
        ]
      },
      {
        "name": "wStrides",
        "kind": "strides_of",
        "of": "wDims"
      },
      {
        "name": "yDims",
        "kind": "expr",
        "value": [
          "$q.N",
          "$q.K",
          {
            "+": [
              {
                "/": [
                  {
                    "-": [
                      {
                        "-": [
                          {
                            "+": [
                              "$q.H",
                              {
                                "*": [
                                  2,
                                  "$q.pad_h"
                                ]
                              }
                            ]
                          },
                          {
                            "*": [
                              "$q.dilation_h",
                              {
                                "-": [
                                  "$q.R",
                                  1
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      1
                    ]
                  },
                  "$q.stride_h"
                ]
              },
              1
            ]
          },
          {
            "+": [
              {
                "/": [
                  {
                    "-": [
                      {
                        "-": [
                          {
                            "+": [
                              "$q.W",
                              {
                                "*": [
                                  2,
                                  "$q.pad_w"
                                ]
                              }
                            ]
                          },
                          {
                            "*": [
                              "$q.dilation_w",
                              {
                                "-": [
                                  "$q.S",
                                  1
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      1
                    ]
                  },
                  "$q.stride_w"
                ]
              },
              1
            ]
          }
        ]
      },
      {
        "name": "yStrides",
        "kind": "strides_of",
        "of": "yDims"
      },
      {
        "name": "prePadding",
        "kind": "expr",
        "value": [
          "$q.pad_h",
          "$q.pad_w"
        ]
      },
      {
        "name": "postPadding",
        "kind": "expr",
        "value": [
          "$q.pad_h",
          "$q.pad_w"
        ]
      },
      {
        "name": "convStrides",
        "kind": "expr",
        "value": [
          "$q.stride_h",
          "$q.stride_w"
        ]
      },
      {
        "name": "convDilation",
        "kind": "expr",
        "value": [
          "$q.dilation_h",
          "$q.dilation_w"
        ]
      },
      {
        "name": "dataType",
        "kind": "dtype_of",
        "source": "$q.dtype"
      },
      {
        "name": "computeDataType",
        "kind": "constant",
        "constant": "float"
      },
      {
        "name": "intermediateDataType",
        "kind": "constant",
        "constant": "float"
      }
    ],
    "// types": "Operands carry the declared dtype; accumulation is fp32 regardless. That is what mixed precision means -- fp16 or bf16 storage with fp32 accumulate -- and it is also a hard gate: MIOpen's convolution builder declines any node whose compute_data_type is not FLOAT, so a uniform-fp16 graph is refused before applicability is even considered."
  },
  "constraints": [
    {
      "<=": [
        {
          "+": [
            {
              "*": [
                "$q.dilation_h",
                {
                  "-": [
                    "$q.R",
                    1
                  ]
                }
              ]
            },
            1
          ]
        },
        {
          "+": [
            "$q.H",
            {
              "*": [
                2,
                "$q.pad_h"
              ]
            }
          ]
        }
      ]
    },
    {
      "<=": [
        {
          "+": [
            {
              "*": [
                "$q.dilation_w",
                {
                  "-": [
                    "$q.S",
                    1
                  ]
                }
              ]
            },
            1
          ]
        },
        {
          "+": [
            "$q.W",
            {
              "*": [
                2,
                "$q.pad_w"
              ]
            }
          ]
        }
      ]
    },
    {
      "==": [
        {
          "%": [
            "$q.C",
            "$q.groups"
          ]
        },
        0
      ]
    },
    {
      "==": [
        {
          "%": [
            "$q.K",
            "$q.groups"
          ]
        },
        0
      ]
    },
    {
      "<=": [
        "$q.groups",
        "$q.C"
      ]
    }
  ],
