      "type": "int64"
    },
    "heads": {
      "type": "int64"
    },
    "seqlen_q": {
      "type": "int64"
    },
    "seqlen_k": {
      "type": "int64"
    },
    "head_dim": {
      "type": "int64"
    },
    "is_causal": {
      "type": "bool",
      "description": "Decode is always causal (RFC 0019.13 \u00a712.3)"
    },
    "dtype": {
      "type": "enum",
      "values": [
        "fp16",
        "bf16"
      ]
    }
  },
  "stratification_axis": "arithmetic_intensity",
  "regimes": {
    "batch": {
      "parameter": "batch",
      "buckets": [
        1,
        4,
        16,
        64,
        256
