    },
    "heads": {
      "parameter": "heads",
      "buckets": [
        1,
        8,
        16,
        32,
        96
      ]
    },
    "seqlen_q": {
      "parameter": "seqlen_q",
      "buckets": [
        1,
        128,
        512,
        2048,
        8192
      ]
    },
    "seqlen_k": {
      "parameter": "seqlen_k",
      "buckets": [
        128,
        512,
        2048,
        8192,
        32768
      ]
    },
    "head_dim": {
      "parameter": "head_dim",
      "buckets": [
        64,
        128,
        256
      ]
    }
  },
  "constraints": [
    {
      "<=": [
        "$q.seqlen_q",
        "$q.seqlen_k"
      ]
    }
  ],
  "graph_builder": {
    "function": "sdpaForward",
    "source": "hipdnn_corpus_gen/GraphBuilders.hpp",
    "arguments": [
      {
        "name": "qDims",
        "kind": "expr",
        "value": [
          "$q.batch",
          "$q.heads",
          "$q.seqlen_q",
          "$q.head_dim"
        ]
      },
      {
        "name": "qStrides",
        "kind": "strides_of",
        "of": "qDims"
      },
      {
        "name": "kDims",
        "kind": "expr",
        "value": [
          "$q.batch",
          "$q.heads",
          "$q.seqlen_k",
          "$q.head_dim"
        ]
      },
      {
        "name": "kStrides",
        "kind": "strides_of",
        "of": "kDims"
      },
      {
        "name": "vDims",
        "kind": "expr",
        "value": [
          "$q.batch",
          "$q.heads",
          "$q.seqlen_k",
          "$q.head_dim"
        ]
      },
      {
        "name": "vStrides",
        "kind": "strides_of",
        "of": "vDims"
      },
      {
        "name": "oDims",
        "kind": "expr",
        "value": [
          "$q.batch",
          "$q.heads",
          "$q.seqlen_q",
          "$q.head_dim"
        ]
      },
      {
        "name": "oStrides",
        "kind": "strides_of",
        "of": "oDims"
      },
      {
        "name": "dataType",
        "kind": "dtype_of",
        "source": "$q.dtype"
      },
      {
        "name": "causalMask",
        "kind": "direct",
        "source": "$q.is_causal"
      }
    ]
  },
