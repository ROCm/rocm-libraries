{
  "schema_version": "1.0",
  "operation": "mx_matmul",
  "display_name": "Block-Scaled (MX) Matmul",
  "description": "C[M, N] = dequantize(A[M, K]) x dequantize(B[K, N]), with A and B in an OCP MX element format and one E8M0 scale per 32 elements along K. The operand layouts are axes: which orientations an engine takes is its answer.",
  "parameters": {
    "M": {
      "type": "int64"
    },
    "N": {
      "type": "int64"
    },
    "K": {
      "type": "int64"
    },
    "dtype": {
      "type": "enum",
      "values": [
        "fp8_e4m3",
        "fp8_e5m2",
        "fp6_e2m3",
        "fp6_e3m2",
        "fp4_e2m1"
      ],
      "description": "The MX element format of A and B."
    },
    "out_dtype": {
      "type": "enum",
      "values": [
        "fp32",
        "fp16",
        "bf16"
      ]
    },
    "a_layout": {
      "type": "enum",
      "values": [
        "row",
        "col"
      ],
      "description": "Memory order of A and its scale."
    },
    "b_layout": {
      "type": "enum",
      "values": [
        "row",
        "col"
      ],
      "description": "Memory order of B and its scale."
    }
  },
  "constraints": [
    {
      "divisible": [
        "$q.K",
        32
      ]
    }
  ],
  "// constraints": "The MX formats scale blocks of 32 elements along K, so K is a multiple of 32 by definition.",
  "stratification_axis": "working_set",
  "regimes": {
    "m": {
      "parameter": "M",
      "buckets": [
        16,
        256,
        2048,
        8192
      ]
    },
    "n": {
      "parameter": "N",
      "buckets": [
        256,
        2048,
        8192,
        16384
      ]
    },
    "k": {
      "parameter": "K",
      "buckets": [
        256,
        2048,
        8192,
        16384
      ]
    }
  },
  "graph_builder": {
    "function": "blockScaledMatmul",
    "source": "hipdnn_corpus_gen/GraphBuilders.hpp",
    "arguments": [
      {
        "name": "aDims",
        "kind": "expr",
        "value": [
          "$q.M",
          "$q.K"
        ]
      },
      {
        "name": "aStrides",
        "kind": "expr",
        "value": [
          {
            "if": [
              {
                "==": [
