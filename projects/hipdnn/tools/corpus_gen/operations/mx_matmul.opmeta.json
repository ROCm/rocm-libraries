                  "col"
                ]
              },
              1,
              "$q.K"
            ]
          },
          {
            "if": [
              {
                "==": [
                  "$q.a_layout",
                  "col"
                ]
              },
              "$q.M",
              1
            ]
          }
        ]
      },
      {
        "name": "aScaleDims",
        "kind": "expr",
        "value": [
          "$q.M",
          {
            "/": [
              "$q.K",
              32
            ]
          }
        ]
      },
      {
        "name": "aScaleStrides",
        "kind": "expr",
        "value": [
          {
            "if": [
              {
                "==": [
                  "$q.a_layout",
                  "col"
                ]
              },
              1,
              {
                "/": [
                  "$q.K",
                  32
                ]
              }
            ]
          },
          {
            "if": [
              {
                "==": [
                  "$q.a_layout",
                  "col"
                ]
              },
              "$q.M",
              1
            ]
          }
        ]
      },
      {
        "name": "bDims",
        "kind": "expr",
        "value": [
          "$q.K",
          "$q.N"
        ]
      },
      {
        "name": "bStrides",
        "kind": "expr",
        "value": [
          {
            "if": [
              {
                "==": [
                  "$q.b_layout",
                  "col"
                ]
              },
              1,
              "$q.N"
            ]
          },
          {
            "if": [
              {
                "==": [
                  "$q.b_layout",
                  "col"
                ]
              },
              "$q.K",
              1
            ]
          }
        ]
      },
      {
        "name": "bScaleDims",
        "kind": "expr",
        "value": [
          {
            "/": [
              "$q.K",
              32
            ]
          },
