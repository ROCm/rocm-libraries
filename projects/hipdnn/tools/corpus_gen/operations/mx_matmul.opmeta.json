      },
      {
        "name": "computeDataType",
        "kind": "constant",
        "constant": "float"
      },
      {
        "name": "intermediateDataType",
        "kind": "constant",
        "constant": "float"
      }
    ],
    "// types": "A and B carry the MX format, the scales E8M0, C the output dtype; dequantized operands and the matmul are fp32."
  },
