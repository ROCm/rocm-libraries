            ]
          },
          {
            "if": [
              {
                "==": [
                  "$q.b_layout",
                  "col"
                ]
              },
              {
                "/": [
                  "$q.K",
                  32
                ]
              },
              1
            ]
          }
        ]
      },
      {
        "name": "cDims",
        "kind": "expr",
        "value": [
          "$q.M",
          "$q.N"
        ]
      },
      {
        "name": "cStrides",
        "kind": "expr",
        "value": [
          "$q.N",
          1
        ]
      },
      {
        "name": "dataType",
        "kind": "dtype_of",
        "source": "$q.dtype"
      },
