{
  "schema_version": "1.0",
  "operation": "mx_matmul",
  "display_name": "Block-Scaled (MX) Matmul",
  "description": "C[M, N] = dequantize(A[M, K]) x dequantize(B[K, N]), with A and B in an OCP MX element format and one E8M0 scale per 32 elements along K. The operand layouts are axes: which orientations an engine takes is its answer.",
  "parameters": {
    "M": {
      "type": "int64"
    },
    "N": {
      "type": "int64"
    },
    "K": {
      "type": "int64"
    },
    "dtype": {
      "type": "enum",
      "values": [
        "fp8_e4m3",
        "fp8_e5m2",
        "fp6_e2m3",
        "fp6_e3m2",
        "fp4_e2m1"
      ],
      "description": "The MX element format of A and B."
    },
    "out_dtype": {
      "type": "enum",
      "values": [
        "fp32",
        "fp16",
        "bf16"
      ]
    },
    "a_layout": {
      "type": "enum",
      "values": [
        "row",
        "col"
      ],
      "description": "Memory order of A and its scale."
    },
    "b_layout": {
      "type": "enum",
      "values": [
        "row",
        "col"
      ],
      "description": "Memory order of B and its scale."
    }
  },
  "constraints": [
    {
      "divisible": [
        "$q.K",
        32
      ]
    }
  ],
  "// constraints": "The MX formats scale blocks of 32 elements along K, so K is a multiple of 32 by definition.",
  "stratification_axis": "working_set",
  "regimes": {
    "m": {
      "parameter": "M",
      "buckets": [
        16,
        256,
        2048,
        8192
      ]
    },
    "n": {
      "parameter": "N",
      "buckets": [
        256,
        2048,
        8192,
        16384
      ]
    },
    "k": {
      "parameter": "K",
      "buckets": [
        256,
        2048,
        8192,
        16384
      ]
    }
  },
  "// regime_label": "The population a problem is reported, held out and grown under. skinny: M or N of 16 or less, a decode step's or a small batch's GEMV-like product, bound by reading the weights. deep_k: K four times the larger of M and N or more, a weight gradient's reduction over tokens, where split-K and stream-K kernels win. regular: the rest, the prefill and training projections.",
  "regime_label": [
    {
      "name": "shape",
      "labels": [
        {
          "label": "skinny",
          "when": {
            "or": [
              {
                "<=": [
                  "$q.M",
                  16
                ]
              },
              {
                "<=": [
                  "$q.N",
                  16
                ]
              }
            ]
          }
        },
        {
          "label": "deep_k",
          "when": {
            ">=": [
              "$q.K",
              {
                "*": [
                  4,
                  {
                    "max": [
                      "$q.M",
                      "$q.N"
                    ]
                  }
                ]
              }
            ]
          }
        }
      ],
      "otherwise": "regular"
    }
  ],
  "graph_builder": {
    "function": "blockScaledMatmul",
    "source": "hipdnn_corpus_gen/GraphBuilders.hpp",
    "arguments": [
      {
        "name": "aDims",
        "kind": "expr",
        "value": [
          "$q.M",
          "$q.K"
        ]
      },
      {
        "name": "aStrides",
        "kind": "expr",
        "value": [
          {
            "if": [
              {
                "==": [
                  "$q.a_layout",
                  "col"
                ]
              },
              1,
              "$q.K"
            ]
          },
          {
            "if": [
              {
                "==": [
                  "$q.a_layout",
                  "col"
                ]
              },
              "$q.M",
              1
            ]
          }
        ]
      },
      {
        "name": "aScaleDims",
        "kind": "expr",
        "value": [
          "$q.M",
          {
            "/": [
              "$q.K",
              32
            ]
          }
        ]
      },
      {
        "name": "aScaleStrides",
        "kind": "expr",
        "value": [
          {
            "if": [
              {
                "==": [
                  "$q.a_layout",
                  "col"
                ]
              },
              1,
              {
                "/": [
                  "$q.K",
                  32
                ]
              }
            ]
          },
          {
            "if": [
              {
                "==": [
                  "$q.a_layout",
                  "col"
                ]
              },
              "$q.M",
              1
            ]
          }
        ]
      },
      {
        "name": "bDims",
        "kind": "expr",
        "value": [
          "$q.K",
          "$q.N"
        ]
      },
      {
        "name": "bStrides",
        "kind": "expr",
        "value": [
          {
            "if": [
              {
                "==": [
                  "$q.b_layout",
                  "col"
                ]
              },
              1,
              "$q.N"
            ]
          },
          {
            "if": [
              {
                "==": [
                  "$q.b_layout",
                  "col"
                ]
              },
              "$q.K",
              1
            ]
          }
        ]
      },
      {
        "name": "bScaleDims",
        "kind": "expr",
        "value": [
          {
            "/": [
              "$q.K",
              32
            ]
          },
          "$q.N"
        ]
      },
      {
        "name": "bScaleStrides",
        "kind": "expr",
        "value": [
          {
            "if": [
              {
                "==": [
                  "$q.b_layout",
                  "col"
                ]
              },
              1,
              "$q.N"
            ]
          },
          {
            "if": [
              {
                "==": [
                  "$q.b_layout",
                  "col"
                ]
              },
              {
                "/": [
                  "$q.K",
                  32
                ]
              },
              1
            ]
          }
        ]
      },
      {
        "name": "cDims",
        "kind": "expr",
        "value": [
          "$q.M",
          "$q.N"
        ]
      },
      {
        "name": "cStrides",
        "kind": "expr",
        "value": [
          "$q.N",
          1
        ]
      },
      {
        "name": "dataType",
        "kind": "dtype_of",
        "source": "$q.dtype"
      },
      {
        "name": "scaleDataType",
        "kind": "constant",
        "constant": "fp8_e8m0"
      },
      {
        "name": "outputDataType",
        "kind": "dtype_of",
        "source": "$q.out_dtype"
      },
      {
        "name": "blockSize",
        "kind": "constant",
        "constant": 32
      },
      {
        "name": "computeDataType",
        "kind": "constant",
        "constant": "float"
      },
      {
        "name": "intermediateDataType",
        "kind": "constant",
        "constant": "float"
      }
    ],
    "// types": "A and B carry the MX format, the scales E8M0, C the output dtype; dequantized operands and the matmul are fp32."
  },
  "archetypes": [
    {
      "name": "llm_projection",
      "note": "a transformer projection: tokens by model width by hidden width",
      "values": {
