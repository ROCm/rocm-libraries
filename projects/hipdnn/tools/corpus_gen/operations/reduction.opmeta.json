{
  "schema_version": "1.0",
  "operation": "reduction",
  "display_name": "Reduction",
  "description": "Reduces the trailing axis. The output shape is the statement of which axes reduce, so it is declared rather than inferred.",
  "parameters": {
    "rows": {
      "type": "int64"
    },
    "cols": {
      "type": "int64"
    },
    "mode": {
      "type": "enum",
      "values": [
        "ADD",
        "MUL",
        "MIN_OP",
        "MAX_OP",
        "AMAX",
        "AVG",
        "NORM1",
        "NORM2"
      ],
      "description": "FlatBuffers enumerator names; MIN and MAX are reserved words in the schema"
    },
    "dtype": {
      "type": "enum",
      "values": [
        "fp32",
        "fp16"
      ]
    }
  },
  "stratification_axis": "reduction_ratio",
  "regimes": {
    "rows": {
      "parameter": "rows",
      "buckets": [
        1,
        16,
        256,
        4096,
        16384
      ]
    },
    "cols": {
      "parameter": "cols",
      "buckets": [
        8,
        128,
        1024,
        8192
      ]
    }
  },
  "graph_builder": {
    "function": "reduction",
    "source": "hipdnn_corpus_gen/GraphBuilders.hpp",
    "arguments": [
      {
        "name": "inDims",
        "kind": "expr",
        "value": [
          "$q.rows",
          "$q.cols"
        ]
      },
      {
        "name": "inStrides",
        "kind": "strides_of",
        "of": "inDims"
      },
      {
        "name": "outDims",
        "kind": "expr",
        "value": [
          1,
          "$q.cols"
        ]
      },
      {
        "name": "outStrides",
        "kind": "strides_of",
        "of": "outDims"
      },
      {
        "name": "mode",
        "kind": "direct",
        "source": "$q.mode"
      },
      {
        "name": "dataType",
        "kind": "dtype_of",
        "source": "$q.dtype"
      }
    ]
  },
  "constraints": [
    {
      ">": [
        "$q.rows",
        1
      ]
    }
  ],
  "archetypes": [
    {
      "name": "softmax_rows",
      "note": "the row-wise reduction inside attention; cols is the sequence length",
      "values": {
        "rows": [
          1,
          8,
          32,
          128,
          512,
          2048,
          8192
        ],
        "cols": [
          128,
          512,
          2048,
          8192,
          32768
        ]
      }
    },
    {
      "name": "logits_vocab",
      "note": "reduction over the vocabulary, which is where the cols are enormous",
      "values": {
        "rows": [
          1,
          8,
          32,
          128
        ],
        "cols": [
          32000,
          50257,
          128256
        ]
      }
    },
    {
      "name": "channel_stats",
      "note": "per-channel statistics, as normalization and pooling produce",
      "values": {
        "rows": [
          1,
          8,
          32,
          128,
          256
        ],
        "cols": [
          64,
          128,
          256,
          512,
          1024,
          2048
        ]
      }
    },
    {
      "name": "loss_scalar",
      "note": "a whole tensor to one number; the fully memory-bound case",
      "values": {
        "rows": [
          1
        ],
        "cols": [
          1024,
          4096,
          16384,
          65536,
          262144
        ]
      }
    },
    {
      "name": "gradient_accumulate",
      "values": {
        "rows": [
          128,
          512,
          2048
        ],
        "cols": [
          768,
          1024,
          4096,
          8192
        ]
      }
    }
  ],
  "neighbourhood": {
    "rows": {
      "kind": "scale",
      "factors": [
        0.5,
        1,
        2
      ]
    },
    "cols": {
      "kind": "scale",
      "factors": [
        0.5,
        0.75,
        1,
        1.5,
        2
      ]
    }
  },
  "mixture": {
    "archetypes": 0.2,
    "neighbourhood": 0.6,
    "exploration": 0.2
  },
  "// archetypes": "A reduction's cost is set by how much it reads and how far it must reduce, so the meaningful axis is the aspect ratio: a short-wide softmax row, a vocabulary-sized logit reduction, and a whole-tensor reduction to one scalar are different kernels.",
  "// elements": "The full input, and one output per row. Element count across every tensor the operation touches, inputs and outputs. Dtype-free on purpose: bytes is elements times the dtype width, and the width table belongs to the tool rather than repeated as a nested dtype lookup in seven declarations. gbs = bytes / measured time, which is the metric that ranks a memory-bound kernel where tflops cannot.",
  "elements": {
    "+": [
      {
        "*": [
          "$q.rows",
          "$q.cols"
        ]
      },
      "$q.rows"
    ]
  }
}
