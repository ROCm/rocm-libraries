{
  "schema_version": "1.0",
  "operation": "layernorm_bwd",
  "display_name": "Layer Normalization, Backward",
  "description": "Gradients of layer normalization over the trailing hidden dimension: dx from dy and the forward pass's saved mean and inverse variance, and dscale and dbias.",
  "parameters": {
    "batch": {
      "type": "int64"
    },
    "seq_len": {
      "type": "int64"
    },
    "hidden_dim": {
      "type": "int64",
      "range": [
        32,
        65536
      ],
      "description": "The normalised width. 32 and up: a narrower row is no model's (a per-head QK-norm is 64 at the least), and unbounded the search spent a third of its draws on widths below 16."
    },
    "dtype": {
      "type": "enum",
      "values": [
        "fp32",
        "fp16",
        "bf16"
      ]
    },
    "rank": {
      "type": "enum",
      "values": [
        "3",
        "4",
        "5"
      ],
      "description": "How many dimensions x is spelled with: [batch, seq_len, hidden_dim] padded with trailing unit dimensions. The same problem either way; engines whose kernels take only 4-D or 5-D tensors (HIP_MLOPS) serve only the padded spellings."
    }
  },
  "stratification_axis": "working_set",
  "regimes": {
    "hidden_dim": {
      "parameter": "hidden_dim",
      "buckets": [
        768,
        1024,
        1536,
        4096,
        5120,
        8192
      ]
    },
    "batch": {
      "parameter": "batch",
      "buckets": [
        1,
        4,
        16,
        32,
        64,
        128
      ]
    },
    "seq_len": {
      "parameter": "seq_len",
      "buckets": [
        128,
        512,
        2048,
        8192
      ]
    }
  },
  "// regime_label": "The population a problem is reported, held out and grown under. rows: few (64 or fewer normalised rows, a decode step's) or many. width: narrow (512 or less: a per-head QK-norm or an MLA latent's norm), wide (8192 and up: the 70B-class hidden sizes, a row past one workgroup's registers), mid. A kernel's shape choice turns on the row width and its grid on the row count, so these are the axes its accuracy is read on.",
  "regime_label": [
    {
      "name": "rows",
      "labels": [
        {
          "label": "few",
          "when": {
            "<=": [
              {
                "*": [
                  "$q.batch",
                  "$q.seq_len"
                ]
              },
              64
            ]
          }
        }
      ],
      "otherwise": "many"
    },
    {
      "name": "width",
      "labels": [
        {
          "label": "narrow",
          "when": {
            "<=": [
              "$q.hidden_dim",
              512
            ]
          }
        },
        {
          "label": "wide",
          "when": {
            ">=": [
              "$q.hidden_dim",
              8192
            ]
          }
        }
      ],
      "otherwise": "mid"
    }
  ],
  "graph_builder": {
    "function": "layernormBackward",
    "source": "hipdnn_corpus_gen/GraphBuilders.hpp",
    "arguments": [
      {
        "name": "dyDims",
        "kind": "expr",
        "value": [
          "$q.batch",
          "$q.seq_len",
          "$q.hidden_dim"
        ]
      },
      {
        "name": "dyStrides",
        "kind": "strides_of",
        "of": "dyDims"
      },
      {
        "name": "xDims",
        "kind": "expr",
        "value": [
          "$q.batch",
          "$q.seq_len",
          "$q.hidden_dim"
        ]
      },
      {
        "name": "xStrides",
        "kind": "strides_of",
        "of": "xDims"
      },
      {
        "name": "scaleDims",
        "kind": "expr",
        "value": [
          1,
          1,
          "$q.hidden_dim"
        ]
      },
      {
        "name": "scaleStrides",
        "kind": "strides_of",
        "of": "scaleDims"
      },
      {
        "name": "dxDims",
        "kind": "expr",
        "value": [
          "$q.batch",
          "$q.seq_len",
          "$q.hidden_dim"
        ]
      },
      {
        "name": "dxStrides",
        "kind": "strides_of",
        "of": "dxDims"
      },
      {
        "name": "dscaleDims",
        "kind": "expr",
        "value": [
          1,
          1,
          "$q.hidden_dim"
        ]
      },
      {
        "name": "dscaleStrides",
        "kind": "strides_of",
        "of": "dscaleDims"
      },
      {
        "name": "dbiasDims",
        "kind": "expr",
        "value": [
          1,
          1,
          "$q.hidden_dim"
        ]
      },
      {
        "name": "dbiasStrides",
        "kind": "strides_of",
        "of": "dbiasDims"
      },
      {
        "name": "meanDims",
        "kind": "expr",
        "value": [
          "$q.batch",
          "$q.seq_len",
          1
        ]
      },
      {
        "name": "meanStrides",
        "kind": "strides_of",
        "of": "meanDims"
      },
      {
        "name": "invVarianceDims",
        "kind": "expr",
        "value": [
          "$q.batch",
          "$q.seq_len",
          1
        ]
      },
      {
        "name": "invVarianceStrides",
        "kind": "strides_of",
        "of": "invVarianceDims"
      },
      {
        "name": "dataType",
        "kind": "dtype_of",
        "source": "$q.dtype"
      },
      {
        "name": "computeDataType",
        "kind": "constant",
        "constant": "float"
      },
      {
        "name": "intermediateDataType",
        "kind": "constant",
        "constant": "float"
      },
      {
        "name": "rank",
        "kind": "direct",
        "source": "$q.rank"
      },
      {
        "name": "normalizedDimCount",
        "kind": "constant",
        "constant": 1
      },
      {
        "name": "meanDataType",
        "kind": "constant",
        "constant": "float"
      },
      {
        "name": "invVarianceDataType",
        "kind": "constant",
        "constant": "float"
      }
    ],
    "// types": "Operands carry the declared dtype; statistics accumulate in fp32. Left to default, compute follows io, and hip-kernel-provider's Layernorm plan builder refuses any node whose compute_data_type is not fp32."
  },
  "archetypes": [
