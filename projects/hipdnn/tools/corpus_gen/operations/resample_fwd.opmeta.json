        0,
        3
      ]
    },
    "pad_w": {
      "type": "int64",
      "range": [
        0,
        3
      ]
    },
    "pad_d": {
      "type": "int64",
      "range": [
        0,
        3
      ]
    },
    "spatial": {
      "type": "enum",
      "values": [
        "3d",
        "2d"
      ],
      "description": "2-D ([N, C, H, W]) or 3-D ([N, C, D, H, W]) pooling."
    },
    "mode": {
      "type": "enum",
      "values": [
        "MAXPOOL",
        "AVGPOOL_EXCLUDE_PADDING",
        "AVGPOOL_INCLUDE_PADDING"
      ],
      "description": "FlatBuffers ResampleMode enumerator names."
    },
    "padding": {
      "type": "enum",
      "values": [
        "NEG_INF_PAD",
        "ZERO_PAD"
      ],
      "description": "FlatBuffers PaddingMode enumerator names; tied to the mode by a constraint."
    },
    "index": {
      "type": "enum",
      "values": [
        "yes",
        "no"
      ],
      "description": "Whether max pooling's int32 index tensor (the position of each window's maximum) is part of the graph."
    },
    "layout": {
      "type": "enum",
      "values": [
        "channels_first",
        "channels_last"
      ],
      "description": "NCHW/NCDHW or NHWC/NDHWC memory order."
    },
    "dtype": {
      "type": "enum",
      "values": [
        "fp32",
        "fp16",
        "bf16"
      ]
    }
  },
  "stratification_axis": "working_set",
  "regimes": {
    "n": {
      "parameter": "N",
      "buckets": [
        1,
        8,
        32,
        128
      ]
    },
    "c": {
      "parameter": "C",
      "buckets": [
        16,
        64,
        256,
        1024
      ]
    },
    "h": {
      "parameter": "H",
      "buckets": [
        7,
        14,
        56,
        224
