  "operation": "resample_fwd",
  "display_name": "Pooling, Forward",
  "description": "Max or average pooling of an [N, C, (D,) H, W] activation; max pooling may also write the index of each window's maximum.",
  "parameters": {
    "N": {
      "type": "int64"
    },
    "C": {
      "type": "int64"
    },
    "H": {
      "type": "int64"
    },
    "W": {
      "type": "int64"
    },
    "D": {
      "type": "int64",
      "description": "Depth; 1 and absent for 2-D."
    },
    "R": {
      "type": "int64",
      "range": [
        1,
        8
      ]
    },
    "S": {
      "type": "int64",
      "range": [
        1,
        8
      ]
    },
    "Rd": {
      "type": "int64",
      "range": [
        1,
        8
      ],
      "description": "Window depth; 1 for 2-D."
    },
    "stride_h": {
      "type": "int64",
      "range": [
        1,
        4
      ]
    },
    "stride_w": {
      "type": "int64",
      "range": [
        1,
        4
      ]
    },
    "stride_d": {
      "type": "int64",
      "range": [
        1,
        4
      ]
    },
    "pad_h": {
