set -eu
prefix=$(CDPATH= cd -- "$(dirname -- "$0")/@_studio_bin_to_prefix@" && pwd)
export ELECTRON_RUN_AS_NODE=1
exec "$prefix/@_studio_electron_dir@/electron" \
    "$prefix/@_studio_appdir@/electron/launch.cjs" @_studio_launch_mode@ "$@"
