# Example site settings for the validation harness on a Slurm cluster.
# Copy it to site.env beside this file (git ignores that name) or anywhere
# else and point VALIDATION_CONFIG at the copy, then replace every <...> value.
# Sourced by submit.sh (submit host) and run_matrix.sbatch (compute node).
# Every path a job touches must be visible on compute nodes.

HV_ROOT=/path/to/hipdnn-vllm
# Shared venv with the BUILD_PINS.toml vLLM, torch and ROCm. Jobs never modify
# it: the plugin wheel goes into a throwaway overlay venv that sees this venv's
# site-packages.
HV_VENV=$HV_ROOT/venvs/<venv>
# Model weights: models.json paths are relative to HV_ROOT (hf/<name>, models/<name>).
HV_HF_HOME=$HV_ROOT/hf
# Plugin wheels: $HV_WHEEL_ROOT/<family>/hipdnn_vllm-*.whl (newest is used).
HV_WHEEL_ROOT=${HV_WHEEL_ROOT:-$HV_ROOT/wheels}
HV_LOG_DIR=$HV_ROOT/logs
HV_RESULTS=$HV_ROOT/results/validation
HV_SCRATCH=$HV_ROOT/scratch

HV_PARTITION=<partition>
HV_TIME=08:00:00
HV_CPUS=16
# Default host memory request; HV_MEM_<arch> overrides it per arch.
HV_MEM=128G
# Comma list of nodes to keep jobs off (empty for none).
HV_EXCLUDE=

# Per arch: the wheel family (a BUILD_PINS.toml [families] key), the Slurm GPU
# request (--gres), an optional host memory request (HV_MEM_<arch>, for nodes
# with less RAM than HV_MEM) and optional extra sbatch flags (HV_SBATCH_<arch>),
# which come after the defaults above and override them.
HV_FAMILY_gfx942=gfx94X
HV_GRES_gfx942=gpu:<gfx942 gres name>:1
HV_FAMILY_gfx950=gfx950
HV_GRES_gfx950=gpu:<gfx950 gres name>:1
HV_FAMILY_gfx1100=gfx110X-all
HV_GRES_gfx1100=gpu:<gfx1100 gres name>:1
HV_FAMILY_gfx1201=gfx120X-all
HV_GRES_gfx1201=gpu:<gfx1201 gres name>:1
HV_MEM_gfx1201=96G
HV_FAMILY_gfx1151=gfx1151
HV_GRES_gfx1151=gpu:<gfx1151 gres name>:1
# Example of per-arch overrides for nodes with fewer CPUs or less RAM.
HV_MEM_gfx1151=48G
HV_SBATCH_gfx1151="-c 8"
