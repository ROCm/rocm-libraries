# Config package for the hipBLAS Fortran bindings.
#
#   find_package(hipblas-fortran REQUIRED)
#   target_link_libraries(my_app PRIVATE roc::hipblas_fortran)
#
# The bindings ship as one static archive and one .mod set PER FORTRAN COMPILER,
# because a .mod is not portable across compilers or even across versions of the
# same compiler. This package therefore checks that the consumer is building with
# the compiler the bindings were installed for, and fails with a named diagnostic
# rather than letting the build hit an unreadable .mod much later.

@PACKAGE_INIT@

set(HIPBLAS_FORTRAN_COMPILER_DIR "@HIPBLAS_FORTRAN_COMPILER_DIR@")

# A consumer asks "is a hipBLAS Fortran binding available here?" through
# hipblas_FORTRAN_FOUND, which is set whether this package is reached directly by
# find_package(hipblas-fortran) or alongside hipblas-config.cmake, with which it
# is co-installed in lib/cmake/hipblas. It stays FALSE on every early return
# below.
set(hipblas_FORTRAN_FOUND FALSE)

if(NOT CMAKE_Fortran_COMPILER_LOADED)
  set(hipblas-fortran_FOUND FALSE)
  # One argument, not several. set() with multiple arguments builds a LIST, and
  # find_package renders a list with a semicolon at every element boundary, so a
  # message split across lines for readability comes out as
  # "... find_package: ;add Fortran to ...".
  string(CONCAT hipblas-fortran_NOT_FOUND_MESSAGE
      "The hipBLAS Fortran bindings need Fortran enabled before find_package: "
      "add Fortran to your project() languages, or call enable_language(Fortran).")
  return()
endif()

# This MUST mirror the mapping in projects/hipblas/fortran/CMakeLists.txt
# exactly: it recomputes, for the compiler the CONSUMER is using, the same
# directory name the bindings were installed under. The two cannot share code --
# this file runs in a consumer's build, long after ours is gone, so they are
# kept in step by hand. Get it wrong, compare against CMake's raw ID, against
# "${id}-${version}", or against the basename of an MPI wrapper, and the check
# can never match: the package then rejects every consumer with a message
# claiming a compiler mismatch that does not exist.
if(CMAKE_Fortran_COMPILER_ID STREQUAL "GNU")
  set(_hipblas_fc "gfortran")
elseif(CMAKE_Fortran_COMPILER_ID MATCHES "Flang")
  set(_hipblas_fc "amdflang")
elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Cray")
  set(_hipblas_fc "ftn")
elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "IntelLLVM")
  set(_hipblas_fc "ifx")
elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Intel")
  set(_hipblas_fc "ifort")
elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "NVHPC")
  set(_hipblas_fc "nvfortran")
else()
  get_filename_component(_hipblas_fc "${CMAKE_Fortran_COMPILER}" NAME_WE)
  string(TOLOWER "${_hipblas_fc}" _hipblas_fc)
endif()

# A site that installs several versions of one compiler side by side overrides
# HIPBLAS_FORTRAN_COMPILER_DIR with a suffixed name (gfortran-13.3.0), so the
# recorded directory is accepted when it is the derived name, or that name
# followed by a separator and anything. A strict equality would reject exactly
# the sites that used the documented override. Note what this cannot do: the
# layout records no version, so the package cannot tell gfortran 13 from
# gfortran 15 by itself.
#
# Done by length and substring rather than by regex. _hipblas_fc comes from
# CMAKE_Fortran_COMPILER's basename on the fallback branch above, so it is an
# arbitrary file name; interpolating it into a regex would let a compiler called
# g++.wrapper or flang(2) either mismatch silently or abort CMake with a regex
# error. There is no regex-escape in CMake, so the comparison avoids regex.
function(_hipblas_dir_matches DIR FC OUT)
  set(${OUT} FALSE PARENT_SCOPE)
  if(DIR STREQUAL FC)
    set(${OUT} TRUE PARENT_SCOPE)
    return()
  endif()
  string(LENGTH "${FC}" _n)
  string(LENGTH "${DIR}" _dn)
  if(_dn GREATER _n)
    string(SUBSTRING "${DIR}" 0 ${_n} _head)
    string(SUBSTRING "${DIR}" ${_n} 1 _sep)
    if(_head STREQUAL FC AND _sep MATCHES "^[-._]$")
      set(${OUT} TRUE PARENT_SCOPE)
    endif()
  endif()
endfunction()

# Which per-compiler directory to use.
#
# The recorded HIPBLAS_FORTRAN_COMPILER_DIR is the compiler the package was
# built with, and it is only a default. A prefix can hold artifacts for several
# compilers at once -- installing the bindings twice writes
# include/fortran/gfortran and include/fortran/amdflang side by side -- but the
# config package is written once, so the recorded value names whichever install
# ran last. Trusting it blindly rejects a consumer whose .mod is present.
#
# So prefer the consumer's OWN compiler when its artifacts are installed here,
# and fall back to the recorded directory when they are not.
set(_hipblas_dir "")
if(EXISTS "${PACKAGE_PREFIX_DIR}/include/fortran/${_hipblas_fc}/hipblas.mod")
  set(_hipblas_dir "${_hipblas_fc}")
else()
  _hipblas_dir_matches("${HIPBLAS_FORTRAN_COMPILER_DIR}" "${_hipblas_fc}" _hipblas_ok)
  if(_hipblas_ok)
    set(_hipblas_dir "${HIPBLAS_FORTRAN_COMPILER_DIR}")
  endif()
endif()

if(NOT _hipblas_dir)
  # Name what IS installed, so the reader can see whether they need to rebuild
  # or merely point at an existing directory.
  file(GLOB _hipblas_avail RELATIVE "${PACKAGE_PREFIX_DIR}/include/fortran"
       "${PACKAGE_PREFIX_DIR}/include/fortran/*")
  set(hipblas-fortran_FOUND FALSE)
  string(CONCAT hipblas-fortran_NOT_FOUND_MESSAGE
      "This project builds with ${_hipblas_fc}, but no hipblas.mod for it is "
      "installed under ${PACKAGE_PREFIX_DIR}/include/fortran. Available: "
      "${_hipblas_avail}. A Fortran .mod cannot be shared across compilers; "
      "rebuild the bindings with ${_hipblas_fc}, or set "
      "HIPBLAS_FORTRAN_COMPILER_DIR to the directory to use.")
  return()
endif()

# The C library the binding declares bind(C) interfaces into. It is a link-time
# dependency of the imported target, so it has to be imported first or the
# include() below would leave roc::hipblas_fortran pointing at an undefined
# roc::hipblas and the generate step would fail. Skipped when the caller already
# did find_package(hipblas), which is the common case.
#
# hipblas-config.cmake in turn does find_dependency(hip), and hip-config.cmake
# reaches FindThreads, which hard-errors unless C or CXX is enabled. A
# Fortran-only consumer has neither, so C is enabled here. Enabling a language
# from a config package is unusual, and it is done deliberately: the alternative
# is making every Fortran consumer of these bindings write enable_language(C)
# for a reason that has nothing to do with their code, after a
# "FindThreads only works if either C or CXX language is enabled" that names
# nothing they wrote.
if(NOT TARGET roc::hipblas)
  if(NOT CMAKE_C_COMPILER_LOADED AND NOT CMAKE_CXX_COMPILER_LOADED)
    enable_language(C)
  endif()
  include(CMakeFindDependencyMacro)
  find_dependency(hipblas)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/hipblas-fortran-targets.cmake")

# The targets file hardcodes the directory the package was BUILT with. When the
# consumer's compiler resolved to a different one above, repoint the imported
# target at it, otherwise the .mod found and the archive linked would disagree.
if(NOT _hipblas_dir STREQUAL "${HIPBLAS_FORTRAN_COMPILER_DIR}")
  set_target_properties(roc::hipblas_fortran PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include/fortran/${_hipblas_dir}")
  get_target_property(_hipblas_cfgs roc::hipblas_fortran IMPORTED_CONFIGURATIONS)
  foreach(_hipblas_c IN LISTS _hipblas_cfgs)
    set_target_properties(roc::hipblas_fortran PROPERTIES
      IMPORTED_LOCATION_${_hipblas_c}
        "${PACKAGE_PREFIX_DIR}/lib/fortran/${_hipblas_dir}/libhipblas_fortran.a")
  endforeach()
endif()

set(hipblas_FORTRAN_FOUND TRUE)

check_required_components(hipblas-fortran)
