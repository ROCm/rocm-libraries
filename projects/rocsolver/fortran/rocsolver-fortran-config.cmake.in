# Config package for the rocSOLVER Fortran bindings.
#
#   find_package(rocsolver-fortran REQUIRED)
#   target_link_libraries(my_app PRIVATE roc::rocsolver_fortran)
#
# One archive and .mod set is installed per Fortran compiler. Set
# ROCSOLVER_FORTRAN_COMPILER_DIR before find_package to pick one explicitly.

@PACKAGE_INIT@

set(_rocsolver_built_dir "@ROCSOLVER_FORTRAN_COMPILER_DIR@")

# Absolute, relocatable paths written by PATH_VARS (see PACKAGE_INIT above).
set(_rocsolver_libdir "@PACKAGE_ROCSOLVER_FORTRAN_LIBDIR@")
set(_rocsolver_incdir "@PACKAGE_ROCSOLVER_FORTRAN_INCLUDEDIR@")

set(rocsolver_FORTRAN_FOUND FALSE)

if(NOT CMAKE_Fortran_COMPILER_LOADED)
  set(rocsolver-fortran_FOUND FALSE)
  string(CONCAT rocsolver-fortran_NOT_FOUND_MESSAGE
      "The rocSOLVER Fortran bindings need Fortran enabled before find_package: "
      "add Fortran to your project() languages, or call enable_language(Fortran).")
  return()
endif()

# Accepts FC itself or FC plus a separator and suffix (gfortran-13). Not a regex:
# FC may be an arbitrary basename, and CMake has no regex-escape.
function(_rocsolver_dir_matches DIR FC OUT)
  set(${OUT} FALSE PARENT_SCOPE)
  if(DIR STREQUAL FC)
    set(${OUT} TRUE PARENT_SCOPE)
    return()
  endif()
  string(LENGTH "${FC}" _n)
  string(LENGTH "${DIR}" _dn)
  if(_dn GREATER _n)
    string(SUBSTRING "${DIR}" 0 ${_n} _head)
    string(SUBSTRING "${DIR}" ${_n} 1 _sep)
    if(_head STREQUAL FC AND _sep MATCHES "^[-._]$")
      set(${OUT} TRUE PARENT_SCOPE)
    endif()
  endif()
endfunction()

file(GLOB _rocsolver_avail RELATIVE "${_rocsolver_incdir}" "${_rocsolver_incdir}/*")

set(_rocsolver_dir "")
if(DEFINED ROCSOLVER_FORTRAN_COMPILER_DIR)
  if(NOT EXISTS "${_rocsolver_incdir}/${ROCSOLVER_FORTRAN_COMPILER_DIR}/rocsolver.mod" OR
     NOT EXISTS "${_rocsolver_libdir}/${ROCSOLVER_FORTRAN_COMPILER_DIR}/librocsolver_fortran.a")
    set(rocsolver-fortran_FOUND FALSE)
    string(CONCAT rocsolver-fortran_NOT_FOUND_MESSAGE
        "ROCSOLVER_FORTRAN_COMPILER_DIR is '${ROCSOLVER_FORTRAN_COMPILER_DIR}', but "
        "no rocsolver.mod and librocsolver_fortran.a are installed under "
        "${_rocsolver_incdir}/${ROCSOLVER_FORTRAN_COMPILER_DIR} and "
        "${_rocsolver_libdir}/${ROCSOLVER_FORTRAN_COMPILER_DIR}. Available: "
        "${_rocsolver_avail}.")
    return()
  endif()
  set(_rocsolver_dir "${ROCSOLVER_FORTRAN_COMPILER_DIR}")
else()
  # Must mirror the mapping in projects/rocsolver/fortran/CMakeLists.txt.
  if(CMAKE_Fortran_COMPILER_ID STREQUAL "GNU")
    set(_rocsolver_fc "gfortran")
  elseif(CMAKE_Fortran_COMPILER_ID MATCHES "Flang")
    set(_rocsolver_fc "amdflang")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Cray")
    set(_rocsolver_fc "ftn")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "IntelLLVM")
    set(_rocsolver_fc "ifx")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Intel")
    set(_rocsolver_fc "ifort")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "NVHPC")
    set(_rocsolver_fc "nvfortran")
  else()
    get_filename_component(_rocsolver_fc "${CMAKE_Fortran_COMPILER}" NAME_WE)
    string(TOLOWER "${_rocsolver_fc}" _rocsolver_fc)
  endif()

  # A prefix can hold several compilers' artifacts; the recorded one is a fallback.
  if(EXISTS "${_rocsolver_incdir}/${_rocsolver_fc}/rocsolver.mod")
    set(_rocsolver_dir "${_rocsolver_fc}")
  else()
    _rocsolver_dir_matches("${_rocsolver_built_dir}" "${_rocsolver_fc}" _rocsolver_ok)
    if(_rocsolver_ok)
      set(_rocsolver_dir "${_rocsolver_built_dir}")
    endif()
  endif()

  if(NOT _rocsolver_dir)
    set(rocsolver-fortran_FOUND FALSE)
    string(CONCAT rocsolver-fortran_NOT_FOUND_MESSAGE
        "This project builds with ${_rocsolver_fc}, but no rocsolver.mod for it is "
        "installed under ${_rocsolver_incdir}. Available: "
        "${_rocsolver_avail}. A Fortran .mod cannot be shared across compilers; "
        "rebuild the bindings with ${_rocsolver_fc}, or set "
        "ROCSOLVER_FORTRAN_COMPILER_DIR to the directory to use.")
    return()
  endif()
endif()

# Written TRUE only when the archive links roc::rocsolver, which must be imported
# before the targets file. hip's config needs C or CXX enabled (FindThreads).
if(@ROCSOLVER_FORTRAN_NEEDS_C_PACKAGE@)
  if(NOT TARGET roc::rocsolver)
    if(NOT CMAKE_C_COMPILER_LOADED AND NOT CMAKE_CXX_COMPILER_LOADED)
      enable_language(C)
    endif()
    include(CMakeFindDependencyMacro)
    find_dependency(rocsolver)
  endif()
endif()

# find_package, not find_dependency, so the message below can name what is missing.
if(NOT TARGET roc::rocblas_fortran)
  find_package(rocblas-fortran QUIET CONFIG PATH_SUFFIXES lib/cmake/rocblas)
endif()
if(NOT TARGET roc::rocblas_fortran)
  set(rocsolver-fortran_FOUND FALSE)
  string(CONCAT rocsolver-fortran_NOT_FOUND_MESSAGE
      "The rocSOLVER Fortran bindings are built on the rocBLAS ones (`use "
      "rocblas`), but no rocBLAS Fortran package was found. Install it for "
      "${CMAKE_Fortran_COMPILER} and make sure its prefix is on CMAKE_PREFIX_PATH.")
  return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/rocsolver-fortran-targets.cmake")

# The targets file hardcodes the directory the package was built with.
if(NOT _rocsolver_dir STREQUAL "${_rocsolver_built_dir}")
  set_target_properties(roc::rocsolver_fortran PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_rocsolver_incdir}/${_rocsolver_dir}")
  get_target_property(_rocsolver_cfgs roc::rocsolver_fortran IMPORTED_CONFIGURATIONS)
  foreach(_rocsolver_c IN LISTS _rocsolver_cfgs)
    set_target_properties(roc::rocsolver_fortran PROPERTIES
      IMPORTED_LOCATION_${_rocsolver_c}
        "${_rocsolver_libdir}/${_rocsolver_dir}/librocsolver_fortran.a")
  endforeach()
endif()

set(rocsolver_FORTRAN_FOUND TRUE)

check_required_components(rocsolver-fortran)
