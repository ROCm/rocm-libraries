# End-to-end, reproducible dev image for the TensileLite characterization
# tests (CPU-only, group "unit"). ONE Dockerfile, two layers:
#
#   Layer A — canonical ROCm base, byte-for-byte the output of
#             `/rocm:env --build --arch gfx94X-dcgpu --source run:26531351157`
#             (engex-marketplace-internal `rocm` plugin -> build-dev-env agent).
#             It COPYs TheRock CI run 26531351157's published artifacts onto
#             TheRock's manylinux base. This REPLACES the old, unreproducible
#             `FROM rocm-libs-bump-e3b:26531351157` (a locally-loaded CI image
#             nobody else can rebuild). Everything here comes from public
#             sources -- see README.md section 2 for the command that stages
#             ./artifacts/ from S3 by run id (or section 1 to generate the
#             whole base via the `rocm` skill / `/rocm:env`).
#
#   Layer B — the characterization test layer: Python deps (incl. syrupy, the
#             snapshot library the tests require) + the env vars rocisa needs
#             at runtime.
#
# rocisa itself is NOT baked: its CMake links the monorepo siblings
# shared/origami + shared/stinkytofu, which live in the worktree, not the
# image. Build it once in a worktree-mounted container via `invoke rocisa`
# (README.md section 5) -- the project's standard editable workflow.
#
# NOTE: there is intentionally no `# syntax=docker/dockerfile:1.x` directive.
# It forces BuildKit to pull a frontend image from docker.io, which fails
# (401) on hosts without docker.io auth. This file uses only classic
# Dockerfile syntax, so the built-in frontend handles it.
#
# To build, the build context must contain ./artifacts/ (TheRock's unpacked
# ROCm tree). See README.md section 1 -- the Dockerfile is committed to the
# repo; the multi-GB artifacts are fetched into the context at build time and
# are NOT committed.
#
# ---------------------------------------------------------------------------
# Layer A — ROCm base (generated by rocm:env build-dev-env, manylinux template)
# ---------------------------------------------------------------------------
FROM ghcr.io/rocm/therock_build_manylinux_x86_64:main

LABEL org.opencontainers.image.source="https://github.com/ROCm/TheRock"
LABEL therock.run_id="26531351157"
LABEL therock.arch="gfx94X-dcgpu"
LABEL therock.nickname="tensilelite-char"

# Deps not shipped by TheRock's artifact set.
# llvm-toolset: llvm-profdata + llvm-cov for source-based coverage.
# AlmaLinux 8.10 ships LLVM 21; TheRock's amdclang++ is LLVM 23. Profile
# format is backward-compatible across majors (validated empirically:
# 7 function mismatches out of ~5,000 — acceptable for coverage).
RUN dnf install -y --setopt=install_weak_deps=False llvm-toolset \
 && dnf clean all

COPY artifacts/ /opt/rocm-pkg/

# Compatibility shims (see "Shared conventions" in build-dev-env agent):
#   /opt/rocm symlink, amdllvm shim in bin/, and amdclang{,++,-cl,-cpp}
#   shims for older artifact sets that don't hardlink them into bin/.
# Conditional shim creation is a no-op when bin/ is already populated.
RUN ln -s /opt/rocm-pkg /opt/rocm \
 && if [ -f /opt/rocm/lib/llvm/bin/amdllvm ] && [ ! -e /opt/rocm/bin/amdllvm ]; then \
        ln -s /opt/rocm/lib/llvm/bin/amdllvm /opt/rocm/bin/amdllvm; \
    fi \
 && for tool in amdclang amdclang++ amdclang-cl amdclang-cpp; do \
        if [ -e /opt/rocm/lib/llvm/bin/$tool ] && [ ! -e /opt/rocm/bin/$tool ]; then \
            ln -s /opt/rocm/lib/llvm/bin/$tool /opt/rocm/bin/$tool; \
        fi; \
    done \
 && printf 'export ROCM_PATH=/opt/rocm\n'                                  >  /etc/profile.d/rocm.sh \
 && printf 'export PATH=$ROCM_PATH/lib/llvm/bin:$ROCM_PATH/bin:$PATH\n'    >> /etc/profile.d/rocm.sh \
 && printf 'export LD_LIBRARY_PATH=$ROCM_PATH/lib:$LD_LIBRARY_PATH\n'      >> /etc/profile.d/rocm.sh \
 && printf 'export CMAKE_PREFIX_PATH=$ROCM_PATH\n'                         >> /etc/profile.d/rocm.sh

# ---------------------------------------------------------------------------
# Layer B — characterization test layer
# ---------------------------------------------------------------------------
# The manylinux base sets ROCM_PATH / LD_LIBRARY_PATH / the rocm bin dirs
# only in /etc/profile.d/rocm.sh, i.e. for LOGIN shells. The README drives
# everything with plain `docker exec` (NON-login), so bake the few vars that
# matter into image ENV. Critically, LD_LIBRARY_PATH must carry /opt/rocm/lib
# or `import rocisa` fails to load libamdhip64.so.7. python3 + cmake are
# already on the base's non-login PATH; amdclang++ is reached by absolute
# path from rocisa's CMake, so it need not be on PATH.
ENV ROCM_PATH=/opt/rocm
ENV PATH=/opt/rocm/lib/llvm/bin:/opt/rocm/bin:$PATH
ENV LD_LIBRARY_PATH=/opt/rocm/lib
ENV CMAKE_PREFIX_PATH=/opt/rocm
ENV PIP_NO_CACHE_DIR=1
# Also source the login env for any `bash -lc` callers (belt and suspenders).
ENV BASH_ENV=/etc/profile.d/rocm.sh

# Core deps to import Tensile, run the unit/characterization tests, build
# rocisa, and measure coverage. Kept faithful to requirements.txt + the test
# stack. `syrupy` is the snapshot lib the characterization tests need; it is
# declared in the repo's test deps (tox.ini + pyproject [dependency-groups].dev)
# and pinned here too so the image is self-sufficient.
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install \
        packaging pyyaml msgpack "joblib>=1.4.0" numpy \
        "pytest>=5.4.1" "pytest-xdist>=1.32.0" pytest-cov "coverage[toml]>=7.0.0" \
        syrupy \
        filelock invoke memory_profiler \
        "scikit-build-core>=0.10" "nanobind>=2.0" cmake setuptools

# Optional deps from requirements.txt not needed for unit/char tests
# (client-run / profiling paths). Tolerant so an index hiccup doesn't fail the
# image; record any miss when running the full suite.
RUN python3 -m pip install simplejson ujson orjson yappi tox hip-python || \
    echo "WARN: some optional deps failed to install (ok for unit/char tests)"

WORKDIR /work
