{
  "name": "rocm-libraries (ROCm 7.13 / CK)",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "USERNAME": "${localEnv:USER}",
      "VIDEO_GID": "44",
      "RENDER_GID": "109"
    }
  },

  // Container user matches host $USER; VS Code remaps its UID/GID to the
  // host's at container start so bind-mounted files keep host ownership.
  "remoteUser": "${localEnv:USER}",
  "updateRemoteUserUID": true,
  // Ensure host-side identity files exist before Docker tries to bind-mount
  // them (Docker errors on missing bind sources rather than auto-creating).
  "initializeCommand": "touch ${localEnv:HOME}/.gitconfig ${localEnv:HOME}/.claude.json && mkdir -p ${localEnv:HOME}/.claude ${localEnv:HOME}/.ssh",

  "workspaceFolder": "/workspaces/rocm-libraries",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/rocm-libraries,type=bind,consistency=cached",

  // ROCm device access + ipc=host is required for HIP.
  "runArgs": [
    "--device=/dev/kfd",
    "--device=/dev/dri",
    "--ipc=host",
    "--shm-size=16g",
    "--group-add=video",
    "--group-add=render",
    "--security-opt=seccomp=unconfined",
    "--cap-add=SYS_PTRACE"
  ],

  // Preserve host identity: Claude Code auth/state, git config, SSH keys.
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/${localEnv:USER}/.claude,type=bind",
    "source=${localEnv:HOME}/.claude.json,target=/home/${localEnv:USER}/.claude.json,type=bind",
    "source=${localEnv:HOME}/.gitconfig,target=/home/${localEnv:USER}/.gitconfig,type=bind,readonly",
    "source=${localEnv:HOME}/.ssh,target=/home/${localEnv:USER}/.ssh,type=bind,readonly"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "twxs.cmake",
        "llvm-vs-code-extensions.vscode-clangd"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}