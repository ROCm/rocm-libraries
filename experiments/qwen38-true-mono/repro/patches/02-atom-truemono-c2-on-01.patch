@@ -0,0 +1,565 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+"""The Path B tail hook: ``ATOM_Q38_TRUE_MONO=tail`` (D0.1, DESIGN 7.4 / 7.6).
+
+Path B runs the target's 48 layers as graph-launched ``layers=1`` kernels
+(the ``layer`` hook, ``hook.py``; ``tail`` mode keeps it on) and the round's
+non-layer work -- final HC mix, head and argmax, accept, the draft front,
+draft heads and the drafter's meta -- in a *tail* (one persistent launch, or
+P9's chains). ATOM runs that work in ``ModelRunner.postprocess`` and
+``propose_draft_token_ids``; this module puts a *tail provider* there:
+
+    ATOM_Q38_TRUE_MONO_TAIL=<module>:<callable>     (default: :data:`DEFAULT_PROVIDER`)
+
+``provider(request, hybrid)`` gets a :class:`TailRequest` (one step width)
+and :class:`HybridTail` (the hybrid's own code for it) and returns a *tail*
+or None (refused: that width keeps the hybrid, logged once; under
+``ATOM_Q38_TRUE_MONO_STRICT=1`` it raises :class:`TrueMonoRefused`). A tail
+has the attributes of :class:`HybridTail`:
+
+- ``owns_logits`` (bool): True if the tail computes the logits itself; the
+  width's captured decode graph then holds no ``compute_logits`` and
+  ``step.logits`` is None on its graph replays (eager steps still have them).
+- ``verify(step) -> (sampled_tokens, verdict)`` (MTP steps): what the
+  sampler and the rejection sampler return (``sampled_tokens`` int32
+  ``[bs, k + 1]``; ``verdict`` int32 ``[3, bs]``: accepted drafts
+  (``num_bonus``), rejected (``num_reject``), anchor rows).
+- ``sample(step) -> sampled_tokens`` (no MTP): the sampler's ``[bs]``.
+- ``propose(step, **kw) -> draft_token``: what ``drafter.propose(**kw)``
+  returns (``kw`` = its keyword arguments, unchanged).
+
+``postprocess`` then runs its own bookkeeping on those tensors
+(``prepare_sampled_ids``, the deferred-output path,
+``send_mtp_status_to_cpu_async``, ``prepare_draft_ids``) exactly as on the
+hybrid's: one writer per word (DESIGN 7.3).
+
+A step goes to the tail only when all of these hold (:meth:`TailHook.route`),
+else the hybrid's code runs it (a *transition*, counted per reason):
+a real (not dummy) decode step with no prefill or mid-prompt sequence, every
+request greedy and none asking for logprobs (DESIGN 7.6: routed to the
+hybrid until WP8), the width served by the mono runner, and a tail for it.
+A step the hybrid takes after a graph replay that captured no logits gets
+them from :meth:`TailHook.hybrid_logits` first, so every transition is a
+plain hybrid step. Prefill and mixed steps are always ATOM's (7.4); the
+first tail round after a prefill reads what that path wrote.
+
+**P9's ``input_ids`` alias rule.** The verify reads its drafts from the
+step's ids (``spec.input_ids``: draft r at ``target_logits_indices[r] + 1``)
+and the drafter scatters the next token into ``tokenID_processor.input_ids
+.gpu[1 : total + 1]``: the same buffer, one element on. :class:`StepIds`
+gives a tail both views, the offset and whether they overlap. A tail whose
+verify writes the drafter's ids (a fused accept + front) must read every
+draft id of the step first, in every CTA / wave that uses them (P9 finding 1);
+``ATOM_Q38_TRUE_MONO_CHECK`` catches a tail that does not (the shadow below
+runs on the untouched ids).
+
+``ATOM_Q38_TRUE_MONO_CHECK=<n>`` (gates): for the first ``n`` tail steps of
+each width, run the hybrid's verify / sample first on the same inputs, then
+the tail's, and compare them bit for bit (and, where the decode graph
+captured the logits, those against an eager ``compute_logits`` of the same
+hidden states: the capture / replay check). Mismatches are logged (strict:
+raised). Each check synchronises the stream: never in timed runs.
+
+Imported only in ``tail`` mode (``true_mono.tail_hook``).
+"""
+
+from __future__ import annotations
+
+import collections
+import importlib
+import logging
+import os
+from dataclasses import dataclass
+
+import torch
+
+from .hook import STRICT_ENV, TrueMonoRefused, strict
+
+PROVIDER_ENV = "ATOM_Q38_TRUE_MONO_TAIL"
+CHECK_ENV = "ATOM_Q38_TRUE_MONO_CHECK"
+# rocKE's tail (DESIGN WP4B), on PYTHONPATH as the layer kernels are: not
+# written yet, so ``tail`` serves the hybrid's tail until it is
+DEFAULT_PROVIDER = "kernels.gfx950.qwen38_mono.truemono_tail:provider"
+STATS_ENV = "ATOM_Q38_TRUE_MONO_STATS"
+# a stats line every this many routing decisions (``ATOM_Q38_TRUE_MONO_STATS``)
+STATS_EVERY = 4096
+
+logger = logging.getLogger("atom")
+
+__all__ = [
+    "CHECK_ENV",
+    "DEFAULT_PROVIDER",
+    "PROVIDER_ENV",
+    "STATS_ENV",
+    "STRICT_ENV",
+    "HybridTail",
+    "StepIds",
+    "TailHook",
+    "TailRequest",
+    "TailStep",
+    "TrueMonoRefused",
+]
+
+
+@dataclass(frozen=True)
+class TailRequest:
+    """One step width a tail serves: ``requests`` (the decode graph's batch,
+    padded rows included) of ``k + 1`` rows each (``k`` drafts; 0 without
+    MTP)."""
+
+    requests: int
+    k: int
+
+    @property
+    def rows(self) -> int:
+        return self.requests * (self.k + 1)
+
+    @property
+    def variant(self) -> str:
+        """The width's name as the layer builds name it (``r<rows>``,
+        ``s`` for one request's verify, ``g<k + 1>`` for a grouped one)."""
+        if not self.k:
+            return f"r{self.requests}"
+        if self.requests == 1:
+            return f"r{self.rows}s"
+        return f"r{self.rows}g{self.k + 1}"
+
+
+@dataclass(frozen=True)
+class StepIds:
+    """P9's alias: ``step`` = the verify's ids (``spec.input_ids``), ``draft``
+    = the drafter's ids (``input_ids.gpu[1 : total + 1]``, which
+    ``propose`` scatters the next tokens into); ``draft[j]`` is
+    ``step[j + offset]`` when ``offset`` is not None (same storage)."""
+
+    step: torch.Tensor
+    draft: torch.Tensor
+    offset: int | None
+    overlap: bool
+
+    @staticmethod
+    def of(step: torch.Tensor, draft: torch.Tensor) -> StepIds:
+        size = step.element_size()
+        same = (
+            step.untyped_storage().data_ptr() == draft.untyped_storage().data_ptr()
+            and step.dtype == draft.dtype
+        )
+        offset = (draft.data_ptr() - step.data_ptr()) // size if same else None
+        a0, a1 = step.data_ptr(), step.data_ptr() + step.numel() * size
+        b0 = draft.data_ptr()
+        b1 = b0 + draft.numel() * draft.element_size()
+        return StepIds(step, draft, offset, a0 < b1 and b0 < a1)
+
+
+@dataclass
+class TailStep:
+    """What a tail gets for one step. ``logits`` is None on a graph replay
+    of a width whose tail owns them; ``hidden`` is the model's output as
+    ``postprocess`` has it (MTP: the HC streams ``[rows, hc, hidden]``);
+    ``spec`` the step's ``SpecDecodeMetadata`` (None without MTP); ``ids``
+    the alias (MTP only); ``mono`` the mono decode runner (its ``counter``
+    is the step word every path shares, DESIGN 7.4)."""
+
+    request: TailRequest
+    batch: object
+    spec: object
+    logits: torch.Tensor | None
+    hidden: torch.Tensor
+    ids: StepIds | None
+    mono: object
+    temperatures: object
+    top_ks: object
+    top_ps: object
+    needs_independent_noise: bool
+
+    @property
+    def bs(self) -> int:
+        return self.batch.total_seqs_num
+
+
+class HybridTail:
+    """The hybrid's own tail: ``ModelRunner``'s sampler, rejection sampler and
+    drafter, called exactly as ``postprocess`` calls them. Providers get it to
+    return (pass-through), wrap, or fall back to."""
+
+    owns_logits = False
+
+    def __init__(self, runner) -> None:
+        self.runner = runner
+
+    def logits(self, hidden: torch.Tensor) -> torch.Tensor:
+        """``compute_logits`` of ``hidden``, as the decode graph runs it."""
+        return self.runner.model.compute_logits(hidden)
+
+    def _logits(self, step: TailStep) -> torch.Tensor:
+        return step.logits if step.logits is not None else self.logits(step.hidden)
+
+    def verify(self, step: TailStep):
+        return self.runner._verify_tokens(
+            self._logits(step),
+            step.spec,
+            step.temperatures,
+            step.top_ks,
+            step.top_ps,
+            True,
+            step.needs_independent_noise,
+        )
+
+    def sample(self, step: TailStep):
+        return self.runner._sample_tokens(
+            self._logits(step)[: step.bs],
+            step.temperatures,
+            step.top_ks,
+            step.top_ps,
+            True,
+            step.needs_independent_noise,
+        )
+
+    def propose(self, step: TailStep, **kw):
+        return self.runner.drafter.propose(**kw)
+
+
+def _load(spec: str):
+    """``(callable, None)`` for ``module:attr``, or ``(None, why)``."""
+    mod, sep, attr = spec.partition(":")
+    if not sep or not mod or not attr:
+        return None, f"{PROVIDER_ENV}={spec!r} is not module:callable"
+    try:
+        fn = getattr(importlib.import_module(mod), attr)
+    except (ImportError, AttributeError) as e:
+        return None, f"{spec}: {type(e).__name__}: {e}"
+    if not callable(fn):
+        return None, f"{spec} is not callable"
+    return fn, None
+
+
+def provider_spec() -> str:
+    return os.environ.get(PROVIDER_ENV, "").strip() or DEFAULT_PROVIDER
+
+
+def check_steps() -> int:
+    value = os.environ.get(CHECK_ENV, "").strip()
+    if not value:
+        return 0
+    n = int(value)
+    if n < 0:
+        raise ValueError(f"{CHECK_ENV}={value!r}: expected a count >= 0")
+    return n
+
+
+def _same(a, b) -> bool:
+    """Bitwise equality of two outputs (tensors, or tuples of them / None)."""
+    if isinstance(a, (tuple, list)):
+        return (
+            isinstance(b, (tuple, list))
+            and len(a) == len(b)
+            and all(_same(x, y) for x, y in zip(a, b))
+        )
+    if a is None or b is None:
+        return a is None and b is None
+    return (
+        a.shape == b.shape
+        and a.dtype == b.dtype
+        and a.device == b.device
+        and torch.equal(a, b)
+    )
+
+
+def _signature(x):
+    if isinstance(x, (tuple, list)):
+        return tuple(_signature(v) for v in x)
+    if x is None:
+        return None
+    return (tuple(x.shape), x.dtype, str(x.device))
+
+
+class Route:
+    """One step on a tail (``TailHook.route``)."""
+
+    def __init__(self, hook: TailHook, tail, step: TailStep) -> None:
+        self.hook, self.tail, self.step = hook, tail, step
+
+    def _run(self, what: str, call):
+        hook, step = self.hook, self.step
+        key = step.request.variant
+        if hook.check_left.get(key, hook.check) <= 0:
+            out = call()
+            hook.shape_once(key, what, out, None)
+            return out
+        hook.check_left[key] = hook.check_left.get(key, hook.check) - 1
+        hybrid = hook.hybrid
+        if step.logits is not None:
+            # capture / replay: the graph's logits against an eager head
+            eager = hybrid.logits(step.hidden)
+            hook.record(key, "logits", _same(eager, step.logits))
+        # the hybrid first, on the untouched ids (P9's alias rule)
+        ref = getattr(hybrid, what)(step)
+        out = call()
+        hook.shape_once(key, what, out, ref)
+        hook.record(key, what, _same(ref, out))
+        return out
+
+    def verify(self):
+        return self._run("verify", lambda: self.tail.verify(self.step))
+
+    def sample(self):
+        return self._run("sample", lambda: self.tail.sample(self.step))
+
+    def propose(self, **kw):
+        self.hook.count("tail.propose")
+        return self.tail.propose(self.step, **kw)
+
+
+class TailHook:
+    """Installed on the mono decode model in ``tail`` mode
+    (``true_mono.tail_hook``); ``ModelRunner`` binds itself (``bind``) and
+    asks it per decode graph (``runner_logits``) and per step (``route``)."""
+
+    def __init__(self, model, k: int) -> None:
+        self.model = model  # dispatch.MonoDecodeModel
+        self.k = k
+        self.runner = None
+        self.hybrid = None
+        self.spec = provider_spec()
+        self.check = check_steps()
+        self.stats_every = int(os.environ.get(STATS_ENV, "").strip() or STATS_EVERY)
+        self.check_left: dict[str, int] = {}
+        self.tails: dict[TailRequest, object] = {}
+        # (variant) -> "provider <spec>" or "hybrid: <why>"
+        self.routes: dict[str, str] = {}
+        self.stats: collections.Counter = collections.Counter()
+        self._decisions = 0
+        self._logged: set = set()
+        self._shaped: set = set()
+        self._fn = None
+        self._fn_why = None
+        self._loaded = False
+        self._last = None  # the previous step's route kind: "tail" / reason
+
+    # ------------------------------------------------------------ install
+    def bind(self, runner) -> None:
+        """``ModelRunner`` after the model is installed."""
+        self.runner = runner
+        self.hybrid = HybridTail(runner)
+        logger.info(
+            "Qwen3.8 true mono: tail provider %s, k=%d%s%s",
+            self.spec,
+            self.k,
+            f", check {self.check} steps a width" if self.check else "",
+            ", strict" if strict() else "",
+        )
+
+    def _once(self, key, level, msg, *args) -> None:
+        if key not in self._logged:
+            self._logged.add(key)
+            logger.log(level, msg, *args)
+
+    def _provider(self):
+        if not self._loaded:
+            self._loaded = True
+            self._fn, self._fn_why = _load(self.spec)
+        return self._fn, self._fn_why
+
+    def tail_for(self, req: TailRequest):
+        """The tail of width ``req`` (the provider asked once), or None."""
+        if req in self.tails:
+            return self.tails[req]
+        fn, why = self._provider()
+        tail = None
+        if fn is None:
+            why = f"no tail provider ({why})"
+        else:
+            tail = fn(req, self.hybrid)
+            if tail is None:
+                why = f"the provider {self.spec} has no tail for it"
+        if tail is None:
+            if strict():
+                raise TrueMonoRefused(f"tail {req.variant}: {why}")
+            self.routes[req.variant] = f"hybrid: {why}"
+            self._once(
+                ("refused", req.variant),
+                logging.WARNING,
+                "Qwen3.8 true mono: tail %s: %s; the hybrid serves",
+                req.variant,
+                why,
+            )
+        else:
+            for name in ("verify", "sample", "propose") if self.k else ("sample",):
+                if not callable(getattr(tail, name, None)):
+                    raise TypeError(
+                        f"{self.spec} returned {tail!r} for {req}: no {name}()"
+                    )
+            self.routes[req.variant] = f"provider {self.spec}"
+            logger.info(
+                "Qwen3.8 true mono: tail %s from %s%s",
+                req.variant,
+                self.spec,
+                ", owns the logits" if getattr(tail, "owns_logits", False) else "",
+            )
+        self.tails[req] = tail
+        return tail
+
+    def _request(self, bs: int, q: int) -> TailRequest | None:
+        """The width of a decode graph of ``bs`` requests and ``q`` rows each,
+        or None if no tail could take it."""
+        if q != self.k + 1 or bs < 1:
+            return None
+        return TailRequest(bs, self.k)
+
+    def runner_logits(self, bs: int, q: int) -> bool:
+        """Does the decode graph of key ``(bs, q)`` capture ``compute_logits``
+        (the hybrid's choice), or does its tail own the logits?"""
+        req = self._request(bs, q)
+        if req is None or not self._mono_serves(req.rows):
+            return True
+        tail = self.tail_for(req)
+        owns = tail is not None and bool(getattr(tail, "owns_logits", False))
+        if owns:
+            self.count(f"graph.no_logits.{req.variant}")
+        return not owns
+
+    # ------------------------------------------------------------ steps
+    def _mono_runner(self):
+        lazy = getattr(self.model, "_mono", None)
+        if lazy is None or not lazy.enabled:
+            return None
+        return lazy.runner
+
+    def _mono_serves(self, rows: int) -> bool:
+        r = self._mono_runner()
+        if r is None:
+            return False
+        return rows in getattr(r, "widths", {}) or rows in getattr(r, "groups", {})
+
+    def count(self, what: str) -> None:
+        self.stats[what] += 1
+
+    def record(self, key: str, what: str, ok: bool) -> None:
+        self.count(f"check.{what}.{'equal' if ok else 'DIFF'}")
+        if not ok:
+            msg = f"tail {key}: CHECK {what} differs from the hybrid"
+            logger.warning("Qwen3.8 true mono: %s", msg)
+            if strict():
+                raise TrueMonoRefused(msg)
+
+    def shape_once(self, key: str, what: str, out, ref) -> None:
+        """Each width's first output of each kind: the hybrid's signature
+        (shape, dtype, device), checked against ``ref`` when given."""
+        if (key, what) in self._shaped:
+            return
+        self._shaped.add((key, what))
+        sig = _signature(out)
+        if ref is not None and sig != _signature(ref):
+            raise TypeError(
+                f"tail {key} {what}: {sig} != the hybrid's {_signature(ref)}"
+            )
+        logger.info("Qwen3.8 true mono: tail %s %s output %s", key, what, sig)
+
+    def _decide(self, kind: str) -> None:
+        self.count(f"route.{kind}")
+        if self._last is not None and (self._last == "tail") != (kind == "tail"):
+            self.count(
+                "transition.to_tail" if kind == "tail" else "transition.to_hybrid"
+            )
+            self._once(
+                ("transition", self._last, kind),
+                logging.INFO,
+                "Qwen3.8 true mono: first transition %s -> %s",
+                self._last,
+                kind,
+            )
+        self._last = kind
+        self._decisions += 1
+        if self._decisions % self.stats_every == 0:
+            self.log_stats()
+
+    def log_stats(self) -> None:
+        logger.info(
+            "Qwen3.8 true mono: tail stats %s",
+            ", ".join(f"{k}={v}" for k, v in sorted(self.stats.items())),
+        )
+
+    def route(
+        self,
+        batch,
+        spec,
+        logits,
+        hidden,
+        all_greedy,
+        need_logprobs,
+        temperatures,
+        top_ks,
+        top_ps,
+        needs_independent_noise,
+    ) -> Route | None:
+        """This step's tail, or None (the hybrid's code runs it)."""
+        from atom.utils.forward_context import get_forward_context
+
+        fwd = get_forward_context()
+        context = fwd.context
+        if batch is None or getattr(batch, "is_dummy_run", False):
+            return self._hybrid("dummy")
+        if getattr(batch, "total_seqs_num_prefill", 0) or context is None:
+            return self._hybrid("prefill")
+        if context.is_prefill:
+            return self._hybrid("prefill")
+        if (
+            getattr(context, "draft_anchor_overrides", None) is not None
+            and getattr(batch, "next_token_ids", None) is not None
+        ):
+            # a sequence mid-prompt beside the decodes: its anchor is the
+            # scheduler's (``propose_draft_token_ids``)
+            return self._hybrid("mid_prompt")
+        if (spec is None) != (self.k == 0):
+            return self._hybrid("not_a_decode_step")
+        if not all_greedy:
+            return self._hybrid("not_greedy")
+        if need_logprobs:
+            return self._hybrid("logprobs")
+        q = self.k + 1
+        running = getattr(context, "running_bs", None) or batch.total_seqs_num
+        req = self._request(running, q)
+        if req is None or hidden is None or hidden.shape[0] < batch.total_seqs_num * q:
+            return self._hybrid("width")
+        if not self._mono_serves(req.rows):
+            return self._hybrid("mono_not_serving")
+        tail = self.tail_for(req)
+        if tail is None:
+            return self._hybrid("refused")
+        ids = None
+        if spec is not None:
+            gpu = self.runner.tokenID_processor.input_ids.gpu
+            ids = StepIds.of(spec.input_ids, gpu[1 : batch.total_tokens_num + 1])
+            self._once(
+                ("alias", req.variant),
+                logging.INFO if ids.offset == 1 else logging.WARNING,
+                "Qwen3.8 true mono: tail %s: the drafter's ids are the step's "
+                "offset %s (P9: 1), overlap %s",
+                req.variant,
+                ids.offset,
+                ids.overlap,
+            )
+        step = TailStep(
+            req,
+            batch,
+            spec,
+            logits,
+            hidden,
+            ids,
+            self._mono_runner(),
+            temperatures,
+            top_ks,
+            top_ps,
+            needs_independent_noise,
+        )
+        self._decide("tail")
+        self.count(f"tail.{req.variant}")
+        return Route(self, tail, step)
+
+    def _hybrid(self, why: str):
+        self._decide(why)
+
+    def hybrid_logits(self, hidden: torch.Tensor) -> torch.Tensor:
+        """A hybrid step's logits after a graph replay that captured none."""
+        self.count("hybrid_logits")
+        return self.hybrid.logits(hidden)
