@@ -0,0 +1,256 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+"""``ATOM_Q38_PERTURB`` and ``ATOM_Q38_TF`` (true-mono P11 accuracy-gate calibration hooks).
+
+CPU: both off by default; the perturbation's scope / scale parsing, its
+determinism (a function of the values: same input, same bits), its size
+(relative change within the scale plus one bf16 rounding, mean near zero,
+present at every scale >= one bf16 ulp), scale 0 = identity, zeros stay zero,
+layers and seeds draw different noise; teacher forcing replaces the sampled
+token only at generated positions inside ``golden``, anchors positions on the
+prefill sample (and re-anchors on a later prefill chunk), leaves steps of more
+than one request and requests first seen on a decode step alone, and records
+the forced token's log-probability, the top ids and the log-probabilities at a
+reference record's top ids."""
+
+import json
+import os
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from atom.models.qwen4_exp_mono import q38_accuracy as qa
+
+KINDS = ["delta", "delta", "delta_ple", "qsa"] * 12
+
+
+def _x(rows=4, cols=4096, seed=0):
+    g = torch.Generator().manual_seed(seed)
+    return (torch.randn(rows, cols, generator=g) * 3).to(torch.bfloat16)
+
+
+def test_off_by_default(monkeypatch):
+    monkeypatch.delenv(qa.PERTURB_ENV, raising=False)
+    assert qa.Perturb.from_env() is None
+    r = SimpleNamespace(
+        kinds=KINDS, geometry=SimpleNamespace(hc_width=64), device="cpu"
+    )
+    qa.install_perturb(r)
+    assert r.perturb is None and not r.perturb_layers
+    monkeypatch.delenv(qa.TF_ENV, raising=False)
+    monkeypatch.setattr(qa, "_TF_INIT", False)
+    assert qa.teacher_forcing() is None
+
+
+@pytest.mark.parametrize(
+    "spec,layers,scale",
+    [
+        ("all:2^-6", list(range(48)), 2.0**-6),
+        ("qsa:0.01", [i for i, k in enumerate(KINDS) if k == "qsa"], 0.01),
+        ("delta_ple:1e-3", [i for i, k in enumerate(KINDS) if k == "delta_ple"], 1e-3),
+        ("l3+l17+l3:2^-2:5", [3, 17], 0.25),
+    ],
+)
+def test_scope_and_scale(spec, layers, scale):
+    p = qa.Perturb.from_env({qa.PERTURB_ENV: spec})
+    assert p.layers(KINDS) == layers
+    assert p.scale == scale
+    assert p.seed == (5 if spec.count(":") == 2 else 0)
+
+
+@pytest.mark.parametrize("bad", ["all", "all:-1", "l48:0.1", "x:0.1", "all:0.1:1:2"])
+def test_bad_specs(bad):
+    with pytest.raises(ValueError):
+        qa.Perturb.from_env({qa.PERTURB_ENV: bad}).layers(KINDS)
+
+
+def test_install(monkeypatch):
+    monkeypatch.setenv(qa.PERTURB_ENV, "qsa:2^-8")
+    r = SimpleNamespace(
+        kinds=KINDS, geometry=SimpleNamespace(hc_width=64), device="cpu"
+    )
+    qa.install_perturb(r)
+    assert r.perturb_layers == frozenset(i for i, k in enumerate(KINDS) if k == "qsa")
+    assert r.perturb.describe(12).startswith(
+        "scope=qsa scale=2^-8 (0.00390625) seed=0 layers=12"
+    )
+
+
+@pytest.mark.parametrize("e", [2, 4, 6, 8])
+def test_size_and_determinism(e):
+    p = qa.Perturb("all", f"2^-{e}")
+    x = _x()
+    a, b = x.clone(), x.clone()
+    p.apply(a, 7)
+    p.apply(b, 7)
+    assert torch.equal(a.view(torch.int16), b.view(torch.int16)), "not deterministic"
+    rel = (a.float() - x.float()) / x.float()
+    s = 2.0**-e
+    # within the scale plus one bf16 rounding (2^-8 relative)
+    assert rel.abs().max() <= s + 2.0**-8 + 1e-6
+    # present: a visible share of the elements moved, and the noise is not one-signed
+    moved = (a.view(torch.int16) != x.view(torch.int16)).float().mean()
+    assert moved > (0.3 if e <= 6 else 0.1)
+    assert abs(rel.mean()) < s / 8
+    # spread like the uniform it is drawn from (std s / sqrt(3)) once the rounding is small against it
+    if e <= 6:
+        assert 0.8 < float(rel.std()) / (s / 3**0.5) < 1.2
+
+
+def test_identity_zero_and_independence():
+    x = _x()
+    a = x.clone()
+    qa.Perturb("all", "0").apply(a, 0)
+    assert torch.equal(a.view(torch.int16), x.view(torch.int16))
+    z = torch.zeros(2, 64, dtype=torch.bfloat16)
+    qa.Perturb("all", "2^-1").apply(z, 0)
+    assert not z.any()
+    p, q = qa.Perturb("all", "2^-4"), qa.Perturb("all", "2^-4", seed=1)
+    u0, u1, v0 = p.noise(x, 0), p.noise(x, 1), q.noise(x, 0)
+    for other in (u1, v0):
+        c = torch.corrcoef(torch.stack([u0.flatten(), other.flatten()]))[0, 1]
+        assert abs(float(c)) < 0.05
+    assert -0.5 <= float(u0.min()) and float(u0.max()) < 0.5
+
+
+# ---------------------------------------------------------------- teacher forcing
+
+
+def _batch(req, ctx, prefill, seqs=1):
+    return SimpleNamespace(
+        total_seqs_num=seqs,
+        is_dummy_run=False,
+        req_ids=[req] * seqs,
+        context_lens=[ctx] * seqs,
+        total_tokens_num_prefill=ctx if prefill else 0,
+    )
+
+
+def _logits(winner, v=64):
+    lg = torch.zeros(1, v)
+    lg[0, winner] = 5.0
+    lg[0, (winner + 1) % v] = 3.0
+    return lg
+
+
+def _cur(d, **kw):
+    with open(os.path.join(d, "cur.json"), "w") as f:
+        json.dump({"key": None, "golden": None, "ref": None, "record": False} | kw, f)
+
+
+@pytest.mark.parametrize("spill", [256, 2])
+def test_teacher_forcing(tmp_path, monkeypatch, spill):
+    # spill 2: the rows move to the host every 2 steps; the records must not change
+    monkeypatch.setattr(qa.TeacherForcing, "SPILL_ROWS", spill)
+    ref_dir, arm_dir = tmp_path / "ref", tmp_path / "arm"
+    tf = qa.TeacherForcing(str(ref_dir), topk=4)
+    # record mode: nothing forced, the server's own greedy tokens recorded
+    _cur(ref_dir, key="p0", record=True)
+    out = tf.step(_batch(1, 100, True), _logits(9), torch.tensor([9]))
+    assert out.tolist() == [9]
+    for g, tok in enumerate([11, 12], start=1):
+        tf.step(_batch(1, 100 + g, False), _logits(tok), torch.tensor([tok]))
+    _cur(ref_dir, key="end")
+    tf.step(
+        _batch(2, 5, True), _logits(0), torch.tensor([0])
+    )  # starts the next request: flushes p0
+    rec = torch.load(ref_dir / "p0.pt")
+    assert rec["pos"].tolist() == [0, 1, 2] and rec["token"].tolist() == [9, 11, 12]
+    assert rec["argmax"].tolist() == [9, 11, 12] and not rec["forced"]
+    assert rec["top_ids"].shape == (3, 4) and rec["top_ids"][:, 0].tolist() == [
+        9,
+        11,
+        12,
+    ]
+
+    # forced mode against the reference: the arm prefers other tokens, golden wins
+    tf2 = qa.TeacherForcing(str(arm_dir), topk=4)
+    _cur(arm_dir, key="p0", golden=[9, 11, 12], ref=str(ref_dir), record=True)
+    assert tf2.step(_batch(7, 50, True), _logits(3), torch.tensor([3])).tolist() == [9]
+    # a second prefill chunk of the same request re-anchors on its own context length
+    assert tf2.step(_batch(7, 60, True), _logits(3), torch.tensor([3])).tolist() == [9]
+    assert tf2.step(_batch(7, 61, False), _logits(4), torch.tensor([4])).tolist() == [
+        11
+    ]
+    assert tf2.step(_batch(7, 62, False), _logits(5), torch.tensor([5])).tolist() == [
+        12
+    ]
+    # past the golden: the arm's own token
+    assert tf2.step(_batch(7, 63, False), _logits(6), torch.tensor([6])).tolist() == [6]
+    # two requests in a step, or a request first seen on a decode step: untouched
+    assert tf2.step(
+        _batch(8, 70, False, seqs=2), _logits(1), torch.tensor([1, 1])
+    ).tolist() == [1, 1]
+    assert tf2.step(_batch(9, 70, False), _logits(1), torch.tensor([1])).tolist() == [1]
+    _cur(arm_dir, key="end")
+    tf2.step(_batch(10, 5, True), _logits(0), torch.tensor([0]))
+    rec = torch.load(arm_dir / "p0.pt")
+    assert rec["forced"] and rec["pos"].tolist() == [0, 1, 2, 3]
+    assert rec["token"].tolist() == [9, 11, 12, 6] and rec["argmax"].tolist() == [
+        3,
+        4,
+        5,
+        6,
+    ]
+    lp = torch.log_softmax(_logits(3)[0], -1)
+    assert torch.allclose(rec["lp_token"][0], lp[9])
+    # log-probabilities at the reference's top ids, position by position (the reference has positions 0-2)
+    # position 3 has no reference row: NaN there, values at positions 0-2
+    assert (
+        rec["ref_lp"].shape == (4, 4)
+        and rec["ref_lp"][3].isnan().all()
+        and not rec["ref_lp"][:3].isnan().any()
+    )
+    ref = torch.load(ref_dir / "p0.pt")
+    for g in range(3):
+        assert set(ref["top_ids"][g].tolist()) >= {ref["token"][g].item()}
+
+
+def test_teacher_forcing_one_request_only(tmp_path):
+    tf = qa.TeacherForcing(str(tmp_path), topk=4)
+    _cur(tmp_path, key="p", golden=[9, 11], record=True)
+    # a prefill step of two requests: neither is forced nor recorded
+    assert tf.step(
+        _batch(1, 10, True, seqs=2), _logits(3), torch.tensor([3, 3])
+    ).tolist() == [3, 3]
+    assert tf.req is None and not tf.rows
+
+
+def test_teacher_forcing_ref_gather(tmp_path):
+    ref_dir, arm_dir = tmp_path / "ref", tmp_path / "arm"
+    tf = qa.TeacherForcing(str(ref_dir), topk=4)
+    _cur(ref_dir, key="k", record=True)
+    tf.step(_batch(1, 10, True), _logits(9), torch.tensor([9]))
+    tf.step(_batch(1, 11, False), _logits(2), torch.tensor([2]))
+    _cur(ref_dir, key="end")
+    tf.step(_batch(2, 5, True), _logits(0), torch.tensor([0]))
+    tf2 = qa.TeacherForcing(str(arm_dir), topk=4)
+    _cur(arm_dir, key="k", golden=[9, 2], ref=str(ref_dir), record=True)
+    tf2.step(_batch(3, 10, True), _logits(4), torch.tensor([4]))
+    tf2.step(_batch(3, 11, False), _logits(2), torch.tensor([2]))
+    _cur(arm_dir, key="end")
+    tf2.step(_batch(4, 5, True), _logits(0), torch.tensor([0]))
+    ref, rec = torch.load(ref_dir / "k.pt"), torch.load(arm_dir / "k.pt")
+    for g, w in enumerate([4, 2]):
+        lp = torch.log_softmax(_logits(w)[0], -1)
+        assert torch.allclose(rec["ref_lp"][g], lp[ref["top_ids"][g].long()])
+
+
+def test_teacher_forcing_ref_key(tmp_path):
+    ref_dir, arm_dir = tmp_path / "ref", tmp_path / "arm"
+    tf = qa.TeacherForcing(str(ref_dir), topk=4)
+    _cur(ref_dir, key="k", record=True)
+    tf.step(_batch(1, 10, True), _logits(9), torch.tensor([9]))
+    _cur(ref_dir, key="end")
+    tf.step(_batch(2, 5, True), _logits(0), torch.tensor([0]))
+    # a repeat of key "k" in another request gathers at k's reference ids
+    tf2 = qa.TeacherForcing(str(arm_dir), topk=4)
+    _cur(arm_dir, key="k_r2", golden=[9], ref=str(ref_dir), ref_key="k", record=True)
+    tf2.step(_batch(3, 10, True), _logits(4), torch.tensor([4]))
+    _cur(arm_dir, key="end")
+    tf2.step(_batch(4, 5, True), _logits(0), torch.tensor([0]))
+    rec = torch.load(arm_dir / "k_r2.pt")
+    ref = torch.load(ref_dir / "k.pt")
+    lp = torch.log_softmax(_logits(4)[0], -1)
+    assert torch.allclose(rec["ref_lp"][0], lp[ref["top_ids"][0].long()])
