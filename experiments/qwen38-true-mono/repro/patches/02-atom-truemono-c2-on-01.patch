+def _method(name):
+    tree = ast.parse(RUNNER.read_text(encoding="utf-8"))
+    (cls,) = [
+        n for n in tree.body if isinstance(n, ast.ClassDef) and n.name == "ModelRunner"
+    ]
+    (fn,) = [n for n in cls.body if isinstance(n, ast.FunctionDef) and n.name == name]
+    return cls, fn
+
+
+def _src(node):
+    return ast.unparse(node)
+
+
+def test_model_runner_carries_no_tail_by_default():
+    cls, _ = _method("postprocess")
+    attrs = [
+        n
+        for n in cls.body
+        if isinstance(n, ast.Assign) and _src(n.targets[0]) == "q38_tail"
+    ]
+    assert len(attrs) == 1 and _src(attrs[0].value) == "None"
+    _, init = _method("__init__")
+    s = _src(init)
+    assert "self.q38_tail = getattr(self.model, 'q38_tail', None)" in s
+    assert "self.q38_tail.bind(self)" in s
+
+
+def test_postprocess_routes_through_the_tail():
+    _, fn = _method("postprocess")
+    s = _src(fn)
+    for piece in (
+        "self.q38_tail.route(",
+        "q38_route.verify()",
+        "q38_route.sample()",
+        "logits = self.q38_tail.hybrid_logits(hidden_states)",
+        "self._verify_tokens(",
+        "self._sample_tokens(",
+    ):
+        assert piece in s, piece
+    # the hybrid's sampling lives in the two helpers only, so the
+    # pass-through tail (HybridTail) runs exactly the hybrid's code
+    assert "rejection_sampler" not in s and "self.sampler(" not in s
+    calls = [
+        c
+        for c in ast.walk(fn)
+        if isinstance(c, ast.Call) and _src(c.func) == "self.propose_draft_token_ids"
+    ]
+    assert len(calls) == 2 and all(
+        any(k.arg == "q38_route" for k in c.keywords) for c in calls
+    )
+
