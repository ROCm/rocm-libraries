index 0000000000000000000000000000000000000000..e5cc0fef096ac8307fa019935550874be25d02f4
--- /dev/null
+++ b/atom/models/qwen4_exp_mono/truemono/hook.py
@@ -0,0 +1,185 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+"""The true mono's hook into the mono runners' layer builds.
+
+Each mono runner builds its layer launchers (``kernels.kernel.build_layer``)
+once per width and hands each to ``true_mono.layer_launcher``. With
+``ATOM_Q38_TRUE_MONO=layer`` this module asks a *layer provider* for a rocKE
+layer kernel of the same build:
+
+    ATOM_Q38_TRUE_MONO_LAYER=<module>:<callable>    (default: :data:`DEFAULT_PROVIDER`)
+
+``provider(request, hybrid)`` gets a :class:`LayerRequest` and the hybrid's
+launcher and returns a launcher of the hybrid's ABI -- ``(step counter
+address, layer slot, scratch address, *kernel.LAYER_ARGS[1:], stream=)`` --
+or None for a width it does not serve. A refused width, a provider that does
+not import and the granularities not built yet (``pass``, ``round``,
+``loop``) keep the hybrid's launcher, logged once each (DESIGN 7.4:
+a refusal falls back per width, never "mono off for good").
+``ATOM_Q38_TRUE_MONO_STRICT=1`` raises :class:`TrueMonoRefused` instead
+(gates and probes: a silent fallback would pass for the true mono).
+``tail`` (Path B, D0.1) keeps this hook on for the layers and adds the tail
+hook (``tail.py``).
+
+:data:`ROUTES` records each decision by (runner, kind, variant): what served
+it and why.
+"""
+
+import importlib
+import logging
+import os
+from dataclasses import dataclass
+
+PROVIDER_ENV = "ATOM_Q38_TRUE_MONO_LAYER"
+STRICT_ENV = "ATOM_Q38_TRUE_MONO_STRICT"
+# rocKE's layer kernels (DESIGN WP3), on PYTHONPATH as the extern stages'
+# library is: not written yet, so ``layer`` serves the hybrid until they are
+DEFAULT_PROVIDER = "kernels.gfx950.qwen38_mono.truemono_layer:provider"
+# the work package that builds each granularity (DESIGN 8.2)
+NOT_BUILT = {"pass": "WP4", "round": "WP5c", "loop": "WP12"}
+# the modes whose layers come from the layer provider: Path B's ``tail`` runs
+# graph-launched ``layers=1`` kernels plus the tail (``tail.py``)
+LAYER_MODES = ("layer", "tail")
+WHERE = ("target", "draft")
+
+logger = logging.getLogger("atom")
+
+# (runner, kind, variant) -> "provider <spec>" or "hybrid: <why>"
+ROUTES: dict[tuple[str, str, str], str] = {}
+_logged: set = set()
+_providers: dict[str, tuple] = {}
+
+
+class TrueMonoRefused(RuntimeError):
+    """A true-mono request served by the hybrid under
+    ``ATOM_Q38_TRUE_MONO_STRICT=1``."""
+
+
+@dataclass(frozen=True)
+class LayerRequest:
+    """One layer build a mono runner asks for: ``kind`` (``delta``,
+    ``delta_ple`` or ``qsa``), ``rows``, ``seq`` (an MTP verify's
+    consecutive rows), ``group`` (rows per request of a grouped verify, else
+    0), ``experts`` (routed experts) and ``where`` (``target`` or ``draft``)."""
+
+    kind: str
+    rows: int
+    seq: bool
+    group: int
+    experts: int
+    where: str
+
+    @property
+    def variant(self) -> str:
+        """The build variant's name, as ``sched`` and ``extern_stages`` name
+        it: ``r<rows>``, ``s`` for seq, ``g<group>``."""
+        return (
+            f"r{self.rows}"
+            + ("s" if self.seq else "")
+            + (f"g{self.group}" if self.group else "")
+        )
+
+
+def strict() -> bool:
+    return os.environ.get(STRICT_ENV, "").strip() == "1"
+
+
+def provider_spec() -> str:
+    return os.environ.get(PROVIDER_ENV, "").strip() or DEFAULT_PROVIDER
+
+
+def _load(spec: str):
+    """``(callable, None)`` for ``module:attr``, or ``(None, why)``."""
+    if spec not in _providers:
+        mod, sep, attr = spec.partition(":")
+        if not sep or not mod or not attr:
+            _providers[spec] = (None, f"{PROVIDER_ENV}={spec!r} is not module:callable")
+        else:
+            try:
+                fn = getattr(importlib.import_module(mod), attr)
+            except (ImportError, AttributeError) as e:
+                _providers[spec] = (None, f"{spec}: {type(e).__name__}: {e}")
+            else:
+                if callable(fn):
+                    _providers[spec] = (fn, None)
+                else:
+                    _providers[spec] = (None, f"{spec} is not callable")
+    return _providers[spec]
+
+
+def _once(key, level, msg, *args) -> None:
+    if key not in _logged:
+        _logged.add(key)
+        logger.log(level, msg, *args)
+
+
+def _hybrid(launch, req: LayerRequest, why: str, once_key):
+    """The hybrid's launcher for ``req``, logged once per ``once_key``; raises
+    under ``ATOM_Q38_TRUE_MONO_STRICT=1``."""
+    msg = f"{req.where} {req.kind} {req.variant}: {why}"
+    if strict():
+        raise TrueMonoRefused(msg)
+    ROUTES[(req.where, req.kind, req.variant)] = f"hybrid: {why}"
+    _once(once_key, logging.WARNING, "Qwen3.8 true mono: %s; the hybrid serves", msg)
+    return launch
+
+
+def layer_launcher(mode, launch, kind, rows, *, experts, seq, group, where):
+    """``true_mono.layer_launcher`` for a mode other than ``off``."""
+    if where not in WHERE:
+        raise ValueError(f"where={where!r}: expected one of {WHERE}")
+    req = LayerRequest(kind, rows, bool(seq), int(group), experts, where)
+    if mode not in LAYER_MODES:
+        why = f"ATOM_Q38_TRUE_MONO={mode} is not built yet ({NOT_BUILT[mode]})"
+        return _hybrid(launch, req, why, ("mode", mode))
+    spec = provider_spec()
+    fn, why = _load(spec)
+    if fn is None:
+        return _hybrid(launch, req, f"no layer provider ({why})", ("provider", spec))
+    got = fn(req, launch)
+    if got is None:
+        return _hybrid(
+            launch,
+            req,
+            f"the provider {spec} has no layer kernel for it",
+            ("refused", spec, where, kind, req.variant),
+        )
+    if not callable(got):
+        raise TypeError(f"{spec} returned {got!r} for {req}: not a launcher")
+    ROUTES[(where, kind, req.variant)] = f"provider {spec}"
+    _once(
+        ("served", spec, where, kind, req.variant),
+        logging.INFO,
+        "Qwen3.8 true mono: %s %s %s layer from %s",
+        where,
+        kind,
+        req.variant,
+        spec,
+    )
+    return got
+
+
+def announce(log, mode) -> None:
+    """The install-time line of ``true_mono.announce``."""
+    if mode in LAYER_MODES:
+        log.info(
+            "Qwen3.8 true mono: ATOM_Q38_TRUE_MONO=%s, provider %s%s",
+            mode,
+            provider_spec(),
+            ", strict" if strict() else "",
+        )
+    else:
+        log.warning(
+            "Qwen3.8 true mono: ATOM_Q38_TRUE_MONO=%s is not built yet (%s); "
+            "the hybrid serves every width%s",
+            mode,
+            NOT_BUILT[mode],
+            " (strict: the first build raises)" if strict() else "",
+        )
+
+
+def reset() -> None:
+    """Forget the routes, logged lines and loaded providers (tests)."""
+    ROUTES.clear()
+    _logged.clear()
+    _providers.clear()
