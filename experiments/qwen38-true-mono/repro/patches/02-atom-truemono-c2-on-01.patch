@@ -0,0 +1,173 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+"""Round-boundary host timeline (diagnostics; Qwen3.8 true mono, round-boundary track).
+
+``ATOM_Q38_HOSTTL=<dir>`` (unset: off, every call below is a no-op behind the module
+flag :data:`ON`) records, per engine step, host timestamps (``time.monotonic_ns``:
+CLOCK_MONOTONIC, one clock for the EngineCore and the model-runner processes) at
+named points of the step, and in the runner GPU timing events at a few of them
+(``gpu=True``). No sync is added: events are resolved two steps later with
+``query()``. The first ``ATOM_Q38_HOSTTL_SKIP`` steps (default 64) are skipped,
+then ``ATOM_Q38_HOSTTL_STEPS`` (default 400) steps are kept and written once to
+``<dir>/hosttl_<role>_<pid>.json``; recording stops after that.
+
+A GPU mark's ``g`` is its GPU time (us) relative to the step's first GPU mark; the
+first GPU mark also carries ``gprev``: GPU time since the previous step's last
+GPU mark (the boundary: if the host recorded the first mark after the GPU drained,
+``gprev`` is the GPU idle between the steps, plus the marker itself).
+"""
+
+import json
+import os
+import time
+
+ENV = "ATOM_Q38_HOSTTL"
+_DIR = os.getenv(ENV, "")
+ON = bool(_DIR)
+SKIP = int(os.getenv(ENV + "_SKIP", "64"))
+STEPS = int(os.getenv(ENV + "_STEPS", "400"))
+# ATOM_Q38_HOSTTL_SYNCDBG=1: torch.cuda.set_sync_debug_mode("warn") while recording (lists hidden syncs)
+SYNCDBG = os.getenv(ENV + "_SYNCDBG", "0") == "1"
+
+_now = time.monotonic_ns
+
+
+class _Rec:
+    def __init__(self, role: str):
+        self.role = role
+        self.step = -1
+        self.cur = None  # current step's record
+        self.done = []
+        self.pending = []  # steps whose GPU marks are not resolved yet
+        self.prev_last = None  # previous kept step's last GPU event
+        self.closed = False
+        self._pre = None
+        self._syncdbg = False
+
+    # ---- per step ----
+    def begin(self, kind: str = "") -> None:
+        if self.closed:
+            return
+        self.step += 1
+        self._resolve(final=False)
+        if self.step < SKIP:
+            self.cur = None
+            return
+        if len(self.done) + len(self.pending) + 1 > STEPS:
+            self._finish()
+            return
+        self.cur = {"step": self.step, "kind": kind, "m": [], "gm": []}
+        if self._pre is not None:
+            self.cur["m"].append(self._pre)
+        self._pre = None
+        if SYNCDBG and not self._syncdbg and self.role == "runner":
+            import torch
+
+            torch.cuda.set_sync_debug_mode(1)  # warn on every synchronizing op (stack in the log)
+            self._syncdbg = True
+
+    def mark(self, name: str, gpu: bool = False) -> None:
+        c = self.cur
+        if c is None:
+            return
+        t = _now()
+        c["m"].append((name, t))
+        if gpu:
+            import torch
+
+            ev = torch.cuda.Event(enable_timing=True)
+            ev.record()
+            c["gm"].append((name, t, ev))
+
+    def probe(self, name: str) -> None:
+        """Has the GPU finished the previous step's last GPU mark by now? (``query()``, no sync)."""
+        c = self.cur
+        if c is not None and self.prev_last is not None:
+            c.setdefault("q", {})[name] = bool(self.prev_last.query())
+
+    def pre(self, name: str) -> None:
+        """A mark taken before the step begins (e.g. the RPC dequeue); joins the next step."""
+        self._pre = (name, _now())
+
+    def late(self, name: str) -> None:
+        """A mark after the step ended (e.g. the output send); joins the step just ended."""
+        last = self.pending[-1] if self.pending else (self.done[-1] if self.done else None)
+        if last is not None and last.get("step") == self.step and self.cur is None:
+            last["m"].append((name, _now()))
+
+    def dur(self, name: str, t0: int) -> None:
+        """A named duration (host ns) that began at ``t0`` and ends now (e.g. a sync)."""
+        c = self.cur
+        if c is not None:
+            c["m"].append((name + ".0", t0))
+            c["m"].append((name + ".1", _now()))
+
+    def end(self) -> None:
+        c = self.cur
+        if c is None:
+            return
+        self.cur = None
+        if c["gm"]:
+            c["prev_ev"] = self.prev_last
+            self.prev_last = c["gm"][-1][2]
+            self.pending.append(c)
+        else:
+            self._keep(c)
+
+    # ---- resolution / output ----
+    def _keep(self, c) -> None:
+        c.pop("prev_ev", None)
+        c["gm"] = [(n, t, g) for (n, t, g) in c.get("gm", [])]
+        self.done.append(c)
+
+    def _resolve(self, final: bool) -> None:
+        keep = []
+        for c in self.pending:
+            evs = [e for (_, _, e) in c["gm"]]
+            pe = c.get("prev_ev")
+            if not final and not all(e.query() for e in evs + ([pe] if pe is not None else [])):
+                keep.append(c)
+                continue
+            if final:
+                evs[-1].synchronize()
+            first = evs[0]
+            gm = []
+            for n, t, e in c["gm"]:
+                gm.append((n, t, round(first.elapsed_time(e) * 1000.0, 2)))
+            c["gprev"] = round(pe.elapsed_time(first) * 1000.0, 2) if pe is not None else None
+            c["gm"] = gm
+            c.pop("prev_ev", None)
+            self.done.append(c)
+        self.pending = keep
+
+    def _finish(self) -> None:
+        if self.closed:
+            return
+        self.closed = True
+        self.cur = None
+        if self._syncdbg:
+            import torch
+
+            torch.cuda.set_sync_debug_mode(0)
+        try:
+            self._resolve(final=True)
+        except Exception as e:  # diagnostics never take the server down
+            self.done.append({"error": repr(e)})
+        os.makedirs(_DIR, exist_ok=True)
+        path = os.path.join(_DIR, f"hosttl_{self.role}_{os.getpid()}.json")
+        with open(path + ".part", "w") as f:
+            json.dump({"role": self.role, "skip": SKIP, "steps": self.done}, f)
+        os.replace(path + ".part", path)
+
+
+_recs: dict = {}
+
+
+def rec(role: str) -> _Rec:
+    r = _recs.get(role)
+    if r is None:
+        r = _recs[role] = _Rec(role)
+        import atexit
+
+        atexit.register(lambda: r.done and r._finish())
+    return r
