+# ---------------------------------------------------------------- ModelRunner, behaviour
+# (as tests/test_postprocess_width.py: skipped where model_runner cannot import)
+
+
+def _mr():
+    return pytest.importorskip(
+        "atom.model_engine.model_runner",
+        reason="model_runner imports aiter at module load",
+        exc_type=ImportError,
+    )
+
+
+class _FakeRoute:
+    def __init__(self, log):
+        self.log = log
+
+    def sample(self):
+        self.log.append("sample")
+        return torch.full((2,), 11, dtype=torch.int32)
+
+    def verify(self):
+        self.log.append("verify")
+        sampled = torch.tensor([[5, 9, -1, -1]], dtype=torch.int32)
+        return sampled, torch.tensor([[1], [2], [1]], dtype=torch.int32)
+
+    def propose(self, **kw):
+        self.log.append(("propose", sorted(kw)))
+        return "drafts"
+
+
+class _FakeTail:
+    def __init__(self, log, serve=True):
+        self.log, self.serve = log, serve
+
+    def route(self, batch, spec, logits, hidden, all_greedy, logprobs, *rest):
+        self.log.append(
+            ("route", spec is not None, logits is None, all_greedy, logprobs)
+        )
+        return _FakeRoute(self.log) if self.serve else None
+
+    def hybrid_logits(self, hidden):
+        self.log.append("hybrid_logits")
+        return torch.zeros(hidden.shape[0], 8)
+
+
+def _mr_runner(mod, log, tail_obj):
+    runner = object.__new__(mod.ModelRunner)
+
+    def _sampler(logits, *a, **k):
+        log.append(("sampler", logits.shape[0]))
+        return torch.zeros(logits.shape[0], dtype=torch.int32)
+
+    runner.sampler = _sampler
+    runner.q38_tail = tail_obj
+    runner.forward_done_event = SimpleNamespace(record=lambda: None)
+    seen = {}
+
+    def _prep(batch, sampled, event, logprobs):
+        seen["sampled"] = sampled
+        return {}, {}
+
+    runner.tokenID_processor = SimpleNamespace(
+        is_deferred_out=False,
+        prev_batch=None,
+        default_num_rejected_tokens=torch.zeros(64, dtype=torch.int32),
+        prepare_sampled_ids=_prep,
+    )
+    return runner, seen
+
+
+def _mr_batch(n):
+    return SimpleNamespace(
+        total_seqs_num=n,
+        total_tokens_num=n,
+        req_ids=list(range(n)),
+        return_logprobs=[False] * n,
+    )
+
+
