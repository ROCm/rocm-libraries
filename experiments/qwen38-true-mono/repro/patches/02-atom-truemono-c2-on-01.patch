+from atom.models.qwen4_exp_mono import true_mono
+from atom.models.qwen4_exp_mono.truemono import hook, tail
+
+PKG = pathlib.Path(true_mono.__file__).resolve().parent
+ATOM_ROOT = PKG.parents[2]
+RUNNER = ATOM_ROOT / "atom" / "model_engine" / "model_runner.py"
+ENVS = (
+    true_mono.ENV,
+    hook.PROVIDER_ENV,
+    hook.STRICT_ENV,
+    tail.PROVIDER_ENV,
+    tail.CHECK_ENV,
+    tail.STATS_ENV,
+)
+K = 3
+VOCAB = 16
