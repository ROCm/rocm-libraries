@@ -0,0 +1,357 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+"""Round boundary without the host: round t+1's accept-dependent metadata on the device.
+
+Qwen3.8 true mono, round-boundary track (default off). In ATOM's deferred MTP decode the model runner prepares
+round t+1 only after ``recv_mtp_status_async`` has read round t's rejection counts on the host: the host waits for
+round t's verify, then builds the metadata (~0.1 of a round of host work) and launches the next graph while the GPU
+runs round t's drafts. When that host work outlasts the drafts the GPU idles at every round boundary (measured with
+``hosttl``: hosttl_an / RB job rb-tl1). Every accept-dependent value of the step is a shift of its full-acceptance
+value by the request's rejection count r (and ``num_accepted`` = bonus + 1), so:
+
+``ATOM_Q38_RB_DEVMETA=1``: for a pure deferred speculative decode step the host prepares with r = 0 / bonus = K for
+every carried-over request (no wait), and one device kernel (:func:`apply`, enqueued right after ``prepare_model``,
+before the graph) shifts ``context_lens``, the mRoPE (or plain) positions, ``qsa_logical_positions``, recomputes
+``slot_mapping`` from the step's block table, ``kv_indptr`` and ``num_accepted_tokens`` from round t's DEVICE
+verdict (``num_reject_tokens`` / ``next_token_locs``, indexed through ``decode_src``), then re-derives the device
+products ``prepare_decode`` built from them (``kv_indices``, ``qsa_compressed_slots``, the FlyDSL plan). The rejection
+counts reach the host later, at the start of ``postprocess`` (after the next graph launch), where the scheduler's
+deferred output wants them. Requests new to the step keep the host path (decode_src < 0: r = 0 on the device).
+
+``ATOM_Q38_RB_DEVMETA=check``: the same, plus a reference per step for the first ``ATOM_Q38_RB_DEVMETA_CHECK`` (64)
+eligible steps: the step is prepared twice (device path, then ATOM's own path with the host counts), every device
+tensor of ``forward_vars``, the metadata builder and the step's attention metadata compared bit for bit, the step
+served with ATOM's values. Logs ``rb devmeta check step N: OK`` / ``DIFF <names>``.
+``ATOM_Q38_RB_DEVMETA_MUT`` (gates only): ``nofix`` (no kernel), ``slot`` (slot + 1), ``acc`` (bonus, not bonus + 1),
+``noderive`` (no re-derivation; with ``_FUSE`` only the bs > 1 kv_indices), ``pos`` (positions not shifted),
+``comp`` (fused compressed QSA slot + 1).
+"""
+
+import logging
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+ENV = "ATOM_Q38_RB_DEVMETA"
+MODE = os.getenv(ENV, "")
+ON = MODE in ("1", "check")
+CHECK = MODE == "check"
+CHECK_STEPS = int(os.getenv(ENV + "_CHECK", "64"))
+# check every Nth eligible step (default 1: consecutive). With N > 1 the N - 1 production device-path steps between
+# checks run without ATOM's reference pass, so drift a skipped upload / fill would leave (TRIM, ADV) reaches the check.
+CHECK_EVERY = max(1, int(os.getenv(ENV + "_CHECK_EVERY", "1")))
+MUT = os.getenv(ENV + "_MUT", "")
+# ATOM_Q38_RB_DEVMETA_ADV=1: on a steady-state step (the previous step was a device-path step with the same requests in
+# the same order and width) skip the uploads of the accept-dependent buffers (``suppress_set``) and advance them on the
+# device from round t's true length (``_state``): length + q - r. Needs the fused path.
+ADV = os.getenv(ENV + "_ADV", "0") == "1"
+# ATOM_Q38_RB_DEVMETA_FUSE=1 (default): the compressed QSA slots in the shift kernel, and kv_indices re-derived only
+# when a request's kv offset can move (bs > 1; at bs 1 the r = 0 superset already holds every read entry); 0: the
+# shift kernel plus ATOM's own kv_indices / qsa_compressed_slots launches (v1)
+FUSE = os.getenv(ENV + "_FUSE", "1") == "1"
+SNAP_MAX = int(os.getenv(ENV + "_SNAP_MAX_MIB", "256")) << 20
+logger = logging.getLogger("atom")
+_logged: set = set()
+
+
+def log_once(msg: str) -> None:
+    if msg not in _logged:
+        _logged.add(msg)
+        logger.info(msg)
+
+
+@triton.jit
+def _fix_kernel(
+    r_ptr,
+    b_ptr,
+    src_ptr,
+    ctx_ptr,
+    mrope_ptr,
+    pos_ptr,
+    logical_ptr,
+    slot_ptr,
+    bt_ptr,
+    acc_ptr,
+    kvp_ptr,
+    comp_ptr,
+    st_ctx_ptr,
+    st_delta_ptr,
+    bs,
+    running_bs,
+    q,
+    mrope_w,
+    bt_stride,
+    slot_block,
+    kv_block,
+    ratio,
+    HAS_MROPE: tl.constexpr,
+    FUSE_COMP: tl.constexpr,
+    HAS_POS: tl.constexpr,
+    MUT_SLOT: tl.constexpr,
+    MUT_ACC: tl.constexpr,
+    MUT_POS: tl.constexpr,
+    MUT_COMP: tl.constexpr,
+    ADVANCE: tl.constexpr,
+    MUT_ADV: tl.constexpr,
+    QB: tl.constexpr,
+    PB: tl.constexpr,
+):
+    j = tl.arange(0, QB)
+    jm = j < q
+    total = tl.load(kvp_ptr).to(tl.int64)  # kv_indptr[0] (0)
+    for i in range(0, bs):
+        s = tl.load(src_ptr + i)
+        live = s >= 0
+        si = tl.where(live, s, 0)
+        r = tl.where(live, tl.load(r_ptr + si).to(tl.int64), 0)
+        if ADVANCE:
+            # steady state (same requests, same order): round t's true length + q - r (the uploads were skipped)
+            adv = r
+            if MUT_ADV:
+                adv = r * 0
+            ctx = tl.load(st_ctx_ptr + i) + q - adv
+        else:
+            ctx = tl.load(ctx_ptr + i).to(tl.int64) - r
+        tl.store(ctx_ptr + i, ctx.to(ctx_ptr.dtype.element_ty))
+        tl.store(st_ctx_ptr + i, ctx)
+        b = tl.load(b_ptr + si).to(tl.int64)
+        acc = b + 1
+        if MUT_ACC:
+            acc = b
+        old_acc = tl.load(acc_ptr + i)
+        tl.store(acc_ptr + i, tl.where(live, acc.to(acc_ptr.dtype.element_ty), old_acc))
+        shift = r
+        if MUT_POS:
+            shift = r * 0
+        t = i * q + j
+        if ADVANCE:
+            lg = ctx - q + j
+            delta = tl.load(st_delta_ptr + i)
+            if HAS_MROPE:
+                for k in tl.static_range(3):
+                    tl.store(mrope_ptr + k * mrope_w + t, (lg + delta).to(mrope_ptr.dtype.element_ty), mask=jm)
+            if HAS_POS:
+                tl.store(pos_ptr + t, lg.to(pos_ptr.dtype.element_ty), mask=jm)
+        else:
+            if HAS_MROPE:
+                # the request's mRoPE offset (text: one value; a shift moves both alike), read before any store and
+                # kept for the steady-state advance
+                p0 = tl.load(mrope_ptr + i * q).to(tl.int64)
+                l0 = tl.load(logical_ptr + i * q).to(tl.int64)
+                tl.store(st_delta_ptr + i, p0 - l0)
+                for k in tl.static_range(3):
+                    p = tl.load(mrope_ptr + k * mrope_w + t, mask=jm)
+                    tl.store(mrope_ptr + k * mrope_w + t, (p - shift).to(p.dtype), mask=jm)
+            if HAS_POS:
+                p = tl.load(pos_ptr + t, mask=jm)
+                tl.store(pos_ptr + t, (p - shift).to(p.dtype), mask=jm)
+            lg = tl.load(logical_ptr + t, mask=jm, other=0).to(tl.int64) - r
+        tl.store(logical_ptr + t, lg.to(logical_ptr.dtype.element_ty), mask=jm)
+        blk = lg // slot_block
+        phys = tl.load(bt_ptr + i * bt_stride + blk, mask=jm, other=0).to(tl.int64)
+        slot = phys * slot_block + lg % slot_block
+        if MUT_SLOT:
+            slot = slot + 1
+        tl.store(slot_ptr + t, slot.to(slot_ptr.dtype.element_ty), mask=jm)
+        if FUSE_COMP:
+            # qsa_compressed_slots' rule (_qsa_compressed_slots_kernel), on the shifted tokens
+            closes = (lg >= 0) & ((lg + 1) % ratio == 0) & (slot >= 0)
+            comp = slot // ratio
+            if MUT_COMP:
+                comp = comp + 1
+            tl.store(comp_ptr + t, tl.where(closes, comp, -1).to(comp_ptr.dtype.element_ty), mask=jm)
+        total = total + (ctx + kv_block - 1) // kv_block
+        tl.store(kvp_ptr + i + 1, total.to(kvp_ptr.dtype.element_ty))
+    # graph-padding requests: kv_indptr stays at the sum (prepare_decode's rule)
+    for p0 in range(bs + 1, running_bs + 1, PB):
+        pi = p0 + tl.arange(0, PB)
+        tl.store(kvp_ptr + pi, total.to(kvp_ptr.dtype.element_ty), mask=pi < running_bs + 1)
+
+
+def _np2(n: int) -> int:
+    return 1 << max(0, (int(n) - 1).bit_length())
+
+
+def refusal(runner) -> str | None:
+    """Why this server cannot use the device path (checked once), or None."""
+    tp = runner.tokenID_processor
+    b = runner.attn_metadata_builder
+    if not tp.is_deferred_out or not tp.use_spec:
+        return "needs deferred output and MTP"
+    if getattr(b, "replayssm", False):
+        return "replayssm"
+    for name in ("context_lens", "slot_mapping", "kv_indptr", "block_tables", "qsa_logical_positions",
+                 "qsa_token_to_req", "qsa_compressed_slots", "kv_indices", "decode_src"):
+        if name not in runner.forward_vars:
+            return f"no forward_vars[{name!r}]"
+    if getattr(b, "_num_accepted", None) is None:
+        return "no metadata-builder num_accepted buffer"
+    if len(getattr(runner, "_fv_ring", [None])) != 1:
+        return "forward_vars ring (pipeline parallel)"
+    return None
+
+
+def _state(runner):
+    """Per-request device state across device-path steps: round t's true context length and its mRoPE offset."""
+    st = getattr(runner, "_rb_dev_state", None)
+    if st is None:
+        n = runner.tokenID_processor.decode_src.gpu.shape[0]
+        st = runner._rb_dev_state = (
+            torch.zeros(n, dtype=torch.int64, device=runner.device),
+            torch.zeros(n, dtype=torch.int64, device=runner.device),
+        )
+    return st
+
+
+def suppress_set(runner) -> frozenset:
+    """``ATOM_Q38_RB_DEVMETA_ADV``: the uploads a steady-state step skips (the advance kernel writes them)."""
+    var = runner.forward_vars
+    names = ["slot_mapping", "context_lens", "kv_indptr", "qsa_logical_positions"]
+    if getattr(runner, "use_mrope", False):
+        names.append("mrope_positions")
+    else:
+        names.append("positions")
+    bufs = [var[n] for n in names] + [runner.attn_metadata_builder._num_accepted]
+    return frozenset(id(b) for b in bufs)
+
+
+def apply(runner, batch, md, advance: bool = False) -> None:
+    """Shift the step's accept-dependent device metadata by round t's device verdict; re-derive its products.
+    ``advance``: steady state with the uploads skipped: the values come from the per-request device state."""
+    tp = runner.tokenID_processor
+    var = runner.forward_vars
+    b = runner.attn_metadata_builder
+    r_dev, b_dev = tp.rb_prev_dev
+    bs = batch.total_seqs_num_decode
+    q = int(md.max_seqlen_q)
+    running_bs = int(md.context_lens.shape[0])
+    num_tokens = int(md.qsa_metadata.slot_mapping.shape[0]) if md.qsa_metadata is not None else bs * q
+    use_mrope = bool(getattr(runner, "use_mrope", False))
+    mrope = var["mrope_positions"].gpu.reshape(-1) if use_mrope else var["context_lens"].gpu
+    bt = var["block_tables"].gpu
+    st_ctx, st_delta = _state(runner)
+    if MUT != "nofix":
+        _fix_kernel[(1,)](
+            r_dev,
+            b_dev,
+            var["decode_src"].gpu,
+            var["context_lens"].gpu,
+            mrope,
+            var["positions"].gpu,
+            var["qsa_logical_positions"].gpu,
+            var["slot_mapping"].gpu,
+            bt,
+            b._num_accepted.gpu,
+            var["kv_indptr"].gpu,
+            var["qsa_compressed_slots"],
+            st_ctx,
+            st_delta,
+            bs,
+            running_bs,
+            q,
+            num_tokens,
+            bt.stride(0),
+            runner.block_size,
+            b.block_size,
+            int(getattr(b, "_compress_ratio", 1) or 1),
+            HAS_MROPE=use_mrope,
+            FUSE_COMP=FUSE and md.qsa_metadata is not None,
+            HAS_POS=not use_mrope,
+            MUT_SLOT=MUT == "slot",
+            MUT_ACC=MUT == "acc",
+            MUT_POS=MUT == "pos",
+            MUT_COMP=MUT == "comp",
+            ADVANCE=advance,
+            MUT_ADV=MUT == "adv",
+            QB=_np2(q),
+            PB=64,
+        )
+    if MUT == "noderive":
+        return
+    from atom.utils.block_convert import kv_indices_generate_triton
+
+    # advance: prepare_decode generated kv_indices from the stale (not uploaded) kv_indptr, so always re-derive
+    if not FUSE or bs > 1 or advance:
+        kv_indices_generate_triton(
+            var["block_tables"].gpu[:running_bs],
+            var["kv_indices"].gpu,
+            var["kv_indptr"].gpu[: running_bs + 1],
+            b.block_ratio,
+            int(md.max_seqlen_k),
+        )
+    if md.qsa_metadata is not None and not FUSE:
+        from atom.model_ops.qwen4_exp.ops.qsa import qsa_compressed_slots
+
+        qsa_compressed_slots(
+            var["slot_mapping"].gpu[:num_tokens],
+            var["qsa_logical_positions"].gpu[:num_tokens],
+            b._compress_ratio,
+            var["qsa_compressed_slots"][:num_tokens],
+        )
+    if getattr(md, "flydsl_work_plan", None) is not None:
+        md.flydsl_work_plan = b.refresh_flydsl_plan(md.context_lens)
+
+
+# ---- check mode: bitwise compare of every device tensor the step's preparation can write ----
+def _tensors(obj, prefix, out, seen, depth):
+    if depth < 0 or obj is None or id(obj) in seen:
+        return
+    seen.add(id(obj))
+    if isinstance(obj, torch.Tensor):
+        if obj.is_cuda and obj.numel() > 0:
+            out.setdefault(prefix, obj)
+        return
+    gpu = getattr(obj, "gpu", None)
+    if isinstance(gpu, torch.Tensor):
+        _tensors(gpu, prefix + ".gpu", out, seen, depth)
+        return
+    if isinstance(obj, dict):
+        items = list(obj.items())
+    elif isinstance(obj, (list, tuple)):
+        items = list(enumerate(obj))
+    elif hasattr(obj, "__dict__") and not isinstance(obj, type) and not callable(obj):
+        items = list(vars(obj).items())
+    else:
+        return
+    for k, v in items:
+        if isinstance(k, str) and k.startswith("__"):
+            continue
+        _tensors(v, f"{prefix}.{k}", out, seen, depth - 1)
+
+
+def snapshot(runner, md) -> dict:
+    torch.cuda.synchronize()
+    found: dict = {}
+    seen: set = set()
+    _tensors(runner.forward_vars, "fv", found, seen, 2)
+    _tensors(runner.attn_metadata_builder, "builder", found, seen, 2)
+    _tensors(md, "md", found, seen, 3)
+    # one entry per distinct storage view; kv_indices only up to the step's kv_indptr end (the rest is never read)
+    snap = {}
+    byptr = {}
+    for name, t in found.items():
+        key = (t.data_ptr(), t.numel(), t.dtype)
+        if key in byptr:
+            continue
+        if t.numel() * t.element_size() > SNAP_MAX:  # caches / weights (no step metadata is this big)
+            log_once(f"rb devmeta check: not compared (> {SNAP_MAX >> 20} MiB): {name} {tuple(t.shape)}")
+            continue
+        byptr[key] = name
+        snap[name] = t.clone()
+    return snap
+
+
+def compare(a: dict, b: dict, kv_end: int) -> list:
+    diff = []
+    for name, x in a.items():
+        y = b.get(name)
+        if y is None or x.shape != y.shape:
+            diff.append(name + "(missing)")
+            continue
+        if name.endswith("kv_indices.gpu") or name.endswith(".kv_indices"):
+            x, y = x.reshape(-1)[:kv_end], y.reshape(-1)[:kv_end]
+        if not torch.equal(x, y):
+            diff.append(name)
+    return diff
diff --git a/atom/models/qwen4_exp_mono/truemono/slots.py b/atom/models/qwen4_exp_mono/truemono/slots.py
new file mode 100644
index 0000000000000000000000000000000000000000..94f52f13bba1571659f3e685863c36e0c6cd3371
--- /dev/null
+++ b/atom/models/qwen4_exp_mono/truemono/slots.py
@@ -0,0 +1,82 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+"""Instance names and their mailbox tag slots in one true-mono round.
+
+A launch's tag is ``step * LAYER_SLOTS + slot + 1`` (``kernels.mailbox``);
+DESIGN 6.2 keeps a slot below ``LAYER_SLOTS - 1`` (63), so a tag never reaches
+the next step's range and the stamp / blame regions (``[LAYER_SLOTS]`` rows)
+hold every slot. The hybrid gives
+target layer ``i`` slot ``i`` and the drafter's layer slot 48 under its own
+counter. A round launch runs every instance under one counter, so every
+instance needs its own slot (DESIGN 6.2):
+
+=====================  =======  =========================================
+instance               slots    what
+=====================  =======  =========================================
+``target.<l>``         0 .. 47  target layer ``l``
+``draft.<j>``          48 .. 50 draft forward ``j`` (``j`` < k <= 3), the
+                                drafter's layer
+``tail.<f>``           52 .. 55 final mix / head / accept or draft token of
+                                forward ``f`` (0 target, 1 .. k drafts)
+``front.<f>``          56 .. 59 draft front of forward ``f``
+``meta``               60       prologue + verify meta at launch start
+=====================  =======  =========================================
+
+Slots 51, 61 and 62 are free; 63 is never used.
+Standard library only.
+"""
+
+LAYER_SLOTS = 64  # kernels.mailbox.LAYER_SLOTS (a GPU-side test pins it)
+TARGET_LAYERS = 48
+MAX_DRAFTS = 3  # dispatch SPEC_TOKENS: k <= 3
+
+_BASES = {"target": 0, "draft": 48, "tail": 52, "front": 56, "meta": 60}
+_COUNTS = {
+    "target": TARGET_LAYERS,
+    "draft": MAX_DRAFTS,
+    "tail": MAX_DRAFTS + 1,
+    "front": MAX_DRAFTS + 1,
+    "meta": 1,
+}
+
+
+def slot(name: str) -> int:
+    """The tag slot of instance ``name`` (``target.<l>``, ``draft.<j>``,
+    ``tail.<f>``, ``front.<f>`` or ``meta``)."""
+    kind, _, index = name.partition(".")
+    if kind not in _BASES:
+        raise ValueError(f"unknown instance {name!r}")
+    if kind == "meta":
+        if index:
+            raise ValueError(f"unknown instance {name!r}")
+        return _BASES["meta"]
+    if not index.isdigit() or int(index) >= _COUNTS[kind]:
+        raise ValueError(f"instance {name!r}: index outside 0 .. {_COUNTS[kind] - 1}")
+    return _BASES[kind] + int(index)
+
+
+def round_instances(k: int) -> list[str]:
+    """Every instance a round with ``k`` draft tokens (0 = a plain decode
+    pass) runs, in launch order."""
+    if not 0 <= k <= MAX_DRAFTS:
+        raise ValueError(f"k = {k}")
+    out = ["meta"] + [f"target.{l}" for l in range(TARGET_LAYERS)] + ["tail.0"]
+    for j in range(k):
+        out += [f"front.{j + 1}", f"draft.{j}", f"tail.{j + 1}"]
+    return out
+
+
+def validate(names) -> dict[str, int]:
+    """``names`` -> slots; raises if two instances share a slot or a slot
+    is past ``LAYER_SLOTS - 2``."""
+    seen: dict[int, str] = {}
+    out = {}
+    for n in names:
+        s = slot(n)
+        if s > LAYER_SLOTS - 2:
+            raise ValueError(f"{n}: slot {s} > {LAYER_SLOTS - 2}")
+        if s in seen:
+            raise ValueError(f"{n} and {seen[s]} share slot {s}")
+        seen[s] = n
+        out[n] = s
+    return out
