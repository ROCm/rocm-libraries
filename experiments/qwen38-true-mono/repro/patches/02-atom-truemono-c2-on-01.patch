@@ -0,0 +1,220 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+"""``ATOM_Q38_DRAFT_VOCAB`` (N8): the drafter's argmax over a ranked vocab subset.
+
+CPU: off by default (nothing built, every head call the mono's); the ranking
+file formats; the subset rules (multiple of 128, no duplicates, ids in range,
+ascending order); on, only a DRAFT context's argmax routes to the subset, the
+target's logits and argmax never do. GPU: the subset argmax returns the token
+id of the largest subset logit (lowest id on a tie) for rows 1..16, through the
+mono's Triton head and (with the rocKE library) the rocKE fused head; where
+the full head's winner is in the subset the draft token is the full head's."""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+from torch import nn
+
+pytest.importorskip("aiter")
+
+from atom.models.qwen4_exp_mono import draft_vocab as dv
+from atom.models.qwen4_exp_mono import head as fp4
+from atom.models.qwen4_exp_mono import rocke_head
+
+N, K = 1024, 512
+
+
+def _weight(n=N, k=K, seed=0):
+    g = torch.Generator().manual_seed(seed)
+    codes = torch.randint(0, 16, (n, k), generator=g, dtype=torch.uint8)
+    codes[codes == 8] = 0
+    codes.view(n, k // 32, 32)[:, :, 0] = 7
+    scales = torch.randint(110, 135, (n, k // 32), generator=g, dtype=torch.uint8)
+    packed = codes[:, 0::2] | (codes[:, 1::2] << 4)
+    return fp4._unpack(packed, scales)
+
+
+class _Head(nn.Module):
+    def __init__(self, weight):
+        super().__init__()
+        self.weight = nn.Parameter(weight, requires_grad=False)
+        self.bias = None
+        self.tp_size = 1
+
+    def forward(self, x):
+        return ("bf16", x)
+
+    def compute_argmax_token(self, x, *, out):
+        return ("bf16-argmax", x)
+
+
+def _ctx(monkeypatch, draft):
+    ctx = SimpleNamespace(is_prefill=False, is_draft=draft)
+    monkeypatch.setattr(fp4, "get_forward_context", lambda: SimpleNamespace(context=ctx))
+    return ctx
+
+
+def _clear(monkeypatch):
+    for k in ("", "_N", "_SPEC"):
+        monkeypatch.delenv(dv.ENV + k, raising=False)
+    monkeypatch.delenv(rocke_head.ENV, raising=False)
+
+
+def test_off_by_default(monkeypatch):
+    _clear(monkeypatch)
+    assert not dv.enabled()
+    assert dv.build(torch.zeros(N, K // 2, dtype=torch.uint8), torch.zeros(N, K // 32, dtype=torch.uint8), False, 16) is None
+    model = nn.Module()
+    model.lm_head = _Head(_weight())
+    assert fp4.install_fp4_head(model, None)
+    assert model.lm_head.dv is None
+    monkeypatch.setenv(dv.ENV, "0")
+    assert not dv.enabled()
+
+
+def test_ranking_formats(tmp_path):
+    ids = [5, 3, 9, 1]
+    (tmp_path / "r.txt").write_text("# ranked\n5\n3 # second\n\n9\n1\n")
+    torch.save(torch.tensor(ids), tmp_path / "r.pt")
+    assert dv.load_ranking(str(tmp_path / "r.txt")).tolist() == ids
+    assert dv.load_ranking(str(tmp_path / "r.pt")).tolist() == ids
+    np = pytest.importorskip("numpy")
+    np.save(tmp_path / "r.npy", np.array(ids, dtype=np.int32))
+    got = dv.load_ranking(str(tmp_path / "r.npy"))
+    assert got.tolist() == ids and got.dtype == torch.int64
+
+
+def test_subset_rules():
+    r = torch.randperm(N, generator=torch.Generator().manual_seed(1))
+    s = dv.subset_ids(r, 256, N)
+    assert s.tolist() == sorted(r[:256].tolist())
+    with pytest.raises(ValueError, match="multiple of 128"):
+        dv.subset_ids(r, 200, N)
+    with pytest.raises(ValueError, match="larger than the vocab"):
+        dv.subset_ids(r, 2 * N, N)
+    with pytest.raises(ValueError, match="fewer than"):
+        dv.subset_ids(r[:128], 256, N)
+    bad = r.clone()
+    bad[3] = bad[0]
+    with pytest.raises(ValueError, match="duplicate"):
+        dv.subset_ids(bad, 256, N)
+    bad = r.clone()
+    bad[0] = N
+    with pytest.raises(ValueError, match="outside"):
+        dv.subset_ids(bad, 256, N)
+
+
+def test_routes_only_draft_argmax(monkeypatch, tmp_path):
+    _clear(monkeypatch)
+    torch.save(torch.randperm(N), tmp_path / "r.pt")
+    monkeypatch.setenv(dv.ENV, str(tmp_path / "r.pt"))
+    monkeypatch.setenv(dv.ENV + "_N", "256")
+    calls = []
+    monkeypatch.setattr(dv.DraftVocab, "argmax", lambda self, x, out: calls.append("subset") or out.fill_(7))
+    monkeypatch.setattr(fp4, "mxfp4_head", lambda x, w, s: torch.full((x.shape[0], N), 9.0))
+    monkeypatch.setattr(fp4, "mxfp4_argmax", lambda x, w, s, k, out: calls.append("full") or out.fill_(8))
+    model = nn.Module()
+    model.lm_head = _Head(_weight())
+    fp4.install_fp4_head(model, None)
+    head = model.lm_head
+    assert head.dv is not None and head.dv.n == 256 and head.dv.rk is None
+    assert torch.equal(head.dv.map.long(), torch.sort(head.dv.ids).values)
+    x = torch.zeros(4, K, dtype=torch.bfloat16)
+    out = torch.zeros(4, dtype=torch.int32)
+    _ctx(monkeypatch, draft=True)
+    assert int(head.compute_argmax_token(x, out=out)[0]) == 7
+    assert float(head(x)[0, 0]) == 9.0  # draft logits: the full head
+    _ctx(monkeypatch, draft=False)
+    assert int(head.compute_argmax_token(x, out=out)[0]) == 8
+    assert calls == ["subset", "full"]
+    # more rows than the MXFP4 head takes: the bf16 module
+    assert head.compute_argmax_token(torch.zeros(fp4.MAX_HEAD_ROWS + 1, K, dtype=torch.bfloat16), out=out)[0] == "bf16-argmax"
+
+
+def _rocke_available():
+    try:
+        import kernels.gfx950.mx_decode_gemv  # noqa: F401
+        import rocke  # noqa: F401
+    except Exception:
+        return False
+    return torch.cuda.is_available()
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="needs a GPU")
+@pytest.mark.parametrize("rocke", [False, True])
+def test_gpu_subset_argmax(monkeypatch, tmp_path, rocke):
+    if rocke and not _rocke_available():
+        pytest.skip("needs the rocKE library")
+    _clear(monkeypatch)
+    # K = 512 is one load group: dg 1
+    monkeypatch.setenv(dv.ENV + "_SPEC", '{"ctas": 8, "dg": 1}')
+    weight = _weight().cuda()
+    packed, scales = fp4.pack_exact(weight)
+    rank = torch.randperm(N, generator=torch.Generator().manual_seed(3))
+    ids = dv.subset_ids(rank, 384, N)
+    d = dv.DraftVocab(packed, scales, ids, rocke, fp4.MAX_HEAD_ROWS)
+    assert (d.rk is not None) == rocke
+    keys = fp4.argmax_keys(packed)
+    inside = 0
+    for rows in (1, 2, 3, 4, 5, 8, 16):
+        g = torch.Generator().manual_seed(rows)
+        x = torch.randn(rows, K, generator=g).to(torch.bfloat16).cuda()
+        logits = fp4.mxfp4_head(x, packed, scales).float()
+        sub = logits[:, d.ids]
+        # lowest id among the largest subset logits (ids ascending: the first)
+        want = d.ids[sub.argmax(1)].to(torch.int32)
+        out = torch.full((rows,), -1, dtype=torch.int32, device="cuda")
+        got = d.argmax(x, out)
+        assert got.data_ptr() == out.data_ptr()
+        assert torch.equal(out, want), rows
+        full = torch.empty(rows, dtype=torch.int32, device="cuda")
+        fp4.mxfp4_argmax(x, packed, scales, keys, full)
+        isin = torch.isin(full.long(), d.ids)
+        assert torch.equal(out[isin], full[isin]), rows
+        inside += int(isin.sum())
+    # a planted tie inside the subset: two subset rows with the same weights
+    lo, hi = int(d.ids[0]), int(d.ids[1])
+    p2, s2 = packed.clone(), scales.clone()
+    p2[lo], s2[lo] = p2[hi], s2[hi]
+    d2 = dv.DraftVocab(p2, s2, ids, rocke, fp4.MAX_HEAD_ROWS)
+    x = torch.zeros(1, K, dtype=torch.bfloat16, device="cuda")
+    x2 = fp4._unpack(p2[hi : hi + 1], s2[hi : hi + 1]).cuda()  # x = row hi: rows lo/hi tie at the max
+    out = torch.full((1,), -1, dtype=torch.int32, device="cuda")
+    d2.argmax(x2, out)
+    sub = fp4.mxfp4_head(x2, p2, s2).float()[0, d2.ids]
+    assert int(out[0]) == int(d2.ids[sub.argmax()])
+    del x
+
+
+@pytest.mark.skipif(not _rocke_available(), reason="needs a GPU and the rocKE library")
+@pytest.mark.parametrize("n_keep", [32768, 65536])
+def test_gpu_served_shape(monkeypatch, n_keep):
+    """The served build: K = 2560, the default subset spec (ctas 256 on top of the
+    argmax part's waves_per_eu 1), a vocab of 2 x n_keep rows; rocKE subset argmax ==
+    the subset logits' argmax for rows 1..4 and 16, and == the full head's where
+    its winner is in the subset."""
+    _clear(monkeypatch)
+    k, vocab = 2560, 2 * n_keep
+    g = torch.Generator(device="cuda").manual_seed(n_keep)
+    packed = torch.randint(0, 256, (vocab, k // 2), generator=g, device="cuda", dtype=torch.int32).to(torch.uint8)
+    scales = torch.randint(115, 128, (vocab, k // 32), generator=g, device="cuda", dtype=torch.int32).to(torch.uint8)
+    rank = torch.randperm(vocab, generator=torch.Generator().manual_seed(5))
+    ids = dv.subset_ids(rank, n_keep, vocab)
+    d = dv.DraftVocab(packed, scales, ids, True, fp4.MAX_HEAD_ROWS)
+    keys = fp4.argmax_keys(packed)
+    hits = 0
+    for rows in (1, 2, 3, 4, 16):
+        for trial in range(4):
+            x = torch.randn(rows, k, generator=g, device="cuda").to(torch.bfloat16)
+            logits = fp4.mxfp4_head(x, packed, scales).float()
+            want = d.ids[logits[:, d.ids].argmax(1)].to(torch.int32)
+            out = torch.full((rows,), -1, dtype=torch.int32, device="cuda")
+            d.argmax(x, out)
+            assert torch.equal(out, want), (rows, trial)
+            full = torch.empty(rows, dtype=torch.int32, device="cuda")
+            fp4.mxfp4_argmax(x, packed, scales, keys, full)
+            isin = torch.isin(full.long(), d.ids)
+            assert torch.equal(out[isin], full[isin]), (rows, trial)
+            hits += int(isin.sum())
+    assert hits > 0
