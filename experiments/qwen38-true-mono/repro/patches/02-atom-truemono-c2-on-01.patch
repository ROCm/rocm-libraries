+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+"""``ATOM_Q38_TRUE_MONO`` (``true_mono``, ``truemono/``): off it is the hybrid
+itself and imports nothing of the true mono; every mono layer build passes
+through the switch; the ``layer`` hook serves a provider's launcher, keeps the
+hybrid's for a refused width, a missing provider or a granularity not built
+yet (logged once each, or raising when strict); the round's tag slot plan.
+CPU only; the cases that compare with the kernels' own names need FlyDSL."""
+
+import ast
+import logging
+import os
+import pathlib
+import subprocess
+import sys
+import textwrap
+
+import pytest
+
+from atom.models.qwen4_exp_mono import true_mono
+from atom.models.qwen4_exp_mono.truemono import hook, slots
+
+PKG = pathlib.Path(true_mono.__file__).resolve().parent
+ATOM_ROOT = PKG.parents[2]
+ENVS = (true_mono.ENV, hook.PROVIDER_ENV, hook.STRICT_ENV)
+
+
+@pytest.fixture(autouse=True)
+def _clean(monkeypatch):
+    for k in ENVS:
+        monkeypatch.delenv(k, raising=False)
+    hook.reset()
+    yield
+    hook.reset()
+
+
+@pytest.fixture
+def provider(tmp_path, monkeypatch):
+    """A provider module ``wp_prov``: ``serve`` serves every request with a
+    launcher returning ("rk", variant); ``narrow`` refuses past 4 rows;
+    ``bad`` returns a non-callable."""
+    (tmp_path / "wp_prov.py").write_text(
+        textwrap.dedent(
+            """
+            CALLS = []
+
+            def serve(req, hybrid):
+                CALLS.append((req, hybrid))
+                return lambda *a, **k: ("rk", req.variant)
+
+            def narrow(req, hybrid):
+                return None if req.rows > 4 else serve(req, hybrid)
+
+            def bad(req, hybrid):
+                return 42
+
+            NOT_CALLABLE = 7
+            """
+        )
+    )
+    monkeypatch.syspath_prepend(str(tmp_path))
+    sys.modules.pop("wp_prov", None)
+    yield
+    sys.modules.pop("wp_prov", None)
+
+
+def _launch(*, kind="delta", rows=1, seq=False, group=0, where="target", hybrid=None):
+    return true_mono.layer_launcher(
+        hybrid, kind, rows, experts=512, seq=seq, group=group, where=where
+    )
+
+
+# ---------------------------------------------------------------- off
+
+
+@pytest.mark.parametrize("value", [None, "", "off", " OFF "])
+def test_off_is_the_build_itself(monkeypatch, value):
+    if value is not None:
+        monkeypatch.setenv(true_mono.ENV, value)
+    hybrid = object()
+    assert true_mono.mode() == "off"
+    for kw in ({}, {"rows": 4, "seq": True}, {"rows": 8, "group": 4}):
+        assert _launch(hybrid=hybrid, **kw) is hybrid
+    assert _launch(kind="qsa", rows=4, seq=True, where="draft", hybrid=hybrid) is hybrid
+    assert hook.ROUTES == {}
+
+
+def test_off_imports_nothing_of_the_true_mono():
+    code = (
+        "import sys, logging\n"
+        "from atom.models.qwen4_exp_mono import true_mono\n"
+        "s = object()\n"
+        "assert true_mono.layer_launcher(s, 'qsa', 4, experts=512, seq=True, where='draft') is s\n"
+        "true_mono.announce(logging.getLogger('atom'))\n"
+        "print(sorted(m for m in sys.modules if 'truemono' in m))\n"
+    )
+    env = {k: v for k, v in os.environ.items() if k not in ENVS}
+    out = subprocess.run(
+        [sys.executable, "-c", code],
+        env=env,
+        cwd=str(ATOM_ROOT),
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    assert out.stdout.strip().splitlines()[-1] == "[]"
+
+
+def test_a_bad_mode_raises(monkeypatch):
+    monkeypatch.setenv(true_mono.ENV, "pas")
+    with pytest.raises(ValueError, match="ATOM_Q38_TRUE_MONO"):
+        true_mono.mode()
+    with pytest.raises(ValueError):
+        _launch(hybrid=object())
+    with pytest.raises(ValueError):
+        true_mono.announce(logging.getLogger("atom"))
+
+
+def test_the_true_mono_is_outside_the_kernel_sources():
+    """The build keys carry the ``kernels`` package's sources only
+    (``sources.SOURCES``): the true mono's files must not be among them."""
+    from atom.mono.plan.build_key import source_digest
+
+    kernels = PKG / "kernels"
+    files = [PKG / "true_mono.py", *sorted((PKG / "truemono").rglob("*.py"))]
+    assert len(files) >= 4
+    for f in files:
+        assert kernels not in f.parents, f
+    # and the kernels package neither holds nor references any of it
+    for f in sorted(kernels.rglob("*.py")):
+        assert "true" not in f.name.lower(), f
+        text = f.read_text()
+        for word in ("true_mono", "truemono", "TRUE_MONO"):
+            assert word not in text, (f, word)
+    assert source_digest("models/qwen4_exp_mono/kernels")  # the digest still reads
+
+
+def _calls(tree, name):
+    return [
+        n
+        for n in ast.walk(tree)
+        if isinstance(n, ast.Call)
+        and (getattr(n.func, "id", None) == name or getattr(n.func, "attr", None) == name)
+    ]
+
+
+@pytest.mark.parametrize("module", ["runner.py", "group_runner.py", "draft_runner.py"])
+def test_every_layer_build_goes_through_the_switch(module):
+    """Each host-side ``build_layer`` call is the first argument of a
+    ``true_mono.layer_launcher`` call, so ``layer`` mode sees every build a
+    runner launches; nothing else in the package outside ``kernels/`` builds
+    layers."""
+    tree = ast.parse((PKG / module).read_text())
+    builds = _calls(tree, "build_layer")
+    hooked = [c.args[0] for c in _calls(tree, "layer_launcher") if c.args]
+    assert builds
+    assert all(any(b is h for h in hooked) for b in builds)
+    others = [
+        f.name
+        for f in PKG.glob("*.py")
+        if f.name not in ("runner.py", "group_runner.py", "draft_runner.py")
+        and _calls(ast.parse(f.read_text()), "build_layer")
+    ]
+    assert others == []
+
+
+# ---------------------------------------------------------------- layer
+
+
+def test_layer_mode_serves_the_provider(monkeypatch, provider):
+    monkeypatch.setenv(true_mono.ENV, "layer")
+    monkeypatch.setenv(hook.PROVIDER_ENV, "wp_prov:serve")
+    hybrid = object()
+    got = _launch(kind="delta_ple", rows=8, group=4, hybrid=hybrid)
+    assert got() == ("rk", "r8g4")
+    assert _launch(kind="qsa", rows=4, seq=True, where="draft", hybrid=hybrid)() == (
+        "rk",
+        "r4s",
+    )
+    import wp_prov
+
+    req, passed = wp_prov.CALLS[0]
+    assert passed is hybrid
+    assert (req.kind, req.rows, req.seq, req.group, req.experts, req.where) == (
+        "delta_ple",
+        8,
+        False,
+        4,
+        512,
+        "target",
+    )
+    assert hook.ROUTES == {
+        ("target", "delta_ple", "r8g4"): "provider wp_prov:serve",
+        ("draft", "qsa", "r4s"): "provider wp_prov:serve",
+    }
+
+
+def test_a_refused_width_keeps_the_hybrid_logged_once(monkeypatch, provider, caplog):
+    monkeypatch.setenv(true_mono.ENV, "layer")
+    monkeypatch.setenv(hook.PROVIDER_ENV, "wp_prov:narrow")
+    hybrid = object()
+    with caplog.at_level(logging.WARNING, logger="atom"):
+        assert _launch(rows=8, group=4, hybrid=hybrid) is hybrid
+        assert _launch(rows=8, group=4, hybrid=hybrid) is hybrid
+        assert _launch(rows=4, hybrid=hybrid)() == ("rk", "r4")
+    lines = [r.getMessage() for r in caplog.records if "true mono" in r.getMessage()]
+    assert len(lines) == 1 and "target delta r8g4" in lines[0], lines
+    assert hook.ROUTES[("target", "delta", "r8g4")].startswith("hybrid: ")
+    assert hook.ROUTES[("target", "delta", "r4")] == "provider wp_prov:narrow"
+
+
+@pytest.mark.parametrize(
+    "spec", [None, "no_such_module_xyz:provider", "wp_prov:missing", "wp_prov", "wp_prov:NOT_CALLABLE"]
+)
+def test_no_provider_keeps_the_hybrid(monkeypatch, provider, caplog, spec):
+    monkeypatch.setenv(true_mono.ENV, "layer")
+    if spec is not None:
+        monkeypatch.setenv(hook.PROVIDER_ENV, spec)
+    hybrid = object()
+    with caplog.at_level(logging.WARNING, logger="atom"):
+        for rows in (1, 2, 4):
+            assert _launch(rows=rows, hybrid=hybrid) is hybrid
+    lines = [r.getMessage() for r in caplog.records if "true mono" in r.getMessage()]
+    assert len(lines) == 1 and "no layer provider" in lines[0], lines
+
+
+def test_a_provider_returning_no_launcher_raises(monkeypatch, provider):
+    monkeypatch.setenv(true_mono.ENV, "layer")
+    monkeypatch.setenv(hook.PROVIDER_ENV, "wp_prov:bad")
+    with pytest.raises(TypeError, match="not a launcher"):
+        _launch(hybrid=object())
+
+
+# ``tail`` is built (WP4h): its layers come from the provider
+# (test_qwen4_exp_mono_truemono_tail.py)
+@pytest.mark.parametrize("mode", ["pass", "round", "loop"])
