@@ -0,0 +1,88 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+"""``ATOM_Q38_TRUE_MONO``: the switch of the true rocKE monokernel path.
+
+The true mono (``truemono/``) runs Qwen3.8-Flash-Next decode on rocKE kernels
+in place of the hybrid's FlyDSL layer launches, at a launch granularity the
+switch names:
+
+=========  ===============================================================
+``off``    the default (also the switch unset or empty): the hybrid as is
+``layer``  each layer launch a rocKE layer kernel (``layers=1``) of the
+           same ABI, from a provider (``truemono.hook``); a width the
+           provider refuses keeps the hybrid's launcher, logged
+``tail``   Path B (D0.1): ``layer``, plus the round's non-layer work
+           (final mix, head, accept, drafts, meta) from a tail provider
+           (``truemono.tail``) in ``postprocess``; a width or step the
+           tail does not take runs the hybrid's code
+``pass``   48 target layers + final mix + head + argmax in one launch
+``round``  a whole MTP round in one launch
+``loop``   the request loop on the device
+=========  ===============================================================
+
+``off``, ``layer`` and ``tail`` are built; the others are not, so every
+width keeps the hybrid's launchers, logged once.
+
+Off, nothing of the true mono is imported: :func:`layer_launcher` returns the
+hybrid's launcher object itself. Neither this file nor ``truemono/`` is under
+``kernels/``, whose sources are in every build's key (``sources.SOURCES``), so
+the hybrid's build keys and binaries do not change with them.
+
+Standard library only: the hybrid's import graph does not grow.
+"""
+
+import os
+
+ENV = "ATOM_Q38_TRUE_MONO"
+MODES = ("off", "layer", "tail", "pass", "round", "loop")
+
+
+def mode() -> str:
+    """The switch's mode (``off`` when unset or empty); raises on any other
+    value, so a typo cannot serve the hybrid unnoticed."""
+    value = os.environ.get(ENV, "").strip().lower()
+    if not value:
+        return "off"
+    if value not in MODES:
+        raise ValueError(f"{ENV}={value!r}: expected one of {', '.join(MODES)}")
+    return value
+
+
+def layer_launcher(launch, kind, rows, *, experts, seq=False, group=0, where):
+    """The launcher a mono runner uses for a ``kind`` layer build of ``rows``
+    rows (``seq`` / ``group`` as ``kernels.kernel.build_layer`` takes them):
+    ``launch`` (the hybrid's own, from ``build_layer``) when the switch is off,
+    else the true mono's choice (``truemono.hook.layer_launcher``). ``where``
+    names the runner: ``target`` (the target model's layers, single, seq and
+    grouped steps) or ``draft`` (the MTP drafter's QSA layer)."""
+    m = mode()
+    if m == "off":
+        return launch
+    from .truemono import hook
+
+    return hook.layer_launcher(
+        m, launch, kind, rows, experts=experts, seq=seq, group=group, where=where
+    )
+
+
+def tail_hook(model, atom_config):
+    """``tail`` mode: the tail hook (``truemono.tail.TailHook``) the mono decode
+    model carries for ``ModelRunner``; None in every other mode (nothing
+    imported)."""
+    if mode() != "tail":
+        return None
+    from .truemono import tail
+
+    spec = atom_config.speculative_config
+    return tail.TailHook(model, 0 if spec is None else spec.num_speculative_tokens)
+
+
+def announce(logger) -> None:
+    """Log the mode once at install when the switch is on (and fail on a bad
+    value before the first step); nothing when it is off."""
+    m = mode()
+    if m == "off":
+        return
+    from .truemono import hook
+
+    hook.announce(logger, m)
