+class _RockeSubset:
+    """rocKE fused-argmax builds of the subset head (rows <= 4 and <= max_rows)."""
+
+    def __init__(self, weight, max_rows, over, RH):
+        from kernels.gfx950 import mx_decode_gemv as M
+
+        n, kh = weight.shape
+        spec_kw = RH._spec_env("argmax")
+        spec_kw.update(over)
+        self.k = {}
+        for rows in (4, max_rows):
+            spec = M.MxDecodeGemvSpec(n=n, k=2 * kh, rows_max=rows, epilogue="fused", **spec_kw)
+            self.k[rows] = RH._Kernel(spec)
+        self.names = sorted({k.name for k in self.k.values()})
+
+    def argmax(self, x, weight, scales, out):
+        for r in sorted(self.k):
+            if x.shape[0] <= r:
+                if x.stride(-1) != 1:
+                    x = x.contiguous()
+                self.k[r](x, weight, scales, out, 0, 0)
+                return out
+        return None
