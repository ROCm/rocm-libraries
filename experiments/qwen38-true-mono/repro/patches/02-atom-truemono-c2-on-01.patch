+# ---------------------------------------------------------------- fakes
+
+
+class FakeRunnerState:
+    """A mono decode runner with prepared widths (rows)."""
+
+    def __init__(self, widths=(4,), groups=()):
+        self.widths = {w: None for w in widths}
+        self.groups = {g: None for g in groups}
+        self.counter = torch.zeros(1, dtype=torch.int32)
+
+
+class FakeModel:
+    """``MonoDecodeModel``: the lazy mono runner and ``compute_logits``."""
+
+    def __init__(self, mono=None, enabled=True):
+        self._mono = SimpleNamespace(runner=mono, enabled=enabled)
+        torch.manual_seed(0)
+        self.w = torch.randn(VOCAB, VOCAB)
+        self.logit_calls = 0
+
+    def compute_logits(self, hidden):
+        self.logit_calls += 1
+        return hidden.reshape(hidden.shape[0], -1).float() @ self.w
+
+
+class FakeModelRunner:
+    """``ModelRunner``'s parts the hybrid tail calls: a greedy sampler and
+    rejection sampler (drafts read in place from ``spec.input_ids``, as ATOM's
+    do) and a drafter whose ``propose`` scatters into its ids."""
+
+    def __init__(self, model, buf):
+        self.model = model
+        self.tokenID_processor = SimpleNamespace(input_ids=SimpleNamespace(gpu=buf))
+        self.proposed = []
+        runner = self
+
+        class Drafter:
+            def propose(self, **kw):
+                kw["target_token_ids"].scatter_(
+                    0, kw["last_token_indices"], kw["next_token_ids"]
+                )
+                runner.proposed.append(kw)
+                return torch.full((1, K), 7, dtype=torch.int32)
+
+        self.drafter = Drafter()
+
+    def _sample_tokens(self, logits, temperatures, top_ks, top_ps, all_greedy, noise):
+        assert all_greedy
+        return logits.argmax(-1).to(torch.int32)
+
+    def _verify_tokens(
+        self, logits, spec, temperatures, top_ks, top_ps, all_greedy, noise
+    ):
+        assert all_greedy
+        tgt = logits.index_select(0, spec.target_logits_indices).argmax(-1)
+        bonus = logits.index_select(0, spec.bonus_logits_indices).argmax(-1)
+        drafts = spec.input_ids[spec.target_logits_indices + 1]
+        ok = (tgt == drafts).to(torch.int64).cumprod(0)
+        accepted = int(ok.sum())
+        out = torch.full((1, K + 1), -1, dtype=torch.int32)
+        nxt = tgt[accepted : accepted + 1] if accepted < K else bonus
+        out[0, : accepted + 1] = torch.cat([tgt[:accepted], nxt]).to(torch.int32)
+        # ATOM's verdict: int32 [3, bs] = accepted drafts, rejected, anchor row
+        verdict = torch.tensor(
+            [[accepted], [K - accepted], [accepted]], dtype=torch.int32
+        )
+        return out, verdict
+
+
+def _hidden_for(targets):
+    """Hidden states whose logits' argmax per row is ``targets``."""
+    model = FakeModel()
+    w = model.w
+    rows = []
+    for t in targets:
+        # x @ w = e_t * 50 (w square, invertible)
+        y = torch.zeros(VOCAB)
+        y[t] = 50.0
+        x = torch.linalg.solve(w.T, y)
+        rows.append(x)
+    h = torch.stack(rows)
+    assert (model.compute_logits(h).argmax(-1) == torch.tensor(targets)).all()
+    return h
+
+
+def _world(
+    monkeypatch,
+    *,
+    widths=(4,),
+    running_bs=1,
+    prefill=False,
+    k=K,
+    spec=True,
+    targets=(5, 9, 3, 2),
+):
+    """A hook bound to a fake runner, and a step's arguments: ids
+    [anchor, 5, 6, 7] in one buffer, the target picks ``targets``."""
+    buf = torch.zeros(32, dtype=torch.int64)
+    buf[:4] = torch.tensor([1, 5, 6, 7])
+    model = FakeModel(FakeRunnerState(widths))
+    runner = FakeModelRunner(model, buf)
+    h = tail.TailHook(model, k)
+    h.bind(runner)
+    hidden = _hidden_for(targets)
+    md = None
+    if spec:
+        md = SimpleNamespace(
+            input_ids=buf[:4],
+            target_logits_indices=torch.tensor([0, 1, 2]),
+            bonus_logits_indices=torch.tensor([3]),
+        )
+    batch = SimpleNamespace(
+        total_seqs_num=1,
+        total_tokens_num=4,
+        is_dummy_run=False,
+        total_seqs_num_prefill=1 if prefill else 0,
+        next_token_ids=None,
+        return_logprobs=[False],
+    )
+    ctx = SimpleNamespace(
+        is_prefill=prefill, running_bs=running_bs, draft_anchor_overrides=None
+    )
+    import atom.utils.forward_context as fc
+
+    monkeypatch.setattr(fc, "get_forward_context", lambda: SimpleNamespace(context=ctx))
+    return SimpleNamespace(
+        hook=h, runner=runner, model=model, buf=buf, hidden=hidden, spec=md, batch=batch
+    )
+
+
+def _route(w, *, logits="eager", greedy=True, logprobs=False, hidden=None):
+    hidden = w.hidden if hidden is None else hidden
+    if logits == "eager":
+        logits = w.model.compute_logits(hidden)
+    return w.hook.route(
+        w.batch, w.spec, logits, hidden, greedy, logprobs, None, None, None, False
+    )
