@@ -0,0 +1,235 @@
+"""True-mono probe P16 (K=0 hop cuts): one-round-trip payload polls of the
+A2 -> B1 / Q1 and B3 / Q7 -> C1 hand-offs (``ATOM_Q38_SCHED`` ``fold.<stage>=V``;
+off by default, and off nothing here is traced).
+
+The mono waits for these two hand-offs in two phases: wave 0 spins on the
+producers' exponent pairs (each producer task's last store), the CTA barriers,
+then every thread loads its fp8 words, normally on the first try. The second
+phase is one more round trip after the data is already there, on two of the
+largest blamed hops of a K=0 delta layer (``reports/qwen38-rocke/BUBBLES.md``
+section 2: hop a2>b1, hop b3>c1). The fold polls the words and the exponents in
+ONE phase, so the hop ends one round trip after the producers' stores. The
+same words land in the same LDS slots: bitwise the mono by construction.
+
+Values (one-request builds only; ``sched.resolve`` drops the lever elsewhere):
+
+- 1: every payload thread spins on its own words (B1 / Q1: threads 0-319,
+  C1: all 512); wave 0 spins on the exponents in the same poll. The rocKE B3's
+  ``wait=barrier`` is the same idea for its own polls.
+- 2: fewer spinning waves, each lane spinning on more words in one poll: B1 /
+  Q1 wave 0 alone (10 word pairs + 2 exponents per lane, ``POLL_MAX``); C1
+  waves 0-3 (6 word pairs, wave 0 also the 3 exponents in the same poll).
+  In every value, wave 0 polls its words and the exponents in ONE poll.
+- 3: 1 only on the CTAs that reach the poll late, when the data is nearly
+  there; every other CTA waits in the mono's two phases (it would spin
+  through the whole producer stage, and 1's spinning loads then contend with
+  the producer). B1 / Q1: the CTAs holding an A2 task. C1: the C1 tasks that
+  wrapped past CTA 255 onto CTAs 0 .. ``(base + tasks) % GRID`` (they hold B3
+  tasks in every B3 variant: the mono's 192 and the rocKE B3's 48 x split, both
+  from CTA 0; in qsa layers Q-stage tasks).
+- 7 (tests only, must fail the bitwise gate): 1 with the words loaded once,
+  without waiting for their tags (the exponents still polled).
+- 9 (tests only, must fail the bitwise gate): 1 with exponent ``e`` taken from
+  pair ``e + 1`` (the last from pair 0).
+"""
+
+import flydsl.expr as fx
+from flydsl.compiler.ast_rewriter import ASTRewriter
+from flydsl.expr import gpu, range_constexpr
+
+from atom.models.qwen4_exp_mono.kernels import mailbox as mbx
+from atom.models.qwen4_exp_mono.kernels.config import DEFAULT as C
+from atom.models.qwen4_exp_mono.kernels.config import GRID
+from atom.models.qwen4_exp_mono.kernels.stages.common import task_index
+
+VALUES = (1, 2, 3, 7, 9)
+STAGES = ("b1", "q1", "c1")
+MIXED_EXPS = C.hidden // 32  # 80 exponent pairs of A2's mixed row
+MIXED_WORDS = C.hidden // 8  # 320 threads x 2 fp8 word pairs
+GATED_EXPS = C.delta_value // 32  # 192 exponent pairs of the gated output (B3 / Q7)
+
+
+def _words(specs, tag, v):
+    """The value words of ``specs``: polled, or (value 7) loaded once."""
+    if v == 7:
+        return mbx.split_values(mbx.load_pairs(specs), specs)
+    return mbx.poll(specs, tag)
+
+
+def _words_exps(wspecs, especs, tag, v):
+    """Wave 0's words and exponents in ONE poll (value 7: the exponents
+    polled, then the words loaded once)."""
+    if v == 7:
+        g = mbx.poll(especs, tag)
+        return _words(wspecs, tag, v) + g
+    return mbx.poll(wspecs + especs, tag)
+
+
+def _exp_ix(i, n, v):
+    """Pair index of exponent ``i`` of ``n`` (value 9: the next one)."""
+    if v == 9:
+        return (i + 1) % n
+    return i
+
+
+# ------------------------------------------------------------- A2 -> B1 / Q1
+
+
+def _mixed_v1(c, x8, xe, v):
+    tid, lane = c.tid, c.lane
+    n = MIXED_EXPS
+    if c.wave == 0:
+        e0 = _exp_ix(lane, n, v)
+        e1 = _exp_ix(fx.min(lane + 64, n - 1), n, v)
+        g = _words_exps([(c.mb_x8, tid * 2, 2)], [(c.mb_xe, e0, 1), (c.mb_xe, e1, 1)], c.tag, v)
+        fx.ptr_store(g[0][0], x8 + tid * 2)
+        fx.ptr_store(g[0][1], x8 + (tid * 2 + 1))
+        fx.ptr_store(g[1][0], xe + lane)
+        if lane < n - 64:
+            fx.ptr_store(g[2][0], xe + (lane + 64))
+    if (tid >= 64) & (tid < MIXED_WORDS):
+        w = _words([(c.mb_x8, tid * 2, 2)], c.tag, v)[0]
+        fx.ptr_store(w[0], x8 + tid * 2)
+        fx.ptr_store(w[1], x8 + (tid * 2 + 1))
+    gpu.barrier()
+
+
+_mixed_v1 = ASTRewriter.transform(_mixed_v1)
+
+
+def _mixed_v2(c, x8, xe):
+    lane = c.lane
+    n = MIXED_EXPS
+    k = MIXED_WORDS // 64  # 5 word pairs of 2 per lane
+    if c.wave == 0:
+        specs = [(c.mb_x8, (lane + 64 * j) * 2, 2) for j in range(k)]
+        specs += [(c.mb_xe, lane, 1), (c.mb_xe, fx.min(lane + 64, n - 1), 1)]
+        g = mbx.poll(specs, c.tag)
+        for j in range_constexpr(k):
