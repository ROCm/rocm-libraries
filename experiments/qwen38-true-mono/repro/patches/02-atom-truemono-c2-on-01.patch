+    if not enabled():
+        return None
+    n_keep = int(os.environ.get(f"{ENV}_N", DEFAULT_N))
+    ids = subset_ids(load_ranking(os.environ[ENV]), n_keep, packed.shape[0])
+    return DraftVocab(packed, scales, ids, rocke, max_rows)
