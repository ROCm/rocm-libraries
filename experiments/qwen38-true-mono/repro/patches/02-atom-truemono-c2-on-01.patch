index 0000000000000000000000000000000000000000..c0528f05877c052f92796b1bfb1a526a1ad1c4b2
--- /dev/null
+++ b/atom/models/qwen4_exp_mono/kernels/stages/xloc.py
@@ -0,0 +1,132 @@
+"""True-mono probe P16, XCD-SCHEDULING lever 1 (XCD-affine dataflow with the intra-XCD hand-off protocol) on the
+B1 -> B3 edge (``ATOM_Q38_SCHED`` ``xloc.b1=V``; off by default, and off nothing here is traced).
+
+Measured first (P16 ``p16_xpp.py``): a tagged hand-off between two CTAs of ONE XCD takes about half the round trip
+when the producer stores plainly (the line stays dirty in that XCD's L2 and the consumer's ``sc1`` poll hits it)
+instead of with the mono's ``sc1`` store (written through to the memory side). A plain store is never visible to
+another XCD (the cross-XCD arms time out), so the edge must be XCD-local by construction.
+
+B1 -> B3 is: B3 task (value head ``vh``, split ``s``) reads 6 of B1's 256 tiles of N64 (``layout.b3_tiles``): q and
+k of key head ``kh = vh // 3`` (2 tiles each) and the 2 v and 2 z tiles of ``vh``. The rocKE B3 with
+``head_map=xcd`` runs task ``t`` on CTA ``t`` (XCD ``t % 8``) for value heads ``6 x .. 6 x + 5`` of XCD ``x``,
+i.e. key heads ``2 x`` and ``2 x + 1``, whatever its split. Those heads' 32 tiles (q 4, k 4, v 12, z 12) are what
+this lever puts on the 32 CTAs of XCD ``x`` (CTA ``8 j + x`` computes tile ``T(x, j)``): every qkvz pair B3 polls is
+then produced on the B3 task's own XCD.
+
+Values (one-request delta builds; ``sched.resolve`` drops the lever elsewhere):
+
+- 1: the tile map above, and qkvz put with a plain store on every CTA whose hardware XCC id is ``bid % 8`` (the
+  dispatch the map assumes; any other CTA keeps the ``sc1`` store, which every XCD sees). Needs the extern rocKE B3
+  built with ``head_map=xcd`` (checked at trace time from its sidecar: any other B3 would poll a plain store from
+  another XCD forever, so such a build is refused).
+- 2: the tile map only (``sc1`` stores): placement without the protocol (safe with any B3).
+- 7 (tests only, must fail the bitwise gate): 1 with every tile published under its pair-neighbour's index
+  (``t ^ 1``): all tiles still published once, the values in the wrong place.
+
+B1's weights, conv channels and epilogue all follow the tile index, so a CTA computing tile ``T`` does exactly what
+the mono's CTA ``T`` does: bitwise by construction.
+"""
+
+import json
+import os
+
+import flydsl.expr as fx
+from flydsl.compiler.ast_rewriter import ASTRewriter
+
+from atom.models.qwen4_exp_mono.kernels import mailbox as mbx
+from atom.models.qwen4_exp_mono.kernels import numa
+from atom.models.qwen4_exp_mono.kernels.config import DEFAULT as C
+from atom.models.qwen4_exp_mono.kernels.config import GRID
+from atom.models.qwen4_exp_mono.kernels.stages.common import mb_ix
+
+VALUES = (1, 2, 7)
+XCDS = 8
+SLOTS = GRID // XCDS  # 32 CTAs per XCD
+KT = C.delta_key // 64  # q tiles (32), then k tiles
+V0 = 2 * KT  # first v tile (64)
+Z0 = C.delta_qkv // 64  # first z tile (160)
+HPX = C.delta_v_heads // XCDS  # value heads per XCD (6)
+GQA = C.delta_gqa  # value heads per key head (3)
+KPX = HPX // GQA  # key heads per XCD (2)
+assert 4 * KPX + 4 * HPX == SLOTS, (KPX, HPX)  # q 2 + k 2 per key head, v 2 + z 2 per value head
+assert Z0 + 2 * C.delta_v_heads == GRID
+
+
+def tile_of(bid):
+    """Host model of the tile CTA ``bid`` computes (value 1 / 2): ``T(bid % 8, bid // 8)``."""
+    x, j = bid % XCDS, bid // XCDS
+    q, k, v = 2 * KPX, 2 * KPX, 2 * HPX
+    if j < q:
+        return 2 * KPX * x + j
+    if j < q + k:
+        return KT + 2 * KPX * x + (j - q)
+    if j < q + k + v:
+        return V0 + 2 * HPX * x + (j - q - k)
+    return Z0 + 2 * HPX * x + (j - q - k - v)
+
+
+def _tile(bid):
+    x = bid & (XCDS - 1)
+    j = bid >> 3
+    q = 2 * KPX
+    v = 2 * HPX
+    t = (j < q).select(
+        2 * KPX * x + j,
+        (j < 2 * q).select(
+            KT + 2 * KPX * x + (j - q),
+            (j < 2 * q + v).select(V0 + 2 * HPX * x + (j - 2 * q), Z0 + 2 * HPX * x + (j - 2 * q - v)),
+        ),
+    )
+    return t
+
+
+def value():
+    from atom.models.qwen4_exp_mono.kernels import sched
+
+    return sched.xloc_value()
+
+
+def _check_b3(c):
+    e = getattr(c, "extern", {}).get("b3")
+    knobs = ""
+    if e is not None:
+        side = os.path.splitext(e.path)[0] + ".json"
+        if os.path.exists(side):
+            knobs = json.load(open(side)).get("stage_knobs", "")
+    if e is None or "head_map=xcd" not in knobs:
+        raise ValueError(
+            "xloc.b1=1/7 needs the extern rocKE B3 built with head_map=xcd (a plain-store qkvz would never reach a B3 "
+            f"task on another XCD); this build's B3: {getattr(e, 'path', 'FlyDSL')} {knobs!r}"
+        )
+
+
+def tile(c, t):
+    """B1's tile of this CTA: ``t`` (its task) when off, else ``T(bid)``."""
+    v = value()
+    if not v:
+        return t
+    assert c.rows == 1 and not c.group and c.L.base["b1"] == 0 and c.L.tasks["b1"] == GRID, "xloc.b1: r1 layout"
+    if v in (1, 7):
+        _check_b3(c)
+    return _tile(fx.Int32(fx.block_idx.x))
+
+
+def _put_local(c, idx, word):
+    ok = numa.xcc_id() == (fx.Int32(fx.block_idx.x) & (XCDS - 1))
+    if ok:
+        mbx.put(c.mb_qkvz, idx, word, c.tag, cm=0)
+    else:
+        mbx.put(c.mb_qkvz, idx, word, c.tag)
+
+
+_put_local = ASTRewriter.transform(_put_local)
+
+
+def put_qkvz(c, t, lane, rw, out, other):
+    """B1's qkvz put: off, exactly the mono's ``mbx.put`` (same operations in the same order)."""
+    v = value()
+    if v in (1, 7):
+        tt = (t ^ 1) if v == 7 else t
+        _put_local(c, mb_ix(tt * 32 + lane // 2, rw), mbx.bf16_pair(out, other))
+        return
+    mbx.put(c.mb_qkvz, mb_ix(t * 32 + lane // 2, rw), mbx.bf16_pair(out, other), c.tag)
diff --git a/atom/models/qwen4_exp_mono/q38_accuracy.py b/atom/models/qwen4_exp_mono/q38_accuracy.py
new file mode 100644
index 0000000000000000000000000000000000000000..e4da43f35508c13acfc34be5ea3afc4b0d6badcd
--- /dev/null
+++ b/atom/models/qwen4_exp_mono/q38_accuracy.py
@@ -0,0 +1,310 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+"""Accuracy-gate calibration hooks of the Qwen3.8 mono (true-mono P11; all off by default).
+
+- ``ATOM_Q38_PERTURB=<scope>:<scale>[:<seed>]``: a planted, deterministic
+  perturbation of the target's decode path. After each target layer launch
+  in ``<scope>`` (``all``, a layer kind ``delta`` / ``qsa`` / ``delta_ple``,
+  or layer ids ``l3+l17``), every bf16 element ``x`` of the layer's output
+  (the HC streams the next layer reads) becomes ``bf16(x * (1 + 2 s u))``
+  with ``s`` the scale (a float or ``2^-e``) and ``u`` in ``[-0.5, 0.5)`` a
+  hash of ``x``'s bits, its column, the layer id and the seed. The noise is a
+  function of the values alone: the same input gives the same output (as a
+  tolerance lever must, DESIGN 12.1 rule 2), it is captured into the decode
+  graphs like the layer launches, and scale 0 is the identity. The draft
+  layer is never perturbed. It stands in for a non-bitwise lever's drift when
+  the T2 budget is calibrated (DESIGN 12.4) and is the must-fail mutant of
+  the accuracy gates.
+- ``ATOM_Q38_TF=<dir>``: teacher forcing and per-token records on
+  non-speculative steps (K=0), one request at a time. Before each request the
+  client writes ``<dir>/cur.json`` (``{"key": str, "golden": [ids] | null,
+  "ref": path | null, "record": bool, "ref_key": str (optional)}``); on that
+  request's samples the hook
+  replaces the sampled token at generated position ``g`` with ``golden[g]``
+  (while ``g < len(golden)``) and records the step's distribution: the
+  sampled (argmax) token, the forced token, the log-probability of the forced
+  token, the top ``ATOM_Q38_TF_TOPK`` (default 64) ids and log-probabilities
+  and, when ``ref`` names a reference record of the same key, the
+  log-probabilities at the reference's top ids (NaN at positions the
+  reference does not have; ``t2_stats`` computes the KL of the coarsened
+  distributions from them). A request's record
+  is written as ``<dir>/<key>.pt`` when the next request starts.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+import re
+
+import torch
+
+logger = logging.getLogger("atom")
+
+PERTURB_ENV = "ATOM_Q38_PERTURB"
+TF_ENV = "ATOM_Q38_TF"
+_M32 = 0xFFFFFFFF
+_KINDS = ("delta", "qsa", "delta_ple")
+
+
+# ------------------------------------------------------------ perturbation
+
+
+def parse_scale(text: str) -> float:
+    """``0.01``, ``1e-3`` or ``2^-6``."""
+    m = re.fullmatch(r"2\^(-?\d+)", text.strip())
+    if m:
+        return 2.0 ** int(m.group(1))
+    v = float(text)
+    if not v >= 0:
+        raise ValueError(f"{PERTURB_ENV}: scale {text!r} must be >= 0")
+    return v
+
+
+class Perturb:
+    """``ATOM_Q38_PERTURB``'s planted noise for one runner's layers."""
+
+    def __init__(self, scope: str, scale_text: str, seed: int = 0):
+        self.scope = scope
+        self.scale_text = scale_text
+        self.scale = parse_scale(scale_text)
+        self.seed = int(seed)
+        self._salt = {}
+
+    @classmethod
+    def from_env(cls, env=None) -> "Perturb | None":
+        raw = (os.environ if env is None else env).get(PERTURB_ENV, "")
+        if not raw:
+            return None
+        parts = raw.split(":")
+        if len(parts) not in (2, 3):
+            raise ValueError(f"{PERTURB_ENV}={raw!r}: want <scope>:<scale>[:<seed>]")
+        return cls(parts[0], parts[1], int(parts[2]) if len(parts) == 3 else 0)
+
+    def layers(self, kinds) -> list[int]:
+        """The target layer ids in scope, for a model of layer ``kinds``."""
+        if self.scope == "all":
+            return list(range(len(kinds)))
+        if self.scope in _KINDS:
+            return [i for i, k in enumerate(kinds) if k == self.scope]
+        ids = []
+        for tok in self.scope.split("+"):
+            m = re.fullmatch(r"l(\d+)", tok)
+            if not m or int(m.group(1)) >= len(kinds):
+                raise ValueError(f"{PERTURB_ENV}: bad scope {self.scope!r}")
+            ids.append(int(m.group(1)))
+        return sorted(set(ids))
+
+    def describe(self, n_layers: int) -> str:
+        return (
+            f"scope={self.scope} scale={self.scale_text} ({self.scale:.6g}) "
+            f"seed={self.seed} layers={n_layers}"
+        )
+
+    def salt(self, layer: int, cols: int, device) -> torch.Tensor:
+        """int64 ``[cols]``: the per-column, per-layer, per-seed hash salt."""
+        key = (layer, cols, str(device))
+        s = self._salt.get(key)
+        if s is None:
+            c = torch.arange(cols, dtype=torch.int64)
+            s = (
+                c * 0x9E3779B1
+                + layer * 0x85EBCA6B
+                + self.seed * 0xC2B2AE35
+                + 0x165667B1
+            ) & _M32
+            s = s.to(device)
+            self._salt[key] = s
+        return s
+
+    def noise(self, x: torch.Tensor, layer: int) -> torch.Tensor:
+        """f32 ``u`` in ``[-0.5, 0.5)``, shaped as ``x`` (bf16, last dim = columns)."""
+        bits = x.view(torch.int16).to(torch.int64) & 0xFFFF
+        h = (bits * 0x2C1B3C6D + self.salt(layer, x.shape[-1], x.device)) & _M32
+        h = h ^ (h >> 15)
+        h = (h * 0x297A2D39) & _M32
+        h = h ^ (h >> 12)
+        h = (h * 0x7FEB352D) & _M32
+        h = h ^ (h >> 16)
+        return (h & 0xFFFFFF).to(torch.float32) * (1.0 / (1 << 24)) - 0.5
+
+    def apply(self, x: torch.Tensor, layer: int) -> None:
+        """``x`` (bf16) in place: ``bf16(x * (1 + 2 s u))``."""
+        if self.scale == 0.0:
+            return
+        u = self.noise(x, layer)
+        x.copy_((x.float() * (1.0 + (2.0 * self.scale) * u)).to(x.dtype))
+
+
+def install_perturb(runner) -> None:
+    """Set ``runner.perturb`` / ``runner.perturb_layers`` (None / empty when
+    ``ATOM_Q38_PERTURB`` is unset) and pre-build the salts outside any graph
+    capture."""
+    p = Perturb.from_env()
+    runner.perturb = p
+    runner.perturb_layers = frozenset()
+    if p is None:
+        return
+    ids = p.layers(runner.kinds)
+    runner.perturb_layers = frozenset(ids)
+    cols = runner.geometry.hc_width
+    for i in ids:
+        p.salt(i, cols, runner.device)
+    logger.info("Qwen3.8 mono q38 perturb on: %s", p.describe(len(ids)))
+
+
+# ------------------------------------------------------------ teacher forcing
+
+
+class TeacherForcing:
+    """``ATOM_Q38_TF``: see the module docstring. One request at a time."""
+
+    def __init__(self, out: str, topk: int | None = None):
+        self.out = out
+        os.makedirs(out, exist_ok=True)
+        self.topk = int(topk or os.environ.get("ATOM_Q38_TF_TOPK", "64"))
+        self.req = None
+        self.cur = None
+        self.prompt_len = None
+        self.rows = []
+        self.chunks = []
+        self.ref = None
+        self.warned = False
+        logger.info(
+            "Qwen3.8 mono q38 teacher forcing on: dir=%s topk=%d", out, self.topk
+        )
+
+    def _load_cur(self) -> dict:
+        path = os.path.join(self.out, "cur.json")
+        try:
+            with open(path) as f:
+                return json.load(f)
+        except (OSError, ValueError):
+            return {"key": None, "golden": None, "ref": None, "record": False}
+
+    _FIELDS = ("argmax", "token", "lp_token", "top_ids", "top_lp", "ref_lp")
+    # rows held on the device before they move to the host in one copy: a long request's records must not grow
+    # the model process's device memory (a 33K-position request ran out of memory with every row on the device)
+    SPILL_ROWS = 256
+
+    def _spill(self) -> None:
+        """Move the device rows to one host chunk (one sync per ``SPILL_ROWS`` steps)."""
+        rows, self.rows = self.rows, []
+        if not rows:
+            return
+        chunk = {"pos": torch.tensor([r["pos"] for r in rows], dtype=torch.int32)}
+        for f in self._FIELDS:
+            if all(f in r for r in rows):
+                chunk[f] = torch.stack([r[f] for r in rows]).cpu()
+        self.chunks.append(chunk)
+
+    def _reset_rows(self) -> None:
+        self.rows = []
+        self.chunks = []
+
+    def _flush(self) -> None:
+        self._spill()
+        cur, chunks = self.cur, self.chunks
+        self._reset_rows()
+        if not cur or not cur.get("record") or not chunks or not cur.get("key"):
+            return
+        rec = {
+            "key": cur["key"],
+            "prompt_len": self.prompt_len,
+            "pos": torch.cat([c["pos"] for c in chunks]),
+            "forced": cur.get("golden") is not None,
+        }
+        for f in self._FIELDS:
+            if all(f in c for c in chunks):
+                rec[f] = torch.cat([c[f] for c in chunks])
+        torch.save(rec, os.path.join(self.out, f"{cur['key']}.pt"))
+
+    def _start(self, req, prompt_len: int) -> None:
+        self._flush()
+        self.req = req
+        self.cur = self._load_cur()
+        self.prompt_len = prompt_len
+        self.ref = None
+        self.ref_row = {}
+        ref = self.cur.get("ref")
+        if ref and self.cur.get("key"):
+            # ``ref_key``: the reference record to gather at (default: the request's own key)
+            path = os.path.join(ref, f"{self.cur.get('ref_key') or self.cur['key']}.pt")
+            if os.path.exists(path):
+                self.ref = torch.load(path, map_location="cpu")
+                # position -> row of the reference, and its top ids on the device once per request
+                self.ref_row = {g: i for i, g in enumerate(self.ref["pos"].tolist())}
+                self.ref_ids = None
+
+    def step(self, batch, logits: torch.Tensor, sampled: torch.Tensor) -> torch.Tensor:
+        """The (forced) sampled tokens of a non-speculative step."""
+        if batch.total_seqs_num != 1 or getattr(batch, "is_dummy_run", False):
+            if batch.total_seqs_num > 1 and not self.warned:
+                logger.warning(
+                    "q38 teacher forcing: %d requests in a step; serve one at a time",
+                    batch.total_seqs_num,
+                )
+                self.warned = True
+            return sampled
+        req = batch.req_ids[0]
+        ctx = int(batch.context_lens[0])
+        if batch.total_tokens_num_prefill > 0:
+            # a prefill (chunk) samples generated position 0: anchor the prompt length on it (a later chunk of
+            # the same request re-anchors and drops what an earlier chunk recorded)
+            if req != self.req:
+                self._start(req, ctx)
+            else:
+                self.prompt_len = ctx
+                self._reset_rows()
+        elif req != self.req:
+            # a request first seen on a decode step is not one this hook started: leave it alone
+            return sampled
+        g = ctx - self.prompt_len
+        golden = self.cur.get("golden")
+        lp = torch.log_softmax(logits[0].float(), dim=-1)
+        token = sampled.view(-1)[0].clone()
+        out = sampled
+        if golden is not None and 0 <= g < len(golden):
+            token = torch.tensor(golden[g], dtype=sampled.dtype, device=sampled.device)
+            out = sampled.clone()
+            out.view(-1)[0] = token
+        if self.cur.get("record"):
+            top_lp, top_ids = lp.topk(self.topk)
+            row = {
+                "pos": g,
+                # the server's own greedy choice (the sampler's argmax and tie rule) before forcing
+                "argmax": sampled.view(-1)[0].to(torch.int64),
+                "token": token.to(torch.int64),
+                "lp_token": lp[token.to(torch.int64)],
+                "top_ids": top_ids.to(torch.int32),
+                "top_lp": top_lp,
+            }
+            if self.ref is not None:
+                # NaN where the reference has no row at this position
+                if self.ref_ids is None:
+                    self.ref_ids = self.ref["top_ids"].to(lp.device, torch.int64)
+                if g in self.ref_row:
+                    row["ref_lp"] = lp[self.ref_ids[self.ref_row[g]]]
+                else:
+                    row["ref_lp"] = torch.full(
+                        (self.ref["top_ids"].shape[1],), float("nan"), device=lp.device
+                    )
+            self.rows.append(row)
+            if len(self.rows) >= self.SPILL_ROWS:
+                self._spill()
+        return out
+
+
+_TF = None
+_TF_INIT = False
+
+
+def teacher_forcing() -> "TeacherForcing | None":
+    """The process's ``ATOM_Q38_TF`` hook, or None (unset)."""
+    global _TF, _TF_INIT
+    if not _TF_INIT:
+        _TF_INIT = True
+        out = os.environ.get(TF_ENV, "")
+        _TF = TeacherForcing(out) if out else None
+    return _TF
