+@pytest.fixture
+def provider(tmp_path, monkeypatch):
+    """A tail provider module ``wp_tail``: ``passthrough`` (the hybrid),
+    ``owned`` (owns the logits, computes them from the hidden states),
+    ``narrow`` (refuses more than one request), ``none`` (refuses all),
+    ``broken`` (no ``verify``), ``mutant_accept`` (one more bonus) and
+    ``mutant_alias`` (scatters the next token into the drafter's ids, then
+    reads its drafts: P9's race)."""
+    (tmp_path / "wp_tail.py").write_text(textwrap.dedent("""
+            CALLS = []
+
+            def passthrough(req, hybrid):
+                CALLS.append(req)
+                return hybrid
+
+            class Owned:
+                owns_logits = True
+
+                def __init__(self, hybrid):
+                    self.h = hybrid
+
+                def verify(self, step):
+                    assert step.logits is None or step.logits.shape[0] >= step.request.rows
+                    import dataclasses
+                    s = dataclasses.replace(step, logits=self.h.logits(step.hidden))
+                    return self.h.verify(s)
+
+                def sample(self, step):
+                    import dataclasses
+                    return self.h.sample(dataclasses.replace(step, logits=self.h.logits(step.hidden)))
+
+                def propose(self, step, **kw):
+                    return self.h.propose(step, **kw)
+
+            def owned(req, hybrid):
+                return Owned(hybrid)
+
+            def narrow(req, hybrid):
+                return None if req.requests > 1 else hybrid
+
+            def none(req, hybrid):
+                return None
+
+            def broken(req, hybrid):
+                return object()
+
+            class Wrap:
+                owns_logits = False
+
+                def __init__(self, hybrid):
+                    self.h = hybrid
+
+                def sample(self, step):
+                    return self.h.sample(step)
+
+                def propose(self, step, **kw):
+                    return self.h.propose(step, **kw)
+
+            class MutantAccept(Wrap):
+                def verify(self, step):
+                    sampled, verdict = self.h.verify(step)
+                    v = verdict.clone()
+                    v[0] = (v[0] + 1) % (step.request.k + 1)
+                    return sampled, v
+
+            class MutantAlias(Wrap):
+                def verify(self, step):
+                    sampled, verdict = self.h.verify(step)
+                    nb, anchors = verdict[0].long(), verdict[2].long()
+                    nxt = sampled.gather(1, nb.view(-1, 1)).view(-1).to(step.ids.draft.dtype)
+                    step.ids.draft.scatter_(0, anchors, nxt)  # the front's write, too early
+                    return self.h.verify(step)  # the accept reads the drafts after it
+
+            def mutant_accept(req, hybrid):
+                return MutantAccept(hybrid)
+
+            def mutant_alias(req, hybrid):
+                return MutantAlias(hybrid)
+            """))
+    monkeypatch.syspath_prepend(str(tmp_path))
+    sys.modules.pop("wp_tail", None)
+    yield
+    sys.modules.pop("wp_tail", None)
