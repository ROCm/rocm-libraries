+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+"""N8: the drafter's greedy head over a frequency-ranked vocab subset (off by default).
+
+``ATOM_Q38_DRAFT_VOCAB=<file>`` (true-mono DESIGN 12.3 N8): every DRAFT step's
+argmax head (``Mxfp4LMHead.compute_argmax_token`` with a draft forward
+context) reads only the first ``ATOM_Q38_DRAFT_VOCAB_N`` rows (default 32768)
+of a corpus-frequency ranking of the vocabulary: a re-packed copy of those rows
+of the MXFP4 head (codes + scales, 1/7.6 of its bytes at 32768), the same
+fused argmax, then one gather from subset index to token id. The target's
+heads (verify logits, prefill, K=0 decode) are untouched, so every verified
+token is the target's own: greedy verify keeps the target argmax whatever
+the drafter proposes. Only the acceptance length can change (gate: T3 of
+DESIGN 12.4, acceptance >= the hybrid's A-vs-A minimum, plus GSM8K correct).
+
+The subset rows are kept in ascending token-id order, so the "lowest index of
+the largest bf16 logit" rule over the subset picks the lowest token id among
+tied subset rows, as the full head does. When the full head's argmax is in the
+subset the draft token is bit-identical to the full head's.
+
+File: a ``.pt`` int tensor, a ``.npy`` int array, or text (one token id per
+line, ``#`` comments), most frequent first; duplicates and ids outside the
+vocab are refused. Knobs (read once at install):
+
+- ``ATOM_Q38_DRAFT_VOCAB_N``: rows kept (multiple of 128).
+- ``ATOM_Q38_DRAFT_VOCAB_SPEC``: JSON ``MxDecodeGemvSpec`` fields for the
+  rocKE subset builds (default ``{"ctas": 256}``: 2048 panels at 32768 rows,
+  8 per CTA), applied on top of the argmax part's head spec. Used only when
+  ``ATOM_Q38_ROCKE_HEAD`` is on; otherwise the mono's Triton argmax runs on
+  the subset.
+- ``ATOM_Q38_DRAFT_VOCAB_AUDIT=<n>`` (diagnostics, not for timing): every
+  draft argmax also runs the full head and counts, on the device, the rows
+  whose full-head token is in the subset and the rows where the subset token
+  equals it; logged every ``n`` eager calls (never inside a graph capture).
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+
+import torch
+
+logger = logging.getLogger("atom")
+
+ENV = "ATOM_Q38_DRAFT_VOCAB"
+DEFAULT_N = 32768
+DEFAULT_SPEC = {"ctas": 256}
+
+
+def enabled() -> bool:
+    return os.environ.get(ENV, "") not in ("", "0")
+
+
+def load_ranking(path: str) -> torch.Tensor:
+    """The ranked token ids of ``path`` (int64, most frequent first)."""
+    if path.endswith(".pt"):
+        ids = torch.as_tensor(torch.load(path, map_location="cpu"))
+    elif path.endswith(".npy"):
+        import numpy as np
+
+        ids = torch.from_numpy(np.load(path))
+    else:
+        with open(path) as f:
+            ids = torch.tensor(
+                [int(s.split("#")[0]) for s in f if s.split("#")[0].strip()]
+            )
+    return ids.to(torch.int64).flatten()
+
+
+def subset_ids(ranking: torch.Tensor, n_keep: int, vocab: int) -> torch.Tensor:
+    """The first ``n_keep`` ids of ``ranking`` in ascending order (int64)."""
+    if n_keep <= 0 or n_keep % 128:
+        raise ValueError(f"{ENV}_N must be a positive multiple of 128, got {n_keep}")
+    if n_keep > vocab:
+        raise ValueError(f"{ENV}_N={n_keep} is larger than the vocab ({vocab})")
+    if ranking.numel() < n_keep:
+        raise ValueError(f"{ENV}: the ranking has {ranking.numel()} ids, fewer than {n_keep}")
+    top = ranking[:n_keep]
+    if int(top.min()) < 0 or int(top.max()) >= vocab:
+        raise ValueError(f"{ENV}: token id outside [0, {vocab})")
+    if torch.unique(top).numel() != n_keep:
+        raise ValueError(f"{ENV}: duplicate token ids in the first {n_keep}")
+    return torch.sort(top).values
+
+
+class DraftVocab:
+    """The subset head: packed rows, the id map and the argmax launches."""
+
+    def __init__(self, packed: torch.Tensor, scales: torch.Tensor, ids: torch.Tensor, rocke: bool, max_rows: int):
+        from . import head as fp4
+
+        dev = packed.device
+        self.ids = ids.to(dev)
+        self.map = self.ids.to(torch.int32)
+        self.weight = packed.index_select(0, self.ids).contiguous()
+        self.scales = scales.index_select(0, self.ids).contiguous()
+        self.n = self.weight.shape[0]
+        self.vocab = packed.shape[0]
+        self.keys = fp4.argmax_keys(self.weight)
+        self.tmp = torch.empty(max_rows, dtype=torch.int32, device=dev)
+        self.rk = None
+        self.audit = int(os.environ.get(f"{ENV}_AUDIT", "0") or 0)
+        if self.audit:
+            self.insub = torch.zeros(self.vocab, dtype=torch.bool, device=dev)
+            self.insub[self.ids] = True
+            self.full = torch.empty(max_rows, dtype=torch.int32, device=dev)
+            self.fullkeys = fp4.argmax_keys(packed)
+            self.packed, self.packed_s = packed, scales
+            self.counts = torch.zeros(3, dtype=torch.int64, device=dev)  # rows, full in subset, equal
+            self.calls = 0
+        if rocke:
+            from . import rocke_head
+
+            spec = dict(DEFAULT_SPEC)
+            raw = os.environ.get(f"{ENV}_SPEC")
+            if raw:
+                spec.update(json.loads(raw))
+            self.rk = _RockeSubset(self.weight, max_rows, spec, rocke_head)
+        logger.info(
+            "Qwen3.8 mono draft vocab subset on: %d of %d rows (%.0f MB), argmax by %s",
+            self.n,
+            self.vocab,
+            (self.weight.numel() + self.scales.numel()) / 1e6,
+            "rocKE " + ", ".join(self.rk.names) if self.rk else "the mono's Triton head",
+        )
+
+    def argmax(self, x: torch.Tensor, out: torch.Tensor) -> torch.Tensor:
+        """``out`` (int32 [M]): the token id of each row's subset argmax."""
+        from . import head as fp4
+
+        m = x.shape[0]
+        tmp = self.tmp[:m]
+        got = None
+        if self.rk is not None:
+            got = self.rk.argmax(x, self.weight, self.scales, tmp)
+        if got is None:
+            fp4.mxfp4_argmax(x, self.weight, self.scales, self.keys, tmp)
+        torch.index_select(self.map, 0, tmp, out=out)
+        if self.audit:
+            self._audit(x, out)
+        return out
+
+    def _audit(self, x, out):
+        from . import head as fp4
+
+        m = x.shape[0]
+        full = self.full[:m]
+        fp4.mxfp4_argmax(x, self.packed, self.packed_s, self.fullkeys, full)
+        self.counts[0] += m
+        self.counts[1] += self.insub[full.long()].sum()
+        self.counts[2] += (full == out).sum()
