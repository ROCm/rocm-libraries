@@ -0,0 +1,513 @@
+"""True-mono probe P13 / lever N4a: the QSA layer dense under the index budget
+(``ATOM_Q38_SCHED`` ``qdense=V``; off by default, and off nothing here is
+traced).
+
+While a request row's complete index blocks fit the budget (``cb <= SEL``,
+i.e. ``L + 1 <= 2048``), Q4 takes every block, so the selected SET is fixed;
+the mono still ranks it by Q3's scores (``qsa_fast._final`` then ``_rank``)
+and Q5-Q7 run over the list in that rank order. Here such a row's list is in
+position order (list slot ``j`` = block ``j``). That moves Q6's denominator
+and Q7's PV sums to another summation order (tolerance class, P13) and removes
+hops from the chain:
+
+- 1: Q4's final task publishes the position order at once (no wait on Q3's
+  hints, no selection, no sort); Q3 unchanged.
+- 2: 1, and Q3 skips the index query and every score of such a row: it still
+  keys the block the row completes and writes that key to ``index_cmp`` (later
+  steps' cached scores), with the mono's code (:func:`qsa_fast._block_key`).
+- 3: 2, and Q5 / Q7 take block ``j`` for list slot ``j`` themselves: no poll
+  of ``sel`` / ``selh``; Q4 idles on such rows.
+- 8 / 9 (tests only; they must fail the tolerance gate): 3 / 1 with list slot
+  0 taking block 1 (block 0 dropped, block 1 twice).
+
+Rows above the budget run the mono's code unchanged (a runtime branch per
+request row), so a build with the lever on is bitwise equal to the mono
+there. Narrow ungrouped QSA builds only (``sched.resolve`` drops the lever
+elsewhere). :func:`_q5d` / :func:`_q7d` are ``qsa._q5`` / ``qsa._q7`` with
+only the selected-list reads changed.
+"""
+
+import flydsl.expr as fx
+from flydsl.compiler.ast_rewriter import ASTRewriter
+from flydsl.expr import const_expr, gpu, range_constexpr
+from flydsl.expr import math as fmath
+from flydsl.expr.typing import T
+
+from atom.models.qwen4_exp_mono.kernels import buffer_ops as bo
+from atom.models.qwen4_exp_mono.kernels import mailbox as mbx
+from atom.models.qwen4_exp_mono.kernels import p2
+from atom.models.qwen4_exp_mono.kernels.config import DEFAULT as C
+from atom.models.qwen4_exp_mono.kernels.config import GRID, THREADS
+from atom.models.qwen4_exp_mono.kernels.device_ops import rsrc, xred, xshfl
+from atom.models.qwen4_exp_mono.kernels.layout import (
+    K_STRIDE,
+    SCORE_TILE,
+    SS_ROW,
+    TASKS,
+    WAVES,
+)
+from atom.models.qwen4_exp_mono.kernels.stages import qsa_fast
+from atom.models.qwen4_exp_mono.kernels.stages.common import (
+    add,
+    bf16r,
+    bf16x8,
+    mb_ix,
+    task_index,
+    task_rounds,
+)
+from atom.models.qwen4_exp_mono.kernels.stages.hc import fma, sigmoid_acc
+from atom.models.qwen4_exp_mono.kernels.stages.qsa import (
+    GROUP,
+    HEAD_WORDS,
+    INDEX_WORDS,
+    NEG_MAX,
+    P_IK,
+    P_Q,
+    P_V,
+    PP_ROW,
+    Q7_HEADS,
+    Q7_ROUNDS,
+    QN_SEQ,
+    QN_SPECS,
+    ROPE_WORDS,
+    SCALE,
+    SEL,
+    SELH_FROM_QN,
+    _cache_row,
+    _f32,
+    _lds_i4,
+    _now_rows,
+    _request,
+    list_len,
+    page_block,
+    qsa_row,
+    row_len,
+    unpack,
+    word,
+)
+
+VALUES = (1, 2, 3, 8, 9)
+Q3_KEY_ONLY = (2, 3, 8)  # Q3 of an under-budget row: the completing block's key only
+Q4_PUBLISH = (1, 2, 9)  # Q4 of an under-budget row: the position order, at once
+DIRECT = (3, 8)  # Q5 / Q7 of an under-budget row: block j for slot j, no sel poll
+MUTANT = (8, 9)  # slot 0 takes block 1
+_STAGES = {"q3": Q3_KEY_ONLY, "q4": Q4_PUBLISH + DIRECT, "q5": DIRECT, "q7": DIRECT}
+
+
+def mode(c):
+    """The build's ``qdense`` value (0: off)."""
+    return getattr(c, "qdense", 0)
+
+
+def on(c, stage):
+    """Whether ``stage`` runs this module's code (trace time)."""
+    return mode(c) in _STAGES.get(stage, ())
+
+
+def _blk(c, j, cb):
+    """The block of list slot ``j`` of an under-budget row: ``j`` (the
+    mutants: block 1 at slot 0)."""
+    if const_expr(mode(c) in MUTANT):
+        return j + ((j == 0) & (cb > 1)).select(fx.Int32(1), fx.Int32(0))
+    return j
+
+
+# ------------------------------------------------------------------ Q3
+
+
+def _q3_key(c, p, t, rq, tq, per, L, cb):
+    """An under-budget row's Q3 task: only the wave holding the block one of
+    the launch's rows completes keys it (``qsa_fast.q3``'s code for that
+    block, from the same raw rows) and, on the row that completes it, writes
+    it to ``index_cmp``. No index query, no score, no hint (Q4 does not wait
+    on Q3 for such a row)."""
+    lane, wave = c.lane, c.wave
+    a_pages = qsa_row(p, rq, "pages")
+    a_index_key = qsa_row(p, rq, "index_key")
+    a_index_cmp = qsa_row(p, rq, "index_cmp")
+    a_cos = qsa_row(p, rq, "cos")
+    a_sin = qsa_row(p, rq, "sin")
+    first = tq * WAVES + wave
+    nc = L // 4
+    if const_expr(c.seq):
+        nc = p.Ls[0] // 4
+    b = nc + first
+    if (t < c.L.tasks["q3"]) & (b < cb) & (4 * b + 3 == L):
+        r_pg = rsrc(a_pages)
+        r_ik = rsrc(a_index_key)
+        r_cmp = rsrc(a_index_cmp)
+        rope_word = fx.min(lane, ROPE_WORDS - 1)
+        wk = unpack([word(rsrc(p.a_ik_norm), lane)])
+        g = page_block(r_pg, b, True)
+        kws = [word(r_ik, (4 * g + r) * INDEX_WORDS + lane) for r in range(4)]
+        at = 4 * b * ROPE_WORDS + rope_word
+        kc, ks = word(rsrc(a_cos), at), word(rsrc(a_sin), at)
+        if const_expr(c.seq):
+            got = mbx.poll(
+                [(c.mb_qp, mb_ix(P_IK + lane, q), 1) for q in range(c.rows)], c.tag
+            )
+            iks = [v[0] for v in got]
+        else:
+            ik = mbx.poll([(c.mb_qp, mb_ix(P_IK + lane, rq), 1)], c.tag)[0][0]
+        raw = []
+        for r in range_constexpr(4):
+            row = 4 * b + r
+            kw = kws[r]
+            if const_expr(c.seq):
+                for s in range_constexpr(c.rows):
+                    kw = (row == p.Ls[s]).select(iks[s], kw)
+                raw.append(unpack([fx.Int32(kw)]))
+            else:
+                raw.append(unpack([fx.Int32((row == L).select(ik, kw))]))
+        kn = qsa_fast._block_key(raw, wk, kc, ks, lane)
+        bo.buffer_store(mbx.bf16_pair(kn[0], kn[1]), r_cmp, g * INDEX_WORDS + lane)
+
+
+_q3_key = ASTRewriter.transform(_q3_key)
+
+
+def q3(c, p):
+    t = task_index(c, "q3")
+    per = c.L.tasks["q3"] // c.rows
+    rq, tq = _request(c, t, per)
+    L = row_len(p, rq)
+    cb = (L + 1) // 4
+    if cb <= SEL:
+        _q3_key(c, p, t, rq, tq, per, L, cb)
+    else:
+        qsa_fast.q3(c, p)
+
+
+q3 = ASTRewriter.transform(q3)
+
+
+# ------------------------------------------------------------------ Q4
+
+
+def _publish(c, cb, rq):
+    """The position order to ``sel`` (slots ``0 .. cb - 1``), then ``selh``:
+    ``qsa_fast._rank``'s puts without the sort."""
+    tid = fx.Int32(c.tid)
+    if tid < cb:
+        mbx.put(c.mb_sel, mb_ix(tid, rq), _blk(c, tid, cb), c.tag)
+    gpu.barrier()
+    if tid == 0:
+        mbx.put(c.mb_selh, mb_ix(0, rq), 1, c.tag)
+
+
+_publish = ASTRewriter.transform(_publish)
+
+
+def q4(c, p):
+    t = task_index(c, "q4")
+    rq, j = _request(c, t, qsa_fast.Q4_TASKS)
+    L = row_len(p, rq)
+    if t < c.L.tasks["q4"]:
+        cb = (L + 1) // 4
+        if cb <= SEL:
+            if const_expr(mode(c) in Q4_PUBLISH):
+                if j == qsa_fast.CHUNKS:
+                    _publish(c, cb, rq)
+        else:
+            qsa_fast.q4(c, p)
+
+
+q4 = ASTRewriter.transform(q4)
+
+
+# ------------------------------------------------------------------ Q5
+
+
+def _q5d(c, p, tid, t, turn):
+    qs = c.lds_i + c.L.lds["q5_q"]
+    ks = c.lds_i + c.L.lds["q5_k"]
+    sl = c.lds_i + c.L.lds["q5_sel"]
+    rq = 0 if c.rows == 1 else (t // 2 + turn) % c.rows
+    L = row_len(p, rq)
+    a_pages = qsa_row(p, rq, "pages")
+    a_key = qsa_row(p, rq, "key")
+
+    if t < c.L.tasks["q5"]:
+        kv = t % 2
+        tile = t // 2 if c.rows == 1 else t // (2 * c.rows)
+        cb, n, ak = list_len(L)
+        if tile * SCORE_TILE < ak:
+            r_pg = rsrc(a_pages)
+            tail, now_row = _now_rows(p, r_pg, L, c.seq)
+
+            def hint(m):
+                head = (m < GROUP).select(GROUP * kv + m, C.q_heads + kv)
+                return c.mb_qn, mb_ix(
+                    (m <= GROUP).select(HEAD_WORDS * head, fx.Int32(SELH_FROM_QN)), rq
+                )
+
+            def hint_seq(m):
+                head = (m < GROUP).select(GROUP * kv + m, C.q_heads + kv)
+                kq = (m < GROUP).select(rq, fx.min(fx.max(m - GROUP, 0), c.rows - 1))
+                return c.mb_qn, (m < GROUP + c.rows).select(
+                    mb_ix(HEAD_WORDS * head, kq), mb_ix(SELH_FROM_QN, rq)
+                )
+
+            # An under-budget row: the q heads and k head(s) only (no selh).
+            if cb <= SEL:
+                if const_expr(c.seq):
+                    mbx.pre_poll(hint_seq, GROUP + c.rows, c.tag)
+                else:
+                    mbx.pre_poll(hint, GROUP + 1, c.tag)
+            else:
+                if const_expr(c.seq):
+                    mbx.pre_poll(hint_seq, GROUP + c.rows + 1, c.tag)
+                else:
+                    mbx.pre_poll(hint, GROUP + 2, c.tag)
+            if (tid < SCORE_TILE // 4) & (tile * (SCORE_TILE // 4) + tid < n):
+                jb = tile * (SCORE_TILE // 4) + tid
+                if cb <= SEL:
+                    fx.ptr_store(page_block(r_pg, _blk(c, jb, cb)), sl + tid)
+                else:
+                    b = mbx.poll([(c.mb_sel, mb_ix(jb, rq), 1)], c.tag)[0][0]
+                    fx.ptr_store(page_block(r_pg, b), sl + tid)
+            specs, dst = [], []
+            for r in range_constexpr(2):
+                s = fx.min(
+                    tid + THREADS * r, (QN_SEQ[c.rows] if c.seq else QN_SPECS) - 1
+                )
+                hh = s // (HEAD_WORDS // 2)
+                w = 2 * (s % (HEAD_WORDS // 2))
+                head = (hh < GROUP).select(GROUP * kv + hh, C.q_heads + kv)
+                if const_expr(c.seq):
+                    qn_at = mb_ix(
+                        head * HEAD_WORDS + w, (hh < GROUP).select(rq, hh - GROUP)
+                    )
+                else:
+                    qn_at = mb_ix(head * HEAD_WORDS + w, rq)
+                specs.append((c.mb_qn, qn_at, 2))
+                dst.append(hh * HEAD_WORDS + w)
+            got = mbx.poll(specs, c.tag)
+            for r in range_constexpr(2):
+                fx.ptr_store(fx.Vector.from_elements(got[r], fx.Int32), qs + dst[r])
+            gpu.barrier()
+
+            r_k = rsrc(a_key)
+            quad = tid % 32
+            if const_expr(c.seq):
+                curs = [
+                    _lds_i4(qs, (GROUP + q) * HEAD_WORDS + 4 * quad)
+                    for q in range(c.rows)
+                ]
+            else:
+                cur = _lds_i4(qs, GROUP * HEAD_WORDS + 4 * quad)
+            for r in range_constexpr(2):
+                row = tid // 32 + 16 * r
+                kr = _cache_row(
+                    fx.ptr_load(sl + row // 4), tile * SCORE_TILE + row, n, ak, tail
+                )
+                at = (kr * C.kv_heads + kv) * HEAD_WORDS + 4 * quad
+                kw = fx.Vector(bo.buffer_load(r_k, at, vec_width=4, dtype=T.i32))
+                if const_expr(c.seq):
+                    w4 = [kw[e] for e in range(4)]
+                    for q in range_constexpr(c.rows):
+                        hit = kr == now_row[q]
+                        w4 = [fx.Int32(hit.select(curs[q][e], w4[e])) for e in range(4)]
+                else:
+                    now = kr == now_row
+                    w4 = [fx.Int32(now.select(cur[e], kw[e])) for e in range(4)]
+                fx.ptr_store(
+                    fx.Vector.from_elements(w4, fx.Int32),
+                    ks + (row * K_STRIDE + 4 * quad),
+                )
+            gpu.barrier()
+
+            if tid < GROUP * SCORE_TILE:
+                h = tid // SCORE_TILE
+                i = tid % SCORE_TILE
+                acc = fx.Float32(0.0)
+                for d in range_constexpr(HEAD_WORDS // 4):
+                    qf = bf16x8(_lds_i4(qs, h * HEAD_WORDS + 4 * d))
+                    kf = bf16x8(_lds_i4(ks, i * K_STRIDE + 4 * d))
+                    for e in range_constexpr(8):
+                        acc = fma(qf[e], kf[e], acc)
+                j = tile * SCORE_TILE + i
+                score = (j < ak).select(acc * _f32(SCALE), fx.Float32(NEG_MAX))
+                other = xshfl(score, 1)
+                if i % 2 == 0:
+                    mbx.put2(
+                        c.mb_ss,
+                        mb_ix((GROUP * kv + h) * SS_ROW + j, rq),
+                        score,
+                        other,
+                        c.tag,
+                    )
+            gpu.barrier()
+            if tid == 0:
+                mbx.put(
+                    c.mb_ssh, mb_ix(2 * tile + kv, rq) if c.rows > 1 else t, 1, c.tag
+                )
+
+
+_q5d = ASTRewriter.transform(_q5d)
+
+
+def q5(c, p):
+    tid = fx.Int32(c.tid)
+    t = task_index(c, "q5")
+    turn = 0 if c.seq or GRID % (2 * c.rows) else 1
+    for k in range_constexpr(task_rounds(c, "q5")):
+        _q5d(c, p, tid, t if k == 0 else t + k * GRID, k * turn % c.rows)
+
+
+# ------------------------------------------------------------------ Q7
+
+
+def _q7d(c, p, tid, lane, wave, t):
+    sl = c.lds_i + c.L.lds["q7_sel"]
+    pb = c.lds_f + c.L.lds["q7_p"]
+    cur = c.lds_i + c.L.lds["q7_cur"]
+    part = c.lds_f + c.L.lds["q7_part"]
+    rq, x = _request(c, t, TASKS["q7"])
+    L = row_len(p, rq)
+    a_pages = qsa_row(p, rq, "pages")
+    a_value = qsa_row(p, rq, "value")
+
+    if t < c.L.tasks["q7"]:
+        dt = x % 8
+        kv = x // 24
+        qh0 = GROUP * kv + Q7_HEADS * ((x // 8) % 3)
+        cb, n, ak = list_len(L)
+        r_pg = rsrc(a_pages)
+        tail, now_row = _now_rows(p, r_pg, L, c.seq)
+        nt = (ak + SCORE_TILE - 1) // SCORE_TILE
+        own = tid % 128
+        hd = own // 32
+        dim = own % 32
+
+        # An under-budget row: slot j is block j (no selh, no sel poll).
+        if cb <= SEL:
+            if tid < n:
+                fx.ptr_store(page_block(r_pg, _blk(c, tid, cb)), sl + tid)
+        else:
+            mbx.pre_poll(lambda m: (c.mb_selh, mb_ix(0, rq)), 1, c.tag)
+            if tid < n:
+                b = mbx.poll([(c.mb_sel, mb_ix(tid, rq), 1)], c.tag)[0][0]
+                fx.ptr_store(page_block(r_pg, b), sl + tid)
+        if const_expr(c.seq):
+            ct = fx.min(tid, 8 * c.rows - 1)
+            cur_at = P_V + HEAD_WORDS * kv + 16 * dt + 2 * (ct % 8)
+            cur_row = ct // 8
+        else:
+            cur_at = P_V + HEAD_WORDS * kv + 16 * dt + 2 * fx.min(tid, 7)
+            cur_row = rq
