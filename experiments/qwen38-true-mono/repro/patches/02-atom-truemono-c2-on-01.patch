new file mode 100644
index 0000000000000000000000000000000000000000..a0fa237c6ca66052c8f0e43ec1bb804edc4a1db9
--- /dev/null
+++ b/tests/test_qwen4_exp_mono_rb_devmeta.py
@@ -0,0 +1,169 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+"""rb_devmeta's device shift (ATOM_Q38_RB_DEVMETA) against the host formulas of a decode step's metadata.
+
+GPU test (skipped without a GPU / Triton). The host builds the step at full acceptance (r = 0, bonus = K) for carried-
+over requests; the kernel must leave exactly what ``aiter_attention.prepare_decode`` / ``_build_mrope_decode_positions``
+/ ``_build_qsa_metadata`` / ``prepare_num_accepted_tokens`` would have written with the true counts. Mutants must fail.
+"""
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+if not torch.cuda.is_available():
+    pytest.skip("needs a GPU", allow_module_level=True)
+pytest.importorskip("triton")
+
+import atom.models.qwen4_exp_mono.truemono.rb_devmeta as rb  # noqa: E402
+
+
+def _host(ctx_ub, r, b, q, bt, slot_block, kv_block, deltas, running_bs, acc_new):
+    bs = len(ctx_ub)
+    ctx = ctx_ub - r
+    pos = (ctx - q)[:, None] + np.arange(q)[None, :]
+    slot = bt[np.arange(bs)[:, None], pos // slot_block].astype(np.int64) * slot_block + pos % slot_block
+    kvp = np.zeros(running_bs + 1, np.int64)
+    kvp[1 : bs + 1] = np.cumsum((ctx + kv_block - 1) // kv_block)
+    kvp[bs + 1 :] = kvp[bs]
+    mr = np.stack([(pos + deltas[:, None]).reshape(-1)] * 3)
+    acc = np.where(acc_new >= 0, acc_new, b + 1)
+    return ctx, pos.reshape(-1), slot.reshape(-1), kvp, mr, acc
+
+
+@pytest.mark.parametrize("seed", range(6))
+@pytest.mark.parametrize("mut", ["", "nofix", "slot", "acc", "pos", "comp"])
+def test_shift(seed, mut, monkeypatch):
+    rng = np.random.default_rng(seed)
+    K, q, slot_block, kv_block = 3, 4, 16, 16
+    bs = int(rng.integers(1, 5))
+    running_bs = bs + int(rng.integers(0, 3))
+    prev_bs = bs + int(rng.integers(0, 2))
+    src = rng.permutation(prev_bs)[:bs].astype(np.int32)
+    if bs > 1 and seed % 2:
+        src[-1] = -1  # a request new to the step keeps the host values
+    r_prev = rng.integers(0, K + 1, prev_bs).astype(np.int32)
+    b_prev = (K - r_prev).astype(np.int32)
+    r = np.where(src >= 0, r_prev[np.maximum(src, 0)], 0)
+    b = np.where(src >= 0, b_prev[np.maximum(src, 0)], 0)
+    acc_new = np.where(src >= 0, -1, 1)
+    ctx_ub = rng.integers(40, 900, bs).astype(np.int32)
+    nblk = 64
+    bt = np.zeros((running_bs, nblk), np.int32)
+    for i in range(bs):
+        bt[i] = rng.permutation(4096)[:nblk]
+    deltas = rng.integers(0, 5, bs)
+    T = running_bs * q
+    # host staging at full acceptance (what prepare_decode writes in rb mode)
+    c0, p0, s0, k0, m0, _ = _host(ctx_ub, np.zeros(bs, np.int64), b, q, bt, slot_block, kv_block, deltas, running_bs, acc_new)
+    acc0 = np.where(src >= 0, K + 1, 1)
+    # expected: the true counts
+    c1, p1, s1, k1, m1, a1 = _host(ctx_ub, r, b, q, bt, slot_block, kv_block, deltas, running_bs, acc_new)
+    dev = lambda a, dt: torch.tensor(np.asarray(a), dtype=dt, device="cuda")  # noqa: E731
+    ctx = dev(np.concatenate([c0, np.zeros(running_bs - bs)]), torch.int32)
+    mrope = torch.zeros(3, T, dtype=torch.int64, device="cuda")
+    mrope[:, : bs * q] = dev(m0, torch.int64)
+    pos = torch.zeros(T, dtype=torch.int64, device="cuda")
+    logical = torch.full((T,), -1, dtype=torch.int32, device="cuda")
+    logical[: bs * q] = dev(p0, torch.int32)
+    slot = torch.full((T,), -1, dtype=torch.int64, device="cuda")
+    slot[: bs * q] = dev(s0, torch.int64)
+    acc = dev(np.concatenate([acc0, np.ones(running_bs - bs)]), torch.int32)
+    kvp = dev(k0, torch.int32)
+    ratio = 4
+    comp_rule = lambda pos, slot: np.where(((pos + 1) % ratio == 0) & (slot >= 0), slot // ratio, -1)  # noqa: E731
+    comp = torch.full((T,), -1, dtype=torch.int64, device="cuda")
+    comp[: bs * q] = dev(comp_rule(p0, s0), torch.int64)
+    st_ctx = torch.zeros(running_bs, dtype=torch.int64, device="cuda")
+    st_delta = torch.zeros(running_bs, dtype=torch.int64, device="cuda")
+    rb._fix_kernel[(1,)](
+        dev(r_prev, torch.int32), dev(b_prev, torch.int32), dev(src, torch.int32), ctx, mrope.reshape(-1), pos,
+        logical, slot, dev(bt, torch.int32), acc, kvp, comp, st_ctx, st_delta, bs, running_bs, q, T, nblk, slot_block,
+        kv_block, ratio, HAS_MROPE=True, FUSE_COMP=True, HAS_POS=False, MUT_SLOT=mut == "slot", MUT_ACC=mut == "acc",
+        MUT_POS=mut == "pos", MUT_COMP=mut == "comp", ADVANCE=False, MUT_ADV=False, QB=4, PB=64,
+    ) if mut != "nofix" else None
+    torch.cuda.synchronize()
+    ok = (
+        np.array_equal(ctx.cpu().numpy()[:bs], c1)
+        and np.array_equal(mrope.cpu().numpy()[:, : bs * q], m1)
+        and np.array_equal(logical.cpu().numpy()[: bs * q], p1)
+        and np.array_equal(slot.cpu().numpy()[: bs * q], s1)
+        and np.array_equal(kvp.cpu().numpy(), k1)
+        and np.array_equal(acc.cpu().numpy()[:bs], a1)
+        and np.array_equal(comp.cpu().numpy()[: bs * q], comp_rule(p1, s1))
+        and bool((comp[bs * q :] == -1).all())
+        and bool((logical[bs * q :] == -1).all())
+        and bool((slot[bs * q :] == -1).all())
+    )
+    if not mut:
+        assert ok
+        # the state the steady-state advance starts from: the true length and the mRoPE offset
+        assert np.array_equal(st_ctx.cpu().numpy()[:bs], c1)
+        assert np.array_equal(st_delta.cpu().numpy()[:bs], deltas)
+    elif mut == "comp" and (comp_rule(p1, s1) >= 0).any():
+        assert not ok, "mutant comp not caught"
+    elif mut != "comp" and (r.any() or mut in ("acc",) and (src >= 0).any()):
+        assert not ok, f"mutant {mut} not caught"
+
+
+@pytest.mark.parametrize("seed", range(6))
+@pytest.mark.parametrize("mut", ["", "adv"])
+def test_advance(seed, mut):
+    """Steady state: no uploads; round t+1 from round t's true length + q - r (decode_src = arange)."""
+    rng = np.random.default_rng(100 + seed)
+    K, q, slot_block, kv_block, ratio = 3, 4, 16, 16, 4
+    bs = int(rng.integers(1, 5))
+    running_bs = bs + int(rng.integers(0, 3))
+    T = running_bs * q
+    nblk = 96
+    bt = np.zeros((running_bs, nblk), np.int32)
+    for i in range(bs):
+        bt[i] = rng.permutation(4096)[:nblk]
+    deltas = rng.integers(0, 5, bs)
+    ctx_prev = rng.integers(40, 900, bs).astype(np.int64)  # round t's true lengths (the state)
+    r = rng.integers(0, K + 1, bs).astype(np.int32)
+    b = (K - r).astype(np.int32)
+    src = np.arange(bs, dtype=np.int32)
+    c2 = ctx_prev + q - r
+    c, p, s_, k, m, a = _host(c2, np.zeros(bs, np.int64), b, q, bt, slot_block, kv_block, deltas, running_bs,
+                              np.full(bs, -1))
+    dev = lambda x, dt: torch.tensor(np.asarray(x), dtype=dt, device="cuda")  # noqa: E731
+    junk = lambda n, dt: torch.full((n,), 12345, dtype=dt, device="cuda")  # noqa: E731
+    ctx = dev(np.concatenate([np.full(bs, 777), np.zeros(running_bs - bs)]), torch.int32)  # stale (not uploaded)
+    mrope = torch.full((3, T), 999, dtype=torch.int64, device="cuda")
+    mrope[:, bs * q :] = 0
+    pos = torch.zeros(T, dtype=torch.int64, device="cuda")
+    logical = junk(T, torch.int32)
+    logical[bs * q :] = -1
+    slot = junk(T, torch.int64)
+    slot[bs * q :] = -1
+    comp = junk(T, torch.int64)
+    comp[bs * q :] = -1
+    acc = dev(np.concatenate([np.full(bs, K + 1), np.ones(running_bs - bs)]), torch.int32)
+    kvp = torch.zeros(running_bs + 1, dtype=torch.int32, device="cuda")
+    st_ctx = torch.zeros(running_bs, dtype=torch.int64, device="cuda")
+    st_ctx[:bs] = dev(ctx_prev, torch.int64)
+    st_delta = torch.zeros(running_bs, dtype=torch.int64, device="cuda")
+    st_delta[:bs] = dev(deltas, torch.int64)
+    rb._fix_kernel[(1,)](
+        dev(r, torch.int32), dev(b, torch.int32), dev(src, torch.int32), ctx, mrope.reshape(-1), pos, logical, slot,
+        dev(bt, torch.int32), acc, kvp, comp, st_ctx, st_delta, bs, running_bs, q, T, nblk, slot_block, kv_block,
+        ratio, HAS_MROPE=True, FUSE_COMP=True, HAS_POS=False, MUT_SLOT=False, MUT_ACC=False, MUT_POS=False,
+        MUT_COMP=False, ADVANCE=True, MUT_ADV=mut == "adv", QB=4, PB=64,
+    )
+    torch.cuda.synchronize()
+    comp_rule = lambda pp, ss: np.where(((pp + 1) % ratio == 0) & (ss >= 0), ss // ratio, -1)  # noqa: E731
+    ok = (
+        np.array_equal(ctx.cpu().numpy()[:bs], c)
+        and np.array_equal(mrope.cpu().numpy()[:, : bs * q], m)
+        and np.array_equal(logical.cpu().numpy()[: bs * q], p)
+        and np.array_equal(slot.cpu().numpy()[: bs * q], s_)
+        and np.array_equal(comp.cpu().numpy()[: bs * q], comp_rule(p, s_))
+        and np.array_equal(kvp.cpu().numpy(), k)
+        and np.array_equal(acc.cpu().numpy()[:bs], b + 1)
+        and np.array_equal(st_ctx.cpu().numpy()[:bs], c)
+    )
+    if not mut:
+        assert ok
+    elif r.any():
+        assert not ok, "mutant adv not caught"
