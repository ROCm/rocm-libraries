+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+"""The true rocKE monokernel path of Qwen3.8-Flash-Next decode (skeleton).
+
+Imported only when ``ATOM_Q38_TRUE_MONO`` is on (``true_mono``):
+
+- ``hook``: the ``layer`` hook (a rocKE layer kernel provider in place of a
+  hybrid layer build, per runner and width, with per-width refusal to the
+  hybrid) and the not-yet-built granularities (``tail`` / ``pass`` /
+  ``round`` / ``loop``), which keep the hybrid's launchers, logged.
+- ``slots``: the instance -> mailbox tag slot plan of a whole round
+  (``mailbox.LAYER_SLOTS`` = 64 slots a step), the names the true mono's
+  launches and logs use.
+
+Plan of record: ``copy-rocm-lib/experiments/qwen38-true-mono/DESIGN.md``
+(sections 6.2, 7 and 8). Nothing here is under ``kernels/``: the hybrid's
+build keys (``sources.SOURCES``) do not see it.
+"""
diff --git a/atom/models/qwen4_exp_mono/truemono/hook.py b/atom/models/qwen4_exp_mono/truemono/hook.py
