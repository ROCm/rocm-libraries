+            n, ins, eq = (int(v) for v in self.counts.tolist())
+            logger.info(
+                "Qwen3.8 mono draft vocab audit: %d rows, full-head token in the subset %.5f, subset token equal %.5f",
+                n, ins / max(n, 1), eq / max(n, 1),
+            )
