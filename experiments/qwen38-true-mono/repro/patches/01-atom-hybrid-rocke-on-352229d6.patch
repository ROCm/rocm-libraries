index 0000000000000000000000000000000000000000..281b0329894a11f0e8129d38b734d40d821658df
--- /dev/null
+++ b/scripts/qwen38_rocke/sched/ab_sched.py
@@ -0,0 +1,195 @@
+"""In-situ layer A/B of schedule-track levers vs plain MONO (shuffled arms + mono-vs-mono control).
+
+    python ab_sched.py --kind delta --variants r1,r4s --arms 'p2:ATOM_Q38_SCHED=pause=2;;numa:ATOM_Q38_SCHED=numa=1' \
+        --rounds 12 --reps 5 --out ab.json
+
+``--arms``: ``;;``-separated ``name:ENV=VALUE[;ENV=VALUE...]``. Per variant: every arm is built and checked
+bitwise against the plain mono build (mailboxes, layer output, every written state; deterministic;
+nonzero output), a mutant arm (``ATOM_Q38_SCHED=mutate.<stage>=1``: one payload bit flipped) must
+differ; then ``--rounds`` rounds with the arms in a shuffled order (``sched_rig.LayerRig.rounds``).
+Gate per arm: WIN if its median ratio is below the control's minimum and >= 3/4 of its rounds are
+< 1. ``--stamps`` adds a stamped twin of every arm and prints the stage-end ratios (timeline.py).
+``--check-only``: the bitwise checks and the mutant only (no compile control, no timing rounds).
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import re
+import sys
+import time
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+
+import sched_rig as SR
+
+from atom.models.qwen4_exp_mono.kernels import sched as SCH
+
+
+def parse_arms(spec):
+    arms = {}
+    for item in filter(None, (s.strip() for s in spec.split(";;"))):
+        name, _, rest = item.partition(":")
+        over = {}
+        for kv in filter(
+            None, re.split(r";(?=ATOM_)", rest)
+        ):  # ';' inside a value (ATOM_Q38_SCHED groups) stays
+            k, v = kv.split("=", 1)
+            over[k.strip()] = v
+        arms[name.strip()] = over
+    return arms
+
+
+def stage_timeline(R, name, over):
+    """Stamped twin of an arm: merged stage timeline of the last 48 launches."""
+    import timeline
+    import torch
+
+    from atom.models.qwen4_exp_mono.kernels import layout as LY
+    from atom.models.qwen4_exp_mono.q38_hook import _stamp_region
+
+    tw = name + "_tl"
+    R.add(tw, dict(over, ATOM_Q38_STAMPS="1"))
+    R.graph(tw)
+    decs = []
+    for _ in range(4):
+        R.graphs[tw].replay()
+        torch.cuda.synchronize()
+        region = _stamp_region(R.r.scratch, R.rows).cpu()
+        L = LY.for_rows(R.rows, R.seq)
+        decs += [timeline.decode(region[k], R.stages, L) for k in range(SR.SLOTS)]
+    return timeline.merge(decs)
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--kind", default="delta")
+    ap.add_argument("--variants", default="r1,r4s")
+    ap.add_argument("--arms", default="")
+    ap.add_argument(
+        "--arms-file", help="lines 'name ENV=VALUE[;ENV=VALUE...]' (# comments)"
+    )
+    ap.add_argument("--mutant-stage", default="c1")
+    ap.add_argument("--copies", type=int, default=16)
+    ap.add_argument("--rounds", type=int, default=12)
+    ap.add_argument("--reps", type=int, default=5)
+    ap.add_argument("--stamps", action="store_true")
+    ap.add_argument("--dump")
+    ap.add_argument("--real")
+    ap.add_argument("--seed", type=int, default=0)
+    ap.add_argument(
+        "--refs",
+        default="",
+        help="'arm:ref,...': also gate arm / ref per round (e.g. BEST:N)",
+    )
+    ap.add_argument("--context", type=int, default=8192)
+    ap.add_argument(
+        "--check-only",
+        action="store_true",
+        help="bitwise checks + mutant only, no timing",
+    )
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args(argv)
+    arms = parse_arms(a.arms)
+    if a.arms_file:
+        with open(a.arms_file) as f:
+            lines = f.read().splitlines()
+        for ln in lines:
+            ln = ln.split("#", 1)[0].strip()
+            if ln:
+                name, _, rest = ln.partition(" ")
+                arms.update(parse_arms(f"{name}:{rest.strip()}"))
+    res = {"kind": a.kind, "arms": arms, "variants": {}}
+    absd = {}
+    ok = True
+    for v in a.variants.split(","):
+        t0 = time.time()
+        R = SR.LayerRig(
+            a.kind,
+            v,
+            a.copies,
+            context=a.context,
+            dump=a.dump,
+            real=a.real,
+            seed=a.seed,
+        )
+        rec = {
+            "checks": {},
+            "numa_calibration": {
+                "mask": R.numa_cal[0],
+                "agreement": R.numa_cal[1],
+                "info": R.numa_cal[2],
+            },
+        }
+        print(
+            "NUMA_CAL",
+            a.kind,
+            v,
+            "mask",
+            hex(R.numa_cal[0]),
+            "agreement",
+            round(R.numa_cal[1], 4),
+            json.dumps(R.numa_cal[2]),
+            flush=True,
+        )
+        for name, over in ([] if a.check_only else [("mono_rc", SR.RC_ENV)]) + list(
+            arms.items()
+        ):
+            R.add(name, over)
+            chk = R.check(name)
+            rec["checks"][name] = chk
+            ok &= chk["bitwise"] and chk["deterministic"] and chk["out_nonzero"]
+            print("CHECK", a.kind, v, name, json.dumps(chk), flush=True)
+        R.add("_mutant", {SCH.ENV_SCHED: f"mutate.{a.mutant_stage}=1"})
+        m = R.check("_mutant", mutant=True)
+        rec["checks"]["_mutant"] = m
+        ok &= m["differs"]
+        print("CHECK", a.kind, v, "_mutant", json.dumps(m), flush=True)
+        R.builds.pop("_mutant")
+        if a.check_only:
+            rec["wall_s"] = time.time() - t0
+            res["variants"][v] = rec
+            R.free()
+            continue
+        refs = dict(x.split(":") for x in a.refs.split(",") if x)
+        tm = R.rounds(list(arms), a.rounds, a.reps, seed=a.seed, refs=refs)
+        rec["summary"] = tm["summary"]
+        absd[v] = tm["rounds"]
+        print(f"##### {a.kind} {v}\n" + SR.fmt_summary(tm["summary"]), flush=True)
+        if a.stamps:
+            tl = {
+                n: stage_timeline(R, n, arms.get(n, {})) for n in ["mono"] + list(arms)
+            }
+            base = tl["mono"]
+            rec["stamps"] = {}
+            for n, t in tl.items():
+                rr = {"total": t["total"] / base["total"]}
+                for s in R.stages:
+                    if t["stages"].get(s) and base["stages"].get(s):
+                        rr[s + "_end"] = t["stages"][s]["end"] / base["total"]
+                        rr[s + "_incr"] = t["stages"][s]["incr"] / base["total"]
+                rec["stamps"][n] = rr
+                print(
+                    "STAMPS",
+                    v,
+                    n,
+                    json.dumps({k: round(x, 4) for k, x in rr.items()}),
+                    flush=True,
+                )
+        rec["wall_s"] = time.time() - t0
+        res["variants"][v] = rec
+        R.free()
+    res["ok"] = ok
+    with open(a.out, "w") as f:
+        json.dump(res, f, indent=1)
+    with open(a.out.replace(".json", "_abs.json"), "w") as f:
+        json.dump(absd, f)
+    print("AB", "PASS" if ok else "FAIL", flush=True)
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/qwen38_rocke/sched/grp_check.py b/scripts/qwen38_rocke/sched/grp_check.py
