+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+"""The Qwen3.8-Flash-Next mono's schedule-track knobs (``kernels.sched``):
+off by default (no build-key entry, no scratch), parsing, the measurement
+knobs' preconditions and scratch tail, and that knob builds trace."""
+
+import pytest
+
+pytest.importorskip("flydsl")
+
+from atom.models.qwen4_exp_mono.kernels import layout, sched, stamps
+
+ENVS = (sched.ENV_BLAME, sched.ENV_SPIN, sched.ENV_DELAY, sched.ENV_SCHED)
+
+
+@pytest.fixture
+def clean(monkeypatch):
+    for k in ENVS + (stamps.ENV,):
+        monkeypatch.delenv(k, raising=False)
+    return monkeypatch
+
+
+def test_off_by_default(clean):
+    assert sched.resolve(False, 1) == ()
+    assert sched.resolve(False, 8) == ()
+    assert sched.scratch_extra() == 0
+    assert sched.suffix(()) == ""
+    assert layout.scratch_bytes(4) == layout.mailbox_bytes(4)
+    assert not sched.active()
+
+
+def test_delay_parsing():
+    assert sched.parse_delay("") == ()
+    assert sched.parse_delay("b3=32") == (("b3", "entry", 0, 256, 32),)
+    assert sched.parse_delay("m1:post@0-4=8; b3:exit=2") == (
+        ("b3", "exit", 0, 256, 2),
+        ("m1", "post", 0, 4, 8),
+    )
+    assert sched.parse_delay("b3=0") == ()  # zero units: inert, not keyed
+    for bad in ("b3", "b3:late=2", "b3@4-4=2", "B3=1", "b3=-1"):
+        with pytest.raises(ValueError):
+            sched.parse_delay(bad)
+
+
+def test_lever_parsing():
+    assert sched.parse_levers("pause=2,prio.m4=3,head_sleep=0") == (
+        ("head_sleep", 0),
+        ("pause", 2),
+        ("prio.m4", 3),
+    )
+    assert sched.parse_levers("b3pf=1,pipe.b3=2") == (("b3pf", 1), ("pipe.b3", 2))
+    assert sched.parse_levers("hold.b1=32,place.m1=32,mutate.c1=1") == (
+        ("hold.b1", 32),
+        ("mutate.c1", 1),
+        ("place.m1", 32),
+    )
+    for bad in (
+        "prio=2",
+        "prio.m4=4",
+        "head_sleep.a1=2",
+        "nope=1",
+        "pause=x",
+        "hold=3",
+        "place=1",
+    ):
+        with pytest.raises(ValueError):
+            sched.parse_levers(bad)
+
+
+def test_selectors_and_best(clean, monkeypatch):
+    spec = "*:head_sleep=128;delta.r4s:hold.m3=128;qsa:hold.q1=64;*.r1:hold.b1=32"
+    assert sched.select(spec, "delta", "r4s") == "head_sleep=128,hold.m3=128"
+    assert sched.select(spec, "qsa", "r4s") == "head_sleep=128,hold.q1=64"
+    assert sched.select(spec, "delta", "r1") == "head_sleep=128,hold.b1=32"
+    assert sched.select("hold.m3=2", "qsa", "r2s") == "hold.m3=2"
+    assert (
+        sched.variant_name(4, True) == "r4s"
+        and sched.variant_name(8, True, 4) == "r8sg4"
+    )
+    assert (
+        sched.kind_of(("a1", "q1")) == "qsa" and sched.kind_of(("p1",)) == "delta_ple"
+    )
+    monkeypatch.setattr(sched, "BEST", "delta.r1:hold.b1=32")
+    clean.setenv(sched.ENV_SCHED, "best")
+    assert sched.resolve(False, 1, False, 0, ("a1", "b1")) == (
+        ("lever", ("hold.b1", 32)),
+    )
+    # ``best`` composes: later groups on top of it
+    assert sched.select("best;pipe=2", "delta", "r1") == "hold.b1=32,pipe=2"
+    assert (
+        sched.select("best;delta.r1:hold.b1=8", "delta", "r1") == "hold.b1=32,hold.b1=8"
+    )
+    assert sched.parse_levers(
+        sched.select("best;delta.r1:hold.b1=8", "delta", "r1")
+    ) == (("hold.b1", 8),)
+    assert sched.resolve(False, 4, True, 0, ("a1", "b1")) == ()
+    # placement is dropped for wide builds
+    clean.setenv(sched.ENV_SCHED, "place.m1=32,hold.m3=8")
+    assert sched.resolve(False, 8, True, 4, ("a1",)) == (("lever", ("hold.m3", 8)),)
+
+
+def test_extern_builds_keep_the_plain_mailboxes(clean):
+    clean.setenv(sched.ENV_SCHED, "numa=1,hold.m3=8")
+    k = sched.resolve(False, 4, True, 0, ("a1", "m3"))
+    assert sched.from_knobs(k).levers == {"numa": 1, "hold.m3": 8}
+    k2 = sched.without_numa(k, ("a1", "m3"), 4, True, 0)
+    assert sched.from_knobs(k2).levers == {"hold.m3": 8}
+    assert sched.without_numa(k2, ("a1",), 4, True, 0) == k2
+
+
+def test_knobs_keyed_and_named(clean):
+    clean.setenv(sched.ENV_SCHED, "pause=2")
+    k1 = sched.resolve(False, 1)
+    clean.setenv(sched.ENV_SCHED, "pause=3")
+    k2 = sched.resolve(False, 1)
+    assert k1 and k2 and k1 != k2
+    assert sched.suffix(k1) != sched.suffix(k2) != ""
+    assert sched.from_knobs(k1).levers == {"pause": 2}
+
+
+def test_measurement_knobs_need_stamps_and_narrow_rows(clean):
+    clean.setenv(sched.ENV_BLAME, "1")
+    with pytest.raises(ValueError):
+        sched.resolve(False, 1)
+    with pytest.raises(ValueError):
+        sched.resolve(True, layout.MAX_ROWS + 1)
+    assert sched.from_knobs(sched.resolve(True, 4)).blame
+
+
+def test_scratch_tail(clean):
+    clean.setenv(stamps.ENV, "1")
+    clean.setenv(sched.ENV_BLAME, "1")
+    mb = layout.mailbox_bytes(layout.MAX_ROWS)
+    assert sched.blame_offset() == mb + stamps.REGION_BYTES
+    assert sched.spin_offset() == sched.blame_offset() + sched.BL_BYTES
+    assert sched.side_delta() == sched.spin_offset() + sched.SP_BYTES
+    # the side copy of every mailbox byte fits the scratch
+    assert layout.scratch_bytes(4) >= sched.side_delta() + mb
+    clean.delenv(sched.ENV_BLAME)
+    clean.setenv(sched.ENV_SPIN, "1")
+    assert (
+        layout.scratch_bytes(4)
+        == mb + stamps.REGION_BYTES + sched.BL_BYTES + sched.SP_BYTES
+    )
+
+
+def test_numa_layout(clean):
+    from atom.models.qwen4_exp_mono.kernels import numa
+
+    # copies of a chunk 8 KiB apart; chunks never overlap; the area holds the mailbox part twice
+    xs = [0, 8, 8184, 8192, 16384 + 24, layout.mailbox_bytes(4) - 8]
+    ph = [numa.phys(x) for x in xs]
+    assert ph[:3] == [0, 8, 8184] and ph[3] == 16384 and ph[4] == 32768 + 24
+    assert all(p % 16384 < 8192 for p in ph)
+    assert numa.phys(layout.mailbox_bytes(4) - 8) + 8192 + 8 <= numa.area_bytes()
+    assert numa.area_bytes() // numa.PAGE <= 32  # one mask bit per page
+    assert numa.header_offset() >= sched.side_delta() + layout.mailbox_bytes(4)
+    for p in (0, 1 << 20, (5 << 21) + 4096):
+        b = numa.area_base(p)
+        assert b % numa.PAGE == 0 and b >= p + numa.header_offset() + 256
+        assert b + numa.area_bytes() <= p + numa.scratch_bytes_needed()
+    clean.setenv(sched.ENV_SCHED, "delta.r4s:numa=1")
+    assert numa.wanted()
+    assert layout.scratch_bytes(4) >= numa.scratch_bytes_needed()
+    clean.setenv(sched.ENV_SCHED, "best")
+    assert numa.wanted() == ("numa" in sched.BEST)
+    clean.delenv(sched.ENV_SCHED)
+    assert not numa.wanted()  # the BEST table alone never turns it on
+    assert layout.scratch_bytes(4) == layout.mailbox_bytes(4)
+
+
+def test_numa_wanted_parses_levers(clean):
+    """``numa.wanted`` follows the parsed levers, not the substring: ``numa=0``
+    or a selector no narrow build matches does not calibrate or grow the
+    scratch, and a wide scratch never holds the NUMA area."""
+    from atom.models.qwen4_exp_mono.kernels import numa
+
+    for spec in ("numa=0", "delta.r8:numa=1", "pause=1", "best;numa=0"):
+        clean.setenv(sched.ENV_SCHED, spec)
+        assert not numa.wanted(), spec
+        assert layout.scratch_bytes(4) == layout.mailbox_bytes(4), spec
+    for spec in ("numa=1", "qsa.r4g2:numa=1", "delta_ple.r2s:numa=3", "best"):
+        clean.setenv(sched.ENV_SCHED, spec)
+        assert numa.wanted(), spec
+        assert layout.scratch_bytes(4) >= numa.scratch_bytes_needed(), spec
+        # wide builds drop the lever (``resolve``): their scratch has no area
+        assert layout.scratch_bytes(8) == layout.mailbox_bytes(8), spec
+
+
+def test_slots_cover_every_kind():
+    from atom.models.qwen4_exp_mono.kernels.kernel import STAGES
+
+    for stages in STAGES.values():
+        assert len(stages) <= sched.MAX_STAGES
+    assert (
+        sched.BL_POINTS <= 512 and sched.SP_POINTS <= 512
+    )  # one thread per slot at flush
+
+
+@pytest.mark.parametrize(
+    "envs,kind,rows,seq",
+    [
+        ({sched.ENV_SCHED: "pause=2,prio.b3=2,head_sleep=0"}, "delta", 4, True),
+        (
+            {
+                sched.ENV_SCHED: "hold.m3=64,hold.b1=8,place.m1=32,head_sleep=128,mutate.c1=1"
+            },
+            "delta",
+            4,
+            True,
+        ),
+        ({sched.ENV_DELAY: "b3:post=8;m1=4;c1:exit@0-8=2"}, "delta", 4, True),
+        (
+            {stamps.ENV: "1", sched.ENV_BLAME: "1", sched.ENV_SPIN: "1"},
+            "delta",
+            4,
+            True,
+        ),
+        ({sched.ENV_SCHED: "numa=1"}, "delta", 4, True),
+        ({sched.ENV_SCHED: "numa=1,pipe=3,pipe.b3=1"}, "delta", 1, False),
+        ({sched.ENV_SCHED: "best"}, "qsa", 4, True),
+        ({sched.ENV_SCHED: "best;b3pf=1"}, "delta", 4, True),
+        ({sched.ENV_SCHED: "b3pf=1"}, "delta_ple", 1, False),
+        ({sched.ENV_SCHED: "numa=1"}, "qsa", 1, False),
+        ({sched.ENV_SCHED: "numa=1"}, "delta_ple", 4, True),
+        ({sched.ENV_SCHED: "dyn.b1=1,dyn.c1=1,dyn.m1=1,dyn.m2=1"}, "delta", 4, True),
+        ({sched.ENV_SCHED: "best;dyn.c1=1,dyn.q5=1"}, "qsa", 1, False),
+        ({stamps.ENV: "1", sched.ENV_SCHED: "dyn.c1=1"}, "delta", 1, False),
+        (
+            {stamps.ENV: "1", sched.ENV_BLAME: "1", sched.ENV_SCHED: "numa=1"},
+            "qsa",
+            4,
+            True,
+        ),
+    ],
+)
+def test_knob_builds_trace(tmp_path, clean, envs, kind, rows, seq):
+    pytest.importorskip("aiter")
+    from atom.models.qwen4_exp_mono.kernels import kernel
+    from atom.mono.runtime.compile import compile_only
+
+    clean.setenv("ARCH", "gfx950")
+    clean.setenv("FLYDSL_GPU_ARCH", "gfx950")
+    clean.setenv("FLYDSL_RUNTIME_CACHE_DIR", str(tmp_path))
+    for k, v in envs.items():
+        clean.setenv(k, v)
+    kernel.build_layer.cache_clear()
+    try:
+        with compile_only():
+            kernel.build_layer(kernel.STAGES[kind], rows=rows, seq=seq)(
+                0, 0, *([0] * len(kernel.LAYER_ARGS))
+            )
+        assert not sched.active()  # the trace ended its knob state
+    finally:
+        kernel.build_layer.cache_clear()
+
+
+def test_dyn_parsing(clean):
+    """``dyn.<stage>``: needs a stage, not A1 / A2, dropped by wide builds,
+    refused with blame / spin; its counters need the NUMA header in the scratch."""
+    from atom.models.qwen4_exp_mono.kernels import numa
+
+    assert sched.parse_levers("dyn.c1=1,dyn.m1=1") == (("dyn.c1", 1), ("dyn.m1", 1))
+    for bad in ("dyn=1", "dyn.a1=1", "dyn.a2=1", "dyn.m5=1"):
+        with pytest.raises(ValueError):
+            sched.parse_levers(bad)
+    clean.setenv(sched.ENV_SCHED, "dyn.c1=1")
+    k = sched.resolve(False, 4, True, 0, ("a1", "a2", "b1", "b3", "c1"))
+    assert sched.dyn_stages(k) == {"c1"} and sched.needs_lds(k)
+    assert sched.resolve(False, 8) == ()  # wide: dropped
+    assert sched.resolve(True, 4, True)  # stamped: fine
+    clean.setenv(sched.ENV_BLAME, "1")
+    with pytest.raises(ValueError):
+        sched.resolve(True, 4, True)
+    clean.delenv(sched.ENV_BLAME)
+    assert numa.wanted("dyn") and not numa.wanted()
+    assert layout.scratch_bytes(4) >= sched.dyn_offset() + 4 * sched.MAX_STAGES
+    assert layout.scratch_bytes(8) == layout.mailbox_bytes(8)
+    assert sched.dyn_offset() + 4 * sched.DY_WORDS <= numa.header_offset() + 256
+    clean.delenv(sched.ENV_SCHED)
+    assert not sched.needs_lds(()) and not numa.wanted("dyn")
+
+
+@pytest.mark.parametrize(
+    "envs,kind,rows,seq",
+    [({}, "delta", 4, True), ({sched.ENV_SCHED: "best"}, "qsa", 1, False)],
+)
+def test_stack_builds_trace(tmp_path, clean, envs, kind, rows, seq):
+    """The two-layer stacked launch (``kernels.stack``) traces and compiles."""
+    pytest.importorskip("aiter")
+    from atom.models.qwen4_exp_mono.kernels import kernel, stack
+    from atom.mono.runtime.compile import compile_only
+
+    clean.setenv("ARCH", "gfx950")
+    clean.setenv("FLYDSL_GPU_ARCH", "gfx950")
+    clean.setenv("FLYDSL_RUNTIME_CACHE_DIR", str(tmp_path))
+    for k, v in envs.items():
+        clean.setenv(k, v)
+    stack._build_stack.cache_clear()
+    try:
+        with compile_only():
+            stack.build_stack(kernel.STAGES[kind], rows=rows, seq=seq)(
+                0, 0, *([0] * len(kernel.LAYER_ARGS)), 0
+            )
+        assert not sched.active()
+    finally:
+        stack._build_stack.cache_clear()
+    assert stack.table_bytes() == stack.XL_OFF + 256 * 8
+    assert stack.NARGS == len(kernel.LAYER_ARGS) - 1
