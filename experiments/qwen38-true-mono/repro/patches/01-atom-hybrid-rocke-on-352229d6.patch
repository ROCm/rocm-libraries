index 0000000000000000000000000000000000000000..c13482b8f60ac6739651f22b9e5eff3e18b71cfd
--- /dev/null
+++ b/atom/models/qwen4_exp_mono/rocke_head.py
@@ -0,0 +1,204 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+"""The mono's MXFP4 ``lm_head`` on rocKE's MX decode GEMV (off by default).
+
+``ATOM_Q38_ROCKE_HEAD=1`` swaps the two launches of ``head.py`` -- the logits
+head (``mxfp4_head``: the target's verify rows) and the greedy argmax head
+(``mxfp4_argmax``: each draft step) -- for rocKE builds of
+``kernels.gfx950.mx_decode_gemv`` (the rocKE library on ``PYTHONPATH``). Same
+weights (``Mxfp4LMHead``'s packed codes and scales), same arguments, same
+results: the default build multiplies in the order of ``_mxfp4_head``'s
+``tl.dot_scaled`` (bf16 x e2m1, f32 accumulation), so the logits are the
+mono's bit for bit and the argmax rule is ``_argmax_fold``'s (lowest index of
+the largest bf16 logit). Unset, nothing here is imported or run.
+
+Knobs (all optional, read once when the head is installed):
+
+- ``ATOM_Q38_ROCKE_HEAD_PARTS``: ``logits,argmax`` (default both) -- which
+  of the two launches to swap.
+- ``ATOM_Q38_ROCKE_HEAD_SPEC``: JSON of ``MxDecodeGemvSpec`` fields applied
+  to every build (e.g. ``{"waves": 8, "ctas": 512}``); per part:
+  ``ATOM_Q38_ROCKE_HEAD_SPEC_LOGITS`` / ``_ARGMAX``. Both apply on top of
+  ``DEFAULT_SPEC`` (the argmax builds: ``waves_per_eu=1``, -0.4% kernel time
+  in three runs; ``{"waves_per_eu": 0}`` restores the kernel default).
+- ``ATOM_Q38_ROCKE_HEAD_FOLD``: ``fused`` (default: the last CTA folds the
+  per-CTA keys, one launch: the GPU time of ``keys`` at rows <= 4 and a third
+  of the mono's host cost per eager call) or ``keys`` (per-CTA keys, then the
+  mono's ``_argmax_fold``: two launches, as the mono; faster with the 16-row
+  build, which no served argmax uses: a greedy argmax takes one row a request).
+- ``ATOM_Q38_ROCKE_HEAD_SERPENTINE``: ``1`` (default 0) runs each draft
+  step's head in the opposite column order of the head before it, so the
+  pass starts on the columns the previous pass read last (still in the
+  memory-side cache).
+
+The kernels are compiled when the head is installed (``Mxfp4LMHead``), never
+during a graph capture, and launched with ``hipModuleLaunchKernel`` on
+torch's current stream (graph capturable).
+"""
+
+from __future__ import annotations
+
+import ctypes
+import json
+import logging
+import os
+
+import torch
+
+logger = logging.getLogger("atom")
+
+ENV = "ATOM_Q38_ROCKE_HEAD"
+#: per-part ``MxDecodeGemvSpec`` fields under the env knobs (head track lever ledger L8)
+DEFAULT_SPEC = {"logits": {}, "argmax": {"waves_per_eu": 1}}
+
+
+def enabled() -> bool:
+    return os.environ.get(ENV, "0") not in ("", "0")
+
+
+def _spec_env(part: str) -> dict:
+    out = dict(DEFAULT_SPEC.get(part, {}))
+    for key in (f"{ENV}_SPEC", f"{ENV}_SPEC_{part.upper()}"):
+        raw = os.environ.get(key)
+        if raw:
+            out.update(json.loads(raw))
+    return out
+
+
+class _Kernel:
+    """One compiled rocKE build: its module, function and launch geometry."""
+
+    def __init__(self, spec):
+        from kernels.gfx950 import mx_decode_gemv as M
+        from rocke.helpers import compile_kernel
+        from rocke.runtime import hip_module as HM
+
+        self.M, self.HM = M, HM
+        self.spec = spec
+        art = compile_kernel(M.build_mx_decode_gemv(spec), arch="gfx950", backend="python")
+        self.module = HM.Runtime().load_module(art.hsaco)
+        self.fn = self.module.get_function(art.kernel_name)
+        self.name = art.kernel_name
+        self.grid, self.block = M.grid(spec)
+        self.sig = M.signature(spec)
+        self.ws = None
+        if spec.epilogue == "fused":
+            n = M.fused_workspace_bytes(spec) // 4
+            self.ws = torch.zeros(n, dtype=torch.int32, device="cuda")
+        # the launch's ctypes objects, built once: a call only sets their values
+        # (the draft heads launch eagerly, so the host cost of a call counts)
+        self._vals = {
+            n: ctypes.c_uint64() if kind == "ptr" else ctypes.c_int32() for n, kind in self.sig
+        }
+        self._params = (ctypes.c_void_p * len(self.sig))(
+            *[ctypes.cast(ctypes.pointer(self._vals[n]), ctypes.c_void_p) for n, _ in self.sig]
+        )
+        if self.ws is not None:
+            self._vals["ws"].value = self.ws.data_ptr()
+        self._geom = (
+            ctypes.c_uint(self.grid[0]),
+            ctypes.c_uint(1),
+            ctypes.c_uint(1),
+            ctypes.c_uint(self.block[0]),
+            ctypes.c_uint(1),
+            ctypes.c_uint(1),
+            ctypes.c_uint(0),
+        )
+
+    def __call__(self, x, w, s, y, sym: int, rev: int) -> None:
+        v = self._vals
+        v["x"].value = x.data_ptr()
+        v["w"].value = w.data_ptr()
+        v["s"].value = s.data_ptr()
+        v["y"].value = y.data_ptr()
+        v["m"].value = x.shape[0]
+        v["sxm"].value = x.stride(0)
+        v["sym"].value = sym
+        v["rev"].value = rev
+        rc = self.HM._hipModuleLaunchKernel(
+            self.fn,
+            *self._geom,
+            ctypes.c_void_p(torch.cuda.current_stream().cuda_stream),
+            self._params,
+            None,
+        )
+        if rc != 0:
+            raise RuntimeError(f"rocKE head {self.name}: hipModuleLaunchKernel error {rc}")
+
+
+class RockeHead:
+    """rocKE builds of the head for ``packed`` (``[N, K/2]`` u8 codes):
+    rows <= 4 and <= 16 (``head.MAX_HEAD_ROWS``), logits and argmax."""
+
+    def __init__(self, packed: torch.Tensor, max_rows: int):
+        from kernels.gfx950 import mx_decode_gemv as M
+
+        n, kh = packed.shape
+        parts = os.environ.get(f"{ENV}_PARTS", "logits,argmax").split(",")
+        fold = os.environ.get(f"{ENV}_FOLD", "fused")
+        if fold not in ("fused", "keys"):
+            raise ValueError(f"{ENV}_FOLD must be fused or keys, got {fold!r}")
+        self.serpentine = os.environ.get(f"{ENV}_SERPENTINE", "0") == "1"
+        self.fold = fold
+        self.n = n
+        self._next_rev = 0
+        self.logits_k = {}
+        self.argmax_k = {}
+        for rows in (4, max_rows):
+            if "logits" in parts:
+                spec = M.MxDecodeGemvSpec(
+                    n=n, k=2 * kh, rows_max=rows, epilogue="logits", **_spec_env("logits")
+                )
+                self.logits_k[rows] = _Kernel(spec)
+            if "argmax" in parts:
+                spec = M.MxDecodeGemvSpec(
+                    n=n, k=2 * kh, rows_max=rows, epilogue=fold, **_spec_env("argmax")
+                )
+                self.argmax_k[rows] = _Kernel(spec)
+        names = sorted({k.name for k in (*self.logits_k.values(), *self.argmax_k.values())})
+        logger.info("Qwen3.8 mono rocKE lm_head on: %s", ", ".join(names))
+
+    def _pick(self, table, rows):
+        for r in sorted(table):
+            if rows <= r:
+                return table[r]
+        return None
+
+    def logits(self, x, weight, scales):
+        """``mxfp4_head``'s result, or None when this part is not swapped."""
+        k = self._pick(self.logits_k, x.shape[0])
+        if k is None:
+            return None
+        if x.stride(-1) != 1:
+            x = x.contiguous()
+        y = torch.empty(x.shape[0], self.n, dtype=torch.bfloat16, device=x.device)
+        k(x, weight, scales, y, y.stride(0), 0)
+        self._next_rev = 1  # the first draft head after a target head
+        return y
+
+    def argmax(self, x, weight, scales, keys, out):
+        """``mxfp4_argmax``'s result into ``out``, or None when not swapped."""
+        k = self._pick(self.argmax_k, x.shape[0])
+        if k is None:
+            return None
+        if x.stride(-1) != 1:
+            x = x.contiguous()
+        rev = 0
+        if self.serpentine:
+            rev = self._next_rev
+            self._next_rev ^= 1
+        if self.fold == "fused":
+            k(x, weight, scales, out, 0, rev)
+            return out
+        from .head import _argmax_fold
+
+        k(x, weight, scales, keys, 0, rev)
+        _argmax_fold[(x.shape[0],)](keys, out, k.spec.ctas, self.n - 1, BLOCK=1024)
+        return out
+
+
+def build(packed: torch.Tensor, max_rows: int):
+    """``RockeHead`` when ``ATOM_Q38_ROCKE_HEAD`` is on, else None."""
+    if not enabled():
+        return None
+    return RockeHead(packed, max_rows)
