index 0000000000000000000000000000000000000000..db2158ee4338de3bd3fe94c44bc954ca062bb720
--- /dev/null
+++ b/scripts/qwen38_rocke/repro_rocke_mono.sh
@@ -0,0 +1,615 @@
+#!/usr/bin/env bash
+# Reproduction of the rocKE + schedule improvements of the Qwen3.8-Flash-Next monokernel decode on one
+# MI355X (gfx950), in the pinned container of scripts/qwen38_flash_mono/repro.sh (same image, same $WORK
+# environment: venv, aiter c53e9b3f, FlyDSL 0.3.4.1). recipes/Qwen3.8-Flash-Next-rocKE.md explains what is
+# reproduced, the knobs and the expected results.
+#
+# The full stack against plain mono, all knobs default off in ATOM:
+#   ATOM_Q38_SCHED=best           NUMA dual-copy mailboxes + per-stage holds on the mono's own layer kernels
+#   ATOM_Q38_EXTERN_STAGES=...    rocKE stage functions linked into the FlyDSL layer kernel in place of the
+#                                 mono's: the fused MoE (m3 + m4 + m5) and the gated delta rule (b3 + b3pre),
+#                                 generated by the gen step from the rocm-libraries checkout (ROCKE_ROOT)
+#   ATOM_Q38_EXTERN_MISSING=mono  builds without a generated function (grouped / wide) keep the FlyDSL stage
+#   ATOM_Q38_ROCKE_HEAD=1         lm_head on rocKE's MXFP4 decode GEMV (logits and fused argmax)
+#
+#   MODEL=/path/to/Qwen3.8-Flash-Next-MXFP4 ROCKE_ROOT=/path/to/rocm-libraries GPU=0 \
+#     bash scripts/qwen38_rocke/repro_rocke_mono.sh all
+#
+# Run it on the host from this ATOM checkout: it starts the container (repro.sh's launch: /dev/kfd, /dev/dri,
+# HIP_VISIBLE_DEVICES=$GPU) and runs itself inside. REPRO_IN_CONTAINER=1 runs it directly inside a container of
+# the same image where this checkout is at /atom and the repro environment at /work (MODEL and ROCKE_ROOT are
+# then paths inside the container; MODEL defaults to /model).
+#
+# Steps (each prints PASS / FAIL per check; a FAIL stops the run unless KEEP_GOING=1):
+#   check  gfx950 GPU; container image; ATOM branch / commit and the files of this work; rocm-libraries commit
+#          (warns unless it is the pinned commit or a descendant); rocKE imports; FlyDSL 0.3.4.1; aiter commit;
+#          the checkpoint's sha256 (scripts/qwen38_flash_mxfp4/Qwen3.8-Flash-Next-MXFP4.sha256)
+#   gen    generate the rocKE stage functions into $FNS: fused MoE (stage_moe_fused --knobs best) and B3
+#          (stage_b3 --knobs tuned_numa), both NUMA-aware; the lm_head needs no generation (ATOM compiles it
+#          at load). Verifies the sidecars: symbols, "mailboxes": "numa1", the MoE generation pairing, the B3
+#          body / prologue pairing
+#   unit   ATOM's CPU tests of the new modules (tests/test_qwen4_exp_mono_{extern_stages,extern_moe_pairing,
+#          sched,rocke_head,stamps,build_key}.py; with a GPU and rocKE the rocke_head test's GPU case runs too)
+#   gate   layer-level bitwise gates against plain mono, each with a mutant that must differ:
+#            sched     ATOM_Q38_SCHED=best on every narrow variant of the three layer kinds + grouped r4g2
+#            moe       the fused MoE (BEST sets) per kind and variant, forced-U and step-2^25 cases
+#            b3        the generated B3 files under ATOM_Q38_SCHED=best (NUMA layout kept), every variant;
+#                      the tuned NUMA sets with a numerics mutant (exp=hw)
+#            composed  N / NF / NFB (lever, + fused MoE, + B3) in one DeltaNet layer build, every variant
+#            head      rocKE lm_head logits bitwise and argmax equal to the mono head, rows 1..16, tie rule
+#            isa       knobs off: the layer kernels' ISA byte-identical to plain mono (BASE_COMMIT's tree)
+#   quick  served tok/s: plain mono vs the full stack, back to back x2 (A ALL A ALL), MTP K=3, gsm8k
+#          QUICK_PROMPTS prompts; tok/s per arm, ratio, verify-round ratio, acceptance, gsm8k right; checks
+#          the server logs (NUMA calibrated, the extern stages resolved per build, rocKE lm_head on)
+#   full   optional: the composed shuffled A/B (arms A M N NF NFB ALL, K=3 and K=0, PAIRS pairs)
+#   all    check gen unit gate quick
+#   shell  a shell in the container with this environment
+#
+# Settings (environment variables):
+#   MODEL        the MXFP4 checkpoint (repro.sh convert); host mode: required
+#   ROCKE_ROOT   rocm-libraries checkout at the pinned branch / commit (or its
+#                dnn-providers/hip-kernel-provider/rocke directory); required
+#   GPU          HIP device ordinal; default 0
+#   WORK         repro.sh's environment and caches (host path); default $HOME/q38-repro
+#   RUN_DIR      this run's results; default $WORK/runs/<UTC time>-rocke-<command>
+#   FNS          generated functions; default $WORK/fns (replaced by gen)
+#   BASE_ATOM    a plain tree of ATOM at BASE_COMMIT for the isa gate; default: exported from this checkout's git
+#   PORT         server port; default 8000
+#   KEEP_GOING   1: run the remaining steps after a FAIL
+#   CHECKSUM     0: skip the checkpoint sha256 (WARN); default 1
+#   GATE_SET     full (default) | smoke (one variant per kind and gate, for a first try)
+#   GATES        the gates to run, in order; default "sched moe b3 composed head isa"
+#   QUICK_PROMPTS (32), QUICK_TOKENS (2048), QUICK_MIN_SPEEDUP (1.10: quick FAILs below it)
+#   PAIRS (6), KS ("3 0"), ARMS ("A M N NF NFB ALL"), PROMPTS (96), TOKENS (2048): the full step
+#   Q38_SHARED_CACHE 1: FlyDSL / Triton caches shared under /work/cache instead of fresh per run
+set -euo pipefail
+
+SELF=scripts/qwen38_rocke/repro_rocke_mono.sh
+HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+REPO=$(cd "$HERE/../.." && pwd)
+MONO_REPRO=$REPO/scripts/qwen38_flash_mono/repro.sh
+# Pins. The image and aiter come from repro.sh (one source of truth), FlyDSL from its constraints.
+PINNED_IMAGE=$(sed -n 's/^IMAGE=\${IMAGE:-\([^}]*\)}$/\1/p' "$MONO_REPRO")
+AITER_COMMIT=$(sed -n 's/^AITER_COMMIT=\([0-9a-f]*\)$/\1/p' "$MONO_REPRO")
+FLYDSL_VERSION=$(sed -n 's/^flydsl==\(.*\)$/\1/p' "$REPO/scripts/qwen38_flash_mono/repro-constraints.txt" | tr -d '\r')
+IMAGE=${IMAGE:-$PINNED_IMAGE}
+ROCKE_BRANCH=users/vanantha/rocke-monokernels
+ROCKE_COMMIT=89209ac76656aede13abd8bb4e5e6ec371ed6a1f
+ATOM_BRANCH=qwen38-megakernels
+BASE_COMMIT=352229d6d4a756cf58146bc5cb37519dd5d5aefd  # the plain mono this work is measured against
+IMAGE_TORCH=2.13.0+rocm10.0.0                          # the image's /opt/venv torch (fingerprint inside it)
+VARIANTS=r1,r2,r3,r4,r2s,r3s,r4s                         # the narrow (rows <= 4) ungrouped builds
+
+die() { echo "repro-rocke: $*" >&2; exit 1; }
+usage() { sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed '$d' | sed 's/^# \{0,1\}//'; }
+
+cmd=${1:-help}
+case $cmd in
+  check | gen | unit | gate | quick | full | all | shell) ;;
+  help | -h | --help) usage; exit 0 ;;
+  *) usage; exit 2 ;;
+esac
+[ -n "$PINNED_IMAGE" ] && [ -n "$AITER_COMMIT" ] && [ -n "$FLYDSL_VERSION" ] || die "cannot read the pins from $MONO_REPRO"
+
+# ---------------------------------------------------------------------------------------------
+# Host: start the container (as repro.sh does) and run this script inside it.
+# ---------------------------------------------------------------------------------------------
+if [ -z "${REPRO_IN_CONTAINER:-}" ]; then
+  command -v docker > /dev/null || die "docker not found"
+  [ -n "${MODEL:-}" ] && [ -f "$MODEL/config.json" ] || die "set MODEL=<the Qwen3.8-Flash-Next-MXFP4 checkpoint directory>"
+  [ -n "${ROCKE_ROOT:-}" ] && [ -d "$ROCKE_ROOT" ] || die "set ROCKE_ROOT=<rocm-libraries checkout at $ROCKE_BRANCH>"
+  WORK=${WORK:-$HOME/q38-repro}
+  mkdir -p "$WORK"
+  # The image: pulled by digest when IMAGE is the pinned reference; its RepoDigests are checked in `check`.
+  docker image inspect "$IMAGE" > /dev/null 2>&1 || docker pull "$IMAGE"
+  digests=$(docker image inspect "$IMAGE" --format '{{join .RepoDigests " "}}' 2> /dev/null || true)
+  args=(
+    --rm --init --name "q38-rocke-$(id -un)-$$"
+    --ulimit nofile=65535:65535 --ulimit memlock=-1:-1 --ulimit stack=67108864
+    --cap-add=SYS_PTRACE --security-opt seccomp=unconfined
+    --device=/dev/kfd --device=/dev/dri --group-add video --ipc=host
+    -v "$REPO":/atom -v "$(cd "$WORK" && pwd)":/work -w /atom
+    -v "$(realpath "$MODEL")":/model:ro -v "$(realpath "$ROCKE_ROOT")":/rocke-root:ro
+    -e REPRO_IN_CONTAINER=1 -e HIP_VISIBLE_DEVICES="${GPU:-0}" -e MODEL=/model -e ROCKE_ROOT=/rocke-root
+    -e HOST_UID="$(id -u)" -e HOST_GID="$(id -g)"
+    -e REPRO_IMAGE="$IMAGE" -e REPRO_IMAGE_DIGESTS="$digests"
+  )
+  # A git worktree's metadata lives in the main checkout's .git: mount it at the same path.
+  for d in "$REPO" "$ROCKE_ROOT"; do
+    common=$(git -C "$d" rev-parse --path-format=absolute --git-common-dir 2> /dev/null || true)
+    [ -z "$common" ] || [ "$common" = "$(realpath "$d")/.git" ] || args+=(-v "$common":"$common":ro)
+  done
+  for v in KEEP_GOING CHECKSUM GATE_SET GATES PORT QUICK_PROMPTS QUICK_TOKENS QUICK_MIN_SPEEDUP PAIRS KS ARMS PROMPTS \
+    TOKENS Q38_SHARED_CACHE; do
+    [ -z "${!v:-}" ] || args+=(-e "$v=${!v}")
+  done
+  [ ! -t 0 ] || args+=(-it)
+  echo "repro-rocke: $cmd on HIP device ${GPU:-0}, work dir $WORK, image $IMAGE"
+  exec docker run "${args[@]}" "$IMAGE" bash "/atom/$SELF" "$@"
+fi
+
+# ---------------------------------------------------------------------------------------------
+# Container.
+# ---------------------------------------------------------------------------------------------
+[ "$REPO" = /atom ] || die "inside the container this checkout must be at /atom (repro.sh's layout), not $REPO"
+MODEL=${MODEL:-/model}
+[ -n "${ROCKE_ROOT:-}" ] || die "set ROCKE_ROOT=<rocm-libraries checkout at $ROCKE_BRANCH>"
+if [ -d "$ROCKE_ROOT/dnn-providers/hip-kernel-provider/rocke" ]; then
+  ROCKE=$ROCKE_ROOT/dnn-providers/hip-kernel-provider/rocke
+else
+  ROCKE=$ROCKE_ROOT  # the rocke directory itself
+fi
+[ -d "$ROCKE/library/kernels/gfx950/qwen38_mono" ] || die "ROCKE_ROOT=$ROCKE_ROOT has no rocKE qwen38_mono library"
+KIT=/atom/scripts/qwen38_rocke
+FNS=${FNS:-/work/fns}
+RUN=${RUN_DIR:-/work/runs/$(date -u +%Y%m%dT%H%M%SZ)-rocke-$cmd}
+mkdir -p "$RUN"
+RUN=$(cd "$RUN" && pwd)
+export RUN MODEL ROCKE ATOM_ROOT=/atom Q38_ROCKE_TMP=$RUN/tmp
+mkdir -p "$Q38_ROCKE_TMP"
+
+# repro.sh's container environment (the same exports), then its setup (once; a few minutes on a fresh $WORK)
+export HOME=/work/home TMPDIR=/work/tmp
+export PIP_CACHE_DIR=/work/cache/pip XDG_CACHE_HOME=/work/cache/xdg HF_HOME=/work/cache/hf
+export TRITON_CACHE_DIR=/work/cache/triton TORCHINDUCTOR_CACHE_DIR=/work/cache/inductor
+export FLYDSL_RUNTIME_CACHE_DIR=/work/cache/flydsl
+export MIOPEN_USER_DB_PATH=/work/cache/miopen MIOPEN_CUSTOM_CACHE_DIR=/work/cache/miopen
+export PYTHONDONTWRITEBYTECODE=1 AITER_LOG_LEVEL=WARNING HSA_COREDUMP_PATTERN=/dev/null
+mkdir -p "$HOME" "$TMPDIR" /work/cache
+git config --global --add safe.directory '*'  # the container's own $HOME/.gitconfig (root vs host owner)
+
+TABLE=()
+STEP_FAIL=0
+STEP=
+res() {  # res <check> <PASS|FAIL|WARN> <detail>
+  local line
+  line=$(printf '%-6s %-22s %-4s %s' "$STEP" "$1" "$2" "${3:-}")
+  TABLE+=("$line")
+  echo "repro-rocke: [$STEP] $1: $2 ${3:-}"
+  [ "$2" != FAIL ] || STEP_FAIL=1
+  return 0
+}
+print_table() {
+  {
+    echo "repro_rocke_mono.sh $cmd: results in $RUN"
+    printf '%-6s %-22s %-4s %s\n' step check res detail
+    printf '%s\n' "${TABLE[@]}"
+  } | tee "$RUN/summary.txt"
+}
+on_exit() {
+  print_table > /dev/null 2>&1 || true
+  # host mode: the container runs as root; hand what it wrote back to the caller (as repro.sh does)
+  [ -z "${HOST_UID:-}" ] || chown -R "$HOST_UID:${HOST_GID:-$HOST_UID}" /work "$RUN" "$FNS" 2> /dev/null || true
+}
+trap on_exit EXIT
+
+env_setup() {
+  echo "repro-rocke: environment (repro.sh setup; log $RUN/setup.log)"
+  if ! (REPRO_IN_CONTAINER=1 bash "$MONO_REPRO" setup) > "$RUN/setup.log" 2>&1; then
+    tail -n 30 "$RUN/setup.log"
+    STEP=check res env FAIL "repro.sh setup failed (see setup.log)"
+    print_table
+    exit 1
+  fi
+  # shellcheck disable=SC1091
+  source /work/venv/bin/activate
+  local sp=/work/venv/lib/python3.12/site-packages
+  export ROCM_PATH=$sp/_rocm_sdk_devel HIP_PATH=$sp/_rocm_sdk_devel
+  export LD_LIBRARY_PATH=$ROCM_PATH/lib:$ROCM_PATH/lib/host-math/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
+  export PATH=$ROCM_PATH/bin:$PATH
+  # rocKE: the library and platform on PYTHONPATH (ATOM imports it only when a knob asks), its Python backend
+  export PYTHONPATH=$ROCKE/platform/python:$ROCKE/library${PYTHONPATH:+:$PYTHONPATH}
+  export ROCKE_BACKEND=python
+  # run-local compile caches (fresh compiles), unless Q38_SHARED_CACHE=1
+  Q38_ROCKE_CACHE=$RUN/cache source "$KIT/common/caches.sh"
+  # nothing of this work switched on by the caller's environment: each step sets its own knobs
+  for v in $(env | sed -n 's/^\(ATOM_Q38_[A-Z_]*\)=.*/\1/p'); do unset "$v"; done
+}
+
+# --- check -----------------------------------------------------------------------------------
+ATOM_NEW=(
+  atom/models/qwen4_exp_mono/kernels/extern_stages.py atom/models/qwen4_exp_mono/kernels/numa.py
+  atom/models/qwen4_exp_mono/kernels/sched.py atom/models/qwen4_exp_mono/kernels/stack.py
+  atom/models/qwen4_exp_mono/kernels/stamps.py atom/models/qwen4_exp_mono/q38_hook.py
+  atom/models/qwen4_exp_mono/rocke_head.py
+  tests/test_qwen4_exp_mono_extern_stages.py tests/test_qwen4_exp_mono_extern_moe_pairing.py
+  tests/test_qwen4_exp_mono_sched.py tests/test_qwen4_exp_mono_rocke_head.py tests/test_qwen4_exp_mono_stamps.py
+)
+# modified ATOM files: a marker of this work in each (file|text)
+ATOM_MARKERS=(
+  "atom/models/qwen4_exp_mono/kernels/kernel.py|import extern_stages, numa, sched, stamps"
+  "atom/models/qwen4_exp_mono/kernels/layout.py|def mailbox_bytes"
+  "atom/models/qwen4_exp_mono/kernels/mailbox.py|numa.Box"
+  "atom/models/qwen4_exp_mono/kernels/stages/common.py|schedule lever"
+  "atom/models/qwen4_exp_mono/kernels/stages/delta.py|extern_stages.call_for"
+  "atom/models/qwen4_exp_mono/kernels/stages/delta_group.py|extern_stages.call_for"
+  "atom/models/qwen4_exp_mono/head.py|rocke_head.build"
+  "atom/models/qwen4_exp_mono/runner.py|_numa.prepare"
+  "atom/models/qwen4_exp_mono/draft_runner.py|_numa.prepare"
+  "tests/test_qwen4_exp_mono_build_key.py|ATOM_Q38_STAMPS"
+)
+
+step_check() {
+  local x out
+  out=$(python -c "import torch; p = torch.cuda.get_device_properties(0); print(p.gcnArchName.split(':')[0], p.name)" 2>&1 | tail -1)
+  case $out in gfx950*) res gpu PASS "HIP device $HIP_VISIBLE_DEVICES: $out" ;; *) res gpu FAIL "HIP device $HIP_VISIBLE_DEVICES: $out (needs gfx950)" ;; esac
+  if [ -n "${REPRO_IMAGE:-}" ]; then
+    if [ "$REPRO_IMAGE" != "$PINNED_IMAGE" ]; then
+      res image WARN "IMAGE=$REPRO_IMAGE is not repro.sh's pinned $PINNED_IMAGE"
+    elif [[ " ${REPRO_IMAGE_DIGESTS:-} " == *"@${PINNED_IMAGE#*@}"* ]]; then
+      res image PASS "${PINNED_IMAGE}"
+    else
+      res image FAIL "docker reports digests '${REPRO_IMAGE_DIGESTS:-none}', want ${PINNED_IMAGE#*@}"
+    fi
+  else
+    # inside a container started by someone else: the digest is not visible here; the image's own venv is
+    x=$(/opt/venv/bin/python -c "import torch; print(torch.__version__)" 2> /dev/null || echo none)
+    if [ "$x" = "$IMAGE_TORCH" ] && grep -q 'VERSION_ID="24.04"' /etc/os-release 2> /dev/null; then
+      res image PASS "fingerprint of the pinned image: /opt/venv torch $x, Ubuntu 24.04 (the digest is not visible inside)"
+    else
+      res image FAIL "image fingerprint: /opt/venv torch $x (want $IMAGE_TORCH), $(grep PRETTY_NAME /etc/os-release 2> /dev/null)"
+    fi
+  fi
+  # ATOM: commit / branch, the files of this work
+  if git -C /atom rev-parse HEAD > /dev/null 2>&1; then
+    local head br dirty
+    head=$(git -C /atom rev-parse HEAD) br=$(git -C /atom rev-parse --abbrev-ref HEAD)
+    dirty=$(git --no-optional-locks -C /atom status --porcelain | wc -l)
+    if git -C /atom merge-base --is-ancestor "$BASE_COMMIT" HEAD 2> /dev/null; then
+      res atom-commit PASS "$br @ ${head:0:12} (descends from ${BASE_COMMIT:0:8}; $dirty uncommitted changes)"
+    else
+      res atom-commit FAIL "$br @ ${head:0:12} does not descend from $ATOM_BRANCH ${BASE_COMMIT:0:8}"
+    fi
+  else
+    res atom-commit WARN "/atom is not a git checkout: commit not verifiable (files checked below)"
+  fi
+  local miss=()
+  for x in "${ATOM_NEW[@]}" "scripts/qwen38_rocke/repro_rocke_mono.sh"; do [ -f "/atom/$x" ] || miss+=("$x"); done
+  for x in "${ATOM_MARKERS[@]}"; do grep -q "${x#*|}" "/atom/${x%%|*}" 2> /dev/null || miss+=("${x%%|*} (no '${x#*|}')"); done
+  if [ ${#miss[@]} = 0 ]; then
+    res atom-files PASS "${#ATOM_NEW[@]} new modules / tests and ${#ATOM_MARKERS[@]} markers in the modified files"
+  else
+    res atom-files FAIL "missing: ${miss[*]}"
+  fi
+  # rocm-libraries
+  local rr=$ROCKE_ROOT
+  if git -C "$rr" rev-parse HEAD > /dev/null 2>&1; then
+    local rh rb
+    rh=$(git -C "$rr" rev-parse HEAD) rb=$(git -C "$rr" rev-parse --abbrev-ref HEAD)
+    if [ "$rh" = "$ROCKE_COMMIT" ]; then
+      res rocke-commit PASS "$rb @ ${rh:0:11} (pinned)"
+    elif git -C "$rr" merge-base --is-ancestor "$ROCKE_COMMIT" "$rh" 2> /dev/null; then
+      res rocke-commit WARN "$rb @ ${rh:0:11}: a descendant of the pinned ${ROCKE_COMMIT:0:11}"
+    else
+      res rocke-commit WARN "$rb @ ${rh:0:11}: not the pinned $ROCKE_BRANCH @ ${ROCKE_COMMIT:0:11} or a descendant"
+    fi
+    x=$(git --no-optional-locks -C "$rr" status --porcelain -- "$(realpath --relative-to="$(git -C "$rr" rev-parse --show-toplevel)" "$ROCKE")" 2> /dev/null | wc -l)
+    [ "$x" = 0 ] || res rocke-dirty WARN "$x uncommitted changes under the rocke directory"
+  else
+    res rocke-commit WARN "$rr is not a git checkout: commit not verifiable"
+  fi
+  if out=$(cd /tmp && python -c "
+import rocke, kernels.gfx950.mx_decode_gemv
+from kernels.gfx950.qwen38_mono import stage_b3, stage_moe_fused
+print(rocke.__file__.rsplit('/', 3)[0])" 2>&1); then
+    res rocke-import PASS "rocke, mx_decode_gemv, stage_b3, stage_moe_fused from $(echo "$out" | tail -1)"
+  else
+    res rocke-import FAIL "$(echo "$out" | tail -1)"
+  fi
+  x=$(python -c "import importlib.metadata as m; print(m.version('flydsl'))" 2>&1 | tail -1)
+  [ "$x" = "$FLYDSL_VERSION" ] && res flydsl PASS "$x" || res flydsl FAIL "$x (want $FLYDSL_VERSION)"
+  x=$(git -C /work/src/aiter rev-parse HEAD 2>&1 | tail -1)
+  [ "$x" = "$AITER_COMMIT" ] && res aiter PASS "${x:0:12}" || res aiter FAIL "$x (want $AITER_COMMIT)"
+  if [ "${CHECKSUM:-1}" = 0 ]; then
+    res checkpoint WARN "sha256 skipped (CHECKSUM=0)"
+  elif (cd "$MODEL" && sha256sum --quiet -c /atom/scripts/qwen38_flash_mxfp4/Qwen3.8-Flash-Next-MXFP4.sha256) > "$RUN/checksum.log" 2>&1; then
+    res checkpoint PASS "$(grep -c . /atom/scripts/qwen38_flash_mxfp4/Qwen3.8-Flash-Next-MXFP4.sha256) files match the sha256 list"
+  else
+    res checkpoint FAIL "$(head -3 "$RUN/checksum.log" | tr '\n' ' ')"
+  fi
+}
+
+# --- gen -------------------------------------------------------------------------------------
+step_gen() {
+  rm -rf "$FNS"
+  mkdir -p "$FNS/b3" "$FNS/moe"
+  local lib=$ROCKE/library
+  if (cd "$lib" && ROCKE_LLVM_FLAVOR=llvm23 python -m kernels.gfx950.qwen38_mono.stage_b3 --out "$FNS/b3" --knobs tuned_numa \
+    --variants "$VARIANTS,r4g2") > "$RUN/gen_b3.log" 2>&1; then
+    res gen-b3 PASS "stage_b3 --knobs tuned_numa: $(ls "$FNS/b3" | grep -c '\.ll$') files ($(ls "$FNS/b3" | grep '\.ll$' | sed 's/\.ll$//' | tr '\n' ' '))"
+  else
+    res gen-b3 FAIL "$(tail -2 "$RUN/gen_b3.log" | tr '\n' ' ')"
+  fi
+  if (cd "$lib" && ROCKE_LLVM_FLAVOR=llvm23 python -m kernels.gfx950.qwen38_mono.stage_moe_fused --out "$FNS/moe" \
+    --variants "$VARIANTS" --knobs best) > "$RUN/gen_moe.json" 2> "$RUN/gen_moe.log"; then
+    res gen-moe PASS "stage_moe_fused --knobs best: $(ls "$FNS/moe" | grep -c '\.ll$') files"
+  else
+    res gen-moe FAIL "$(tail -2 "$RUN/gen_moe.log" | tr '\n' ' ')"
+  fi
+  (cd "$FNS" && find b3 moe -type f | sort | xargs sha256sum > manifest.sha256)
+  local out
+  if out=$(python "$KIT/common/check_fns.py" "$FNS" "$VARIANTS" 2>&1); then
+    res sidecars PASS "$(echo "$out" | grep '^FNS' | cut -c5-): symbols, numa1 layouts, B3 body/prologue and MoE m3/m4/m5 pairing"
+  else
+    res sidecars FAIL "$(echo "$out" | grep BAD | head -3 | tr '\n' ' ')"
+  fi
+  echo "repro-rocke: ATOM_Q38_EXTERN_STAGES=m3=$FNS/moe/m3_{variant}.ll,m4=$FNS/moe/m4_{variant}.ll,m5=$FNS/moe/m5_{variant}.ll,b3=$FNS/b3,b3pre=$FNS/b3"
+}
+
+need_fns() {  # the gen step's files, unchanged since (manifest) and consistent (sidecars)
+  local out
+  if [ ! -f "$FNS/manifest.sha256" ]; then
+    res fns FAIL "no generated functions in $FNS (run the gen step)"
+    return 1
+  fi
+  if ! out=$(python "$KIT/common/check_fns.py" "$FNS" "$VARIANTS" 2>&1); then
+    res fns FAIL "$FNS: $(echo "$out" | grep BAD | head -3 | tr '\n' ' ')"
+    return 1
+  fi
+}
+
+# --- unit ------------------------------------------------------------------------------------
+step_unit() {
+  python -m pytest --version > /dev/null 2>&1 || pip install -q "pytest==9.0.3" > "$RUN/pip-pytest.log" 2>&1 || true
+  local t=() x
+  for x in extern_stages extern_moe_pairing sched rocke_head stamps build_key; do t+=("tests/test_qwen4_exp_mono_$x.py"); done
+  if (cd /atom && timeout 1800 python -m pytest -q -p no:cacheprovider "${t[@]}") > "$RUN/unit.log" 2>&1; then
+    res pytest PASS "$(tail -1 "$RUN/unit.log")"
+  else
+    res pytest FAIL "$(tail -1 "$RUN/unit.log") (unit.log)"
+  fi
+}
+
+# --- gate ------------------------------------------------------------------------------------
+G=
+gate_run() {  # gate_run <name> <pass regex> <log> <command...>: one gate command, PASS iff rc 0 and the regex
+  local name=$1 pat=$2 log=$3 rc t0=$SECONDS
+  shift 3
+  echo "repro-rocke: gate $name (log ${log#"$RUN"/})"
+  set +e
+  "$@" > "$log" 2>&1
+  rc=$?
+  set -e
+  if [ $rc = 0 ] && grep -a -q -E "$pat" "$log"; then
+    res "$name" PASS "$(grep -a -E "$pat" "$log" | tail -1 | cut -c1-60) ($((SECONDS - t0)) s)"
+  else
+    res "$name" FAIL "rc $rc; $(grep -a -E 'FAIL|Error|error' "$log" | tail -2 | tr '\n' ' ' | cut -c1-200)"
+  fi
+}
+
+gate_sched() {
+  local kind vs
+  for kind in delta qsa delta_ple; do
+    vs=$VARIANTS
+    [ "${GATE_SET:-full}" = full ] || vs=r4s
+    gate_run "sched-$kind" '^AB PASS' "$G/sched_$kind.log" python "$KIT/sched/ab_sched.py" --check-only --kind "$kind" \
+      --variants "$vs" --arms "best:ATOM_Q38_SCHED=best" --copies 2 --out "$G/sched_$kind.json"
+  done
+  # grouped narrow verify (rows 4 = 2 requests x 2 tokens) of a 4-layer rig: best and numa=1 bitwise vs knobs
+  # off (and a second knobs-off process), a payload-bit mutant must differ
+  local a ok=1
+  for a in off off2 best numa mut; do
+    case $a in off | off2) v= ;; best) v=best ;; numa) v=numa=1 ;; mut) v="best;mutate.c1=1" ;; esac
+    ATOM_Q38_SCHED="$v" python "$KIT/sched/grp_check.py" "$G/grp_$a.pt" > "$G/grp_$a.log" 2>&1 || ok=0
+  done
+  python "$KIT/sched/grp_cmp.py" "$G/grp_off.pt" "$G/grp_off2.pt" "$G/grp_best.pt" "$G/grp_numa.pt" "$G/grp_mut.pt" \
+    > "$G/grp_cmp.txt" 2>&1 || ok=0
+  grep -q "grp_mut.pt DIFFERS" "$G/grp_cmp.txt" || ok=0
+  grep -q -E "^GRP grp_(off2|best|numa).pt DIFFERS" "$G/grp_cmp.txt" && ok=0
+  [ "$(grep -c 'bitwise_equal' "$G/grp_cmp.txt")" = 3 ] || ok=0
+  if [ $ok = 1 ]; then res sched-grouped PASS "r4g2 x 4 layers: off2 / best / numa=1 bitwise, mutant differs"
+  else res sched-grouped FAIL "$(tr '\n' ' ' < "$G/grp_cmp.txt" | cut -c1-200)"; fi
+}
+
+gate_moe() {
+  local B1 BN mut
+  B1=$(cd "$ROCKE/library" && python -c "import json; from kernels.gfx950.qwen38_mono import stage_moe_fused as S; print(json.dumps(S.BEST_KNOBS[1]))")
+  BN=$(cd "$ROCKE/library" && python -c "import json; from kernels.gfx950.qwen38_mono import stage_moe_fused as S; print(json.dumps(S.BEST_KNOBS[0]))")
+  mut() { python -c "import json,sys; d=json.loads(sys.argv[1]); d['mutate']=sys.argv[2]; print(json.dumps(d, separators=(',', ':')))" "$1" "$2"; }
+  chk() {  # chk <name> <knobs> <fused_ab args...>
+    local name=$1 kn=$2
+    shift 2
+    gate_run "moe-$name" '^CHECK_PASS' "$G/moe_$name.log" python "$KIT/moe-fused/fused_ab.py" check "$@" \
+      --arms "hyb:$kn" --mutants "hyb:$(mut "$kn" combine_swap)" --out "$G/moe_$name.json"
+  }
+  local kind v r s c cells
+  for kind in delta qsa delta_ple; do
+    cells="1:0 2:0 3:0 4:0 2:1 3:1 4:1"
+    [ $kind = delta ] || cells="1:0 3:0 2:1 4:1"
+    [ "${GATE_SET:-full}" = full ] || cells="4:1"
+    for v in $cells; do
+      IFS=: read -r r s <<< "$v"
+      c=0.7; [ "$s" = 1 ] || c=0
+      if [ "$r" = 1 ]; then
+        chk "${kind}_r1" "$B1" --kind $kind --rows 1 --seq 0 --copies 2 --inputs 3 --check-cases 3
+      else
+        chk "${kind}_r$r$([ "$s" = 1 ] && echo s)" "$BN" --kind $kind --rows "$r" --seq "$s" --row-corr $c --copies 2 --inputs 3 --check-cases 3
+      fi
+    done
+  done
+  [ "${GATE_SET:-full}" = full ] || return 0
+  chk u40_r4s "$BN" --rows 4 --seq 1 --force-u 40 --copies 2 --inputs 2 --check-cases 2
+  chk u10_r4 "$BN" --rows 4 --seq 0 --force-u 10 --copies 2 --inputs 2 --check-cases 2
+  chk u10_ple_r2 "$BN" --kind delta_ple --rows 2 --seq 0 --force-u 10 --copies 2 --inputs 2 --check-cases 2
+  # launch tags cross step 2^25 inside the cases (a former bug: an OR-ed private tag; xtag_or must differ there)
+  gate_run moe-step25_qsa_r4s '^CHECK_PASS' "$G/moe_step25.log" python "$KIT/moe-fused/fused_ab.py" check --kind qsa \
+    --rows 4 --seq 1 --row-corr 0.7 --step0 $((2 ** 25 - 3)) --arms "hyb:$BN" \
+    --mutants "hyb:$(mut "$BN" xtag_or);hyb:$(mut "$BN" combine_swap)" --copies 2 --inputs 4 --check-cases 4 \
+    --out "$G/moe_step25.json"
+}
+
+gate_b3() {
+  local vs=$VARIANTS,r4g2 v spec
+  [ "${GATE_SET:-full}" = full ] || vs=r1,r4s
+  # the generated files, as served: ATOM_Q38_EXTERN_STAGES=b3=DIR,b3pre=DIR (MISSING=error), ATOM_Q38_SCHED=best:
+  # bitwise on the logical view, the numa lever kept, deterministic
+  gate_run b3-files '^ENVSMOKE PASS' "$G/b3_files.log" python "$KIT/gdn-b3/env_smoke_b3.py" --fns "$FNS/b3" --one-spec \
+    --sched best --variants "$vs"
+  # the tuned NUMA sets in situ with a numerics mutant (exp=hw) that must differ, and the plain layer with the lever
+  for v in ${vs//,/ }; do
+    spec=$(cd "$ROCKE/library" && python -c "from kernels.gfx950.qwen38_mono import stage_b3 as S; print(S.TUNED_SPECS_NUMA['$v'])")
+    gate_run "b3-mutant-$v" '^INSITU PASS' "$G/b3_mutant_$v.log" python "$KIT/gdn-b3/insitu_b3.py" --variants "$v" \
+      --copies 2 --launches 2 --no-time --sched best --arms "rk:$spec" --fn-dir "$Q38_ROCKE_TMP/b3_$v" --out "$G/b3_mutant_$v.json"
+  done
+}
+
+gate_composed() {
+  local vs=$VARIANTS,r4g2
+  [ "${GATE_SET:-full}" = full ] || vs=r1,r4s
+  gate_run composed '^COMBO PASS' "$G/composed.log" python "$KIT/e2e/combo_numa.py" --fns "$FNS" --variants "$vs"
+}
+
+gate_head() {
+  # as the server: rocKE picks its LLVM flavor from the loaded comgr
+  gate_run head '^HEAD PASS' "$G/head.log" env -u ROCKE_LLVM_FLAVOR python "$KIT/head/gate_head.py" --out "$G/head.json"
+}
+
+isa_tree() {  # isa_tree <atom tree> <out.json> <kind> <rows> <seq 0|1>: compile one layer build, its ISA resources
+  local tree=$1 out=$2 kind=$3 rows=$4 sq=
+  [ "$5" = 1 ] && sq=--seq
+  local d=$Q38_ROCKE_TMP/isa_$RANDOM$RANDOM
+  (cd "$tree" && env PYTHONPATH="$tree${PYTHONPATH:+:$PYTHONPATH}" FLYDSL_DUMP_IR=1 FLYDSL_DUMP_DIR="$d" \
+    FLYDSL_RUNTIME_ENABLE_CACHE=0 python -c "import atom, sys; sys.exit(0 if atom.__file__.startswith('$tree/') else 1)" \
+    && env PYTHONPATH="$tree${PYTHONPATH:+:$PYTHONPATH}" FLYDSL_DUMP_IR=1 FLYDSL_DUMP_DIR="$d" FLYDSL_RUNTIME_ENABLE_CACHE=0 \
+      python "$KIT/hybrid/isa_layer.py" --kind "$kind" --rows "$rows" $sq --out "$out") > "$out.log" 2>&1
+  local rc=$?
+  rm -rf "$d"
+  return $rc
+}
+
+gate_isa() {
+  local base=${BASE_ATOM:-}
+  if [ -z "$base" ]; then
+    base=$Q38_ROCKE_TMP/base-atom
+    rm -rf "$base" && mkdir -p "$base"
+    if ! git -C /atom archive "$BASE_COMMIT" | tar -x -C "$base" 2> "$G/isa_base.log"; then
+      res isa FAIL "no BASE_ATOM and /atom's git cannot export $BASE_COMMIT ($(head -1 "$G/isa_base.log"))"
+      return 0
+    fi
+  fi
+  [ -f "$base/atom/models/qwen4_exp_mono/kernels/kernel.py" ] || { res isa FAIL "BASE_ATOM=$base is no ATOM tree"; return 0; }
+  local cells="delta:1:0 delta:4:1 delta:4:0 qsa:1:0 qsa:4:1 delta_ple:1:0 delta_ple:4:1" c kind r s ok=1 n=0 detail=()
+  [ "${GATE_SET:-full}" = full ] || cells="delta:4:1"
+  for c in $cells; do
+    IFS=: read -r kind r s <<< "$c"
+    local nm=${kind}_r$r$([ "$s" = 1 ] && echo s)
+    echo "repro-rocke: gate isa $nm (this tree, knobs off / $BASE_COMMIT)"
+    if isa_tree /atom "$G/isa_cur_$nm.json" "$kind" "$r" "$s" && isa_tree "$base" "$G/isa_base_$nm.json" "$kind" "$r" "$s"; then
+      if python - "$G/isa_cur_$nm.json" "$G/isa_base_$nm.json" << 'PY'
+import json, os, sys
+
+a, b = (json.load(open(p)) for p in sys.argv[1:3])
+same = bool(a) and a == b
+print("ISA", "identical" if same else "DIFFERS", sorted(a), sorted(b))
+for k in sorted(set(a) | set(b)):
+    if a.get(k) != b.get(k):
+        print("  ", k, a.get(k), b.get(k))
+sys.exit(0 if same else 1)
+PY
+      then n=$((n + 1)); else ok=0; detail+=("$nm differs"); fi
+    else
+      ok=0
+      detail+=("$nm: build failed ($(tail -1 "$G/isa_cur_$nm.json.log" "$G/isa_base_$nm.json.log" 2> /dev/null | tr '\n' ' ' | cut -c1-120))")
+    fi
+  done
+  if [ $ok = 1 ]; then res isa PASS "$n builds: instruction body sha and resources equal to ${BASE_COMMIT:0:8} (knobs off)"
+  else res isa FAIL "${detail[*]}"; fi
+}
+
+step_gate() {
+  G=$RUN/gate
+  mkdir -p "$G"
+  need_fns || return 0
+  # stage functions the gates write themselves are lowered for FlyDSL's LLVM, as the gen step's
+  export ROCKE_LLVM_FLAVOR=llvm23
+  local x
+  for x in ${GATES:-sched moe b3 composed head isa}; do
+    "gate_$x"
+  done
+}
+
+# --- quick / full ----------------------------------------------------------------------------
+step_quick() {
+  need_fns || return 0
+  local o=$RUN/quick rc=0
+  ARMS="A ALL" KS=3 PAIRS=2 ORDER=fixed PROMPTS=${QUICK_PROMPTS:-32} TOKENS=${QUICK_TOKENS:-2048} \
+    bash "$KIT/e2e/e2e.sh" "$FNS" "$o" 2>&1 | tee "$RUN/quick.log" || rc=$?
+  local out
+  out=$(python - "$o/ratios.json" "$o/abs.json" "${QUICK_MIN_SPEEDUP:-1.10}" << 'PY'
+import json, sys
+
+r = json.load(open(sys.argv[1]))["k3"]
+ab = json.load(open(sys.argv[2]))["k3"]
+c, a = r["ALL"], r["A"]
+sp, rd, acc = (c.get(m) or {} for m in ("req_speed", "round", "acc"))
+tps = {arm: [x["decode_tok_s_per_request_mean"] for x in ab[arm]] for arm in ("A", "ALL")}
+print("tok/s per run: mono " + " ".join(f"{x:.1f}" for x in tps["A"] if x) + " | full stack " + " ".join(f"{x:.1f}" for x in tps["ALL"] if x))
+print(f"tok/s ratio {sp.get('mean', 0):.3f} (per pair {sp.get('per_pair')}); verify-round ratio {rd.get('mean', 0):.3f};"
+      f" acceptance ratio {acc.get('mean', 0):.3f}; gsm8k right mono {a['gsm8k_correct_total']}/{a['gsm8k_checked_total']},"
+      f" full {c['gsm8k_correct_total']}/{c['gsm8k_checked_total']}")
+lc = {k: v for k, v in r["log_checks"].items() if k.startswith("ALL")}
+cal = sum(len(v["numa_calibrations"]) for v in lc.values())
+agree = min((x[1] for v in lc.values() for x in v["numa_calibrations"]), default=0)
+ext = sorted({e for v in lc.values() for e in v["extern_served"]})
+logs_ok = c["log_checks_ok"] and a["log_checks_ok"]
+print(f"server logs {'ok' if logs_ok else 'FAIL'}: full stack: NUMA calibrated {cal}x (agreement >= {agree:.4f}), "
+      f"rocKE lm_head on {sum(v['head_on'] for v in lc.values())}/{len(lc)}, served r4s externs "
+      f"{' '.join(x.split('/')[0] for x in ext)}, numa=1 in every narrow build; mono: no knob lines")
+ok = (sp.get("mean") or 0) >= float(sys.argv[3]) and logs_ok
+ok &= c["gsm8k_correct_total"] >= 0.8 * a["gsm8k_correct_total"]
+print("QUICK", "PASS" if ok else "FAIL")
+PY
+  ) || true
+  echo "$out" | tee -a "$RUN/quick.log"
+  local line
+  line=$(echo "$out" | grep '^tok/s ratio' || echo "no ratios ($o)")
+  if [ $rc = 0 ] && echo "$out" | grep -q '^QUICK PASS'; then
+    res quick PASS "$line"
+  else
+    res quick FAIL "e2e rc $rc; $line (min tok/s ratio ${QUICK_MIN_SPEEDUP:-1.10}; log checks: $o/ratios.json)"
+  fi
+  if echo "$out" | grep -q '^server logs ok'; then
+    res quick-logs PASS "$(echo "$out" | grep '^server logs' | cut -c17-)"
+  else
+    res quick-logs FAIL "$(echo "$out" | grep '^server logs' || echo "no log checks ($o/ratios.json)")"
+  fi
+  res quick-tok/s INFO "$(echo "$out" | grep '^tok/s per run' || true)"
+}
+
+step_full() {
+  need_fns || return 0
+  local rc=0
+  ORDER=shuffle bash "$KIT/e2e/e2e.sh" "$FNS" "$RUN/full" 2>&1 | tee "$RUN/full.log" || rc=$?
+  if [ $rc = 0 ]; then res full PASS "ratios: $RUN/full/ratios.json"
+  else res full FAIL "rc $rc (full.log, $RUN/full/ratios.json)"; fi
+}
+
+# ---------------------------------------------------------------------------------------------
+STEP=check
+env_setup
+case $cmd in
+  all) steps=(check gen unit gate quick) ;;
+  shell) bash -i || true; exit 0 ;;
+  *) steps=("$cmd") ;;
+esac
+{
+  echo "date: $(date -u)"
+  echo "atom: $(git -C /atom rev-parse HEAD 2> /dev/null || echo n/a) ($(git --no-optional-locks -C /atom status --porcelain 2> /dev/null | wc -l) changed files)"
+  echo "rocke: $ROCKE ($(git -C "$ROCKE_ROOT" rev-parse HEAD 2> /dev/null || echo n/a))"
+  echo "image: ${REPRO_IMAGE:-in-container}  aiter: $AITER_COMMIT  flydsl: $FLYDSL_VERSION"
+  echo "gpu: HIP_VISIBLE_DEVICES=$HIP_VISIBLE_DEVICES"
+  echo "settings: FNS=$FNS GATE_SET=${GATE_SET:-full} QUICK_PROMPTS=${QUICK_PROMPTS:-32} PAIRS=${PAIRS:-6} KS=${KS:-3 0}"
+} > "$RUN/meta.txt"
+rc=0
+for STEP in "${steps[@]}"; do
+  STEP_FAIL=0
+  echo "repro-rocke: ===== $STEP $(date -u +%H:%M:%S)"
+  "step_$STEP"
+  if [ $STEP_FAIL = 1 ]; then
+    rc=1
+    [ "${KEEP_GOING:-0}" = 1 ] || { echo "repro-rocke: $STEP FAILED; stopping (KEEP_GOING=1 runs the rest)"; break; }
+  fi
+done
+print_table
+[ $rc = 0 ] && echo "repro-rocke: ALL PASS" || echo "repro-rocke: FAIL"
+exit $rc
diff --git a/scripts/qwen38_rocke/sched/ab_sched.py b/scripts/qwen38_rocke/sched/ab_sched.py
