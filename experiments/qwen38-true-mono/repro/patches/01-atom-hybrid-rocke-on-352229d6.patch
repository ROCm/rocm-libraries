+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+"""NUMA dual-copy mailboxes (schedule lever ``ATOM_Q38_SCHED=numa=1``; off by
+default, narrow builds only).
+
+On gfx950 the home IOD of an address (where an sc1 load of it is served) is
+address bit 13 XOR a per-2 MiB-page constant (measured: the rocKE
+``persistent_mailbox`` IOD calibration). With the lever on, every mailbox
+region lives in a NUMA area of the scratch instead, twice: byte ``x`` of the
+mailbox part (the offset a plain build uses) sits at ``x + (x & ~8191)`` and
+``+ 8192`` in the area (8 KiB chunks of the two copies interleaved, so the
+copies of a chunk are on opposite IODs). Producers store both copies; a
+consumer polls the copy homed at its own IOD: ``copy = iod ^ f(page)``, ``f``
+from the area's calibration (:func:`calibrate`, written to the scratch header
+the kernel reads at entry). An uncalibrated header (``f = 0``) is still
+correct, just remote on half the pages.
+
+Layout from the scratch base (bytes): the header at :func:`header_offset`
+(word 0: the page mask, word 1: :data:`MAGIC`), then the area at the next
+2 MiB boundary past it, :func:`area_bytes` long.
+"""
+
+import functools
+
+import flydsl.expr as fx
+from flydsl._mlir.dialects import llvm
+from flydsl.compiler.ast_rewriter import ASTRewriter
+from flydsl.expr.typing import T
+
+from atom.models.qwen4_exp_mono.kernels import buffer_ops as bo
+from atom.models.qwen4_exp_mono.kernels.device_ops import rsrc
+
+CHUNK = 8192
+PAGE = 1 << 21
+MAGIC = 0x4E554D41  # "NUMA"
+CM_DEV = 16  # mailbox.CM_DEV
+
+
+def header_offset():
+    """Scratch offset of the NUMA header: past every other scratch region
+    (mailboxes, stamps, blame, spin, side copies), whether or not those are on."""
+    from atom.models.qwen4_exp_mono.kernels import sched
+
+    return sched.side_delta() + _mailbox_bytes()
+
+
+def _mailbox_bytes():
+    from atom.models.qwen4_exp_mono.kernels.layout import MAX_ROWS, mailbox_bytes
+
+    return mailbox_bytes(MAX_ROWS)
+
+
+def area_bytes():
+    return 2 * _mailbox_bytes()
+
+
+def scratch_bytes_needed():
+    """Scratch bytes a build with the lever needs (header, alignment slack, area)."""
+    return header_offset() + 256 + PAGE + area_bytes()
+
+
+def area_base(scratch_ptr):
+    """Host: the area's address for a scratch at ``scratch_ptr``."""
+    a = scratch_ptr + header_offset() + 256
+    return (a + PAGE - 1) & ~(PAGE - 1)
+
+
+def phys(x):
+    """Byte ``x`` of the mailbox part -> its copy-0 offset in the area."""
+    return x + (x & ~(CHUNK - 1))
+
+
+# ------------------------------------------------------------- device side
+
+
+def xcc_id():
+    asm = llvm.InlineAsmOp(
+        T.i32, [], "s_getreg_b32 $0, hwreg(HW_REG_XCC_ID)", "=s", has_side_effects=False
+    )
+    return fx.Int32(asm.result) & 0xF
+
+
+def iod_id():
+    return (xcc_id() >> 2) & 1
+
+
+class Box:
+    """A mailbox region's address in a ``numa`` build: the scratch base and the
+    region's static byte offset in the mailbox part (``layout.SC``). Stage code
+    passes it to ``mailbox`` as it would the plain address; static ``+``/``-``
+    move the offset (``qsa_fast._mailboxes``)."""
