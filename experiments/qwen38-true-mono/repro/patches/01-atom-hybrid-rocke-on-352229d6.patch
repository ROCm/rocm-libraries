index 0000000000000000000000000000000000000000..119a89211c4942b531b8feab259a9f2d50575dbc
--- /dev/null
+++ b/scripts/qwen38_rocke/sched/grp_check.py
@@ -0,0 +1,62 @@
+"""Grouped narrow verify (rows 4 = 2 requests x 2 tokens, ``group_runner``'s builds) of a 4-layer rig
+(delta, delta_ple, delta, qsa), one process per ``ATOM_Q38_SCHED`` setting: one step of the four layers,
+then every output and written state dumped to a .pt for ``grp_cmp.py`` (bitwise vs the knob-off dump).
+The A/B rigs (``sched_rig``) build only ungrouped variants; this covers the grouped narrow cells the
+served path launches at CONC 2 with k = 1 (after a reviewer's check, sched-rev3).
+
+    ATOM_Q38_SCHED=best python grp_check.py out.pt
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+for d in (os.path.join(HERE, "..", "harness"), os.path.join(HERE, "harness")):
+    if os.path.isdir(d):
+        sys.path.insert(0, d)
+
+import torch
+from rig import MonoRig
+
+from atom.models.qwen4_exp_mono.kernels import numa as NUMA
+from atom.models.qwen4_exp_mono.kernels import sched as SCH
+from atom.models.qwen4_exp_mono.kernels.kernel import STAGES
+
+KINDS = ["delta", "delta_ple", "delta", "qsa"]
+
+
+def main(out, context=2048, seed=3):
+    rig = MonoRig(
+        KINDS, experts=512, context=context, spec_tokens=1, max_groups=2, seed=seed
+    )
+    r = rig.runner
+    need = NUMA.scratch_bytes_needed() // 4
+    if (NUMA.wanted() or NUMA.wanted("dyn")) and r.scratch.numel() < need:
+        r.scratch = torch.zeros(need, dtype=torch.int32, device="cuda")
+    cal = NUMA.prepare(r.scratch)
+    print("CAL", cal and (hex(cal[0]), round(cal[1], 4)), flush=True)
+    s = rig.group_step(2)
+    g = torch.Generator(device="cuda")
+    g.manual_seed(11)
+    s.w.h0.copy_(torch.randn(s.w.h0.shape, generator=g, device="cuda").bfloat16())
+    rig.meta(s)
+    for i in range(len(KINDS)):
+        rig.launch(s, i)
+    torch.cuda.synchronize()
+    st = rig.state
+    d = {"chain": s.w.chain.clone().cpu(), "rec": st.rec.clone().cpu(), "conv": st.conv.clone().cpu(),
+         "ple": st.ple_conv.clone().cpu()}  # fmt: skip
+    for name, t in st.qsa[3].items():
+        if isinstance(t, torch.Tensor):
+            d["qsa." + name] = t.clone().cpu()
+    for k in ("delta", "delta_ple", "qsa"):
+        print("KNOBS", k, SCH.resolve(False, 4, False, 2, tuple(STAGES[k])), flush=True)
+    print("nonzero", bool((s.w.chain != 0).any()), "keys", list(d), flush=True)
+    torch.save(d, out)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1]))
diff --git a/scripts/qwen38_rocke/sched/grp_cmp.py b/scripts/qwen38_rocke/sched/grp_cmp.py
new file mode 100644
index 0000000000000000000000000000000000000000..2def8428a1e87142fda8579056d536d339cf3b27
--- /dev/null
+++ b/scripts/qwen38_rocke/sched/grp_cmp.py
@@ -0,0 +1,31 @@
+"""Bitwise comparison of grp_check.py dumps: ``python grp_cmp.py REF.pt A.pt [B.pt ...]`` (bytes differing per key)."""
+
+import sys
+
+import torch
+
+
+def main(argv):
+    a = torch.load(argv[0])
+    for f in argv[1:]:
+        b = torch.load(f)
+        diff = {
+            k: int(
+                (
+                    a[k].contiguous().view(torch.uint8)
+                    != b[k].contiguous().view(torch.uint8)
+                ).sum()
+            )
+            for k in a
+        }
+        print(
+            "GRP",
+            f.split("/")[-1],
+            "bitwise_equal" if not any(diff.values()) else "DIFFERS",
+            diff,
+            flush=True,
+        )
+
+
+if __name__ == "__main__":
+    main(sys.argv[1:])
diff --git a/scripts/qwen38_rocke/sched/sched_rig.py b/scripts/qwen38_rocke/sched/sched_rig.py
new file mode 100644
index 0000000000000000000000000000000000000000..fccc5facc717bc78a3b85cd442c0ee492d478714
--- /dev/null
+++ b/scripts/qwen38_rocke/sched/sched_rig.py
@@ -0,0 +1,392 @@
+"""In-situ layer rig of the schedule track: the plain mono layer and any number of arms built with
+schedule knobs (ATOM ``kernels/sched.py``: ``ATOM_Q38_BLAME`` / ``SPIN`` / ``DELAY`` / ``SCHED``,
+plus ``ATOM_Q38_STAMPS``), one process, one variant.
+
+- Arms are environment overrides (``{"ATOM_Q38_SCHED": "pause=2"}``); every arm is its own build
+  (``kernel._build_layer`` with the arm's resolved knobs) bound to the same weights, inputs, state.
+- ``check(name)``: bitwise vs the plain mono build after one launch from the same snapshot and tag:
+  the scratch's mailbox part, the layer output, every state the kind writes (DeltaNet conv /
+  recurrent rows, QSA caches, PLE conv).
+- ``rounds(names, R)``: R rounds; per round the arms (``mono``, its graph control ``mono2`` = a
+  second graph of the plain build, and its compile control ``mono_rc`` = a separately compiled
+  build of the same code: ``ATOM_Q38_SCHED=pause=0``, another kernel name / code object) run in a
+  SHUFFLED order (seeded per round), ``reps`` replays each; ratio per round vs that round's
+  ``mono``. Gate (``summarize``): WIN only if the arm's median is below the minimum of BOTH
+  controls' rounds by ``MARGIN`` and >= 3/4 of its rounds are < 1 (LOSS mirrored). ``refs``:
+  the same gate on the per-round ratio arm / ref arm (e.g. ``BEST`` vs ``N``), the controls'
+  spread taken around 1.
+
+Absolute times only in the JSON the callers write (``--out``); consoles print ratios.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import os
+import random
+import statistics
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+for d in (os.path.join(HERE, "..", "harness"), os.path.join(HERE, "harness")):
+    if os.path.isdir(d):
+        sys.path.insert(0, d)
+
+import torch
+from rig import MonoRig
+
+from atom.models.qwen4_exp_mono.kernels import kernel as K
+from atom.models.qwen4_exp_mono.kernels import layout as LY
+from atom.models.qwen4_exp_mono.kernels import sched as SCH
+from atom.models.qwen4_exp_mono.kernels import stamps as STAMPS
+
+BASE_KINDS = ["delta", "delta_ple", "delta", "qsa"]
+SLOTS = 48
+H_IN = K.LAYER_ARGS[1:].index("h_in")
+H_OUT = K.LAYER_ARGS[1:].index("h_out")
+ENV_KEYS = (
+    "ATOM_Q38_STAMPS",
+    SCH.ENV_BLAME,
+    SCH.ENV_SPIN,
+    SCH.ENV_DELAY,
+    SCH.ENV_SCHED,
+)
+CONTROLS = ("mono2", "mono_rc")
+RC_ENV = {
+    SCH.ENV_SCHED: "pause=0"
+}  # same code as mono, compiled separately (own kernel name)
+MARGIN = 0.002  # a win must clear both controls' minimum by this much (sched-rev1: a recompiled mono 0.998)
+
+
+def parse_variant(v):
+    import re
+
+    m = re.fullmatch(r"r(\d)(s?)", v)
+    if not m:
+        raise ValueError(f"variant {v!r}: r<rows>[s]")
+    return int(m.group(1)), bool(m.group(2))
+
+
+@contextlib.contextmanager
+def env(over):
+    """Only the schedule / stamp knobs of ``over`` set, every other one of ``ENV_KEYS`` unset."""
+    saved = {k: os.environ.get(k) for k in ENV_KEYS}
+    try:
+        for k in ENV_KEYS:
+            os.environ.pop(k, None)
+        for k, v in (over or {}).items():
+            assert k in ENV_KEYS, k
+            if v is not None:
+                os.environ[k] = str(v)
+        yield
+    finally:
+        for k, v in saved.items():
+            if v is None:
+                os.environ.pop(k, None)
+            else:
+                os.environ[k] = v
+
+
+def debug_scratch_bytes():
+    """A scratch big enough for every stamped / blame / spin build."""
+    with env({"ATOM_Q38_STAMPS": "1", SCH.ENV_BLAME: "1", SCH.ENV_SPIN: "1"}):
+        return LY.scratch_bytes(LY.MAX_ROWS)
+
+
+class LayerRig:
+    def __init__(self, kind, variant, copies=16, experts=512, context=8192, dump=None, real=None,
+                 launches=96, seed=0, share_experts=False, inputs=8):  # fmt: skip
+        self.kind, self.variant = kind, variant
+        self.rows, self.seq = parse_variant(variant)
+        self.copies, self.experts, self.launches = copies, experts, launches
+        self.stages = K.STAGES[kind]
+        torch.cuda.empty_cache()
+        kinds = BASE_KINDS + [kind] * copies
+        self.idx = list(range(len(BASE_KINDS), len(kinds)))
+        realmap = {i: real for i in self.idx} if real else None
+        spec_tokens = self.rows - 1 if self.seq else 0
+        self.rig = MonoRig(kinds, experts=experts, context=context, spec_tokens=spec_tokens, seed=seed,
+                           share_experts=share_experts, dump=dump, real=realmap)  # fmt: skip
+        r = self.r = self.rig.runner
+        from atom.models.qwen4_exp_mono.kernels import numa as NUMA
+
+        n = max(debug_scratch_bytes(), NUMA.scratch_bytes_needed()) // 4
+        if r.scratch.numel() < n:
+            r.scratch = torch.zeros(n, dtype=torch.int32, device="cuda")
+        # the NUMA area's header (``numa`` lever arms): calibrated once per rig
+        self.numa_cal = NUMA.calibrate(r.scratch)
+        self.s = s = self.rig.step(self.rows)
+        g = self.g = torch.Generator(device="cuda")
+        g.manual_seed(77 + seed)
+        # random layer inputs: a one-layer launch's input is otherwise zero (HYBRID.md section 4)
+        s.w.h0.copy_(torch.randn(s.w.h0.shape, generator=g, device="cuda").bfloat16())
+        s.w.chain.copy_(
+            torch.randn(s.w.chain.shape, generator=g, device="cuda").bfloat16()
+        )
+        self.rig.meta(s)
+        r.counter.add_(1)
+        hdr = NUMA.header_offset() // 4
+        keep = r.scratch[hdr : hdr + 2].clone()
+        r.scratch.zero_()
+        r.scratch[hdr : hdr + 2] = keep
+        torch.cuda.synchronize()
+        i0 = self.idx[0]
+        st = self.rig.state
+        self.live = {"scratch": r.scratch, "h_out": s.w.chain[i0]}
+        if kind == "qsa":
+            for name, t in st.qsa[i0].items():
+                if isinstance(t, torch.Tensor):
+                    self.live["qsa." + name] = t
+        else:
+            self.live["rec"], self.live["conv"] = st.rec, st.conv
+            if kind == "delta_ple":
+                self.live["ple_conv"] = st.ple_conv
+        self.snap = {k: t.clone() for k, t in self.live.items()}
+        self.counter0 = r.counter.clone()
+        width = self.rig.geometry.hc_width
+        ins = [
+            torch.randn(self.rows, width, generator=g, device="cuda").bfloat16()
+            for _ in range(inputs)
+        ]
+        self._keep = ins
+        self.outs = [
+            torch.zeros(self.rows, width, dtype=torch.bfloat16, device="cuda")
+            for _ in self.idx
+        ]
+        self.largs = []
+        for j in range(launches):
+            c = j % copies
+            lst = list(s.w.args[self.idx[c]])
+            lst[H_IN] = ins[j % len(ins)].data_ptr()
+            lst[H_OUT] = self.outs[c].data_ptr()
+            self.largs.append(lst)
+        self.builds, self.envs, self.graphs = {}, {}, {}
+        self.add("mono", {})
+        self.ref = self.run_once("mono")
+
+    # ------------------------------------------------------------ builds
+    def add(self, name, over):
+        with env(over):
+            stamped = STAMPS.enabled()
+            sk = SCH.resolve(stamped, self.rows, self.seq, 0, tuple(self.stages))
+        self.envs[name] = dict(over)
+        self.knobs = getattr(self, "knobs", {})
+        self.knobs[name] = sk
+        self.builds[name] = K._build_layer(
+            self.stages, self.experts, self.rows, self.seq, 0, stamped, (), sk
+        )
+        return self.builds[name]
+
+    def run_once(self, name, slot=7):
+        r = self.r
+        for k, t in self.live.items():
+            t.copy_(self.snap[k])
+        cur = r.counter.clone()
+        r.counter.copy_(self.counter0)
+        torch.cuda.synchronize()
+        self.builds[name](r.counter.data_ptr(), slot, r.scratch.data_ptr(), *self.s.w.args[self.idx[0]],
+                          stream=torch.cuda.current_stream())  # fmt: skip
+        torch.cuda.synchronize()
+        out = {k: t.clone() for k, t in self.live.items()}
+        r.counter.copy_(torch.maximum(cur, self.counter0))
+        torch.cuda.synchronize()
+        return out
+
+    def _mask(self, name, t):
+        if name != "scratch":
+            return t
+        mb = LY.mailbox_bytes(LY.MAX_ROWS) // 4
+        return t[:mb]  # stamps / blame / side copies: clocks
+
+    def _logical(self, name, got):
+        """A ``numa`` arm's mailboxes from its NUMA area (copy 0), and whether copy 1 equals copy 0."""
+        from atom.models.qwen4_exp_mono.kernels import numa as NUMA
+
+        t = got["scratch"]
+        mb = LY.mailbox_bytes(LY.MAX_ROWS) // 4
+        live = self.r.scratch.data_ptr()  # the area's alignment is the live scratch's
+        base_w = (NUMA.area_base(live) - live) // 4
+        w = torch.arange(mb, device=t.device)
+        ph = base_w + w + (w & ~2047)
+        c0 = t[ph]
+        c1 = t[ph + 2048]
+        return c0, bool(torch.equal(c0, c1))
+
+    def check(self, name, mutant=False):
+        got = self.run_once(name)
+        dd = {}
+        numa_arm = bool(
+            SCH.from_knobs(self.knobs.get(name, ())).levers.get("numa")
+        )  # resolved (``best`` too)
+        if numa_arm:
+            c0, same = self._logical(name, got)
+            if not same:
+                dd["numa_copies"] = {"copy1_differs": True}
+            got = dict(got)
+            full = got["scratch"].clone()
+            full[: c0.numel()] = c0
+            got["scratch"] = full
+        for k in self.live:
+            a, b = self._mask(k, self.ref[k]), self._mask(k, got[k])
+            if not torch.equal(a, b):
+                av, bv = a.contiguous().view(torch.uint8), b.contiguous().view(
+                    torch.uint8
+                )
+                bad = (av != bv).nonzero().flatten()
+                dd[k] = {"bytes_differ": int(bad.numel()), "first_byte": int(bad[0])}
+        if mutant:
+            return {"differs": bool(dd), "diff": dd}
+        again = self.run_once(name)
+        if numa_arm:
+            c0, _ = self._logical(name, again)
+            again = dict(again)
+            full = again["scratch"].clone()
+            full[: c0.numel()] = c0
+            again["scratch"] = full
+        det = all(
+            torch.equal(self._mask(k, got[k]), self._mask(k, again[k]))
+            for k in self.live
+        )
+        nz = bool((got["h_out"] != 0).any())
+        return {"bitwise": not dd, "deterministic": det, "out_nonzero": nz, "diff": dd}
+
+    # ------------------------------------------------------------ timing
+    def graph(self, name, key=None):
+        key = key or name
+        if key in self.graphs:
+            return self.graphs[key]
+        r, launch = self.r, self.builds[name]
+
+        def run_all(stream):
+            for j, lst in enumerate(self.largs):
+                launch(
+                    r.counter.data_ptr(),
+                    j % SLOTS,
+                    r.scratch.data_ptr(),
+                    *lst,
+                    stream=stream,
+                )
+                if j % SLOTS == SLOTS - 1 and j != len(self.largs) - 1:
+                    r.counter.add_(1)
+            r.counter.add_(1)
+
+        gr = torch.cuda.CUDAGraph()
+        cs = torch.cuda.Stream()
+        cs.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(cs):
+            run_all(cs)
+        torch.cuda.synchronize()
+        with torch.cuda.graph(gr, stream=cs):
+            run_all(cs)
+        torch.cuda.synchronize()
+        for _ in range(3):
+            gr.replay()
+        torch.cuda.synchronize()
+        self.graphs[key] = gr
+        return gr
+
+    def replay_us(self, key, reps):
+        gr = self.graphs[key]
+        ts = []
+        for _ in range(reps):
+            e0, e1 = torch.cuda.Event(enable_timing=True), torch.cuda.Event(
+                enable_timing=True
+            )
+            e0.record()
+            gr.replay()
+            e1.record()
+            torch.cuda.synchronize()
+            ts.append(e0.elapsed_time(e1) * 1e3 / self.launches)
+        return statistics.median(ts)
+
+    def rounds(self, names, nrounds=12, reps=5, seed=0, refs=None):
+        """``names``: arms (``mono``, ``mono2`` and ``mono_rc`` are added). ``refs``: {arm: ref arm}
+        pairs gated on arm / ref per round too. Returns per-round per-arm us and ratios.
+        """
+        if "mono_rc" not in self.builds:
+            self.add("mono_rc", RC_ENV)
+        arms = ["mono", *CONTROLS] + [n for n in names if n not in ("mono", *CONTROLS)]
+        for n in arms:
+            self.graph("mono" if n == "mono2" else n, key=n)
+        per = []
+        for k in range(nrounds):
+            order = list(arms)
+            random.Random(seed * 1000 + k).shuffle(order)
+            us = {n: self.replay_us(n, reps) for n in order}
+            per.append(
+                {
+                    "order": order,
+                    "us": us,
+                    "ratio": {n: us[n] / us["mono"] for n in arms},
+                }
+            )
+        return {"arms": arms, "rounds": per, "summary": summarize(per, arms, refs)}
+
+    def free(self):
+        self.graphs.clear()
+        self.builds.clear()
+        del self.rig
+        torch.cuda.empty_cache()
+
+
+def _gate(rs, cmin, cmax, margin):
+    med = statistics.median(rs)
+    below = sum(r < 1 for r in rs)
+    return {
+        "median": med,
+        "min": min(rs),
+        "max": max(rs),
+        "rounds_below_1": below,
+        "rounds": len(rs),
+        "win": med < cmin - margin and below >= 0.75 * len(rs),
+        "loss": med > cmax + margin and (len(rs) - below) >= 0.75 * len(rs),
+    }
+
+
+def summarize(per, arms, refs=None, margin=MARGIN):
+    """Gate every arm against BOTH controls (``CONTROLS``); ``refs`` {arm: ref}: also arm / ref per
+    round, against the controls' spread around 1 (each control's ratio as is)."""
+    ctl = {c: [p["ratio"][c] for p in per] for c in CONTROLS if c in arms}
+    allc = [x for v in ctl.values() for x in v]
+    cmin, cmax = min(allc), max(allc)
+    out = {}
+    for n in arms:
+        rs = [p["ratio"][n] for p in per]
+        g = _gate(rs, cmin, cmax, margin)
+        if n in ("mono", *CONTROLS):
+            g["win"] = g["loss"] = False
+        out[n] = g
+    for n, ref in (refs or {}).items():
+        if n in arms and ref in arms:
+            rs = [p["ratio"][n] / p["ratio"][ref] for p in per]
+            out[f"{n}/{ref}"] = _gate(rs, cmin, cmax, margin)
+    out["_control"] = {
+        "min": cmin,
+        "max": cmax,
+        "median": statistics.median(allc),
+        **{
+            c: {"min": min(v), "max": max(v), "median": statistics.median(v)}
+            for c, v in ctl.items()
+        },
+    }
+    return out
+
+
+def fmt_summary(summ):
+    lines = []
+    c = summ["_control"]
+    lines.append(
+        f"control (mono2, mono_rc)/mono median {c['median']:.4f} [{c['min']:.4f}, {c['max']:.4f}]"
+        + "".join(
+            f" {k} {c[k]['median']:.4f} [{c[k]['min']:.4f}, {c[k]['max']:.4f}]"
+            for k in CONTROLS
+            if k in c
+        )
+    )
+    for n, s in summ.items():
+        if n.startswith("_") or n == "mono":
+            continue
+        tag = "WIN" if s["win"] else ("LOSS" if s["loss"] else "noise")
+        lines.append(f"{n:40s} median {s['median']:.4f} [{s['min']:.4f}, {s['max']:.4f}] "
+                     f"<1: {s['rounds_below_1']}/{s['rounds']} {tag}")  # fmt: skip
+    return "\n".join(lines)
