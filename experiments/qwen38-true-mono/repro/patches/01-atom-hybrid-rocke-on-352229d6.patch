index 0000000000000000000000000000000000000000..39e22aa870dc6f9626771756e1b00b5fd27f49a2
--- /dev/null
+++ b/atom/models/qwen4_exp_mono/kernels/extern_stages.py
@@ -0,0 +1,355 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+"""External stage bodies for the layer kernel (hybrid path; off by default).
+
+``ATOM_Q38_EXTERN_STAGES="q2=<path>[,<stage>=<path>...]"`` when a layer kernel
+is built (``build_layer``; the setting and the linked files' contents are in
+the build's key): each listed stage runs an externally compiled device
+function instead of its FlyDSL body, with the same inputs, outputs,
+mailboxes and task assignment. The kernel computes the launch tag and the
+CTA's task index as for its own stage and calls::
+
+    void @rocke_q38_<stage>_<variant>(i32 tag, i32 task, i64 step, i32 layer,
+        i64 <LAYER_ARGS...>, i32 l0, i32 l1, i32 l2, i32 l3, i32 lds_base)
+
+``variant`` = ``r<rows>`` + ``s`` (seq) + ``g<S>`` (grouped); ``l0..l3`` the
+QSA rows' cache lengths (``p.Ls``; 0 past the rows and in other kinds);
+``lds_base`` the LDS arena's byte address. The function comes from rocKE
+(``kernels/gfx950/qwen38_mono/stage_fn.py`` in the rocKE library), which
+writes ``<stage>_<variant>.ll`` (LLVM text), ``.bc`` (bitcode, with an
+assembler) and a ``.json`` sidecar holding the symbol and the ABI.
+
+``<path>``: a file template with ``{variant}`` (``/x/q2_{variant}.ll``), or a
+directory holding ``<stage>_<variant>.bc`` or ``.ll``. FlyDSL links it into the
+kernel's module before LLVM's optimization (``flydsl.compiler.extern_link``;
+MLIR internalizes the linked function, so the call is normally inlined).
+A build whose sidecar's symbol or ABI differs from this kernel's raises. A
+build whose variant has no file raises too, unless
+``ATOM_Q38_EXTERN_MISSING=mono``: then that build keeps the FlyDSL body of the
+stage and a line on stderr names the variant (e.g. a server that also
+prepares grouped widths the rocKE function does not cover yet). Extern-linked kernels
+are not written to FlyDSL's disk cache (FlyDSL's rule), so every process
+compiles them once.
+
+A stamped build (``ATOM_Q38_STAMPS=1``) records the extern stage's enter and
+exit; its per-wave ready points stay 0 (the polls are inside the function).
+
+Prologues: a key ``<stage>pre`` (e.g. ``b3pre=<path>``, symbol
+``rocke_q38_b3pre_<variant>``, same ABI) names a function that the stage
+*before* ``<stage>`` calls inside its body for this CTA's task of
+``<stage>`` (:func:`call_for`; e.g. B1 calls ``b3pre`` after issuing its
+weight loads, before it waits for the mixed row), so ``<stage>``'s function
+can find data on chip. Only with ``<stage>`` itself extern too (the prologue
+fills that function's LDS arena). Stages that host a prologue: B1 for
+``b3pre`` (``stages/delta.py``, ``delta_group.py``).
+
+A stage function that reads what its prologue left in LDS says so in its
+sidecar: ``"needs": ["b3pre"]`` (rocKE ``stage_b3.write_b3_functions``, knob
+``pre="dma"``); both sidecars may carry ``"stage_knobs"`` (the rocKE knob
+spec they were built with), which must then agree. Such a stage without its
+prologue in the knob raises; with the prologue's file missing under
+``ATOM_Q38_EXTERN_MISSING=mono`` the build drops BOTH back to FlyDSL. A
+prologue is linked only together with its stage's function, and not when that
+function's sidecar lists ``needs`` without it (it would only add work). A
+sidecar without ``needs`` reads nothing from a prologue (older files, the
+``stage_fn`` registry's default bodies).
+
+Layer kinds: ``{kind}`` in a ``<path>`` (``/x/m4_{kind}_{variant}.ll``) is
+the build's layer kind (``delta``, ``delta_ple`` or ``qsa``, :func:`kind_of`),
+so a stage can have per-kind functions, or (with ``ATOM_Q38_EXTERN_MISSING=mono``)
+a function for some kinds only.
+
+NUMA: a sidecar ``"mailboxes": "numa1"`` says the function addresses the
+mailboxes as a build with the ``numa=1`` schedule lever does (``numa``:
+every mailbox in the scratch's NUMA area); such a build keeps the lever
+(:func:`numa_kept`) and refuses to link without it. ``"numa_hdr": <offset>``
+says the function uses the NUMA area at all (also for private copies with
+plain mailboxes otherwise); it must match ``numa.header_offset()`` and the
+area must exist (a ``numa`` lever somewhere in ``ATOM_Q38_SCHED``). Plain
+functions (no such keys) drop the lever for their build (``kernel``).
+
+Pairing: a sidecar ``"requires": {"<stage>": <pair id or null>}`` (rocKE
+``stage_moe``: M5 reusing the rocKE M4's LDS routing tables, and M4, whose
+tables only the rocKE M5 reads) names stages that must be extern in the same
+build; with a pair id, the required stage's sidecar must carry
+``"pair": <id>`` (the same generation). A build that links a stage without
+its requirements raises.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import sys
+from dataclasses import dataclass
+
+ENV = "ATOM_Q38_EXTERN_STAGES"
+# Stages whose prologue (``<stage>pre``) another stage can host (module docstring).
+PRE_HOSTS = ("b3",)
+MISSING_ENV = "ATOM_Q38_EXTERN_MISSING"  # "error" (default) | "mono"
+SYMBOL_PREFIX = "rocke_q38_"
+L_ARGS = 4  # l0 .. l3
+
+
+@dataclass(frozen=True)
+class ExternStage:
+    stage: str
+    path: str  # the linked file (.ll or .bc)
+    symbol: str
+    ffi_types: tuple
+    digest: str  # sha256 of the linked file's contents (in the build key)
+    # mailbox layout the function addresses: "plain" (the layout without the
+    # ``numa`` schedule lever) | "numa1" (the lever's NUMA area, ``numa=1``)
+    mailboxes: str = "plain"
+
+
+def variant(rows: int, seq: bool, group: int) -> str:
+    return f"r{rows}" + ("s" if seq else "") + (f"g{group}" if group else "")
+
+
+def parse(value: str | None) -> dict:
+    """``{stage: path}`` from the knob's value (empty: off)."""
+    out = {}
+    for item in (value or "").split(","):
+        item = item.strip()
+        if not item:
+            continue
+        stage, sep, path = item.partition("=")
+        if not sep or not stage or not path:
+            raise ValueError(f"{ENV}: expected <stage>=<path>, got {item!r}")
+        if stage in out:
+            raise ValueError(f"{ENV}: stage {stage!r} listed twice")
+        out[stage.strip()] = path.strip()
+    return out
+
+
+def requested() -> dict:
+    return parse(os.environ.get(ENV))
+
+
+def expected_abi(layer_args) -> list:
+    return (
+        [["tag", "i32"], ["task", "i32"], ["step", "i64"], ["layer", "i32"]]
+        + [[n, "i64"] for n in layer_args]
+        + [[f"l{i}", "i32"] for i in range(L_ARGS)]
+        + [["lds_base", "i32"]]
+    )
+
+
+def kind_of(stages) -> str:
+    """The layer kind of a build running ``stages`` (``kernel._build_layer``'s rule)."""
+    if any(s.startswith("q") for s in stages):
+        return "qsa"
+    if any(s in ("p1", "p2") for s in stages):
+        return "delta_ple"
+    return "delta"
+
+
+def _file(stage: str, path: str, var: str, fallback: str = "this build runs the FlyDSL stage") -> str:
+    if "{variant}" in path:
+        f = path.format(variant=var)
+    elif os.path.isdir(path):
+        stem = os.path.join(path, f"{stage}_{var}")
+        f = next((stem + e for e in (".bc", ".ll") if os.path.isfile(stem + e)), stem + ".ll")
+    else:
+        f = path
+    if not os.path.isfile(f):
+        policy = os.environ.get(MISSING_ENV, "error")
+        if policy == "mono":
+            print(
+                f"[{ENV}] no {stage} function for build variant {var} ({f}): {fallback}",
+                file=sys.stderr,
+            )
+            return None
+        if policy != "error":
+            raise ValueError(f"{MISSING_ENV} must be error or mono, got {policy!r}")
+        raise FileNotFoundError(
+            f"{ENV}: no {stage} function for build variant {var} ({f})"
+        )
+    return f
+
+
+def resolve(stages, rows, seq, group, layer_args, known, spec=None) -> tuple:
+    """The :class:`ExternStage` of each requested stage this build runs, in
+    stage order (``spec``: ``{stage: path}``, default the environment's;
+    ``known``: every stage name of every layer kind). A requested stage of
+    another kind is not in this build and is skipped."""
+    spec = requested() if spec is None else spec
+    known_pre = {f"{s}pre" for s in PRE_HOSTS}
+    unknown = set(spec) - set(known) - known_pre
+    if unknown:
+        raise ValueError(f"{ENV}: unknown stage(s) {sorted(unknown)}")
+    for name in set(spec) & known_pre:
+        if name[: -len("pre")] not in spec:
+            raise ValueError(f"{ENV}: {name} needs {name[: -len('pre')]} extern too")
+    var = variant(rows, seq, group)
+    kind = kind_of(stages)
+    spec = {s: p.replace("{kind}", kind) for s, p in spec.items()}
+    metas = {}
+
+    def load(stage, fallback=None):
+        """(file, sidecar, ExternStage) of ``stage``; None when its file is
+        missing under ``ATOM_Q38_EXTERN_MISSING=mono``."""
+        f = _file(stage, spec[stage], var, *((fallback,) if fallback else ()))
+        if f is None:
+            return None
+        side = os.path.splitext(f)[0] + ".json"
+        with open(side) as fh:
+            meta = json.load(fh)
+        sym = f"{SYMBOL_PREFIX}{stage}_{var}"
+        if meta.get("symbol") != sym:
+            raise ValueError(f"{side}: symbol {meta.get('symbol')!r}, expected {sym!r}")
+        if meta.get("abi") != expected_abi(layer_args):
+            raise ValueError(f"{side}: ABI differs from the layer kernel's")
+        with open(f, "rb") as fh:
+            digest = hashlib.sha256(fh.read()).hexdigest()[:16]
+        _check_numa(side, meta)
+        return f, side, meta, ExternStage(
+            stage, os.path.abspath(f), sym, tuple(meta["ffi_types"]), digest,
+            meta.get("mailboxes", "plain"),
+        )  # fmt: skip
+
+    out = []
+    for stage in stages:
+        if stage not in spec:
+            continue
+        body = load(stage)
+        if body is None:
+            continue  # the FlyDSL stage (and no prologue for it)
+        f, side, meta, ext = body
+        metas[stage] = (side, meta)
+        needs = meta.get("needs", [])
+        for n in needs:
+            if n not in known_pre or n[: -len("pre")] != stage:
+                raise ValueError(f"{side}: needs {n!r}, not a prologue of {stage!r}")
+            if n not in spec:
+                raise ValueError(
+                    f"{ENV}: {stage} {var} ({f}) reads LDS its prologue {n} fills: add {n}=<path>"
+                )
+        pre = f"{stage}pre"
+        pre_ext = None
+        if pre in known_pre and pre in spec and ("needs" not in meta or pre in needs):
+            p = load(pre, f"{stage} {var} runs the FlyDSL stage too" if pre in needs else "no prologue linked")
+            if p is None:
+                if pre in needs:
+                    continue  # the body cannot run without it: both stay FlyDSL
+            else:
+                pk, bk = p[2].get("stage_knobs"), meta.get("stage_knobs")
+                if pk is not None and bk is not None and pk != bk:
+                    raise ValueError(
+                        f"{p[1]}: built with knobs {pk!r}, its stage {side} with {bk!r}"
+                    )
+                pre_ext = p[3]
+        for e in (ext, pre_ext):
+            if e is not None:
+                out.append(e)
+                print(f"[{ENV}] {e.stage} {var}: {e.symbol} from {e.path} ({e.digest})", file=sys.stderr)
+    linked = {e.stage for e in out}
+    for stage, (side, meta) in metas.items():
+        if stage not in linked:
+            continue
+        for req, pair in (meta.get("requires") or {}).items():
+            if req not in linked:
+                raise ValueError(f"{side}: {stage} {var} ({kind}) needs {req} extern in the same build")
+            if pair is not None and metas[req][1].get("pair") != pair:
+                raise ValueError(
+                    f"{side}: {stage} {var} needs the {req} of its own generation (pair {pair!r}), "
+                    f"got {metas[req][1].get('pair')!r} ({metas[req][0]})"
+                )
+    return tuple(out)
+
+
+def _check_numa(side, meta) -> None:
+    """A sidecar's NUMA needs (module docstring, "NUMA"): its ``mailboxes``
+    layout is known, and a function that reads or writes the NUMA area
+    (``"numa_hdr"``: the header offset it was built for) runs only where the
+    scratch has that area (a ``numa`` lever in ``ATOM_Q38_SCHED``) at that
+    offset."""
+    mb = meta.get("mailboxes", "plain")
+    if mb not in ("plain", "numa1"):
+        raise ValueError(f"{side}: mailboxes {mb!r}, expected 'plain' or 'numa1'")
+    hdr = meta.get("numa_hdr")
+    if hdr is None:
+        if mb == "numa1":
+            raise ValueError(f"{side}: mailboxes 'numa1' without numa_hdr")
+        return
+    from atom.models.qwen4_exp_mono.kernels import numa
+
+    if hdr != numa.header_offset():
+        raise ValueError(
+            f"{side}: built for the NUMA header at {hdr}, this ATOM's is at {numa.header_offset()}"
+        )
+    if not numa.wanted():
+        raise ValueError(
+            f"{side}: the function uses the scratch's NUMA area: needs a numa lever in "
+            "ATOM_Q38_SCHED (the area is sized and calibrated only then)"
+        )
+
+
+def numa_kept(externs, levers) -> bool:
+    """Whether a build with ``externs`` keeps its ``numa`` lever (``levers``:
+    the resolved schedule levers): only when every linked function addresses
+    the lever's layout (``"mailboxes": "numa1"``) and the lever is ``numa=1``.
+    Raises when some do and the build does not run that lever (the functions
+    would poll mailboxes no stage writes)."""
+    if not externs:
+        return True
+    n1 = [e for e in externs if e.mailboxes == "numa1"]
+    if not n1:
+        return False
+    lever = levers.get("numa", 0)
+    if len(n1) != len(externs) or lever != 1:
+        raise ValueError(
+            f"{ENV}: {', '.join(e.stage for e in n1)} address the numa=1 mailbox layout; the build "
+            f"(numa lever {lever!r}, functions {[(e.stage, e.mailboxes) for e in externs]}) does not"
+        )
+    return True
+
+
+def key(externs) -> tuple:
+    """The build-key entries (stage, file digest) of ``externs``."""
+    return tuple((e.stage, e.digest) for e in externs)
+
+
+def suffix(externs) -> str:
+    """Kernel-name suffix: ``_x`` + a digest of the linked functions."""
+    if not externs:
+        return ""
+    h = hashlib.sha256(repr(key(externs)).encode()).hexdigest()[:8]
+    return "_x" + h
+
+
+_FNS = {}
+
+
+def _function(e: ExternStage):
+    from flydsl.compiler.extern_link import link_extern
+    from flydsl.expr.extern import ffi
+
+    fn = _FNS.get(e)
+    if fn is None:
+        fn = _FNS[e] = link_extern(ffi(e.symbol, list(e.ffi_types), "void"), bitcode_path=e.path)
+    return fn
+
+
+def call_for(c, name, task_stage):
+    """Inside another stage's body (trace time): call the resolved extern
+    ``name`` (``c.extern``) for this CTA's task of ``task_stage``, with the
+    kernel's tag, arguments and LDS arena (as the stage call does)."""
+    import flydsl.expr as fx
+    from flydsl._mlir.dialects import llvm
+    from flydsl.expr.typing import T
+
+    from atom.models.qwen4_exp_mono.kernels.stages.common import task_index
+
+    lds_base = fx.Int32(llvm.PtrToIntOp(T.i32, c.lds_i.llvm_ptr).result)
+    call(c.extern[name], c.tag, task_index(c, task_stage), c.raw, [], lds_base)
+
+
+def call(e: ExternStage, tag, task, raw, ls, lds_base):
+    """Emit the call (trace time, inside the kernel body). ``raw``: ``step``,
+    ``layer`` and the :data:`LAYER_ARGS` values; ``ls``: up to 4 i32."""
+    ls = list(ls)[:L_ARGS]
+    ls += [0] * (L_ARGS - len(ls))
+    _function(e)(tag, task, *raw, *ls, lds_base)
