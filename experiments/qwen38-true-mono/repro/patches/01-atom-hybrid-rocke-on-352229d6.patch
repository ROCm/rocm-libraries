+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+"""Two-layer stacked launch (schedule track lever, off by default: nothing in
+the served path builds it unless ``ATOM_Q38_STACK=2``).
+
+:func:`build_stack` compiles ONE launch running two consecutive layers of the
+same kind and variant: layer A (the kernel arguments, as
+``kernel.build_layer``'s launcher) then layer B, whose arguments come from a
+device table at ``nxt`` (:func:`table_bytes`): int64 entries ``[0]`` layer B's
+id, ``[1]`` layer B's scratch, ``[2 ..]`` layer B's ``LAYER_ARGS[1:]``; at
+byte :data:`XL_OFF` the cross-layer pairs (``GRID`` tagged pairs).
+
+Hand-off A -> B (no grid sync): every CTA with an M5 task of layer A, after
+its M5 body, waits for its stores (``vmcnt(0)``, a CTA barrier), and thread 0
+writes them back (``buffer_wbl2 sc1``) and puts the pair ``task`` of the XL
+area with layer A's tag (the mailbox rule for bulk data, ``mailbox``). Layer
+B's tasks that read ``h_in`` first (A1, A2: before any poll of theirs) wait
+for every XL pair (wave 0 spins, ``mailbox.pre_poll``), then thread 0
+acquires (``buffer_inv sc1``) and the CTA barriers. Every other stage of B
+reads ``h_in`` only after polling a (transitive) consumer of A1 / A2 (C1's
+residual, P2's), so its data is out by then, and its CTA's L2 was invalidated
+after the XL pairs by an A1 / A2 task CTA of the same XCD (A1's tasks cover
+every XCD). Layer B runs on its own scratch (its mailboxes, and with the
+``numa`` lever its own NUMA area): a CTA of layer B may put while a slower one
+still polls layer A's regions. Layer B's CTAs that have no A1 / A2 task
+start its stages (and their weight streams) as soon as they leave layer A:
+the run-ahead the stack buys, against one XL round trip on A1 / A2.
+
+Each layer's results are bit-identical to its own ``build_layer`` launch.
+Narrow, ungrouped builds of the delta and qsa kinds; no stamps / blame / spin
+/ extern stages.
+"""
+
+import functools
+import os
+from types import SimpleNamespace
+
+import flydsl.compiler as flyc
+import flydsl.expr as fx
+from flydsl._mlir.dialects import llvm
+from flydsl.compiler.ast_rewriter import ASTRewriter
+from flydsl.expr import const_expr, gpu, range_constexpr, rocdl
+from flydsl.expr.typing import Int32, Int64
+
+from atom.models.qwen4_exp_mono.kernels import buffer_ops as bo
+from atom.models.qwen4_exp_mono.kernels import kernel as K
+from atom.models.qwen4_exp_mono.kernels import mailbox as mbx
+from atom.models.qwen4_exp_mono.kernels import sched, stamps
+from atom.models.qwen4_exp_mono.kernels.config import DEFAULT, GRID, THREADS
+from atom.models.qwen4_exp_mono.kernels.device_ops import rsrc, uniform
+from atom.models.qwen4_exp_mono.kernels.layout import (
+    MAX_ROWS,
+    ORDERS,
+    SPLIT_GROUPS,
+    for_rows,
+)
+from atom.models.qwen4_exp_mono.kernels.stages.common import table_entry, task_index
+from atom.models.qwen4_exp_mono.kernels.stages.qsa import QSA_STATE, qsa_len
+from atom.models.qwen4_exp_mono.sources import SOURCES
+
+ENV = "ATOM_Q38_STACK"
+NARGS = len(K.LAYER_ARGS) - 1  # layer B's LAYER_ARGS[1:]
+XL_OFF = 512  # bytes: the XL pairs in the table buffer
+WAITERS = ("a1", "a2")  # layer B's stages reading h_in before any poll
+
+
+def enabled():
+    v = os.environ.get(ENV, "0")
+    if v not in ("0", "2", ""):
+        raise ValueError(f"{ENV}={v!r}: 0 or 2")
+    return v == "2"
+
+
+def table_bytes():
+    return XL_OFF + GRID * 8
+
+
+def fill_table(table, layer_b, scratch_b, args_b):
+    """Host: layer B's entries of a table tensor (int64, ``table_bytes() // 8``
+    entries; the XL pairs past them are never cleared: the tag is the flag)."""
+    assert len(args_b) == NARGS
+    vals = [int(layer_b), int(scratch_b)] + [int(a) for a in args_b]
+    table[: len(vals)].copy_(
+        __import__("torch").tensor(vals, dtype=table.dtype, device="cpu")
+    )
+
+
+def _asm(text):
+    llvm.InlineAsmOp(None, [], text, "", has_side_effects=True)
+
+
+def _xl_release_body(c, xl, tag, tasks, fence):
+    t = task_index(c, "m5")
+    if t < tasks:
+        rocdl.s_waitcnt(vmcnt=0)  # this wave's h_out stores
+        gpu.barrier()  # every wave's
+        if fx.thread_idx.x == 0:
+            if const_expr(fence):
+                _asm("buffer_wbl2 sc1\n\ts_waitcnt vmcnt(0)")
+            mbx.put(xl, t, fx.Int32(1), tag)
+
+
+_xl_release = ASTRewriter.transform(_xl_release_body)
+
+
+def _xl_wait_body(c, stage, hint, tag, tasks, producers, fence):
+    t = task_index(c, stage)
+    if t < tasks:
+        mbx.pre_poll(
+            hint, producers, tag
+        )  # wave 0 spins on every XL pair, then a barrier
+        if const_expr(fence):
+            _xl_acquire()  # thread 0's buffer_inv sc1, then a barrier
+        else:
+            gpu.barrier()
+
+
+_xl_wait = ASTRewriter.transform(_xl_wait_body)
+
+
+def _xl_wait_all(hint, tag, producers):
+    """``waiters="all"``: every CTA waits for every XL pair at layer B's entry
+    (a grid-wide hand-off in place of the launch boundary)."""
+    mbx.pre_poll(hint, producers, tag)
+    _xl_acquire()
+
+
+def _xl_acquire_body():
+    if fx.thread_idx.x == 0:
+        _asm("buffer_inv sc1\n\ts_waitcnt vmcnt(0)")
+    gpu.barrier()
+
+
+_xl_acquire = ASTRewriter.transform(_xl_acquire_body)
+
+
+def build_stack(stages, experts=DEFAULT.experts, rows=1, seq=False, waiters="h_in"):
+    """Launcher ``(step, layer, *LAYER_ARGS, nxt, stream)`` of the two-layer
+    stack of ``stages`` (layer B from the table at ``nxt``), at the current
+    schedule knobs (``sched.resolve``; the ``numa`` lever moves both layers'
+    mailboxes, each into its own scratch's area). ``waiters``: ``h_in`` (only
+    layer B's A1 / A2 tasks wait for the XL pairs) or ``all`` (every CTA, at
+    layer B's entry: no run-ahead). ``h_in_nofence``: ``h_in`` without the
+    release / acquire fences: NOT correct (stale lines possible), a timing
+    diagnostic of the fences' cost only."""
+    assert rows <= MAX_ROWS and not stamps.enabled()
+    assert waiters in ("h_in", "all", "h_in_nofence"), waiters
+    sknobs = sched.resolve(False, rows, seq, 0, tuple(stages))
+    sk = sched.from_knobs(sknobs)
+    assert not (sk.blame or sk.spin), "stack: no blame / spin builds"
+    assert not sched.dyn_stages(sknobs), "stack: no dyn levers"
+    return _build_stack(tuple(stages), experts, rows, seq, sknobs, waiters)
+
+
+@functools.cache
+def _build_stack(stages, experts, rows, seq, sknobs, waiters="h_in"):
+    kind = sched.kind_of(stages)
+    assert kind in ("delta", "qsa") and stages == ORDERS[kind], (kind, stages)
+    lds_words = for_rows(rows, seq).lds_words
+    records = dict(K.RECORDS, h_in=K.RECORDS["h_in"] * rows)
+    records["hc_norm_w"] = DEFAULT.hc_width * 2  # a1_preload reads it out of range
+    nst = len(stages)
+    numa_mode = sched.from_knobs(sknobs).levers.get("numa", 0)
+    fence = waiters != "h_in_nofence"
+    keyed = (
+        ("stack", 2),
+        ("waiters", waiters),
+        ("stages", stages),
+        ("experts", experts),
+        ("rows", rows),
+        ("seq", seq),
+        ("sources", SOURCES),
+        ("sched", sknobs),
+    )
+
+    @fx.struct
+    class Smem:
+        w: fx.Array[fx.Int32, lds_words, 16]
+
+    def resources(args):
+        return SimpleNamespace(
+            **{
+                name: bo.create_buffer_resource_from_addr(
+                    a, num_records_bytes=records.get(name)
+                )
+                for name, a in zip(K.LAYER_ARGS[1:], args)
+                if name not in K.RAW_ARGS
+            },
+            **{
+                "a_" + name: a
+                for name, a in zip(K.LAYER_ARGS[1:], args)
+                if name in K.RAW_ARGS
+            },
+        )
+
+    def layer_loop(c, p, xl=None, tag_a=None):
+        def hint(m):
+            return xl, m
+
+        if const_expr(tag_a is not None and waiters == "all"):
+            _xl_wait_all(hint, tag_a, c.L.tasks["m5"])
+        hs = sched.head_sleep(sknobs, K.HEAD_SLEEP) if sknobs else K.HEAD_SLEEP
+        if const_expr(hs > 0):
+            K._head_sleep(c, hs)
+        if const_expr(any(s in QSA_STATE for s in stages)):
+            qsa_len(p, rows, seq)
+        for i in range_constexpr(nst):
+            if const_expr(c.L.split and i > 0):
+                halves = {SPLIT_GROUPS.get(s) for s in stages[i - 1 : i + 1]}
+                if const_expr(halves == {0, 1}):
+                    gpu.barrier()
+            if const_expr(
+                tag_a is not None and waiters != "all" and stages[i] in WAITERS
+            ):
+                _xl_wait(
+                    c,
+                    stages[i],
+                    hint,
+                    tag_a,
+                    fx.Int32(c.L.tasks[stages[i]]),
+                    c.L.tasks["m5"],
+                    fence,
+                )
+            sched.stage_enter(i, stages[i], c, p)
+            K._run(stages[i], c, p, stages)
+            sched.stage_leave(i, stages[i], c)
+
+    @flyc.kernel(
+        name={"h_in": "qwen4s2_", "all": "qwen4s2a_", "h_in_nofence": "qwen4s2x_"}[waiters] + "_".join(stages) + f"_e{experts}" + (f"_r{rows}" if rows > 1 else "")
+        + ("_s" if seq else "") + sched.suffix(sknobs),
+        known_block_size=[THREADS, 1, 1],
+    )  # fmt: skip
+    def qwen4_stack(
+        step: Int64, layer: Int32, scratch: Int64, ple: Int64, h_in: Int64, hc_norm_w: Int64,
+        w_down: Int64, s_down: Int64, w_up: Int64, s_up: Int64, w_inj: Int64, w_qkvz: Int64,
+        s_qkvz: Int64, conv_w: Int64, conv_in: Int64, conv_out: Int64, ba_w: Int64, a_log: Int64,
+        dt_bias: Int64, norm_w: Int64, rec_in: Int64, rec_out: Int64, w_qsa: Int64, s_qsa: Int64,
+        qsa: Int64, w_out: Int64, s_out: Int64, m_norm_w: Int64, m_w_down: Int64, m_s_down: Int64,
+        m_w_up: Int64, m_s_up: Int64, m_w_inj: Int64, r_w: Int64, e_w_gu: Int64, e_s_gu: Int64,
+        sh_w_gu: Int64, sh_s_gu: Int64, e_w_dn: Int64, e_s_dn: Int64, sh_w_dn: Int64, sh_s_dn: Int64,
+        h_out: Int64, nxt: Int64,
+    ):  # fmt: skip
+        stamps.reset()
+        sched.reset()
+        lds = fx.SharedAllocator().allocate(Smem).peek()
+        sched.begin(sknobs, None, None, nst, scratch)
+        # ---- layer A: kernel.build_layer's body (narrow, starts with A1)
+        c = K._context(kind, step, layer, scratch, lds, experts, rows, seq, 0, True)
+        sched.apply_layout(c, sknobs)
+        args = (
+            ple, h_in, hc_norm_w, w_down, s_down, w_up, s_up, w_inj, w_qkvz, s_qkvz, conv_w, conv_in,
+            conv_out, ba_w, a_log, dt_bias, norm_w, rec_in, rec_out, w_qsa, s_qsa, qsa, w_out,
+            s_out, m_norm_w, m_w_down, m_s_down, m_w_up, m_s_up, m_w_inj, r_w, e_w_gu, e_s_gu,
+            sh_w_gu, sh_s_gu, e_w_dn, e_s_dn, sh_w_dn, sh_s_dn, h_out,
+        )  # fmt: skip
+        p = resources(args)
+        c.extern = {}
+        c.raw = None
+        c.pre = K.a1_preload(c, p)
+        rocdl.sched_barrier(0)
+        c.tag = uniform(c.step_word) * mbx.LAYER_SLOTS + layer + 1
+        tbl = rsrc(nxt)
+        xl = fx.Int64(nxt) + fx.Int64(XL_OFF)
+        layer_loop(c, p)
+        _xl_release(c, xl, c.tag, fx.Int32(c.L.tasks["m5"]), fence)
+        # ---- layer B: its arguments from the table, its own scratch
+        gpu.barrier()  # no wave of this CTA still reads layer A's LDS entries
+        layer_b = fx.Int32(bo.buffer_load(tbl, 0, vec_width=1, is_scalar=True))
+        scratch_b = table_entry(tbl, 1)
+        args_b = [table_entry(tbl, 2 + k) for k in range(NARGS)]
+        if const_expr(numa_mode):
+            sched.rebase_numa(scratch_b, numa_mode)
+        c2 = K._context(
+            kind, step, layer_b, scratch_b, lds, experts, rows, seq, 0, False
+        )
+        sched.apply_layout(c2, sknobs)
+        p2 = resources(args_b)
+        c2.extern = {}
+        c2.raw = None
+        layer_loop(c2, p2, xl, c.tag)
+        sched.end()
+        _ = keyed
+
+    @flyc.jit
+    def launch(
+        step: Int64, layer: Int32, scratch: Int64, ple: Int64, h_in: Int64, hc_norm_w: Int64,
+        w_down: Int64, s_down: Int64, w_up: Int64, s_up: Int64, w_inj: Int64, w_qkvz: Int64,
+        s_qkvz: Int64, conv_w: Int64, conv_in: Int64, conv_out: Int64, ba_w: Int64, a_log: Int64,
+        dt_bias: Int64, norm_w: Int64, rec_in: Int64, rec_out: Int64, w_qsa: Int64, s_qsa: Int64,
+        qsa: Int64, w_out: Int64, s_out: Int64, m_norm_w: Int64, m_w_down: Int64, m_s_down: Int64,
+        m_w_up: Int64, m_s_up: Int64, m_w_inj: Int64, r_w: Int64, e_w_gu: Int64, e_s_gu: Int64,
+        sh_w_gu: Int64, sh_s_gu: Int64, e_w_dn: Int64, e_s_dn: Int64, sh_w_dn: Int64, sh_s_dn: Int64,
+        h_out: Int64, nxt: Int64,
+        stream: fx.Stream = fx.Stream(None),  # noqa: B008
+    ):  # fmt: skip
+        _ = keyed
+        qwen4_stack(
+            step, layer, scratch, ple, h_in, hc_norm_w, w_down, s_down, w_up, s_up, w_inj, w_qkvz,
+            s_qkvz, conv_w, conv_in, conv_out, ba_w, a_log, dt_bias, norm_w, rec_in, rec_out, w_qsa,
+            s_qsa, qsa, w_out, s_out, m_norm_w, m_w_down, m_s_down, m_w_up, m_s_up, m_w_inj, r_w,
+            e_w_gu, e_s_gu, sh_w_gu, sh_s_gu, e_w_dn, e_s_dn, sh_w_dn, sh_s_dn, h_out, nxt,
+        ).launch(grid=(GRID,), block=(THREADS,), stream=stream)  # fmt: skip
+
+    return launch
