+++ b/scripts/qwen38_rocke/gdn-b3/env_smoke_b3.py
@@ -0,0 +1,139 @@
+"""ATOM-knob path smoke: the B3 functions written by the rocKE CLI
+(``python -m kernels.gfx950.qwen38_mono.stage_b3 --out DIR --knobs tuned``), enabled through
+``ATOM_Q38_EXTERN_STAGES`` (+ ``ATOM_Q38_EXTERN_MISSING=mono``) and built by ATOM's own
+``build_layer``, against the plain mono layer: bitwise per variant (scratch minus B3's private
+exchange / stamps, layer output, every state pool), deterministic.
+
+    python env_smoke_b3.py --fns DIR [--variants r1,r2,...] [--one-spec] [--misconf]
+
+``--one-spec``: every variant under the ONE serving setting ``b3=DIR,b3pre=DIR`` with
+``ATOM_Q38_EXTERN_MISSING=error`` (bodies whose sidecar does not need ``b3pre`` link alone).
+``--misconf``: a ``pre="dma"`` body must never link without its prologue: ``b3=DIR`` alone raises,
+and with the prologue file missing under ``MISSING=mono`` nothing is linked (the plain layer).
+``--sched SPEC`` (``best`` / ``numa=1``): the builds run with ``ATOM_Q38_SCHED=SPEC`` (calibrated NUMA area);
+a build whose functions are ``numa1`` (``--knobs tuned_numa``) must KEEP the numa lever (else FAIL: a silent
+drop) and is compared on its logical view (copy 0 of the area; copy 1 == copy 0).
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+
+from insitu_b3 import Insitu, diff
+
+from atom.models.qwen4_exp_mono.kernels import kernel as K
+
+
+def misconf(fns, variants):
+    """CPU-side resolution of the two misconfigurations (no launch needed: nothing may link)."""
+    import shutil
+    import tempfile
+
+    from atom.models.qwen4_exp_mono.kernels import extern_stages as X
+
+    ok = True
+    nopre = tempfile.mkdtemp()
+    for f in os.listdir(fns):
+        if not f.startswith("b3pre_"):
+            shutil.copy(os.path.join(fns, f), nopre)
+    for v in variants:
+        if not os.path.exists(os.path.join(fns, f"b3pre_{v}.ll")):
+            continue
+        rows, seq, group = int(v[1]), "s" in v, 0
+        args = (K.STAGES["delta"], rows, seq, group, K.LAYER_ARGS, K._ALL_STAGES)
+        try:
+            X.resolve(*args, spec={"b3": fns})
+            alone = "LINKED (bug)"
+        except ValueError as e:
+            alone = "raises: " + str(e)[:120]
+        os.environ["ATOM_Q38_EXTERN_MISSING"] = "mono"
+        dropped = X.resolve(*args, spec={"b3": nopre, "b3pre": nopre})
+        os.environ.pop("ATOM_Q38_EXTERN_MISSING", None)
+        res = {
+            "variant": v,
+            "b3_alone": alone,
+            "pre_missing_mono_links": [e.stage for e in dropped],
+        }
+        ok &= alone.startswith("raises") and not dropped
+        print("MISCONF", json.dumps(res), flush=True)
+    shutil.rmtree(nopre)
+    return ok
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--fns", required=True)
+    ap.add_argument("--variants", default="r1,r2,r3,r4,r2s,r3s,r4s")
+    ap.add_argument("--one-spec", action="store_true")
+    ap.add_argument("--misconf", action="store_true")
+    ap.add_argument("--sched", default=None)
+    a = ap.parse_args()
+    ok = True
+    if a.misconf:
+        ok &= misconf(a.fns, a.variants.split(","))
+    for v in a.variants.split(","):
+        os.environ.pop("ATOM_Q38_EXTERN_STAGES", None)
+        ins = Insitu(v, copies=2, launches=2, sched=a.sched)
+        pre = os.path.exists(os.path.join(a.fns, f"b3pre_{v}.ll"))
+        if a.one_spec:
+            os.environ["ATOM_Q38_EXTERN_STAGES"] = f"b3={a.fns},b3pre={a.fns}"
+            os.environ["ATOM_Q38_EXTERN_MISSING"] = "error"
+        else:
+            os.environ["ATOM_Q38_EXTERN_STAGES"] = f"b3={a.fns}" + (
+                f",b3pre={a.fns}" if pre else ""
+            )
+            os.environ["ATOM_Q38_EXTERN_MISSING"] = "mono"
+        if a.sched:
+            os.environ["ATOM_Q38_SCHED"] = a.sched
+        build = K.build_layer(ins.stages, ins.experts, ins.rows, ins.seq, ins.group)
+        # what ATOM's build_layer decided for this build (its own rule, recomputed): externs, numa lever kept
+        from atom.models.qwen4_exp_mono.kernels import extern_stages as X
+        from atom.models.qwen4_exp_mono.kernels import sched as SCH
+
+        ext = X.resolve(
+            tuple(ins.stages), ins.rows, ins.seq, ins.group, K.LAYER_ARGS, K._ALL_STAGES
+        )
+        sk = SCH.resolve(False, ins.rows, ins.seq, ins.group, tuple(ins.stages))
+        kept = bool(SCH.from_knobs(sk).levers.get("numa")) and X.numa_kept(
+            ext, SCH.from_knobs(sk).levers
+        )
+        n1 = bool(ext) and all(e.mailboxes == "numa1" for e in ext)
+        os.environ.pop("ATOM_Q38_SCHED", None)
+        got = ins.run_once(build)
+        again = ins.run_once(build)
+        same = True
+        if kept:
+            got, same = ins.logical(got)
+            again, _ = ins.logical(again)
+        dd = {
+            k: x for k, x in ((k, diff(ins.ref[k], got[k], k)) for k in ins.live) if x
+        }
+        det = all(diff(got[k], again[k], k) is None for k in ins.live)
+        res = {
+            "variant": v,
+            "b3pre": pre,
+            "bitwise": not dd,
+            "deterministic": det,
+            "externs": [[e.stage, e.mailboxes] for e in ext],
+            "numa_kept": kept,
+            "numa_copies_equal": same,
+            "diff": dd,
+        }
+        ok &= res["bitwise"] and det and same and bool(ext)
+        if a.sched and n1:
+            ok &= kept  # numa1 functions under a numa lever: the lever must stay on
+        print("ENVSMOKE", json.dumps(res), flush=True)
+        os.environ.pop("ATOM_Q38_EXTERN_STAGES", None)
+        ins.free()
+    print("ENVSMOKE", "PASS" if ok else "FAIL")
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
