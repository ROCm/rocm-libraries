new file mode 100644
index 0000000000000000000000000000000000000000..b80b989e5d7ed4948f7ec23b32efcb1140e84f73
--- /dev/null
+++ b/atom/models/qwen4_exp_mono/kernels/stamps.py
@@ -0,0 +1,162 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+"""Per-CTA stage stamps of the layer kernel (debug / measurement only, off by
+default).
+
+``ATOM_Q38_STAMPS=1`` when a layer kernel is built (``build_layer``; the
+setting is in the build's key): every CTA records the ``s_memrealtime``
+(100 MHz device clock) at
+
+- point 0, the kernel entry;
+- per stage ``i`` of the build (in its order): :func:`enter_ix` and
+  :func:`exit_ix`, thread 0 entering and leaving the stage; and
+  :func:`ready_ix` ``(i, w)``, lane 0 of wave ``w`` leaving its last mailbox
+  poll of the stage (``mailbox.poll_raw``): the wave's inputs were ready then.
+
+The stamps sit in LDS until the kernel ends (a global store per stamp would
+sit on every later ``s_waitcnt vmcnt``), then each CTA writes its
+:data:`POINTS` int64 to the scratch tail, past every mailbox region:
+``[LAYER_SLOTS][GRID][POINTS]`` at :func:`offset` from the scratch base,
+indexed by the launch's ``layer``. A point never reached reads 0.
+:func:`scratch_extra` is the bytes ``layout.scratch_bytes`` adds for it.
+
+Off, nothing here is traced: the builds are unchanged.
+"""
+
+import os
+
+import flydsl.expr as fx
+from flydsl._mlir.dialects import llvm
+from flydsl.compiler.ast_rewriter import ASTRewriter
+from flydsl.expr import gpu, range_constexpr
+from flydsl.expr.typing import T
+
+from atom.models.qwen4_exp_mono.kernels import buffer_ops as bo
+from atom.models.qwen4_exp_mono.kernels.config import GRID, THREADS
+
+ENV = "ATOM_Q38_STAMPS"
+WAVES = THREADS // 64
+LAYER_SLOTS = 64  # mailbox.LAYER_SLOTS
+MAX_STAGES = 15  # the QSA layer's
+PER_STAGE = 2 + WAVES  # enter, exit, ready of each wave
+POINTS = 160
+assert 1 + MAX_STAGES * PER_STAGE <= POINTS
+LAUNCH_BYTES = GRID * POINTS * 8
+REGION_BYTES = LAYER_SLOTS * LAUNCH_BYTES
+
+# Trace time only: (LDS stamp pointer, stage index) while a stamped build
+# traces a stage, read by ``mailbox.poll_raw``.
+CURRENT = None
+
+
+def enabled() -> bool:
+    return os.environ.get(ENV, "0") == "1"
+
+
+def scratch_extra() -> int:
+    return REGION_BYTES if enabled() else 0
+
+
+def enter_ix(i):
+    return 1 + i * PER_STAGE
+
+
+def exit_ix(i):
+    return 2 + i * PER_STAGE
+
+
+def ready_ix(i, w=0):
+    return 3 + i * PER_STAGE + w
+
+
+def offset(base_scratch_bytes):
+    """The stamp region's byte offset in a scratch whose mailbox regions take
+    ``base_scratch_bytes`` (``layout.scratch_bytes`` without the stamps)."""
+    return base_scratch_bytes
+
+
+def memrealtime():
+    return fx.Int64(llvm.call_intrinsic(T.i64, "llvm.amdgcn.s.memrealtime", [], [], []))
+
+
+def _begin(tls, stages):
+    tid = fx.thread_idx.x
+    if tid == 0:
+        for i in range_constexpr(stages):
+            fx.ptr_store(fx.Int64(0), tls + enter_ix(i))
+            fx.ptr_store(fx.Int64(0), tls + exit_ix(i))
+        fx.ptr_store(memrealtime(), tls + 0)
+    # each wave zeroes its own ready points: in program order before its stamps
+    if tid % 64 == 0:
+        for i in range_constexpr(stages):
+            fx.ptr_store(fx.Int64(0), tls + (ready_ix(i) + tid // 64))
+
+
+_begin = ASTRewriter.transform(_begin)
+
+
+def _stamp(tls, k):
+    if fx.thread_idx.x == 0:
+        fx.ptr_store(memrealtime(), tls + k)
+
+
+_stamp = ASTRewriter.transform(_stamp)
+
+
+def _ready(tls, k0):
+    tid = fx.thread_idx.x
+    if tid % 64 == 0:
+        fx.ptr_store(memrealtime(), tls + (k0 + tid // 64))
+
+
+_ready = ASTRewriter.transform(_ready)
+
+
+def _flush(tls, scratch, base, layer):
+    tid = fx.thread_idx.x
+    if tid < POINTS:
+        v = fx.ptr_load(tls + tid)
+        r = bo.create_buffer_resource_from_addr(scratch + fx.Int64(base))
+        bo.buffer_store(v, r, (layer * GRID + fx.block_idx.x) * POINTS + tid)
+
+
+_flush = ASTRewriter.transform(_flush)
+
+
+def reset():
+    """At the start of every layer kernel's trace, stamped or not: no stage
+    is open. A stamped trace that raised inside a stage would otherwise leave
+    :data:`CURRENT` set, and the next build's polls would emit ready stamps
+    into an LDS pointer of another trace."""
+    global CURRENT
+    CURRENT = None
+
+
+def begin(tls, stages):
+    """Kernel entry: zero the CTA's points of ``stages`` stages, stamp point 0."""
+    _begin(tls, stages)
+
+
+def enter(tls, i):
+    global CURRENT
+    CURRENT = (tls, i)
+    _stamp(tls, enter_ix(i))
+
+
+def leave(tls, i):
+    global CURRENT
+    CURRENT = None
+    _stamp(tls, exit_ix(i))
+
+
+def ready():
+    """Called by ``mailbox.poll_raw`` after a poll succeeds, at trace time."""
+    if CURRENT is not None:
+        tls, i = CURRENT
+        _ready(tls, ready_ix(i))
+
+
+def flush(tls, scratch, base, layer):
+    """Kernel end: a CTA barrier, then the CTA's points to the scratch tail."""
+    gpu.barrier()
+    _flush(tls, scratch, base, layer)
