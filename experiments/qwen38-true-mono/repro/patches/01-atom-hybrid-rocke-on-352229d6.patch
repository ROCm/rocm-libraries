@@ -0,0 +1,83 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+"""``ATOM_Q38_EXTERN_STAGES`` per layer kind (``{kind}`` in a path) and the
+sidecar pairing rule (``"requires"`` / ``"pair"``: rocKE ``stage_moe``'s M5
+reuses its own M4's LDS routing tables, and the mono M5 cannot read that
+M4's tables). CPU only."""
+
+import json
+
+import pytest
+
+from atom.models.qwen4_exp_mono.kernels import extern_stages as X
+
+LAYER_ARGS = ("scratch", "h_out")
+KNOWN = ("a1", "a2", "q1", "b1", "p1", "c1", "m3", "m4", "m5")
+DELTA = ("a1", "a2", "b1", "c1", "m3", "m4", "m5")
+QSA = ("a1", "a2", "q1", "c1", "m3", "m4", "m5")
+PLE = ("p1", "a1", "a2", "b1", "c1", "m3", "m4", "m5")
+
+
+def _write(d, stem, stage, var, **extra):
+    (d / f"{stem}.ll").write_text("; fn\n")
+    meta = {
+        "symbol": f"rocke_q38_{stage}_{var}",
+        "abi": X.expected_abi(LAYER_ARGS),
+        "ffi_types": ["int32"] * len(X.expected_abi(LAYER_ARGS)),
+        **extra,
+    }
+    (d / f"{stem}.json").write_text(json.dumps(meta))
+
+
+def test_kind_of():
+    assert X.kind_of(DELTA) == "delta"
+    assert X.kind_of(QSA) == "qsa"
+    assert X.kind_of(PLE) == "delta_ple"
+    assert X.kind_of(("m3", "m4", "m5")) == "delta"
+
+
+def test_kind_template_and_missing_kind(tmp_path, monkeypatch):
+    _write(tmp_path, "m3_delta_r4s", "m3", "r4s")
+    spec = {"m3": str(tmp_path / "m3_{kind}_{variant}.ll")}
+    (e,) = X.resolve(DELTA, 4, True, 0, LAYER_ARGS, KNOWN, spec=spec)
+    assert e.path.endswith("m3_delta_r4s.ll")
+    with pytest.raises(FileNotFoundError):
+        X.resolve(QSA, 4, True, 0, LAYER_ARGS, KNOWN, spec=spec)
+    monkeypatch.setenv(X.MISSING_ENV, "mono")
+    assert X.resolve(QSA, 4, True, 0, LAYER_ARGS, KNOWN, spec=spec) == ()
+
+
+def test_pair_must_be_linked_together(tmp_path):
+    _write(tmp_path, "m4_r4s", "m4", "r4s", pair="g1", requires={"m5": None})
+    _write(tmp_path, "m5_r4s", "m5", "r4s", pair="g1", requires={"m4": "g1"})
+    d = str(tmp_path)
+    got = X.resolve(DELTA, 4, True, 0, LAYER_ARGS, KNOWN, spec={"m4": d, "m5": d})
+    assert [e.stage for e in got] == ["m4", "m5"]
+    for alone in ("m4", "m5"):
+        with pytest.raises(ValueError, match="needs"):
+            X.resolve(DELTA, 4, True, 0, LAYER_ARGS, KNOWN, spec={alone: d})
+
+
+def test_pair_must_be_one_generation(tmp_path):
+    a, b = tmp_path / "a", tmp_path / "b"
+    a.mkdir()
+    b.mkdir()
+    _write(a, "m4_r4s", "m4", "r4s", pair="g1", requires={"m5": None})
+    _write(b, "m5_r4s", "m5", "r4s", pair="g2", requires={"m4": "g2"})
+    with pytest.raises(ValueError, match="own generation"):
+        X.resolve(DELTA, 4, True, 0, LAYER_ARGS, KNOWN, spec={"m4": str(a), "m5": str(b)})
+
+
+def test_missing_requirement_under_mono_policy(tmp_path, monkeypatch):
+    # m5 present for qsa, m4 not: the build must not link m5 against the mono M4
+    _write(tmp_path, "m5_qsa_r4s", "m5", "r4s", pair="g1", requires={"m4": "g1"})
+    monkeypatch.setenv(X.MISSING_ENV, "mono")
+    spec = {s: str(tmp_path / f"{s}_{{kind}}_{{variant}}.ll") for s in ("m4", "m5")}
+    with pytest.raises(ValueError, match="needs m4"):
+        X.resolve(QSA, 4, True, 0, LAYER_ARGS, KNOWN, spec=spec)
+
+
+def test_no_requires_is_unchanged(tmp_path):
+    _write(tmp_path, "m5_r1", "m5", "r1")
+    (e,) = X.resolve(DELTA, 1, False, 0, LAYER_ARGS, KNOWN, spec={"m5": str(tmp_path)})
+    assert e.stage == "m5"
