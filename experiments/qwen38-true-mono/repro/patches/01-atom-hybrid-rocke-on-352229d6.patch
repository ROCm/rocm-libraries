+# Sourced by the reproduction kit (inside the container). Run-local compile caches: comgr, FlyDSL, Triton and
+# inductor under $Q38_ROCKE_CACHE (default: the run directory's cache/), fresh for every run, so no run reuses
+# another's compile (a fresh compile is what the gates check). Q38_SHARED_CACHE=1 opts FlyDSL / Triton /
+# inductor back into the environment's shared caches (warm starts for quick iterations; those caches are keyed
+# by sources and build parameters); comgr stays per run either way.
+Q38_ROCKE_CACHE=${Q38_ROCKE_CACHE:-${RUN:-${TMPDIR:-/tmp}}/cache}
+mkdir -p "$Q38_ROCKE_CACHE/comgr" && export AMD_COMGR_CACHE_DIR=$Q38_ROCKE_CACHE/comgr
+if [ "${Q38_SHARED_CACHE:-0}" != 1 ]; then
+  export FLYDSL_RUNTIME_CACHE_DIR=$Q38_ROCKE_CACHE/flydsl TRITON_CACHE_DIR=$Q38_ROCKE_CACHE/triton \
+    TORCHINDUCTOR_CACHE_DIR=$Q38_ROCKE_CACHE/inductor
+  mkdir -p "$FLYDSL_RUNTIME_CACHE_DIR" "$TRITON_CACHE_DIR" "$TORCHINDUCTOR_CACHE_DIR"
+fi
