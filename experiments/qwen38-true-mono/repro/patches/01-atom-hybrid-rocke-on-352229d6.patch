+def state_tensors(rig):
+    """Every tensor the layer may write besides ``h_out``: the scratch and the rig's state pools
+    (verify builds update their spec slots in place, so each arm restarts from one snapshot).
+    """
+    out = {"scratch": rig.runner.scratch}
+
+    def walk(prefix, obj, depth):
+        if isinstance(obj, torch.Tensor):
+            out[prefix] = obj
+        elif depth < 3 and isinstance(obj, dict):
+            for k, v in obj.items():
+                walk(f"{prefix}.{k}", v, depth + 1)
+        elif depth < 3 and isinstance(obj, (list, tuple)):
+            for i, v in enumerate(obj):
+                walk(f"{prefix}.{i}", v, depth + 1)
+        elif depth < 3 and hasattr(obj, "__dict__"):
+            for k, v in vars(obj).items():
+                walk(f"{prefix}.{k}", v, depth + 1)
+
+    walk("state", rig.state, 0)
+    seen, uniq = set(), {}
+    for k, t in out.items():  # views of one storage once
+        key = (t.untyped_storage().data_ptr(), t.storage_offset(), tuple(t.shape))
+        if key not in seen:
+            seen.add(key)
+            uniq[k] = t
+    return uniq
+
+
+def check(cell, arms):
+    a = cell.a
+    stream = torch.cuda.current_stream()
+    r = cell.r
+    regions = (["lg", "sg"] if "m3" in cell.stages else []) + ["dn"]
+    res = {"cases": []}
+    ok = True
+    live = state_tensors(cell.rig)
+    for j in range(min(a.inputs, a.check_cases)):
+        slot = j % SLOTS
+        c, _ = cell.args(j)
+        ref_arm = "full" if a.routing == "random" else "fly"
+        got = {}
+        # one tag and one starting state for every arm of the case
+        r.counter.add_(1)
+        r.scratch.zero_()
+        torch.cuda.synchronize()
+        snap = {k: t.clone() for k, t in live.items()}
+        for arm, _k in [(ref_arm, None)] + [x for x in arms if x[0] != ref_arm]:
+            if a.routing == "real" and arm.startswith("hyb:"):
+                continue
+            for k, t in live.items():
+                t.copy_(snap[k])
+            cell.outs[c].zero_()
+            torch.cuda.synchronize()
+            cell.pair(arm, j, slot, stream)
+            torch.cuda.synchronize()
+            got[arm] = (
+                cell.outs[c].clone(),
+                {n: payload(r.scratch, n, a.rows) for n in regions},
+            )
+            if arm == ref_arm:
+                u = lg_unique(r.scratch, a.rows, a.experts)
+        del snap
+        ref_h, ref_m = got[ref_arm]
+        case = {"case": j, "U": u, "arms": {}}
+        for arm, (h, m) in got.items():
+            if arm == ref_arm:
+                continue
+            e = {
+                "h_out_bitwise": bool(torch.equal(h, ref_h)),
+                "h_out_max_abs": float((h.float() - ref_h.float()).abs().max()),
+                "h_out_nonzero": bool((h != 0).any()),
+            }
+            for n in regions:
+                eq = m[n] == ref_m[n]
+                e[f"{n}_bitwise"] = bool(eq.all())
+                if not eq.all():
+                    bad = (~eq).nonzero()
+                    e[f"{n}_bad"] = int(bad.shape[0])
+                    e[f"{n}_first_bad"] = bad[:4].tolist()
+            ok &= (
+                e["h_out_bitwise"]
+                and all(e[f"{n}_bitwise"] for n in regions)
+                and e["h_out_nonzero"]
+            )
+            case["arms"][arm] = e
+        res["cases"].append(case)
+        print(json.dumps(case), flush=True)
+        if a.dump:
+            torch.save(
+                {
+                    k: (h.cpu(), {n: x.cpu() for n, x in m.items()})
+                    for k, (h, m) in got.items()
+                },
+                f"{a.dump}_case{j}.pt",
+            )
+    res["pass"] = bool(ok)
+    return res
+
+
+# ------------------------------------------------------------------ bench
+
+
+def bench(cell, arms):
+    a = cell.a
+    r = cell.r
+    split = [n for n, _ in arms if n == "fly" or n.startswith("rk:")]
+    whole = [n for n, _ in arms if n == "full" or n.startswith(("hyb:", "srv:"))]
+    if any(n.startswith(("hyb:", "srv:")) for n in whole) and "full" not in whole:
+        whole = ["full"] + whole
+    names = (["pre"] if split else []) + split + whole
+    graphs = {}
+    us_by_launch = []
+    stream = torch.cuda.current_stream()
+    # eager pass over every arm: compile, warm, U
+    for arm in names:
+        for j in range(min(a.launches, a.copies)):
+            cell.pair(arm, j, j % SLOTS, stream)
+        torch.cuda.synchronize()
+        r.counter.add_(1)
+    if cell.real is not None:
+        for j in range(min(a.launches, cell.real.shape[0])):
+            lg = cell.real[j % cell.real.shape[0]]
+            picked = set()
+            for row in range(a.rows):
+                logits = lg[row].contiguous().view(torch.bfloat16).float()
+                picked |= set(torch.topk(logits, 10).indices.tolist())
+            us_by_launch.append(len(picked))
+    else:
+        for j in range(min(a.copies, a.inputs)):
+            cell.pair("full", j, j % SLOTS, stream)
+            torch.cuda.synchronize()
+            us_by_launch.append(lg_unique(r.scratch, a.rows, a.experts))
+            r.counter.add_(1)
+
+    def run_all(arm, st):
+        for j in range(a.launches):
+            cell.pair(arm, j, j % SLOTS, st)
+            if j % SLOTS == SLOTS - 1 and j != a.launches - 1:
+                r.counter.add_(1)
+        r.counter.add_(1)
+
+    cs = torch.cuda.Stream()
+    for arm in names:
+        g = torch.cuda.CUDAGraph()
+        cs.wait_stream(stream)
+        with torch.cuda.stream(cs):
+            run_all(arm, cs)
+        torch.cuda.synchronize()
+        with torch.cuda.graph(g, stream=cs):
+            run_all(arm, cs)
+        torch.cuda.synchronize()
+        graphs[arm] = g
+    for _ in range(a.warmup):
+        for arm in names:
+            graphs[arm].replay()
+    torch.cuda.synchronize()
+    times = {arm: [] for arm in names}
+    for rep in range(a.reps):
+        order = names if rep % 2 == 0 else names[::-1]
+        for arm in order:
+            e0, e1 = torch.cuda.Event(enable_timing=True), torch.cuda.Event(
+                enable_timing=True
+            )
+            e0.record()
+            graphs[arm].replay()
+            e1.record()
+            torch.cuda.synchronize()
+            times[arm].append(e0.elapsed_time(e1) * 1e3 / a.launches)
+    med = {arm: statistics.median(v) for arm, v in times.items()}
+    res = {
+        "us_per_launch_median": med,
+        "us_per_launch_min": {arm: min(v) for arm, v in times.items()},
+        "cv": {
+            arm: statistics.pstdev(v) / statistics.mean(v) for arm, v in times.items()
+        },
+        "U_mean": statistics.mean(us_by_launch) if us_by_launch else None,
+    }
+    suffix = {arm: med[arm] - med["pre"] for arm in split}
+    res["suffix_us"] = suffix
+    ratios = {}
+    if "fly" in suffix:
+        for arm in split:
+            if arm.startswith("rk:"):
+                ratios[arm] = suffix[arm] / suffix["fly"]
+    res["suffix_ratio_vs_fly"] = ratios
+    res["layer_ratio_vs_full"] = {
+        arm: med[arm] / med["full"] for arm in whole if arm != "full"
+    }
+    if a.stamps:
+        res["timeline"] = {}
+        from atom.models.qwen4_exp_mono.q38_hook import _stamp_region
+
+        for arm in names:
+            graphs[arm].replay()
+            torch.cuda.synchronize()
+            region = _stamp_region(r.scratch, a.rows).cpu()
+            last = min(SLOTS, a.launches)
+            if a.dump_stamps:
+                raw = res.setdefault("_raw", {})
+                raw[arm] = region[:last].clone()
+            if arm == "pre":
+                continue
+            if arm == "full" or arm.startswith(("hyb:", "srv:")):
+                dec = [
+                    timeline.decode(
+                        region[k], K.STAGES[a.kind], LY.for_rows(a.rows, a.seq)
+                    )
+                    for k in range(last)
+                ]
+            elif arm == "fly":
+                dec = [
+                    timeline.decode(region[k], cell.stages, LY.for_rows(a.rows, a.seq))
+                    for k in range(last)
+                ]
+            else:
+                dec = [decode_any(region[k], cell.stages) for k in range(last)]
+            res["timeline"][arm] = timeline.merge(dec)
+        res["timeline_ratio"] = timeline_ratios(res["timeline"])
+        if a.dump_stamps:
+            torch.save(
+                {
+                    "stages": K.STAGES[a.kind],
+                    "rows": a.rows,
+                    "seq": a.seq,
+                    "raw": res.pop("_raw", {}),
+                },
+                a.dump_stamps,
+            )
+    return res
+
+
+def timeline_ratios(tl):
+    """Per-stage ratios (arm / reference) of the merged timelines: rk arms vs ``fly``, hyb arms vs
+    ``full``. Fields: end, incr, span, wait_med, tail_med, tail_max, first_ready; plus total.
+    """
+    out = {}
+    for arm, t in tl.items():
+        ref = (
+            "fly"
+            if arm.startswith("rk:")
+            else "full" if arm.startswith("hyb:") else None
+        )
+        if ref is None or not t or not tl.get(ref):
+            continue
+        rt = tl[ref]
+        o = {"total": t["total"] / rt["total"] if rt["total"] else None}
+        for n, st in t["stages"].items():
+            rs = rt["stages"].get(n)
+            if not st or not rs:
+                continue
+            o[n] = {
+                f: round(st[f] / rs[f], 3)
+                for f in (
+                    "end",
+                    "incr",
+                    "span",
+                    "wait_med",
+                    "tail_med",
+                    "tail_max",
+                    "first_ready",
+                )
+                if st.get(f) is not None and rs.get(f)
+            }
+        out[arm] = o
+    return out
+
+
+def run_eager(cell, arms):
+    """``run`` mode: eager launches of each arm (for rocprofv3 ATT / PMC captures)."""
+    a = cell.a
+    stream = torch.cuda.current_stream()
+    for arm, _k in arms:
+        for j in range(a.launches):
+            cell.pair(arm, j, j % SLOTS, stream)
+            if j % SLOTS == SLOTS - 1:
+                cell.r.counter.add_(1)
+        torch.cuda.synchronize()
+        cell.r.counter.add_(1)
+    return {"ran": [n for n, _ in arms], "launches": a.launches}
+
+
+class _AnyLayout:
+    """timeline.decode's layout argument for a build whose task CTAs are those with stamps."""
+
+    def __init__(self, ctas_by_stage):
+        self.tasks = {k: len(v) for k, v in ctas_by_stage.items()}
+        self.base = {k: 0 for k in ctas_by_stage}
+        self._ctas = ctas_by_stage
+
+
+def decode_any(stamps, stages):
+    S = stamps.tolist() if hasattr(stamps, "tolist") else stamps
+    ctas = {}
+    for i, name in enumerate(stages):
+        ctas[name] = [
+            b
+            for b in range(len(S))
+            if any(S[b][timeline.ready_ix(i, w)] for w in range(timeline.WAVES))
+        ]
+    saved = timeline.task_ctas
+    timeline.task_ctas = lambda L, name: L._ctas[name]
+    try:
+        return timeline.decode(S, stages, _AnyLayout(ctas))
+    finally:
+        timeline.task_ctas = saved
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("mode", choices=("check", "bench", "run"))
+    ap.add_argument("--kind", default="delta", choices=("delta", "delta_ple", "qsa"))
+    ap.add_argument("--rows", type=int, default=4)
+    ap.add_argument(
+        "--seq", type=int, default=-1, help="1: MTP verify build (default: rows > 1)"
+    )
+    ap.add_argument("--experts", type=int, default=512)
+    ap.add_argument("--stages", default="m3,m4,m5")
+    ap.add_argument("--routing", default="random", choices=("random", "real"))
+    ap.add_argument("--arms", default="rk:{}")
+    ap.add_argument("--copies", type=int, default=4)
+    ap.add_argument("--inputs", type=int, default=4)
+    ap.add_argument("--check-cases", type=int, default=4)
+    ap.add_argument("--context", type=int, default=2048)
+    ap.add_argument("--share-experts", action="store_true")
+    ap.add_argument("--launches", type=int, default=96)
+    ap.add_argument("--reps", type=int, default=20)
+    ap.add_argument("--warmup", type=int, default=3)
+    ap.add_argument("--stamps", action="store_true")
+    ap.add_argument("--hyb-stages", default="m3,m4,m5")
+    ap.add_argument("--row-corr", type=float, default=0.0)
+    ap.add_argument("--seed", type=int, default=0)
+    ap.add_argument("--out")
+    ap.add_argument(
+        "--dump-stamps",
+        help="bench --stamps: torch.save every arm's raw stamp regions (per CTA)",
+    )
+    ap.add_argument(
+        "--dump",
+        help="check: torch.save every arm's h_out and payloads to DUMP_case<j>.pt",
+    )
+    a = ap.parse_args(argv)
+    a.seq = (a.rows > 1) if a.seq < 0 else bool(a.seq)
+    if a.stamps:
+        assert STAMPS.enabled(), "--stamps needs ATOM_Q38_STAMPS=1"
+    arms = parse_arms(a.arms)
+    if (
+        a.mode == "bench"
+        and any(n.startswith("rk:") for n, _ in arms)
+        and not any(n == "fly" for n, _ in arms)
+    ):
+        arms = [("fly", None)] + arms
+    cell = Cell(a)
+    info = add_rocke_arms(cell, [(n, dict(k)) for n, k in arms if k is not None])
+    out = {"args": vars(a), "kernels": info}
+    if a.mode == "check":
+        out.update(check(cell, arms))
+        rc = 0 if out["pass"] else 1
+    elif a.mode == "run":
+        out.update(run_eager(cell, arms))
+        rc = 0
+    else:
+        out.update(bench(cell, arms))
+        rc = 0
+        print(
+            json.dumps(
+                {
+                    "U_mean": out["U_mean"],
+                    "suffix_ratio_vs_fly": out["suffix_ratio_vs_fly"],
+                    "layer_ratio_vs_full": out["layer_ratio_vs_full"],
+                    "cv": out["cv"],
+                    "timeline_ratio": out.get("timeline_ratio"),
+                },
+                indent=1,
+            ),
+            flush=True,
+        )
+    if a.out:
+        with open(a.out, "w") as f:
+            json.dump(out, f, indent=1)
+    return rc
+
+
+if __name__ == "__main__":
+    sys.exit(main())
