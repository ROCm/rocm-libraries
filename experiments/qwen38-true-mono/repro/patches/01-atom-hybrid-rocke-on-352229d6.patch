index 0000000000000000000000000000000000000000..df8515e6baa881176dd7aaab7c77e3f1ad2dae13
--- /dev/null
+++ b/scripts/qwen38_rocke/common/check_fns.py
@@ -0,0 +1,92 @@
+"""Check the stage functions the gen step wrote (``<fns>/b3``, ``<fns>/moe``) before anything links them.
+
+    python check_fns.py <fns dir> [variants, default r1,r2,r3,r4,r2s,r3s,r4s]
+
+- every function has its ``.ll`` and its ``.json`` sidecar, and the sidecar's symbol is ``rocke_q38_<stem>``;
+- every sidecar says ``"mailboxes": "numa1"`` (the bodies address the NUMA mailboxes of ATOM's ``numa`` lever,
+  so ATOM keeps the lever for the builds that link them: run them with ``ATOM_Q38_SCHED=best``);
+- B3 (``b3_<v>``, every variant and grouped ``r4g2``): a body whose sidecar ``"needs"`` the prologue has a
+  ``b3pre_<v>`` built with the same ``stage_knobs``; no prologue without such a body;
+- fused MoE (``m3`` / ``m4`` / ``m5`` of every variant): one generation, i.e. one ``"pair"`` id, and each sidecar
+  ``"requires"`` the two others with that id (ATOM refuses a build that links only some of them);
+- with ``<fns>/manifest.sha256``: every listed file still has its hash.
+
+Prints ``FNS <n> sidecars`` and one ``BAD ...`` line per problem; exits 1 on any.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import sys
+
+
+def sha256(path):
+    with open(path, "rb") as f:
+        return hashlib.sha256(f.read()).hexdigest()
+
+
+def main(argv):
+    fns = argv[0]
+    variants = (argv[1] if len(argv) > 1 else "r1,r2,r3,r4,r2s,r3s,r4s").split(",")
+    bad, n = [], 0
+
+    def side(d, stem):
+        p = os.path.join(fns, d, stem + ".json")
+        if not os.path.isfile(p) or not os.path.isfile(
+            os.path.join(fns, d, stem + ".ll")
+        ):
+            bad.append(f"{d}/{stem}: missing .ll / .json")
+            return None
+        with open(p) as f:
+            m = json.load(f)
+        if m.get("symbol") != f"rocke_q38_{stem}":
+            bad.append(f"{d}/{stem}: symbol {m.get('symbol')}")
+        if m.get("mailboxes") != "numa1":
+            bad.append(f"{d}/{stem}: mailboxes {m.get('mailboxes')!r}, want numa1")
+        return m
+
+    for v in variants + ["r4g2"]:
+        b = side("b3", f"b3_{v}")
+        if b is None:
+            continue
+        n += 1
+        if "b3pre" in b.get("needs", []):
+            p = side("b3", f"b3pre_{v}")
+            n += 1
+            if p is not None and p.get("stage_knobs") != b.get("stage_knobs"):
+                bad.append(f"b3 {v}: body / prologue built with different knobs")
+        elif os.path.exists(os.path.join(fns, "b3", f"b3pre_{v}.ll")):
+            bad.append(f"b3 {v}: a prologue without a body that needs it")
+    for v in variants:
+        ms = {s: side("moe", f"{s}_{v}") for s in ("m3", "m4", "m5")}
+        if None in ms.values():
+            continue
+        n += 3
+        pairs = {m.get("pair") for m in ms.values()}
+        if len(pairs) != 1:
+            bad.append(f"moe {v}: pair ids {sorted(map(str, pairs))}")
+        for s, m in ms.items():
+            if m.get("requires") != {o: m.get("pair") for o in ms if o != s}:
+                bad.append(f"moe {v} {s}: requires {m.get('requires')}")
+    man = os.path.join(fns, "manifest.sha256")
+    if os.path.isfile(man):
+        with open(man) as f:
+            lines = f.read().splitlines()
+        for line in lines:
+            if not line.strip():
+                continue
+            want, name = line.split(None, 1)
+            name = name.strip().lstrip("*")
+            p = os.path.join(fns, name)
+            if not os.path.isfile(p) or sha256(p) != want:
+                bad.append(f"{name}: changed since the gen step (manifest.sha256)")
+    print(f"FNS {n} sidecars")
+    for b in bad:
+        print("BAD", b)
+    return 1 if bad else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
diff --git a/scripts/qwen38_rocke/common/server.sh b/scripts/qwen38_rocke/common/server.sh
