+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+"""The Qwen3.8-Flash-Next mono's stage stamps (``kernels.stamps``, debug /
+measurement only): off by default, a scratch tail only when on, and every
+stage's points distinct and inside a CTA's record."""
+
+from types import SimpleNamespace
+
+import pytest
+
+pytest.importorskip("flydsl")
+
+from atom.models.qwen4_exp_mono.kernels import layout, stamps
+from atom.models.qwen4_exp_mono.kernels.kernel import STAGES
+
+
+def test_off_by_default(monkeypatch):
+    monkeypatch.delenv(stamps.ENV, raising=False)
+    assert not stamps.enabled()
+    assert stamps.scratch_extra() == 0
+    assert layout.scratch_bytes(4) == layout.mailbox_bytes(4)
+
+
+def test_on_adds_the_stamp_region(monkeypatch):
+    monkeypatch.setenv(stamps.ENV, "1")
+    assert layout.scratch_bytes(4) == layout.mailbox_bytes(4) + stamps.REGION_BYTES
+    assert stamps.REGION_BYTES == stamps.LAYER_SLOTS * stamps.LAUNCH_BYTES
+
+
+def test_points_are_distinct_and_fit():
+    for stages in STAGES.values():
+        n = len(stages)
+        assert n <= stamps.MAX_STAGES
+        points = [0]
+        for i in range(n):
+            points += [stamps.enter_ix(i), stamps.exit_ix(i)]
+            points += [stamps.ready_ix(i, w) for w in range(stamps.WAVES)]
+        assert len(set(points)) == len(points)
+        assert max(points) < stamps.POINTS
+
+
+def test_a_trace_starts_with_no_stage_open(tmp_path, monkeypatch):
+    # a stamped trace that raised inside a stage leaves ``stamps.CURRENT``
+    # set; the next build (unstamped here) must not emit ready stamps into
+    # that stale LDS pointer: every trace resets it first (``stamps.reset``)
+    pytest.importorskip("aiter")
+    from atom.models.qwen4_exp_mono.kernels import kernel
+    from atom.mono.runtime.compile import compile_only
+
+    monkeypatch.setenv("ARCH", "gfx950")
+    monkeypatch.setenv("FLYDSL_GPU_ARCH", "gfx950")
+    monkeypatch.setenv("FLYDSL_RUNTIME_CACHE_DIR", str(tmp_path))
+    monkeypatch.delenv(stamps.ENV, raising=False)
+    kernel.build_layer.cache_clear()
+    monkeypatch.setattr(stamps, "CURRENT", ("not an LDS pointer", 0))
+    try:
+        with compile_only():
+            # Q7 alone polls Q6's probabilities: a poll reaches ``stamps.ready``
+            kernel.build_layer(("q7",), rows=1)(
+                0, 0, *([0] * len(kernel.LAYER_ARGS))
+            )
+        assert stamps.CURRENT is None
+    finally:
+        kernel.build_layer.cache_clear()
+
+
+def test_the_round_hook_reads_the_scratch_each_launch_ran_on(tmp_path, monkeypatch):
+    # ``ATOM_Q38_ROUND``: a round's first draft step (the verify's rows,
+    # ``DraftWidth.group`` > 1) gathers the target pass's stamps from the
+    # scratch that pass ran on (the wide one past MAX_ROWS rows, as
+    # ``group_runner`` launches), and a later step (one row per request)
+    # gathers none, whatever its row count
+    torch = pytest.importorskip("torch")
+    if not torch.cuda.is_available():
+        pytest.skip("the hook times its gathers with CUDA events")
+    from atom.models.qwen4_exp_mono import q38_hook
+    from atom.models.qwen4_exp_mono.kernels.layout import MAX_ROWS
+    from atom.models.qwen4_exp_mono.kernels.layout_wide import WIDE_ROWS
+
+    monkeypatch.setenv("ATOM_Q38_ROUND_SKIP", "0")
+    monkeypatch.setenv("ATOM_Q38_ROUND_STEPS", "3")
+
+    def scratch(rows, fill):
+        n = (layout.mailbox_bytes(rows) + stamps.REGION_BYTES) // 4
+        t = torch.zeros(n, dtype=torch.int32, device="cuda")
+        q38_hook._stamp_region(t, rows).fill_(fill)
+        return t
+
+    target = SimpleNamespace(
+        kinds=["delta", "qsa"],
+        scratch=scratch(MAX_ROWS, 1),
+        wide_scratch=scratch(WIDE_ROWS, 2),
+    )
+    draft = SimpleNamespace(
+        scratch=scratch(MAX_ROWS, 3), wide_scratch=scratch(WIDE_ROWS, 4), layer_id=48
+    )
+    monkeypatch.setitem(q38_hook._RUNNERS, "target", target)
+    hook = q38_hook._Round(str(tmp_path))
+    hook.after_draft(draft, SimpleNamespace(rows=8, group=4))  # step 0, 2 requests
+    hook.after_draft(draft, SimpleNamespace(rows=2, group=1))  # a later step of them
+    hook.after_draft(draft, SimpleNamespace(rows=4, group=4))  # step 0, 1 request
+    torch.cuda.synchronize()
+    assert hook.meta == [(8, True), (2, False), (4, True)]
+    assert (hook.ring_t[0] == 2).all() and (hook.ring_d[0] == 4).all()
+    assert (hook.ring_t[1] == 0).all() and (hook.ring_d[1] == 3).all()
+    assert (hook.ring_t[2] == 1).all() and (hook.ring_d[2] == 3).all()
+    assert len(hook.events) == 3
