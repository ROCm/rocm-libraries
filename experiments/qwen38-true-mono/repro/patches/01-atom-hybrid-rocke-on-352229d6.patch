+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+"""Schedule-track knobs of the layer kernel: bubble measurement and schedule
+levers. Every knob is off by default; off, nothing here is traced and the
+builds are unchanged (same kernel name, same IR).
+
+Measurement (debug builds; need ``ATOM_Q38_STAMPS=1`` and rows <= MAX_ROWS):
+
+- ``ATOM_Q38_BLAME=1``: every mailbox put (``mailbox.put`` / ``put2`` /
+  ``put_bf``) first stores a side pair ``(s_memrealtime low word, producer id)``
+  per payload pair, at the same byte offset in a side copy of the mailboxes
+  (:data:`side_delta` bytes on); the producer id is ``bid | stage << 8 | tag
+  << 12``. After a poll succeeds (``mailbox.poll_raw``), the wave loads the
+  side pairs of the polled pairs (re-loading, at most :data:`SIDE_SPIN` times,
+  while a side pair is older than the launch) and atomically maxes ``stamp << 12
+  | bid | stage << 8`` into its LDS slot ``(stage, wave)``: per CTA, stage and
+  wave, the LAST-ARRIVING producer of the wave's inputs and when it put them.
+- ``ATOM_Q38_SPIN=1``: per ``(stage, wave)``, the most retries any lane's
+  poll of the stage took.
+
+Both go to the scratch tail past the stage stamps (``[LAYER_SLOTS][GRID]
+[BL_POINTS]`` int64, then ``[LAYER_SLOTS][GRID][SP_POINTS]`` int32, then the
+side mailboxes): :func:`blame_offset`, :func:`spin_offset`, :data:`side_delta`.
+
+Causal delay injection (``ATOM_Q38_DELAY``, any build):
+``stage[:mode][@t0-t1]=units;...`` sleeps ``units`` ``s_sleep`` units (64
+clocks each) in ``stage`` on the CTAs holding a task in ``[t0, t1)`` (all its
+tasks by default): ``entry`` (default) when the CTA enters the stage, ``post``
+after the stage's first traced poll, ``exit`` after the stage's body.
+
+Levers (``ATOM_Q38_SCHED``: ``;``-separated groups ``[kind[.variant]:]key=value,...``
+selected per build (:func:`select`); a group ``best`` is :data:`BEST`, the hill
+climb's winners, e.g. ``ATOM_Q38_SCHED=best``):
+
+- ``pause=N`` / ``pause.<stage>=N``: ``s_sleep N`` between poll retries
+  instead of ``s_nop 0`` (N = 0: the default ``s_nop``);
+- ``prio.<stage>=P``: ``s_setprio P`` while the CTA runs ``stage`` (0 after);
+- ``hold.<stage>=N``: the stage's task CTAs sleep N units when they enter it
+  (before its weight loads and polls), so an off-critical stage's weight
+  stream starts later and contends less with the critical one (the ``entry``
+  delay of ``ATOM_Q38_DELAY`` as a lever: the causal profile's negative
+  slopes);
+- ``head_sleep=N``: the A1 builds' head sleep of CTAs with neither an A1 nor
+  an A2 task (``kernel.HEAD_SLEEP``, 64 by default);
+- ``place.<stage>=B`` (narrow builds): the stage's tasks start at CTA ``B``
+  (``layout.BASE`` override: task ``t`` on CTA ``(B + t) % GRID``); every
+  dependency still points to an earlier stage, so any placement is free of
+  deadlock;
+- ``numa=1`` (narrow builds): NUMA dual-copy mailboxes (``numa``): every
+  region twice, a consumer polls the copy homed at its IOD; the scratch needs
+  ``numa.scratch_bytes_needed()`` and a calibrated header (``numa.prepare``);
+  ``numa=2`` / ``numa=3`` are ablations (copy 0 always / the remote copy);
+- ``pipe=N`` / ``pipe.<stage>=N``: polls of at most ``4 N`` words keep two
+  loads in flight (``mailbox._poll_spin2``): a retry every half round trip;
+- ``b3pf=1`` (DeltaNet narrow, ungrouped builds): at B1's entry, waves 4-7
+  (idle in B1's GEMM) of a CTA holding a B3 task load that task's recurrent
+  state block (row 0's 16 KiB) and drop it: B3's own state loads, issued after
+  its mixed-row poll, then hit L2 / MALL;
+- ``dyn.<stage>=1`` (narrow builds, no blame / spin; not A1 / A2 / M5,
+  :data:`DYN_REFUSED`): dynamic task
+  assignment, a ready queue without a queue: a CTA takes the stage's task
+  from a per-stage ticket counter (a buffer atomic add at agent scope on a
+  word of the scratch header, :func:`dyn_offset`, issued by thread 0 when the
+  CTA enters the PREVIOUS stage, so its round trip hides behind that stage),
+  ticket ``% GRID`` = the task (none past the stage's tasks): the first CTAs
+  to reach the previous stage get the tasks. Every launch takes exactly
+  ``GRID`` tickets per stage, so the counter needs no reset. The ticket goes
+  to LDS (thread 0) and the CTA barriers at the stage's entry;
+  ``stages.common.task_index`` returns it for that stage;
+- ``mutate.<stage>=1`` (tests only): every ``mailbox.put`` payload of the
+  stage has its lowest bit flipped, so the bitwise A/B must see a difference.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+from types import SimpleNamespace
+
+import flydsl.expr as fx
+from flydsl._mlir.dialects import llvm
+from flydsl.compiler.ast_rewriter import ASTRewriter
+from flydsl.expr import gpu, range_constexpr, rocdl
+from flydsl.expr.typing import T
+
+from atom.models.qwen4_exp_mono.kernels import buffer_ops as bo
+from atom.models.qwen4_exp_mono.kernels.config import GRID, THREADS
+
+ENV_BLAME = "ATOM_Q38_BLAME"
+ENV_SPIN = "ATOM_Q38_SPIN"
+ENV_DELAY = "ATOM_Q38_DELAY"
+ENV_SCHED = "ATOM_Q38_SCHED"
+
+WAVES = THREADS // 64
+LAYER_SLOTS = 64  # mailbox.LAYER_SLOTS
+MAX_STAGES = 15  # stamps.MAX_STAGES
+BL_POINTS = MAX_STAGES * WAVES  # one int64 per (stage, wave)
+SP_POINTS = MAX_STAGES * WAVES  # one int32 per (stage, wave)
+BL_BYTES = LAYER_SLOTS * GRID * BL_POINTS * 8
+SP_BYTES = LAYER_SLOTS * GRID * SP_POINTS * 4
+SIDE_SPIN = 64  # side-pair reloads at most per poll (a stale side pair: no blame)
+DELAY_MODES = ("entry", "post", "exit")
+LEVER_KEYS = (
+    "pause",
+    "prio",
+    "head_sleep",
+    "hold",
+    "place",
+    "numa",
+    "pipe",
+    "b3pf",
+    "mutate",
+    "dyn",
+)
+# ``ATOM_Q38_SCHED=best``: the hill climb's current best lever set per layer
+# kind and build variant (ledger ``schedule.md``, rounds 5 and 10): NUMA
+# dual-copy mailboxes everywhere (narrow builds), plus the holds that won on
+# top of it.
+BEST = (
+    "numa=1"
+    ";delta.r1:hold.b1=32,hold.m4=64,hold.m3=32"
+    ";delta.r4s:hold.m3=128,head_sleep=128"
+    ";qsa.r4s:hold.m3=64,head_sleep=128,hold.m1=32"
+    ";qsa.r1:hold.q1=32"
+    ";delta_ple.r4s:hold.a2=32,hold.m3=128"
+    ";delta_ple.r1:hold.b1=32,hold.m4=64,hold.a2=32"
+)
+
+
+# ------------------------------------------------------------- knobs
+
+
+def _flag(name):
+    v = os.environ.get(name, "0")
+    if v not in ("0", "1", ""):
+        raise ValueError(f"{name}={v!r}: 0 or 1")
+    return v == "1"
+
+
+def parse_delay(spec):
+    """``ATOM_Q38_DELAY`` -> sorted tuple of (stage, mode, t0, t1, units)."""
+    out = []
+    for item in filter(None, (s.strip() for s in (spec or "").split(";"))):
+        m = re.fullmatch(
+            r"([a-z]\d)(?::(entry|post|exit))?(?:@(\d+)-(\d+))?=(\d+)", item
+        )
+        if not m:
+            raise ValueError(
+                f"{ENV_DELAY}: bad item {item!r} (stage[:mode][@t0-t1]=units)"
+            )
+        st, mode, t0, t1, units = m.groups()
+        t0, t1 = (int(t0), int(t1)) if t0 is not None else (0, GRID)
+        if t1 <= t0:
+            raise ValueError(f"{ENV_DELAY}: empty task range in {item!r}")
+        if int(units):
+            out.append((st, mode or "entry", t0, t1, int(units)))
+    return tuple(sorted(out))
+
+
+def variant_name(rows, seq=False, group=0):
+    """``r<rows>`` + ``s`` (seq) + ``g<S>`` (grouped), as the hybrid stage files."""
+    return f"r{rows}" + ("s" if seq else "") + (f"g{group}" if group else "")
+
+
+def kind_of(stages):
+    if any(s.startswith("q") for s in stages):
+        return "qsa"
+    if any(s in ("p1", "p2") for s in stages):
+        return "delta_ple"
+    return "delta"
+
+
+def select(spec, kind, variant):
+    """The lever items of ``spec`` for a ``kind`` / ``variant`` build: ``spec`` is a
+    ``;``-separated list of groups, each ``[selector:]items``; a selector is
+    ``kind``, ``kind.variant``, ``*.variant`` or ``*`` (no selector: ``*``).
+    Groups apply in order (a later group's value of a key wins). A group
+    ``best`` expands to :data:`BEST`'s groups (``best;pipe=2``: on top of it)."""
+    groups = []
+    for g in (spec or "").split(";"):
+        groups += BEST.split(";") if g.strip() == "best" else [g]
+    items = []
+    for grp in filter(None, (g.strip() for g in groups)):
+        sel, _, body = grp.rpartition(":")
+        sel = sel.strip() or "*"
+        sk, _, sv = sel.partition(".")
+        if sk not in ("*", kind) or (sv and sv not in ("*", variant)):
+            continue
+        items.append(body)
+    return ",".join(items)
+
+
+def parse_levers(spec):
+    """``ATOM_Q38_SCHED`` items (``select``ed) -> sorted tuple of (key, value) with int values."""
+    out = {}
+    for item in filter(None, (s.strip() for s in (spec or "").split(","))):
+        m = re.fullmatch(r"([a-z_][a-z0-9_]*?)(?:\.([a-z]\d))?=(\d+)", item)
+        if not m or m.group(1) not in LEVER_KEYS:
+            raise ValueError(f"{ENV_SCHED}: bad item {item!r} (keys {LEVER_KEYS})")
+        key, st, v = m.group(1), m.group(2), int(m.group(3))
+        if key == "prio" and (st is None or not 0 <= v <= 3):
+            raise ValueError(f"{ENV_SCHED}: prio.<stage>=0..3, got {item!r}")
+        if key == "dyn" and st in DYN_REFUSED:
+            raise ValueError(f"{ENV_SCHED}: dyn.{st}: {DYN_REFUSED[st]}")
+        if key in ("mutate", "hold", "place", "dyn") and st is None:
+            raise ValueError(f"{ENV_SCHED}: {key}.<stage>=N, got {item!r}")
+        if key in ("head_sleep", "numa", "b3pf") and st is not None:
+            raise ValueError(f"{ENV_SCHED}: head_sleep takes no stage, got {item!r}")
+        out[key + ("." + st if st else "")] = v
+    return tuple(sorted(out.items()))
+
+
+def resolve(stamped, rows, seq=False, group=0, stages=()):
+    """The build's schedule knobs from the environment: a hashable tuple of
+    ``(name, value)``, empty when every knob is off (the build key then has no
+    entry and the build is unchanged). A delay of a stage the build does not
+    run is inert (it is still in the key)."""
+    blame, spin = _flag(ENV_BLAME), _flag(ENV_SPIN)
+    delay = parse_delay(os.environ.get(ENV_DELAY, ""))
+    spec = select(
+        os.environ.get(ENV_SCHED, ""), kind_of(stages), variant_name(rows, seq, group)
+    )
+    levers = parse_levers(spec)
+    from atom.models.qwen4_exp_mono.kernels.layout import MAX_ROWS
+
+    if rows > MAX_ROWS:  # wide builds: the levers are tuned for the narrow ones only
+        levers = tuple(
+            kv
+            for kv in levers
+            if not kv[0].startswith(("place.", "dyn.")) and kv[0] != "numa"
+        )
+    if (blame or spin) and any(kv[0].startswith("dyn.") for kv in levers):
+        raise ValueError(
+            f"{ENV_SCHED}: dyn.<stage> levers: not with {ENV_BLAME} / {ENV_SPIN}"
+        )
+    if (blame or spin) and not stamped:
+        raise ValueError(f"{ENV_BLAME} / {ENV_SPIN} need ATOM_Q38_STAMPS=1")
+    if (blame or spin) and rows > MAX_ROWS:
+        raise ValueError(f"{ENV_BLAME} / {ENV_SPIN}: builds of up to {MAX_ROWS} rows")
+    knobs = []
+    if blame:
+        knobs.append(("blame", 1))
+    if spin:
+        knobs.append(("spin", 1))
+    if delay:
+        knobs.append(("delay", delay))
+    knobs += [("lever", kv) for kv in levers]
+    return tuple(knobs)
+
+
+def without_numa(knobs, stages, rows, seq, group):
+    """``knobs`` without the ``numa`` lever (a build with extern stages), logged."""
+    if not from_knobs(knobs).levers.get("numa"):
+        return knobs
+    import sys
+
+    print(
+        f"[{ENV_SCHED}] numa off for {kind_of(stages)} {variant_name(rows, seq, group)}: "
+        "ATOM_Q38_EXTERN_STAGES stages address the plain mailboxes",
+        file=sys.stderr,
+        flush=True,
+    )
+    return tuple(
+        kv
+        for kv in knobs
+        if kv != ("lever", ("numa", from_knobs(knobs).levers["numa"]))
+    )
+
+
+_LOGGED_BUILDS = set()
+
+
+def log_build(stages, rows, seq, group, knobs, externs=()):
+    """One stderr line per (kind, variant, levers, extern layouts) a process
+    builds while ``ATOM_Q38_SCHED`` is set: the build's final levers (after
+    :func:`without_numa`) and its extern stages with the mailbox layout each
+    addresses, e.g. ``[ATOM_Q38_SCHED] build delta r4s: numa=1 hold.m3=128
+    head_sleep=128 | extern b3:numa1 m3:numa1``. Unset: nothing (servers and
+    rigs without the knob print nothing new)."""
+    if not os.environ.get(ENV_SCHED):
+        return
+    lv = from_knobs(knobs).levers
+    ext = " ".join(f"{e.stage}:{e.mailboxes}" for e in externs)
+    key = (kind_of(stages), variant_name(rows, seq, group), tuple(sorted(lv.items())), ext)
+    if key in _LOGGED_BUILDS:
+        return
+    _LOGGED_BUILDS.add(key)
+    import sys
+
+    items = " ".join(f"{k}={v}" for k, v in sorted(lv.items())) or "none"
+    print(
+        f"[{ENV_SCHED}] build {key[0]} {key[1]}: {items}" + (f" | extern {ext}" if ext else ""),
+        file=sys.stderr,
+        flush=True,
+    )
+
+
+def from_knobs(knobs):
+    """``resolve``'s tuple as a namespace (blame, spin, delay, levers dict)."""
+    d = {"blame": False, "spin": False, "delay": (), "levers": {}}
+    for k, v in knobs:
+        if k == "lever":
+            d["levers"][v[0]] = v[1]
+        elif k == "delay":
+            d["delay"] = v
+        else:
+            d[k] = bool(v)
+    return SimpleNamespace(**d)
+
+
+def suffix(knobs):
+    """Kernel-name suffix of a knob set ('' when off)."""
+    if not knobs:
+        return ""
+    import hashlib
+
+    return "_k" + hashlib.sha256(repr(knobs).encode()).hexdigest()[:8]
+
+
+def numa_state():
+    """The ``numa`` lever's entry state while such a build traces, else None."""
+    return None if _T is None else _T.numa
+
+
+def rebase_numa(scratch, mode):
+    """Stacked launches (``stack``): the ``numa`` lever's entry state for
+    another scratch (layer B's own NUMA area); else nothing."""
+    if _T is not None and _T.numa is not None:
+        from atom.models.qwen4_exp_mono.kernels import numa
+
+        _T.numa = numa.entry_state(scratch, mode)
+
+
+def head_sleep(knobs, default):
+    return from_knobs(knobs).levers.get("head_sleep", default)
+
+
+def apply_layout(c, knobs):
+    """``place.<stage>`` levers: the build's layout with those stages' bases
+    replaced (trace time; nothing without such a lever)."""
+    lv = {
+        k[6:]: v for k, v in from_knobs(knobs).levers.items() if k.startswith("place.")
+    }
+    if not lv:
+        return
+    base = dict(c.L.base)
+    for st, b in lv.items():
+        if st in base:
+            base[st] = b % GRID
+    c.L = SimpleNamespace(**{**vars(c.L), "base": base})
+
+
+# ------------------------------------------------------------- scratch tail
+
+
+def _stamp_base():
+    from atom.models.qwen4_exp_mono.kernels.layout import MAX_ROWS, mailbox_bytes
+
+    return mailbox_bytes(MAX_ROWS)
+
+
+def blame_offset():
+    """Byte offset (from the scratch base) of the blame region."""
+    from atom.models.qwen4_exp_mono.kernels import stamps
+
+    return _stamp_base() + stamps.REGION_BYTES
+
+
+def spin_offset():
+    return blame_offset() + BL_BYTES
+
+
+def side_delta():
+    """Bytes from a mailbox pair to its side pair."""
+    return spin_offset() + SP_BYTES
+
+
+def scratch_extra(rows=None):
+    """Bytes ``layout.scratch_bytes(rows)`` adds for the measurement knobs set
+    in the environment, or, for a narrow scratch (``rows`` <= ``MAX_ROWS``;
+    ``None``: narrow), for a ``numa`` lever with a nonzero value somewhere in
+    ``ATOM_Q38_SCHED`` (0 when off). Wide builds never use the NUMA area.
+    """
+    blame, spin = _flag(ENV_BLAME), _flag(ENV_SPIN)
+    from atom.models.qwen4_exp_mono.kernels import numa
+    from atom.models.qwen4_exp_mono.kernels.layout import MAX_ROWS
+
+    if (rows is None or rows <= MAX_ROWS) and numa.wanted():
+        return numa.scratch_bytes_needed() - _stamp_base()
+    if (rows is None or rows <= MAX_ROWS) and numa.wanted("dyn"):
+        # the ticket counters sit in the NUMA header (``dyn_offset``)
+        return numa.header_offset() + 256 - _stamp_base()
+    if not (blame or spin):
+        return 0
+    return BL_BYTES + SP_BYTES + (_stamp_base() if blame else 0)
+
+
+# ------------------------------------------------------------- trace state
+# Set while a build with knobs traces (``begin`` .. ``end``); None otherwise,
+# so every hook below is a Python no-op in a plain build.
+_T = None
+
+
+def reset():
+    global _T
+    _T = None
+
+
+def active():
+    return _T is not None
+
+
+def begin(knobs, bl, sp, nstages, scratch=None, stages=None, dy=None):
+    """Kernel entry of a build with ``knobs`` (``bl`` / ``sp``: the LDS
+    arrays of the blame and spin slots, or None; ``dy``: the ``dyn`` lever's
+    LDS words, ``stages``: the build's stage names)."""
+    global _T
+    _T = None
+    if not knobs:
+        return
+    k = from_knobs(knobs)
+    _T = SimpleNamespace(
+        k=k, bl=bl, sp=sp, stage=None, i=-1, posted=False, c=None, numa=None,
+        dyn=dyn_stages(knobs), dy=dy, stages=tuple(stages or ()), scratch=scratch,
+        ticket={},
+    )  # fmt: skip
+    if _T.dyn:
+        assert dy is not None and stages, (
+            "dyn levers need the build's LDS words and stage names"
+        )
+        if stages[0] in _T.dyn:
+            raise ValueError("dyn: not on a build's first stage")
+    if k.levers.get("numa"):
+        from atom.models.qwen4_exp_mono.kernels import numa
+
+        _T.numa = numa.entry_state(scratch, k.levers["numa"])
+    if bl is not None or sp is not None:
+        _zero_slots(bl, sp, nstages)
+
+
+def _zero_slots_body(bl, sp, nstages):
+    tid = fx.thread_idx.x
+    lane = tid % 64
+    w = tid // 64
+    if lane < nstages:
+        if bl is not None:
+            fx.ptr_store(fx.Int64(0), bl + (lane * WAVES + w))
+        if sp is not None:
+            fx.ptr_store(fx.Int32(0), sp + (lane * WAVES + w))
+
+
+_zero_slots = ASTRewriter.transform(_zero_slots_body)
+
+
+def end():
+    global _T
+    _T = None
+
+
+def _sleep(n):
+    for _ in range_constexpr(n // 127):
+        rocdl.s_sleep(127)
+    if n % 127:
+        rocdl.s_sleep(n % 127)
+
+
+def _setprio(p):
+    llvm.InlineAsmOp(None, [], f"s_setprio {int(p)}", "", has_side_effects=True)
+
+
+def _task_delay_body(t, t0, t1, n):
+    if (t >= t0) & (t < t1):
+        _sleep(n)
+
+
+_task_delay = ASTRewriter.transform(_task_delay_body)
+
+
+def _delays(mode):
+    if _T is None or _T.stage is None:
+        return []
+    return [d for d in _T.k.delay if d[0] == _T.stage and d[1] == mode]
+
+
+def _emit_delays(mode, c):
+    from atom.models.qwen4_exp_mono.kernels.stages.common import task_index
+
+    for st, _m, t0, t1, n in _delays(mode):
+        t = task_index(c, st)
+        _task_delay(t, fx.Int32(t0), fx.Int32(min(t1, c.L.tasks[st])), n)
+
+
+def _b3_prefetch_body(c, p, tasks):
+    from atom.models.qwen4_exp_mono.kernels.stages.common import delta_state, task_index
+
+    t = task_index(c, "b3")
+    if (t < tasks) & (fx.thread_idx.x >= 256):
+        rec = delta_state(c, p, 0)[2]
+        base = (
+            (t // 4) * 128 + (t % 4) * 32
+        ) * 128  # the task's 32 state rows (f32 words)
+        j = fx.thread_idx.x - 256
+        vs = [
+            bo.buffer_load(rec, base + (j + 256 * k) * 4, vec_width=4, dtype=T.i32)
+            for k in range(4)
+        ]
+        llvm.InlineAsmOp(
+            None, list(vs), "; b3pf $0 $1 $2 $3", "v,v,v,v", has_side_effects=True
+        )
+
+
+_b3_prefetch = ASTRewriter.transform(_b3_prefetch_body)
+
+
+def stage_enter(i, name, c, p=None):
+    """Kernel stage loop, before the stage's body."""
+    if _T is None:
+        return
+    if (
+        name == "b1"
+        and _T.k.levers.get("b3pf")
+        and p is not None
+        and not c.group
+        and c.rows <= 4
+        and "b3" in c.L.tasks
+    ):
+        _b3_prefetch(c, p, fx.Int32(min(256, c.L.tasks["b3"])))
+    if _T.dyn:
+        _dyn_enter(i, name, c)
+    _T.stage, _T.i, _T.posted, _T.c = name, i, False, c
+    p = _T.k.levers.get("prio." + name)
+    if p is not None:
+        _setprio(p)
+    h = _T.k.levers.get("hold." + name)
+    if h:
+        from atom.models.qwen4_exp_mono.kernels.stages.common import task_index
+
+        _task_delay(
+            task_index(c, name), fx.Int32(0), fx.Int32(min(GRID, c.L.tasks[name])), h
+        )
+    _emit_delays("entry", c)
+
+
+DY_WORDS = 16  # LDS words of the ``dyn`` lever (one per stage index)
+# ``dyn`` stages refused (every other stage was checked bitwise with its own
+# ``dyn`` lever: delta b1 b3 c1 m1 m2 m3 m4, qsa q1 q2 q3 q5 q6 q7 c1 m2,
+# delta_ple p2; sched-fx5b / sched-fx8)
+DYN_REFUSED = {
+    "a1": "its task is read at the kernel head (a1_preload, head sleep)",
+    "a2": "its task is read at the kernel head (head sleep)",
+    "m5": "memory fault (sched-fx5b): its body (moe.py, fused-moe's) assumes the static task map",
+}
+
+
+def dyn_stages(knobs):
+    """The stages with a ``dyn`` lever (a frozenset; empty: none)."""
+    return frozenset(
+        k[4:] for k, v in from_knobs(knobs).levers.items() if k.startswith("dyn.") and v
+    )
+
+
+def needs_lds(knobs):
+    """Whether a build with ``knobs`` needs the ``dyn`` lever's LDS words."""
+    return bool(knobs) and bool(dyn_stages(knobs))
+
+
+def dyn_offset():
+    """Scratch byte offset of the ``dyn`` ticket counters (one int32 per stage
+    index): in the NUMA header (``numa.header_offset``), past its two words."""
+    from atom.models.qwen4_exp_mono.kernels import numa
+
+    return numa.header_offset() + 64
+
+
+def _ticket(scratch, k):
+    """Thread 0's ticket of stage index ``k`` (a returning buffer atomic add of
+    1, agent scope); every other thread's offset is out of range (no memory
+    operation, 0), so no branch holds the value."""
+    r = bo.create_buffer_resource_from_addr(
+        fx.Int64(scratch) + fx.Int64(dyn_offset() + 4 * k), num_records_bytes=4
+    )
+    rsrc8 = fx.rocdl.get_buffer_rsrc(r)
+    off = (fx.Int32(fx.thread_idx.x) == 0).select(fx.Int32(0), fx.Int32(64))
+    res = llvm.call_intrinsic(
+        T.i32,
+        "llvm.amdgcn.raw.ptr.buffer.atomic.add.i32",
+        [
+            fx.Int32(1).ir_value(),
+            rsrc8,
+            off.ir_value(),
+            fx.Int32(0).ir_value(),
+            fx.Int32(16).ir_value(),  # sc1: agent scope (every XCD's tickets)
+        ],
+        [],
+        [],
+    )
+    return fx.Int32(res)
+
+
+def _dyn_publish_body(v, slot):
+    if fx.thread_idx.x == 0:
+        fx.ptr_store(v & (GRID - 1), slot)
+    gpu.barrier()
+
+
+_dyn_publish = ASTRewriter.transform(_dyn_publish_body)
+
+
+def _dyn_enter(i, name, c):
+    """``dyn`` levers at stage ``i``'s entry: this stage's ticket (issued at the
+    previous stage) to LDS and to ``c.dyn``; the next stage's ticket issued."""
+    from atom.models.qwen4_exp_mono.kernels.device_ops import uniform
+
+    if name in _T.dyn:
+        v = _T.ticket.pop(name)
+        slot = _T.dy + i
+        _dyn_publish(v, slot)
+        if getattr(c, "dyn", None) is None:
+            c.dyn = {}
+        c.dyn[name] = uniform(fx.ptr_load(slot))
+    nxt = _T.stages[i + 1] if i + 1 < len(_T.stages) else None
+    if nxt in _T.dyn:
+        _T.ticket[nxt] = _ticket(_T.scratch, i + 1)
+
+
+def stage_leave(i, name, c):
+    """Kernel stage loop, after the stage's body."""
+    if _T is None:
+        return
+    _emit_delays("exit", c)
+    if _T.k.levers.get("prio." + name) is not None:
+        _setprio(0)
+    _T.stage, _T.i, _T.c = None, -1, None
+
+
+def pipelined(words):
+    """``pipe`` lever: whether a poll of ``words`` int32 words in the stage
+    being traced keeps two loads in flight."""
+    if _T is None or _T.stage is None:
+        return False
+    lv = _T.k.levers
+    n = lv.get("pipe." + _T.stage, lv.get("pipe"))
+    return bool(n) and words <= 4 * n
+
+
+def pause_fn(default):
+    """The poll loop's pause of the stage being traced."""
+    if _T is None or _T.stage is None:
+        return default
+    lv = _T.k.levers
+    n = lv.get("pause." + _T.stage, lv.get("pause"))
+    if not n:
+        return default
+    return lambda: rocdl.s_sleep(n)
+
+
+# ------------------------------------------------------------- producer side
+
+
+def mutate_bits(bits):
+    """``mutate.<stage>=1``: the payload word with its lowest bit flipped."""
+    if _T is None or _T.stage is None or not _T.k.levers.get("mutate." + _T.stage):
+        return bits
+    return bits ^ 1
+
+
+def _side_words(n, tag):
+    from atom.models.qwen4_exp_mono.kernels import stamps
+
+    t = stamps.memrealtime()
+    lo = fx.Vector.from_elements([t], fx.Int64).bitcast(fx.Int32)[0]
+    pid = (
+        (fx.Int32(fx.block_idx.x) & 0xFF)
+        | fx.Int32((_T.i & 0xF) << 8)
+        | (fx.Int32(tag) << 12)
+    )
+    words = []
+    for _ in range(n):
+        words += [lo, pid]
+    return fx.Vector.from_elements(words, fx.Int32)
+
+
+def side_put(addr, word_off, npairs, tag, cm):
+    """Blame builds: the side pairs of a put of ``npairs`` pairs at word
+    offset ``word_off`` of the region at ``addr`` (before the payload store)."""
+    if _T is None or not _T.k.blame or _T.stage is None:
+        return
+    from atom.models.qwen4_exp_mono.kernels import numa
+    from atom.models.qwen4_exp_mono.kernels.device_ops import rsrc
+
+    if isinstance(addr, numa.Box):
+        addr = addr.logical()
+    bo.buffer_store(
+        _side_words(npairs, tag),
+        rsrc(addr + fx.Int64(side_delta())),
+        word_off,
+        cache_modifier=cm,
+    )
+
+
+# ------------------------------------------------------------- consumer side
+
+
+def _side_bad(v, tag12):
+    bad = (v[1] & -4096) != tag12
+    for e in range_constexpr(3, len(v), 2):
+        bad = bad | ((v[e] & -4096) != tag12)
+    return bad
+
+
+def _side_spin_body(sspecs, tag12, cm):
+    from atom.models.qwen4_exp_mono.kernels.mailbox import load_pairs
+
+    v = load_pairs(sspecs, cm)
+    n = fx.Int32(0)
+    while _side_bad(v, tag12) & (n < SIDE_SPIN):
+        v = load_pairs(sspecs, cm)
+        n = n + 1
+    return v
+
+
+_side_spin = ASTRewriter.transform(_side_spin_body)
+
+
+def _blame_key(v, tag12):
+    best = fx.Int64(0)
+    for e in range_constexpr(0, len(v), 2):
+        stamp = fx.Vector.from_elements([v[e], fx.Int32(0)], fx.Int32).bitcast(
+            fx.Int64
+        )[0]  # zext
+        key = (stamp << 12) | fx.Int64(v[e + 1] & 0xFFF)
+        ok = (v[e + 1] & -4096) == tag12
+        key = ok.select(key, fx.Int64(0))
+        best = (key > best).select(key, best)
+    return best
+
+
+def _record_spin(sp, slot, n):
+    # an LDS atomic max by every active lane: polls in wave-divergent code
+    # (a DPP wave reduction would read inactive lanes)
+    fx.atomic_max(sp + slot, n)
+
+
+def spin_counting():
+    return _T is not None and _T.k.spin and _T.stage is not None
+
+
+def poll_done(specs, tag, cm, retries=None):
+    """``mailbox.poll_raw`` after the poll succeeded: blame, spin count, post
+    delay of the stage being traced."""
+    if _T is None or _T.stage is None:
+        return
+    from atom.models.qwen4_exp_mono.kernels.device_ops import uniform
+
+    slot = _T.i * WAVES + uniform(fx.thread_idx.x // 64)
+    if _T.k.blame and _T.bl is not None:
+        d = fx.Int64(side_delta())
+        from atom.models.qwen4_exp_mono.kernels import numa
+
+        sspecs = [
+            ((b.logical() if isinstance(b, numa.Box) else b) + d, i, n)
+            for b, i, n in specs
+        ]
+        tag12 = fx.Int32(tag) << 12
+        v = _side_spin(sspecs, tag12, cm)
+        fx.atomic_max(_T.bl + slot, _blame_key(v, tag12))
+    if retries is not None and _T.sp is not None:
+        _record_spin(_T.sp, slot, retries)
+    if not _T.posted:
+        _T.posted = True
+        _emit_delays("post", _T.c)
+
+
+# ------------------------------------------------------------- flush
+
+
+def _flush_body(arr, n, off, scratch, layer):
+    tid = fx.thread_idx.x
+    if tid < n:
+        r = bo.create_buffer_resource_from_addr(scratch + fx.Int64(off))
+        bo.buffer_store(
+            fx.ptr_load(arr + tid), r, (layer * GRID + fx.block_idx.x) * n + tid
+        )
+
+
+_flush = ASTRewriter.transform(_flush_body)
+
+
+def flush(scratch, layer):
+    """Kernel end (after ``stamps.flush``'s barrier): the CTA's blame / spin
+    slots to the scratch tail."""
+    if _T is None:
+        return
+    if _T.bl is not None:
+        _flush(_T.bl, BL_POINTS, blame_offset(), scratch, layer)
+    if _T.sp is not None:
+        _flush(_T.sp, SP_POINTS, spin_offset(), scratch, layer)
