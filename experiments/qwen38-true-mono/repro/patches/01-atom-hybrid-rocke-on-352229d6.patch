@@ -0,0 +1,266 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+"""``ATOM_Q38_EXTERN_STAGES`` (``kernels.extern_stages``, the hybrid path; off
+by default): knob parsing, file resolution per build variant, the sidecar
+ABI / symbol check, the missing-variant policy, and the build-key entries.
+CPU only; the linked builds themselves are checked on gfx950 by the q38
+harness (``hybrid/ab_extern.py``: bit-identical stage, mutant differs)."""
+
+import json
+
+import pytest
+
+from atom.models.qwen4_exp_mono.kernels import extern_stages as X
+
+LAYER_ARGS = ("scratch", "ple", "qsa", "h_out")  # any argument list: the ABI follows it
+KNOWN = ("a1", "a2", "q1", "q2", "b1")
+
+
+def _write(d, stage, var, layer_args=LAYER_ARGS, symbol=None, ext=".ll", body="; fn\n", **extra):
+    (d / f"{stage}_{var}{ext}").write_text(body)
+    meta = {
+        "symbol": symbol or f"rocke_q38_{stage}_{var}",
+        "abi": X.expected_abi(layer_args),
+        "ffi_types": ["int32"] * len(X.expected_abi(layer_args)),
+        **extra,
+    }
+    (d / f"{stage}_{var}.json").write_text(json.dumps(meta))
+
+
+def test_off_by_default(monkeypatch):
+    monkeypatch.delenv(X.ENV, raising=False)
+    assert X.requested() == {}
+    assert X.resolve(("a1", "q2"), 1, False, 0, LAYER_ARGS, KNOWN) == ()
+    assert X.key(()) == () and X.suffix(()) == ""
+
+
+def test_parse():
+    assert X.parse(" q2=/a/{variant}.ll , b1=/b ") == {"q2": "/a/{variant}.ll", "b1": "/b"}
+    for bad in ("q2", "=x", "q2=", "q2=/a,q2=/b"):
+        with pytest.raises(ValueError):
+            X.parse(bad)
+
+
+def test_variant_names():
+    assert X.variant(1, False, 0) == "r1"
+    assert X.variant(4, True, 0) == "r4s"
+    assert X.variant(8, False, 2) == "r8g2"
+
+
+@pytest.mark.parametrize("form", ["dir", "template"])
+def test_resolve(tmp_path, form):
+    _write(tmp_path, "q2", "r4s")
+    path = str(tmp_path) if form == "dir" else str(tmp_path / "q2_{variant}.ll")
+    (e,) = X.resolve(("a1", "a2", "q1", "q2"), 4, True, 0, LAYER_ARGS, KNOWN, spec={"q2": path})
+    assert e.stage == "q2" and e.symbol == "rocke_q38_q2_r4s"
+    assert e.path.endswith("q2_r4s.ll")
+    # a requested stage of another kind is not in this build
+    assert X.resolve(("a1", "b1"), 4, True, 0, LAYER_ARGS, KNOWN, spec={"q2": path}) == ()
+
+
+def test_directory_prefers_bitcode(tmp_path):
+    _write(tmp_path, "q2", "r1")
+    _write(tmp_path, "q2", "r1", ext=".bc")
+    (e,) = X.resolve(("q2",), 1, False, 0, LAYER_ARGS, KNOWN, spec={"q2": str(tmp_path)})
+    assert e.path.endswith("q2_r1.bc")
+
+
+def test_unknown_stage(tmp_path):
+    with pytest.raises(ValueError, match="unknown stage"):
+        X.resolve(("q2",), 1, False, 0, LAYER_ARGS, KNOWN, spec={"zz": str(tmp_path)})
+
+
+def test_missing_variant(tmp_path, monkeypatch):
+    _write(tmp_path, "q2", "r1")
+    spec = {"q2": str(tmp_path)}
+    monkeypatch.delenv(X.MISSING_ENV, raising=False)
+    with pytest.raises(FileNotFoundError, match="r2g2"):
+        X.resolve(("q2",), 2, False, 2, LAYER_ARGS, KNOWN, spec=spec)
+    monkeypatch.setenv(X.MISSING_ENV, "mono")
+    assert X.resolve(("q2",), 2, False, 2, LAYER_ARGS, KNOWN, spec=spec) == ()
+    monkeypatch.setenv(X.MISSING_ENV, "maybe")
+    with pytest.raises(ValueError):
+        X.resolve(("q2",), 2, False, 2, LAYER_ARGS, KNOWN, spec=spec)
+
+
+def test_sidecar_must_match(tmp_path):
+    _write(tmp_path, "q2", "r1", symbol="other")
+    with pytest.raises(ValueError, match="symbol"):
+        X.resolve(("q2",), 1, False, 0, LAYER_ARGS, KNOWN, spec={"q2": str(tmp_path)})
+    _write(tmp_path, "q2", "r1", layer_args=LAYER_ARGS[:-1])
+    with pytest.raises(ValueError, match="ABI"):
+        X.resolve(("q2",), 1, False, 0, LAYER_ARGS, KNOWN, spec={"q2": str(tmp_path)})
+
+
+def test_key_follows_the_file_contents(tmp_path):
+    _write(tmp_path, "q2", "r1")
+    spec = {"q2": str(tmp_path)}
+    a = X.resolve(("q2",), 1, False, 0, LAYER_ARGS, KNOWN, spec=spec)
+    _write(tmp_path, "q2", "r1", body="; edited\n")
+    b = X.resolve(("q2",), 1, False, 0, LAYER_ARGS, KNOWN, spec=spec)
+    assert X.key(a) != X.key(b) and X.suffix(a) != X.suffix(b)
+    assert X.suffix(a).startswith("_x")
+
+
+def test_the_layer_abi():
+    pytest.importorskip("flydsl")
+    from atom.models.qwen4_exp_mono.kernels import kernel
+
+    abi = X.expected_abi(kernel.LAYER_ARGS)
+    assert abi[:4] == [["tag", "i32"], ["task", "i32"], ["step", "i64"], ["layer", "i32"]]
+    assert len(abi) == 4 + len(kernel.LAYER_ARGS) + X.L_ARGS + 1
+    assert set(kernel._ALL_STAGES) >= {"a1", "q2", "m5", "p2"}
+
+
+def test_prologue_resolution(tmp_path):
+    """``<stage>pre`` (a prologue another stage hosts, e.g. B1 for ``b3pre``):
+    resolved right after its stage, own symbol, only with the stage extern."""
+    known = KNOWN + ("b3",)
+    for st in ("b3", "b3pre"):
+        _write(tmp_path, st, "r4s")
+    spec = {"b3": str(tmp_path), "b3pre": str(tmp_path)}
+    ext = X.resolve(("b1", "b3"), 4, True, 0, LAYER_ARGS, known, spec=spec)
+    assert [e.stage for e in ext] == ["b3", "b3pre"]
+    assert ext[1].symbol == "rocke_q38_b3pre_r4s"
+    assert X.key(ext) != X.key(ext[:1])
+    with pytest.raises(ValueError, match="needs b3"):
+        X.resolve(("b1", "b3"), 4, True, 0, LAYER_ARGS, known, spec={"b3pre": str(tmp_path)})
+    with pytest.raises(ValueError, match="unknown"):
+        X.resolve(("b1",), 4, True, 0, LAYER_ARGS, known, spec={"q2pre": str(tmp_path)})
+
+
+def test_stage_that_needs_its_prologue(tmp_path, monkeypatch, capsys):
+    """A body whose sidecar says ``needs: [b3pre]`` (rocKE ``pre="dma"``)
+    never links without its prologue: without ``b3pre`` in the knob it raises;
+    with the prologue's file missing under MISSING=mono both stay FlyDSL;
+    under MISSING=error it raises; prologue and body built with different
+    knobs raise; a ``needs`` entry that is not the stage's prologue raises."""
+    known = KNOWN + ("b3",)
+    stages = ("b1", "b3")
+    _write(tmp_path, "b3", "r1", needs=["b3pre"], stage_knobs="pre=dma")
+    _write(tmp_path, "b3pre", "r1", stage_knobs="pre=dma")
+    _write(tmp_path, "b3", "r2s", needs=["b3pre"], stage_knobs="pre=dma")  # no b3pre_r2s
+    d = str(tmp_path)
+    with pytest.raises(ValueError, match="b3pre"):
+        X.resolve(stages, 1, False, 0, LAYER_ARGS, known, spec={"b3": d})
+    both = {"b3": d, "b3pre": d}
+    ext = X.resolve(stages, 1, False, 0, LAYER_ARGS, known, spec=both)
+    assert [e.stage for e in ext] == ["b3", "b3pre"]
+    monkeypatch.delenv(X.MISSING_ENV, raising=False)
+    with pytest.raises(FileNotFoundError, match="b3pre"):
+        X.resolve(stages, 2, True, 0, LAYER_ARGS, known, spec=both)
+    monkeypatch.setenv(X.MISSING_ENV, "mono")
+    capsys.readouterr()
+    assert X.resolve(stages, 2, True, 0, LAYER_ARGS, known, spec=both) == ()
+    assert "b3 r2s runs the FlyDSL stage too" in capsys.readouterr().err
+    _write(tmp_path, "b3pre", "r1", stage_knobs="pre=dma,split=2")
+    with pytest.raises(ValueError, match="knobs"):
+        X.resolve(stages, 1, False, 0, LAYER_ARGS, known, spec=both)
+    _write(tmp_path, "b3", "r3", needs=["q2pre"])
+    with pytest.raises(ValueError, match="not a prologue"):
+        X.resolve(stages, 3, False, 0, LAYER_ARGS, known, spec=both)
+
+
+def test_prologue_only_with_its_body(tmp_path, monkeypatch):
+    """No prologue without its body (MISSING=mono drops the body: the FlyDSL
+    B3 keeps its LDS); a body that lists ``needs`` without the prologue does
+    not link it, and a missing prologue file is then no error."""
+    known = KNOWN + ("b3",)
+    stages = ("b1", "b3")
+    d = str(tmp_path)
+    both = {"b3": d, "b3pre": d}
+    _write(tmp_path, "b3pre", "r4", stage_knobs="pre=dma")  # stale, no b3_r4
+    monkeypatch.setenv(X.MISSING_ENV, "mono")
+    assert X.resolve(stages, 4, False, 0, LAYER_ARGS, known, spec=both) == ()
+    monkeypatch.delenv(X.MISSING_ENV, raising=False)
+    _write(tmp_path, "b3", "r4", needs=[], stage_knobs="head_map=xcd")
+    ext = X.resolve(stages, 4, False, 0, LAYER_ARGS, known, spec=both)
+    assert [e.stage for e in ext] == ["b3"]
+    _write(tmp_path, "b3", "r4s", needs=[])  # and no b3pre_r4s: not an error
+    assert [e.stage for e in X.resolve(stages, 4, True, 0, LAYER_ARGS, known, spec=both)] == ["b3"]
+
+
+def test_numa_sidecars(tmp_path, monkeypatch):
+    """A function built for the numa=1 mailbox layout (sidecar ``"mailboxes":
+    "numa1"`` with its NUMA header offset) links only where the scratch has the
+    NUMA area at that offset, and its build keeps the numa=1 lever
+    (``numa_kept``); a plain function drops the lever; mixed or mismatched
+    layouts raise."""
+    numa = pytest.importorskip("atom.models.qwen4_exp_mono.kernels.numa")
+    from atom.models.qwen4_exp_mono.kernels import sched
+
+    hdr = numa.header_offset()
+    stages = ("a1", "a2", "q1", "q2")
+    spec = {"q2": str(tmp_path)}
+    _write(tmp_path, "q2", "r4s", mailboxes="numa1", numa_hdr=hdr)
+    _write(tmp_path, "q2", "r4", mailboxes="numa1", numa_hdr=hdr + 256)
+    _write(tmp_path, "q2", "r2s", mailboxes="numa1")
+    _write(tmp_path, "q2", "r3s", mailboxes="numa9", numa_hdr=hdr)
+    _write(tmp_path, "q2", "r2")
+    monkeypatch.delenv(sched.ENV_SCHED, raising=False)
+    with pytest.raises(ValueError, match="numa lever"):  # no NUMA area in the scratch
+        X.resolve(stages, 4, True, 0, LAYER_ARGS, KNOWN, spec=spec)
+    monkeypatch.setenv(sched.ENV_SCHED, "numa=1")
+    (e,) = X.resolve(stages, 4, True, 0, LAYER_ARGS, KNOWN, spec=spec)
+    assert e.mailboxes == "numa1"
+    assert X.numa_kept((e,), {"numa": 1})
+    for levers in ({}, {"numa": 2}, {"numa": 3}):
+        with pytest.raises(ValueError, match="numa=1 mailbox layout"):
+            X.numa_kept((e,), levers)
+    with pytest.raises(ValueError, match="NUMA header"):
+        X.resolve(stages, 4, False, 0, LAYER_ARGS, KNOWN, spec=spec)
+    with pytest.raises(ValueError, match="without numa_hdr"):
+        X.resolve(stages, 2, True, 0, LAYER_ARGS, KNOWN, spec=spec)
+    with pytest.raises(ValueError, match="mailboxes"):
+        X.resolve(stages, 3, True, 0, LAYER_ARGS, KNOWN, spec=spec)
+    (p,) = X.resolve(stages, 2, False, 0, LAYER_ARGS, KNOWN, spec=spec)
+    assert p.mailboxes == "plain" and not X.numa_kept((p,), {"numa": 1})
+    with pytest.raises(ValueError, match="numa=1 mailbox layout"):
+        X.numa_kept((e, p), {"numa": 1})
+    assert X.numa_kept((), {"numa": 1})
+
+
+def test_numa_body_and_prologue(tmp_path, monkeypatch):
+    """A numa=1 B3 (rocKE ``stage_b3`` knob ``numa=1``: both sidecars say
+    ``"mailboxes": "numa1"``, the prologue carrying its body's keys) keeps the
+    lever for its build, also together with other numa1 stages (the fused
+    MoE); a prologue left plain next to a numa1 body (a mixed generation)
+    raises instead of silently dropping the lever."""
+    numa = pytest.importorskip("atom.models.qwen4_exp_mono.kernels.numa")
+    from atom.models.qwen4_exp_mono.kernels import sched
+
+    monkeypatch.setenv(sched.ENV_SCHED, "best")
+    hdr = numa.header_offset()
+    known = KNOWN + ("b3", "m3")
+    stages = ("b1", "b3", "m3")
+    n1 = {"mailboxes": "numa1", "numa_hdr": hdr}
+    _write(tmp_path, "b3", "r1", needs=["b3pre"], stage_knobs="pre=dma,numa=1", **n1)
+    _write(tmp_path, "b3pre", "r1", stage_knobs="pre=dma,numa=1", **n1)
+    _write(tmp_path, "m3", "r1", **n1)
+    d = str(tmp_path)
+    ext = X.resolve(stages, 1, False, 0, LAYER_ARGS, known, spec={"b3": d, "b3pre": d, "m3": d})
+    assert [(e.stage, e.mailboxes) for e in ext] == [("b3", "numa1"), ("b3pre", "numa1"), ("m3", "numa1")]
+    assert X.numa_kept(ext, {"numa": 1})
+    _write(tmp_path, "b3pre", "r1", stage_knobs="pre=dma,numa=1")  # plain sidecar
+    ext = X.resolve(stages, 1, False, 0, LAYER_ARGS, known, spec={"b3": d, "b3pre": d})
+    with pytest.raises(ValueError, match="numa=1 mailbox layout"):
+        X.numa_kept(ext, {"numa": 1})
+
+
+def test_build_log_names_levers_and_layouts(monkeypatch, capsys):
+    """``sched.log_build``: with ``ATOM_Q38_SCHED`` set, one line per build
+    (kind, variant, final levers, extern layouts), deduplicated; unset, none."""
+    sched = pytest.importorskip("atom.models.qwen4_exp_mono.kernels.sched")
+
+    e = X.ExternStage("b3", "/x/b3_r4s.ll", "rocke_q38_b3_r4s", (), "0", "numa1")
+    monkeypatch.delenv(sched.ENV_SCHED, raising=False)
+    sched.log_build(("a1", "b3"), 4, True, 0, (("lever", ("numa", 1)),), (e,))
+    assert capsys.readouterr().err == ""
+    monkeypatch.setenv(sched.ENV_SCHED, "best")
+    kn = (("lever", ("head_sleep", 128)), ("lever", ("numa", 1)))
+    sched.log_build(("a1", "b3"), 4, True, 0, kn, (e,))
+    sched.log_build(("a1", "b3"), 4, True, 0, kn, (e,))
+    err = capsys.readouterr().err.splitlines()
+    assert err == ["[ATOM_Q38_SCHED] build delta r4s: head_sleep=128 numa=1 | extern b3:numa1"]
+    sched.log_build(("a1", "q1"), 8, False, 2, (), ())
+    assert capsys.readouterr().err.strip() == "[ATOM_Q38_SCHED] build qsa r8g2: none"
