index 0000000000000000000000000000000000000000..261513304d4c03efb411c272bba8a61549f3be22
--- /dev/null
+++ b/atom/models/qwen4_exp_mono/q38_hook.py
@@ -0,0 +1,355 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+"""Measurement hooks of the Qwen3.8-Flash-Next mono (all off by default).
+
+- ``ATOM_Q38_DUMP=<dir>``: when the runners bind the weights, the kernel
+  arguments of the layers in ``ATOM_Q38_DUMP_LAYERS`` (default
+  ``0,1,3,47,mtp``; ``mtp`` is the draft layer) are saved as
+  ``<dir>/layer_<i>.pt`` (``LayerWeights`` fields, CPU tensors, in the
+  kernels' layouts), with the RoPE tables (``rope.pt``) and the geometry
+  (``meta.json``). A single-layer bench replays them with real weights.
+- ``ATOM_Q38_TRACE=<dir>``: on eager steps only (a graph replay runs no
+  Python, so serve with ``--enforce-eager``), steps ``ATOM_Q38_TRACE_SKIP``
+  (default 20) on, ``ATOM_Q38_TRACE_STEPS`` (default 16) of them, save per
+  step ``<dir>/<kind>_r<rows>_<n>.pt``: every target layer's router logits
+  (the scratch's ``lg`` mailbox region, copied after each layer launch) and,
+  with ``ATOM_Q38_STAMPS=1``, the stamp region (``kernels.stamps``) of the
+  target pass and of each draft step.
+
+- ``ATOM_Q38_ROUND=<dir>`` (with ``ATOM_Q38_STAMPS=1``): per draft step, the
+  entry / last-exit stamps of the draft layer's launch and, once a round, of
+  every target layer's launch (graph replays included): the device-side round
+  timeline (``_Round``), with the GPU time of the hook's own gathers.
+- ``ATOM_Q38_ROCTX_TRIGGER=<file>``: for ``rocprofv3 --selected-regions``
+  (collection only between ``roctxProfilerResume`` and ``roctxProfilerPause``),
+  a thread of the model's process resumes collection once ``<file>`` exists and
+  pauses it ``ATOM_Q38_ROCTX_SECONDS`` (default 5) later: a short steady-state
+  window of a served run, graph replays included.
+
+Neither changes what the kernels compute. The trace copies add stream-ordered
+copies between the layer launches of the steps they run on.
+"""
+
+import json
+import logging
+import os
+from dataclasses import asdict
+
+import torch
+
+from .kernels import stamps
+from .kernels.config import GRID
+from .kernels.layout import MAX_ROWS, REGIONS, SC, SCRATCH_BYTES, mailbox_bytes
+from .kernels.layout_wide import WIDE_ROWS
+
+logger = logging.getLogger("atom")
+
+_ACTIVE = None
+
+
+def dump(runner_kind: str, bound, rope=None, geometry=None) -> None:
+    """``ATOM_Q38_DUMP``: save the selected layers of ``bound`` (a list of
+    ``LayerWeights`` for the target, one for the draft layer)."""
+    out = os.environ.get("ATOM_Q38_DUMP")
+    if not out:
+        return
+    os.makedirs(out, exist_ok=True)
+    want = os.environ.get("ATOM_Q38_DUMP_LAYERS", "0,1,3,47,mtp").split(",")
+    layers = bound if isinstance(bound, list) else [bound]
+    for b in layers:
+        name = "mtp" if runner_kind == "draft" else str(b.layer_id)
+        if name not in want:
+            continue
+
+        def cpu(d):
+            return None if d is None else {k: v.detach().cpu() for k, v in d.items()}
+
+        torch.save(
+            {
+                "layer_id": b.layer_id,
+                "kind": b.kind,
+                "args": cpu(b.args),
+                "qsa_norms": cpu(b.qsa_norms),
+                "ple": cpu(b.ple),
+            },
+            os.path.join(out, f"layer_{name}.pt"),
+        )
+        logger.info("Qwen3.8 mono q38: dumped layer %s to %s", name, out)
+    if rope is not None:
+        torch.save([t.detach().cpu() for t in rope], os.path.join(out, "rope.pt"))
+    if geometry is not None:
+        with open(os.path.join(out, "meta.json"), "w") as f:
+            json.dump({k: v for k, v in asdict(geometry).items()}, f, default=str)
+
+
+class _Trace:
+    def __init__(self, out: str):
+        self.out = out
+        os.makedirs(out, exist_ok=True)
+        self.skip = int(os.environ.get("ATOM_Q38_TRACE_SKIP", "20"))
+        self.steps = int(os.environ.get("ATOM_Q38_TRACE_STEPS", "16"))
+        self.seen = {}
+        self.lg = {}
+        self.draft_stamps = []
+
+    def _live(self, key) -> bool:
+        if torch.cuda.is_current_stream_capturing():
+            return False
+        n = self.seen.get(key, 0)
+        return self.skip <= n < self.skip + self.steps
+
+    @staticmethod
+    def _lg_view(scratch: torch.Tensor, rows: int) -> torch.Tensor:
+        """``[rows, lg pairs * 2]`` int32 views of the ``lg`` region per row."""
+        words = REGIONS["lg"] * 2
+        base, stride = SC["lg"] // 4, SCRATCH_BYTES // 4
+        return scratch.as_strided((rows, words), (stride, 1), base)
+
+    def after_layer(self, runner, w, i: int) -> None:
+        key = ("verify" if w.seq else "decode", w.rows)
+        if not self._live(key):
+            return
+        buf = self.lg.get(key)
+        if buf is None:
+            buf = torch.zeros(
+                len(runner.kinds),
+                w.rows,
+                REGIONS["lg"] * 2,
+                dtype=torch.int32,
+                device=runner.scratch.device,
+            )
+            self.lg[key] = buf
+        buf[i].copy_(self._lg_view(runner.scratch, w.rows))
+
+    def after_draft(self, runner, w) -> None:
+        key = ("verify", runner.verify_rows)
+        if not stamps.enabled() or not self._live(key):
+            return
+        region = _stamp_region(
+            runner.scratch if w.rows <= MAX_ROWS else runner.wide_scratch, w.rows
+        )
+        self.draft_stamps.append((w.rows, region[runner.layer_id].clone()))
+
+    def after_step(self, runner, w) -> None:
+        key = ("verify" if w.seq else "decode", w.rows)
+        n = self.seen.get(key, 0)
+        self.seen[key] = n + 1
+        if (
+            not (self.skip <= n < self.skip + self.steps)
+            or torch.cuda.is_current_stream_capturing()
+        ):
+            self.draft_stamps = []
+            return
+        rec = {
+            "kinds": runner.kinds,
+            "rows": w.rows,
+            "seq": w.seq,
+            "lg": self.lg[key].cpu(),
+        }
+        if stamps.enabled():
+            rec["stamps"] = _stamp_region(runner.scratch, w.rows)[
+                : len(runner.kinds)
+            ].cpu()
+        # the draft steps that ran since the previous target step (they precede it)
+        rec["draft_stamps"] = [(r, t.cpu()) for r, t in self.draft_stamps]
+        self.draft_stamps = []
+        torch.save(
+            rec, os.path.join(self.out, f"{key[0]}_r{w.rows}_{n - self.skip}.pt")
+        )
+
+
+def _stamp_region(scratch: torch.Tensor, rows: int) -> torch.Tensor:
+    """``[LAYER_SLOTS, GRID, POINTS]`` int64 view of a scratch's stamp region."""
+    base = mailbox_bytes(WIDE_ROWS if rows > MAX_ROWS else MAX_ROWS)
+    flat = scratch.view(torch.int64)
+    return flat[base // 8 : (base + stamps.REGION_BYTES) // 8].view(
+        stamps.LAYER_SLOTS, -1, stamps.POINTS
+    )
+
+
+def _roctx_window(trigger: str, seconds: float) -> None:
+    import ctypes
+    import threading
+    import time
+
+    lib = None
+    for name in (
+        "librocprofiler-sdk-roctx.so.1",
+        "librocprofiler-sdk-roctx.so",
+        "libroctx64.so",
+    ):
+        try:
+            lib = ctypes.CDLL(name)
+            break
+        except OSError:
+            continue
+    if lib is None:
+        logger.warning(
+            "Qwen3.8 mono q38: no roctx library; ATOM_Q38_ROCTX_TRIGGER ignored"
+        )
+        return
+    lib.roctxProfilerPause.argtypes = [ctypes.c_uint64]
+    lib.roctxProfilerResume.argtypes = [ctypes.c_uint64]
+
+    def run():
+        while not os.path.exists(trigger):
+            time.sleep(0.05)
+        lib.roctxProfilerResume(0)
+        logger.info("Qwen3.8 mono q38: roctx collection resumed for %.1f s", seconds)
+        time.sleep(seconds)
+        lib.roctxProfilerPause(0)
+        logger.info("Qwen3.8 mono q38: roctx collection paused")
+
+    threading.Thread(target=run, name="q38-roctx", daemon=True).start()
+
+
+_TRIGGER = os.environ.get("ATOM_Q38_ROCTX_TRIGGER")
+if _TRIGGER:
+    _roctx_window(_TRIGGER, float(os.environ.get("ATOM_Q38_ROCTX_SECONDS", "5")))
+
+
+_RUNNERS = {}
+
+
+def register(kind: str, runner) -> None:
+    """The target (``kind`` "target") or draft runner, for the round hook."""
+    _RUNNERS[kind] = runner
+
+
+class _Round:
+    """``ATOM_Q38_ROUND=<dir>`` (with ``ATOM_Q38_STAMPS=1``; graph-replayed
+    target passes too, as the draft steps run eagerly): at every draft step,
+    one gather of the CTA entry and last-exit stamps of the draft layer's
+    launch, and at a round's first draft step also of every target layer's
+    launch, into a device ring; ``ATOM_Q38_ROUND_STEPS`` (default 256) draft
+    steps after ``ATOM_Q38_ROUND_SKIP`` (default 64) are saved as
+    ``<dir>/round_stamps.pt``. Cost: one or two gather launches per draft
+    step, right after its draft layer; a pair of timing events around them
+    records their GPU time (``gather_us``, per step), so that the
+    decomposition can take them out of the interval they sit in.
+
+    A round's first draft step (``DraftWidth.group`` > 1: the verify's rows,
+    one request's ``S`` or ``n·S`` of a grouped verify) also gathers the
+    target pass's stamps, from the scratch that pass ran on: the target's
+    wide scratch past ``MAX_ROWS`` rows (``group_runner``), else its own."""
+
+    def __init__(self, out: str):
+        self.out = out
+        os.makedirs(out, exist_ok=True)
+        self.skip = int(os.environ.get("ATOM_Q38_ROUND_SKIP", "64"))
+        self.n = int(os.environ.get("ATOM_Q38_ROUND_STEPS", "256"))
+        self.seen = 0
+        self.ring_t = self.ring_d = None
+        self.meta = []
+        self.events = []
+        self.saved = False
+
+    def _cols(self, kinds, dev):
+        from .kernels.kernel import STAGES
+
+        ex = sorted({stamps.exit_ix(len(STAGES[k]) - 1) for k in kinds})
+        return [0, *ex]
+
+    def after_draft(self, runner, w) -> None:
+        if self.saved or torch.cuda.is_current_stream_capturing():
+            return
+        n = self.seen
+        self.seen += 1
+        if n < self.skip:
+            return
+        i = n - self.skip
+        if i >= self.n:
+            self._save()
+            return
+        target = _RUNNERS.get("target")
+        dev = runner.scratch.device
+        if self.ring_d is None:
+            self.cols_d = torch.tensor(self._cols(["qsa"], dev), device=dev)
+            self.ring_d = torch.zeros(
+                self.n, GRID, len(self.cols_d), dtype=torch.int64, device=dev
+            )
+            self.kinds = list(target.kinds) if target is not None else []
+            self.cols_t = torch.tensor(
+                self._cols(self.kinds or ["qsa"], dev), device=dev
+            )
+            self.ring_t = torch.zeros(
+                self.n,
+                len(self.kinds),
+                GRID,
+                len(self.cols_t),
+                dtype=torch.int64,
+                device=dev,
+            )
+        wide = w.rows > MAX_ROWS
+        ev = (
+            torch.cuda.Event(enable_timing=True),
+            torch.cuda.Event(enable_timing=True),
+        )
+        ev[0].record()
+        region = _stamp_region(runner.wide_scratch if wide else runner.scratch, w.rows)
+        torch.index_select(region[runner.layer_id], 1, self.cols_d, out=self.ring_d[i])
+        # a round's first draft step runs the verify's rows (``DraftWidth.group``
+        # > 1); a later one a row per request (group 1)
+        first = w.group > 1
+        tsc = None
+        if first and target is not None:
+            # the target pass ran the same rows, on its wide scratch past MAX_ROWS
+            tsc = getattr(target, "wide_scratch", None) if wide else target.scratch
+        if tsc is not None:
+            treg = _stamp_region(tsc, w.rows)[: len(self.kinds)]
+            torch.index_select(treg, 2, self.cols_t, out=self.ring_t[i])
+        ev[1].record()
+        self.events.append(ev)
+        self.meta.append((w.rows, first and tsc is not None))
+
+    def _save(self):
+        self.saved = True
+        torch.cuda.synchronize()
+        gather_us = [a.elapsed_time(b) * 1e3 for a, b in self.events]
+        torch.save(
+            {
+                "kinds": self.kinds,
+                "cols_t": self.cols_t.cpu(),
+                "cols_d": self.cols_d.cpu(),
+                "draft": self.ring_d.cpu(),
+                "target": self.ring_t.cpu(),
+                "meta": self.meta,
+                "gather_us": gather_us,
+            },
+            os.path.join(self.out, "round_stamps.pt"),
+        )
+        logger.info("Qwen3.8 mono q38: round stamps saved to %s", self.out)
+
+
+class _Hooks:
+    """The active hooks (``ATOM_Q38_TRACE``, ``ATOM_Q38_ROUND``) as one."""
+
+    def __init__(self, parts):
+        self.parts = parts
+
+    def after_layer(self, runner, w, i):
+        for p in self.parts:
+            if hasattr(p, "after_layer"):
+                p.after_layer(runner, w, i)
+
+    def after_step(self, runner, w):
+        for p in self.parts:
+            if hasattr(p, "after_step"):
+                p.after_step(runner, w)
+
+    def after_draft(self, runner, w):
+        for p in self.parts:
+            p.after_draft(runner, w)
+
+
+def active():
+    """The ``ATOM_Q38_TRACE`` / ``ATOM_Q38_ROUND`` hooks, or None."""
+    global _ACTIVE
+    if _ACTIVE is None:
+        parts = []
+        if os.environ.get("ATOM_Q38_TRACE"):
+            parts.append(_Trace(os.environ["ATOM_Q38_TRACE"]))
+        if os.environ.get("ATOM_Q38_ROUND"):
+            parts.append(_Round(os.environ["ATOM_Q38_ROUND"]))
+        _ACTIVE = _Hooks(parts) if parts else False
+    return _ACTIVE or None
