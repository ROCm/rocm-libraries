+++ b/scripts/qwen38_rocke/gdn-b3/insitu_b3.py
@@ -0,0 +1,647 @@
+"""B3 in situ (hybrid path): the mono DeltaNet layer with its B3 replaced by the rocKE B3 function
+(``ATOM_Q38_EXTERN_STAGES=b3=...``) against the plain FlyDSL layer: bitwise, then timing.
+
+    python insitu_b3.py --variants r1,r4s --arms 'rk;rk:wait=barrier' --copies 16 --stamps \
+        --launches 96 --reps 20 --out r.json
+
+Per variant: one ``MonoRig`` (synthetic weights unless ``--dump/--real``; delta copies, cold).
+Arm ``mono`` is the plain layer; every ``rk[:knobs]`` arm writes ``b3_<variant>.{ll,json}``
+(``stage_b3.lower_b3_function``) and builds the layer with it linked in. Bitwise: the scratch
+(every mailbox but B3's internal exchange), the layer output, every DeltaNet state pool, after one
+launch from the same snapshot and tag; a mutant (B3 with ``exp=hw``, numerics-changing) must
+differ. Timing: a HIP graph per arm over the copies (fixed inputs, outputs per copy), interleaved
+replays; with ``--stamps`` the stage timelines (``timeline.py``): the launch's critical path,
+B3's increment and end, C1's end. Absolute numbers only in ``--out``; the console prints ratios.
+
+``Insitu`` is also the engine of ``climb_b3.py`` (hill climbing with lookback).
+
+``--sched SPEC`` (e.g. ``numa=1`` or ``best``): the rocKE arms and the extra arm ``mono_numa`` (the plain FlyDSL
+layer) build with ``ATOM_Q38_SCHED=SPEC``: the scratch gets ATOM's calibrated NUMA area, a build whose linked
+functions address the numa=1 layout (``B3Knobs(numa=1)``, sidecar ``"mailboxes": "numa1"``) keeps the lever
+(``extern_stages.numa_kept``), a plain function drops it (as ``kernel.build_layer``). The reference stays the
+PLAIN mono; an arm with the lever is compared on its LOGICAL view (every mailbox read back from copy 0 of the
+NUMA area) and its two copies must be equal (copy 1 == copy 0 over the whole mailbox part). ``--controls``:
+also time ``mono2`` (a second graph of the plain build) and, with ``--sched``, ``mono_numa`` / ``mono_numa2``.
+``--shuffle-seed N``: every timing round runs the arms in a seeded shuffled order (default: rotated).
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import random
+import statistics
+import sys
+import time
+from dataclasses import replace
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+for d in (os.path.join(HERE, "..", "harness"),):
+    if os.path.isdir(d):
+        sys.path.insert(0, d)
+sys.path.insert(0, HERE)
+
+import torch
+
+torch.cuda.init()
+
+import timeline
+from rig import MonoRig
+
+from atom.models.qwen4_exp_mono.kernels import extern_stages
+from atom.models.qwen4_exp_mono.kernels import kernel as K
+from atom.models.qwen4_exp_mono.kernels import layout as LY
+from atom.models.qwen4_exp_mono.kernels import numa as NUMA
+from atom.models.qwen4_exp_mono.kernels import sched as SCH
+from atom.models.qwen4_exp_mono.kernels import stamps as STAMPS
+
+BASE_KINDS = ["delta", "delta_ple", "delta", "qsa"]
+SLOTS = 48
+H_IN = K.LAYER_ARGS[1:].index("h_in")
+H_OUT = K.LAYER_ARGS[1:].index("h_out")
+
+
+def parse_variant(v):
+    import re
+
+    m = re.fullmatch(r"r(\d)(s?)(?:g(\d))?", v)
+    return int(m.group(1)), bool(m.group(2)), int(m.group(3) or 0)
+
+
+def parse_knobs(spec):
+    from kernels.gfx950.qwen38_mono import stage_b3 as SB
+    from rocke.helpers import mailbox as M
+
+    kn, mb = {}, {}
+    if spec:
+        for kv in spec.split(","):
+            k, v = kv.split("=")
+            target = mb if k.startswith("mb_") else kn
+            key = k.removeprefix("mb_")
+            if v.isdigit():
+                v = int(v)
+            elif v in ("True", "False", "true", "false"):
+                v = v.lower() == "true"
+            target[key] = v
+    if mb.get("impl") == "ir":
+        import kernels.gfx950.qwen38_mono.mailbox_ir  # noqa: F401
+    knobs = SB.B3Knobs(**kn)
+    if mb:
+        knobs = replace(knobs, mailbox=M.MailboxKnobs(**mb))
+    return knobs
+
+
+def knob_spec(knobs) -> str:
+    """Inverse of :func:`parse_knobs` (non-default fields only)."""
+    from kernels.gfx950.qwen38_mono import stage_b3 as SB
+    from rocke.helpers import mailbox as M
+
+    d, md = SB.B3Knobs(), M.MailboxKnobs()
+    parts = []
+    for f in knobs.__dataclass_fields__:
+        if f == "mailbox":
+            continue
+        v = getattr(knobs, f)
+        if v != getattr(d, f):
+            parts.append(f"{f}={v}")
+    for f in knobs.mailbox.__dataclass_fields__:
+        v = getattr(knobs.mailbox, f)
+        if v != getattr(md, f):
+            parts.append(f"mb_{f}={v}")
+    return ",".join(parts)
+
+
+def mask_internal(t):
+    """The scratch without B3's internal exchange regions (``core`` of every row and the
+    ``xchg="numa2"`` area): consumers never read them, an arm may lay them out differently.
+    """
+    from kernels.gfx950.qwen38_mono import stage_b3 as SB
+
+    t = t.clone()
+    for r in range(LY.MAX_ROWS):
+        lo = (LY.SC["core"] + r * LY.SCRATCH_BYTES) // 4
+        t[lo : lo + 2 * LY.REGIONS["core"]] = 0
+    lo = SB.XCHG_OFFSET // 4
+    t[lo : lo + LY.MAX_ROWS * SB.XCHG_ROW_PAIRS * 2] = 0
+    # the stage stamps' region (stamped builds): device clock values, never equal run to run
+    t[LY.mailbox_bytes(LY.MAX_ROWS) // 4 :] = 0
+    return t
+
+
+def diff(a, b, name=""):
+    if name == "scratch":
+        a, b = mask_internal(a), mask_internal(b)
+    if torch.equal(a, b):
+        return None
+    av, bv = a.view(torch.uint8).flatten(), b.view(torch.uint8).flatten()
+    bad = (av != bv).nonzero().flatten()
+    return {"bytes_differ": int(bad.numel()), "first_byte": int(bad[0])}
+
+
+class Insitu:
+    """One variant's rig, the plain mono layer and any number of rocKE-B3 arms."""
+
+    def __init__(self, variant, copies=16, experts=512, share_experts=False, context=8192,
+                 dump=None, real=None, fn_dir="fns", stamps=False, launches=96, sched=None):  # fmt: skip
+        if stamps:
+            os.environ["ATOM_Q38_STAMPS"] = "1"
+        self.stamped = STAMPS.enabled()
+        self.variant = variant
+        self.rows, self.seq, self.group = parse_variant(variant)
+        self.copies, self.experts, self.fn_dir, self.launches = (
+            copies,
+            experts,
+            fn_dir,
+            launches,
+        )
+        from kernels.gfx950.qwen38_mono import stage_b3 as SB
+
+        self.SB = SB
+        self.shape = SB.B3Shape(self.rows, self.seq, self.group)
+        torch.cuda.empty_cache()
+        kinds = BASE_KINDS + ["delta"] * copies
+        self.idx = list(range(len(BASE_KINDS), len(kinds)))
+        realmap = {i: real for i in self.idx} if real else None
+        # grouped verify (``r<R>g<S>``): R / S requests of S rows each, the runner's grouped build
+        groups = self.rows // self.group if self.group else 0
+        spec_tokens = (
+            self.group - 1 if self.group else (self.rows - 1 if self.seq else 0)
+        )
+        self.rig = MonoRig(
+            kinds, experts=experts, context=context, spec_tokens=spec_tokens,
+            share_experts=share_experts, dump=dump, real=realmap, max_groups=groups,
+        )  # fmt: skip
+        r = self.r = self.rig.runner
+        self.sched = sched or None
+        n = (
+            (LY.mailbox_bytes(LY.MAX_ROWS) + STAMPS.REGION_BYTES) // 4
+            if self.stamped
+            else 0
+        )
+        if self.sched:
+            n = max(n, NUMA.scratch_bytes_needed() // 4)
+        if r.scratch.numel() < n:
+            r.scratch = torch.zeros(n, dtype=torch.int32, device="cuda")
+        self.s = s = self.rig.group_step(groups) if groups else self.rig.step(self.rows)
+        assert (
+            self.rig.scratch_ptr(s) == r.scratch.data_ptr()
+        )  # rows <= KERNEL_ROWS: the base scratch
+        self.g = torch.Generator(device="cuda")
+        self.g.manual_seed(77)
+        s.w.h0.copy_(
+            torch.randn(s.w.h0.shape, generator=self.g, device="cuda").bfloat16()
+        )
+        s.w.chain.copy_(
+            torch.randn(s.w.chain.shape, generator=self.g, device="cuda").bfloat16()
+        )
+        self.rig.meta(s)
+        r.counter.add_(1)
+        r.scratch.zero_()
+        torch.cuda.synchronize()
+        self.numa_cal = None
+        if (
+            self.sched
+        ):  # the NUMA area's header (the page mask): calibrated once, part of every snapshot
+            mask, agree, info = NUMA.calibrate(r.scratch)
+            self.numa_cal = {
+                "mask": mask,
+                "agreement": agree,
+                **{k: v for k, v in info.items() if k != "xcc_pairs"},
+            }
+            print("NUMA", variant, json.dumps(self.numa_cal), flush=True)
+        self.stages = K.STAGES["delta"]
+        self.builds = {
+            "mono": K._build_layer(
+                self.stages, experts, self.rows, self.seq, self.group, self.stamped
+            )
+        }
+        self.knobs = {"mono": ()}
+        self.alias = {"mono2": "mono", "mono_numa2": "mono_numa"}
+        self.info = {"mono": {"kernel": "flydsl"}}
+        self.graphs = {}
+        i0 = self.idx[0]
+        st = self.rig.state
+        self.live = {
+            "scratch": r.scratch,
+            "h_out": s.w.chain[i0],
+            "rec": st.rec,
+            "conv": st.conv,
+        }
+        self.snap = {k: t.clone() for k, t in self.live.items()}
+        # the check launches' step counter (graph replays advance the live one: a check after a timing
+        # round would otherwise run with another tag than the reference)
+        self.counter0 = r.counter.clone()
+        self.ref = self.run_once(self.builds["mono"])
+        if self.sched:
+            sk = self.sknobs(())
+            self.builds["mono_numa"] = K._build_layer(self.stages, experts, self.rows, self.seq, self.group,
+                                                      self.stamped, (), sk)  # fmt: skip
+            self.knobs["mono_numa"] = sk
+            self.info["mono_numa"] = {
+                "kernel": "flydsl",
+                "sched": self.sched,
+                "levers": SCH.from_knobs(sk).levers,
+            }
+            self.info["mono_numa"]["check"] = self.check("mono_numa")
+            print(
+                "CHECK",
+                variant,
+                "mono_numa",
+                json.dumps(self.info["mono_numa"]["check"]),
+                flush=True,
+            )
+        width = self.rig.geometry.hc_width
+        ins = [
+            torch.randn(self.rows, width, generator=self.g, device="cuda").bfloat16()
+            for _ in range(8)
+        ]
+        self._keep = ins
+        self.outs = [
+            torch.zeros(self.rows, width, dtype=torch.bfloat16, device="cuda")
+            for _ in self.idx
+        ]
+        self.largs = []
+        for j in range(launches):
+            c = j % copies
+            lst = list(s.w.args[self.idx[c]])
+            lst[H_IN] = ins[j % len(ins)].data_ptr()
+            lst[H_OUT] = self.outs[c].data_ptr()
+            self.largs.append(lst)
+
+    # ------------------------------------------------------------ arms
+    def sknobs(self, externs):
+        """The schedule knobs of a build with ``externs`` under ``--sched`` (``kernel.build_layer``'s rule:
+        the numa lever stays only when every linked function addresses its layout); () without ``--sched``.
+        """
+        if not self.sched:
+            return ()
+        with _Env(SCH.ENV_SCHED, self.sched):
+            sk = SCH.resolve(
+                self.stamped, self.rows, self.seq, self.group, tuple(self.stages)
+            )
+            if externs and not extern_stages.numa_kept(
+                externs, SCH.from_knobs(sk).levers
+            ):
+                sk = SCH.without_numa(
+                    sk, tuple(self.stages), self.rows, self.seq, self.group
+                )
+        return sk
+
+    def numa_arm(self, name):
+        return bool(
+            SCH.from_knobs(self.knobs.get(self.alias.get(name, name), ())).levers.get(
+                "numa"
+            )
+        )
+
+    def add_arm(self, name, knobs):
+        from kernels.gfx950.qwen38_mono.mono_layout import from_atom
+
+        t0 = time.time()
+        d = os.path.join(self.fn_dir, self.variant, knobs.suffix() or "default")
+        lay = from_atom()
+        # the CLI's writer: sidecars with stage_knobs / needs and, for numa=1, the layout ATOM keeps the lever for
+        stems = self.SB.write_b3_functions(d, [self.shape], lambda s: knobs, lay)
+        with open(os.path.join(d, f"b3_{self.variant}.json")) as f:
+            meta = json.load(f)
+        spec = {"b3": d}
+        if f"b3pre_{self.variant}" in stems:
+            spec["b3pre"] = d
+        with _Env(
+            SCH.ENV_SCHED, self.sched
+        ):  # resolve checks a numa1 sidecar against the lever's NUMA area
+            ext = extern_stages.resolve(self.stages, self.rows, self.seq, self.group, K.LAYER_ARGS,
+                                        K._ALL_STAGES, spec=spec)  # fmt: skip
+        sk = self.sknobs(ext)
+        self.knobs[name] = sk
+        self.builds[name] = K._build_layer(self.stages, self.experts, self.rows, self.seq, self.group,
+                                           self.stamped, ext, sk)  # fmt: skip
+        self.info[name] = {"symbol": meta["symbol"], "lds_bytes": meta.get("lds_bytes"),
+                           "knobs": knobs.suffix() or "default", "spec": knob_spec(knobs),
+                           "tasks": self.SB.b3_tasks(knobs), "mailboxes": meta.get("mailboxes", "plain"),
+                           "externs": [[e.stage, e.mailboxes] for e in ext],
+                           "levers": SCH.from_knobs(sk).levers}  # fmt: skip
+        res = self.check(name)
+        self.info[name]["check"] = res
+        self.info[name]["build_s"] = time.time() - t0
+        return res
+
+    def run_once(self, launch):
+        r, s = self.r, self.s
+        for k, t in self.live.items():
+            t.copy_(self.snap[k])
+        cur = r.counter.clone()
+        r.counter.copy_(self.counter0)
+        torch.cuda.synchronize()
+        launch(r.counter.data_ptr(), 7, r.scratch.data_ptr(), *s.w.args[self.idx[0]],
+               stream=torch.cuda.current_stream())  # fmt: skip
+        torch.cuda.synchronize()
+        out = {k: t.clone() for k, t in self.live.items()}
+        # back to the live counter: later graph replays keep fresh tags (never one the scratch holds)
+        r.counter.copy_(torch.maximum(cur, self.counter0))
+        torch.cuda.synchronize()
+        return out
+
+    def logical(self, got):
+        """A numa-lever arm's outputs with the scratch's mailbox part read back from copy 0 of the NUMA area,
+        and whether copy 1 equals copy 0 over the whole mailbox part."""
+        t = got["scratch"]
+        mb = LY.mailbox_bytes(LY.MAX_ROWS) // 4
+        live = self.r.scratch.data_ptr()  # the area's alignment is the live scratch's
+        base_w = (NUMA.area_base(live) - live) // 4
+        w = torch.arange(mb, device=t.device)
+        ph = base_w + w + (w & ~2047)
+        c0, c1 = t[ph], t[ph + 2048]
+        full = t.clone()
+        full[:mb] = c0
+        return dict(got, scratch=full), bool(torch.equal(c0, c1))
+
+    def check(self, name, mutant=False):
+        got = self.run_once(self.builds[name])
+        numa = self.numa_arm(name)
+        same = True
+        if numa:
+            got, same = self.logical(got)
+        dd = {k: diff(self.ref[k], got[k], k) for k in self.live}
+        dd = {k: x for k, x in dd.items() if x}
+        if not same:
+            dd["numa_copies"] = {"copy1_differs": True}
+        if mutant:
+            return {"differs": bool(dd), "diff": dd, "numa": numa}
+        again = self.run_once(self.builds[name])
+        if numa:
+            again, _ = self.logical(again)
+        det = all(
+            diff(got[k], again[k], k) is None for k in self.live
+        )  # scratch: stamps / internal masked
+        nz = bool((got["h_out"] != 0).any())
+        return {"bitwise": not dd, "deterministic": det, "out_nonzero": nz, "numa": numa, "numa_copies_equal": same,
+                "diff": dd}  # fmt: skip
+
+    def mutant(self, base_knobs):
+        name = "_mutant"
+        k = replace(base_knobs, exp="hw")
+        self.add_arm(name, k)
+        res = self.check(name, mutant=True)
+        self.builds.pop(name)
+        self.graphs.pop(name, None)
+        return res
+
+    # ------------------------------------------------------------ timing
+    def graph(self, name):
+        if name in self.graphs:
+            return self.graphs[name]
+        r, launch = self.r, self.builds[self.alias.get(name, name)]
+
+        def run_all(stream):
+            for j, lst in enumerate(self.largs):
+                launch(
+                    r.counter.data_ptr(),
+                    j % SLOTS,
+                    r.scratch.data_ptr(),
+                    *lst,
+                    stream=stream,
+                )
+                if j % SLOTS == SLOTS - 1 and j != len(self.largs) - 1:
+                    r.counter.add_(1)
+            r.counter.add_(1)
+
+        gr = torch.cuda.CUDAGraph()
+        cs = torch.cuda.Stream()
+        cs.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(cs):
+            run_all(cs)
+        torch.cuda.synchronize()
+        with torch.cuda.graph(gr, stream=cs):
+            run_all(cs)
+        torch.cuda.synchronize()
+        for _ in range(3):
+            gr.replay()
+        torch.cuda.synchronize()
+        self.graphs[name] = gr
+        return gr
+
+    def time(self, names, reps=20, shuffle_seed=None):
+        """Interleaved replays; per arm the per-launch median (and all samples). ``shuffle_seed``: every round
+        in a seeded shuffled arm order (else rotated by one per round)."""
+        names = list(dict.fromkeys(names))
+        for n in names:
+            self.graph(n)
+        times = {n: [] for n in names}
+        for k in range(reps):
+            order = names[k % len(names) :] + names[: k % len(names)]
+            if shuffle_seed is not None:
+                order = list(names)
+                random.Random(shuffle_seed * 1000 + k).shuffle(order)
+            for n in order:
+                e0, e1 = torch.cuda.Event(enable_timing=True), torch.cuda.Event(
+                    enable_timing=True
+                )
+                e0.record()
+                self.graphs[n].replay()
+                e1.record()
+                torch.cuda.synchronize()
+                times[n].append(e0.elapsed_time(e1) * 1e3 / self.launches)
+        return {n: {"us_med": statistics.median(t), "cv": statistics.pstdev(t) / statistics.mean(t), "samples": t}
+                for n, t in times.items()}  # fmt: skip
+
+    def stamps(self, name):
+        from atom.models.qwen4_exp_mono.q38_hook import _stamp_region
+
+        if not self.stamped:
+            return None
+        self.graph(name).replay()
+        torch.cuda.synchronize()
+        region = _stamp_region(self.r.scratch, self.rows).cpu()
+        L = LY.for_rows(self.rows, self.seq)
+        dec = [
+            timeline.decode(region[kk], self.stages, L)
+            for kk in range(min(SLOTS, self.launches))
+        ]
+        return timeline.merge(dec)
+
+    def free(self):
+        self.graphs.clear()
+        self.builds.clear()
+        del self.rig
+        torch.cuda.empty_cache()
+
+
+class _Env:
+    """Set (value) or unset (None) one environment variable for a ``with`` block."""
+
+    def __init__(self, key, value):
+        self.key, self.value = key, value
+
+    def __enter__(self):
+        self.old = os.environ.get(self.key)
+        if self.value is None:
+            os.environ.pop(self.key, None)
+        else:
+            os.environ[self.key] = self.value
+
+    def __exit__(self, *exc):
+        if self.old is None:
+            os.environ.pop(self.key, None)
+        else:
+            os.environ[self.key] = self.old
+
+
+CONTROLS = ("mono2", "mono_numa2")
+
+
+def round_summary(tm, names, ref="mono"):
+    """Per arm: the per-round ratio to ``ref`` (round = replay index; every arm once per round): median, min,
+    max, rounds < 1. Against ``mono``: WIN = median below the plain control's (mono2) min and >= 3/4 of the
+    rounds < 1."""
+    out = {}
+    if ref not in tm:
+        return out
+    for n in names:
+        if n == ref or n not in tm:
+            continue
+        rs = [x / y for x, y in zip(tm[n]["samples"], tm[ref]["samples"], strict=True)]
+        out[n] = {"median": statistics.median(rs), "min": min(rs), "max": max(rs),
+                  "below1": sum(r < 1 for r in rs), "rounds": len(rs)}  # fmt: skip
+    if "mono2" in out and ref == "mono":
+        cmin = out["mono2"]["min"]
+        for n, s in out.items():
+            s["win"] = (
+                n not in CONTROLS
+                and s["median"] < cmin
+                and s["below1"] >= 0.75 * s["rounds"]
+            )
+    return out
+
+
+def stamp_ratios(tl, m):
+    sb, mb = tl["stages"]["b3"], m["stages"]["b3"]
+    sc_, mc = tl["stages"]["c1"], m["stages"]["c1"]
+    return {
+        "total": tl["total"] / m["total"], "b3_incr": sb["incr"] / mb["incr"], "b3_span": sb["span"] / mb["span"],
+        "b3_end": sb["end"] / mb["end"], "c1_end": sc_["end"] / mc["end"],
+        "b3_incr_share_of_mono_total": mb["incr"] / m["total"],
+        "b3_saving_share_of_mono_total": (mb["incr"] - sb["incr"]) / m["total"],
+    }  # fmt: skip
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--variants", default="r1,r4s")
+    ap.add_argument("--arms", default="rk")
+    ap.add_argument("--copies", type=int, default=16)
+    ap.add_argument("--experts", type=int, default=512)
+    ap.add_argument("--share-experts", action="store_true")
+    ap.add_argument("--context", type=int, default=8192)
+    ap.add_argument("--launches", type=int, default=96)
+    ap.add_argument("--reps", type=int, default=20)
+    ap.add_argument("--stamps", action="store_true")
+    ap.add_argument("--no-time", action="store_true")
+    ap.add_argument("--no-mutant", action="store_true")
+    ap.add_argument("--dump")
+    ap.add_argument("--real")
+    ap.add_argument(
+        "--fn-dir", default=os.path.join(os.environ.get("Q38_ROCKE_TMP", "."), "fns")
+    )
+    ap.add_argument(
+        "--sched",
+        default=None,
+        help="ATOM_Q38_SCHED of the rocKE arms and of arm mono_numa",
+    )
+    ap.add_argument(
+        "--controls",
+        action="store_true",
+        help="also time mono2 (and mono_numa, mono_numa2)",
+    )
+    ap.add_argument("--shuffle-seed", type=int, default=None)
+    ap.add_argument("--out")
+    a = ap.parse_args(argv)
+    results = {"variants": {}, "copies": a.copies, "experts": a.experts, "sched": a.sched,
+               "weights": f"dump:{a.real}" if a.real else "synthetic"}  # fmt: skip
+    ok_all = True
+    arm_specs = [x.strip() for x in a.arms.split(";") if x.strip()]
+    for v in a.variants.split(","):
+        t0 = time.time()
+        ins = Insitu(v, a.copies, a.experts, a.share_experts, a.context, a.dump, a.real, a.fn_dir,
+                     a.stamps, a.launches, a.sched)  # fmt: skip
+        rec = {"checks": {}, "numa_cal": ins.numa_cal}
+        if a.sched:
+            c = ins.info["mono_numa"]["check"]
+            rec["checks"]["mono_numa"] = c
+            ok_all &= (
+                c["bitwise"]
+                and c["deterministic"]
+                and c["numa_copies_equal"]
+                and c["numa"]
+            )
+        for spec in arm_specs:
+            knobs = parse_knobs(spec.split(":", 1)[1] if ":" in spec else "")
+            res = ins.add_arm(spec, knobs)
+            rec["checks"][spec] = res
+            ok_all &= (
+                res["bitwise"]
+                and res["deterministic"]
+                and res["numa_copies_equal"]
+                and res["out_nonzero"]
+            )
+            if (
+                a.sched
+            ):  # a numa=1 body keeps the lever, a plain one drops it (as kernel.build_layer)
+                res["numa_expected"] = knobs.numa == 1
+                ok_all &= res["numa"] == res["numa_expected"]
+            print("CHECK", v, spec, json.dumps(res), flush=True)
+        if not a.no_mutant and arm_specs:
+            m = ins.mutant(
+                parse_knobs(
+                    arm_specs[0].split(":", 1)[1] if ":" in arm_specs[0] else ""
+                )
+            )
+            rec["checks"]["_mutant"] = m
+            ok_all &= m["differs"]
+            print("CHECK", v, "_mutant", json.dumps(m), flush=True)
+        rec["info"] = ins.info
+        if not a.no_time:
+            ctl = (
+                (["mono2"] + (["mono_numa", "mono_numa2"] if a.sched else []))
+                if a.controls
+                else []
+            )
+            names = ["mono"] + ctl + arm_specs
+            tm = ins.time(names, a.reps, a.shuffle_seed)
+            rec["timing"] = tm
+            base = tm["mono"]["us_med"]
+            for n in names:
+                print("TIME", v, n, "launch_ratio_vs_mono", round(tm[n]["us_med"] / base, 4),
+                      "cv", round(tm[n]["cv"], 4), flush=True)  # fmt: skip
+            rec["rounds_vs_mono"] = round_summary(tm, names, "mono")
+            if a.sched and "mono_numa" in tm:
+                rec["rounds_vs_mono_numa"] = round_summary(tm, names, "mono_numa")
+            for ref in ("mono", "mono_numa"):
+                for n, s in rec.get(f"rounds_vs_{ref}", {}).items():
+                    print("ROUNDS", v, n, "vs", ref, json.dumps({k: (round(x, 4) if isinstance(x, float) else x)
+                                                                  for k, x in s.items()}), flush=True)  # fmt: skip
+            if ins.stamped:
+                rec["stamps"] = {n: ins.stamps(n) for n in names}
+                for n in names:
+                    rr = stamp_ratios(rec["stamps"][n], rec["stamps"]["mono"])
+                    print(
+                        "STAMPS",
+                        v,
+                        n,
+                        json.dumps({k: round(x, 4) for k, x in rr.items()}),
+                        flush=True,
+                    )
+        rec["wall_s"] = time.time() - t0
+        results["variants"][v] = rec
+        ins.free()
+    results["ok"] = ok_all
+    if a.out:
+        with open(a.out, "w") as f:
+            json.dump(results, f, indent=1)
+    print("INSITU", "PASS" if ok_all else "FAIL", flush=True)
+    return 0 if ok_all else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
