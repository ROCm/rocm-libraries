+++ b/tests/test_qwen4_exp_mono_rocke_head.py
@@ -0,0 +1,150 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2026, Advanced Micro Devices, Inc. All rights reserved.
+"""``ATOM_Q38_ROCKE_HEAD``: the mono's MXFP4 lm_head on rocKE builds.
+
+CPU: off by default (nothing built, both launches the mono's); on, the two
+launches route to the rocKE head and fall back to the mono's when a part is
+not swapped. GPU (with the rocKE library importable): the rocKE logits equal
+the mono head's bit for bit and the argmax (both folds, serpentine order)
+equals the mono's, rows 1..16, planted ties included."""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+from torch import nn
+
+pytest.importorskip("aiter")
+
+from atom.models.qwen4_exp_mono import head as fp4
+from atom.models.qwen4_exp_mono import rocke_head
+
+N, K = 256, 512
+
+
+def _weight(n=N, k=K, seed=0):
+    g = torch.Generator().manual_seed(seed)
+    codes = torch.randint(0, 16, (n, k), generator=g, dtype=torch.uint8)
+    codes[codes == 8] = 0
+    codes.view(n, k // 32, 32)[:, :, 0] = 7
+    scales = torch.randint(110, 135, (n, k // 32), generator=g, dtype=torch.uint8)
+    packed = codes[:, 0::2] | (codes[:, 1::2] << 4)
+    return fp4._unpack(packed, scales)
+
+
+class _Head(nn.Module):
+    def __init__(self, weight):
+        super().__init__()
+        self.weight = nn.Parameter(weight, requires_grad=False)
+        self.bias = None
+        self.tp_size = 1
+
+    def forward(self, x):
+        return ("bf16", x)
+
+    def compute_argmax_token(self, x, *, out):
+        return ("bf16-argmax", x)
+
+
+def _context(monkeypatch):
+    ctx = SimpleNamespace(is_prefill=False, is_draft=False)
+    monkeypatch.setattr(fp4, "get_forward_context", lambda: SimpleNamespace(context=ctx))
+
+
+def test_off_by_default(monkeypatch):
+    monkeypatch.delenv(rocke_head.ENV, raising=False)
+    assert not rocke_head.enabled()
+    assert rocke_head.build(torch.zeros(N, K // 2, dtype=torch.uint8), 16) is None
+    model = nn.Module()
+    model.lm_head = _Head(_weight())
+    assert fp4.install_fp4_head(model, None)
+    assert model.lm_head.rk is None
+
+
+class _Stub:
+    def __init__(self, logits=True, argmax=True):
+        self.calls = []
+        self.do_logits, self.do_argmax = logits, argmax
+
+    def logits(self, x, w, s):
+        self.calls.append("logits")
+        return torch.full((x.shape[0], N), 3.0) if self.do_logits else None
+
+    def argmax(self, x, w, s, keys, out):
+        self.calls.append("argmax")
+        return out.fill_(5) if self.do_argmax else None
+
+
+@pytest.mark.parametrize("parts", [(True, True), (False, False)])
+def test_routes(monkeypatch, parts):
+    stub = _Stub(*parts)
+    monkeypatch.setattr(rocke_head, "build", lambda packed, rows: stub)
+    model = nn.Module()
+    model.lm_head = _Head(_weight())
+    fp4.install_fp4_head(model, None)
+    head = model.lm_head
+    assert head.rk is stub
+    _context(monkeypatch)
+    monkeypatch.setattr(fp4, "mxfp4_head", lambda x, w, s: torch.full((x.shape[0], N), 9.0))
+    monkeypatch.setattr(fp4, "mxfp4_argmax", lambda x, w, s, k, out: out.fill_(8))
+    y = head(torch.zeros(4, K, dtype=torch.bfloat16))
+    out = torch.zeros(4, dtype=torch.int32)
+    got = head.compute_argmax_token(torch.zeros(4, K, dtype=torch.bfloat16), out=out)
+    assert stub.calls == ["logits", "argmax"]
+    assert float(y[0, 0]) == (3.0 if parts[0] else 9.0)
+    assert int(got[0]) == (5 if parts[1] else 8)
+    # more rows than the MXFP4 head takes: the bf16 module, never the stub
+    stub.calls.clear()
+    assert head(torch.zeros(fp4.MAX_HEAD_ROWS + 1, K, dtype=torch.bfloat16))[0] == "bf16"
+    assert stub.calls == []
+
+
+def test_spec_defaults(monkeypatch):
+    for k in ("", "_LOGITS", "_ARGMAX"):
+        monkeypatch.delenv(f"{rocke_head.ENV}_SPEC{k}", raising=False)
+    assert rocke_head._spec_env("logits") == {}
+    assert rocke_head._spec_env("argmax") == {"waves_per_eu": 1}
+    monkeypatch.setenv(f"{rocke_head.ENV}_SPEC", '{"ctas": 8}')
+    monkeypatch.setenv(f"{rocke_head.ENV}_SPEC_ARGMAX", '{"waves_per_eu": 0}')
+    assert rocke_head._spec_env("argmax") == {"waves_per_eu": 0, "ctas": 8}
+    assert rocke_head._spec_env("logits") == {"ctas": 8}
+
+
+def _rocke_available():
+    try:
+        import kernels.gfx950.mx_decode_gemv  # noqa: F401
+        import rocke  # noqa: F401
+    except Exception:
+        return False
+    return torch.cuda.is_available()
+
+
+@pytest.mark.skipif(not _rocke_available(), reason="needs a GPU and the rocKE library")
+@pytest.mark.parametrize("fold", ["fused", "keys"])
+def test_gpu_bitwise_with_the_mono(monkeypatch, fold):
+    monkeypatch.setenv(rocke_head.ENV, "1")
+    monkeypatch.setenv(f"{rocke_head.ENV}_FOLD", fold)
+    monkeypatch.setenv(f"{rocke_head.ENV}_SERPENTINE", "1")
+    # K = 512 is one load group: dg 1
+    monkeypatch.setenv(f"{rocke_head.ENV}_SPEC", '{"ctas": 8, "dg": 1}')
+    weight = _weight().cuda()
+    packed, scales = fp4.pack_exact(weight)
+    rk = rocke_head.build(packed, fp4.MAX_HEAD_ROWS)
+    keys = fp4.argmax_keys(packed)
+    for rows in (1, 2, 3, 4, 5, 8, 16):
+        g = torch.Generator().manual_seed(rows)
+        x = torch.randn(rows, K, generator=g).to(torch.bfloat16).cuda()
+        mono = fp4.mxfp4_head(x, packed, scales)
+        got = rk.logits(x, packed, scales)
+        assert torch.equal(got.view(torch.int16), mono.view(torch.int16)), rows
+        # a tie: the first row's winner copied to a lower column
+        j = int(mono[0].float().argmax())
+        p2, s2 = packed.clone(), scales.clone()
+        if j > 0:
+            p2[j // 2], s2[j // 2] = p2[j], s2[j]
+        want = torch.empty(rows, dtype=torch.int32, device="cuda")
+        fp4.mxfp4_argmax(x, p2, s2, keys, want)
+        for _ in range(3):  # serpentine flips the order every call
+            out = torch.full((rows,), -1, dtype=torch.int32, device="cuda")
+            assert rk.argmax(x, p2, s2, keys, out) is out
+            assert torch.equal(out, want), rows
