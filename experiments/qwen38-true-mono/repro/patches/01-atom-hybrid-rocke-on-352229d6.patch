index 0000000000000000000000000000000000000000..0d8156c3da43e92c4e0af867795fec5b4250a44d
--- /dev/null
+++ b/scripts/qwen38_rocke/harness/midchain_probe.py
@@ -0,0 +1,148 @@
+"""Is a FlyDSL mono build that starts mid-chain correct when the host fills its upstream mailboxes?
+(ROADMAP T1: decides the T11 A/B method.)
+
+One cut per process (a hang on a missing mailbox cannot be recovered in-process):
+
+    python midchain_probe.py --kind delta --cut m3 --out r.json
+
+1. the full layer build runs once (tag T); the scratch is snapshotted, ``h_out`` kept;
+2. the scratch is zeroed and only the mailbox regions of the stages before the cut are restored
+   (tag T: as if the host had filled them), ``h_out`` zeroed;
+3. a build of the stages from the cut on (``build_layer``'s start rule patched out in a module copy,
+   FlyDSL cache off) runs with the same tag;
+4. pass = ``h_out`` bitwise equal to the full build's. Exit 3 on a hang (60 s).
+"""
+
+from __future__ import annotations
+
+import argparse
+import inspect
+import json
+import os
+import sys
+import time
+import types
+
+os.environ.setdefault("FLYDSL_RUNTIME_ENABLE_CACHE", "0")
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.join(HERE, "..", "harness"))
+
+import torch
+from rig import MonoRig
+
+from atom.models.qwen4_exp_mono.kernels import kernel as K
+from atom.models.qwen4_exp_mono.kernels import layout as LY
+
+PRODUCES = {
+    "p1": ("pk", "pv"), "p2": ("ph", "phs"),
+    "a1": ("lr8", "lre", "inj", "inv"), "a2": ("x8", "xe", "xbf"),
+    "b1": ("qkvz",), "b3": ("core", "d8", "de"),
+    "q1": ("qp",), "q2": ("qn",), "q3": ("isc",), "q4": ("sel", "selh"),
+    "q5": ("ss", "ssh"), "q6": ("pp", "pph"), "q7": ("d8", "de"),
+    "c1": ("w", "whs"),
+    "m1": ("mlr8", "mlre", "minj", "minv"), "m2": ("mx8", "mxe", "mxbf"),
+    "m3": ("lg", "sg"), "m4": ("dn",), "m5": (),
+}  # fmt: skip
+KINDS = ["delta", "delta_ple", "delta", "qsa"]
+LAYER = {"delta": 0, "delta_ple": 1, "qsa": 3}
+
+
+def patched_kernel_module():
+    src = inspect.getsource(K)
+    rule = 'assert first in starts or (kind == "qsa" and first > 2), stages'
+    assert src.count(rule) == 1
+    src = src.replace(rule, "pass  # q38 midchain probe: any start")
+    mod = types.ModuleType(K.__name__ + "_midchain")
+    mod.__file__ = K.__file__
+    sys.modules[mod.__name__] = mod
+    # dont_inherit: this file's `from __future__ import annotations` would turn the kernel
+    # signature's annotations into strings
+    code = compile(src, K.__file__, "exec", dont_inherit=True)
+    exec(code, mod.__dict__)  # noqa: S102
+    return mod
+
+
+def region_words(name, rows):
+    """int32 word ranges of region ``name`` for every request row."""
+    out = []
+    for r in range(rows):
+        base = (LY.SC[name] + r * LY.SCRATCH_BYTES) // 4
+        out.append((base, base + 2 * LY.REGIONS[name]))
+    return out
+
+
+def wait(timeout=60.0):
+    ev = torch.cuda.Event()
+    ev.record()
+    t0 = time.time()
+    while not ev.query():
+        if time.time() - t0 > timeout:
+            print(json.dumps({"result": "HANG"}), flush=True)
+            os._exit(3)
+        time.sleep(0.01)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--kind", default="delta", choices=("delta", "delta_ple", "qsa"))
+    ap.add_argument("--cut", required=True)
+    ap.add_argument("--rows", type=int, default=1)
+    ap.add_argument("--out")
+    a = ap.parse_args()
+    os.environ["ATOM_Q38_STAMPS"] = "0"
+    stages = K.STAGES[a.kind]
+    cut = stages.index(a.cut)
+    rig = MonoRig(KINDS, experts=16, context=640, seed=5, share_experts=False)
+    s = rig.step(a.rows)
+    g = torch.Generator(device="cuda")
+    g.manual_seed(9)
+    s.w.h0.copy_(torch.randn(s.w.h0.shape, generator=g, device="cuda").bfloat16())
+    s.w.chain.copy_(torch.randn(s.w.chain.shape, generator=g, device="cuda").bfloat16())
+    rig.meta(s)
+    i = LAYER[a.kind]
+    full = K.build_layer(stages, 16, rows=a.rows)
+    r = rig.runner
+    full(
+        r.counter.data_ptr(),
+        7,
+        r.scratch.data_ptr(),
+        *s.w.args[i],
+        stream=torch.cuda.current_stream(),
+    )
+    wait()
+    ref = rig.h_out(s, i).clone()
+    snap = r.scratch.clone()
+    r.scratch.zero_()
+    restored = []
+    for st in stages[:cut]:
+        for name in PRODUCES[st]:
+            for lo, hi in region_words(name, a.rows):
+                r.scratch[lo:hi] = snap[lo:hi]
+            restored.append(name)
+    rig.h_out(s, i).zero_()
+    mid = patched_kernel_module()._build_layer(
+        stages[cut:], 16, a.rows, False, 0, False
+    )
+    mid(
+        r.counter.data_ptr(),
+        7,
+        r.scratch.data_ptr(),
+        *s.w.args[i],
+        stream=torch.cuda.current_stream(),
+    )
+    wait()
+    got = rig.h_out(s, i)
+    res = {
+        "kind": a.kind, "cut": a.cut, "rows": a.rows, "restored": restored,
+        "bitwise": bool(torch.equal(got, ref)), "max_abs_diff": float((got.float() - ref.float()).abs().max()),
+        "nonzero": bool((got != 0).any()),
+    }  # fmt: skip
+    print(json.dumps(res), flush=True)
+    if a.out:
+        with open(a.out, "w") as f:
+            json.dump(res, f)
+    return 0 if res["bitwise"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
