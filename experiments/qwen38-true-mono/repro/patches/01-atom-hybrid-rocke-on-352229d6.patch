@@ -0,0 +1,763 @@
+"""MoE track A/B harness: the mono MoE stages (FlyDSL) vs the rocKE MoE suffix.
+
+Split launches over the same rig (``harness/rig.py``) and weights:
+
+    pre     FlyDSL prefix a1..m2 (``--stages m3,m4,m5``) or a1..m3 (``--stages m4,m5``)
+    fly     prefix + the FlyDSL suffix (a mid-chain build, ``midchain_probe``)
+    rk:K    prefix + the rocKE suffix (``kernels.gfx950.qwen38_mono.moe``, knobs K as JSON)
+    full    the whole FlyDSL layer (the reference when routing comes from M3)
+    hyb:K   the whole FlyDSL layer with ``--hyb-stages`` (default m3,m4,m5) replaced by the rocKE
+            stage functions (``stage_moe``, knobs K) through ``ATOM_Q38_EXTERN_STAGES``: in situ
+
+Routing: ``random`` (random HC rows through M3: U ~ 38-39 at rows 4; ``--row-corr s`` makes the
+rows of an input ``(base + s * noise) / sqrt(1 + s^2)``, which routes them closer together, U
+falling as s falls) or ``real`` (``--stages m4,m5``, split arms only: the lg mailbox is overwritten
+after the prefix with router logits captured in the served k=3 run, ``real_lg.pt``: U ~ 28.5 at
+rows 4; that capture is not shipped with the reproduction kit, so only ``random`` routing runs here).
+
+    python moe_ab.py check --rows 4 --arms 'rk:{};rk:{"dedupe":true}' --out c.json
+    python moe_ab.py bench --rows 4 --copies 16 --arms 'fly;rk:{};rk:{"dedupe":true}' --out b.json
+
+check: bitwise h_out and the lg / sg / dn payloads (rocKE vs full, or vs fly with real routing). Every arm of
+a case starts from one snapshot of the scratch and of every state pool, under one tag (verify builds update
+their spec slots in place). ``--dump P`` saves each arm's outputs to ``P_case<j>.pt``.
+bench: one HIP graph per arm of ``--launches`` launch pairs over ``--copies`` weight copies (cold),
+replays interleaved over the arms; suffix time = arm - pre. ``--stamps`` (with
+ATOM_Q38_STAMPS=1 and knob stamps on the rocKE arms) adds per-stage timelines of the last replay.
+Absolute times go to ``--out`` only; stdout carries ratios.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import statistics
+import sys
+import time
+
+os.environ.setdefault("FLYDSL_RUNTIME_ENABLE_CACHE", "0")
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.join(HERE, "..", "harness"))
+
+import timeline
+import torch
+from kernels.gfx950.qwen38_mono import abi as A
+from kernels.gfx950.qwen38_mono import moe as MO
+from kernels.gfx950.qwen38_mono import stage_moe as SM
+from kernels.gfx950.qwen38_mono.device_function import (
+    DeviceFunctionKnobs,
+    lower_device_function,
+    write_device_function,
+)
+from kernels.gfx950.qwen38_mono.stage_fn import variant_name
+from midchain_probe import patched_kernel_module
+from rig import MonoRig
+from rocke.helpers.compile import compile_kernel
+from rocke.runtime.launcher import KernelLauncher, LaunchConfig, no_fence
+
+from atom.models.qwen4_exp_mono.kernels import kernel as K
+from atom.models.qwen4_exp_mono.kernels import layout as LY
+from atom.models.qwen4_exp_mono.kernels import stamps as STAMPS
+
+BASE_KINDS = ["delta", "delta_ple", "delta", "qsa"]
+SLOTS = 48
+H_IN = K.LAYER_ARGS[1:].index("h_in")
+H_OUT = K.LAYER_ARGS[1:].index("h_out")
+
+
+def words_of(scratch):
+    return scratch.view(torch.int32)
+
+
+def payload(scratch, region, rows):
+    """[rows, pairs] payload words of a mailbox region."""
+    w = words_of(scratch)
+    out = []
+    for r in range(rows):
+        base = (LY.SC[region] + r * LY.SCRATCH_BYTES) // 4
+        out.append(w[base : base + 2 * LY.REGIONS[region] : 2].clone())
+    return torch.stack(out)
+
+
+def lg_unique(scratch, rows, experts):
+    lg = payload(scratch, "lg", rows)
+    picked = set()
+    for r in range(rows):
+        logits = lg[r].contiguous().view(torch.bfloat16).float()[:experts]
+        picked |= set(torch.topk(logits, 10).indices.tolist())
+    return len(picked)
+
+
+# ------------------------------------------------------------------ launchers
+
+
+def rocke_launcher(spec):
+    t0 = time.time()
+    kern = MO.build_moe_suffix(spec)
+    art = compile_kernel(kern, arch="gfx950", backend="python")
+    lau = KernelLauncher(
+        hsaco=art.hsaco, kernel_name=art.kernel_name, signature=MO.signature()
+    )
+    names = ("scratch",) + K.LAYER_ARGS[1:]
+    assert tuple(names) == A.LAYER_ARGS
+
+    def launch(step, layer, scratch, *args, stream):
+        vals = {"step": step, "layer": layer, "scratch": scratch}
+        vals.update(zip(A.LAYER_ARGS[1:], args))
+        with no_fence():
+            lau(
+                vals,
+                config=LaunchConfig(
+                    grid=(A.GRID, 1, 1),
+                    block=(A.THREADS, 1, 1),
+                    stream=stream.cuda_stream,
+                ),
+            )
+
+    launch.compile_s = time.time() - t0
+    launch.name = art.kernel_name
+    return launch
+
+
+class Cell:
+    def __init__(self, a):
+        self.a = a
+        dev = torch.device("cuda")
+        kinds = BASE_KINDS + [a.kind] * a.copies
+        self.idx = list(range(len(BASE_KINDS), len(kinds)))
+        spec = a.rows - 1 if a.seq else 0
+        self.rig = MonoRig(
+            kinds, experts=a.experts, context=a.context, spec_tokens=spec, seed=a.seed,
+            share_experts=a.share_experts,
+        )  # fmt: skip
+        self.s = self.rig.step(a.rows)
+        self.r = self.rig.runner
+        gen = torch.Generator(device=dev)
+        gen.manual_seed(1234 + a.seed)
+        width = self.rig.geometry.hc_width
+        self.ins = []
+        for _ in range(a.inputs):
+            x = torch.randn(a.rows, width, generator=gen, device=dev)
+            if a.row_corr > 0:
+                base = torch.randn(1, width, generator=gen, device=dev)
+                x = (base + a.row_corr * x) / (1 + a.row_corr**2) ** 0.5
+            self.ins.append(x.to(torch.bfloat16))
+        self.outs = [
+            torch.zeros(a.rows, width, dtype=torch.bfloat16, device=dev)
+            for _ in self.idx
+        ]
+        self.stages = tuple(a.stages.split(","))
+        assert self.stages in (("m3", "m4", "m5"), ("m4", "m5")), self.stages
+        order = K.STAGES[a.kind]
+        cut = order.index(self.stages[0])
+        self.prefix = tuple(order[:cut])
+        self.launch = {
+            "full": self.s.w.launch[a.kind],
+            "pre": K.build_layer(self.prefix, a.experts, rows=a.rows, seq=a.seq),
+            "fly": patched_kernel_module().build_layer(
+                self.stages, a.experts, rows=a.rows, seq=a.seq
+            ),
+        }
+        self.real = None
+        if a.routing == "real":
+            assert (
+                self.stages == ("m4", "m5") and a.experts == 512
+            ), "real routing: --stages m4,m5, 512 experts"
+            src = torch.load(
+                os.path.join(HERE, "real_lg.pt")
+            )  # [N, 4, 256] int32 payload words
+            self.real = src[:, : a.rows].contiguous().to(dev)
+        self.rig.meta(self.s)
+        torch.cuda.synchronize()
+
+    def args(self, j):
+        a = self.a
+        c = j % a.copies
+        lst = list(self.s.w.args[self.idx[c]])
+        lst[H_IN] = self.ins[j % a.inputs].data_ptr()
+        lst[H_OUT] = self.outs[c].data_ptr()
+        return c, lst
+
+    def inject(self, j, slot):
+        """Overwrite the lg payloads with captured logits (window j) under this launch's tag."""
+        rows = self.a.rows
+        w = words_of(self.r.scratch)
+        base = LY.SC["lg"] // 4
+        stride = LY.SCRATCH_BYTES // 4
+        pay = w.as_strided((rows, 256), (stride, 2), w.storage_offset() + base)
+        tags = w.as_strided((rows, 256), (stride, 2), w.storage_offset() + base + 1)
+        pay.copy_(self.real[j % self.real.shape[0]])
+        tag = (self.r.counter[:1] * A.LAYER_SLOTS + (slot + 1)).to(torch.int32)
+        tags.copy_(tag.view(1, 1).expand(rows, 256))
+
+    def pair(self, arm, j, slot, stream):
+        """One launch of ``arm`` (``full``, ``pre`` or a suffix arm after the prefix)."""
+        r = self.r
+        _c, lst = self.args(j)
+        cp, sp = r.counter.data_ptr(), r.scratch.data_ptr()
+        if arm == "full" or arm.startswith(("hyb:", "srv:")):
+            self.launch[arm](cp, slot, sp, *lst, stream=stream)
+            return
+        self.launch["pre"](cp, slot, sp, *lst, stream=stream)
+        if self.real is not None:
+            self.inject(j, slot)
+        if arm != "pre":
+            self.launch[arm](cp, slot, sp, *lst, stream=stream)
+
+
+def parse_arms(text):
+    arms = []
+    for item in text.split(";"):
+        item = item.strip()
+        if not item:
+            continue
+        if item.startswith("srv:"):
+            # the serving handoff: ATOM_Q38_EXTERN_STAGES=<stage>=DIR/<stage>_{kind}_{variant}.ll with
+            # ATOM_Q38_EXTERN_MISSING=mono, DIR from ``stage_moe --knobs best`` (srv:DIR)
+            arms.append((item, {"_srv": item[4:]}))
+        elif item.startswith(("rk:", "hyb:")):
+            kind, _, text = item.partition(":")
+            knobs = json.loads(text or "{}")
+            arms.append((kind + ":" + json.dumps(knobs, sort_keys=True), knobs))
+        else:
+            arms.append((item, None))
+    return arms
+
+
+def hybrid_launcher(cell, knobs, stages):
+    """The FlyDSL layer with ``stages`` replaced by rocKE stage functions (in situ)."""
+    from atom.models.qwen4_exp_mono.kernels import extern_stages as XS
+
+    a = cell.a
+    t0 = time.time()
+    knobs = dict(knobs)
+    # "_inline": the device functions' inline knob (default "always", as the stage_moe generator; "default"
+    # = LLVM's inliner decides: it left M5 a real call in the QSA r4s layer)
+    inline = knobs.pop("_inline", "always")
+    if "mailbox" in knobs:
+        knobs["mailbox"] = MO.M.MailboxKnobs(**knobs["mailbox"])
+    kn = MO.MoeKnobs(**knobs)
+    var = variant_name(a.rows, a.seq)
+    out_dir = os.path.join(
+        os.environ.get("Q38_ROCKE_TMP", HERE),
+        "hyb",
+        a.kind,
+        (kn.suffix() or "default") + f"_inl{inline}",
+        "_".join(stages),
+    )
+    os.makedirs(out_dir, exist_ok=True)
+    for st in stages:
+        kern, _plan = SM.build_function(
+            st, a.rows, a.seq, kn, experts=a.experts, m5_reuse=("m4" in stages)
+        )
+        fn = lower_device_function(
+            kern,
+            arch="gfx950",
+            symbol=f"rocke_q38_{st}_{var}",
+            knobs=DeviceFunctionKnobs(lds="arg", inline=inline),
+        )
+        write_device_function(fn, out_dir, stem=f"{st}_{var}", bitcode=False)
+    spec = ",".join(f"{st}={out_dir}/{st}_{{variant}}.ll" for st in stages)
+    old = os.environ.get(XS.ENV)
+    os.environ[XS.ENV] = spec
+    try:
+        launch = K.build_layer(K.STAGES[a.kind], a.experts, rows=a.rows, seq=a.seq)
+        # compile now (the extern files are read at compile time)
+        _c, lst = cell.args(0)
+        launch(
+            cell.r.counter.data_ptr(),
+            0,
+            cell.r.scratch.data_ptr(),
+            *lst,
+            stream=torch.cuda.current_stream(),
+        )
+        torch.cuda.synchronize()
+        cell.r.counter.add_(1)
+    finally:
+        if old is None:
+            os.environ.pop(XS.ENV, None)
+        else:
+            os.environ[XS.ENV] = old
+    launch.compile_s = time.time() - t0
+    launch.name = f"hyb_{'_'.join(stages)}_{kn.suffix() or 'default'}_inl{inline}"
+    return launch
+
+
+def serving_launcher(cell, fdir):
+    """The layer as served with the handoff's settings (module docstring of ``stage_moe``): the files of
+    ``stage_moe --knobs best --out fdir`` per kind, missing cells on the FlyDSL stages.
+    """
+    from atom.models.qwen4_exp_mono.kernels import extern_stages as XS
+
+    a = cell.a
+    spec = ",".join(
+        f"{st}={fdir}/{st}_{{kind}}_{{variant}}.ll" for st in ("m3", "m4", "m5")
+    )
+    old = {k: os.environ.get(k) for k in (XS.ENV, XS.MISSING_ENV)}
+    os.environ[XS.ENV] = spec
+    os.environ[XS.MISSING_ENV] = "mono"
+    try:
+        stages = K.STAGES[a.kind]
+        ext = XS.resolve(tuple(stages), a.rows, a.seq, 0, K.LAYER_ARGS, K._ALL_STAGES)
+        launch = K.build_layer(stages, a.experts, rows=a.rows, seq=a.seq)
+        _c, lst = cell.args(0)
+        launch(
+            cell.r.counter.data_ptr(),
+            0,
+            cell.r.scratch.data_ptr(),
+            *lst,
+            stream=torch.cuda.current_stream(),
+        )
+        torch.cuda.synchronize()
+        cell.r.counter.add_(1)
+    finally:
+        for k, v in old.items():
+            if v is None:
+                os.environ.pop(k, None)
+            else:
+                os.environ[k] = v
+    launch.name = "srv_" + "_".join(e.stage for e in ext)
+    launch.externs = [e.stage for e in ext]
+    return launch
+
+
+def add_rocke_arms(cell, arms):
+    a = cell.a
+    info = {}
+    for name, knobs in arms:
+        if knobs is None or name in cell.launch:
+            continue
+        if name.startswith("srv:"):
+            cell.launch[name] = serving_launcher(cell, knobs["_srv"])
+            info[name] = {
+                "kernel": cell.launch[name].name,
+                "externs": cell.launch[name].externs,
+            }
+            print(
+                f"[moe_ab] built {cell.launch[name].name} externs {cell.launch[name].externs}",
+                flush=True,
+            )
+            continue
+        if name.startswith("hyb:"):
+            # "_stages": this arm's swapped stages (default --hyb-stages), e.g. "m3"
+            st = knobs.pop("_stages", None) or a.hyb_stages
+            cell.launch[name] = hybrid_launcher(cell, knobs, tuple(st.split(",")))
+            info[name] = {
+                "kernel": cell.launch[name].name,
+                "compile_s": round(cell.launch[name].compile_s, 1),
+            }
+            print(
+                f"[moe_ab] built {cell.launch[name].name} ({cell.launch[name].compile_s:.1f} s)",
+                flush=True,
+            )
+            continue
+        if a.stamps:
+            knobs["stamps"] = True
+        mb = knobs.pop("mailbox", None)
+        if mb is not None:
+            knobs["mailbox"] = MO.M.MailboxKnobs(**mb)
+        kn = MO.MoeKnobs(**knobs)
+        spec = MO.MoeSuffixSpec(
+            rows=a.rows, experts=a.experts, stages=cell.stages, knobs=kn
+        )
+        cell.launch[name] = rocke_launcher(spec)
+        info[name] = {
+            "kernel": cell.launch[name].name,
+            "compile_s": round(cell.launch[name].compile_s, 1),
+        }
+        print(
+            f"[moe_ab] built {cell.launch[name].name} ({cell.launch[name].compile_s:.1f} s)",
+            flush=True,
+        )
+    return info
+
