index 0000000000000000000000000000000000000000..ec81d39a26d7b710863c4e979ff61ca6ecf177a9
--- /dev/null
+++ b/scripts/qwen38_rocke/harness/rig.py
@@ -0,0 +1,542 @@
+"""A Qwen3.8-Flash-Next mono layer rig without a served model (T1 harness).
+
+``MonoRig`` builds what ``Qwen4MonoDecodeRunner`` binds from a loaded model -- the layers'
+kernel arguments (``weights.bind_parameters``), ATOM-shaped state pools (``state.bind_state``),
+the RoPE tables, scratch, step counter, null state -- from
+
+- synthetic weights (``synth_params``: random MXFP4 codes and E8M0 scales in ATOM's checkpoint
+  layouts, bf16 norms, HC low-rank weights that are exact MXFP4 values), or
+- real weights dumped by the ATOM hook (``ATOM_Q38_DUMP``: ``layer_<i>.pt``, ``rope.pt``),
+
+then drives the runner's own ``prepare`` / ``_tables`` (the runner class with only the attributes
+those read), ``write_step_meta`` / ``write_verify_meta`` and the layer launchers, exactly as a
+served step does. Every layer index has its own weights unless ``share_experts`` aliases the
+routed-expert banks (they dominate memory; a launch touches 11 of 513 experts).
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import os
+from types import SimpleNamespace
+
+import torch
+
+from atom.model_ops.attentions.gdn_attn import LINEAR_STATE_ROWS
+from atom.model_ops.attentions.qwen4_exp_attn import QSA_ROWS
+from atom.models.qwen4_exp_mono import weights as W
+from atom.models.qwen4_exp_mono.group_meta import write_group_verify_meta
+from atom.models.qwen4_exp_mono.group_runner import Qwen4MonoGroupRunner
+from atom.models.qwen4_exp_mono.kernels import layout as LY
+from atom.models.qwen4_exp_mono.kernels.config import DEFAULT
+from atom.models.qwen4_exp_mono.kernels.kernel import LAYER_ARGS, STAGES, build_layer
+from atom.models.qwen4_exp_mono.kernels.p2 import dequantize_mxfp4
+from atom.models.qwen4_exp_mono.runner import Qwen4MonoDecodeRunner
+from atom.models.qwen4_exp_mono.state import QSA_CACHES as CACHE_PAGES
+from atom.models.qwen4_exp_mono.state import bind_state
+from atom.models.qwen4_exp_mono.step_meta import (
+    PLE_CONV_IN,
+    QSA_CACHES,
+    write_step_meta,
+    write_verify_meta,
+)
+
+BF16, F32, U8 = torch.bfloat16, torch.float32, torch.uint8
+FP4X2, E8M0 = torch.float4_e2m1fn_x2, torch.float8_e8m0fnu
+C = DEFAULT
+PAGE = 16
+
+
+# ------------------------------------------------------------------ synthetic weights
+
+
+def _codes(gen, shape, dev):
+    return torch.randint(0, 256, shape, dtype=U8, device=dev, generator=gen)
+
+
+def _scales(gen, shape, dev, lo=118, hi=123):
+    return torch.randint(lo, hi + 1, shape, dtype=U8, device=dev, generator=gen)
+
+
+def _mxfp4_linear(prm, name, N, K, gen, dev, lo=118, hi=123):
+    prm[name + ".weight"] = _codes(gen, (N, K // 2), dev).view(FP4X2)
+    prm[name + ".weight_scale"] = _scales(gen, (N, K // 32), dev, lo, hi).view(E8M0)
+
+
+def _bf16(gen, shape, dev, std=1.0):
+    return (torch.randn(shape, generator=gen, device=dev) * std).to(BF16)
+
+
+def _exact_mxfp4_bf16(gen, N, K, dev, lo=118, hi=122):
+    """bf16 ``[N, K]`` whose every 32-block is an MXFP4 block's exact values."""
+    q, s = _codes(gen, (N, K // 2), dev), _scales(gen, (N, K // 32), dev, lo, hi)
+    return dequantize_mxfp4(q, s).to(BF16)
+
+
+def logical_expert_bank(experts, gen, dev):
+    """Routed + shared experts as logical row-major MXFP4 (``gate_up [2 I, H/2]``, gate rows then
+    up rows; ``down [H, I/2]``; ``[., K/32]`` E8M0 scales), and the same experts placed and
+    shuffled into ATOM's fused-slot layout (``weights.expert_slot``, aiter's gate/up interleave):
+    ``(bank, logical)`` with ``bank = (w13, w2, s13, s2)`` as ``synth_params`` binds them.
+    """
+    H, I, P = C.hidden, C.moe_inter, W.MOE_INTER_PADDED
+    E = experts + 1
+    logical = {"gu": [], "gu_s": [], "dn": [], "dn_s": []}
+    w13 = torch.empty(E, 2 * P, H // 2, dtype=U8, device=dev)
+    w2 = torch.empty(E, H, P // 2, dtype=U8, device=dev)
+    s13 = torch.empty(E, 2 * P * H // 32, dtype=U8, device=dev)
+    s2 = torch.empty(E, H * P // 32, dtype=U8, device=dev)
+    for e in range(E):
+        gu, gu_s = _codes(gen, (2 * I, H // 2), dev), _scales(
+            gen, (2 * I, H // 32), dev
+        )
+        dn, dn_s = _codes(gen, (H, I // 2), dev), _scales(gen, (H, I // 32), dev)
+        slot = W.expert_slot(gu, gu_s, dn, dn_s)
+        w13[e], s13[e], w2[e], s2[e] = (
+            slot[0].view(U8),
+            slot[1].view(U8),
+            slot[2].view(U8),
+            slot[3].view(U8),
+        )
+        for k, v in (("gu", gu), ("gu_s", gu_s), ("dn", dn), ("dn_s", dn_s)):
+            logical[k].append(v)
+    bank = (
+        w13.view(FP4X2),
+        w2.view(FP4X2),
+        s13.view(E * 2 * P, H // 32),
+        s2.view(E * H, P // 32),
+    )
+    return bank, logical
+
+
+def synth_params(kind, experts, dev, seed=0, expert_bank=None, logical_experts=False):
+    """Synthetic parameters of one decoder layer of ``kind``, by the dotted names
+    ``weights.bind_parameters`` reads. ``expert_bank``: reuse these routed-expert tensors.
+    ``logical_experts``: build the experts from logical weights (``logical_expert_bank``; slower)
+    and keep those under ``prm["_logical_experts"]`` for references."""
+    gen = torch.Generator(device=dev)
+    gen.manual_seed(seed)
+    H, width, rank = C.hidden, C.hc_width, C.hc_lowrank
+    prm = {}
+    for hc in ("attn_hyper_connection.", "mlp_hyper_connection."):
+        prm[hc + "hc_norm.weight"] = _bf16(gen, (width,), dev, 0.1)
+        prm[hc + "input_mix_weight_down.weight"] = _exact_mxfp4_bf16(
+            gen, rank, width, dev
+        )
+        prm[hc + "input_mix_weight_up.weight"] = _exact_mxfp4_bf16(
+            gen, width, rank, dev
+        )
+        prm[hc + "block_inject_weight.weight"] = _bf16(
+            gen, (C.hc_count, width), dev, 0.02
+        )
+    inter = W.MOE_INTER_PADDED
+    E = experts + 1  # the shared expert is the last fused slot
+    m = "mlp."
+    if expert_bank is None and logical_experts:
+        expert_bank, prm["_logical_experts"] = logical_expert_bank(experts, gen, dev)
+    if expert_bank is None:
+        w13 = _codes(gen, (E, 2 * inter, H // 2), dev).view(FP4X2)
+        w2 = _codes(gen, (E, H, inter // 2), dev).view(FP4X2)
+        s13 = _scales(gen, (E * 2 * inter, H // 32), dev)
+        s2 = _scales(gen, (E * H, inter // 32), dev)
+        # the padded intermediate columns are zero codes, as aiter's loader leaves them
+        w13.view(U8).view(E, 2, inter, H // 2)[:, :, C.moe_inter :] = 0
+        w2.view(U8)[:, :, C.moe_inter // 2 :] = 0
+    else:
+        w13, w2, s13, s2 = expert_bank
+    w13.is_shuffled = True
+    w2.is_shuffled = True
+    prm[m + "experts.w13_weight"] = w13
+    prm[m + "experts.w2_weight"] = w2
+    prm[m + "experts.w13_weight_scale"] = s13
+    prm[m + "experts.w2_weight_scale"] = s2
+    prm[m + "gate.weight"] = _bf16(gen, (experts + 1, H), dev, 0.02)
+    if kind == "qsa":
+        a = "self_attn."
+        d, q = C.head_dim, C.q_heads * C.head_dim
+        _mxfp4_linear(prm, a + "qkv_proj", 2 * q + 2 * C.kv_heads * d, H, gen, dev)
+        index = C.index_heads * C.index_dim + C.index_dim
+        _mxfp4_linear(prm, a + "indexer.index_qk_proj", index, H, gen, dev)
+        _mxfp4_linear(prm, a + "o_proj", H, q, gen, dev)
+        prm[a + "q_norm.weight"] = _bf16(gen, (d,), dev, 0.1)
+        prm[a + "k_norm.weight"] = _bf16(gen, (d,), dev, 0.1)
+        prm[a + "indexer.q_layernorm.weight"] = _bf16(gen, (C.index_dim,), dev, 0.1)
+        prm[a + "indexer.k_layernorm.weight"] = _bf16(gen, (C.index_dim,), dev, 0.1)
+    else:
+        a = "linear_attn."
+        qkv, value, heads = C.delta_qkv, C.delta_value, C.delta_v_heads
+        _mxfp4_linear(prm, a + "in_proj_qkvz", qkv + value, H, gen, dev)
+        prm[a + "conv1d.weight"] = _bf16(gen, (qkv, 1, C.delta_conv), dev, 0.3)
+        prm[a + "in_proj_ba.weight"] = _bf16(gen, (2 * heads, H), dev, 0.02)
+        prm[a + "A_log"] = torch.log(
+            torch.rand(heads, generator=gen, device=dev) * 15 + 1
+        )
+        prm[a + "dt_bias"] = torch.rand(heads, generator=gen, device=dev) - 0.5
+        prm[a + "norm.weight"] = _bf16(gen, (C.delta_v_dim,), dev, 0.1)
+        _mxfp4_linear(prm, a + "out_proj", H, value, gen, dev)
+    if kind == "delta_ple":
+        p = "ple."
+        _mxfp4_linear(prm, p + "key_proj", width, H, gen, dev)
+        _mxfp4_linear(prm, p + "value_proj", H, H, gen, dev)
+        for n in ("norm_query", "norm_key", "norm_conv"):
+            prm[p + n + ".weight"] = _bf16(gen, (width,), dev, 0.1)
+        prm[p + "conv1d.weight"] = _bf16(gen, (width, 1, C.ple_conv), dev, 0.3)
+    return prm
+
+
+def synth_rope(positions, dev):
+    """RoPE tables as ``weights.rope`` returns them (``[positions, rotary_dim]`` bf16)."""
+    half = C.rotary_dim // 2
+    inv = 1.0 / (C.rope_theta ** (torch.arange(half, device=dev, dtype=F32) / half))
+    ang = torch.arange(positions, device=dev, dtype=F32)[:, None] * inv[None]
+    out = []
+    for t in (ang.cos(), ang.sin()):
+        t = t.to(BF16)
+        out.append(torch.cat([t, t], -1).contiguous())
+    return tuple(out)
+
+
+def load_dump(path, dev):
+    """A ``weights.LayerWeights`` from an ``ATOM_Q38_DUMP`` ``layer_<i>.pt``."""
+    d = torch.load(path, map_location="cpu", weights_only=False)
+
+    def gpu(x):
+        return None if x is None else {k: v.to(dev) for k, v in x.items()}
+
+    return W.LayerWeights(
+        d["layer_id"], d["kind"], gpu(d["args"]), gpu(d["qsa_norms"]), gpu(d["ple"])
+    )
+
+
+def _clone(b):
+    def c(d):
+        return None if d is None else {k: v.clone() for k, v in d.items()}
+
+    return W.LayerWeights(b.layer_id, b.kind, c(b.args), c(b.qsa_norms), c(b.ple))
+
+
+# ------------------------------------------------------------------ state
+
+
+class _Module:
+    def __init__(self, **fields):
+        self.__dict__.update(fields)
+
+
+def _deployment(kinds, slots, spec_tokens, pages, dev, gen):
+    gdn_layers = [i for i, k in enumerate(kinds) if k != "qsa"]
+    k = spec_tokens
+    runner = SimpleNamespace(
+        mamba_k_cache=_bf16(gen, (len(gdn_layers), slots, 3 + k, C.delta_qkv), dev, 0.5),
+        mamba_v_cache=torch.randn(
+            len(gdn_layers), slots, C.delta_v_heads, C.delta_v_dim, C.delta_k_dim,
+            generator=gen, device=dev, dtype=F32,
+        ) * 0.05,
+        ple_conv_state=_bf16(gen, (slots, C.hc_width, 9 + k), dev, 0.5),
+    )  # fmt: skip
+    layers, gdn_rows, qsa_rows = [], {}, {}
+    for i, kind in enumerate(kinds):
+        if kind == "qsa":
+            caches = {
+                attr: _bf16(gen, (pages, *page), dev, 1.0)
+                for attr, page in CACHE_PAGES.values()
+            }
+            m = _Module(is_qsa_attention=True, rope_position_cache=None, **caches)
+            qsa_rows[m] = 0
+            layers.append(SimpleNamespace(self_attn=m))
+        else:
+            policy = SimpleNamespace(decode=False, prefill=False)
+            m = _Module(impl=SimpleNamespace(gdn_flydsl_policy=policy))
+            gdn_rows[m] = gdn_layers.index(i)
+            layers.append(SimpleNamespace(linear_attn=SimpleNamespace(attn=m)))
+    builder = SimpleNamespace(
+        model_runner=runner,
+        pool_rows={LINEAR_STATE_ROWS: gdn_rows, QSA_ROWS: qsa_rows},
+        gdn_state_vk=True,
+        replayssm=False,
+    )
+    return builder, layers
+
+
+# ------------------------------------------------------------------ the rig
+
+
+@dataclasses.dataclass
+class Step:
+    """One prepared step width and its per-step inputs."""
+
+    w: object
+    rows: int
+    seq: bool
+    positions: torch.Tensor
+    slots_in: torch.Tensor | None = None
+    slots_out: torch.Tensor | None = None
+    slots: torch.Tensor | None = None
+    accepted: torch.Tensor | None = None
+    block_tables: torch.Tensor | None = None
+    groups: int = 0  # a grouped verify (``group_step``): its requests
+
+
+class MonoRig:
+    """``kinds``: the layer kinds of the rig's model (it needs one ``delta_ple`` layer and one
+    ``qsa`` layer, as the runner's tables do). ``context``: the QSA cache length every row sits at.
+    ``spec_tokens``: MTP k (the pools' extra conv rows / PLE columns; 0 = plain decode).
+    ``dump``: directory of ``ATOM_Q38_DUMP`` files; ``real``: {layer index: dump file stem} to
+    take real weights for (others synthetic). ``max_groups`` (with MTP): grouped verifies of up
+    to that many requests (``group_runner``; ``group_step``). ``slots``: state slots per pool
+    (default: enough for every step shape the rig serves, two per decode row)."""
+
+    def __init__(
+        self, kinds, experts=C.experts, context=8192, spec_tokens=0, dev="cuda",
+        seed=0, share_experts=True, dump=None, real=None, max_rows=C.hc_count,
+        logical_experts=False, max_groups=0, slots=None,
+    ):  # fmt: skip
+        assert "delta_ple" in kinds and "qsa" in kinds, kinds
+        self.dev = torch.device(dev)
+        gen = torch.Generator(device=self.dev)
+        gen.manual_seed(seed + 1)
+        self.kinds = list(kinds)
+        self.context = context
+        self.spec_tokens = spec_tokens
+        assert not max_groups or spec_tokens, "grouped verifies need MTP"
+        self.max_groups = max_groups
+        n = len(kinds)
+        layer_types = tuple(
+            "full_attention" if k == "qsa" else "linear_attention" for k in kinds
+        )
+        g = dataclasses.replace(
+            C, experts=experts, layers=n, layer_types=layer_types,
+            ple_layers=(kinds.index("delta_ple"),),
+        )  # fmt: skip
+        self.geometry = g
+        real = real or {}
+        bank = None
+        bound = []
+        loaded = {}
+        for i, kind in enumerate(kinds):
+            if i in real:
+                stem = real[i]
+                if stem not in loaded:
+                    loaded[stem] = load_dump(
+                        os.path.join(dump, f"layer_{stem}.pt"), self.dev
+                    )
+                    b = loaded[stem]
+                else:  # a copy: every tensor its own memory (cold-cache benches)
+                    b = _clone(loaded[stem])
+                assert b.kind == kind, (i, b.kind, kind)
+                bound.append(dataclasses.replace(b, layer_id=i))
+                continue
+            prm = synth_params(
+                kind, experts, self.dev, seed=seed * 1000 + i, expert_bank=bank,
+                logical_experts=logical_experts,
+            )  # fmt: skip
+            if share_experts and bank is None:
+                m = "mlp.experts."
+                bank = tuple(
+                    prm[m + x]
+                    for x in (
+                        "w13_weight",
+                        "w2_weight",
+                        "w13_weight_scale",
+                        "w2_weight_scale",
+                    )
+                )
+            bound.append(W.bind_parameters(prm, i, kind, experts))
+            del prm
+        self.bound = bound
+        # slots: decode rows read 2 r and write 2 r + 1 (no state carried over between launches);
+        # a verify's spec slots are 0 .. k
+        slots = (
+            slots
+            or max(2 * max_rows, 2 * (spec_tokens + 1), max_groups * (spec_tokens + 1))
+            + 1
+        )
+        self.slots = slots
+        pages_per_row = (context + 4 * PAGE) // PAGE + 1
+        rows_cap = max(max_rows, spec_tokens + 1, max_groups)
+        pages = pages_per_row * rows_cap + 1
+        builder, layers = _deployment(kinds, slots, spec_tokens, pages, self.dev, gen)
+        self.state = bind_state(builder, layers, self.kinds, spec_tokens)
+        self.pages_per_row = pages_per_row
+        if dump and os.path.exists(os.path.join(dump, "rope.pt")):
+            rope = torch.load(os.path.join(dump, "rope.pt"))
+            self.rope = tuple(t.to(self.dev) for t in rope)
+        else:
+            self.rope = synth_rope(context + 64, self.dev)
+        self.runner = self._runner()
+
+    def _runner(self):
+        cls = Qwen4MonoGroupRunner if self.max_groups else Qwen4MonoDecodeRunner
+        r = cls.__new__(cls)
+        if self.max_groups:
+            r.max_groups = self.max_groups
+            r.wide_scratch = None
+            r.groups = {}
+        g, dev = self.geometry, self.dev
+        r.geometry = g
+        r.kinds = self.kinds
+        r.verify_rows = self.spec_tokens + 1 if self.spec_tokens else 0
+        r.state = self.state
+        r.delta_layers = [i for i, k in enumerate(self.kinds) if k != "qsa"]
+        r.qsa_layers = [i for i, k in enumerate(self.kinds) if k == "qsa"]
+        (r.ple_layer,) = g.ple_layers
+        r.bound = self.bound
+        r.rope = self.rope
+        r.device = dev
+        r.dummy = torch.zeros(64, dtype=torch.int32, device=dev)
+        r.scratch = torch.zeros(
+            LY.scratch_bytes(LY.MAX_ROWS) // 4, dtype=torch.int32, device=dev
+        )
+        r.counter = torch.zeros(1, dtype=torch.int32, device=dev)
+        st = self.state
+        r._nulls = {
+            "conv": torch.zeros_like(st.conv[0, 0]),
+            "rec": torch.zeros_like(st.rec[0, 0]),
+            "ple": torch.zeros_like(st.ple_conv[0]),
+            "pages": torch.zeros(16, dtype=torch.int32, device=dev),
+        }
+        r.nulls = {k: v.data_ptr() for k, v in r._nulls.items()}
+        r._null_caches = [
+            torch.zeros(1, *CACHE_PAGES[c][1], dtype=BF16, device=dev)
+            for c in QSA_CACHES
+        ]
+        r.nulls["caches"] = torch.tensor(
+            [t.data_ptr() for t in r._null_caches], dtype=torch.int64, device=dev
+        )
+        r.widths = {}
+        r.prologue = None
+        return r
+
+    # -------------------------------------------------------------- steps
+
+    def step(self, rows) -> Step:
+        """Prepare a ``rows``-row step (a verify of ``k + 1`` rows with MTP) and its inputs."""
+        r = self.runner
+        assert r.prepare(rows), rows
+        w = r.widths[rows]
+        dev = self.dev
+        L = self.context
+        bt_rows = 1 if w.seq else rows
+        bt = torch.zeros(bt_rows, self.pages_per_row, dtype=torch.int32, device=dev)
+        for q in range(bt_rows):
+            bt[q] = (
+                torch.arange(self.pages_per_row, dtype=torch.int32, device=dev)
+                + 1
+                + q * self.pages_per_row
+            )
+        if w.seq:
+            pos = torch.arange(L, L + rows, dtype=torch.int64, device=dev)
+            return Step(
+                w, rows, True, pos,
+                slots=torch.arange(rows, dtype=torch.int32, device=dev),
+                accepted=torch.ones(1, dtype=torch.int32, device=dev),
+                block_tables=bt,
+            )  # fmt: skip
+        pos = torch.full((rows,), L, dtype=torch.int64, device=dev)
+        return Step(
+            w, rows, False, pos,
+            slots_in=torch.arange(0, 2 * rows, 2, dtype=torch.int32, device=dev),
+            slots_out=torch.arange(1, 2 * rows, 2, dtype=torch.int32, device=dev),
+            block_tables=bt,
+        )  # fmt: skip
+
+    def decode_step(self, rows=1) -> Step:
+        """A plain ``rows``-row decode step in a rig with MTP (whose own steps are verifies): the
+        sequential-launch oracle's. Its PLE rows read and write the pool's slots as a decode does;
+        a verify rig's pool is ``[slots, QKV, 9 + k]``, so point them at ``[QKV, 9]`` windows of
+        their own with :meth:`ple_io` after :meth:`meta`."""
+        r = self.runner
+        saved = r.verify_rows
+        r.verify_rows = 0
+        try:
+            return self.step(rows)
+        finally:
+            r.verify_rows = saved
+
+    def group_step(self, groups) -> Step:
+        """A grouped verify of ``groups`` requests of ``k + 1`` rows each (``group_runner``):
+        request ``g`` at positions ``L .. L + k``, spec slots ``g (k + 1) ..``, its own pages.
+        """
+        r = self.runner
+        S = r.verify_rows
+        rows = groups * S
+        assert self.max_groups >= groups >= 2 and r.prepare(rows), (groups, rows)
+        w = r.groups[rows]
+        dev, L = self.dev, self.context
+        bt = torch.zeros(groups, self.pages_per_row, dtype=torch.int32, device=dev)
+        for g in range(groups):
+            bt[g] = (
+                torch.arange(self.pages_per_row, dtype=torch.int32, device=dev)
+                + 1
+                + g * self.pages_per_row
+            )
+        pos = torch.arange(L, L + S, dtype=torch.int64, device=dev).repeat(groups)
+        return Step(
+            w, rows, True, pos,
+            slots=torch.arange(rows, dtype=torch.int32, device=dev).view(groups, S).contiguous(),
+            accepted=torch.ones(groups, dtype=torch.int32, device=dev),
+            block_tables=bt, groups=groups,
+        )  # fmt: skip
+
+    def ple_io(self, s: Step, row, conv_in, conv_out):
+        """Point row ``row``'s PLE table entries at ``conv_in`` / ``conv_out`` (``[QKV, 9]``)."""
+        t = s.w.tables.ple
+        t[row, PLE_CONV_IN] = conv_in.data_ptr()
+        t[row, PLE_CONV_IN + 1] = conv_out.data_ptr()
+
+    def scratch_ptr(self, s: Step):
+        """The scratch a step's launches take: a grouped verify's own (the wide one past
+        ``MAX_ROWS`` rows), else the runner's."""
+        return s.w.scratch if s.groups else self.runner.scratch.data_ptr()
+
+    def meta(self, s: Step):
+        """The step's per-step words (and the counter's advance), as the runner writes them."""
+        r = self.runner
+        if s.groups:
+            write_group_verify_meta(
+                r.counter, s.positions, s.slots, s.accepted, s.block_tables, s.w.tables,
+                self.state.ple_conv, s.w.ple_window, r.nulls,
+            )  # fmt: skip
+        elif s.seq:
+            write_verify_meta(
+                r.counter, s.positions, s.slots, s.accepted, s.block_tables,
+                s.w.tables, self.state.ple_conv, s.w.ple_window,
+            )  # fmt: skip
+        else:
+            write_step_meta(
+                r.counter, s.positions, s.slots_in, s.slots_out, s.block_tables,
+                s.w.tables, r.nulls,
+            )  # fmt: skip
+
+    def launch(self, s: Step, i, layer_slot=None, stream=None):
+        """Launch layer ``i``'s kernel with tag slot ``layer_slot`` (default ``i``)."""
+        r = self.runner
+        stream = stream or torch.cuda.current_stream(self.dev)
+        kind = self.kinds[i]
+        s.w.launch[kind](
+            r.counter.data_ptr(), i if layer_slot is None else layer_slot, self.scratch_ptr(s),
+            *s.w.args[i], stream=stream,
+        )  # fmt: skip
+
+    def h_in(self, s: Step, i):
+        return s.w.h0 if i == 0 else s.w.chain[i - 1]
+
+    def h_out(self, s: Step, i):
+        return s.w.chain[i]
+
+
+def build_prefix(stages, experts, rows=1, seq=False):
+    """``build_layer`` for a stage prefix (``kernel.STAGES`` subsets)."""
+    return build_layer(tuple(stages), experts, rows=rows, seq=seq)
+
+
+__all__ = [
+    "LAYER_ARGS",
+    "STAGES",
+    "MonoRig",
+    "Step",
+    "build_prefix",
+    "load_dump",
+    "synth_params",
+    "synth_rope",
+]
diff --git a/scripts/qwen38_rocke/harness/timeline.py b/scripts/qwen38_rocke/harness/timeline.py
new file mode 100644
index 0000000000000000000000000000000000000000..68fa68553f9cfdc16a7d5a910fb24fd997c20a7d
--- /dev/null
+++ b/scripts/qwen38_rocke/harness/timeline.py
@@ -0,0 +1,136 @@
+"""Decode the layer kernel's stage stamps (ATOM ``kernels/stamps.py``, ``ATOM_Q38_STAMPS=1``).
+
+A launch's stamps are ``[GRID][POINTS]`` int64 ``s_memrealtime`` ticks (100 MHz): point 0 the CTA's
+entry; per stage ``i`` of the build (its order): enter, exit (thread 0), ready of each wave (lane 0
+leaving its last mailbox poll of the stage; 0 when the wave polled nothing).
+
+Per stage, over the CTAs that hold one of its tasks (``layout`` task maps):
+
+- ``end``     the stage's completion: its last task's exit, from the launch's first CTA entry;
+- ``incr``    ``end`` minus the previous stage's ``end`` (clamped at 0): the stages' increments
+              partition the launch's critical path;
+- ``wait``    per task, ready - enter (the time spent polling for inputs), median over tasks;
+- ``tail``    per task, exit - ready (work after the inputs were ready), median and max;
+- ``span``    last exit - first enter over the stage's tasks;
+- ``first_ready``  first task's ready from launch start (when the stage's inputs started arriving).
+
+All values are in microseconds (the caller keeps them out of repo artifacts).
+"""
+
+from __future__ import annotations
+
+import statistics
+
+TICK_US = 0.01  # s_memrealtime runs at 100 MHz
+GRID = 256
+WAVES = 8
+PER_STAGE = 2 + WAVES
+
+
+def enter_ix(i):
+    return 1 + i * PER_STAGE
+
+
+def exit_ix(i):
+    return 2 + i * PER_STAGE
+
+
+def ready_ix(i, w=0):
+    return 3 + i * PER_STAGE + w
+
+
+def task_ctas(L, name):
+    """CTAs holding a task of stage ``name`` in layout ``L`` (first round only)."""
+    n = min(L.tasks[name], GRID)
+    return [(L.base[name] + t) % GRID for t in range(n)]
+
+
+def decode(stamps, stages, L):
+    """``stamps``: ``[GRID][POINTS]`` (list of lists or tensor). Returns a dict per stage plus
+    ``total`` (first entry to last exit) and ``entry_skew`` (last CTA entry - first)."""
+    S = [
+        [int(v) for v in row]
+        for row in (stamps.tolist() if hasattr(stamps, "tolist") else stamps)
+    ]
+    entries = [r[0] for r in S if r[0]]
+    if not entries:
+        return None
+    t0 = min(entries)
+    us = lambda t: (t - t0) * TICK_US
+    out = {"stages": {}, "entry_skew": us(max(entries))}
+    prev_end = 0.0
+    last = 0.0
+    for i, name in enumerate(stages):
+        ctas = task_ctas(L, name)
+        ent, ext, rdy, waits, tails = [], [], [], [], []
+        for b in ctas:
+            e, x = S[b][enter_ix(i)], S[b][exit_ix(i)]
+            if not e or not x:
+                continue
+            r = max(S[b][ready_ix(i, w)] for w in range(WAVES))
+            ent.append(us(e))
+            ext.append(us(x))
+            if r:
+                rdy.append(us(r))
+                waits.append((r - e) * TICK_US)
+                tails.append((x - r) * TICK_US)
+        if not ext:
+            out["stages"][name] = None
+            continue
+        end = max(ext)
+        st = {
+            "tasks": len(ext),
+            "end": end,
+            "incr": max(0.0, end - prev_end),
+            "span": end - min(ent),
+            "first_enter": min(ent),
+            "first_ready": min(rdy) if rdy else None,
+            "last_ready": max(rdy) if rdy else None,
+            "wait_med": statistics.median(waits) if waits else 0.0,
+            "tail_med": (
+                statistics.median(tails)
+                if tails
+                else statistics.median([x - e for x, e in zip(ext, ent, strict=True)])
+            ),
+            "tail_max": (
+                max(tails)
+                if tails
+                else max(x - e for x, e in zip(ext, ent, strict=True))
+            ),
+        }
+        out["stages"][name] = st
+        prev_end = max(prev_end, end)
+        last = max(last, end)
+    # every CTA's last exit (the CTAs without a task in the last stage leave earlier)
+    exits = [
+        S[b][exit_ix(len(stages) - 1)]
+        for b in range(GRID)
+        if S[b][exit_ix(len(stages) - 1)]
+    ]
+    out["total"] = us(max(exits)) if exits else last
+    return out
+
+
+def merge(decoded):
+    """Median over launches of every numeric stage field."""
+    decoded = [d for d in decoded if d]
+    if not decoded:
+        return None
+    names = list(decoded[0]["stages"])
+    out = {"launches": len(decoded), "stages": {}}
+    for k in ("total", "entry_skew"):
+        out[k] = statistics.median(d[k] for d in decoded)
+    for n in names:
+        rows = [d["stages"][n] for d in decoded if d["stages"].get(n)]
+        if not rows:
+            out["stages"][n] = None
+            continue
+        out["stages"][n] = {
+            f: (
+                statistics.median(r[f] for r in rows if r[f] is not None)
+                if any(r[f] is not None for r in rows)
+                else None
+            )
+            for f in rows[0]
+        }
+    return out
diff --git a/scripts/qwen38_rocke/head/gate_head.py b/scripts/qwen38_rocke/head/gate_head.py
new file mode 100644
index 0000000000000000000000000000000000000000..beb9880e7d4bc9889f5fccbfd5168466afae2d86
--- /dev/null
+++ b/scripts/qwen38_rocke/head/gate_head.py
@@ -0,0 +1,138 @@
+"""lm_head gate: ATOM's ``ATOM_Q38_ROCKE_HEAD=1`` head (``rocke_head.build``, the served build with the served
+defaults: fused argmax fold, ``DEFAULT_SPEC``) against the mono head (``head.mxfp4_head`` / ``mxfp4_argmax``) at
+the served head shape (248320 x 2560 MXFP4), on gfx950.
+
+- logits: bitwise (bf16 bits) vs ``mxfp4_head``, rows 1..16 (the 4-row and the 16-row builds);
+- argmax: equal to ``mxfp4_argmax`` (lowest index of the largest bf16 logit), rows 1..16, plain and with a
+  planted tie (row 0's winning column copied to a lower column, so only the tie rule decides), three calls in a
+  row (the fused fold's launch counter carries across calls);
+- mutant: a build whose K order differs from the mono's (``korder="lane"``) must give different logits bits, so
+  the logits comparison can fail.
+
+    python gate_head.py [--rows 1,2,3,4,8,16] [--out r.json]
+
+Prints one ``HEAD {json}`` line per check, then ``HEAD PASS`` / ``HEAD FAIL``.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+
+import torch
+
+N_HEAD, K_HEAD = 248320, 2560
+
+
+def weights(n=N_HEAD, k=K_HEAD, seed=0):
+    g = torch.Generator(device="cuda").manual_seed(seed)
+    w = torch.randint(
+        0, 256, (n, k // 2), dtype=torch.uint8, device="cuda", generator=g
+    )
+    s = torch.randint(
+        112, 124, (n, k // 32), dtype=torch.uint8, device="cuda", generator=g
+    )
+    return w, s
+
+
+def build(spec=None, parts=None):
+    from atom.models.qwen4_exp_mono import head as H
+    from atom.models.qwen4_exp_mono import rocke_head as RH
+
+    old = {k: os.environ.get(k) for k in (RH.ENV, f"{RH.ENV}_SPEC", f"{RH.ENV}_PARTS")}
+    os.environ[RH.ENV] = "1"
+    if parts:
+        os.environ[f"{RH.ENV}_PARTS"] = parts
+    if spec:
+        os.environ[f"{RH.ENV}_SPEC"] = json.dumps(spec)
+    else:
+        os.environ.pop(f"{RH.ENV}_SPEC", None)
+    try:
+        return RH.build(PACKED, H.MAX_HEAD_ROWS)
+    finally:
+        for k, v in old.items():
+            if v is None:
+                os.environ.pop(k, None)
+            else:
+                os.environ[k] = v
+
+
+def main(argv=None):
+    global PACKED
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--rows", default="1,2,3,4,8,16")
+    ap.add_argument("--out")
+    a = ap.parse_args(argv)
+    from atom.models.qwen4_exp_mono import head as H
+    from atom.models.qwen4_exp_mono import rocke_head as RH
+
+    for k in [k for k in os.environ if k.startswith(RH.ENV + "_")]:
+        os.environ.pop(k)  # the served defaults only
+    arch = torch.cuda.get_device_properties(0).gcnArchName.split(":")[0]
+    if arch != "gfx950":
+        print(f"HEAD FAIL: device is {arch}, the gate needs gfx950", flush=True)
+        return 1
+    w, s = weights()
+    PACKED = w
+    rk = build()
+    mut = build({"korder": "lane"}, parts="logits")
+    keys = H.argmax_keys(w)
+    ok = True
+    res = []
+    for rows in [int(r) for r in a.rows.split(",")]:
+        g = torch.Generator(device="cuda").manual_seed(100 + rows)
+        x = (torch.randn(rows, K_HEAD, device="cuda", generator=g) * 0.5).to(
+            torch.bfloat16
+        )
+        mono = H.mxfp4_head(x, w, s)
+        got = rk.logits(x, w, s)
+        bad = (got.view(torch.int16) != mono.view(torch.int16)).sum().item()
+        m = mut.logits(x, w, s)
+        mbad = (m.view(torch.int16) != mono.view(torch.int16)).sum().item()
+        # argmax with a planted tie: row 0's winner copied to a lower column (the lowest index must win)
+        j = int(mono[0].float().argmax())
+        lo = j // 2
+        w2, s2 = w.clone(), s.clone()
+        w2[lo], s2[lo] = w2[j], s2[j]
+        want = torch.empty(rows, dtype=torch.int32, device="cuda")
+        H.mxfp4_argmax(x, w2, s2, H.argmax_keys(w2), want)
+        calls = []
+        for _ in range(3):
+            out = torch.full((rows,), -1, dtype=torch.int32, device="cuda")
+            r_out = rk.argmax(x, w2, s2, H.argmax_keys(w2), out)
+            calls.append(r_out is out and bool(torch.equal(out, want)))
+        plain = torch.empty(rows, dtype=torch.int32, device="cuda")
+        H.mxfp4_argmax(x, w, s, keys, plain)
+        out = torch.full((rows,), -1, dtype=torch.int32, device="cuda")
+        rk.argmax(x, w, s, keys, out)
+        tie_lower = (
+            j == 0 or int(want[0]) == lo
+        )  # the mono's own rule took the planted lower column
+        cell = {"rows": rows, "logits_bitwise": bad == 0, "logits_bad": bad, "mutant_logits_differ": mbad > 0,
+                "argmax_tie_eq_mono_3_calls": calls, "argmax_eq_mono": bool(torch.equal(out, plain)),
+                "tie_took_lower_column": tie_lower}  # fmt: skip
+        good = (
+            bad == 0
+            and mbad > 0
+            and all(calls)
+            and cell["argmax_eq_mono"]
+            and tie_lower
+        )
+        ok &= good
+        res.append(cell)
+        print("HEAD", json.dumps(cell), flush=True)
+    names = sorted({k.name for k in (*rk.logits_k.values(), *rk.argmax_k.values())})
+    print("HEAD builds", " ".join(names), "fold", rk.fold, flush=True)
+    if a.out:
+        with open(a.out, "w") as f:
+            json.dump({"cells": res, "builds": names, "pass": ok}, f, indent=1)
+    print("HEAD", "PASS" if ok else "FAIL", flush=True)
+    return 0 if ok else 1
+
+
+PACKED = None
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/qwen38_rocke/hybrid/isa_layer.py b/scripts/qwen38_rocke/hybrid/isa_layer.py
new file mode 100644
index 0000000000000000000000000000000000000000..92ddbb7053b75f559d42b79cf0d046c05424cccb
--- /dev/null
+++ b/scripts/qwen38_rocke/hybrid/isa_layer.py
@@ -0,0 +1,76 @@
+"""Compile one mono layer build (compile only, no launch) with FLYDSL_DUMP_IR=1 set by the caller,
+then print the final ISA's resource lines of every kernel dumped under FLYDSL_DUMP_DIR.
+
+    FLYDSL_DUMP_IR=1 FLYDSL_DUMP_DIR=D python isa_layer.py --kind qsa --rows 4 --seq [--out r.json]
+
+The knobs (ATOM_Q38_EXTERN_STAGES, ATOM_Q38_STAMPS) come from the environment, as in a server.
+"""
+
+from __future__ import annotations
+
+import argparse
+import glob
+import hashlib
+import json
+import os
+import re
+import sys
+
+KEYS = {
+    "vgpr": r"\.vgpr_count:\s+(\d+)", "sgpr": r"\.sgpr_count:\s+(\d+)", "agpr": r"\.agpr_count:\s+(\d+)",
+    "lds": r"\.group_segment_fixed_size:\s+(\d+)", "scratch": r"\.private_segment_fixed_size:\s+(\d+)",
+    "vgpr_spill": r"\.vgpr_spill_count:\s+(\d+)", "sgpr_spill": r"\.sgpr_spill_count:\s+(\d+)",
+    "occupancy": r";\s*Occupancy:\s+(\d+)",
+}  # fmt: skip
+
+
+def isa_resources(path):
+    with open(path) as f:
+        text = f.read()
+    out = {
+        k: (int(m[-1]) if (m := re.findall(p, text)) else None) for k, p in KEYS.items()
+    }
+    out["calls"] = len(re.findall(r"\bs_swappc_b64\b", text))
+    # instruction body only (no comments, no metadata): byte-identity across trees
+    body = [
+        ln
+        for ln in text.splitlines()
+        if ln.strip() and not ln.lstrip().startswith((";", ".", "//"))
+    ]
+    out["insts"] = len(body)
+    out["body_sha"] = hashlib.sha256("\n".join(body).encode()).hexdigest()[:16]
+    return out
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--kind", default="qsa")
+    ap.add_argument("--rows", type=int, default=1)
+    ap.add_argument("--seq", action="store_true")
+    ap.add_argument("--experts", type=int, default=512)
+    ap.add_argument("--out")
+    a = ap.parse_args(argv)
+    from atom.models.qwen4_exp_mono.kernels import kernel as K
+    from atom.mono.runtime.compile import compile_only
+
+    with compile_only():
+        K.build_layer(K.STAGES[a.kind], a.experts, rows=a.rows, seq=a.seq)(
+            0, 0, *([0] * len(K.LAYER_ARGS))
+        )
+    res = {}
+    for f in sorted(
+        glob.glob(
+            os.path.join(os.environ["FLYDSL_DUMP_DIR"], "**", "*final_isa.s"),
+            recursive=True,
+        )
+    ):
+        res[os.path.relpath(f, os.environ["FLYDSL_DUMP_DIR"])] = isa_resources(f)
+    print(json.dumps(res, indent=1))
+    if a.out:
+        with open(a.out, "w") as f:
+            json.dump(res, f, indent=1)
+    return 0 if res else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
