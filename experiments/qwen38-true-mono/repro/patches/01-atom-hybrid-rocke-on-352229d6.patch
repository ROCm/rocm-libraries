@@ -0,0 +1,860 @@
+"""Fused MoE track A/B: the mono layer (FlyDSL M3/M4/M5) vs the rocKE fused MoE (``moe_fused``).
+
+Arms:
+    full          the plain FlyDSL layer (the reference)
+    full2         the same build, a second graph: the mono-vs-mono control (bench)
+    fullnuma      the plain FlyDSL layer with ATOM's numa=1 schedule lever (NUMA dual-copy mailboxes)
+    hyb:K         the layer with m3 = the fused body (knobs K, JSON FusedKnobs) and m4 / m5 empty
+                  (ATOM_Q38_EXTERN_STAGES, ``stage_moe_fused``): in situ; K with "numa": 1 builds the layer
+                  with the numa=1 lever (the body addresses its NUMA area), K with lg_copy / xchg_home numa2
+                  only (numa 0) gives the scratch a calibrated NUMA area through a lever on another layer kind
+    fly / fs:K    split arms (``--stages m4,m5``, real routing): the FlyDSL a1..m3 prefix, the captured
+                  router logits injected, then the FlyDSL m4+m5 (fly) or the fused suffix without router (fs)
+
+    python fused_ab.py check --rows 4 --arms 'hyb:{}' --mutants 'hyb:{"mutate":"combine_swap"}'
+    python fused_ab.py check --rows 4 --stages m4,m5 --routing real --arms 'fs:{"router":false}'
+    python fused_ab.py bench --rows 4 --arms 'hyb:{}' --rounds 20
+    python fused_ab.py stamps --rows 4 --arms 'hyb:{"phase_stamps":true}'   (ATOM_Q38_STAMPS=1)
+
+check: bitwise h_out, lg / sg / dn payloads and the whole scratch mailbox part outside the ``ss`` regions of
+rows 0..3 (the fused body's private ys / stamps; the second half, Q3 / Q4's index scores, is compared too),
+every arm from one snapshot under one tag; arms with NUMA-area mailboxes are compared on their logical view
+(the area's copy 0 where the arm keeps a region there, copy 1 must equal copy 0); ``--mutants`` must differ in
+h_out (``xtag_or`` mutants: only at steps >= 2^25, where the old OR tag equals the launch tag; equal before).
+``--step0 N``: the step counter starts at N after the builds (e.g. 2^25 - 2: the cases cross the step where
+launch tags get bit 31). ``--force-u 10``: rows > 1 non-seq delta / delta_ple only (identical rows, every row's
+input state set to row 0's, so they route alike; seq rows are consecutive tokens of one request and QSA rows read
+their own caches, so U = 10 is reachable for them only by injection: ``--stages m4,m5 --routing real --inject
+same``) / ``--force-u 40`` (inputs searched until every row's top-10 is distinct). bench: one
+graph per arm (``--launches`` launches over ``--copies`` cold weight copies); per round every arm replays once
+in a shuffled order; ratio per round vs that round's ``full``; a win counts only when its median < the
+control's (full2) minimum and >= 3/4 of its rounds are < 1.
+Absolute times go to ``--out`` only; stdout carries ratios.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import random
+import statistics
+import sys
+import time
+
+os.environ.setdefault("FLYDSL_RUNTIME_ENABLE_CACHE", "0")
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.join(HERE, "..", "moe"))
+sys.path.insert(0, os.path.join(HERE, "..", "harness"))
+
+import moe_ab as MA
+import timeline
+import torch
+from kernels.gfx950.qwen38_mono import abi as A
+from kernels.gfx950.qwen38_mono import moe_fused as MF
+from kernels.gfx950.qwen38_mono import stage_moe_fused as SMF
+from kernels.gfx950.qwen38_mono.stage_fn import variant_name
+from rocke.helpers.compile import compile_kernel
+from rocke.runtime.launcher import KernelLauncher, LaunchConfig, no_fence
+
+from atom.models.qwen4_exp_mono.kernels import kernel as K
+from atom.models.qwen4_exp_mono.kernels import layout as LY
+
+SLOTS = MA.SLOTS
+
+
+BASE = {}  # --base: FusedKnobs merged under every hyb: / fs: arm's own
+
+
+def parse_arms(text):
+    out = []
+    for item in (text or "").split(";"):
+        item = item.strip()
+        if not item:
+            continue
+        kind, _, js = item.partition(":")
+        if kind in ("hyb", "fs"):
+            kn = dict(BASE, **json.loads(js or "{}"))
+            out.append((kind + ":" + json.dumps(kn, sort_keys=True), kn))
+        else:
+            out.append((item, None))
+    return out
+
+
+SCHED_ENV = "ATOM_Q38_SCHED"
+
+
+def sched_for(kind, fk):
+    """ATOM_Q38_SCHED while a fused arm builds: numa=1 for a numa=1 body (the build keeps the lever), a numa lever
+    on another layer kind for a plain body with NUMA-area copies (the area exists, this build has no lever).
+    """
+    if fk is None:
+        return None
+    if fk.numa:
+        return "numa=1"
+    if fk.uses_area:
+        other = "delta_ple" if kind != "delta_ple" else "delta"
+        return f"{other}.r1:numa=1"
+    return None
+
+
+class _Env:
+    def __init__(self, key, value):
+        self.key, self.value = key, value
+
+    def __enter__(self):
+        self.old = os.environ.get(self.key)
+        if self.value is None:
+            os.environ.pop(self.key, None)
+        else:
+            os.environ[self.key] = self.value
+
+    def __exit__(self, *exc):
+        if self.old is None:
+            os.environ.pop(self.key, None)
+        else:
+            os.environ[self.key] = self.old
+
+
+def numa_launcher(cell):
+    """The plain FlyDSL layer with the numa=1 lever (NUMA dual-copy mailboxes)."""
+    a = cell.a
+    t0 = time.time()
+    with _Env(SCHED_ENV, "numa=1"):
+        launch = K.build_layer(K.STAGES[a.kind], a.experts, rows=a.rows, seq=a.seq)
+    launch.compile_s = time.time() - t0
+    launch.name = "mono_numa1"
+    launch.fk = MF.FusedKnobs(
+        numa=1, lg_copy="numa2", xchg_home="numa2"
+    )  # logical view: every region in the area
+    launch.mono_numa = True
+    return launch
+
+
+def fused_launcher(cell, knobs):
+    """The FlyDSL layer with m3 = the fused body, m4 / m5 empty (in situ)."""
+    from atom.models.qwen4_exp_mono.kernels import extern_stages as XS
+
+    a = cell.a
+    t0 = time.time()
+    kn = dict(knobs)
+    inline = kn.pop("_inline", "always")
+    fk = SMF.knobs_from_json(kn)
+    var = variant_name(a.rows, a.seq)
+    out_dir = os.path.join(
+        os.environ.get("Q38_ROCKE_TMP", HERE),
+        "fused",
+        a.kind,
+        (fk.suffix() or "default") + f"_inl{inline}",
+    )
+    SMF.write_functions(out_dir, [var], fk, experts=a.experts, inline=inline)
+    spec = ",".join(f"{st}={out_dir}/{st}_{{variant}}.ll" for st in SMF.STAGES)
+    old = os.environ.get(XS.ENV)
+    os.environ[XS.ENV] = spec
+    env = _Env(SCHED_ENV, sched_for(a.kind, fk))
+    env.__enter__()
+    try:
+        launch = K.build_layer(K.STAGES[a.kind], a.experts, rows=a.rows, seq=a.seq)
+        _c, lst = cell.args(0)
+        launch(
+            cell.r.counter.data_ptr(),
+            0,
+            cell.r.scratch.data_ptr(),
+            *lst,
+            stream=torch.cuda.current_stream(),
+        )
+        torch.cuda.synchronize()
+        cell.r.counter.add_(1)
+    finally:
+        env.__exit__()
+        if old is None:
+            os.environ.pop(XS.ENV, None)
+        else:
+            os.environ[XS.ENV] = old
+    launch.compile_s = time.time() - t0
+    launch.name = f"fused_{fk.suffix() or 'default'}_inl{inline}"
+    launch.fdir = out_dir
+    launch.fk = fk
+    return launch
+
+
+def suffix_launcher(cell, knobs):
+    """The standalone fused body without router (after the FlyDSL a1..m3 prefix)."""
+    a = cell.a
+    t0 = time.time()
+    fk = SMF.knobs_from_json(dict(knobs, router=False))
+    kern = MF.build_fused_suffix(a.rows, fk, a.experts)
+    art = compile_kernel(kern, arch="gfx950", backend="python")
+    lau = KernelLauncher(
+        hsaco=art.hsaco, kernel_name=art.kernel_name, signature=MF.signature()
+    )
+
+    def launch(step, layer, scratch, *args, stream):
+        vals = {"step": step, "layer": layer, "scratch": scratch}
+        vals.update(zip(A.LAYER_ARGS[1:], args))
+        with no_fence():
+            lau(
+                vals,
+                config=LaunchConfig(
+                    grid=(A.GRID, 1, 1),
+                    block=(A.THREADS, 1, 1),
+                    stream=stream.cuda_stream,
+                ),
+            )
+
+    launch.compile_s = time.time() - t0
+    launch.name = art.kernel_name
+    return launch
+
+
+def is_numa_build(cell, name):
+    """Whether arm ``name`` is a layer build with the numa=1 lever (fullnuma, fused numa=1)."""
+    if name == "fullnuma":
+        return True
+    if not name.startswith("hyb:"):
+        return False
+    return bool(SMF.knobs_from_json(json.loads(name[4:])).numa)
+
+
+def prenuma_launcher(cell):
+    """The mono layer cut after M2 with the numa=1 lever."""
+    a = cell.a
+    with _Env(SCHED_ENV, "numa=1"):
+        launch = K.build_layer(cell.prefix, a.experts, rows=a.rows, seq=a.seq)
+    launch.compile_s = 0.0
+    launch.name = "pre_numa1"
+    return launch
+
+
+def add_arms(cell, arms):
+    info = {}
+    if any(is_numa_build(cell, n) for n, _k in arms) and "prenuma" not in cell.launch:
+        cell.launch["prenuma"] = prenuma_launcher(cell)
+    for name, kn in arms:
+        if name in cell.launch:
+            continue
+        if name == "full2":
+            cell.launch[name] = cell.launch["full"]
+            continue
+        if name == "fullnuma":
+            cell.launch[name] = numa_launcher(cell)
+        elif name.startswith("hyb:"):
+            cell.launch[name] = fused_launcher(cell, kn)
+        elif name.startswith("fs:"):
+            cell.launch[name] = suffix_launcher(cell, kn)
+        else:
+            continue
+        info[name] = {
+            "kernel": cell.launch[name].name,
+            "compile_s": round(cell.launch[name].compile_s, 1),
+        }
+        print(
+            f"[fused_ab] built {name} -> {cell.launch[name].name} ({cell.launch[name].compile_s:.1f} s)",
+            flush=True,
+        )
+    return info
+
+
+def pair(cell, arm, j, slot, stream):
+    """``hyb:`` / ``full`` / ``full2``: the whole layer; ``fly`` / ``fs:``: prefix + inject + suffix."""
+    if arm in ("full", "full2", "fullnuma", "prenuma") or arm.startswith("hyb:"):
+        _c, lst = cell.args(j)
+        cell.launch[arm](
+            cell.r.counter.data_ptr(),
+            slot,
+            cell.r.scratch.data_ptr(),
+            *lst,
+            stream=stream,
+        )
+        return
+    cell.pair(arm, j, slot, stream)
+
+
+# ------------------------------------------------------------------ inputs
+
+
+def same_state(cell):
+    """Non-seq rows (independent requests): every row's input state = row 0's (DeltaNet conv / recurrent
+    rows, PLE conv rows of the input slots 2 r), so identical input rows reach the MoE identical (U = 10).
+    """
+    a = cell.a
+    st = cell.rig.state
+    for name, dim in (("rec", 1), ("conv", 1), ("ple_conv", 0)):
+        t = getattr(st, name, None)
+        if not isinstance(t, torch.Tensor):
+            continue
+        for r in range(1, a.rows):
+            (t[:, 2 * r] if dim == 1 else t[2 * r]).copy_(t[:, 0] if dim == 1 else t[0])
+    torch.cuda.synchronize()
+
+
+def force_u(cell, want):
+    """Replace the inputs so that every launch routes to ``want`` unique experts (10: identical rows with
+    identical input state, non-seq delta / delta_ple only; 10 R: searched)."""
+    a = cell.a
+    if want == A.TOP_K and a.rows > 1:
+        if a.seq or a.kind == "qsa":
+            raise SystemExit(
+                "force-u 10 at rows > 1: non-seq delta / delta_ple only (seq rows are one request's "
+                "consecutive tokens; QSA rows read their own caches): use --inject same"
+            )
+        same_state(cell)
+    dev = torch.device("cuda")
+    gen = torch.Generator(device=dev)
+    gen.manual_seed(777 + a.seed)
+    width = cell.rig.geometry.hc_width
+    stream = torch.cuda.current_stream()
+    got = []
+    tries = 0
+    while len(got) < a.inputs and tries < 400:
+        tries += 1
+        if want == A.TOP_K:
+            x = (
+                torch.randn(1, width, generator=gen, device=dev)
+                .expand(a.rows, width)
+                .contiguous()
+            )
+        else:
+            x = torch.randn(a.rows, width, generator=gen, device=dev)
+        x = x.to(torch.bfloat16)
+        cell.ins[len(got) % len(cell.ins)] = x
+        j = len(got) % len(cell.ins)
+        cell.r.counter.add_(1)
+        pair(cell, "full", j, j % SLOTS, stream)
+        torch.cuda.synchronize()
+        u = MA.lg_unique(cell.r.scratch, a.rows, a.experts)
+        if u == want:
+            got.append(x)
+    if len(got) < a.inputs:
+        raise SystemExit(
+            f"force-u {want}: found {len(got)} of {a.inputs} inputs in {tries} tries"
+        )
+    cell.ins = got
+    print(f"[fused_ab] force-u {want}: {len(got)} inputs in {tries} tries", flush=True)
+
+
+# ------------------------------------------------------------------ check
+
+
+def ss_mask(n_words, spec_prev=False):
+    """bool [n_words] of the compared scratch words: everything before the NUMA header (the mailbox part, rows
+    0..3 and the second half where Q3 / Q4 keep the index scores, and the stamp / blame / spin regions) without
+    rows 0..3's ``ss`` region (the fused body's private ys / stamps); with
+    ``spec_prev`` also without the per-layer union histories (unused region tails, ``spec=prev`` only). The
+    ``combine=last`` counters are compared: every launch leaves them at 0, as the mono does.
+    """
+    keep = torch.ones(n_words, dtype=torch.bool)
+    hdr = numa_hdr_words()[0]
+    keep[hdr:] = (
+        False  # the NUMA header and area (numa arms: compared on their logical view)
+    )
+    lo = LY.SC["ss"] // 4
+    n = LY.REGIONS["ss"] * 2
+    for row in range(LY.MAX_ROWS):
+        b0 = row * LY.SCRATCH_BYTES // 4 + lo
+        keep[b0 : b0 + n] = False
+    if spec_prev:
+        for layer in range(MF.HIST_LAYERS):
+            h = MF.hist_offset(layer) // 4
+            keep[h : h + 16] = False
+    return keep
+
+
+def numa_hdr_words():
+    from atom.models.qwen4_exp_mono.kernels import numa as NUMA
+
+    h = NUMA.header_offset() // 4
+    return h, h + 2
+
+
+def logical(scratch, fk):
+    """(logical scratch words, copies equal) of an arm whose knobs ``fk`` keep regions in ATOM's NUMA area:
+    every region the arm keeps there read from the area's copy 0; copies equal: copy 1 == copy 0 there.
+    """
+    from atom.models.qwen4_exp_mono.kernels import numa as NUMA
+
+    w = MA.words_of(scratch)
+    out = w.clone()
+    if fk is None or not fk.uses_area:
+        return out, True
+    mb = LY.mailbox_bytes(LY.MAX_ROWS) // 4
+    base_w = (NUMA.area_base(scratch.data_ptr()) - scratch.data_ptr()) // 4
+    idx = torch.arange(mb, device=w.device)
+    ph = base_w + idx + (idx & ~2047)
+    c0, c1 = w[ph], w[ph + 2048]
+    sel = torch.zeros(mb, dtype=torch.bool, device=w.device)
+    if fk.numa:
+        sel[:] = True
+    for names, on in (
+        (("lg", "sg"), fk.lg_copy == "numa2"),
+        (("dn",), fk.xchg_home == "numa2"),
+    ):
+        for nm in names:
+            for row in range(LY.MAX_ROWS):
+                b0 = (LY.SC[nm] + row * LY.SCRATCH_BYTES) // 4
+                sel[b0 : b0 + 2 * LY.REGIONS[nm]] = on
+    if (
+        fk.numa
+    ):  # the body's private ys / stamps stay in the plain ss (unused under the lever): masked anyway
+        pass
+    out[:mb][sel] = c0[sel]
+    same = bool(torch.equal(c0[sel], c1[sel]))
+    return out, same
+
+
+def check(cell, arms, mutants):
+    a = cell.a
+    stream = torch.cuda.current_stream()
+    r = cell.r
+    regions = (["lg", "sg"] if "m3" in cell.stages else []) + ["dn"]
+    ref = "full" if a.routing == "random" else "fly"
+    live = MA.state_tensors(cell.rig)
+    words = MA.words_of(r.scratch).numel()
+    spec_prev = any((k or {}).get("spec") == "prev" for _n, k in arms + mutants)
+    keep = ss_mask(words, spec_prev).to(r.scratch.device)
+    h0, h1 = numa_hdr_words()
+    res = {"cases": []}
+    ok = True
+    for j in range(min(a.inputs, a.check_cases)):
+        slot = j % SLOTS
+        c, _ = cell.args(j)
+        r.counter.add_(1)
+        hdr = (
+            MA.words_of(r.scratch)[h0:h1].clone()
+            if MA.words_of(r.scratch).numel() >= h1
+            else None
+        )
+        r.scratch.zero_()
+        if hdr is not None:  # the NUMA area's calibration survives the zeroing
+            MA.words_of(r.scratch)[h0:h1] = hdr
+        step = int(r.counter[0].item())
+        torch.cuda.synchronize()
+        snap = {k: t.clone() for k, t in live.items()}
+        got = {}
+        for arm, _k in [(ref, None)] + [x for x in arms + mutants if x[0] != ref]:
+            for k, t in live.items():
+                t.copy_(snap[k])
+            cell.outs[c].zero_()
+            torch.cuda.synchronize()
+            pair(cell, arm, j, slot, stream)
+            torch.cuda.synchronize()
+            fk = getattr(cell.launch.get(arm), "fk", None)
+            sw, same = logical(r.scratch, fk)
+            got[arm] = (
+                cell.outs[c].clone(),
+                {n: MA.payload(sw, n, a.rows) for n in regions},
+                sw[keep].clone(),
+                {k: t.clone() for k, t in live.items() if k != "scratch"},
+                same,
+            )
+            if arm == ref:
+                u = MA.lg_unique(r.scratch, a.rows, a.experts)
+        del snap
+        ref_h, ref_m, ref_s, ref_st, _same = got[ref]
+        case = {"case": j, "U": u, "step": step, "arms": {}}
+        for arm, (h, m, s, st, same) in got.items():
+            if arm == ref:
+                continue
+            e = {
+                "h_out_bitwise": bool(torch.equal(h, ref_h)),
+                "h_out_max_abs": float((h.float() - ref_h.float()).abs().max()),
+                "h_out_nonzero": bool((h != 0).any()),
+                "scratch_bitwise": bool(torch.equal(s, ref_s)),
+                "state_bitwise": all(torch.equal(st[k], ref_st[k]) for k in st),
+                "numa_copies_equal": same,
+            }
+            if not e["scratch_bitwise"]:
+                bad = (s != ref_s).nonzero().flatten()
+                idx = keep.nonzero().flatten()[bad[:4].to(keep.device)].tolist()
+                e["scratch_bad"] = int(bad.numel())
+                e["scratch_first_bad_words"] = idx
+            for n in regions:
+                eq = m[n] == ref_m[n]
+                e[f"{n}_bitwise"] = bool(eq.all())
+                if not eq.all():
+                    e[f"{n}_bad"] = int((~eq).sum())
+            is_mut = any(arm == x[0] for x in mutants)
+            if is_mut and "xtag_or" in arm:
+                # the old OR tag equals the launch tag once it carries bit 31 (step >= 2^25): in QSA layers the
+                # combine then takes Q5's ss pairs of this launch for ys, where ys shares Q5's ss (plain ss for a
+                # plain build with plain ys; the NUMA area's ss for a numa=1 build with ys_home=numa2); exact else
+                mk = getattr(cell.launch.get(arm), "fk", None)
+                shared_ss = mk is not None and bool(mk.numa) == (mk.ys_home == "numa2")
+                want = a.kind == "qsa" and shared_ss and (step % 2**26) >= 2**25
+                e["mutant_differs"] = not (e["h_out_bitwise"] and e["scratch_bitwise"])
+                e["mutant_expected_differs"] = want
+                ok &= e["mutant_differs"] == want
+            elif is_mut:
+                e["mutant_differs"] = not e["h_out_bitwise"]
+                ok &= e["mutant_differs"]
+            else:
+                ok &= (
+                    e["h_out_bitwise"]
+                    and e["h_out_nonzero"]
+                    and e["scratch_bitwise"]
+                    and e["state_bitwise"]
+                    and all(e[f"{n}_bitwise"] for n in regions)
+                    and same
+                )
+            case["arms"][arm] = e
+        res["cases"].append(case)
+        print("CASE", json.dumps(case), flush=True)
+    res["pass"] = bool(ok)
+    return res
+
+
+# ------------------------------------------------------------------ bench
+
+
+def bench(cell, arms):
+    a = cell.a
+    r = cell.r
+    # "pre": the mono layer cut after M2 (a1..m2): MoE time ~ arm - pre (the split estimate; the cut kernel's
+    # tail overlaps nothing), reported as moe_ratio = (arm - pre) / (full - pre) per round. Arms built with the
+    # numa=1 lever (fullnuma, fused numa=1) take "prenuma" (the cut with the lever) as their pre: their
+    # moe_ratio is their MoE vs the plain mono's MoE; moe_vs_numa_mono: vs the numa=1 mono's MoE (fullnuma).
+    nl = [n for n, _ in arms if is_numa_build(cell, n)]
+    names = (
+        ["full", "full2", "pre"]
+        + (["prenuma"] if nl else [])
+        + [n for n, _ in arms if n not in ("full", "full2", "pre", "prenuma")]
+    )
+    stream = torch.cuda.current_stream()
+    for arm in names:
+        for j in range(min(a.launches, a.copies)):
+            pair(cell, arm, j, j % SLOTS, stream)
+        torch.cuda.synchronize()
+        r.counter.add_(1)
+    us = []
+    for j in range(min(a.copies, a.inputs)):
+        pair(cell, "full", j, j % SLOTS, stream)
+        torch.cuda.synchronize()
+        us.append(MA.lg_unique(r.scratch, a.rows, a.experts))
+        r.counter.add_(1)
+
+    def run_all(arm, st):
+        for j in range(a.launches):
+            pair(cell, arm, j, j % SLOTS, st)
+            if j % SLOTS == SLOTS - 1 and j != a.launches - 1:
+                r.counter.add_(1)
+        r.counter.add_(1)
+
+    graphs = {}
+    cs = torch.cuda.Stream()
+    for arm in names:
+        g = torch.cuda.CUDAGraph()
+        cs.wait_stream(stream)
+        with torch.cuda.stream(cs):
+            run_all(arm, cs)
+        torch.cuda.synchronize()
+        with torch.cuda.graph(g, stream=cs):
+            run_all(arm, cs)
+        torch.cuda.synchronize()
+        graphs[arm] = g
+    for _ in range(a.warmup):
+        for arm in names:
+            graphs[arm].replay()
+    torch.cuda.synchronize()
+    rng = random.Random(a.seed * 7919 + 13)
+    times = {arm: [] for arm in names}
+    ratios = {arm: [] for arm in names if arm not in ("full", "pre", "prenuma")}
+    mvn = {}
+    moe = {arm: [] for arm in names if arm not in ("full", "pre", "prenuma")}
+    for rnd in range(a.rounds):
+        order = list(names)
+        rng.shuffle(order)
+        cur = {}
+        for arm in order:
+            vals = []
+            for _ in range(a.reps):
+                e0, e1 = torch.cuda.Event(enable_timing=True), torch.cuda.Event(
+                    enable_timing=True
+                )
+                e0.record()
+                graphs[arm].replay()
+                e1.record()
+                torch.cuda.synchronize()
+                vals.append(e0.elapsed_time(e1) * 1e3 / a.launches)
+            cur[arm] = statistics.median(vals)
+            times[arm].append(cur[arm])
+        for arm, rs in ratios.items():
+            rs.append(cur[arm] / cur["full"])
+            pk = "prenuma" if arm in nl else "pre"
+            moe[arm].append((cur[arm] - cur[pk]) / (cur["full"] - cur["pre"]))
+            if "fullnuma" in cur and arm in nl:
+                mvn.setdefault(arm, []).append(
+                    (cur[arm] - cur["prenuma"]) / (cur["fullnuma"] - cur["prenuma"])
+                )
+    summ = {}
+    ctrl = ratios["full2"]
+    for arm, v in ratios.items():
+        med = statistics.median(v)
+        summ[arm] = {
+            "median": round(med, 4),
+            "min": round(min(v), 4),
+            "max": round(max(v), 4),
+            "below1": sum(x < 1 for x in v),
+            "rounds": len(v),
+            "win": bool(
+                arm != "full2"
+                and med < min(ctrl)
+                and sum(x < 1 for x in v) >= 0.75 * len(v)
+            ),
+            "moe_median": round(statistics.median(moe[arm]), 4),
+            "moe_min": round(min(moe[arm]), 4),
+            "moe_max": round(max(moe[arm]), 4),
+        }
+        if arm in mvn:
+            summ[arm]["moe_vs_numa_mono"] = round(statistics.median(mvn[arm]), 4)
+        if "fullnuma" in ratios and arm != "fullnuma":
+            rel = [x / y for x, y in zip(v, ratios["fullnuma"])]
+            summ[arm]["vs_numa_mono"] = round(statistics.median(rel), 4)
+    return {
+        "U_mean": statistics.mean(us) if us else None,
+        "ratio_vs_full": summ,
+        "us_per_launch": times,
+        "ratios": ratios,
+    }
+
+
+# ------------------------------------------------------------------ stamps (phase breakdown)
+
+
+def stamps(cell, arms):
+    """Eager stamped launches: per launch, the mono's / fused build's stage stamps (slot 0) and the fused
+    phase stamps; MoE increment = m5 end - m2 end; fused phases relative to m2 end (per CTA medians / max).
+    """
+    from atom.models.qwen4_exp_mono.q38_hook import _stamp_region
+
+    a = cell.a
+    r = cell.r
+    stream = torch.cuda.current_stream()
+    stages = K.STAGES[a.kind]
+    L = LY.for_rows(a.rows, a.seq)
+    names = ["full"] + [n for n, _ in arms if n != "full"]
+    out = {arm: {"moe_incr": [], "phases": []} for arm in names}
+    tick = timeline.TICK_US
+    for it in range(a.stamp_iters):
+        for arm in names:
+            j = it % a.copies
+            r.counter.add_(1)
+            torch.cuda.synchronize()
+            pair(cell, arm, j, 0, stream)
+            torch.cuda.synchronize()
+            reg = _stamp_region(r.scratch, a.rows)[0].cpu()
+            dec = timeline.decode(reg, stages, L)
+            if dec is None:
+                continue
+            st = dec["stages"]
+            m2e = st["m2"]["end"]
+            m5e = max(st[s]["end"] for s in ("m3", "m4", "m5") if st.get(s))
+            out[arm]["moe_incr"].append(m5e - m2e)
+            out[arm].setdefault("ends", []).append(
+                {s: st[s]["end"] - m2e for s in ("m3", "m4", "m5") if st.get(s)}
+            )
+            out[arm].setdefault("m2e", []).append(m2e)
+            out[arm].setdefault("total", []).append(dec.get("total"))
+            if arm.startswith("hyb:") and json.loads(arm[4:]).get("phase_stamps"):
+                S = reg.tolist()
+                t0 = min(row[0] for row in S if row[0])
+                m2_end_tick = t0 + m2e / tick
+                base = (MF.STAMP_OFF + LY.SC["ss"]) // 8
+                ph = (
+                    r.scratch.view(torch.int64)[base : base + A.GRID * MF.STAMP_PTS]
+                    .view(A.GRID, MF.STAMP_PTS)
+                    .cpu()
+                )
+                rel = (ph[:, : len(MF.PHASES)].double() - m2_end_tick) * tick
+                pd = {}
+                for i, p in enumerate(MF.PHASES):
+                    col = rel[:, i]
+                    col = col[ph[:, i] != 0]
+                    if col.numel():
+                        pd[p] = {
+                            "med": float(col.median()),
+                            "max": float(col.max()),
+                            "min": float(col.min()),
+                        }
+                out[arm]["phases"].append(pd)
+                if (
+                    it >= a.stamp_iters - 4
+                ):  # per-CTA rows (us past m2's end) and U of the last launches
+                    out[arm].setdefault("per_cta", []).append(
+                        {
+                            "U": MA.lg_unique(r.scratch, a.rows, a.experts),
+                            "rows": [
+                                [round(float(x), 3) for x in rel[c].tolist()]
+                                for c in range(A.GRID)
+                            ],
+                            "mono_moe_us": None,
+                        }
+                    )
+    res = {}
+    ref = (
+        statistics.median(out["full"]["moe_incr"]) if out["full"]["moe_incr"] else None
+    )
+    for arm, d in out.items():
+        e = {
+            "moe_incr_ratio": (
+                (statistics.median(d["moe_incr"]) / ref)
+                if ref and d["moe_incr"]
+                else None
+            ),
+            "n": len(d["moe_incr"]),
+        }
+        if d.get("m2e") and out["full"].get("m2e"):
+            e["m2_end_vs_mono"] = round(
+                statistics.median(d["m2e"]) / statistics.median(out["full"]["m2e"]), 4
+            )
+            tt = [x for x in d["total"] if x]
+            tf = [x for x in out["full"]["total"] if x]
+            if tt and tf:
+                e["layer_total_vs_mono"] = round(
+                    statistics.median(tt) / statistics.median(tf), 4
+                )
+        if d.get("ends") and ref:
+            e["stage_end_vs_mono_moe"] = {
+                s: round(statistics.median(x[s] for x in d["ends"] if s in x) / ref, 4)
+                for s in ("m3", "m4", "m5")
+            }
+        if d["phases"]:
+            agg = {}
+            for p in MF.PHASES:
+                vals = [x[p] for x in d["phases"] if p in x]
+                if vals and ref:
+                    agg[p] = {
+                        k: round(statistics.median(v[k] for v in vals) / ref, 4)
+                        for k in ("min", "med", "max")
+                    }
+            e["phases_vs_mono_moe"] = agg
+        res[arm] = e
+    return {
+        "stamps": res,
+        "raw": {k: v["moe_incr"] for k, v in out.items()},
+        "per_cta": {k: v["per_cta"] for k, v in out.items() if v.get("per_cta")},
+        "phases_raw": {k: v["phases"] for k, v in out.items() if v["phases"]},
+    }
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("mode", choices=("check", "bench", "stamps", "run"))
+    ap.add_argument("--kind", default="delta", choices=("delta", "delta_ple", "qsa"))
+    ap.add_argument("--rows", type=int, default=4)
+    ap.add_argument("--seq", type=int, default=-1)
+    ap.add_argument("--experts", type=int, default=512)
+    ap.add_argument("--stages", default="m3,m4,m5")
+    ap.add_argument("--routing", default="random", choices=("random", "real"))
+    ap.add_argument("--arms", default="hyb:{}")
+    ap.add_argument("--mutants", default="")
+    ap.add_argument("--copies", type=int, default=4)
+    ap.add_argument("--inputs", type=int, default=4)
+    ap.add_argument("--check-cases", type=int, default=4)
+    ap.add_argument("--context", type=int, default=2048)
+    ap.add_argument("--share-experts", action="store_true")
+    ap.add_argument("--launches", type=int, default=96)
+    ap.add_argument("--reps", type=int, default=3)
+    ap.add_argument("--rounds", type=int, default=20)
+    ap.add_argument("--warmup", type=int, default=3)
+    ap.add_argument("--stamp-iters", type=int, default=24)
+    ap.add_argument("--row-corr", type=float, default=0.0)
+    ap.add_argument("--force-u", type=int, default=0)
+    ap.add_argument("--inject", default="", choices=("", "same", "disjoint"))
+    ap.add_argument("--seed", type=int, default=0)
+    ap.add_argument(
+        "--step0",
+        type=int,
+        default=-1,
+        help="preset the step counter (check: cases follow it)",
+    )
+    ap.add_argument("--out")
+    ap.add_argument(
+        "--base", default="{}", help="FusedKnobs JSON under every hyb: / fs: arm"
+    )
+    a = ap.parse_args(argv)
+    BASE.update(json.loads(a.base))
+    a.seq = (a.rows > 1) if a.seq < 0 else bool(a.seq)
+    a.stamps = False
+    a.hyb_stages = "m3,m4,m5"
+    arms = parse_arms(a.arms)
+    mutants = parse_arms(a.mutants)
+    cell = MA.Cell(a)
+    numa_arms = any(n == "fullnuma" for n, _k in arms + mutants) or any(
+        SMF.knobs_from_json(dict(BASE, **(k or {}))).uses_area
+        for n, k in arms + mutants
+        if n.startswith("hyb:")
+    )
+    if (
+        numa_arms
+    ):  # the scratch's NUMA area (calibrated once): numa=1 builds and NUMA-area copies
+        from atom.models.qwen4_exp_mono.kernels import numa as NUMA
+
+        n = NUMA.scratch_bytes_needed() // 4
+        if cell.r.scratch.numel() < n:
+            cell.r.scratch = torch.zeros(n, dtype=torch.int32, device="cuda")
+        cal = NUMA.calibrate(cell.r.scratch)
+        print(
+            "[fused_ab] NUMA area calibrated: mask",
+            hex(cal[0]),
+            "agreement",
+            round(cal[1], 4),
+            flush=True,
+        )
+
+    if (
+        a.inject
+    ):  # real routing, reshaped: every row row 0's logits (U = 10) or row 0's rolled by 128 r experts
+        assert cell.real is not None, "--inject needs --routing real"
+        src = cell.real.clone()
+        for r in range(1, a.rows):
+            cell.real[:, r] = (
+                src[:, 0]
+                if a.inject == "same"
+                else torch.roll(src[:, 0], 64 * r, dims=-1)
+            )
+    if a.force_u:
+        force_u(cell, a.force_u)
+    info = add_arms(
+        cell, arms + mutants + ([("full2", None)] if a.mode == "bench" else [])
+    )
+    if a.step0 >= 0:  # after the builds (each advances the counter once)
+        cell.r.counter.fill_(a.step0)
+        torch.cuda.synchronize()
+    split_arms = [(n, k) for n, k in arms if n.startswith("rk:")]
+    if split_arms:
+        info.update(MA.add_rocke_arms(cell, split_arms))
+    out = {"args": vars(a), "kernels": info}
+    rc = 0
+    if a.mode == "check":
+        out.update(check(cell, arms, mutants))
+        rc = 0 if out["pass"] else 1
+        print("CHECK_PASS" if out["pass"] else "CHECK_FAIL", flush=True)
+    elif a.mode == "bench":
+        out.update(bench(cell, arms))
+        print(
+            "BENCH",
+            json.dumps(
+                {"U_mean": out["U_mean"], "ratio_vs_full": out["ratio_vs_full"]}
+            ),
+            flush=True,
+        )
+    elif a.mode == "stamps":
+        out.update(stamps(cell, arms))
+        print("STAMPS", json.dumps(out["stamps"]), flush=True)
+    else:
+        stream = torch.cuda.current_stream()
+        for arm, _k in arms:
+            for j in range(a.launches):
+                pair(cell, arm, j, j % SLOTS, stream)
+                if j % SLOTS == SLOTS - 1:
+                    cell.r.counter.add_(1)
+            torch.cuda.synchronize()
+            cell.r.counter.add_(1)
+    if a.out:
+        with open(a.out, "w") as f:
+            json.dump(out, f, indent=1)
+    return rc
+
+
+if __name__ == "__main__":
+    sys.exit(main())
