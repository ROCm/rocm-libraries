index 0000000000000000000000000000000000000000..41fa347d749c451beb0fc5719612a4a9c53a4b9a
--- /dev/null
+++ b/scripts/qwen38_rocke/common/server.sh
@@ -0,0 +1,70 @@
+# Sourced by the reproduction kit (inside the container): start / stop an ATOM server serving
+# Qwen3.8-Flash-Next from $MODEL exactly as scripts/qwen38_flash_mono/repro.sh's server_cmd does, and run
+# single_request_bench against it.
+#   q38_server_start <log> <decode mono|native> <K 0..3> [extra server args...]
+#   q38_server_stop
+#   q38_port            the port in use ($PORT, default 8000)
+# Env knobs: Q38_MAX_SEQS (4), Q38_MML (10240), Q38_GMU (0.9), Q38_SERVER_ENV (extra K=V, space separated).
+# The server starts in its own process group from $ATOM_ROOT (default /atom) and inherits the caller's
+# environment (ATOM_Q38_* knobs, PYTHONPATH with the rocKE library).
+
+q38_port() { echo "${PORT:=8000}"; }
+
+q38_server_start() {
+  local log=$1 decode=$2 k=$3
+  shift 3
+  local envs=(ATOM_RUNNER_INLINE_SEND=1)
+  rm -rf "${HOME:-/work/home}/.cache/atom"  # ATOM's compile cache must not outlive a source change
+  if [ "$decode" = mono ]; then envs+=(ATOM_MONO_ENABLE=1); else envs+=(ATOM_MONO_ENABLE=0); fi
+  local args=(--model "${MODEL:-/model}" --trust-remote-code -tp 1 --server-port "$(q38_port)"
+    --max-num-seqs "${Q38_MAX_SEQS:-4}" --max-model-len "${Q38_MML:-10240}"
+    --gpu-memory-utilization "${Q38_GMU:-0.9}" --hf-overrides '{"_multimodal_config": null}')
+  if [ "$k" != 0 ]; then
+    envs+=(ATOM_ENABLE_REPLAYSSM=0)
+    args+=(--method mtp --num-speculative-tokens "$k")
+  fi
+  # shellcheck disable=SC2206
+  envs+=(${Q38_SERVER_ENV:-})
+  echo "q38: server ${envs[*]} python -m atom.entrypoints.openai_server ${args[*]} $*"
+  (cd "${ATOM_ROOT:-/atom}" && exec setsid env "${envs[@]}" python -m atom.entrypoints.openai_server "${args[@]}" "$@") > "$log" 2>&1 &
+  Q38_SERVER_PID=$!
+  local t=0
+  until curl -sf "http://127.0.0.1:$(q38_port)/v1/models" > /dev/null; do
+    if ! kill -0 "$Q38_SERVER_PID" 2> /dev/null; then
+      tail -n 40 "$log"
+      echo "q38: server exited"
+      Q38_SERVER_PID=
+      return 1
+    fi
+    if [ $t -ge 5400 ]; then
+      tail -n 40 "$log"
+      echo "q38: server not ready after 90 min"
+      q38_server_stop
+      return 1
+    fi
+    sleep 10
+    t=$((t + 10))
+  done
+  grep -ao 'Qwen3.8 mono [a-z]* o[nf]*[^[]*' "$log" | sort -u | sed 's/^/q38: /' || true
+  echo "q38: server ready after ${t}s on port $(q38_port)"
+}
+
+q38_server_stop() {
+  [ -n "${Q38_SERVER_PID:-}" ] || return 0
+  # setsid: the server leads its own process group (engine core and model runner children too)
+  kill -- -"$Q38_SERVER_PID" 2> /dev/null || kill "$Q38_SERVER_PID" 2> /dev/null || true
+  for _ in $(seq 1 60); do kill -0 "$Q38_SERVER_PID" 2> /dev/null || break; sleep 2; done
+  kill -9 -- -"$Q38_SERVER_PID" 2> /dev/null || true
+  sleep 5
+  Q38_SERVER_PID=
+}
+
+# single_request_bench on the running server (repro.sh speed's client and settings):
+#   q38_speed <out.json> <dataset> <prompts> <max_tokens> [extra...]
+q38_speed() {
+  local out=$1 set=$2 n=$3 mt=$4
+  shift 4
+  python -m atom.benchmarks.qwen38_flash_mono.single_request_bench --base-url "http://127.0.0.1:$(q38_port)" \
+    --model "${MODEL:-/model}" --dataset "$set" --num-prompts "$n" --max-tokens "$mt" \
+    --chat-template-kwargs '{"reasoning_effort": "xhigh"}' --out "$out" "$@"
+}
diff --git a/scripts/qwen38_rocke/e2e/combo_numa.py b/scripts/qwen38_rocke/e2e/combo_numa.py
new file mode 100644
index 0000000000000000000000000000000000000000..0cdba5b547d5ab2c7769008d5445c3a5ea2bed73
--- /dev/null
+++ b/scripts/qwen38_rocke/e2e/combo_numa.py
@@ -0,0 +1,143 @@
+"""Numerics gate of the COMPOSED serving settings on one DeltaNet layer (gfx950, in the repro container), on
+top of the schedule lever: ATOM's own ``build_layer`` under ``ATOM_Q38_SCHED=best`` and
+``ATOM_Q38_EXTERN_STAGES`` (+ ``ATOM_Q38_EXTERN_MISSING=mono``) with the files of the kit's gen step, against the PLAIN
+mono layer of the same rig (gdn-b3's ``Insitu``):
+
+    N    the lever alone (no extern stage)
+    NF   + fused MoE   (m3/m4/m5 = <moe>/<stage>_{variant}.ll, numa=1 bodies)
+    NFB  + rocKE B3    (b3 / b3pre = <b3>, numa=1 bodies)
+
+Every arm: the numa lever must stay ON for the build (ATOM's own rule recomputed: every linked function numa1),
+compared on its logical view (copy 0 of the NUMA area; copy 1 == copy 0), bitwise on the scratch outside B3's
+private exchange and rows 0..3's ``ss`` (the fused body's private ys / stamps), the layer output and every state
+pool, deterministic, nonzero output. The fused body's own gate_up -> down exchange (``dn``) stays in the PLAIN
+scratch for sets with ``xchg_home="single"`` (BEST_KNOBS rows > 1; unused by a numa=1 layer otherwise): its
+logical view takes ``dn`` from there (as moe-fused ``fused_ab.logical``). Prints one ``COMBO {json}`` line per (variant, arm), then PASS / FAIL.
+
+    python combo_numa.py --fns DIR [--variants r1,...] [--sched best]
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.join(HERE, "..", "gdn-b3"))
+sys.path.insert(0, os.path.join(HERE, "..", "harness"))
+
+from insitu_b3 import Insitu, diff
+
+from atom.models.qwen4_exp_mono.kernels import extern_stages as X
+from atom.models.qwen4_exp_mono.kernels import kernel as K
+from atom.models.qwen4_exp_mono.kernels import layout as LY
+from atom.models.qwen4_exp_mono.kernels import sched as SCH
+
+
+def specs(fns):
+    moe = ",".join(f"{s}={fns}/moe/{s}_{{variant}}.ll" for s in ("m3", "m4", "m5"))
+    b3 = f"b3={fns}/b3,b3pre={fns}/b3"
+    return {"N": "", "NF": moe, "NFB": f"{moe},{b3}"}
+
+
+def plain_regions(linked, rows):
+    """Regions a linked numa=1 fused MoE keeps in the plain scratch (``FusedCtx.in_area``)."""
+    if "m3" not in {e.stage for e in linked}:
+        return []
+    from kernels.gfx950.qwen38_mono import stage_moe_fused as SMF
+
+    fk = SMF.best_knobs(rows)
+    out = [] if fk.xchg_home == "numa2" else ["dn"]
+    if fk.lg_copy != "numa2" and not fk.numa:
+        out += ["lg", "sg"]
+    return out
+
+
+def mask_ss(t):
+    t = t.clone()
+    lo, n = LY.SC["ss"] // 4, LY.REGIONS["ss"] * 2
+    for row in range(LY.MAX_ROWS):
+        b0 = row * LY.SCRATCH_BYTES // 4 + lo
+        t[b0 : b0 + n] = 0
+    return t
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--fns", required=True)
+    ap.add_argument("--variants", default="r1,r2,r3,r4,r2s,r3s,r4s,r4g2")
+    ap.add_argument("--sched", default="best")
+    a = ap.parse_args()
+    ok = True
+    os.environ["ATOM_Q38_EXTERN_MISSING"] = "mono"
+    for v in a.variants.split(","):
+        os.environ.pop(X.ENV, None)
+        ins = Insitu(v, copies=2, launches=2, sched=a.sched)
+        for arm, spec in specs(a.fns).items():
+            if spec:
+                os.environ[X.ENV] = spec
+            else:
+                os.environ.pop(X.ENV, None)
+            os.environ[SCH.ENV_SCHED] = a.sched
+            try:
+                build = K.build_layer(
+                    ins.stages, ins.experts, ins.rows, ins.seq, ins.group
+                )
+                ext = X.resolve(
+                    tuple(ins.stages),
+                    ins.rows,
+                    ins.seq,
+                    ins.group,
+                    K.LAYER_ARGS,
+                    K._ALL_STAGES,
+                )
+                sk = SCH.resolve(False, ins.rows, ins.seq, ins.group, tuple(ins.stages))
+                lv = SCH.from_knobs(sk).levers
+                kept = bool(lv.get("numa")) and X.numa_kept(ext, lv)
+            finally:
+                os.environ.pop(SCH.ENV_SCHED, None)
+                os.environ.pop(X.ENV, None)
+            got = ins.run_once(build)
+            again = ins.run_once(build)
+            same = True
+            plain = plain_regions(ext, ins.rows) if kept else []
+            if kept:
+                raw, raw2 = got["scratch"], again["scratch"]
+                got, same = ins.logical(got)
+                again, _ = ins.logical(again)
+                for nm in plain:
+                    for row in range(LY.MAX_ROWS):
+                        b0 = (LY.SC[nm] + row * LY.SCRATCH_BYTES) // 4
+                        n = 2 * LY.REGIONS[nm]
+                        got["scratch"][b0 : b0 + n] = raw[b0 : b0 + n]
+                        again["scratch"][b0 : b0 + n] = raw2[b0 : b0 + n]
+            ref = dict(ins.ref, scratch=mask_ss(ins.ref["scratch"]))
+            got = dict(got, scratch=mask_ss(got["scratch"]))
+            again = dict(again, scratch=mask_ss(again["scratch"]))
+            dd = {
+                k: x for k, x in ((k, diff(ref[k], got[k], k)) for k in ins.live) if x
+            }
+            det = all(diff(got[k], again[k], k) is None for k in ins.live)
+            nz = bool((got["h_out"] != 0).any())
+            res = {"variant": v, "arm": arm, "linked": [[e.stage, e.mailboxes] for e in ext], "numa_kept": kept,
+                   "levers": lv, "bitwise": not dd, "deterministic": det, "out_nonzero": nz,
+                   "numa_copies_equal": same, "plain_regions": plain, "diff": dd}  # fmt: skip
+            good = res["bitwise"] and det and nz and same and kept
+            if (
+                arm != "N"
+            ):  # grouped builds: no fused MoE file (FlyDSL MoE), the B3 only
+                want = {"m3", "m4", "m5"} if "g" not in v else set()
+                if arm == "NFB":
+                    want.add("b3")
+                good &= want <= {e.stage for e in ext} and bool(ext) == bool(want)
+            ok &= good
+            print("COMBO", json.dumps(res), flush=True)
+        ins.free()
+    print("COMBO", "PASS" if ok else "FAIL", flush=True)
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/qwen38_rocke/e2e/e2e.sh b/scripts/qwen38_rocke/e2e/e2e.sh
new file mode 100755
index 0000000000000000000000000000000000000000..7ca5236927c6559caa6e7f783b6350dc3d7e6763
--- /dev/null
+++ b/scripts/qwen38_rocke/e2e/e2e.sh
@@ -0,0 +1,64 @@
+#!/usr/bin/env bash
+# Served end-to-end A/B of the rocKE + schedule stack against plain mono (inside the container; called by
+# ../repro_rocke_mono.sh quick / full). One server at a time on one GPU; arms (any subset, ARMS):
+#   A    plain mono                       M    plain mono again (A-vs-A timing control)
+#   N    mono + ATOM_Q38_SCHED=best (NUMA dual-copy mailboxes + the stage holds)
+#   NF   N + fused MoE (stage_moe_fused --knobs best, numa=1 bodies: m3 fused, m4 / m5 empty)
+#   NFB  NF + rocKE B3 (stage_b3 --knobs tuned_numa, numa=1 bodies, b3 + b3pre)
+#   ALL  NFB + rocKE lm_head (ATOM_Q38_ROCKE_HEAD=1)
+# Every extern arm runs with ATOM_Q38_EXTERN_MISSING=mono (grouped / wide builds keep FlyDSL, logged).
+# Per K in KS, PAIRS pairs. ORDER=shuffle: the arm order is a seeded permutation per K rotated by one per pair
+# (PAIRS = number of arms: every arm takes every position once); ORDER=fixed: the ARMS order every pair (back to
+# back). Logged in order.txt. Workload: single_request_bench gsm8k PROMPTS x TOKENS (greedy, reasoning xhigh)
+# after a 2 x 64 warm run.
+# summarize.py writes abs.json (absolute) and ratios.json (ratios only) into OUT and checks every server log:
+# the extern stages resolved per (kind, variant) build and the numa lever ON for every narrow build of
+# N / NF / NFB / ALL ([ATOM_Q38_SCHED] build lines; no "numa off" line), 0 tracebacks, rocKE lm_head on iff ALL.
+#   e2e.sh <fns dir (b3/, moe/)> <out dir>
+set -uo pipefail
+KIT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+FN=${1:?fns dir} O=${2:?out dir}
+source "$KIT/common/server.sh"
+trap q38_server_stop EXIT  # never leave a server running (it leads its own process group)
+trap 'exit 130' INT TERM
+mkdir -p "$O"
+for f in "$FN/moe/m3_r4s.ll" "$FN/b3/b3_r4s.ll"; do [ -f "$f" ] || { echo "e2e: missing $f (run the gen step)"; exit 1; }; done
+SB="b3=$FN/b3,b3pre=$FN/b3"
+SF="m3=$FN/moe/m3_{variant}.ll,m4=$FN/moe/m4_{variant}.ll,m5=$FN/moe/m5_{variant}.ll"
+declare -A ENVS
+ENVS[A]=""
+ENVS[M]=""
+ENVS[N]="ATOM_Q38_SCHED=best"
+ENVS[NF]="ATOM_Q38_SCHED=best ATOM_Q38_EXTERN_STAGES=$SF ATOM_Q38_EXTERN_MISSING=mono"
+ENVS[NFB]="ATOM_Q38_SCHED=best ATOM_Q38_EXTERN_STAGES=$SF,$SB ATOM_Q38_EXTERN_MISSING=mono"
+ENVS[ALL]="ATOM_Q38_SCHED=best ATOM_Q38_ROCKE_HEAD=1 ATOM_Q38_EXTERN_STAGES=$SF,$SB ATOM_Q38_EXTERN_MISSING=mono"
+read -ra names <<< "${ARMS:-A M N NF NFB ALL}"
+for n in "${names[@]}"; do
+  [ -n "${ENVS[$n]+x}" ] || { echo "e2e: unknown arm $n"; exit 2; }
+  echo "  $n: ${ENVS[$n]:-plain mono}"
+done | tee "$O/arms.txt"
+rc=0
+for K in ${KS:-3 0}; do
+  for p in $(seq 1 "${PAIRS:-6}"); do
+    if [ "${ORDER:-shuffle}" = fixed ]; then
+      order=("${names[@]}")
+    else
+      read -ra order <<< "$(python -c "import random,sys; a=sys.argv[3:]; random.Random(1000*int(sys.argv[1])+7).shuffle(a); p=(int(sys.argv[2])-1)%len(a); print(*(a[p:]+a[:p]))" "$K" "$p" "${names[@]}")"
+    fi
+    echo "k$K pair $p order: ${order[*]}" | tee -a "$O/order.txt"
+    for arm in "${order[@]}"; do
+      tag=k${K}_${p}_$arm
+      echo "--- $tag $(date -u +%H:%M:%S)"
+      Q38_SERVER_ENV="${ENVS[$arm]}" q38_server_start "$O/$tag.server.log" mono "$K" || { rc=1; echo "$tag: SERVER FAILED"; continue; }
+      q38_speed "$O/$tag.warm.json" gsm8k 2 64 --warmup 0 > /dev/null 2>&1
+      q38_speed "$O/$tag.json" gsm8k "${PROMPTS:-96}" "${TOKENS:-2048}" --warmup 0 > "$O/$tag.log" 2>&1 || { rc=1; echo "$tag: bench failed"; }
+      q38_server_stop
+      echo "$tag tracebacks: $(grep -a -c Traceback "$O/$tag.server.log")  numa-off lines: $(grep -a -c 'numa off for' "$O/$tag.server.log")"
+      grep -a -o "scratch calibrated: [^[]*" "$O/$tag.server.log" | head -1 | cut -c1-120
+      grep -a -o "rocKE lm_head on: [^[]*" "$O/$tag.server.log" | head -1 | cut -c1-120
+      grep -a -o "\[ATOM_Q38_SCHED\] build [a-z_]* [a-z0-9]*: [^|]*\(| extern [a-z0-9: ]*\)\?" "$O/$tag.server.log" | sort -u | cut -c1-200
+    done
+  done
+done
+python "$KIT/e2e/summarize.py" "$O" "$FN" "${PAIRS:-6}" "${KS:-3 0}" "${names[*]}" || rc=1
+exit $rc
diff --git a/scripts/qwen38_rocke/e2e/summarize.py b/scripts/qwen38_rocke/e2e/summarize.py
new file mode 100644
index 0000000000000000000000000000000000000000..d79fe03cee3426a6c1539dcfd71ae5e651233825
--- /dev/null
+++ b/scripts/qwen38_rocke/e2e/summarize.py
@@ -0,0 +1,307 @@
+"""Served A/B summary (e2e.sh): python summarize.py <e2e dir> <fns dir> <pairs> "<Ks>" "<arm names>"
+
+Writes <e2e dir>/abs.json (per run: absolute speeds) and <e2e dir>/ratios.json (ratios only, gsm8k
+counts, server-log checks). Ratios per pair X/A (same pair index):
+  round      ms per verify round X / A                       (K > 0; < 1 faster)
+  token      time per decoded token X / A = A tok/s / X tok/s (token weighted; < 1 faster)
+  req_speed  per-request mean decode tok/s X / A             (> 1 faster)
+  acc        acceptance length X / A                         (K > 0)
+Incremental (per pair, same metrics): NF / N (the fused MoE on the lever), NFB / NF (the B3), ALL / NFB (the head),
+N / A (the lever alone).
+Server-log checks per run (arms: A, M plain; N = ATOM_Q38_SCHED=best; NF + fused MoE; NFB + B3; ALL + head):
+  - mono decode on, 0 tracebacks, rocKE lm_head on iff ALL;
+  - every "[ATOM_Q38_SCHED] build <kind> <variant>: <levers> | extern <stage:layout ...>" line (one per build):
+    plain arms have none; lever arms: every narrow build (rows <= 4) has numa=1 (wide builds: no numa, by
+    design), no "numa off for" line (a dropped lever), the NUMA calibration line present;
+  - the extern stages per build: NF / NFB / ALL link m3 m4 m5 (numa1) in every narrow ungrouped build whose
+    variant has a fused file; NFB / ALL also b3 (+ b3pre where generated) in every delta / delta_ple narrow
+    build with a b3 file (qsa builds: no b3); nothing else, every linked function numa1;
+  - the served variant (K=3: r4s verify; K=0: r1 decode) resolved (the extern lines) exactly as expected.
+Prints a per-run table (absolute tok/s, ms per verify round, acceptance, gsm8k right: the run's own numbers) and
+the ratios; exits 1 when a run is missing or a server-log check failed. Arm A (plain mono) must be in the set.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+import statistics
+import sys
+
+o, fns, npairs, ks, names = (
+    sys.argv[1],
+    sys.argv[2],
+    int(sys.argv[3]),
+    sys.argv[4].split(),
+    sys.argv[5].split(),
+)
+EXT = re.compile(
+    r"\[ATOM_Q38_EXTERN_STAGES\] ([a-z0-9]+) ([a-z0-9]+): ([a-z0-9_]+) from (\S+)"
+)
+BUILD = re.compile(r"\[ATOM_Q38_SCHED\] build ([a-z_]+) (r\d+s?(?:g\d+)?): ([^|\r\n]*?)(?: \| extern ((?:[a-z0-9]+:[a-z0-9]+ ?)+))?\s*$",
+                   re.MULTILINE)  # fmt: skip
+LEVER_ARMS = {"N", "NF", "NFB", "ALL"}
+HAS_F = {"NF", "NFB", "ALL"}
+HAS_B = {"NFB", "ALL"}
+HAS_HEAD = {"ALL"}
+MAX_ROWS = 4
+
+
+def served(k):
+    return "r1" if k == "0" else f"r{int(k) + 1}s"
+
+
+def rows_of(v):
+    return int(re.match(r"r(\d+)", v).group(1))
+
+
+def expected_externs(arm, kind, v):
+    """{(stage, layout)} a (kind, variant) build of ``arm`` must link."""
+    exp = set()
+    narrow = rows_of(v) <= MAX_ROWS
+    if (
+        arm in HAS_F
+        and narrow
+        and "g" not in v
+        and os.path.exists(f"{fns}/moe/m3_{v}.ll")
+    ):
+        exp |= {("m3", "numa1"), ("m4", "numa1"), ("m5", "numa1")}
+    if (
+        arm in HAS_B
+        and kind in ("delta", "delta_ple")
+        and os.path.exists(f"{fns}/b3/b3_{v}.ll")
+    ):
+        exp.add(("b3", "numa1"))
+        if os.path.exists(f"{fns}/b3/b3pre_{v}.ll"):
+            exp.add(("b3pre", "numa1"))
+    return exp
+
+
+def expected_served(arm, v):
+    exp = set()
+    if arm in HAS_B and os.path.exists(f"{fns}/b3/b3_{v}.ll"):
+        exp.add(("b3", v, f"b3_{v}.ll"))
+        if os.path.exists(f"{fns}/b3/b3pre_{v}.ll"):
+            exp.add(("b3pre", v, f"b3pre_{v}.ll"))
+    if arm in HAS_F:
+        for s in ("m3", "m4", "m5"):
+            if os.path.exists(f"{fns}/moe/{s}_{v}.ll"):
+                exp.add((s, v, f"{s}_{v}.ll"))
+    return exp
+
+
+def logcheck(k, arm, i):
+    path = f"{o}/k{k}_{i}_{arm}.server.log"
+    if not os.path.exists(path):
+        return {"ok": False, "why": "no server log"}
+    with open(path, errors="replace") as f:
+        txt = f.read().replace("\r", "\n")
+    found = {(m[0], m[1], os.path.basename(m[3])) for m in EXT.findall(txt)}
+    v = served(k)
+    got_v = {x for x in found if x[1] == v}
+    exp_v = expected_served(arm, v)
+    head = "rocKE lm_head on" in txt
+    builds = {}
+    for kind, var, lev, ext in BUILD.findall(txt):
+        ex = {tuple(x.split(":")) for x in ext.split()} if ext else set()
+        builds.setdefault((kind, var), set()).add((lev.strip(), frozenset(ex)))
+    bad_builds = []
+    narrow_builds = 0
+    for (kind, var), seen in sorted(builds.items()):
+        for lev, ex in seen:
+            items = dict(x.split("=") for x in lev.split() if "=" in x)
+            want_numa = arm in LEVER_ARMS and rows_of(var) <= MAX_ROWS
+            narrow_builds += rows_of(var) <= MAX_ROWS
+            if (items.get("numa") == "1") != want_numa:
+                bad_builds.append(
+                    f"{kind} {var}: numa={items.get('numa')} (want {'1' if want_numa else 'none'})"
+                )
+            want_ext = expected_externs(arm, kind, var)
+            if set(ex) != want_ext:
+                bad_builds.append(
+                    f"{kind} {var}: extern {sorted(ex)} != {sorted(want_ext)}"
+                )
+    numa_off = len(re.findall(r"numa off for", txt))
+    cal = re.findall(
+        r"scratch calibrated: page mask (0x[0-9a-f]+), bit-13 rule agreement ([0-9.]+)",
+        txt,
+    )
+    r = {
+        "mono_on": "Qwen3.8 mono decode on" in txt,
+        "tracebacks": txt.count("Traceback"),
+        "head_on": head,
+        "head_ok": head == (arm in HAS_HEAD),
+        "served_variant": v,
+        "extern_served": sorted("/".join(x) for x in got_v),
+        "extern_served_expected": sorted("/".join(x) for x in exp_v),
+        "extern_served_ok": got_v == exp_v,
+        "builds": {
+            f"{kd} {vr}": sorted(
+                f"{lv} | {' '.join(':'.join(e) for e in sorted(ex))}" for lv, ex in s
+            )
+            for (kd, vr), s in sorted(builds.items())
+        },
+        "narrow_builds": narrow_builds,
+        "bad_builds": bad_builds,
+        "numa_off_lines": numa_off,
+        "numa_calibrations": [[m, float(a)] for m, a in cal],
+        "missing_lines": len(re.findall(r"\[ATOM_Q38_EXTERN_STAGES\] no ", txt)),
+    }
+    lever_ok = (not bad_builds and numa_off == 0 and (narrow_builds > 0 and len(cal) > 0)
+                if arm in LEVER_ARMS else not builds and not cal and not found)  # fmt: skip
+    r["lever_ok"] = lever_ok
+    r["ok"] = (
+        r["mono_on"]
+        and r["tracebacks"] == 0
+        and r["head_ok"]
+        and r["extern_served_ok"]
+        and lever_ok
+    )
+    return r
+
+
+def load(k, arm, i):
+    try:
+        with open(f"{o}/k{k}_{i}_{arm}.json") as f:
+            return json.load(f)
+    except (OSError, ValueError):
+        return None
+
+
+def stats(xs):
+    xs = [x for x in xs if x is not None]
+    if not xs:
+        return None
+    return {"per_pair": [round(x, 5) for x in xs], "mean": round(statistics.mean(xs), 5),
+            "median": round(statistics.median(xs), 5),
+            "stdev": round(statistics.stdev(xs), 5) if len(xs) > 1 else None,
+            "min": round(min(xs), 5), "max": round(max(xs), 5), "n": len(xs)}  # fmt: skip
+
+
+absout, ratout = {}, {}
+for k in ks:
+    a_abs, r_cell = {}, {"served_variant": served(k)}
+    checks = {}
+    for arm in names:
+        runs = []
+        for i in range(1, npairs + 1):
+            d = load(k, arm, i)
+            s = (d or {}).get("summary", {})
+            tw = s.get("decode_tok_s_token_weighted")
+            runs.append({
+                "pair": i, "ok": d is not None,
+                "decode_tok_s_token_weighted": tw,
+                "decode_tok_s_per_request_mean": s.get("decode_tok_s_per_request_mean"),
+                "decode_tok_s_per_request_median": s.get("decode_tok_s_per_request_median"),
+                "ms_per_token": 1000 / tw if tw else None,
+                "ms_per_round": s.get("ms_per_round"),
+                "acceptance": s.get("acceptance"),
+                "end_to_end_tok_s": s.get("end_to_end_tok_s"),
+                "mean_output_tokens": s.get("mean_output_tokens"),
+                "at_cap": s.get("at_cap"),
+                "correct": s.get("correct"), "checked": s.get("checked"),
+            })  # fmt: skip
+            checks[f"{arm}{i}"] = logcheck(k, arm, i)
+        a_abs[arm] = runs
+    absout[f"k{k}"] = a_abs
+
+    def val(arm, i, metric, a_abs=a_abs):
+        x = a_abs[arm][i]
+        if not x["ok"]:
+            return None
+        return {"round": x["ms_per_round"], "token": (1 / x["decode_tok_s_token_weighted"]) if x["decode_tok_s_token_weighted"] else None,
+                "req_speed": x["decode_tok_s_per_request_mean"], "acc": x["acceptance"],
+                "e2e_wall": (1 / x["end_to_end_tok_s"]) if x["end_to_end_tok_s"] else None}[metric]  # fmt: skip
+
+    def ratio(arm, i, metric, ref="A"):
+        x, a = val(arm, i, metric), val(ref, i, metric)
+        return x / a if x and a else None
+
+    metrics = (
+        ["round", "token", "req_speed", "acc", "e2e_wall"]
+        if k != "0"
+        else ["token", "req_speed", "e2e_wall"]
+    )
+    prim = "round" if k != "0" else "token"
+    for arm in names:
+        cell = {"gsm8k_correct_per_run": [x["correct"] for x in a_abs[arm]],
+                "gsm8k_correct_total": sum(x["correct"] or 0 for x in a_abs[arm]),
+                "gsm8k_checked_total": sum(x["checked"] or 0 for x in a_abs[arm]),
+                "at_cap_total": sum(x["at_cap"] or 0 for x in a_abs[arm]),
+                "log_checks_ok": all(checks[f"{arm}{i}"]["ok"] for i in range(1, npairs + 1)),
+                "tracebacks": sum(checks[f"{arm}{i}"].get("tracebacks", 0) for i in range(1, npairs + 1))}  # fmt: skip
+        if arm != "A":
+            for m in metrics:
+                cell[m] = stats([ratio(arm, i, m) for i in range(npairs)])
+        r_cell[arm] = cell
+    inc = {}
+    for x, y in (
+        ("N", "A"),
+        ("NF", "N"),
+        ("NFB", "NF"),
+        ("ALL", "NFB"),
+        ("NFB", "N"),
+        ("ALL", "N"),
+    ):
+        if x in names and y in names:
+            inc[f"{x}/{y}"] = {
+                m: stats([ratio(x, i, m, y) for i in range(npairs)]) for m in metrics
+            }
+    r_cell["incremental"] = inc
+    if "M" in names:
+        r_cell["control_spread"] = {
+            m: stats([ratio("M", i, m) for i in range(npairs)]) for m in metrics
+        }
+    r_cell["log_checks"] = checks
+    ratout[f"k{k}"] = r_cell
+    order = os.path.join(o, "order.txt")
+    if os.path.exists(order):
+        with open(order) as f:
+            r_cell["orders"] = [ln.strip() for ln in f if ln.startswith(f"k{k} ")]
+
+with open(f"{o}/abs.json", "w") as f:
+    json.dump(absout, f, indent=1)
+with open(f"{o}/ratios.json", "w") as f:
+    json.dump(ratout, f, indent=1)
+brief = {k: {a: ({m: (c.get(m) or {}).get("mean") for m in ("round", "token", "req_speed", "acc")}
+                 | {"correct": c["gsm8k_correct_total"], "logs_ok": c["log_checks_ok"]})
+             for a, c in v.items() if isinstance(c, dict) and "gsm8k_correct_total" in c}
+         | {"incremental": {n: {m: (s or {}).get("mean") for m, s in d.items()} for n, d in v["incremental"].items()}}
+         for k, v in ratout.items()}  # fmt: skip
+print(json.dumps(brief, indent=1))
+bad = [f"{k}:{n}: {c.get('bad_builds') or c.get('why') or ''}" for k, v in ratout.items() for n, c in v["log_checks"].items()
+       if not c["ok"]]  # fmt: skip
+print("LOG CHECK FAILURES:", bad or "none")
+missing = [
+    f"{k}:{a}{x['pair']}"
+    for k, v in absout.items()
+    for a, runs in v.items()
+    for x in runs
+    if not x["ok"]
+]
+print("MISSING RUNS:", missing or "none")
+for k, v in absout.items():
+    print()
+    print(
+        f"{k}: per run (pair, arm): req tok/s mean | ms/round | acceptance | gsm8k right"
+    )
+    for i in range(npairs):
+        for arm in names:
+            x = v[arm][i]
+            f = lambda y, d=2: "-" if y is None else f"{y:.{d}f}"
+            print(
+                f"  {i + 1} {arm:<4} {f(x['decode_tok_s_per_request_mean'], 1):>8} | {f(x['ms_per_round']):>7} |"
+                f" {f(x['acceptance']):>5} | {x['correct']}/{x['checked']}"
+            )
+    print(f"{k}: ratios X/A per pair (round < 1 faster; req_speed > 1 faster)")
+    for arm, c in ratout[k].items():
+        if not isinstance(c, dict) or "gsm8k_correct_total" not in c or arm == "A":
+            continue
+        for m in ("round", "req_speed", "acc", "token"):
+            s = c.get(m)
+            if s:
+                print(
+                    f"  {arm:<4} {m:<9} mean {s['mean']:.4f}  per pair {' '.join(f'{x:.4f}' for x in s['per_pair'])}"
+                )
+sys.exit(1 if bad or missing else 0)
