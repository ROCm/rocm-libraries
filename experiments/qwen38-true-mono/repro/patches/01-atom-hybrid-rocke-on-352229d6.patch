+
+    def logical(self):
+        """The plain build's address of the region (blame side copies)."""
+        return fx.Int64(self.scratch) + fx.Int64(self.off)
+
+
+def _x(box, byte_off):
+    """Area copy-0 byte offset of byte ``byte_off`` (Int32 or int) of ``box``'s region."""
+    x = fx.Int32(byte_off) + box.off
+    return x + (x & -CHUNK)
+
+
+def store(box, byte_off, data, cm=CM_DEV):
+    """Both copies of a pair store (``data``: an int32 vector) at ``byte_off``."""
+    xi = _x(box, byte_off)
+    r = rsrc(box.base())
+    bo.buffer_store(data, r, xi >> 2, cache_modifier=cm)
+    bo.buffer_store(data, r, (xi + CHUNK) >> 2, cache_modifier=cm)
+
+
+def load(box, byte_off, n_words, cm=CM_DEV):
+    """The copy homed at this CTA's IOD (the header's page mask) of ``n_words``
+    int32 words at ``byte_off``."""
+    xi = _x(box, byte_off)
+    if (
+        box.state.mode == 2
+    ):  # ablation: always copy 0 (the layout without the IOD choice)
+        off = xi
+    else:
+        # ``sel_mask`` bit p: the copy homed at this CTA's IOD on page p (the
+        # page mask with the IOD folded in at entry: one SGPR held, not two)
+        sel = (box.state.sel_mask >> (xi >> 21)) & 1
+        off = xi + (sel << 13)
+    return bo.buffer_load(
+        rsrc(box.base()), off >> 2, vec_width=n_words, dtype=T.i32, cache_modifier=cm
+    )
+
+
+def entry_state(scratch, mode=1):
+    """Kernel entry of a ``numa`` build: the header's page mask (scalar load)
+    and this CTA's IOD. ``mode`` (the lever's value): 1 polls the local copy;
+    ablations: 2 always copy 0, 3 the remote copy."""
+    from types import SimpleNamespace
+
+    if mode == 2:
+        return SimpleNamespace(sel_mask=None, mode=2)
+    hdr = bo.create_buffer_resource_from_addr(
+        fx.Int64(scratch) + fx.Int64(header_offset())
+    )
+    mask = fx.Int32(bo.buffer_load(hdr, 0, vec_width=1, is_scalar=True))
+    # copy on page p = mask_p ^ iod (mode 3, the ablation: the REMOTE copy,
+    # mask_p ^ iod ^ 1): fold the IOD into the mask as all-ones / zero
+    flip = iod_id() if mode != 3 else iod_id() ^ 1
+    return SimpleNamespace(sel_mask=mask ^ (fx.Int32(0) - flip), mode=mode)
+
+
+# ------------------------------------------------------------- calibration (host)
+
+
+def _nop():
+    llvm.InlineAsmOp(None, [], "s_nop 0", "", has_side_effects=True)
+
+
+def _ld(r):
+    return fx.Int32(
+        bo.buffer_load(r, 0, vec_width=1, dtype=T.i32, cache_modifier=CM_DEV)
+    )
+
+
+def _st(r, v):
+    bo.buffer_store(fx.Int32(v), r, 0, cache_modifier=CM_DEV)
+
+
+def _ping_body(r, iters):
+    """Side A: put 2k + 1, wait for 2k + 2."""
+    k = fx.Int32(0)
+    while k < iters:
+        _st(r, 2 * k + 1)
+        v = _ld(r)
+        while v != 2 * k + 2:
+            _nop()
+            v = _ld(r)
+        k = k + 1
+
+
+def _pong_body(r, iters):
+    """Side B: wait for 2k + 1, put 2k + 2."""
+    k = fx.Int32(0)
+    while k < iters:
+        v = _ld(r)
+        while v != 2 * k + 1:
+            _nop()
+            v = _ld(r)
+        _st(r, 2 * k + 2)
+        k = k + 1
+
+
+def _pingpong_body(area, out, first, nblk, iters, pair):
+    from atom.models.qwen4_exp_mono.kernels import stamps
+
+    bid = fx.Int32(fx.block_idx.x)
+    tid = fx.thread_idx.x
+    if bid == pair:
+        j = fx.Int32(0)
+        while j < nblk:
+            r = rsrc(area + fx.Int64(first + j) * CHUNK)
+            t0 = stamps.memrealtime()
+            _ping(r, iters)
+            t1 = stamps.memrealtime()
+            if tid == 0:
+                dt = fx.Vector.from_elements([t1 - t0], fx.Int64).bitcast(fx.Int32)[0]
+                bo.buffer_store(dt, rsrc(out), first + j)
+            j = j + 1
+        if tid == 0:
+            bo.buffer_store(xcc_id(), rsrc(out), PP_SLOTS)
+    if bid == pair + 8:
+        j = fx.Int32(0)
+        while j < nblk:
+            r = rsrc(area + fx.Int64(first + j) * CHUNK)
+            _pong(r, iters)
+            j = j + 1
+        if tid == 0:
+            bo.buffer_store(xcc_id(), rsrc(out), PP_SLOTS + 1)
+
+
+_ping = ASTRewriter.transform(_ping_body)
+_pong = ASTRewriter.transform(_pong_body)
+
+
+@functools.cache
+def _pingpong_launcher():
+    # (no ``from __future__ import annotations`` in this module: FlyDSL reads the
+    # kernel parameters' annotations as types)
+    import flydsl.compiler as flyc
+    from flydsl.expr.typing import Int32, Int64
+
+    body = ASTRewriter.transform(_pingpong_body)
+
+    @flyc.kernel(name="qwen4_numa_pingpong", known_block_size=[64, 1, 1])
+    def pingpong(
+        area: Int64, out: Int64, first: Int32, nblk: Int32, iters: Int32, pair: Int32
+    ):
+        body(area, out, first, nblk, iters, pair)
+
+    @flyc.jit
+    def launch(
+        area: Int64,
+        out: Int64,
+        first: Int32,
+        nblk: Int32,
+        iters: Int32,
+        pair: Int32,
+        stream: fx.Stream = fx.Stream(None),  # noqa: B008
+    ):
+        pingpong(area, out, first, nblk, iters, pair).launch(
+            grid=(16,), block=(64,), stream=stream
+        )
+
+    return launch
+
+
+PP_SLOTS = (
+    4096  # out words: one RTT per block (blocks < PP_SLOTS), then the two CTAs' XCC ids
+)
+PP_BATCH = 64  # blocks per launch
+PP_ITERS = 48  # round trips per block
+
+
+def calibrate(scratch, iters=PP_ITERS):
+    """Measure the home IOD of every 8 KiB block of the area of ``scratch`` (a
+    torch int32 tensor of at least :func:`scratch_bytes_needed` bytes): a
+    ping-pong of tagged sc1 stores / polls between two CTAs on one XCD
+    (``iters`` round trips per block), from an XCD of each IOD; the block's
+    home is the IOD with the shorter round trip. Fits ``f`` per 2 MiB page
+    (home = bit 13 ^ f), writes the header. Returns (mask, agreement, info):
+    agreement = the share of blocks whose measured home matches the fitted
+    rule; info = per-IOD round-trip ratio and the CTAs' XCC ids."""
+    import statistics
+
+    import torch
+
+    assert scratch.numel() * 4 >= scratch_bytes_needed(), "scratch too small for numa"
+    nb = area_bytes() // CHUNK
+    assert nb <= PP_SLOTS
+    base = area_base(scratch.data_ptr())
+    base_w = (base - scratch.data_ptr()) // 4
+    out = torch.zeros(PP_SLOTS + 2, dtype=torch.int32, device=scratch.device)
+    launch = _pingpong_launcher()
+    rtt, xccs = {}, {}
+    for pair in (0, 4):
+        t = torch.zeros(nb, dtype=torch.int64)
+        for first in range(0, nb, PP_BATCH):
+            n = min(PP_BATCH, nb - first)
+            scratch[
+                base_w + first * (CHUNK // 4) : base_w + (first + n) * (CHUNK // 4)
+            ].zero_()
+            launch(
+                base,
+                out.data_ptr(),
+                first,
+                n,
+                iters,
+                pair,
+                stream=torch.cuda.current_stream(),
+            )
+            torch.cuda.synchronize()
+            o = out.cpu()
+            t[first : first + n] = o[first : first + n].to(torch.int64) & 0xFFFFFFFF
+            xccs[pair] = (int(o[PP_SLOTS]), int(o[PP_SLOTS + 1]))
+        rtt[pair] = t
+    scratch[base_w : base_w + area_bytes() // 4].zero_()
+    iod_of = {p: (xccs[p][0] >> 2) & 1 for p in (0, 4)}
+    home = []
+    for j in range(nb):
+        a, b = int(rtt[0][j]), int(rtt[4][j])
+        near = 0 if a <= b else 4
+        home.append(iod_of[near])
+    pages = -(-area_bytes() // PAGE)
+    assert pages <= 32, pages
+    mask, agree = 0, 0
+    per_page = PAGE // CHUNK
+    for p in range(pages):
+        fs = [
+            home[j] ^ (j & 1) for j in range(p * per_page, min(nb, (p + 1) * per_page))
+        ]
+        f = 1 if 2 * sum(fs) > len(fs) else 0
+        mask |= f << p
+        agree += sum(1 for v in fs if v == f)
+    hdr = header_offset() // 4
+    scratch[hdr] = mask
+    scratch[hdr + 1] = MAGIC
+    torch.cuda.synchronize()
+    r0 = statistics.median(int(rtt[0][j]) for j in range(nb) if home[j] == iod_of[0])
+    r1 = (
+        statistics.median(int(rtt[0][j]) for j in range(nb) if home[j] != iod_of[0])
+        if any(h != iod_of[0] for h in home)
+        else r0
+    )
+    info = {
+        "xcc_pairs": xccs,
+        "remote_over_local_rtt": r1 / max(1, r0),
+        "home_share_iod0": home.count(0) / nb,
+    }
+    return mask, agree / nb, info
+
+
+def _narrow_variants():
+    """(rows, seq, group) of every narrow build (``rows`` <= ``MAX_ROWS``)."""
+    from atom.models.qwen4_exp_mono.kernels.layout import MAX_ROWS
+
+    out = []
+    for rows in range(1, MAX_ROWS + 1):
+        out.append((rows, False, 0))
+        if rows > 1:
+            out.append((rows, True, 0))
+        for g in range(2, rows // 2 + 1):
+            if rows % g == 0:
+                out.append((rows, False, g))
+    return out
+
+
+def wanted(key="numa"):
+    """Whether ``ATOM_Q38_SCHED`` (directly or through ``best``) gives some
+    narrow build of some layer kind a ``key`` lever (``numa``, or ``dyn`` for
+    any ``dyn.<stage>``) with a nonzero value (``numa=0`` everywhere, or no
+    such item: False)."""
+    import os
+
+    from atom.models.qwen4_exp_mono.kernels import sched
+
+    spec = os.environ.get(sched.ENV_SCHED, "")
+    if key not in spec and "best" not in spec:
+        return False
+    for kind in ("delta", "delta_ple", "qsa"):
+        for rows, seq, group in _narrow_variants():
+            items = sched.select(spec, kind, sched.variant_name(rows, seq, group))
+            for k, v in sched.parse_levers(items):
+                if v and (k == key or k.startswith(key + ".")):
+                    return True
+    return False
+
+
+def prepare(scratch):
+    """Runner / rig hook: calibrate the scratch's NUMA area when a ``numa``
+    lever is in ``ATOM_Q38_SCHED`` (else nothing). Returns the calibration or None."""
+    if not wanted():
+        return None
+    import sys
+
+    mask, agree, info = calibrate(scratch)
+    print(
+        f"[ATOM_Q38_SCHED numa] scratch calibrated: page mask {mask:#x}, bit-13 rule agreement {agree:.4f}, "
+        f"remote/local round trip {info['remote_over_local_rtt']:.2f}",
+        file=sys.stderr,
+        flush=True,
+    )
+    return mask, agree, info
