+
+@triton.jit
+def _restore_kernel(table, BLOCK: tl.constexpr):
+    e = tl.program_id(0)
+    src = tl.load(table + 3 * e).to(tl.pointer_type(tl.uint8))
+    dst = tl.load(table + 3 * e + 1).to(tl.pointer_type(tl.uint8))
+    n = tl.load(table + 3 * e + 2)
+    for off in range(0, n, BLOCK):
+        o = off + tl.arange(0, BLOCK)
+        tl.store(dst + o, tl.load(src + o, mask=o < n), mask=o < n)
