+        if t is None:
+            t = torch.tensor([x for e in entries for x in e], dtype=torch.int64).to(self.runner.device)
+            if len(self.tables) > 64:
+                self.tables.clear()
+            self.tables[key] = t
+        _restore_kernel[(len(entries),)](t, BLOCK=1024)
+
+    def flush(self):
+        d, self.deferred = self.deferred, []
+        self.launch(d)
+
