+class PubHook:
+    def __init__(self, runner):
+        self.runner = runner
+        self.active = False  # inside a device-path step's preparation
+        self.steady = False  # ... of a steady-state step (skip / restore); otherwise capture only
+        self.cache = {}  # id(binding) -> (host bytes, device snapshot, nbytes)
+        self.deferred = []
+        self.tables = {}
+        self.skipped = 0
+        self.uploaded = 0
+        var = runner.forward_vars
+        self.rewritten = {id(var["input_ids"])}
+        self.immediate_groups = {"token_inputs", "input_ids", "early", "sampling", "spec_decode"}
