+    @staticmethod
+    def _bytes(t, count):
+        return t[:count].reshape(-1).view(torch.uint8)
+
+    def filter(self, group, counts):
+        if not self.active:
+            return counts, _noop
+        out, captures, restores = list(counts), [], []
+        for i, (m, c) in enumerate(zip(group.members, counts)):
+            if not c:
+                continue
+            hb = self._bytes(m._source_view, c)
+            db = self._bytes(m._destination_view, c)
