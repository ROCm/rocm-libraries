+                    out[i] = None
+                    restores.append((ent[1].data_ptr(), db.data_ptr(), hb.numel()))
+                    self.skipped += 1
+                    continue
+            captures.append((key, hb, db))
+            self.uploaded += 1
+
+        def post():
+            for key, hb, db in captures:
+                ent = self.cache.get(key)
+                if ent is None or ent[1].numel() < hb.numel():
+                    snap = torch.empty(max(hb.numel(), 64), dtype=torch.uint8, device=db.device)
+                else:
+                    snap = ent[1]
+                snap[: hb.numel()].copy_(db)  # after the upload, stream-ordered
+                self.cache[key] = (hb.clone(), snap, hb.numel())
+            if restores:
+                if group.name in self.immediate_groups:
+                    self.launch(restores)
+                else:
+                    self.deferred += restores
