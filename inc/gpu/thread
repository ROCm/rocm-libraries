//====================================================================================================================//
//      USER FACING API
//====================================================================================================================//

using internal::thread;

namespace this_thread {
static inline __device__ gpu::thread::id get_id() noexcept {
    using namespace internal;
    return currentVthreadId;
}

static inline __device__ void pseudo_yield() {
    using namespace internal;

    // If there's no work waiting, return immediately.
    if (nextVthreadId_launched > nextVthreadId_stored) {
        return;
    }
    uint32_t old_vthreadId = currentVthreadId;
    invokeNext(true);
    currentVthreadId = old_vthreadId;
}
} // namespace this_thread

static inline __host__ void start() {
    using namespace internal;
    if (started) {
        throw std::logic_error("gpu::start() called twice");
    }
    started = true;
    // TODO: investigate using hipExtStreamCreateWithCUMask for this
    __LIBGPU_HIP_CHECK__(hipStreamCreateWithFlags(&mainStream, hipStreamNonBlocking));
    hipLaunchKernelGGL(threading_main, dim3(thread::hardware_concurrency()), dim3(1), 0, mainStream);
}

static inline __host__ void finish(bool blocking = true) {
    using namespace internal;
    if (!started) {
        throw std::logic_error("called gpu::finish() before calling gpu::start()");
    }
    hipLaunchKernelGGL(kernel_terminate, dim3(1), dim3(1), 0, getEnqueingStream());
    __LIBGPU_HIP_CHECK__(hipGetLastError());
    if (blocking) {
        // We could wait for kernel_terminate to finish (with hipStreamSynchronize(enqueingStream)) before
        // synchronizing on mainStream, but there's no need.
        __LIBGPU_HIP_CHECK__(hipStreamSynchronize(mainStream));
        __LIBGPU_HIP_CHECK__(hipStreamDestroy(mainStream));
        // Don't destroy enqueingStream because unlike mainStream we won't re-create it if the user decides to 're-start the GPU'
    }
}

[[gnu::const]]
inline __host__ unsigned int thread::hardware_concurrency() noexcept {
    try {
        uint32_t temp;
        __LIBGPU_HIP_CHECK__(hipMemcpyFromSymbol(&temp, HIP_SYMBOL(numVcores), sizeof(temp), 0, hipMemcpyDeviceToHost));
        return temp;
    }
    catch (...) {
        std::cerr << "Exception while fetching numVcores\n";
        return 1;
    }
}

__host__ __device__ inline thread &thread::operator=(thread &&other) noexcept {
    if (joinable()) {
#ifdef __HIP_DEVICE_COMPILE__
        assert(!joinable() && "Attempted to assign to a gpu::thread object that still has an associated thread");
#else
        std::terminate();
#endif
    }
    vthreadId = other.vthreadId;
    other.vthreadId = MAX_VTHREADS;
    return *this;
}

template <class Fn_t, class... Args_t>
inline __host__ thread::thread(Fn_t &&typed_fn, Args_t &&...args) {
    gpu::thread *temp, *temp_d;
    // We would use hipHostMalloc here instead of malloc + hipHostRegister, except that hipHostFree performs an implicit
    // hipDeviceSynchronize() which will cause problems
    temp = static_cast<gpu::thread *>(std::malloc(sizeof(*temp)));
    __LIBGPU_HIP_CHECK__(hipHostRegister(temp, sizeof(*temp), hipHostRegisterDefault));
    __LIBGPU_HIP_CHECK__(hipHostGetDevicePointer(reinterpret_cast<void **>(&temp_d), temp, 0));
    hipLaunchKernelGGL(spawnVthreadFromHost, dim3(1), dim3(1), 0, getEnqueingStream(), temp_d,
                       std::forward<Fn_t>(typed_fn), std::forward<Args_t>(args)...);
    __LIBGPU_HIP_CHECK__(hipStreamSynchronize(getEnqueingStream()));
    __LIBGPU_HIP_CHECK__(hipHostUnregister(temp));
    *this = std::move(*temp);
    std::free(temp);
}

template <class Fn_t, class... Args_t>
inline __device__ thread::thread(Fn_t &&typed_fn, Args_t &&...args) {
    vthreadId = store(std::forward<Fn_t>(typed_fn), std::forward<Args_t>(args)...);
}

__host__ __device__ inline thread::~thread() {
    if (joinable()) {
#ifdef __HIP_DEVICE_COMPILE__
        assert(!joinable() && "Attempted to destroy a gpu::thread object that still has an associated thread");
#else
        std::terminate();
#endif
    }
}

__device__ inline void thread::join() {
    // TODO: check that the user has called gpu::start()
    if (!joinable()) {
        assert(joinable() && "Attempted to join a gpu::thread object that doesn't have an associated thread");
    }
    if (this->get_id() == gpu::this_thread::get_id()) {
        assert(this->get_id() != gpu::this_thread::get_id() &&
                   "Attempted to join the gpu::thread object associated with the active thread");
    }
    assert(vthreadId < nextVthreadId_stored && "Internal library error");
    while (fn_table[vthreadId] != nullptr) {
        // spin while we wait for it to finish.
    }
    vthreadId = MAX_VTHREADS;
}

__host__ inline void thread::join() {
    if (!started) {
        throw std::logic_error("called gpu::thread::join() before calling gpu::start()");
    }
    if (!joinable()) {
        throw std::system_error(std::error_code(EINVAL, std::system_category()), "thread::join failed");
    }
    // TODO: This is an ugly way of doing this. Try to come up with something better
    hipLaunchKernelGGL(kernel_join, dim3(1), dim3(1), 0, getEnqueingStream(), vthreadId);
    __LIBGPU_HIP_CHECK__(hipStreamSynchronize(getEnqueingStream()));
    vthreadId = MAX_VTHREADS;
}

__host__ __device__ inline void thread::detach() {
    if (!joinable()) {
#ifdef __HIP_DEVICE_COMPILE__
        assert(joinable() && "Attempted to detach a gpu::thread object that doesn't have an associated thread");
#else
        throw std::system_error(std::error_code(EINVAL, std::system_category()), "thread::detach failed");
#endif
    }
    vthreadId = MAX_VTHREADS;
}

} // namespace gpu

#endif // __GPU_THREAD_H__
