enum {
    MAX_VTHREADS = 0x100000, // TODO: Increase this later. For a demo prototype this is good enough.
#if defined(__gfx1030__)
    NUM_VCORES = 130U, // We can't occupy all cores or the host will have a hard time spawning vthreads or terminating us
                     // TODO: this should be dynamic and depend on the number of CUs or something
#elif defined(__gfx1034__)
    NUM_VCORES = 33U,
#elif defined(__gfx1100__)
    NUM_VCORES = 83U, // Conservative for demo
#elif defined(__HIP_DEVICE_COMPILE__)
#warning "Running on a gpu that hasn't had NUM_VCORES configured"
    NUM_VCORES = 15U,
#else
    NUM_VCORES = 0U,
#endif
};
extern __device__ uint32_t numVcores;

//====================================================================================================================//
//      THREAD CLASS DEFINITION
//====================================================================================================================//

class thread {
    volatile uint32_t vthreadId = MAX_VTHREADS;

  public:
    // TODO: temporary measure. Should to be replaced with an actual class.
    // Right now a default constructed id is a valid thread id, and it shouldn't be.
    typedef uint32_t id;

    __host__ __device__ thread() noexcept {}
    __host__ __device__ thread(const thread &) = delete;
    __host__ __device__ thread(thread &&other) noexcept : vthreadId(other.vthreadId) { other.vthreadId = MAX_VTHREADS; }
    __host__ __device__ thread &operator=(thread &&other) noexcept;

    template <class Fn_t, class... Args_t>
    explicit __host__ thread(Fn_t &&typed_fn, Args_t &&...args);
    template <class Fn_t, class... Args_t>
    explicit __device__ thread(Fn_t &&typed_fn, Args_t &&...args);

    __host__ __device__ ~thread();

    __host__ __device__ thread::id get_id() const noexcept { return vthreadId; }
    __host__ __device__ bool joinable() const noexcept { return vthreadId < MAX_VTHREADS; }
    __device__ void join();
    __host__ void join();
    __host__ __device__ void detach();

    __device__ static unsigned int hardware_concurrency() noexcept { return NUM_VCORES; }
    __host__ static inline unsigned int hardware_concurrency() noexcept;
};

//====================================================================================================================//
//      GLOBAL VARIABLE DECLARATIONS
//====================================================================================================================//

// TODO: These globals currently prevent us from being a header-only library
// Maybe use an inline (non-static) __device__ function that returns a pointer to a static local variable instead?
// E.g. https://stackoverflow.com/questions/51612866/global-variables-in-header-only-library
typedef void (*WrappedFnPointer)(void *);
// These are indexed by the vthreadId
extern __device__ volatile WrappedFnPointer wrapper_table[MAX_VTHREADS];
extern __device__ void *volatile fn_table[MAX_VTHREADS];
// TODO: Maybe change the above tables into a linked-list? We already have to allocate heap space for the fn anyways.
/* E.g.
__device__ volatile void *vthreadHead;
__device__ void *volatile *vthreadTail = &vthreadHead;
