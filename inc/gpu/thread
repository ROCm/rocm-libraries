[[nodiscard]] static inline __device__ WorkNode_Header **lockAndFetchTail() {
    uintptr_t currentTail;
    // Roughly equivalent to, but faster than:
    // uintptr_t old = *reinterpret_cast<uintptr_t*>(&workListTail), assumed;
    // do {
    //     assumed = old;
    //     old = atomicCAS(reinterpret_cast<uintptr_t*>(&workListTail), assumed, 0);
    // } while (assumed != old || assumed == 0);
    // Note: I think access through this cast might be a strict aliasing violation, but it's kind of unavoidable.
    // atomicExch only accepts arithmetic types, so we have to cast worklistTail to an arithmetic type like uintptr_t,
    // resulting in a strict aliasing violation.
    while((currentTail = atomicExch(reinterpret_cast<uintptr_t*>(&workListTail), 0)) == 0) {
        //__builtin_amdgcn_s_sleep(1);
    }
    return reinterpret_cast<WorkNode_Header **>(currentTail);
}
static inline __device__ void setAndUnlockTail(WorkNode_Header **newTail) {
    __threadfence();
    // assert(workListTail == nullptr);
    // I think this might be a strict aliasing violation, but it's kind of unavoidable
    atomicExch(reinterpret_cast<uintptr_t*>(&workListTail), reinterpret_cast<uintptr_t>(newTail));
}

// Precondition: We're still holding the lock acquired in invokeNext. Needed to make sure detach doesn't make worknode
// an invalid pointer before we load typed_node_ptr and width.
template <class Callable_t>
static __device__ void wrapper(WorkNode_Header *worknode, WorkNode_Header **currentTail) {
    static_assert(std::is_standard_layout_v<WorkNode<Callable_t>>);
    // TODO: Part of C++20, not yet implemented in libc++. See https://libcxx.llvm.org/Status/Cxx20.html -> P0466R5
    // static_assert(std::is_pointer_interconvertible_with_class(WorkNode<Callable_t>::header));

    // Because of pointer-interconvertability of WorkNode<Callable_t>::header and WorkNode<Callable_t>, reading from typed_node_ptr
    // shouldn't result in a strict-aliasing violation.
    WorkNode<Callable_t> *typed_node_ptr = reinterpret_cast<WorkNode<Callable_t> *>(worknode);
    Callable_t fn = std::move(typed_node_ptr->fn);
    uint32_t width = typed_node_ptr->header.width;
    __syncthreads();
    // Even though setAndUnlockTail includes a threadfence, include a threadfence for all threads just to be safe.
    __threadfence();
    if (threadIdx.x == 0)
        setAndUnlockTail(currentTail);
    if (threadIdx.x < width) {
        fn();
    }
    __threadfence();
    // TODO: figure out how to make all the threads with idx > width 'catch up' on missed __syncthreads() calls.
    // Shouldn't be a concern as long as blockDim.x == MAX_THREAD_WIDTH == warpSize
}

template <class Callable_t>
__device__ WorkNode<Callable_t>::WorkNode(uint32_t width, Callable_t &&callable) : fn(std::move(callable)) {
    header.wrapper_fn = wrapper<Callable_t>;
    header.width = width;
}

template <class Callable_t>
__host__ WorkNode<Callable_t>::WorkNode(uint32_t width, Callable_t &&callable) : fn(std::move(callable)) {
    header.width = width;
    // Only way to pass the device the information about how to invoke WorkNode<Callable_t>.fn is by launching a kernel.
    // Thus, we initialize header.wrapper_fn later in insertWorkNodeFromHost.
    // Since we have to incur the overhead of launching a kernel anyways, we also use that kernel to initialize
    // header.link_to_self and header.vthread_id - that way we can keep all the status information in device memory,
    // rather than in pinned host memory.

    // Why do we NEED a kernel?
    // We can't reference __device__ functions from __host__ functions, so this is illegal:
    // header = {nullptr, nullptr, false, {}, 0, wrapper<Callable_t> };
    //
    // Extended lambda's don't define a pointer-to-function conversion operator, so wrapping the invokation of the
    // __device__ function in an extended lambda without captures doesn't work:
    // header = {nullptr, nullptr, false, {}, 0, [] __device__ () { wrapper<Callable_t>() } };
    // https://docs.nvidia.com/cuda/cuda-c-programming-guide/index.html 14.7.2.16 Extended Lambda Restrictions
    //
    // __device__ template variables cannot be instantiated using a type defined in host code, so this doesn't work:
    // template <class Fn_t> __device__ WrappedFnPointer wrapper_ptr = wrapper<Fn_t>;
    // __LIBGPU_HIP_CHECK__(hipMemcpyFromSymbol(&temp, HIP_SYMBOL(wrapper_ptr<Callable_t>), sizeof(temp), 0,
    // hipMemcpyDeviceToHost)); https://docs.nvidia.com/cuda/cuda-c-programming-guide/index.html 14.5.12 Restrictions ->
    // Templates
    //
    // If there's some other way of bundling the arguments up, and passing them to the device along with a function that
    // accepts those arguments, we could use that and avoid a kernel launch from the host.
}

// TODO: many of these might be better as member functions of WorkNode or WorkNode_Header, and we could potentially make
// a bunch of WorkNode_Header's member variables private
static inline __device__ void insertWorkNodeAtTail(WorkNode_Header *worknode) {
    WorkNode_Header **currentTail = worknode->link_to_self = lockAndFetchTail();
    *(worknode->link_to_self) = worknode;
    if (currentTail != &workListHead) {
        WorkNode_Header* prev = reinterpret_cast<WorkNode_Header*>(reinterpret_cast<char*>(currentTail) - offsetof(WorkNode_Header, next));
        worknode->vthread_id = prev->vthread_id + prev->width;
    } else {
        worknode->vthread_id = 1;
    }
    setAndUnlockTail(&(worknode->next));
}

static inline __device__ void setCurrentWorkNode(WorkNode_Header *node) {
    // This is non-null if and only if invokeNext was called from pseudo_yield.
    WorkNode_Header *yieldingWorkNode = currentWorkNode[blockIdx.x];
    currentWorkNode[blockIdx.x] = node;
    if (node == nullptr)
        return;
    node->link_to_self = const_cast<WorkNode_Header **>(&currentWorkNode[blockIdx.x]);
    // If we're called from pseudo_yield, set node->next to the yielding thread so we can restore later.
    node->next = yieldingWorkNode;
    if (yieldingWorkNode != nullptr) {
        yieldingWorkNode->link_to_self = &node->next;
    }
}
static inline __device__ WorkNode_Header *popWorkNodeFromHead() {
    // assert(workListHead != nullptr);
    WorkNode_Header *head = reinterpret_cast<WorkNode_Header *>(atomicAdd(reinterpret_cast<uintptr_t*>(&workListHead), 0));
    workListHead = head->next;
    setCurrentWorkNode(head);
    if (workListHead != nullptr) {
        workListHead->link_to_self = &workListHead;
    }
    return head;
}

// Returns true if there was work waiting
static inline __device__ bool invokeNext() {
    WorkNode_Header **currentTail;
    __shared__ WorkNode_Header *worknode_s;
    if (threadIdx.x == 0) {
        currentTail = lockAndFetchTail();
        if (currentTail == &workListHead) {
            // assert(workListHead == nullptr);
            setAndUnlockTail(&workListHead);
            worknode_s = nullptr;
        } else {
            worknode_s = popWorkNodeFromHead();
            if (workListHead == nullptr) {
                currentTail = &workListHead;
            }
        }
    }
    __syncthreads();
    if (worknode_s == nullptr) {
        return false;
    }

    // Invoke the user-provided function.
    // So we don't have to keep locking and re-loading worknode from currentWorkNode[], wrapper_fn is responsible for unlock
    worknode_s->wrapper_fn(worknode_s, currentTail);

    __syncthreads();

    // Now we have to re-lock it and re-fetch worknode in case it was detached while the user function was running.
    if (threadIdx.x == 0) {
        currentTail = lockAndFetchTail();
        WorkNode_Header *worknode = currentWorkNode[blockIdx.x];
        // If we're called from pseudo_yield, restore the original worknode.
        // Otherwise, this sets currentWorkNode[blockIdx.x] to nullptr, signaling that we're 'idle'
        setCurrentWorkNode(worknode->next);
        if (worknode->finishedOrDetached) { // Detach has been called
            ::free(worknode);
        } else {
            worknode->finishedOrDetached = true;
        }

        setAndUnlockTail(currentTail);
    }
    return true;
}

static inline __device__ uint32_t getActiveVcoreCount() {
    WorkNode_Header **currentTail;
    if (threadIdx.x == 0)
        currentTail = lockAndFetchTail();
    // Don't need this as long as blockDim.x == MAX_THREAD_WIDTH == warpSize
    // __syncthreads();
    uint32_t count = 0;
    for (uint32_t i = threadIdx.x; i < NUM_VCORES; i += MAX_THREAD_WIDTH) {
        // TODO: If we're only ever using this function to check whether getActiveVcoreCount() != 0, we could exit early
        if (currentWorkNode[i] != nullptr) {
            ++count;
        }
    }
    // equivalent to count = __reduce_add_sync(0x1FU, count);
    // TODO: Fix this if/when blockDim.x (aka MAX_THREAD_WIDTH) > 32
    for (int offset = warpSize / 2; offset > 0; offset /= 2) {
        count += __shfl_down(count, offset);
    }

    if (threadIdx.x == 0)
        setAndUnlockTail(currentTail);
    return count;
}

//====================================================================================================================//
//      KERNELS
//====================================================================================================================//

// TODO: should these all be static? This creates duplicate copies in each compilation unit that includes this header
// Maybe they should be declared inline instead (to avoid multiple definition errors)
// Note that we need to disable -Wcuda-compat for this section using a pragma if we do this
static __global__ void threading_main() {
    for (bool workFound = true; workFound || !finishing || getActiveVcoreCount() != 0;) {
        // TODO: why do we need this when blockDim.x == MAX_THREAD_WIDTH == warpSize?
        __syncthreads();
        workFound = invokeNext();
        if (!workFound)
            __builtin_amdgcn_s_sleep(8);
    }
}

template <class Callable_t>
static __global__ void insertWorkNodeFromHost(WorkNode_Header *worknode) {
    worknode->wrapper_fn = wrapper<Callable_t>;
    insertWorkNodeAtTail(worknode);
}

static __global__ void detachWorkNode(WorkNode_Header *oldWorkNode, uint32_t worknodeSize) {
    WorkNode_Header *newWorkNode = static_cast<WorkNode_Header *>(::malloc(worknodeSize));
    WorkNode_Header **currentTail = lockAndFetchTail();

    if (oldWorkNode->finishedOrDetached) {
        // It's already finished, so oldWorkNode is not in the list, nor in currentWorkNode[]. Thus, we don't have to
        // worry about updating its state or copying it. Just return so gpu::thread can free oldWorkNode.
        setAndUnlockTail(currentTail);
        ::free(newWorkNode);
        return;
    }

    oldWorkNode->finishedOrDetached = true;
    *(oldWorkNode->link_to_self) = newWorkNode;
    gpu::memcpy(newWorkNode, oldWorkNode, worknodeSize);

    // Not equivalent to `oldWorkNode->next == nullptr` b/c pseudo_yield uses oldWorkNode->next to store a pointer to
    // the yielding thread
    if (currentTail == &(oldWorkNode->next)) {
        setAndUnlockTail(&(newWorkNode->next));
    } else {
        // Using oldWorkNode to access next means nothing in this function requires a read from newWorkNode. Not sure if
        // that matters
        if (oldWorkNode->next != nullptr)
            oldWorkNode->next->link_to_self = &(newWorkNode->next);
        setAndUnlockTail(currentTail);
    }
}

