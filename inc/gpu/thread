    void *next; // must always be device-accessible. Either zero-copy pinned host memory, or device memory
    uint32_t threadId;
    bool finished; // for join()
    Callable_t fn;
};
// But how to implement kernel_terminate()? Just a global variable?
*/

extern __device__ volatile uint32_t nextVthreadId_stored;
extern __device__ volatile uint32_t nextVthreadId_launched;
// if nextVthreadId_launched > nextVthreadId_stored, then (nextVthreadId_launched-nextVthreadId_stored) vcores are
// spinning waiting for work. Otherwise (nextVthreadId_stored-nextVthreadId_launched) vthreads have been constructed, but
// not started/assigned to a vcore

extern hipStream_t mainStream;
extern bool started;

// Doesn't need to be volatile because this will only ever be read/written to by a single vcore/(real, non-v) thread
// TODO: switch to a ?32? wide array when we allow more than 1 thread per block
extern __shared__ gpu::internal::thread::id currentVthreadId;

//====================================================================================================================//
//      INTERNAL/HELPER FUNCTIONS
//====================================================================================================================//

template <class Fn_t>
static __device__ void wrapper(void *fn) {
    Fn_t *typed_fn = static_cast<Fn_t *>(fn);
    (*typed_fn)();
    __threadfence();
    // If we start using thread groups > 1, then this becomes necessary (and probably more stuff like it elsewhere)
    //__syncthreads();
    delete typed_fn;
}

template <class Fn_t, class... Args_t>
static inline __device__ uint32_t store(Fn_t &&typed_fn, Args_t &&...args) {
    // Store args by capturing them in a lambda. This allows wrapper<T> to focus on invoking an arbitrary object of
    // callable type.
    // Ideally, we would also forward args in the capture (...args = std::forward<Args_t>(args)) to avoid an extra copy,
    // but that requires C++20
    auto arg_wrapper =
        new auto([typed_fn = std::forward<Fn_t>(typed_fn), args...] __device__() { gpu::__invoke(std::move(typed_fn), std::move(args)...); });
    uint32_t vthreadId = atomicAdd(const_cast<uint32_t *>(&nextVthreadId_stored), 1);
    if (vthreadId >= MAX_VTHREADS) {
        delete arg_wrapper;
        return MAX_VTHREADS;
    }
    wrapper_table[vthreadId] = wrapper<std::remove_reference_t<decltype(*arg_wrapper)>>;
    __threadfence(); // ensure fn_table[i] != nullptr implies wrapper_table[i] != nullptr so invokeNext only needs to
                     // check fn_table[i] != nullptr
    // TODO: determine if using a __threadfence() is actually better than having invokeNext check both fn_table[i] !=
    // nullptr and wrapper_table[i] != nullptr
    fn_table[vthreadId] = static_cast<void *>(arg_wrapper);
    return vthreadId;
}

// Before calling invokeNext(true), the caller should check that there is work available (nextVthreadId_launched <=
// nextVthreadId_stored)
static inline __device__ uint32_t invokeNext(const bool dontWait = false) {
    uint32_t vthreadId = atomicAdd(const_cast<uint32_t *>(&nextVthreadId_launched), 1);
    if (vthreadId >= MAX_VTHREADS) {
        return MAX_VTHREADS;
    }
    currentVthreadId = vthreadId;
    __threadfence(); // Make sure everybody sees our update to nextVthreadId_launched before the vthread function
                     // potentially spawns a thread and in the process updates nextVthreadId_stored.
    while (fn_table[vthreadId] == nullptr) {
        // All constructed vthreads are already assigned/running. If dontWait == false, spin while we wait for work.
        // If dontWait == true, construct dummy vthreads until we get some 'work' to run (an empty lambda).
        //
        // This hack is needed because incrementing nextVthreadId_launched signalled that we'd take responsibility for
        // whatever work gets stored at fn_table[vthreadId].
        if (dontWait) {
            store([] __device__() { ; });
        }
    }
    wrapper_table[vthreadId](fn_table[vthreadId]);
    __threadfence(); // Make sure all the writes the vthread function made are visible before we do anything further
    currentVthreadId = MAX_VTHREADS;
    wrapper_table[vthreadId] = nullptr;
    fn_table[vthreadId] = nullptr;
    return vthreadId;
}

//====================================================================================================================//
//      KERNELS
//====================================================================================================================//

//TODO: should these all be static? This creates duplicate copies in each compilation unit that includes this header
// Maybe they should be declared inline instead (to avoid multiple definition errors)
// Note that we need to disable -Wcuda-compat using a pragma if we do this
static __global__ void threading_main() {
    currentVthreadId = MAX_VTHREADS;
    for (uint32_t vthreadId = invokeNext(); vthreadId < MAX_VTHREADS;) {
        vthreadId = invokeNext();
    }
}

template <class Fn_t, class... Args_t>
static __global__ void spawnVthreadFromHost(thread *thd, Fn_t typed_fn, Args_t... args) {
    new (thd) thread(std::move(typed_fn), std::move(args)...);
}

// This needs to be launched in the same stream as the host-side thread creation to ensure it happens after that
static __global__ void kernel_terminate() {
    // Wait for ALL queued/waiting and started/running vthreads to complete.
    // Note that one of the vthreads might themselves spawn more vthreads we have to wait for!
    for (uint32_t nextVthreadId_executed_local = 0; nextVthreadId_executed_local < nextVthreadId_stored + NUM_VCORES;) {
        // We use a local copy of nextVthreadId_launched to force the read of nextVthreadId_launched to happen before
        // the read of nextVthreadId_stored. If we don't force this ordering, it's possible that we read
        // nextVthreadId_stored right before the last vthread spawns another vthread, finishes, and then the vcore it
        // was on increments nextVthreadId_launched before we read it.
        nextVthreadId_executed_local = nextVthreadId_launched;
        // Looking at the example use of __threadfence() in
        // https://docs.nvidia.com/cuda/cuda-c-programming-guide/index.html#memory-fence-functions, we might need a
        // threadfence between the load of nextVthreadId_launched and the load of nextVthreadId_stored
    }
    __threadfence();
    // When a vcore sees that we have hit MAX_VTHREADS, it exits. We can use this to make them stop running.
    nextVthreadId_launched = MAX_VTHREADS;
    // The vcores are now spinning waiting for work and won't notice the update to nextVthreadId_launched until we give
    // them some. So we'll give them an empty job to do.
    // TODO: this could probably be parallelized if we launch this kernel with a block size of NUM_VCORES instead of 1.
    for (int i = 0; i < NUM_VCORES; ++i) {
        store([] __device__() { ; });
    }
    // The vcores should all exit on their own now.
    // If we need to wait for them to actually exit, we can do that in host code using hipStreamSynchronize(mainStream).
}

static __global__ void kernel_join(thread::id vthreadId) {
    while (fn_table[vthreadId] != nullptr) {
        // spin while we wait for it to finish.
    }
}
