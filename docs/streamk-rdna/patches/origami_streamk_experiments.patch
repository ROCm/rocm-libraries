+  // can move while both ceilings stay put. Default 1 = stock.
+  static const char* th_env = std::getenv("ORIGAMI_THRESHOLD_MULT");
+  static const long  th_mult = th_env ? std::atol(th_env) : 1;
+  const size_t threshold = cu_count * (th_mult > 0 ? static_cast<size_t>(th_mult) : 1);
+
+  if (tiles > threshold) {
     size_t virt_cu_count = cu_count;
     if (config.occupancy > 1 && cu_budget == 0) virt_cu_count *= config.occupancy;
 
