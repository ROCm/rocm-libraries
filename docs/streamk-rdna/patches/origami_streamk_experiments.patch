   size_t tiles = compute_number_of_output_tiles(
       config.mt.m, config.mt.n, problem.size.m, problem.size.n, problem.batch);
 
+  // EXPERIMENT (2026-08-21): size gate. Offline re-analysis of the 2026-08-19 census
+  // (1495 shapes) found StreamK is a per-shape geomean WIN but a flops-weighted wall-clock
+  // LOSS: mode-4-vs-mode-6 is 96.95% by geomean and 102.17% by total throughput. The cause
+  // is pure weighting -- <0.1ms is 53% of shapes but 3.5% of kernel time (StreamK wins
+  // there), >=1ms is 9.8% of shapes but 77% of time (StreamK loses there). Gating StreamK
+  // off above an M*N threshold projected 101.30% geomean AND 102.08% wall-clock on a
+  // held-out half. M*N rather than M*N*K because the benefit is about tile count, which is
+  // M*N-driven. Returning `tiles` is exactly what grid_data_parallel() returns, so the
+  // launch becomes data-parallel-equivalent. Default 0 = disabled = byte-identical to stock.
+  static const char*  mn_env  = std::getenv("ORIGAMI_MN_GATE");
+  static const double mn_gate = mn_env ? std::atof(mn_env) : 0.0;
+  if (mn_gate > 0.0) {
+    const double mn = static_cast<double>(problem.size.m) * static_cast<double>(problem.size.n);
+    if (mn >= mn_gate) return tiles;
+  }
+
   size_t sk_grid = tiles;  // Fallback if no good fractional tile is found
   if (cu_budget > 0) sk_grid = std::min(sk_grid, cu_budget);
 
