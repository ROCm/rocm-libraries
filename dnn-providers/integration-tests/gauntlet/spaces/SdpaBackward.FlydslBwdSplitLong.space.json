        64,
        128
      ]
    },
    "skv": {
      "values": [
        1025,
        2048,
        4096,
        8191,
        8192,
        16384,
        16385,
        32768,
        65536
      ]
    },
    "mask": {
      "values": [
        "none",
        "none",
        "causal_bottom_right",
        "window"
      ]
    },
    "wl": {
      "values": [
