{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocm.docs.amd.com/schemas/rocke/comgr-capabilities.schema.json",
  "title": "rocKE COMGR capability report",
  "type": "object",
  "additionalProperties": false,
  "required": ["probe", "compiler", "capabilities"],
  "properties": {
    "probe": {"$ref": "#/$defs/probe"},
    "compiler": {"$ref": "#/$defs/compiler"},
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "implementation_sha256",
        "schema_sha256",
        "target_triple",
        "processor",
        "fingerprint"
      ],
      "properties": {
        "name": {"const": "rocke-comgr-capabilities"},
        "implementation_sha256": {"$ref": "#/$defs/sha256"},
        "schema_sha256": {"$ref": "#/$defs/sha256"},
        "target_triple": {"const": "amdgcn-amd-amdhsa"},
        "processor": {
          "type": "string",
          "pattern": "^gfx[0-9a-z-]+$"
        },
        "fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "nullablePath": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "llvm_version",
        "version_source",
        "query_library",
        "library",
        "sha256"
      ],
      "properties": {
        "route": {"const": "comgr"},
        "llvm_version": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {"type": "integer", "minimum": 0}
            },
            {"type": "null"}
          ]
        },
        "version_source": {"type": "string", "minLength": 1},
        "query_library": {"$ref": "#/$defs/nullablePath"},
        "library": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hsaco_sha256", "hsaco_size", "completed_stages"],
      "properties": {
        "hsaco_sha256": {"$ref": "#/$defs/sha256"},
        "hsaco_size": {"type": "integer", "minimum": 1},
        "completed_stages": {
          "const": [
            "compile_source_to_bc",
            "codegen_bc_to_relocatable",
            "link_relocatable_to_executable"
          ]
        }
      }
    },
    "observation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "candidate", "outcome", "evidence"],
          "properties": {
            "family": {"type": "string", "minLength": 1},
            "candidate": {"type": "string", "minLength": 1},
            "outcome": {"const": "accepted"},
            "evidence": {"$ref": "#/$defs/evidence"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "candidate", "outcome", "diagnostic"],
          "properties": {
            "family": {"type": "string", "minLength": 1},
            "candidate": {"type": "string", "minLength": 1},
            "outcome": {
              "enum": ["rejected", "crash", "timeout", "error"]
            },
            "diagnostic": {"type": "string", "minLength": 1},
            "failed_stage": {
              "enum": [
                "setup",
                "set_isa",
                "compile_source_to_bc",
                "codegen_bc_to_relocatable",
                "link_relocatable_to_executable"
              ]
            }
          }
        }
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {
        "status": {"const": "known"},
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": ["route", "observations"],
          "properties": {
            "route": {"const": "comgr_llvm_ir_to_hsaco"},
            "observations": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/observation"}
            }
          }
        }
      }
    }
  }
}
