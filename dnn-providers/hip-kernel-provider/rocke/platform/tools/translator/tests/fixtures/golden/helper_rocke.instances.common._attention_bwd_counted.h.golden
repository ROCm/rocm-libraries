#ifndef ROCKE_HELPER_ROCKE_INSTANCES_COMMON__ATTENTION_BWD_COUNTED_H
#define ROCKE_HELPER_ROCKE_INSTANCES_COMMON__ATTENTION_BWD_COUNTED_H

#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>

#include "rocke/ir.h"

#ifdef __cplusplus
extern "C" {
#endif
#define ROCKE_ATTN_BWD_COUNTED_N_ISSUES 2
extern const char* const ROCKE_ATTN_BWD_COUNTED_ISSUES[ROCKE_ATTN_BWD_COUNTED_N_ISSUES];

#define ROCKE_ATTN_BWD_COUNTED_VMCNT_MAX 63

typedef struct rocke_attn_bwd_counted_waits rocke_attn_bwd_counted_waits_t;
typedef struct rocke_attn_bwd_staged_step rocke_attn_bwd_staged_step_t;
typedef struct rocke_attn_bwd_tile_chunk rocke_attn_bwd_tile_chunk_t;

/* py: CountedWaits */
typedef struct rocke_attn_bwd_counted_waits
{
    int n_atomics;
    int since_load;
    int issued;
    int* waits;
    int n_waits;
    int cap_waits;
} rocke_attn_bwd_counted_waits_t;

/* py: StagedStep */
typedef struct rocke_attn_bwd_staged_step
{
    rocke_value_t** stats;
    int n_stats;
    int cap_stats;
    rocke_value_t** qdo;
    int n_qdo;
    int cap_qdo;
} rocke_attn_bwd_staged_step_t;

/* py: TileChunk */
typedef struct rocke_attn_bwd_tile_chunk
{
    rocke_value_t* row;
    rocke_value_t* col;
    rocke_value_t* guard;
    int total;
} rocke_attn_bwd_tile_chunk_t;

typedef rocke_value_t* (*rocke_attn_bwd_tile_load_fn)(void* ctx,
                                                      rocke_value_t* a0,
                                                      rocke_value_t* a1);
typedef struct rocke_attn_bwd_tile_loader
{
    rocke_attn_bwd_tile_load_fn fn;
    void* ctx;
} rocke_attn_bwd_tile_loader_t;

typedef void (*rocke_attn_bwd_tile_store_fn)(void* ctx,
                                             rocke_ir_builder_t* b,
                                             rocke_value_t* row,
                                             rocke_value_t* col,
                                             rocke_value_t* val,
                                             int vec);

typedef struct rocke_attn_bwd_tile_view
{
    rocke_attn_bwd_tile_store_fn store;
    void* ctx;
} rocke_attn_bwd_tile_view_t;

/* py: CountedWaits.__init__ */
bool rocke_attn_bwd_counted_waits_init(rocke_attn_bwd_counted_waits_t* self,
                                       int n_atomics,
                                       char* reason,
                                       size_t reason_cap);

/* py: CountedWaits.step_entry */
void rocke_attn_bwd_counted_waits_step_entry(rocke_attn_bwd_counted_waits_t* self);

/* py: CountedWaits.loads */
void rocke_attn_bwd_counted_waits_loads(rocke_attn_bwd_counted_waits_t* self);

/* py: CountedWaits.atomics */
void rocke_attn_bwd_counted_waits_atomics(rocke_attn_bwd_counted_waits_t* self, int n);

/* py: CountedWaits.end_step. Check that the step issued exactly ``n_atomics`` atomics. */
bool rocke_attn_bwd_counted_waits_end_step(const rocke_attn_bwd_counted_waits_t* self,
                                           char* reason,
                                           size_t reason_cap);

/* py: CountedWaits.barrier */
bool rocke_attn_bwd_counted_waits_barrier(rocke_attn_bwd_counted_waits_t* self,
                                          rocke_ir_builder_t* b,
                                          const char* fence);

/* py: CountedWaits<free>. Release the lists the struct owns. */
void rocke_attn_bwd_counted_waits_free(rocke_attn_bwd_counted_waits_t* self);

/* py: StagedStep.flat */
bool rocke_attn_bwd_staged_step_flat(const rocke_attn_bwd_staged_step_t* self,
                                     rocke_value_t*** out,
                                     int* n_out);

/* py: StagedStep.from_flat */
rocke_attn_bwd_staged_step_t
    rocke_attn_bwd_staged_step_from_flat(rocke_value_t* const* values, int n_values, int n_stats);

/* py: StagedStep<free>. Release the lists the struct owns. */
void rocke_attn_bwd_staged_step_free(rocke_attn_bwd_staged_step_t* self);

/* py: issue_tile_loads. Every global load of the tiles ``loads`` (one loader per tile), tile by tile, chunk by chunk; the values in that order. */
bool rocke_attn_bwd_issue_tile_loads(rocke_ir_builder_t* b,
                                     const rocke_attn_bwd_tile_loader_t* loads,
                                     int n_loads,
                                     const rocke_attn_bwd_tile_chunk_t* chunks,
                                     int n_chunks,
                                     rocke_value_t*** out,
                                     int* n_out);

/* py: store_tile. Store the values of :func:`issue_tile_loads` into the LDS ``views`` (one view per tile, the same order); a tail chunk is stored only when its chunk is inside the tile. */
bool rocke_attn_bwd_store_tile(rocke_ir_builder_t* b,
                               const rocke_attn_bwd_tile_view_t* views,
                               int n_views,
                               const rocke_attn_bwd_tile_chunk_t* chunks,
                               int n_chunks,
                               rocke_value_t* const* values,
                               int n_values,
                               int vec);

/* py: tile_chunks. The chunks of a ``rows x cols`` tile the thread ``tid`` moves, in the order and with the clamps of the ``loads_first`` copy order. */
bool rocke_attn_bwd_tile_chunks(rocke_ir_builder_t* b,
                                int rows,
                                int cols,
                                rocke_value_t* tid,
                                int threads,
                                int vec,
                                rocke_attn_bwd_tile_chunk_t** out,
                                int* n_out);

/* py: zero_like. A zero of each type (f32 scalars, 16-bit vectors): the init values of a guard loop that yields loaded values. */
bool rocke_attn_bwd_zero_like(rocke_ir_builder_t* b,
                              const rocke_type_t* const* types,
                              int n_types,
                              rocke_value_t*** out,
                              int* n_out);
#ifdef __cplusplus
}
#endif
#endif /* ROCKE_HELPER_ROCKE_INSTANCES_COMMON__ATTENTION_BWD_COUNTED_H */
