/* py: RowSlab */
typedef enum rocke_attn_bwd_row_slab_kind
{
    ROCKE_ATTN_BWD_ROW_SLAB_KIND_ROW_SLAB = 0, /* RowSlab */
    ROCKE_ATTN_BWD_ROW_SLAB_KIND_BUFFER_ROW_SLAB = 1 /* BufferRowSlab, a duck-typed peer */
} rocke_attn_bwd_row_slab_kind_t;

typedef struct rocke_attn_bwd_row_slab
{
    rocke_attn_bwd_row_slab_kind_t kind; /* the member class (tagged value) */
    rocke_ir_builder_t* b;
    rocke_value_t* ptr;
    const rocke_type_t* dtype;
    rocke_attn_bwd_iv_t t_stride;
    rocke_value_t* base_row;
    rocke_value_t* last;
    int stage_vec;
    int narrow;
    rocke_attn_bwd_tuple_v_v_v_t parts;
    rocke_value_t* rsrc;
} rocke_attn_bwd_row_slab_t;

