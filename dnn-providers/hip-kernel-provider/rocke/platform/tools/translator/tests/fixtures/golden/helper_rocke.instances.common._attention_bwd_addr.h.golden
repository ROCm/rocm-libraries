                                           rocke_value_t* r,
                                           const rocke_attn_bwd_tuple_iv_v_t* items,
                                           int n_items,
                                           rocke_value_t* ok,
                                           char* reason,
                                           size_t reason_cap);

/* py: WsSlab.atomic_add_row_select. Branch-free :meth:`atomic_add_row`: every ``(x, v)`` pair is added. */
