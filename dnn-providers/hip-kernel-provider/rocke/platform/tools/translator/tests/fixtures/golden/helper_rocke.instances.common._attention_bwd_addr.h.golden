/* py: StridedTensorAddr.slab. Rebase to head ``h`` and tile row ``row0`` (i64 byte offset). */
rocke_attn_bwd_row_slab_t
    rocke_attn_bwd_strided_tensor_addr_slab(const rocke_attn_bwd_strided_tensor_addr_t* self,
                                            rocke_attn_bwd_iv_t h,
                                            rocke_attn_bwd_iv_t row0,
                                            bool clamp);

/* py: StridedTensorAddr.offset_bytes. The i64 byte offset :meth:`slab` adds to the base pointer for head ``h`` and (unclamped) row ``row0``. */
rocke_value_t* rocke_attn_bwd_strided_tensor_addr_offset_bytes(
    const rocke_attn_bwd_strided_tensor_addr_t* self,
    rocke_attn_bwd_iv_t h,
    rocke_attn_bwd_iv_t row0);

/* py: StridedTensorAddr.stride_bytes. The i64 byte stride of one head (``"h"``) or one row (``"t"``). */
rocke_value_t* rocke_attn_bwd_strided_tensor_addr_stride_bytes(
    const rocke_attn_bwd_strided_tensor_addr_t* self, const char* which);

/* py: StridedTensorAddr.slab_at. The slab whose pointer is the base plus the i64 byte offset ``off`` (:meth:`offset_bytes` of a head and of ``row0``, possibly carried across steps) at base row ``row0``. Equal to :meth:`slab` ``(h, row0, clamp=clamp)`` when ``row0 <= last`` (the clamp of the base row is then an identity), which holds for every q tile a q loop visits. */
rocke_attn_bwd_row_slab_t
    rocke_attn_bwd_strided_tensor_addr_slab_at(const rocke_attn_bwd_strided_tensor_addr_t* self,
                                               rocke_value_t* off,
