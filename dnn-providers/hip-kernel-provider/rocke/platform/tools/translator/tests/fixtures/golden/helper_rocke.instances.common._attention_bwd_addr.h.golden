/* py: chunk_coords. ``(row, column)`` of a ``vec``-element chunk of rows of ``per_row`` chunks: ``(chunk / per_row, (chunk % per_row) * vec)``; ``(chunk, 0)`` with no division for one chunk per row. */
rocke_attn_bwd_tuple_v_v_t
    rocke_attn_bwd_chunk_coords(rocke_ir_builder_t* b, rocke_value_t* chunk, int per_row, int vec);

/* py: deal_chunks. Thread ``tid``'s chunks of a ``total``-chunk tile dealt round-robin over ``threads`` threads: one ``(chunk, partial)`` per round, ``chunk = tid + round * threads`` (i32) and ``partial`` (a host bool) true for a round that reaches past ``total``, where the caller guards ``chunk < total``. */
rocke_attn_bwd_tuple_v_bool_t
    rocke_attn_bwd_deal_chunks(rocke_ir_builder_t* b, rocke_value_t* tid, int total, int threads);

