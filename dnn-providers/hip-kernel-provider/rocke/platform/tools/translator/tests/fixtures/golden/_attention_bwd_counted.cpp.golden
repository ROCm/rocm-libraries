/* py: tile_chunks (_attention_bwd_counted.py:103) */
std::vector<rocke_attn_bwd_tile_chunk_t> py_tile_chunks(
    rocke_ir_builder_t* b, int rows, int cols, rocke_value_t* tid, int threads, int vec)
{
    int64_t per_row = py::floordiv(cols, vec);
    int64_t total = (rows * per_row);
    std::vector<rocke_attn_bwd_tile_chunk_t> out;
    const int rounds_1 = rocke_attn_bwd_deal_chunks_count(b, total, threads);
    for(int round_2 = 0; round_2 < rounds_1; ++round_2)
    {
        bool tail{};
        rocke_value_t* chunk
            = rocke_attn_bwd_deal_chunks_round(b, tid, total, threads, round_2, &tail);
        rocke_value_t* sel_5{};
        if(tail)
        {
            rocke_value_t* const_i32_6 = rocke_b_const_i32(b, (total - 1));
            rocke_value_t* smin_7 = rocke_b_smin(b, chunk, const_i32_6);
            sel_5 = smin_7;
        }
        else
        {
            sel_5 = chunk;
        }
        rocke_value_t* src = sel_5;
        rocke_attn_bwd_tuple_v_v_t chunk_coords_8
            = rocke_attn_bwd_chunk_coords(b, src, (int)per_row, vec);
        rocke_value_t* r = chunk_coords_8.f0;
        rocke_value_t* c = chunk_coords_8.f1;
        out.push_back(rocke_attn_bwd_tile_chunk_t{
            .row = r, .col = c, .guard = ((tail) ? chunk : nullptr), .total = (int)total});
    }
    return out;
}

/* py: issue_tile_loads (_attention_bwd_counted.py:118) */
std::vector<rocke_value_t*>
    py_issue_tile_loads([[maybe_unused]] rocke_ir_builder_t* b,
                        const std::vector<rocke_attn_bwd_tile_loader_t>& loads,
                        const std::vector<rocke_attn_bwd_tile_chunk_t>& chunks)
{
    std::vector<rocke_value_t*> lst_1;
    for(rocke_attn_bwd_tile_loader_t const& load : loads)
    {
        for(rocke_attn_bwd_tile_chunk_t const& ch : chunks)
        {
            rocke_value_t* call_2 = load.fn(load.ctx, ch.row, ch.col);
            lst_1.push_back(call_2);
        }
    }
    return lst_1;
}

/* py: store_tile (_attention_bwd_counted.py:128) */
void py_store_tile(rocke_ir_builder_t* b,
                   const std::vector<rocke_attn_bwd_tile_view_t>& views,
                   const std::vector<rocke_attn_bwd_tile_chunk_t>& chunks,
                   const std::vector<rocke_value_t*>& values,
                   int vec)
{
    if(py::len(values) != (py::len(views) * py::len(chunks)))
    {
        throw ckc::ValueError(std::string("staged values do not match the tile chunks"));
    }
    py::iter<rocke_value_t*> it = py::iter<rocke_value_t*>(values);
    for(const rocke_attn_bwd_tile_view_t& view : views)
    {
        for(const rocke_attn_bwd_tile_chunk_t& ch : chunks)
        {
            rocke_value_t* val = it.next();
            if(ch.guard == nullptr)
            {
                view.store(view.ctx, b, ch.row, ch.col, val, vec);
            }
            else
            {
                rocke_value_t* const_i32_1 = rocke_b_const_i32(b, ch.total);
                rocke_value_t* cmp_lt_2 = rocke_b_cmp_lt(b, ch.guard, const_i32_1);
                rocke_if_t if_3 = rocke_b_scf_if(b, cmp_lt_2);
                rocke_b_region_enter(b, if_3.then_region);
                {
                    view.store(view.ctx, b, ch.row, ch.col, val, vec);
                }
                rocke_b_region_leave(b);
            }
        }
    }
}

