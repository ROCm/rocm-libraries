std::vector<rocke_value_t*> py_zero_like(rocke_ir_builder_t* b,
                                         const std::vector<const rocke_type_t*>& types)
{
    std::vector<rocke_value_t*> out;
    for(const rocke_type_t* t : types)
    {
        if(rocke_type_eq(t, rocke_f32()))
        {
            rocke_value_t* const_f32_1 = rocke_b_const_f32(b, 0.0);
            out.push_back(const_f32_1);
        }
        else if(t->kind == ROCKE_TYPE_VECTOR)
        {
            rocke_value_t* zero_vec_2 = rocke_b_zero_vec(b, t->elem, t->count);
            out.push_back(zero_vec_2);
        }
        else
        {
            throw ckc::ValueError(std::string("no zero for staged type ") + py::str(t));
        }
    }
    return out;
}

