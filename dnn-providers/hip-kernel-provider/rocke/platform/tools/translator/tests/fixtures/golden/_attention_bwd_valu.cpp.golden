    {
        return rocke_b_vec_cast_f32_to(b, frag, elem);
    }
    if(!py::eq(bf16_cast, "rne_noguard"))
    {
        throw ckc::ValueError(std::string("bf16_cast=") + py::repr(bf16_cast)
                              + " not in ('generic', 'rne_noguard')");
    }
    if(!rocke_type_eq(elem, rocke_bf16()))
    {
        throw ckc::ValueError(std::string("bf16_cast='rne_noguard' applies to bf16 operands only"));
    }
    return py_rne_noguard_bf16(b, frag);
}

/* py: softmax_p (_attention_bwd_valu.py:140) */
rocke_value_t* py_softmax_p(rocke_ir_builder_t* b,
                            rocke_value_t* sv,
                            rocke_value_t* scale_log2,
                            rocke_value_t* lse2,
                            rocke_value_t* neg_lse2,
                            const char* bwd_exp2)
{
    rocke_value_t* arg{};
    if(neg_lse2 == nullptr)
    {
        rocke_value_t* fmul_1 = rocke_b_fmul(b, sv, scale_log2);
        arg = rocke_b_fsub(b, fmul_1, lse2);
    }
    else
    {
        arg = rocke_b_fma(b, sv, scale_log2, neg_lse2);
    }
    if(py::eq(bwd_exp2, "exact"))
    {
        return rocke_b_exp2(b, arg);
    }
    if(py::eq(bwd_exp2, "fast"))
    {
        return rocke_b_exp2_fast(b, arg);
    }
    throw ckc::ValueError(std::string("bwd_exp2=") + py::repr(bwd_exp2)
                          + " not in ('exact', 'fast')");
}

