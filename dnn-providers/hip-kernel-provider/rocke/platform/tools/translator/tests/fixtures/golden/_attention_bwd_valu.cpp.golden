    }
    rocke_value_t* base = lse2->row0;
    if(!(((q0).v == nullptr) && ((q0).i == 0)))
    {
        rocke_value_t* as_i64_1 = rocke_attn_bwd_as_i64(b, q0, true);
        base = rocke_b_add(b, base, as_i64_1);
