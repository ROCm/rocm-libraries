    rocke_value_t* mul_13 = rocke_b_mul(b, as_i64_12, rows64);
    rocke_value_t* elem = rocke_b_add(b, mul_13, base_ws);
    rocke_value_t* as_i64_15 = rocke_attn_bwd_as_i64(b, n_heads, false);
    rocke_value_t* total = rocke_b_mul(b, as_i64_15, rows64);
    rocke_value_t* const_i64_17 = rocke_b_const_i64(b, (width - 1));
    rocke_value_t* back = rocke_attn_bwd_min64(b, elem, const_i64_17);
    rocke_value_t* const_i32_19 = rocke_b_const_i32(b, 0);
