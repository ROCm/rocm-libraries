/* py: cast_c_frag (_attention_bwd_valu.py:129) */
rocke_value_t* py_cast_c_frag(rocke_ir_builder_t* b,
                              rocke_value_t* frag,
                              const rocke_type_t* elem,
                              const char* bf16_cast)
{
