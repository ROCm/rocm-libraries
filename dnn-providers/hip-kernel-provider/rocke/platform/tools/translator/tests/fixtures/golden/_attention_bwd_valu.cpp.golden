        rocke_value_t* idx = rocke_b_sub(b, a, lo);
        rocke_value_t* vl = rocke_b_global_load_vN(b, p_l, idx, rocke_f32(), width, 4);
        rocke_value_t* vd = rocke_b_global_load_vN(b, p_d, idx, rocke_f32(), width, 4);
