/* py: stats_rows_neg (_attention_bwd_valu.py:270) */
py::dict<int64_t, rocke_value_t*>
    py_stats_rows_neg(rocke_ir_builder_t* b,
                      const py::dict<int64_t, std::array<rocke_value_t*, 2>>& stats)
{
    py::dict<int64_t, rocke_value_t*> dct_1;
    for(const auto& kv_2 : stats.items())
    {
        int64_t const key = kv_2.first;
        rocke_value_t* const lse2 = kv_2.second[0];
        [[maybe_unused]] rocke_value_t* const _dsum = kv_2.second[1];
        rocke_value_t* fneg_3 = rocke_b_fneg(b, lse2);
        dct_1.set(key, fneg_3);
    }
    return dct_1;
}

