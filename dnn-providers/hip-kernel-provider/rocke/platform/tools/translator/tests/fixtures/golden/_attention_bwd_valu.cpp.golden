rocke_value_t* rocke_attn_bwd_rne_noguard_bf16(rocke_ir_builder_t* b, rocke_value_t* frag)
{
    return py_adapt::on_builder<rocke_value_t*>(
        b, nullptr, [&]() -> rocke_value_t* { return py_rne_noguard_bf16(b, frag); });
}

rocke_value_t* rocke_attn_bwd_cast_c_frag(rocke_ir_builder_t* b,
                                          rocke_value_t* frag,
                                          const rocke_type_t* elem,
                                          const char* bf16_cast)
{
    return py_adapt::on_builder<rocke_value_t*>(b, nullptr, [&]() -> rocke_value_t* {
        return py_cast_c_frag(b, frag, elem, bf16_cast != nullptr ? bf16_cast : "generic");
    });
}

rocke_value_t* rocke_attn_bwd_softmax_p(rocke_ir_builder_t* b,
                                        rocke_value_t* sv,
                                        rocke_value_t* scale_log2,
                                        rocke_value_t* lse2,
                                        rocke_value_t* neg_lse2,
                                        const char* bwd_exp2)
{
    return py_adapt::on_builder<rocke_value_t*>(b, nullptr, [&]() -> rocke_value_t* {
        return py_softmax_p(
            b, sv, scale_log2, lse2, neg_lse2, bwd_exp2 != nullptr ? bwd_exp2 : "exact");
    });
}

bool rocke_attn_bwd_check_stats_vec_layout(rocke_ir_builder_t* b,
                                           const rocke_mma_op_t* op,
                                           int width)
{
    return py_adapt::on_builder<bool>(b, false, [&]() -> bool {
        py_check_stats_vec_layout(b, op, width);
        return rocke_ir_builder_ok(b);
    });
}

bool rocke_attn_bwd_batched_stats_rows(rocke_ir_builder_t* b,
                                       const rocke_attn_bwd_workspace_addr_t* lse2,
                                       const rocke_attn_bwd_workspace_addr_t* dsum,
                                       rocke_value_t* h,
                                       rocke_attn_bwd_iv_t q0,
                                       rocke_value_t* const* rows,
                                       int n_rows,
                                       int width,
                                       rocke_attn_bwd_iv_t n_heads,
                                       rocke_value_t*** out_0,
                                       rocke_value_t*** out_1,
                                       int* n_out)
{
    return py_adapt::on_builder<bool>(b, false, [&]() -> bool {
        const std::vector<rocke_value_t*> rows_v(rows, rows + n_rows);
        const auto res_ = py_batched_stats_rows(b, lse2, dsum, h, q0, rows_v, width, n_heads);
        py_adapt::own_out(res_, out_0, [](const auto& x) { return (rocke_value_t*)x[0]; });
        py_adapt::own_out(res_, out_1, [](const auto& x) { return (rocke_value_t*)x[1]; });
        *n_out = (int)res_.size();
        return rocke_ir_builder_ok(b);
    });
}

bool rocke_attn_bwd_stats_rows_neg(rocke_ir_builder_t* b,
                                   const int* stats_keys,
                                   rocke_value_t* const* stats_vals_0,
                                   rocke_value_t* const* stats_vals_1,
                                   int n_stats,
                                   int** out_keys,
                                   rocke_value_t*** out_vals,
                                   int* n_out)
{
    return py_adapt::on_builder<bool>(b, false, [&]() -> bool {
        py::dict<int64_t, std::array<rocke_value_t*, 2>> stats_v;
        for(int i = 0; i < n_stats; ++i)
            stats_v.set(stats_keys[i],
                        std::array<rocke_value_t*, 2>{stats_vals_0[i], stats_vals_1[i]});
        const auto res_ = py_stats_rows_neg(b, stats_v);
        py_adapt::own_out(res_, out_keys, [](const auto& x) { return (int)x.first; });
        py_adapt::own_out(res_, out_vals, [](const auto& x) { return (rocke_value_t*)x.second; });
        *n_out = (int)res_.size();
        return rocke_ir_builder_ok(b);
    });
}
