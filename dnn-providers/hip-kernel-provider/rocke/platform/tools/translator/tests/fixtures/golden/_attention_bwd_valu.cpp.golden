void py_check_stats_vec_layout(rocke_ir_builder_t* b, const rocke_mma_op_t* op, int width)
{
    if(!(width == 1 || width == 2 || width == 4))
    {
        throw ckc::ValueError(std::string("stats_vec=") + py::repr(width) + " not in (1, 2, 4)");
    }
    const rocke_layout_map_t* a_1 = py_adapt::c_layout(op);
    py::tuple<py::tuple<std::array<int64_t, 2>>> lanes = py_adapt::eval_layout(b, a_1);
    int64_t n = py::len(py::at(lanes, 0));
    if(py::mod(n, width) != 0)
    {
        throw ckc::ValueError(std::string("stats_vec=") + py::str(width) + ": the C fragment of "
                              + py::str(op->op_id) + " has " + py::str(n) + " slots");
    }
    for(const py::tuple<std::array<int64_t, 2>>& coords : lanes)
    {
        for(int64_t g : py::range(0, n, width))
        {
            const auto unpack_3 = py::at(coords, g);
            int64_t r0 = unpack_3[0];
            int64_t c0 = unpack_3[1];
            bool any_4 = false;
            for(int64_t j : py::range(width))
            {
                if(py::at(coords, (g + j)) != (std::array<int64_t, 2>{(r0 + j), c0}))
                {
                    any_4 = true;
                    break;
                }
            }
            if(any_4)
            {
                throw ckc::ValueError(std::string("stats_vec=") + py::str(width)
                                      + ": the C rows of " + py::str(op->op_id)
                                      + " are not runs of " + py::str(width)
                                      + " consecutive rows (a lane holds " + py::str(coords) + ")");
            }
        }
    }
}

