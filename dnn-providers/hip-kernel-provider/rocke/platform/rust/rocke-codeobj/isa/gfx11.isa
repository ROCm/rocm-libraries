# gfx11 instruction description for the direct compiler (rust/rocke-codeobj).
# Written by `platform/tools/isa_tables.py import` from the Rust sources and isa/gfx11.overlay;
# keep hand-written knowledge in the overlay. After `switch`, this file is the
# source of the opcode rows, VOPD forms and latency classes. Keys are
# documented in the overlay.

[meta]
# Target facts.
meta target gfx1151
meta isa gfx11
meta wave 32

[flags]
# Compiler flag bits (mir.rs F_*), with the implicit register each one states.
flag DEF_SCC bit=0 imp=def:scc
flag USE_SCC bit=1 imp=use:scc
flag USE_VCC bit=2 imp=use:vcc
flag DEF_EXEC bit=3 imp=def:exec
flag USE_EXEC bit=4 imp=use:exec
flag VMEM_LOAD bit=5
flag VMEM_STORE bit=6
flag LDS bit=7
flag SMEM bit=8
flag BRANCH bit=9
flag TRANS bit=10
flag WMMA bit=11
flag TIED bit=12
flag 64BIT_SRC bit=13
flag 16BIT_DST bit=14
flag 16BIT_SRC bit=15
flag END bit=16
flag EARLY bit=17
flag FENCE bit=18

[alias]
# Flag aliases (mir.rs `const NAME: u32 = F_..`).
alias VALU flags=USE_EXEC

[mods]
# MInst modifier bits (mir.rs M_*).
mod NEG0 bit=0
mod NEG1 bit=1
mod NEG2 bit=2
mod OPSEL_SRC0 bit=4
mod OPSEL_SRC1 bit=5
mod OPSEL_SRC2 bit=6
mod OPSEL_DST bit=7
mod SADDR bit=8
mod MIX_F16_0 bit=9
mod GLC bit=12

[modset]
# Modifier sets an instruction may accept (`m=`), by M_ bit.
modset neg "neg (VOP3) or neg_lo (VOP3P) of sources 0-2" bits=0,1,2
modset opsel "op_sel: the high half of sources 0-2" bits=4,5,6
modset opsel_dst "op_sel: the high half of the destination" bits=7
modset saddr "global address through saddr: SGPR base plus 32-bit VGPR offset" bits=8
modset mix "v_fma_mix: f16 sources (op_sel_hi)" bits=9,10,11
modset glc "GLC: an atomic returns the old value" bits=12

[fmt]
# Rust formats (mir.rs Fmt) and their encodings.
fmt Sop1 enc=SOP1
fmt Sop2 enc=SOP2
fmt Sopc enc=SOPC
fmt Sopk enc=SOPK
fmt Sopp enc=SOPP
fmt Smem enc=SMEM
fmt Vop1 enc=VOP1 vop3=0x180
fmt Vop2 enc=VOP2 vop3=0x100
fmt Vop3 enc=VOP3
fmt Vop3b enc=VOP3SD
fmt Vopc enc=VOPC layout=VOP3
fmt Vop3p enc=VOP3P
fmt Vopd enc=VOPD
fmt Ds enc=DS imp=use:exec
fmt Global enc=GLOBAL imp=use:exec
fmt Mubuf enc=MUBUF imp=use:exec
fmt Pseudo enc=PSEUDO table=no

[enc]
# Encoding layouts: fixed bits per word, fields as name:word:lsb:width.
enc SOP1 "sdst = op(ssrc0)" words=1 fixed=0xbe800000 fields=ssrc0:0:0:8,op:0:8:8,sdst:0:16:7
enc SOP2 "sdst = op(ssrc0, ssrc1)" words=1 fixed=0x80000000 fields=ssrc0:0:0:8,ssrc1:0:8:8,sdst:0:16:7,op:0:23:7
enc SOPC "scc = op(ssrc0, ssrc1)" words=1 fixed=0xbf000000 fields=ssrc0:0:0:8,ssrc1:0:8:8,op:0:16:7
enc SOPK "sdst and a 16-bit immediate" words=1 fixed=0xb0000000 fields=simm16:0:0:16,sdst:0:16:7,op:0:23:5
enc SOPP "program control with a 16-bit immediate" words=1 fixed=0xbf800000 fields=simm16:0:0:16,op:0:16:7
enc SMEM "scalar memory" words=2 fixed=0xf4000000,0x00000000 fields=sbase:0:0:6,sdata:0:6:7,dlc:0:13:1,glc:0:14:1,op:0:18:8,offset:1:0:21,soffset:1:25:7
enc VOP1 "vdst = op(src0)" words=1 fixed=0x7e000000 fields=src0:0:0:9,op:0:9:8,vdst:0:17:8
enc VOP2 "vdst = op(src0, vsrc1)" words=1 fixed=0x00000000 fields=src0:0:0:9,vsrc1:0:9:8,vdst:0:17:8,op:0:25:6
enc VOPC "vcc = op(src0, vsrc1); the compiler always uses the VOP3 form" words=1 fixed=0x7c000000 fields=src0:0:0:9,vsrc1:0:9:8,op:0:17:8
enc VOP3 "three-source VALU (also VOP1, VOP2 and VOPC promoted)" words=2 fixed=0xd4000000,0x00000000 fields=vdst:0:0:8,abs:0:8:3,op_sel:0:11:4,clamp:0:15:1,op:0:16:10,src0:1:0:9,src1:1:9:9,src2:1:18:9,omod:1:27:2,neg:1:29:3
enc VOP3SD "VOP3 with a scalar destination (carry, div_scale flag)" words=2 fixed=0xd4000000,0x00000000 fields=vdst:0:0:8,sdst:0:8:7,clamp:0:15:1,op:0:16:10,src0:1:0:9,src1:1:9:9,src2:1:18:9,omod:1:27:2,neg:1:29:3
enc VOP3P "packed and mixed-precision VALU, WMMA" words=2 fixed=0xcc000000,0x00000000 fields=vdst:0:0:8,neg_hi:0:8:3,op_sel:0:11:3,op_sel_hi2:0:14:1,clamp:0:15:1,op:0:16:7,src0:1:0:9,src1:1:9:9,src2:1:18:9,op_sel_hi:1:27:2,neg:1:29:3
enc VOPD "two VALU operations issued together" words=2 fixed=0xc8000000,0x00000000 fields=src0x:0:0:9,vsrc1x:0:9:8,opy:0:17:5,opx:0:22:4,src0y:1:0:9,vsrc1y:1:9:8,vdsty:1:17:7,vdstx:1:24:8
enc DPP16 "second word of a VOP1 with a DPP16 source" words=1 fixed=0x00000000 fields=src0:0:0:8,ctrl:0:8:24
enc DPP8 "second word of a VOP1 with a DPP8 source" words=1 fixed=0x00000000 fields=src0:0:0:8,sel:0:8:24
enc DS "local data share" words=2 fixed=0xd8000000,0x00000000 fields=offset:0:0:16,gds:0:17:1,op:0:18:8,addr:1:0:8,data0:1:8:8,data1:1:16:8,vdst:1:24:8
enc FLAT "flat memory (segment 0)" words=2 fixed=0xdc000000,0x00000000 fields=offset:0:0:13,dlc:0:13:1,glc:0:14:1,slc:0:15:1,op:0:18:8,addr:1:0:8,data:1:8:8,saddr:1:16:7,sve:1:23:1,vdst:1:24:8
enc SCRATCH "scratch memory (FLAT segment 1)" words=2 fixed=0xdc010000,0x00000000 fields=offset:0:0:13,dlc:0:13:1,glc:0:14:1,slc:0:15:1,op:0:18:8,addr:1:0:8,data:1:8:8,saddr:1:16:7,sve:1:23:1,vdst:1:24:8
enc GLOBAL "global memory (FLAT segment 2)" words=2 fixed=0xdc020000,0x00000000 fields=offset:0:0:13,dlc:0:13:1,glc:0:14:1,slc:0:15:1,op:0:18:8,addr:1:0:8,data:1:8:8,saddr:1:16:7,sve:1:23:1,vdst:1:24:8
enc MUBUF "buffer memory" words=2 fixed=0xe0000000,0x00000000 fields=offset:0:0:12,slc:0:12:1,dlc:0:13:1,glc:0:14:1,op:0:18:8,vaddr:1:0:8,vdata:1:8:8,srsrc:1:16:5,tfe:1:21:1,offen:1:22:1,idxen:1:23:1,soffset:1:24:8

[opnd]
# Operand codes and classes.
reg vcc_lo code=106
reg vcc_hi code=107
reg null code=124
reg m0 code=125
reg exec_lo code=126
reg exec_hi code=127
reg scc code=253
src sgpr=0 vgpr=256 literal=255 dpp16=250 dpp8=233 half_hi=128
inline_int lo=-16 hi=64 zero=128 neg=192
inline_f32 0x3f000000=240 0xbf000000=241 0x3f800000=242 0xbf800000=243 0x40000000=244 0xc0000000=245 0x40800000=246 0xc0800000=247 0x3e22f983=248
inline_f64 0x3fe00000=240 0xbfe00000=241 0x3ff00000=242 0xbff00000=243 0x40000000=244 0xc0000000=245 0x40100000=246 0xc0100000=247
class s "SGPR tuple; as a 1-dword destination also vcc_lo, exec_lo, m0 or null"
class ss "scalar source: SGPR, special register, inline constant or literal"
class v "VGPR tuple"
class vs "vector source: VGPR, SGPR, special register, inline constant or literal"
class vi "vector source without a literal: VGPR, SGPR or inline constant"
class vh "16-bit half of a VGPR (op_sel or .h picks the high half)"
class vsh "16-bit vector source: a VGPR half, SGPR or inline constant"
class x "EXEC, named as an explicit operand"
class a "any register (pseudo)"
imm simm16 "16-bit immediate field"
imm soff21 "21-bit signed byte offset"
imm off16 "16-bit unsigned byte offset"
imm off2x8 "two 8-bit dword offsets: offset0 | offset1 << 8"
imm off13s "13-bit signed byte offset"
imm off12 "12-bit unsigned byte offset"
imm label "branch target block (resolved to a word offset by the assembler)"
imm nop "wait states minus one"
imm clause "instructions in the clause minus one"
imm delay "s_delay_alu instid0, instskip, instid1"
imm waitcnt "vmcnt, expcnt, lgkmcnt"
imm sendmsg "message id"
imm swizzle "ds_swizzle pattern"
imm vopd "X and Y component opcodes in bits 7:0 and 15:8"
imm dpp16 "DPP16 control: bits 31:8 of word 1"
imm dpp8 "DPP8 lane selects"
form plain "the format's general encoding"
form noshort "a VOP2 opcode always encoded as VOP3 (its lane mask is explicit)"
form dpp16 "VOP1 with a DPP16 source: imm holds bits 31:8 of word 1"
form dpp8 "VOP1 with a DPP8 source: imm holds the 24-bit lane selects"
form writelane "VOP3 with two encoded sources and no f32 inline constants"
form mix "VOP3P taking op_sel and op_sel_hi from the modifiers"
form ds_data "DS with both a result and data0 (returning atomics, bpermute)"
form ds_2addr "DS with data0 and data1 (two-address store)"
form scratch "SCRATCH (FLAT segment 1) with no address operands: the offset is in imm"
form b64 "SALU with 64-bit integer sources: no f32 inline constants (a literal is zero-extended)"
form b64_shift "SALU 64-bit shift: source 0 as in b64, source 1 the 32-bit shift amount"
form f64 "VALU with f64 sources: a non-inline-integer immediate is the high dword (an f64 inline constant or a literal)"
form f64_i32 "as f64, but source 1 is the 32-bit integer exponent (v_ldexp_f64)"
form dot2 "VOP3P with 16-bit pair sources 0 and 1 (no f32 inline constants) and an f32 source 2"
form vscnt "SOPK whose register must be null (s_waitcnt_vscnt)"

[unit]
# Execution units.
unit VALU "vector ALU" issue=1
unit TRANS "transcendental unit" issue=4
unit WMMA "matrix unit (WMMA)" issue=34
unit SALU "scalar ALU" issue=1
unit SMEM "scalar memory" issue=5
unit VMEM "vector memory (global, buffer, scratch)" issue=5
unit LDS "local data share" issue=4
unit BRANCH branch issue=1
unit CTRL "program control: waits, hints, barriers, priority, end" issue=0
unit PSEUDO "pseudo instruction, expanded or dropped before encoding" issue=0
unit OTHER other issue=1

[lat]
# Latency classes: scheduler result latency, s_delay_alu class and cycles, wait counters.
lat pseudo "pseudo without a result latency (copies, implicit defs, scheduling barriers)" sched=0 delay=skip
lat pseudo_valu "pseudo expanded into VALU instructions" sched=5 delay=skip
lat salu "scalar ALU" sched=2 delay=salu:2
lat ctrl "program control (SOPP): no result; s_delay_alu counts it as SALU" sched=5 delay=salu:2
lat valu "vector ALU" sched=5 delay=valu:5
lat trans transcendental sched=10 delay=trans:10
lat wmma "WMMA: the scheduler waits 16 cycles; s_delay_alu treats it as VALU" sched=16 delay=valu:5
lat smem "scalar load: lgkmcnt, returns out of order" sched=40 delay=other wait=lgkm,smem
lat lds "LDS access: lgkmcnt" sched=40 delay=other clear=yes wait=lgkm
lat vmem_load "vector memory load or returning atomic: vmcnt" sched=300 delay=other clear=yes wait=vm
lat vmem_store "vector memory store, atomic without return or cache control" sched=5 delay=other clear=yes

[hazard]
# Hazards and where the compiler handles them.
hazard wmma_d "WMMA result: the producer side of wmma_ab" modeled=post.rs:fix_wmma_hazards
hazard wmma_ab "a WMMA reading as A or B the result of the immediately preceding VALU, if that is a WMMA, needs a v_nop between them" modeled=post.rs:fix_wmma_hazards

[vopd]
# VOPD components: code, mnemonic, half (x: either, y: Y only); named=yes when mir.rs names it.
vopd 0 v_dual_fmac_f32 x named=yes
vopd 1 v_dual_fmaak_f32 x
vopd 2 v_dual_fmamk_f32 x
vopd 3 v_dual_mul_f32 x named=yes
vopd 4 v_dual_add_f32 x named=yes
vopd 5 v_dual_sub_f32 x named=yes
vopd 6 v_dual_subrev_f32 x named=yes
vopd 7 v_dual_mul_dx9_zero_f32 x
vopd 8 v_dual_mov_b32 x named=yes
vopd 9 v_dual_cndmask_b32 x
vopd 10 v_dual_max_f32 x named=yes
vopd 11 v_dual_min_f32 x named=yes
vopd 12 v_dual_dot2acc_f32_f16 x
vopd 13 v_dual_dot2acc_f32_bf16 x
vopd 16 v_dual_add_nc_u32 y named=yes
vopd 17 v_dual_lshlrev_b32 y named=yes
vopd 18 v_dual_and_b32 y named=yes

[vcmp]
# VOPC compares the compiler names (Opc::VCmp(code)).
vcmp 0x10 v_cmp_f_f32 src=f32
vcmp 0x11 v_cmp_lt_f32 src=f32
vcmp 0x12 v_cmp_eq_f32 src=f32
vcmp 0x13 v_cmp_le_f32 src=f32
vcmp 0x14 v_cmp_gt_f32 src=f32
vcmp 0x15 v_cmp_lg_f32 src=f32
vcmp 0x16 v_cmp_ge_f32 src=f32
vcmp 0x17 v_cmp_o_f32 src=f32
vcmp 0x18 v_cmp_u_f32 src=f32
vcmp 0x19 v_cmp_nge_f32 src=f32
vcmp 0x1a v_cmp_nlg_f32 src=f32
vcmp 0x1b v_cmp_ngt_f32 src=f32
vcmp 0x1c v_cmp_nle_f32 src=f32
vcmp 0x1d v_cmp_neq_f32 src=f32
vcmp 0x1e v_cmp_nlt_f32 src=f32
vcmp 0x1f v_cmp_t_f32 src=f32
vcmp 0x40 v_cmp_f_i32 src=i32
vcmp 0x41 v_cmp_lt_i32 src=i32
vcmp 0x42 v_cmp_eq_i32 src=i32
vcmp 0x43 v_cmp_le_i32 src=i32
vcmp 0x44 v_cmp_gt_i32 src=i32
vcmp 0x45 v_cmp_ne_i32 src=i32
vcmp 0x46 v_cmp_ge_i32 src=i32
vcmp 0x47 v_cmp_t_i32 src=i32
vcmp 0x48 v_cmp_f_u32 src=u32
vcmp 0x49 v_cmp_lt_u32 src=u32
vcmp 0x4a v_cmp_eq_u32 src=u32
vcmp 0x4b v_cmp_le_u32 src=u32
vcmp 0x4c v_cmp_gt_u32 src=u32
vcmp 0x4d v_cmp_ne_u32 src=u32
vcmp 0x4e v_cmp_ge_u32 src=u32
vcmp 0x4f v_cmp_t_u32 src=u32
vcmp 0x50 v_cmp_f_i64 src=i64
vcmp 0x51 v_cmp_lt_i64 src=i64
vcmp 0x52 v_cmp_eq_i64 src=i64
vcmp 0x53 v_cmp_le_i64 src=i64
vcmp 0x54 v_cmp_gt_i64 src=i64
vcmp 0x55 v_cmp_ne_i64 src=i64
vcmp 0x56 v_cmp_ge_i64 src=i64
vcmp 0x57 v_cmp_t_i64 src=i64
vcmp 0x58 v_cmp_f_u64 src=u64
vcmp 0x59 v_cmp_lt_u64 src=u64
vcmp 0x5a v_cmp_eq_u64 src=u64
vcmp 0x5b v_cmp_le_u64 src=u64
vcmp 0x5c v_cmp_gt_u64 src=u64
vcmp 0x5d v_cmp_ne_u64 src=u64
vcmp 0x5e v_cmp_ge_u64 src=u64
vcmp 0x5f v_cmp_t_u64 src=u64
vcmp 0x7e v_cmp_class_f32 src=f32

[inst]
# Instructions: variant, mnemonic, encoding, opcode, then key=value facts (keys in the overlay header).
group SOP1
inst   SMovB32           s_mov_b32                 SOP1    0x00   flags=0 d=sdst:s1 u=ssrc0:ss1 unit=SALU lat=salu
inst   SMovB64           s_mov_b64                 SOP1    0x01   flags=0 d=sdst:s2 u=ssrc0:ss2 unit=SALU lat=salu form=b64
inst   SNotB32           s_not_b32                 SOP1    0x1e   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1 imp=def:scc unit=SALU lat=salu
inst   SAndSaveexecB32   s_and_saveexec_b32        SOP1    0x20   flags=DEF_SCC|DEF_EXEC|USE_EXEC d=sdst:s1,exec:x1 u=ssrc0:ss1,exec:x1 imp=def:exec,def:scc,use:exec unit=SALU lat=salu
group SOP2
inst   SAddU32           s_add_u32                 SOP2    0x00   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SSubU32           s_sub_u32                 SOP2    0x01   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SAddI32           s_add_i32                 SOP2    0x02   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SSubI32           s_sub_i32                 SOP2    0x03   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SAddcU32          s_addc_u32                SOP2    0x04   flags=DEF_SCC|USE_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc,use:scc unit=SALU lat=salu
inst   SSubbU32          s_subb_u32                SOP2    0x05   flags=DEF_SCC|USE_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc,use:scc unit=SALU lat=salu
inst   SLshlB32          s_lshl_b32                SOP2    0x08   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SLshlB64          s_lshl_b64                SOP2    0x09   flags=DEF_SCC d=sdst:s2 u=ssrc0:ss2,ssrc1:ss1 imp=def:scc unit=SALU lat=salu form=b64_shift
inst   SLshrB32          s_lshr_b32                SOP2    0x0a   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SLshrB64          s_lshr_b64                SOP2    0x0b   flags=DEF_SCC d=sdst:s2 u=ssrc0:ss2,ssrc1:ss1 imp=def:scc unit=SALU lat=salu form=b64_shift
inst   SAshrI32          s_ashr_i32                SOP2    0x0c   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SAshrI64          s_ashr_i64                SOP2    0x0d   flags=DEF_SCC d=sdst:s2 u=ssrc0:ss2,ssrc1:ss1 imp=def:scc unit=SALU lat=salu form=b64_shift
inst   SLshl1AddU32      s_lshl1_add_u32           SOP2    0x0e   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SLshl2AddU32      s_lshl2_add_u32           SOP2    0x0f   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SLshl3AddU32      s_lshl3_add_u32           SOP2    0x10   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SLshl4AddU32      s_lshl4_add_u32           SOP2    0x11   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SMinI32           s_min_i32                 SOP2    0x12   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SMinU32           s_min_u32                 SOP2    0x13   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SMaxI32           s_max_i32                 SOP2    0x14   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SMaxU32           s_max_u32                 SOP2    0x15   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SAndB32           s_and_b32                 SOP2    0x16   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SAndB64           s_and_b64                 SOP2    0x17   flags=DEF_SCC d=sdst:s2 u=ssrc0:ss2,ssrc1:ss2 imp=def:scc unit=SALU lat=salu form=b64
inst   SOrB32            s_or_b32                  SOP2    0x18   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SOrB64            s_or_b64                  SOP2    0x19   flags=DEF_SCC d=sdst:s2 u=ssrc0:ss2,ssrc1:ss2 imp=def:scc unit=SALU lat=salu form=b64
inst   SXorB32           s_xor_b32                 SOP2    0x1a   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SXorB64           s_xor_b64                 SOP2    0x1b   flags=DEF_SCC d=sdst:s2 u=ssrc0:ss2,ssrc1:ss2 imp=def:scc unit=SALU lat=salu form=b64
inst   SAndNot1B32       s_and_not1_b32            SOP2    0x22   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SOrNot1B32        s_or_not1_b32             SOP2    0x24   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SBfeU32           s_bfe_u32                 SOP2    0x26   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SMulI32           s_mul_i32                 SOP2    0x2c   flags=0 d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 unit=SALU lat=salu issue=2
inst   SMulHiU32         s_mul_hi_u32              SOP2    0x2d   flags=0 d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 unit=SALU lat=salu issue=2
