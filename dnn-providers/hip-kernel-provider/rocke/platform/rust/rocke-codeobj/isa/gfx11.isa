inst   Copy              COPY                      PSEUDO  0x00   flags=0 d=dst:a1 u=src:a1 unit=PSEUDO lat=pseudo
inst   ImplicitDef       IMPLICIT_DEF              PSEUDO  0x00   flags=0 d=dst:a1 unit=PSEUDO lat=pseudo note="Defines a register whose contents are never read before overwritten."
inst   PackF16           PACK_F16                  PSEUDO  0x00   flags=VALU|EARLY d=vdst:v1 u=src0:vs1,src1:vs1 imp=use:exec unit=PSEUDO lat=pseudo_valu note="dst <- {cvt_f16(src0), cvt_f16(src1)}; dst must not overlap the sources."
inst   SchedBarrier      SCHED_BARRIER             PSEUDO  0x00   flags=FENCE unit=PSEUDO lat=pseudo note="`tile.sched_barrier` with mask 0: a scheduling boundary that emits nothing."
family VCmp              v_cmp_*                   VOPC    code   flags=macro d=sdst:s1 u=src0:vs1,src1:vs1 m=neg,opsel imp=use:exec unit=VALU lat=valu

[burs]
# BURS grammar for integer and address arithmetic (see the overlay header).
nt s "uniform value in an SGPR"
nt v "value in a VGPR"
nt k constant
nt ssrc "SALU source: an SGPR or a constant"
nt vsrc "VALU source: a VGPR, an SGPR or a constant"
term add kind=Add
term sub kind=Sub
term mul kind=Mul
term mulhu kind=UmulHi
term mulhi kind=SmulHi
term and kind=And
term or kind=Or
term xor kind=Xor
term shl kind=Shl
term lshr kind=Lshr
term ashr kind=Ashr
term smin kind=Smin
term smax kind=Smax
term konst leaf=konst
term sreg leaf=sreg
term vreg leaf=vreg
weight VALU 2
weight TRANS 2
weight WMMA 2
weight SALU 1
pred u24 "both values are known to be below 2^24 (opt.rs ranges)"
pred shift1to4 "a constant shift amount of 1 to 4"
pred fits3 "three sources within VOP3's scalar limit: two SGPRs or literals, one literal"
rule s sreg
rule v vreg
rule k konst
rule ssrc s
rule ssrc k
rule vsrc v
rule vsrc s
rule vsrc k
rule s add(a:ssrc,b:ssrc) emit=hand inst=SAddI32
rule s sub(a:ssrc,b:ssrc) emit=hand inst=SSubI32
rule s mul(a:ssrc,b:ssrc) emit=hand inst=SMulI32
rule s mulhu(a:ssrc,b:ssrc) emit=hand inst=SMulHiU32
rule s mulhi(a:ssrc,b:ssrc) emit=hand inst=SMulHiI32
rule s and(a:ssrc,b:ssrc) emit=hand inst=SAndB32
rule s or(a:ssrc,b:ssrc) emit=hand inst=SOrB32
rule s xor(a:ssrc,b:ssrc) emit=hand inst=SXorB32
rule s shl(a:ssrc,b:ssrc) emit=hand inst=SLshlB32
rule s lshr(a:ssrc,b:ssrc) emit=hand inst=SLshrB32
rule s ashr(a:ssrc,b:ssrc) emit=hand inst=SAshrI32
rule s smin(a:ssrc,b:ssrc) emit=hand inst=SMinI32
rule s smax(a:ssrc,b:ssrc) emit=hand inst=SMaxI32
rule s add(shl(a:ssrc,n:k),b:ssrc) if=shift1to4(n) emit=lshladd(a,n,b) inst=SLshl1AddU32
rule s add(b:ssrc,shl(a:ssrc,n:k)) if=shift1to4(n) emit=lshladd(a,n,b) inst=SLshl1AddU32
rule v add(a:vsrc,b:vsrc) emit=hand inst=VAddNcU32
rule v sub(a:vsrc,b:vsrc) emit=hand inst=VSubNcU32
rule v mul(a:vsrc,b:vsrc) if=u24(a,b) emit=hand inst=VMulU32U24
rule v mul(a:vsrc,b:vsrc) if=!u24(a,b) emit=hand inst=VMulLoU32
rule v mulhu(a:vsrc,b:vsrc) if=u24(a,b) emit=hand inst=VMulHiU32U24
rule v mulhu(a:vsrc,b:vsrc) if=!u24(a,b) emit=hand inst=VMulHiU32
rule v mulhi(a:vsrc,b:vsrc) emit=hand inst=VMulHiI32
rule v and(a:vsrc,b:vsrc) emit=hand inst=VAndB32
rule v or(a:vsrc,b:vsrc) emit=hand inst=VOrB32
rule v xor(a:vsrc,b:vsrc) emit=hand inst=VXorB32
rule v shl(a:vsrc,b:vsrc) emit=hand inst=VLshlrevB32
rule v lshr(a:vsrc,b:vsrc) emit=hand inst=VLshrrevB32
rule v ashr(a:vsrc,b:vsrc) emit=hand inst=VAshrrevI32
rule v smin(a:vsrc,b:vsrc) emit=hand inst=VMinI32
rule v smax(a:vsrc,b:vsrc) emit=hand inst=VMaxI32
rule v add(add(a:vsrc,b:vsrc),c:vsrc) if=fits3(a,b,c) emit=v3c(a,b,c) inst=VAdd3U32
rule v add(c:vsrc,add(a:vsrc,b:vsrc)) if=fits3(a,b,c) emit=v3c(a,b,c) inst=VAdd3U32
rule v add(shl(a:vsrc,b:vsrc),c:vsrc) if=fits3(a,b,c) emit=v3(a,b,c) inst=VLshlAddU32
rule v add(c:vsrc,shl(a:vsrc,b:vsrc)) if=fits3(a,b,c) emit=v3(a,b,c) inst=VLshlAddU32
rule v shl(add(a:vsrc,b:vsrc),c:vsrc) if=fits3(a,b,c) emit=v3c(a,b,c) inst=VAddLshlU32
rule v or(shl(a:vsrc,b:vsrc),c:vsrc) if=fits3(a,b,c) emit=v3(a,b,c) inst=VLshlOrB32
rule v or(c:vsrc,shl(a:vsrc,b:vsrc)) if=fits3(a,b,c) emit=v3(a,b,c) inst=VLshlOrB32
rule v or(and(a:vsrc,b:vsrc),c:vsrc) if=fits3(a,b,c) emit=v3c(a,b,c) inst=VAndOrB32
rule v or(c:vsrc,and(a:vsrc,b:vsrc)) if=fits3(a,b,c) emit=v3c(a,b,c) inst=VAndOrB32
rule v or(or(a:vsrc,b:vsrc),c:vsrc) if=fits3(a,b,c) emit=v3c(a,b,c) inst=VOr3B32
rule v or(c:vsrc,or(a:vsrc,b:vsrc)) if=fits3(a,b,c) emit=v3c(a,b,c) inst=VOr3B32
rule v add(mul(a:vsrc,b:vsrc),c:vsrc) if=u24(a,b)&fits3(a,b,c) emit=v3c(a,b,c) inst=VMadU32U24
rule v add(c:vsrc,mul(a:vsrc,b:vsrc)) if=u24(a,b)&fits3(a,b,c) emit=v3c(a,b,c) inst=VMadU32U24
rule v smax(smin(a:vsrc,b:vsrc),c:vsrc) if=fits3(a,b,c) emit=v3c(a,b,c) inst=VMinmaxI32
rule v smax(c:vsrc,smin(a:vsrc,b:vsrc)) if=fits3(a,b,c) emit=v3c(a,b,c) inst=VMinmaxI32
rule v smin(smax(a:vsrc,b:vsrc),c:vsrc) if=fits3(a,b,c) emit=v3c(a,b,c) inst=VMaxminI32
rule v smin(c:vsrc,smax(a:vsrc,b:vsrc)) if=fits3(a,b,c) emit=v3c(a,b,c) inst=VMaxminI32
