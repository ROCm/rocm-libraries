# gfx950 instruction description for the direct compiler (rust/rocke-codeobj): authored, not imported.
# `platform/tools/isa_tables.py generate --isa gfx950` writes src/target/gfx9/gen_isa.rs from it, and
# `isa_tables.py check --isa gfx950` fails while that would change the file; gfx950 has no import or
# switch. The format and keys are those of isa/gfx11.isa (documented in isa/gfx11.overlay).
#
# Rows are the gfx950 twins of the shared opcodes (src/rir/mir.rs `Opc`, which keeps its gfx11 names):
# mnemonic, encoding and opcode are gfx950's, from the gfx9 records of LLVM's AMDGPU TableGen sources
# read as a specification (a gfx9 record wins over a VI one), and every encoding is checked against
# `llvm-mc -mcpu=gfx950` by `platform/tools/isa_xcheck.py --isa gfx950`. Flags are the shared, semantic
# flags of the variant (the same as in isa/gfx11.isa). Lane masks (compare results, carries, v_cndmask
# selectors, VCC) are SGPR pairs on wave64. VOP3 encodings take no literal on gfx9, and there is no
# null register (code 124 is M0). Shared opcodes gfx950 lacks have no row: v_mov_b16 and other true16
# forms, DPP8, VOPD, WMMA, s_clause, s_delay_alu, s_code_end, s_waitcnt_vscnt, v_maxmin/v_minmax,
# v_permlane16/x16, the gfx11 cache invalidations, and the 32-bit saveexec.

[meta]
# Target facts.
meta target gfx950
meta isa gfx9
meta wave 64

[flags]
# Compiler flag bits (mir.rs F_*), with the implicit register each one states.
flag DEF_SCC bit=0 imp=def:scc
flag USE_SCC bit=1 imp=use:scc
flag USE_VCC bit=2 imp=use:vcc
flag DEF_EXEC bit=3 imp=def:exec
flag USE_EXEC bit=4 imp=use:exec
flag VMEM_LOAD bit=5
flag VMEM_STORE bit=6
flag LDS bit=7
flag SMEM bit=8
flag BRANCH bit=9
flag TRANS bit=10
flag WMMA bit=11
flag TIED bit=12
flag 64BIT_SRC bit=13
flag 16BIT_DST bit=14
flag 16BIT_SRC bit=15
flag END bit=16
flag EARLY bit=17
flag FENCE bit=18

[alias]
# Flag aliases (mir.rs `const NAME: u32 = F_..`).
alias VALU flags=USE_EXEC

[mods]
# MInst modifier bits (mir.rs M_*).
mod NEG0 bit=0
mod NEG1 bit=1
mod NEG2 bit=2
mod OPSEL_SRC0 bit=4
mod OPSEL_SRC1 bit=5
mod OPSEL_SRC2 bit=6
mod OPSEL_DST bit=7
mod SADDR bit=8
mod MIX_F16_0 bit=9
mod GLC bit=12

[modset]
# Modifier sets an instruction may accept (`m=`), by M_ bit. The gfx9 encoder refuses any other bit.
modset neg "neg of float sources 0-2 (VOP3 neg, VOP3P neg_lo); a VOP1 or VOP2 with neg is encoded as VOP3" bits=0,1,2
modset opsel "the high half of 16-bit sources 0-2: gfx9 VOP3 op_sel opcodes, SDWA src0_sel:WORD_1 on VOP1" bits=4,5,6
modset opsel_dst "op_sel: the high half of the destination" bits=7
modset saddr "global address through saddr: SGPR base plus 32-bit VGPR offset" bits=8
modset mix "v_fma_mix: f16 sources (op_sel_hi)" bits=9,10,11
modset glc "sc0: an atomic returns the old value" bits=12

[fmt]
# Rust formats (mir.rs Fmt) and their gfx9 encodings; vop3: opcode offset of the VOP3 form.
fmt Sop1 enc=SOP1
fmt Sop2 enc=SOP2
fmt Sopc enc=SOPC
fmt Sopk enc=SOPK
fmt Sopp enc=SOPP
fmt Smem enc=SMEM
fmt Vop1 enc=VOP1 vop3=0x140
fmt Vop2 enc=VOP2 vop3=0x100
fmt Vop3 enc=VOP3
fmt Vop3b enc=VOP3B
fmt Vopc enc=VOPC layout=VOP3
fmt Vop3p enc=VOP3P
fmt Ds enc=DS imp=use:exec
fmt Global enc=GLOBAL imp=use:exec
fmt Mubuf enc=MUBUF imp=use:exec
fmt Pseudo enc=PSEUDO table=no

[enc]
# Encoding layouts: fixed bits per word, fields as name:word:lsb:width (gfx9, with the gfx940 cache policy
# bits sc0, sc1 and nt in the memory formats).
enc SOP1 "sdst = op(ssrc0)" words=1 fixed=0xbe800000 fields=ssrc0:0:0:8,op:0:8:8,sdst:0:16:7
enc SOP2 "sdst = op(ssrc0, ssrc1)" words=1 fixed=0x80000000 fields=ssrc0:0:0:8,ssrc1:0:8:8,sdst:0:16:7,op:0:23:7
enc SOPC "scc = op(ssrc0, ssrc1)" words=1 fixed=0xbf000000 fields=ssrc0:0:0:8,ssrc1:0:8:8,op:0:16:7
enc SOPK "sdst and a 16-bit immediate" words=1 fixed=0xb0000000 fields=simm16:0:0:16,sdst:0:16:7,op:0:23:5
enc SOPP "program control with a 16-bit immediate" words=1 fixed=0xbf800000 fields=simm16:0:0:16,op:0:16:7
enc SMEM "scalar memory, immediate offset" words=2 fixed=0xc0020000,0x00000000 fields=sbase:0:0:6,sdata:0:6:7,glc:0:16:1,op:0:18:8,offset:1:0:21
enc VOP1 "vdst = op(src0)" words=1 fixed=0x7e000000 fields=src0:0:0:9,op:0:9:8,vdst:0:17:8
enc VOP2 "vdst = op(src0, vsrc1)" words=1 fixed=0x00000000 fields=src0:0:0:9,vsrc1:0:9:8,vdst:0:17:8,op:0:25:6
enc VOPC "vcc = op(src0, vsrc1); the compiler always uses the VOP3 form" words=1 fixed=0x7c000000 fields=src0:0:0:9,vsrc1:0:9:8,op:0:17:8
enc VOP3 "three-source VALU (also VOP1, VOP2 and VOPC promoted); no literal" words=2 fixed=0xd0000000,0x00000000 fields=vdst:0:0:8,abs:0:8:3,op_sel:0:11:4,clamp:0:15:1,op:0:16:10,src0:1:0:9,src1:1:9:9,src2:1:18:9,omod:1:27:2,neg:1:29:3
enc VOP3B "VOP3 with a scalar destination (carry, div_scale flag); no literal" words=2 fixed=0xd0000000,0x00000000 fields=vdst:0:0:8,sdst:0:8:7,clamp:0:15:1,op:0:16:10,src0:1:0:9,src1:1:9:9,src2:1:18:9,omod:1:27:2,neg:1:29:3
enc VOP3P "packed and mixed-precision VALU; no literal" words=2 fixed=0xd3800000,0x00000000 fields=vdst:0:0:8,neg_hi:0:8:3,op_sel:0:11:3,op_sel_hi2:0:14:1,clamp:0:15:1,op:0:16:7,src0:1:0:9,src1:1:9:9,src2:1:18:9,op_sel_hi:1:27:2,neg:1:29:3
enc DPP "second word of a VOP1 with a DPP source: ctrl is bits 31:8 (dpp_ctrl, bound_ctrl, bank and row masks)" words=1 fixed=0x00000000 fields=src0:0:0:8,ctrl:0:8:24
enc SDWA "second word of a VOP1 with an SDWA source" words=1 fixed=0x00000000 fields=src0:0:0:8,dst_sel:0:8:3,dst_unused:0:11:2,clamp:0:13:1,omod:0:14:2,src0_sel:0:16:3,src0_sext:0:19:1,src0_neg:0:20:1,src0_abs:0:21:1,s0:0:23:1
enc DS "local data share" words=2 fixed=0xd8000000,0x00000000 fields=offset:0:0:16,gds:0:16:1,op:0:17:8,acc:0:25:1,addr:1:0:8,data0:1:8:8,data1:1:16:8,vdst:1:24:8
enc FLAT "flat memory (segment 0)" words=2 fixed=0xdc000000,0x00000000 fields=offset:0:0:13,lds:0:13:1,sc0:0:16:1,nt:0:17:1,op:0:18:7,sc1:0:25:1,addr:1:0:8,data:1:8:8,saddr:1:16:7,acc:1:23:1,vdst:1:24:8
enc SCRATCH "scratch memory (FLAT segment 1)" words=2 fixed=0xdc004000,0x00000000 fields=offset:0:0:13,lds:0:13:1,sc0:0:16:1,nt:0:17:1,op:0:18:7,sc1:0:25:1,addr:1:0:8,data:1:8:8,saddr:1:16:7,acc:1:23:1,vdst:1:24:8
enc GLOBAL "global memory (FLAT segment 2)" words=2 fixed=0xdc008000,0x00000000 fields=offset:0:0:13,lds:0:13:1,sc0:0:16:1,nt:0:17:1,op:0:18:7,sc1:0:25:1,addr:1:0:8,data:1:8:8,saddr:1:16:7,acc:1:23:1,vdst:1:24:8
enc MUBUF "buffer memory" words=2 fixed=0xe0000000,0x00000000 fields=offset:0:0:12,offen:0:12:1,idxen:0:13:1,sc0:0:14:1,sc1:0:15:1,lds:0:16:1,nt:0:17:1,op:0:18:7,vaddr:1:0:8,vdata:1:8:8,srsrc:1:16:5,acc:1:23:1,soffset:1:24:8

[opnd]
# Operand codes and classes. There is no null register on gfx9: code 124 is M0, and 102-105 are
# FLAT_SCRATCH and XNACK_MASK, never handed out.
reg vcc_lo code=106
reg vcc_hi code=107
reg m0 code=124
reg exec_lo code=126
reg exec_hi code=127
reg scc code=253
src sgpr=0 vgpr=256 literal=255 dpp=250 sdwa=249 saddr_off=127
inline_int lo=-16 hi=64 zero=128 neg=192
inline_f32 0x3f000000=240 0xbf000000=241 0x3f800000=242 0xbf800000=243 0x40000000=244 0xc0000000=245 0x40800000=246 0xc0800000=247 0x3e22f983=248
inline_f64 0x3fe00000=240 0xbfe00000=241 0x3ff00000=242 0xbff00000=243 0x40000000=244 0xc0000000=245 0x40100000=246 0xc0100000=247
class s "SGPR tuple; as a 1-dword destination also vcc_lo, exec_lo or m0; a lane mask is an SGPR pair, VCC or EXEC"
class ss "scalar source: SGPR, special register, inline constant or literal"
class v "VGPR tuple"
class vs "vector source: VGPR, SGPR, special register, inline constant, or a literal when not VOP3-encoded"
class vi "vector source without a literal: VGPR, SGPR or inline constant"
class x "EXEC, named as an explicit operand"
class a "any register (pseudo)"
imm simm16 "16-bit immediate field"
imm soff21 "21-bit signed byte offset"
imm off16 "16-bit unsigned byte offset"
imm off2x8 "two 8-bit dword offsets: offset0 | offset1 << 8"
imm off13s "13-bit signed byte offset"
imm off12 "12-bit unsigned byte offset"
imm label "branch target block (resolved to a word offset by the assembler)"
imm nop "wait states minus one"
imm waitcnt "gfx9 s_waitcnt: vmcnt bits 3:0 and 15:14, expcnt 6:4, lgkmcnt 11:8"
imm sendmsg "message id"
imm swizzle "ds_swizzle pattern"
imm dpp16 "DPP control: bits 31:8 of the DPP word (gfx9 controls only; no fi bit)"
form plain "the format's general encoding"
form noshort "a VOP2 opcode always encoded as VOP3 (its lane mask is explicit)"
form dpp16 "VOP1 with a DPP source: imm holds bits 31:8 of the DPP word"
form sdwa_hi "VOP1 with a 16-bit source: op_sel on source 0 is an SDWA word with src0_sel:WORD_1"
form writelane "VOP3 with two encoded sources and no f32 inline constants"
form mix "VOP3P taking op_sel and op_sel_hi from the modifiers"
form ds_data "DS with both a result and data0 (returning atomics, bpermute)"
form ds_2addr "DS with data0 and data1 (two-address store)"
form scratch "SCRATCH (FLAT segment 1) with no address operands: the offset is in imm"
form b64 "SALU with 64-bit integer sources: no f32 inline constants (a literal is zero-extended)"
form b64_shift "SALU 64-bit shift: source 0 as in b64, source 1 the 32-bit shift amount"
form f64 "VALU with f64 sources: a non-inline-integer immediate is the high dword (an f64 inline constant or a literal)"
form f64_i32 "as f64, but source 1 is the 32-bit integer exponent (v_ldexp_f64)"
form dot2 "VOP3P with 16-bit pair sources 0 and 1 (no f32 inline constants) and an f32 source 2"
form src16 "VOP3 with 16-bit sources: no f32 inline constants"

[unit]
# Execution units.
unit VALU "vector ALU" issue=1
unit TRANS "transcendental unit" issue=1
unit SALU "scalar ALU" issue=1
unit SMEM "scalar memory" issue=1
unit VMEM "vector memory (global, buffer, scratch)" issue=1
unit LDS "local data share" issue=1
unit BRANCH branch issue=1
unit CTRL "program control: waits, barriers, priority, end" issue=0
unit PSEUDO "pseudo instruction, expanded or dropped before encoding" issue=0

[lat]
# Latency classes: scheduler result latency (initial values from the ISA documents; S8 fits them on
# gfx950), the s_delay_alu class (none on gfx9: other), and the wait counters an instruction
# increments. gfx9 counts vector memory stores in vmcnt, as loads.
lat pseudo "pseudo without a result latency (copies, implicit defs, scheduling barriers)" sched=0 delay=skip
lat pseudo_valu "pseudo expanded into VALU instructions" sched=8 delay=skip
lat salu "scalar ALU" sched=2 delay=other
lat ctrl "program control (SOPP): no result" sched=4 delay=other
lat valu "vector ALU (wave64: four cycles per instruction)" sched=8 delay=other
lat trans "transcendental" sched=16 delay=other
lat smem "scalar load: lgkmcnt, returns out of order" sched=40 delay=other wait=lgkm,smem
lat lds "LDS access: lgkmcnt" sched=64 delay=other wait=lgkm
lat vmem_load "vector memory load or returning atomic: vmcnt" sched=500 delay=other wait=vm
lat vmem_store "vector memory store or atomic without return: vmcnt" sched=8 delay=other wait=vm

[hazard]
# The gfx940/gfx950 hazard rules of G1_DESIGN.md section 5.1, all handled in target/gfx9/hazards.rs.
hazard h1 "VALU writes an SGPR or VCC, a VALU reads it: 2 wait states" modeled=target/gfx9/hazards.rs
hazard h2 "VALU writes EXEC, v_readlane/v_readfirstlane/v_writelane: 4" modeled=target/gfx9/hazards.rs
hazard h3 "VALU writes a VGPR, v_readlane/v_readfirstlane reads it as src0: 1" modeled=target/gfx9/hazards.rs
hazard h4 "VALU writes an SGPR, v_readlane/v_writelane lane select: 4" modeled=target/gfx9/hazards.rs
hazard h5 "VALU writes an SGPR, VMEM reads it (srsrc, soffset, saddr): 5" modeled=target/gfx9/hazards.rs
hazard h6 "VALU writes VCC, v_div_fmas: 4" modeled=target/gfx9/hazards.rs
hazard h7 "VALU writes EXEC, DPP: 5; VALU writes a VGPR, DPP reads it: 2" modeled=target/gfx9/hazards.rs
hazard h8 "transcendental, a non-transcendental VALU reads its result: 1" modeled=target/gfx9/hazards.rs
hazard h9 "dst-sel forwarding (SDWA, op_sel destination, VOP3P DST_OP_SEL), a VALU reads or overwrites it: 1" modeled=target/gfx9/hazards.rs
hazard h10 "VMEM store of more than 64 bits, a VALU overwrites its data: 1 or 2" modeled=target/gfx9/hazards.rs
hazard h11 "XNACK soft clause: no instruction of an SMEM or VMEM clause writes a register the clause reads" modeled=target/gfx9/hazards.rs
hazard h12 "SALU writes M0, LDS DMA / s_sendmsg / ds_*_addtid: 1" modeled=target/gfx9/hazards.rs
hazard h13 "s_setreg, then s_getreg or s_setreg of the same register: 2" modeled=target/gfx9/hazards.rs
hazard h14 "VALU writes a VGPR, v_permlane*_swap reads it: 2; v_cmpx writes EXEC, permlane: 4" modeled=target/gfx9/hazards.rs
hazard h15 "64-bit shift with its amount in a VGPR at 7 mod 8 and the next VGPR unused: an allocation constraint" modeled=target/gfx9/hazards.rs
hazard h16 "inline asm: only the empty value barrier is accepted" modeled=target/gfx9/hazards.rs

[vcmp]
# VOPC compares the compiler names (Opc::VCmp(code), the gfx11 code) and their gfx950 opcodes (op=).
vcmp 0x10 v_cmp_f_f32 src=f32 op=0x40
vcmp 0x11 v_cmp_lt_f32 src=f32 op=0x41
vcmp 0x12 v_cmp_eq_f32 src=f32 op=0x42
vcmp 0x13 v_cmp_le_f32 src=f32 op=0x43
vcmp 0x14 v_cmp_gt_f32 src=f32 op=0x44
vcmp 0x15 v_cmp_lg_f32 src=f32 op=0x45
vcmp 0x16 v_cmp_ge_f32 src=f32 op=0x46
vcmp 0x17 v_cmp_o_f32 src=f32 op=0x47
vcmp 0x18 v_cmp_u_f32 src=f32 op=0x48
vcmp 0x19 v_cmp_nge_f32 src=f32 op=0x49
vcmp 0x1a v_cmp_nlg_f32 src=f32 op=0x4a
vcmp 0x1b v_cmp_ngt_f32 src=f32 op=0x4b
vcmp 0x1c v_cmp_nle_f32 src=f32 op=0x4c
vcmp 0x1d v_cmp_neq_f32 src=f32 op=0x4d
vcmp 0x1e v_cmp_nlt_f32 src=f32 op=0x4e
vcmp 0x1f v_cmp_tru_f32 src=f32 op=0x4f
vcmp 0x40 v_cmp_f_i32 src=i32 op=0xc0
vcmp 0x41 v_cmp_lt_i32 src=i32 op=0xc1
vcmp 0x42 v_cmp_eq_i32 src=i32 op=0xc2
vcmp 0x43 v_cmp_le_i32 src=i32 op=0xc3
vcmp 0x44 v_cmp_gt_i32 src=i32 op=0xc4
vcmp 0x45 v_cmp_ne_i32 src=i32 op=0xc5
vcmp 0x46 v_cmp_ge_i32 src=i32 op=0xc6
vcmp 0x47 v_cmp_t_i32 src=i32 op=0xc7
vcmp 0x48 v_cmp_f_u32 src=u32 op=0xc8
vcmp 0x49 v_cmp_lt_u32 src=u32 op=0xc9
vcmp 0x4a v_cmp_eq_u32 src=u32 op=0xca
vcmp 0x4b v_cmp_le_u32 src=u32 op=0xcb
vcmp 0x4c v_cmp_gt_u32 src=u32 op=0xcc
vcmp 0x4d v_cmp_ne_u32 src=u32 op=0xcd
vcmp 0x4e v_cmp_ge_u32 src=u32 op=0xce
vcmp 0x4f v_cmp_t_u32 src=u32 op=0xcf
vcmp 0x50 v_cmp_f_i64 src=i64 op=0xe0
vcmp 0x51 v_cmp_lt_i64 src=i64 op=0xe1
vcmp 0x52 v_cmp_eq_i64 src=i64 op=0xe2
vcmp 0x53 v_cmp_le_i64 src=i64 op=0xe3
vcmp 0x54 v_cmp_gt_i64 src=i64 op=0xe4
vcmp 0x55 v_cmp_ne_i64 src=i64 op=0xe5
vcmp 0x56 v_cmp_ge_i64 src=i64 op=0xe6
vcmp 0x57 v_cmp_t_i64 src=i64 op=0xe7
vcmp 0x58 v_cmp_f_u64 src=u64 op=0xe8
vcmp 0x59 v_cmp_lt_u64 src=u64 op=0xe9
vcmp 0x5a v_cmp_eq_u64 src=u64 op=0xea
vcmp 0x5b v_cmp_le_u64 src=u64 op=0xeb
vcmp 0x5c v_cmp_gt_u64 src=u64 op=0xec
vcmp 0x5d v_cmp_ne_u64 src=u64 op=0xed
vcmp 0x5e v_cmp_ge_u64 src=u64 op=0xee
vcmp 0x5f v_cmp_t_u64 src=u64 op=0xef
vcmp 0x7e v_cmp_class_f32 src=f32 op=0x10

[inst]
# Instructions: variant, mnemonic, encoding, opcode, then key=value facts (keys as in isa/gfx11.overlay).
group SOP1
inst   SMovB32           s_mov_b32                 SOP1    0x0    flags=0 d=sdst:s1 u=ssrc0:ss1 unit=SALU lat=salu
inst   SMovB64           s_mov_b64                 SOP1    0x1    flags=0 d=sdst:s2 u=ssrc0:ss2 unit=SALU lat=salu form=b64
inst   SNotB32           s_not_b32                 SOP1    0x4    flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1 imp=def:scc unit=SALU lat=salu
inst   SNotB64           s_not_b64                 SOP1    0x5    flags=DEF_SCC d=sdst:s2 u=ssrc0:ss2 imp=def:scc unit=SALU lat=salu form=b64
inst   SAndSaveexecB64   s_and_saveexec_b64        SOP1    0x20   flags=DEF_SCC|DEF_EXEC|USE_EXEC d=sdst:s2,exec:x2 u=ssrc0:ss2,exec:x2 imp=def:exec,def:scc,use:exec unit=SALU lat=salu form=b64
group SOP2
inst   SAddU32           s_add_u32                 SOP2    0x0    flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SSubU32           s_sub_u32                 SOP2    0x1    flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SAddI32           s_add_i32                 SOP2    0x2    flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SSubI32           s_sub_i32                 SOP2    0x3    flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SAddcU32          s_addc_u32                SOP2    0x4    flags=DEF_SCC|USE_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc,use:scc unit=SALU lat=salu
inst   SSubbU32          s_subb_u32                SOP2    0x5    flags=DEF_SCC|USE_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc,use:scc unit=SALU lat=salu
inst   SLshlB32          s_lshl_b32                SOP2    0x1c   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SLshlB64          s_lshl_b64                SOP2    0x1d   flags=DEF_SCC d=sdst:s2 u=ssrc0:ss2,ssrc1:ss1 imp=def:scc unit=SALU lat=salu form=b64_shift
inst   SLshrB32          s_lshr_b32                SOP2    0x1e   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SLshrB64          s_lshr_b64                SOP2    0x1f   flags=DEF_SCC d=sdst:s2 u=ssrc0:ss2,ssrc1:ss1 imp=def:scc unit=SALU lat=salu form=b64_shift
inst   SAshrI32          s_ashr_i32                SOP2    0x20   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SAshrI64          s_ashr_i64                SOP2    0x21   flags=DEF_SCC d=sdst:s2 u=ssrc0:ss2,ssrc1:ss1 imp=def:scc unit=SALU lat=salu form=b64_shift
inst   SLshl1AddU32      s_lshl1_add_u32           SOP2    0x2e   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
inst   SLshl2AddU32      s_lshl2_add_u32           SOP2    0x2f   flags=DEF_SCC d=sdst:s1 u=ssrc0:ss1,ssrc1:ss1 imp=def:scc unit=SALU lat=salu
