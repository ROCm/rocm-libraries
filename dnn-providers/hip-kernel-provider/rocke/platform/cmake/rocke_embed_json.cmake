#
# cmake -DIN=<file> -DOUT=<generated .cpp> -DSYMBOL=<C function> -P rocke_embed_json.cmake
#
# Writes a C++ source whose extern "C" function SYMBOL returns the NUL-terminated
# contents of IN (a data file of the rocKE tree, e.g. the tuned GETT route table),
# so the engine carries it and its C++ consumers need no Python tree at run time.
# The bytes are emitted as an array (no string-literal length limits); OUT is
# rewritten only when its contents change.
file(READ "${IN}" _hex HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
get_filename_component(_name "${IN}" NAME)
file(WRITE "${OUT}.tmp"
     "// Generated by cmake/rocke_embed_json.cmake from ${_name} -- do not edit.\n"
     "static const unsigned char k_data[] = {${_bytes}0x00};\n"
     "extern \"C\" const char* ${SYMBOL}(void)\n"
     "{\n"
     "    return reinterpret_cast<const char*>(k_data);\n"
     "}\n")
configure_file("${OUT}.tmp" "${OUT}" COPYONLY)
file(REMOVE "${OUT}.tmp")
