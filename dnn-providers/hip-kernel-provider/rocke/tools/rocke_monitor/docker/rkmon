    def show_summary(self, doc, made, rows: list, first: bool = True) -> list:
        """The confirm step's summary of DOC, the deploy settings document, as MADE, what it makes on this host
        (deploy_plan.plan), delivers: every setting (confirm.render), with the configuration the container runs with
        them (runtime_config.from_settings), where docker publishes its dashboards (MADE's variables), the image it
        names, and DOC's updates section, which only the host reads; then their check rows (ROWS: the file's and its
        settings' own, confirm_checks'; the image's, confirm.image_rows, from its own code when it is on this host,
        recipe_changes; the models', model_checks; check 16's, claude_env_checks), then, while this host serves the
        team dashboard, who can reach it (confirm.exposure), printed; the check rows. FIRST: before the first start,
        which the rows that wait for a later step name.
        """
        ck, c = self.lib("checks"), self.lib("confirm")
        run = self.lib("runtime_config").from_settings(made.layer["settings"])
        ref = self.made_image(made)
        labels, logins = self.summary_inputs(ref.reference)
        updates = doc.values.get(self.lib("from_layout1").UPDATES)
        say(c.render(made, run.values, labels, logins, updates))
        here = labels is not None
        code = self.recipe_changes(ref.reference) if here else None
        checks = c.checks(
            run,
            doc,
            rows,
            c.image_rows(ref.reference, code, first, pull=bool(ref.registry)),
            self.model_checks(ref.reference if here else None, made, run.values, first),
            claude=self.claude_env_checks(
                doc, made, run.values, *self.claude_env_images(made, first)
            ),
        )
        say("\nThe checks:")
        say(ck.render(checks) if checks else "  every check passes")
        exposed = c.exposure(made.variables)
        if exposed:
            say(f"\nnote: {exposed}")
        return checks

    def model_checks(self, ref, made, values: dict, first: bool, names=None) -> list:
        """The model rows (confirm.model_rows) of the configuration VALUES, or of the models NAMES among them, each
        called from a one-off container of the image REF (None while it is not on this host) on the network of the
        deployment MADE names (deploy_plan.plan), once docker has it (deployment_network, model_answers). FIRST: before
        the first start."""
        c = self.lib("confirm")
        answers = None
        if ref is not None and (names is None or names):
            network = self.deployment_network(made.variables["COMPOSE_PROJECT_NAME"])
            if network:
                urls = [
                    u
                    for n, _p, u, _used in c.models_in_use(values)
                    if u and (names is None or n in names)
                ]
                answers = self.model_answers(ref, network, list(dict.fromkeys(urls)))
        return c.model_rows(values, answers, first, names)

    def deployed(self):
        """The last confirm this folder's records keep, while this folder's container exists under the container name
        it recorded: confirm then shows only what changes. None else, and
        while the records cannot be read (the state's guard then says why)."""
        try:
            was = self.confirmed()
        except (OSError, ValueError):
            return None
        if was is None or self.whose(was.container_name) != self.lib("identity").OURS:
            return None
        return was

    def change_plan_now(self, doc) -> tuple:
        """What confirming DOC, deploy settings in this package's layout, changes on this folder's deployment
        (rkmon_lib/change_plan.py): (the plan, the delivered layer that runs, a mapping, ""), or (None, None, why it
        cannot be told). What runs: the delivered layer in the settings volume (delivered_layer), read through a
        container of the image docker/.env names, only while it is on this host, and docker/.env and the override
        (deliver.on_host: private_files.Refused when either breaks a private file's rules). The package that
        delivered the layer, by the version and the code the layer names: this one; else the one rkmon package update
        keeps beside this folder (<folder>.prev; change_plan.package_in) when it is that package (by its version
        alone, for another version); else, for other code under this version, this package with that code, its schema
        and defaults the nearest known (the plan's package line shows the code change).
        """
        cp, dp, sf = (
            self.lib("change_plan"),
            self.lib("deploy_plan"),
            self.lib("settings_file"),
        )
        ref = self.image_ref()
        if self.image_labels(ref) is None:
            return (
                None,
                None,
                f"the image docker/.env names, {ref}, is not on this host",
            )
        text = self.delivered_layer(variables=self.compose_variables())
        if text is None:
            return None, None, "the settings volume has no settings that can be read"
        found = self.lib("deliver").on_host(self.pkg)
        try:
            layer = json.loads(text)
            made_by, made_code = layer["package_version"], layer["code_sha256"]
        except (ValueError, KeyError, TypeError):
            return None, None, "the settings that run cannot be read"
        image = self.lib("image")
        now = cp.Package(
            image.package_version(self.pkg),
            self.lib("file_types").DEPLOY,
            self.lib("registry").package_defaults(),
            image.code_sha256(self.pkg),
        )
        then = now
        if (made_by, made_code) != (now.version, now.code):
            prev = f"{self.pkg}.prev"
            try:
                kept = cp.package_in(prev)
            except ValueError:
                kept = None
            if kept is not None and (kept.version, kept.code) == (made_by, made_code):
                then = kept
            elif made_by == now.version:
                then = now._replace(code=made_code)
            elif kept is not None and kept.version == made_by:
                then = kept
            else:
                return (
                    None,
                    None,
                    f"package {made_by} delivered the settings that run, and neither this package nor the one in "
                    f"{sf.shown(prev)} is that package",
                )
        host = dp.Host(os.getuid(), os.getgid(), self.lib("records").timestamp())
        try:
            plan = cp.plan(cp.Applied(text, *found), cp.Confirmed(doc, host), then, now)
        except (ValueError, KeyError, TypeError) as exc:
            return None, None, f"the settings that run cannot be read ({exc})"
        return plan, layer, ""

    def change_checks(self, doc, made, layer: dict, plan, rows: list) -> list:
        """The check rows the changes of PLAN call for, of DOC, the deploy settings document, as MADE, what
        it makes on this host (deploy_plan.plan), against LAYER, the delivered layer that runs: the file's and its
        settings' own (ROWS) and the configuration's (confirm.checks); the image's (confirm.image_rows), when the image
        or the package changes; the rows of the models the changes bring (confirm.models_added, model_checks); a
        SKIP for each login and secret they need that is not set yet (confirm.login_skips), as `rk logins --json` in
        the container lists them; and check 16's (claude_env_checks), read by the image the settings name, else by the
        one the deployment runs. Printed; the check rows."""
        ck, c = self.lib("checks"), self.lib("confirm")
        from_settings = self.lib("runtime_config").from_settings
        run = from_settings(made.layer["settings"])
        image = made.layer["container"]["image"]
        ref = self.made_image(made)
        here = self.image_labels(ref.reference) is not None
        container = layer.get("container")
        ran_image = container.get("image") if isinstance(container, dict) else None
        images = []
        if plan.package is not None or ran_image != image:
            code = self.recipe_changes(ref.reference) if here else None
            images = c.image_rows(ref.reference, code, False, pull=bool(ref.registry))
        ran = from_settings(layer.get("settings") or {}).values
        added = c.models_added(run.values, ran)
        models = self.model_checks(
            ref.reference if here else None, made, run.values, False, added
        )
        logins = c.login_skips(run.values, self.logins_rows())
        claude = self.claude_env_checks(
            doc, made, run.values, *self.claude_env_images(made, False)
        )
        checks = c.checks(run, doc, rows, images, models, logins, claude)
        say("\nThe checks:")
        say(ck.render(checks) if checks else "  every check passes")
        return checks

    def show_changes(self, doc, made, file: str, rows: list) -> tuple:
        """Confirm after the first start: what confirming DOC, the deploy settings document of FILE, as
        MADE, what it makes on this host (deploy_plan.plan), changes on this folder's deployment (change_plan_now), each
        change with how it applies (confirm.change_lines, with the configuration MADE's settings make), then, when a
        change serves the team dashboard or moves the address or port it is served on, who can reach it
        (confirm.exposure_changed, against docker/.env as it is), what apply will do for them (confirm.apply_lines, with
        the package's drain limit), and the checks they call for (change_checks), printed: (the check rows, how many
        changes). While what runs cannot be read: a note that says why, then the summary as before the first start
        (show_summary): (its check rows, None). First, while the monitor runs, NoAnswer unless it says which settings it
        runs: the state's next line, once the confirm is recorded, asks it (state_facts.gather).
        """
        c, answers = self.lib("confirm"), DockerAnswers(self)
        project = made.variables["COMPOSE_PROJECT_NAME"]
        if answers.container(project)[0] == self.lib("states").RUNNING:
            answers.monitor(project)
        changed = datetime.datetime.fromtimestamp(
            os.path.getmtime(file), datetime.timezone.utc
        )
        when = self.lib("progress").shown_time(changed)
        say(
            f"your deploy settings file: {self.lib('settings_file').shown(file)} (changed {when})\n"
        )
        plan, layer, why = self.change_plan_now(doc)
        if plan is None:
            say(f"note: what changes cannot be shown ({why}): every setting is shown\n")
            return self.show_summary(doc, made, rows, first=False), None
        values = self.lib("runtime_config").from_settings(made.layer["settings"]).values
        lines, count = c.change_lines(plan, values)
        say("\n".join(lines))
        exposed = c.exposure_changed(self.dotenv(), made.variables)
        if exposed:
            say(f"\nnote: {exposed}")
        if count:
            drain = self.lib("commands").drain_timeout_minutes()
            say("\n" + "\n".join(c.apply_lines(count, plan.restarts, drain)))
        return self.change_checks(doc, made, layer, plan, rows), count

    def confirm_checks(self, file: str, retry) -> tuple:
        """(the configuration the settings make, the check rows) of FILE, a deploy settings file's full path, as the
        confirm reads it before its summary: the file as a private file (settings_file_checks; RETRY names another file
        in a fix), as deploy settings (settings_cfg), then confirm's rows of the settings (deployment.confirm_rows:
        their own checks, the container's share of this host and the team's skills folder they name), check 6's
        read once no row failed (ticket_rows), and whose container.name is on this host (deployment.name_row). The
        configuration is None when a row refused the file.
        """
        d, ck = self.lib("deployment"), self.lib("checks")
        checks = self.settings_file_checks(file, retry)
        cfg = None
        if not ck.failed(checks):
            cfg = self.settings_cfg(file)[0]
            checks += self.problems
        if cfg is not None:
            checks += d.confirm_rows(cfg, file, self.pkg)
            if not ck.failed(checks):  # check 6's read, through the writer
                checks += self.ticket_rows(cfg, file)
            name = d.project(cfg)
            row = d.name_row(name, *self.owner_of(name)[:2], file) if name else None
            if row is not None:
                checks.append(row)
        return cfg, checks

    def new_name_refused(self, cfg, file: str):
        """Check 14, at confirm only: while this folder's container exists under the container name the last
        confirm recorded, the deploy settings CFG of the file FILE that name another are refused, for the new name
        would start a second, empty deployment: REFUSED, with the fix that sets the name back, and its exit code. None
        when the settings name the same, or no container of this folder's exists."""
        was = self.confirmed()
        if was is None or self.lib("deployment").project(cfg) == was.container_name:
            return None
        if self.whose(was.container_name) != self.lib("identity").OURS:
            return None
        ck = self.lib("checks")
        fix = ck.Steps(
            (
                ck.Edit(
                    "container.name",
                    self.lib("settings_file").shown(file),
                    was.container_name,
                ),
                '; for a second deployment on this host, see QUICK_DEPLOY_GUIDE.md, "Several deployments"',
            )
        )
        return self.lib("outcome").finish(
            "REFUSED",
            f"this package folder runs the deployment {was.container_name}; a new container.name would start a "
            "second, empty one; nothing changed",
            fix=fix,
            next=self.again_line(),
        )

    def cmd_confirm(self, ns) -> int:
        """`confirm [--settings FILE] [--yes]`: FILE (without it, the file the last confirm
        recorded) checked (confirm_checks), shown, and confirmed by you: then this folder's records keep it
        (records.confirm: the settings' fingerprint, the file, its own values' digest, this package's version and the
        SHA-256 of its code (image.code_sha256), the container name, the image and how many changes it showed), and
        nothing else is written: the first start delivers it, and later rkmon apply (rkmon_lib/deliver.py). Before the
        first start, it is the deploy path's step 3: every setting, with its checks (show_summary). While this folder's
        container exists (deployed), only what changes and how each change applies, with the checks the changes call
        for (show_changes). CONFIRMED, then the state's next line, as rkmon next gives it (state_next_line): on a first
        deploy, step 4's command when the image is not here, else the next step left. NOTHING TO DO while your file
        and this package (its version and its code) are what the last confirm recorded, under the rows you act on
        (nothing_to_confirm_rows); FAILED, with this command again, when one of them fails. A refusal, the state's, with
        no settings file named or recorded, and check 14's, with a new container name while this folder's container
        exists (new_name_refused).
        """
        st, out, ck = self.lib("steps"), self.lib("outcome"), self.lib("checks")
        dp, rec, sf = (
            self.lib("deploy_plan"),
            self.lib("records"),
            self.lib("settings_file"),
        )
        counted = self.lib("wrapping").counted
        first = self.deployed() is None
        if first:
            say(st.banner(st.DEPLOY_STEPS[2], self.dry == 1))
        else:
            what = "what changes on this deployment"
            say(st.command_banner("confirm", what, self.dry == 1))
        self.state_guard()
        given = ns.settings or self.recorded()
        if not given:
            return self.refuse()
        file = self.abspath(given)
        cfg, checks = self.confirm_checks(file, self.again(ns.settings or ""))
        refused = None if cfg is None else self.new_name_refused(cfg, file)
        if refused is not None:
            return refused
        if cfg is None or ck.failed(checks):
            return self.check_outcome(
                checks, False, rows="problems", unchanged="nothing confirmed"
            )
        doc = sf.read(file, self.lib("file_types").DEPLOY)
        version = self.lib("image").package_version(self.pkg)
        code = self.lib("image").code_sha256(self.pkg)
        shown = sf.shown(file)
        fingerprint = dp.fingerprint(doc, version, code)
        file_sha256 = dp.file_sha256(doc)
        made = dp.plan(doc, version, code, dp.Host(os.getuid(), os.getgid(), ""))
        was = self.confirmed()
        if was is not None and (
            was.settings_file,
            was.fingerprint,
            was.file_sha256,
        ) == (
            shown,
            fingerprint,
            file_sha256,
        ):
            checks, rows = self.nothing_to_confirm_rows(doc, made, checks, first)
            if rows:
                say(ck.render(rows))
                say("")
            if ck.failed(rows):
                word, text = out.tally(checks, "nothing confirmed")
                return out.finish(word, text, next=self.again_line())
            at = rec.parsed(was.at)
            when = self.lib("progress").shown_time(at) if at is not None else was.at
            return out.finish(
                "NOTHING TO DO",
                self.lib("states").as_confirmed(shown, when),
                next=self.state_next_line(),
            )
        count = None  # the changes shown, None for every setting
        if first:
            say(f"your deploy settings file: {shown}\n")
            checks = self.show_summary(doc, made, checks)
        else:
            checks, count = self.show_changes(doc, made, file, checks)
        if ck.failed(checks):
            say("")
            word, text = out.tally(checks, "nothing confirmed")
            return out.finish(word, text, next=self.again_line())
        if count:
            them = f"these {count} changes" if count > 1 else "this change"
            can = f"{counted(count, 'change')} can be confirmed"
        else:
            them, can = "the settings", f"{shown} can be confirmed"
        if self.dry == 1:
            return self.dry_run_outcome(f"{can}; nothing recorded")
        if not ns.yes:
            if not self.interactive():
                err(
                    f"{self.program} confirm: no terminal to ask on: {self.program} confirm --yes confirms {them} "
                    "shown above"
                )
                return 2
            question = "Are these settings right?" if not count else f"Confirm {them}?"
            if not self.confirm(f"\n{question}", default=False):
                return out.finish(
                    "CANCELLED", "nothing confirmed", next=self.state_next_line()
                )
        rec.confirm(
            self.pkg,
            rec.Confirmed(
                settings_file=file,
                fingerprint=fingerprint,
                at=rec.timestamp(),
                file_sha256=file_sha256,
                package_version=version,
                code_sha256=code,
                container_name=made.variables["COMPOSE_PROJECT_NAME"],
                image=self.made_image(made),
                changes=count or 0,
            ),
        )
        if count:
            waits = "waits" if count == 1 else "wait"
            text = f"{counted(count, 'change')} {waits} for apply; nothing runs differently yet"
        else:
            text = f"{shown} is this deployment's settings file"
            text += "" if count is None else "; no change waits for apply"
        return out.finish("CONFIRMED", text, next=self.state_next_line())

    def nothing_to_confirm_rows(self, doc, made, checks: list, first: bool) -> tuple:
        """What a confirm shows while DOC, the deploy settings document, as MADE, what it makes on this host
        (deploy_plan.plan), and this package are what the last confirm recorded: (every check row, the rows shown),
        the rows you act on. Of CHECKS, the file's own (confirm_checks), whose FAIL refuses before: each WARN. Of check
        16's (claude_env_checks; FIRST: before the first start), read again, since they wait for the image, whose SKIP
        asks for this command again once it is here: each but a PASS.
        """
        ck = self.lib("checks")
        values = self.lib("runtime_config").from_settings(made.layer["settings"]).values
        claude = self.claude_env_checks(
            doc, made, values, *self.claude_env_images(made, first)
        )
        rows = [c for c in checks if c.status in ck.PROBLEMS]
        rows += [c for c in claude if c.status != ck.Status.PASS]
        return checks + claude, rows

    # --- apply: the confirmed change made on this deployment, put back on a failure ---------------------------------
    def deliver_compose(self, args, data, variables):
        """How deliver runs docker compose (rkmon_lib/deliver.py): ARGS, with DATA on its input and VARIABLES over this
        process's environment, printed first (compose). Its exit code."""
        return self.compose(*args, stdin=data, variables=variables)

    def container_image(self) -> str:
        """The ID of the image this folder's container was made from; "" when there is none, or docker does not say.
        Read-only, and not printed."""
        rc, cid = self.ask_docker("compose", "ps", "-q", SERVICE)
        if rc != 0 or not cid.strip():
            return ""
        rc, out = self.ask_docker("inspect", "--format", "{{.Image}}", cid.split()[0])
        return out.strip() if rc == 0 else ""

    def image_id(self, ref: str) -> str:
        """The ID of the image REF on this host; "" when it is not here, or docker does not say. Read-only, and not
        printed."""
        rc, out = self.ask_docker("image", "inspect", "--format", "{{.Id}}", ref)
        return out.strip() if rc == 0 else ""

    def release_archive(self) -> bytes:
        """This package's code as code-install takes it (docker/rk_root.py): a tar archive of the files the image's
        build copies (image.code_files), each at its path in this package folder, root's, mode 755 for a file the
        package runs (code_volume.runs), else 644.
        """
        out, runs = io.BytesIO(), self.lib("code_volume").runs
        with tarfile.open(fileobj=out, mode="w") as tar:
            for rel in self.lib("image").code_files(self.pkg):
                path = os.path.join(self.pkg, rel)
                info = tar.gettarinfo(path, arcname=rel)
                info.uid = info.gid = 0
                info.uname = info.gname = "root"
                info.mode = 0o755 if runs(info.mode) else 0o644
                with open(path, "rb") as f:
                    tar.addfile(info, f)
        return out.getvalue()

    def root_code(self, action: str, variables=None, stdin=None, options=()) -> tuple:
        """docker/rk_root.py's ACTION with its OPTIONS, code-install (the archive on STDIN) or code-back, as root
        through the container's entry point: in the running container while it was made from the image VARIABLES
        name, else in a one-off container of that image, VARIABLES over this process's environment. VARIABLES None:
        docker/.env's as it is (compose_variables), for code-back after a put-back, which runs on the image of the
        settings put back. It runs to its end whatever Ctrl-C does (compose's whole, in ctrl_c_waits), so that no
        change of the code stops half-made and the one-off container goes once it has ended; each line it prints is
        said after `code:` first. (its exit code, its lines)."""
        env = variables or self.compose_variables()
        ref = self.image_ref(env["RKMON_TAG"], env["RKMON_IMAGE"])
        made = self.container_image() if self.running() else ""
        with ctrl_c_waits():
            if made and made == self.image_id(ref):
                args = (
                    "exec",
                    "-T",
                    "--user",
                    "0",
                    "-e",
                    "RKMON_AS=root",
                    SERVICE,
                    self.entry,
                )
                rc, out = self.compose(
                    *args, action, *options, stdin=stdin, capture=True, whole=True
                )
            else:
                args = (
                    "run",
                    "--rm",
                    "-T",
                    "--no-deps",
                    "-e",
                    "RKMON_AS=root",
                    SERVICE,
                )
                rc, out = self.compose(
                    *args,
                    action,
                    *options,
                    stdin=stdin,
                    capture=True,
                    variables=variables,
                    whole=True,
                )
            lines = [x for x in out.splitlines() if x.strip()]
            for x in lines:
                say(f"  code: {x}")
        return rc, lines

    def doctor_now(self) -> tuple:
        """rk doctor --fresh in the running container, as apply runs it before and after the change: (its rows
        (checks.Check), each with its fix (`rk doctor --json`), ""); from an rk without --json, the rows of its report
        (deployment.doctor_rows), whose fix is the whole report. (None, why) when it does not run, or what it says
        cannot be read. Nothing is said."""
        ck = self.lib("checks")
        rc, out = self.quiet_inside("rk", "doctor", "--fresh", "--json")
        rows = None
        if rc == 2 and "unrecognized arguments" in out:  # an rk from before --json
            rc, out = self.quiet_inside("rk", "doctor", "--fresh")
            report = ck.Command((self.program, "doctor"))
            rows = [
                ck.Check(
                    r.name,
                    r.status,
                    r.lines[0].partition(f"{r.name}: ")[2].strip() or r.status,
                    report if r.status in ck.PROBLEMS else None,
                )
                for r in self.lib("deployment").doctor_rows(out)
            ]
        else:
            start = out.find("[")
            try:
                found = json.JSONDecoder().raw_decode(out[start:])[0]
                rows = [ck.check_from_json(x) for x in found]
            except (ValueError, KeyError, TypeError):
                rows = None
        if rc in (0, 3, 4) and rows:
            return rows, ""
        said = (out.strip().splitlines() or ["no answer"])[-1][:200]
        if rc in (0, 3, 4):
            return None, f"what rk doctor in the container said cannot be read: {said}"
        return None, f"rk doctor in the container exited {rc}: {said}"

    def doctor_before(self, part_way=None) -> tuple:
        """apply's step 1, and rollback's: the doctor runs (doctor_now), and the baseline is the names of the
        checks it finds failing; after a change that stopped part-way, whose record is PART_WAY (records.UnderWay),
        that change's baseline when its record has one (records.baseline), so that a failure it caused never counts as
        failing already. Said in a row: PASS with the count of the checks that ran, or WARN with those that fail,
        already or since the change that stopped part-way (deployment.new_failures). (the baseline, "") once the
        doctor ran; else (None, why it did not)."""
        ck, joined = self.lib("checks"), self.lib("wrapping").joined
        rows, why = self.doctor_now()
        if rows is None:
            return None, why
        ran = sum(1 for r in rows if r.status in ck.RAN)
        failing = [r for r in rows if r.status == ck.Status.FAIL]
        names = [r.name for r in failing]
        baseline = self.lib("records").baseline(part_way, names)
        since = self.lib("deployment").new_failures(list(baseline), names)
        already = [n for n in names if n not in since]
        found = f"{ran} checks"
        if already:
            found += f"; failing already: {joined(already)}"
        if since:
            found += (
                f"; failing since the change that stopped part-way: {joined(since)}"
            )
        if failing:
            row = ck.Check("doctor before", ck.Status.WARN, found, failing[0].fix)
        else:
            row = ck.Check("doctor before", ck.Status.PASS, found)
        say(ck.render([row], fixes=False))
        return baseline, ""

    def doctor_after(self, baseline):
        """apply's step 7, and rollback's: the doctor again (doctor_now), its failures against BASELINE, the
        names of the checks failing before the change (deployment.new_failures), said in a row: PASS with the count of
        the checks that ran and no new failure; else FAIL (failed) with the first new failure, or that the doctor did
        not run, whose fix is the doctor's own report (rkmon doctor). With no check failing, its result goes to this
        folder's records as rkmon doctor's does (record_doctor): deploy step 7 passed since the container's start, as
        the state's next line reads it. None when no failure is new; else (what failed, its fix).
        """
        ck, d = self.lib("checks"), self.lib("deployment")
        rows, why = self.doctor_now()
        if rows is None:
            report = ck.Command((self.program, "doctor"))
            return self.failed(
                "doctor after", f"the doctor did not run ({why})", report
            )
        failing = [r for r in rows if r.status == ck.Status.FAIL]
        new = d.new_failures(list(baseline), [r.name for r in failing])
        if not new:
            ran = sum(1 for r in rows if r.status in ck.RAN)
            row = ck.Check(
                "doctor after", ck.Status.PASS, f"{ran} checks, no new failure"
            )
            say(ck.render([row], fixes=False))
            if not failing:
                self.record_doctor(ran)
            return None
        first = next(r for r in failing if r.name == new[0])
        failure = f"{first.name}: {first.found}"
        if len(new) > 1:
            failure += f" (and {self.lib('wrapping').joined(new[1:])})"
        return self.failed("doctor after", failure, first.fix)

    def record_doctor(self, ran: int, failing=()) -> None:
        """A whole doctor report's result in this folder's records, which rkmon next reads for deploy step 7
        (records.doctor_result): now, RAN, the count of the checks that ran, and FAILING, the names of those that
        failed. rkmon doctor's (cmd_doctor), and the doctor after a change with no check failing (doctor_after).
        """
        rec = self.lib("records")
        rec.doctor_result(self.pkg, rec.Doctor(rec.timestamp(), ran, tuple(failing)))

    def failed(self, name: str, what: str, fix) -> tuple:
        """A step of apply or rollback that failed: its FAIL row, NAME and WHAT, said without its FIX, which the
        outcome's fix line gives; (WHAT, FIX)."""
        ck = self.lib("checks")
        say(ck.render([ck.Check(name, ck.Status.FAIL, what, fix)], fixes=False))
        return what, fix

    def logs_fix(self):
        """The fix of a container that did not start again, or of a monitor that did not load its settings in time:
        the container's log says why (logs --tail 50)."""
        ck = self.lib("checks")
        return ck.Steps(
            (ck.Command((self.program, "logs", "--tail", "50")), "says why")
        )

    def drain(self, minutes: float, options=()):
        """apply's step 2, rollback's, and stop --drain's: `rk drain --timeout-minutes MINUTES` in the running
        container (rkmon_lib/drain.py), its lines said as they come, indented, then `drain: done`. None once drained
        (under --dry-run, once the command is shown); else, its other lines said, the outcome, with the drain lifted
        and nothing changed: ERROR when the work in flight is still there after MINUTES (next: the command with
        OPTIONS, those it keeps, and twice as long, when it takes --timeout-minutes, or later) or another command lifted
        the drain meanwhile (rk drain's UNDRAINED line says so); REFUSED while another command's drain is on; ERROR,
        with its exit code and its last line, when it ends any other way (a traceback, which exits 1 too). A Ctrl-C
        meanwhile goes on to the caller (KeyboardInterrupt), which lifts the drain (undrain), once rk drain in the
        container has ended by SIGINT (DRAIN), its own way, its drain lifted, so that it sets none after.
        """
        oc, ck = self.lib("outcome"), self.lib("checks")
        started, kept = time.monotonic(), []

        def each(line: str) -> None:
            if line.startswith(("drain: ", "  (")):
                say(f"  {line}")
            elif line.strip():
                kept.append(line)

        try:
            rc = self.piped_inside(
                "rk", "drain", "--timeout-minutes", f"{minutes:g}", each=each
            )
        except KeyboardInterrupt:
            self.quiet_inside("pkill", "-INT", "-f", DRAIN)
            raise
        if self.dry == 1:
            return None
        took = time.monotonic() - started
        if rc == 0:
            after = int(took // 60)
            counted = self.lib("wrapping").counted(after, "minute")
            say("  drain: done" + (f" after {counted}" if after else ""))
            return None
        for line in kept:
            say(f"  {line}")
        last = kept[-1] if kept else "no answer"
        if rc == 4:
            why = last[len("REFUSED: ") :] if last.startswith("REFUSED: ") else last
            return oc.finish(
                "REFUSED", f"{why}; nothing changed", next=self.again_line()
            )
        if rc == 1 and took >= 60 * minutes:  # rk drain's limit passed
            later = ck.Command((self.program, self.cmd, *options))
            next_line = self.next_of(f"{later} later")
            if any("--timeout-minutes" in o.flags for o in self.row.options):
                twice = ("--timeout-minutes", f"{2 * minutes:g}")
                longer = ck.Command((self.program, self.cmd, *options, *twice))
                next_line = self.next_of(f"{longer}, or {later} later")
            return oc.finish(
                "ERROR",
                f"the work in flight did not finish within {minutes:g} minutes; the drain is lifted; nothing "
                "changed",
                next=next_line,
            )
        # rk drain's own line says that another command lifted the drain: a traceback exits 1 too, and says none
        undrained = rc == 1 and any(x.startswith(f"{UNDRAINED}: ") for x in kept)
        if undrained:
            why = "another command lifted the drain before the work in flight finished"
        else:
            why = f"rk drain in the container exited {rc} ({last[:200]})"
        return oc.finish("ERROR", f"{why}; nothing changed", next=self.again_line())

    def undrain(self, change) -> None:
        """The drain CHANGE set lifted (`rk undrain` in the running container; an older package's drain, a stop, by its
        own `rk start`, once the drain that a Ctrl-C left going on in the container has ended by SIGINT: older_drain,
        OLDER_DRAIN), once apply no longer needs it or ends short; a pause you set stays.
        """
        if change.drained:
            if change.older:
                self.quiet_inside("pkill", "-INT", "-f", OLDER_DRAIN)
            self.quiet_inside("rk", "start" if change.older else "undrain")
            change.drained = False

    def begin_change(self, command: str, change, failing=None, code_back=False):
        """apply's step 3: COMMAND, apply or rollback, recorded as under way in this folder's records, with the
        doctor's baseline, FAILING (None: the doctor did not run), for a rollback whether it puts the code back
        (CODE_BACK), and whether it is a first apply over an older package (CHANGE's `first`), under the lease
        CHANGE keeps (records.begin, which keeps the baseline and the mark of a change that stopped part-way). None once
        it is; else, the drain lifted, nothing changed: REFUSED while another apply, rollback or adopt runs; the state's
        refusal while the records keep an adopt that stopped part-way (records.PartWay).
        """
        rec = self.lib("records")
        try:
            change.lease = rec.begin(
                self.pkg, command, failing, code_back, first_apply=change.first
            )
        except rec.Busy as exc:
            self.undrain(change)
            return self.lib("outcome").finish(
                "REFUSED", f"{exc}; nothing changed", next=self.again_line()
            )
        except rec.PartWay:
            self.undrain(change)
            return self.refuse()
        return None

    def end_short(self, change, changed: bool, text: str, fix=None, next_line=""):
        """An apply or a rollback that ends short: the drain lifted; while nothing CHANGED, the record of the command
        gone (the command again is NEXT_LINE's default), else kept (state 3: the state's next line), as it is when the
        command took the place of one that stopped part-way (records.Lease.stop). ERROR with TEXT and FIX.
        """
        self.undrain(change)
        kept = change.lease.stop(changed)
        if not next_line:
            next_line = self.state_next_line() if kept else self.again_line()
        return self.lib("outcome").finish("ERROR", text, fix=fix, next=next_line)

    def end_refused(self, change, text: str, fix=None, earlier_step=False):
        """An apply that refuses once under way, nothing changed: the drain lifted, and the record of the apply gone,
        unless it took the place of one that stopped part-way (records.Lease.stop). REFUSED with TEXT and FIX, then the
        state's next line; EARLIER_STEP: exit 3, an earlier step is not done (outcome.finish), else 4.
        """
        self.undrain(change)
        change.lease.stop(False)
        return self.lib("outcome").finish(
            "REFUSED",
            text,
            fix=fix,
            next=self.state_next_line(),
            earlier_step=earlier_step,
        )

    def install_code(self, variables, change):
        """apply's step 4: this package's code into the code volume, a release over the image VARIABLES name
        (root_code: code-install, with release_archive), CHANGE's phase INSTALLING meanwhile, and `installed` once a
        release went in, as the record of the apply then says (records.Lease.record_install): the install and that
        record run to their end whatever Ctrl-C does (ctrl_c_waits), so that a put-back finds each release that went
        in. None once this code is in place; else REFUSED, nothing changed, when it needs a new image
        (new_image_needed), or ERROR when the install fails, the settings as they were and the code volume as
        code-install's last line says (it empties a code volume that fails its check first: docker/rk_root.py); the
        drain lifted, and the record of the apply gone, unless it took the place of one that stopped part-way
        (records.Lease.stop).
        """
        change.phase = Change.INSTALLING
        with ctrl_c_waits():
            rc, lines = self.root_code(
                "code-install", variables, self.release_archive()
            )
            if rc == 0 and self.went_in(lines):
                change.installed = True
                change.lease.record_install()
        if rc == 0:
            return None
        change.phase = ""
        if rc != self.lib("code_volume").NEW_IMAGE:
            text = f"{self.install_failed(rc, lines)}; the settings are as they were"
            return self.end_short(change, False, text)
        what, fix = self.new_image_needed()
        return self.end_refused(change, f"{what}; nothing changed", fix=fix)

    @staticmethod
    def went_in(lines: list) -> bool:
        """Whether a code-install that ended well put a release in, by LINES, the lines it printed (root_code):
        INSTALLED, where NOTHING TO DO says the code runs already (docker/rk_root.py).
        """
        return any(x.startswith("INSTALLED") for x in lines)

    @staticmethod
    def install_failed(rc: int, lines: list) -> str:
        """What a code-install that exited RC (root_code) left undone, with the last of LINES, the lines it printed:
        this package's code did not go in."""
        why = lines[-1][:200] if lines else "no answer"
        return f"this package's code did not go in (code-install exited {rc}: {why})"

    def new_image_needed(self) -> tuple:
        """What apply and the start say of code that needs a new image (code-install's exit code_volume.NEW_IMAGE):
        (its words, its fix: releases.new_image_fix, then confirm)."""
        then = (", then", self.lib("checks").Command((self.program, "confirm")))
        fix = self.lib("releases").new_image_fix(then)
        return "this package's code needs a new image", fix

    def write_settings(self, plan, change):
        """apply's step 5: PLAN into place by deliver (rkmon_lib/deliver.py), the settings before it kept as
        deliver decides (keep_previous), as the record of the apply says before deliver writes
        (records.Lease.record_kept), CHANGE's phase WRITING. None once they are, after the line that says so; else
        ERROR (end_short), a layer in place that cannot be read among them: when nothing changed, after the code this
        run put in is put back (code-back, on the plan's image), the command again; else the state's next line (3). A
        team's skill that changed since the confirm (deliver.SkillsChanged): REFUSED (end_refused, exit 3) and the
        state's next line (5: the confirm) once nothing is changed, the code this run put in put back; ERROR as above
        when it cannot be.
        """
        dl = self.lib("deliver")
        change.phase = Change.WRITING
        try:
            keep = self.keep_previous(plan)
            if keep:
                change.lease.record_kept()
            dl.deliver(plan, keep, package_dir=self.pkg, compose=self.deliver_compose)
        except (dl.Failed, OSError, ValueError) as exc:
            changed = isinstance(exc, dl.Failed) and bool(exc.changed)
            why = self.said_above(exc)
            if isinstance(exc, dl.Failed):
                text = why
            else:
                text = f"your confirmed settings could not be put in place ({why}): nothing changed"
            if not changed and change.installed:
                changed = self.root_code("code-back", plan.variables)[0] != 0
                if changed:
                    text += (
                        ", but this package's code went in and could not be put back"
                    )
            if isinstance(exc, dl.SkillsChanged) and not changed:
                return self.end_refused(change, text, earlier_step=True)
            return self.end_short(change, changed, text)
        if keep:
            say(
                "  wrote: the new settings (the previous ones kept), docker/.env and the override"
            )
        else:
            say(
                "  wrote: your confirmed settings again, docker/.env and the override; the settings kept before "
                "stay"
            )
        return None

    def restart(self):
        """apply's step 6, and rollback's: the container made again (docker compose up -d --force-recreate: a
        change of the code or of the settings volume alone is none that compose sees), then up (wait_running). None
        once it runs; else (what failed, its fix: the container's log says why), after its FAIL row (failed).
        """
        say("  restart: docker compose up -d --force-recreate")
        rc = self.compose("up", "-d", "--force-recreate")
        if rc == 0 and self.wait_running():
            return None
        if rc:
            what = f"docker compose up exited {rc}"
        else:
            what = "the container was not running after docker compose up"
        return self.failed("restart", what, self.logs_fix())

    def provision_now(self) -> None:
        """`rk provision` in the running container (rkmon_lib/provision.py) before each load of the settings apply or
        rollback delivered (wait_loaded), as every start runs it once the layer is delivered: its steps read your
        confirmed settings, so a changed model binding is probed again. It runs as the load after it does (quiet_inside:
        its output and its errors read, not shown), for PROVISION_MINUTES at most; its rows are said as it renders them
        (deployment.doctor_rows), and nothing else of it, so a traceback's lines are not. It judges nothing, the load
        and the doctor after do: a run that fails, or is not done in time, says so in one line, what failed, and the
        command goes on."""
        ck = self.lib("checks")
        rc, out = self.quiet_inside("rk", "provision", timeout=60 * PROVISION_MINUTES)
        rows = self.lib("deployment").doctor_rows(out)
        if rows:
            say("\n".join(line for r in rows for line in r.lines))
        if rc == 0:
            return
        if rc == self.lib("confirm").TIMED_OUT:
            what = f"not done within {PROVISION_MINUTES:g} minutes, and goes on in the container"
        else:
            failed = [r.name for r in rows if r.status == ck.Status.FAIL]
            said = [x for x in out.splitlines() if x.strip()]
            refused = [x for x in said if x.startswith("REFUSED: ")]
            last = (refused or said or ["no answer"])[-1][:200]
            why = f"{failed[-1]} failed" if failed else f"exit code {rc}: {last}"
            what = f"the work volume is not set up in full ({why})"
        say(f"  set-up: {what}; {self.cmd} goes on")

    def wait_loaded(self, fingerprint: str, what: str = "your confirmed settings"):
        """apply's step 7, and rollback's: rk provision first (provision_now), then `rk applied --load --json` in
        the running container, which loads the delivered layer and records it as applied (rkmon_lib/applied.py), until
        the record names FINGERPRINT, that of WHAT, the settings it waits for, for states.LOAD_WAIT_MINUTES at most.
        None once it does; else (what failed, its fix), after its FAIL row (failed): why the configuration cannot run,
        with rk's fix (the container's log, when it gives none), at once; after that time, that the monitor did not
        load them, with the log's fix. Each answer is waited for until that time at most.
        """
        self.provision_now()
        ck, sts = self.lib("checks"), self.lib("states")
        minutes = sts.LOAD_WAIT_MINUTES
        end = time.monotonic() + 60 * minutes
        while True:
            left = max(1, int(end - time.monotonic()))
            rc, out = self.quiet_inside(
                "rk", "applied", "--load", "--json", timeout=left
            )
            start = out.find("{")
            try:
                said = json.JSONDecoder().raw_decode(out[start:])[0]
            except ValueError:
                said = None
            if not isinstance(said, dict):
                said = {}
            if "refused" in said:
                fix = ck.fix_from_json(said.get("fix")) or self.logs_fix()
                return self.failed("load", str(said["refused"]), fix)
            applied = said.get("applied")
            if isinstance(applied, dict) and applied.get("fingerprint") == fingerprint:
                return None
            if time.monotonic() >= end:
                what = f"the monitor did not load {what} within {minutes:g} minutes"
                return self.failed("load", what, self.logs_fix())
            time.sleep(max(0.0, min(3.0, end - time.monotonic())))

    def put_back_change(self, plan, change, restarted: bool, reason: str, failure):
        """apply's step 8, after a restart, a load or a doctor check that failed (REASON, one of records.REASONS;
        FAILURE: what failed and its fix, its FAIL row said), CHANGE's phase PUTTING_BACK: what deliver kept, back in
        place (deliver.put_back, in PLAN's compose project and image), the code that ran with those settings running
        again when the records say so, as rollback decides (records.code_back: a release went in during the change, by
        an apply that stopped part-way before it too, or the change kept no settings of its own and the last apply put
        one in; root_code: code-back), the container made again when it was (RESTARTED) or the code went back (the
        container runs the code it was made with), and the monitor's load of the settings put back
        (wait_loaded, for the fingerprint of the layer kept); the change put back in the records (records.PutBack, with
        what failed and its fix: state 10), the record of the apply gone, and none that the last apply put a release in
        (records.Installed): ROLLED BACK, exit 1, with the fix and the state's next line. When they cannot be put back,
        or are back but do not run: ERROR, with what failed, the record of the apply kept (state 3).
        """
        dl, oc, rec = self.lib("deliver"), self.lib("outcome"), self.lib("records")
        what, fix = failure
        change.phase = Change.PUTTING_BACK
        kept = self.kept_fingerprint()
        why = ""
        try:
            if not dl.put_back(
                plan.variables, package_dir=self.pkg, compose=self.deliver_compose
            ):
                why = "no settings from before this apply are kept"
        except (dl.Failed, OSError, ValueError) as exc:
            why = self.said_above(exc)
        if why:
            text = f"{what}; and the settings from before this apply could not be put back ({why})"
            return self.end_short(change, True, text, fix=fix)
        say(
            "  put back: the settings from before this apply, docker/.env and the override"
        )
        back = f"{what}; the settings from before this apply are back"
        coded = rec.code_back(rec.read(self.pkg))
        if coded:
            rc, lines = self.root_code("code-back")
            if rc != 0:
                said = lines[-1][:200] if lines else "no answer"
                text = f"{back}, but not the code that ran with them (code-back exited {rc}: {said})"
                return self.end_short(change, True, text, fix=fix)
        down = self.restart() if restarted or coded else None
        if down is not None:
            text = f"{back}, but the container did not start again: {down[0]}"
            return self.end_short(change, True, text, fix=down[1])
        unloaded = self.wait_loaded(kept, "the settings put back")
        if unloaded is not None:
            text = f"{back}, but their load failed: {unloaded[0]}"
            return self.end_short(change, True, text, fix=unloaded[1])
        say("  loaded: the monitor runs the settings from before this apply")
        record = rec.PutBack(plan.fingerprint, reason, rec.timestamp(), what, fix)
        rec.put_back(self.pkg, record)
        change.lease.finish(code=False)
        return oc.finish(
            "ROLLED BACK",
            "the previous settings are back and the container runs them; your confirmed change was put back",
            fix=fix,
            next=self.state_next_line(),
        )

    def unchanged_words(self, drained: bool) -> str:
        """What INTERRUPTED says when a Ctrl-C changed nothing: nothing changed;
        that the drain is lifted and new reviews start again, when DRAINED; and for apply, that your confirmed change
        still waits."""
        said = ["nothing changed"]
        if drained:
            said.append("the drain is lifted and new reviews start again")
        if self.cmd == "apply":
            said.append("your confirmed change still waits")
        return "; ".join(said)

    def interrupted(self, change) -> int:
        """Ctrl-C during apply or rollback, and during stop --drain's drain: the drain lifted;
        before anything changed, the record of the command gone too, unless it took the place of one that stopped
        part-way (records.Lease.stop): INTERRUPTED, nothing changed, and the command again (the state's next line when
        the record stays); once the code or the settings are being written or put back, the record stays (state 3):
        INTERRUPTED, what it was doing, and the state's next line; for a first apply over an older package (CHANGE's
        `first`), which puts nothing back, that the older monitor's files are kept. Exit 130. A second Ctrl-C
        meanwhile ends the command by the signal (ctrl_c_ends).
        """
        ctrl_c_ends()
        oc = self.lib("outcome")
        said = self.unchanged_words(change.drained)
        self.undrain(change)
        if not change.phase:
            kept = change.lease is not None and change.lease.stop(False)
            next_line = self.state_next_line() if kept else self.again_line()
            return oc.finish("INTERRUPTED", said, next=next_line)
        change.lease.release()
        if self.cmd == "rollback":
            text = (
                "while putting back the code and settings from before your last apply"
            )
        elif change.phase == Change.INSTALLING:
            text = "while this package's code went in (the code before it is kept)"
        elif change.phase == Change.PUTTING_BACK:
            text = "while putting back what ran before this apply"
        elif change.first:
            text = "after writing the new settings (the older monitor's files are kept)"
        else:
            text = "after writing the new settings (the previous ones are kept)"
        return oc.finish("INTERRUPTED", text, next=self.state_next_line())

    def apply_before_start(self, state, facts) -> int:
        """apply in STATE, one its row leaves out, of FACTS (state_guard's OUTSIDE): before the first start, in state 8
        and in state 7 while this folder's container does not exist (made: the facts leave it unasked in 7), NOTHING
        TO DO, as the first start takes your confirmed settings, with the state's sentence and next line; else the
        state's refusal (refuse). Its exit code."""
        st = self.lib("states")
        if not (state.n == 8 or state.n == 7 and not self.made()):
            return self.refuse(facts=facts)
        return self.lib("outcome").finish(
            "NOTHING TO DO",
            f"the first start takes your confirmed settings; {st.sentence(state, facts)}",
            next=st.next_line(state, facts, self.since_start(state, facts)),
        )

    def cmd_apply(self, ns) -> int:
        """`apply [--timeout-minutes N] [--no-drain] [--dry-run]`: the confirmed change made on
        this deployment, in its states (state_guard: 3, and 9 to 16; NOTHING TO DO in 12 and 14 to 16, with the state's
        next line, and before the first start: apply_before_start), after check 15's volumes (volume_guard). REFUSED
        while another apply or rollback runs, and, after one stopped part-way (state 3), once your file changed
        (rollback puts back the settings from before it; a first apply over an older package waits for the file you
        confirmed, as it puts nothing back). A change restarts the container when one of its changes does
        (change_plan.ChangePlan.restarts), when what changes cannot be told, in states 3 and 13, and in a first apply
        over an older package; check 15's ports first (port_guard). On the running container (apply_running): the
        doctor, the drain (--timeout-minutes; --no-drain: none), the record of the apply, this package's code when it
        restarts, the settings, the restart, the load and the doctor again; a load that fails or a new doctor failure
        puts back the code and the settings (ROLLED BACK, state 10). The first apply over an older package (first_apply)
        goes its own way wherever it stands: over a running container that runs that package's code
        (runs_older_code), over a stopped container that package made (older_stopped), and while the records mark the
        change as one (Facts' first_apply), on a running container or a stopped one. On a stopped container of this
        package's (apply_stopped): the record, the code and the settings, through one-off containers. A change that
        restarts, but a first apply, first looks for private files in the package folder that are not its own (strays),
        which the release would carry. Under --dry-run, what changes and what apply will do (confirm.change_lines and
        apply_lines), PASSED, and the command without --dry-run. Ctrl-C during the change, from the doctor before it:
        INTERRUPTED (interrupted); before it and once it has ended, Ctrl-C ends apply by the signal (ctrl_c_ends).
        """
        st, sts, oc = self.lib("steps"), self.lib("states"), self.lib("outcome")
        c, ck = self.lib("confirm"), self.lib("checks")
        say(st.command_banner("apply", self.row.summary, self.dry == 1))
        minutes = self.lib("commands").drain_timeout_minutes()
        if ns.timeout_minutes is not None:
            minutes = self.minutes(ns.timeout_minutes)
            if minutes is None:
                return 2
        facts = self.state_guard(
            host_check=self.volume_guard, outside=self.apply_before_start
        )
        state = sts.current(facts)
        # state 3: the state guard asked no container
        if state.n in sts.BEFORE_CONTAINER:
            self.volume_guard()
        if state.n in (12, 14, 15, 16):
            text = f"no change waits for apply; {sts.sentence(state, facts)}"
            return oc.finish(
                "NOTHING TO DO",
                text,
                next=sts.next_line(state, facts, self.since_start(state, facts)),
            )
        if facts.under_way_runs:
            busy = self.lib("records").Busy(facts.under_way)
            return oc.finish(
                "REFUSED", f"{busy}; nothing changed", next=self.again_line()
            )
        doc = self.confirmed_document()
        plan = self.confirmed_plan(doc)
        if plan is None and facts.first_apply:
            # state 3 alone: a first apply puts nothing back, and confirm runs once it has ended
            then = ck.Command((self.program, "apply"))
            back = ck.Steps(
                ("put your settings file back as you confirmed it, then", then)
            )
            return oc.finish(
                "REFUSED",
                "your settings file changed after the last confirm, so the first apply that stopped part-way cannot "
                "be finished; nothing changed",
                fix=self.way_back(back),
                next=self.next_of(
                    f"{then}, once your settings file is as you confirmed it"
                ),
            )
        if plan is None:  # state 3 alone: every later state reads a changed file as 5
            back = ck.Command((self.program, "rollback"))
            return oc.finish(
                "REFUSED",
                "your settings file changed after the last confirm, so the change that stopped part-way cannot be "
                "finished; nothing changed",
                next=self.next_of(
                    f"{back} (it puts back the code and settings from before the last apply)"
                ),
            )
        cp, _layer, why = self.change_plan_now(doc)
        lines, count = (
            ([], self.confirmed().changes) if cp is None else c.change_lines(cp)
        )
        restarts = cp is None or cp.restarts or state.n in (3, 13)
        status = facts.container
        if state.n in sts.BEFORE_CONTAINER:
            status = DockerAnswers(self).container(self.project())[0]
        running = status == sts.RUNNING
        # The first apply over an older package goes its own way, wherever it stands, and makes the container
        # again from this package's compose file: over a container that runs that package's code (its rk asked once
        # with the state guard's read), over a stopped one that package made, and while the records mark the change
        older = running and self.runs_older_code(self.answers.inside)
        first = older or facts.first_apply or self.older_stopped(facts)
        restarts = restarts or first
        if restarts and (running or first):
            file = self.recorded()
            cfg = self.settings_cfg(file)[0]
            shown = self.lib("settings_file").shown(file)
            rc = self.port_guard(cfg, plan.variables, shown) if cfg is not None else 0
            if rc:
                return rc
        if restarts and not first:
            # root's code-install looks for no private file (docker/rk_root.py): one would go into the release
            rc = self.strays()
            if rc:
                return rc
        drain = minutes if not ns.no_drain else None
        if self.dry == 1:
            say(
                f"note: what changes cannot be shown ({why})"
                if cp is None
                else "\n".join(lines)
            )
            say(
                "\n"
                + "\n".join(c.apply_lines(count, restarts, drain, not running, first))
            )
            counted = self.lib("wrapping").counted(count, "change")
            text = (
                f"{counted} can be applied"
                if count
                else "your confirmed settings can be applied"
            )
            return self.dry_run_outcome(f"{text}; nothing changed")
        if first:
            return self.first_apply(plan, count, drain, older, running)
        if running:
            return self.apply_running(plan, restarts, count, minutes, not ns.no_drain)
        return self.apply_stopped(plan, restarts)

    def begin_running(self, change, minutes, code_back=False):
        """apply's steps 1 to 3 on the running container, and rollback's: the doctor's baseline (doctor_before;
        that of a change that stopped part-way, when its record has one), the drain for MINUTES at most (None: no
        drain), and the record of the command with the baseline and CODE_BACK (begin_change), under CHANGE. (the
        baseline, None) once the three are done; else (None, the outcome's exit code), nothing changed.
        """
        part_way = self.lib("records").read(self.pkg).under_way
        before, why = self.doctor_before(part_way)
        if before is None:
            return None, self.lib("outcome").finish(
                "ERROR",
                f"the doctor did not run before the change ({why}); nothing changed",
                next=self.again_line(),
            )
        rc = None
        if minutes is not None:
            # rk drain sets it first: Ctrl-C meanwhile lifts it (interrupted)
            change.drained = True
            rc = self.drain(minutes)
            change.drained = rc is None
        if rc is None:
            rc = self.begin_change(self.cmd, change, before, code_back)
        return (change.lease.failing, None) if rc is None else (None, rc)

    def apply_running(
        self, plan, restarts: bool, count: int, minutes, drain: bool
    ) -> int:
        """apply on the running container (cmd_apply): its steps 1 to 9, each as its method says. Its step 9 keeps
        in the records what the change did to the code (records.Lease.applied: a release went in, or the settings
        before it were kept, else Installed as it was), which rollback reads; then APPLIED (applied_outcome).
        """
        rec = self.lib("records")
        change = Change()
        ctrl_c_interrupts()
        try:
            before, rc = self.begin_running(
                change, minutes if restarts and drain else None
            )
            if rc is None and restarts:
                rc = self.install_code(plan.variables, change)
            if rc is None:
                rc = self.write_settings(plan, change)
            if rc is not None:
                return rc
            failure, reason = None, "restart"
            if restarts:
                failure = self.restart()
            if failure is None:
                failure, reason = self.wait_loaded(plan.fingerprint), "load"
            self.undrain(change)
            if failure is None:
                self.say_loaded()
                failure, reason = self.doctor_after(before), "doctor"
            if failure is not None:
                return self.put_back_change(plan, change, restarts, reason, failure)
            rec.clear_put_back(self.pkg)
            change.lease.applied()
        except KeyboardInterrupt:
            return self.interrupted(change)
        ctrl_c_ends()
        return self.applied_outcome(count)

    def say_loaded(self) -> None:
        """apply's line once the monitor loaded your confirmed settings (wait_loaded), with when you confirmed them."""
        c = self.confirmed()
        at = self.lib("records").parsed(c.at)
        at = self.lib("progress").shown_time(at) if at else c.at
        say(f"  loaded: the monitor runs the settings you confirmed at {at}")

    def applied_outcome(self, count: int) -> int:
        """apply's outcome on the running container once its change ended well: first, while no tick has run since the
        container's start (last_tick_after_start), a tick at once (ask_tick_now), and the line that says what came of
        it; then APPLIED, with COUNT, the count of changes, when it is known, and standby's words while the monitor
        runs in standby (states.with_standby), then the state's next line."""
        if self.last_tick_after_start() == "":
            say(f"  tick: {self.ask_tick_now()[1]}")
        counted = self.lib("wrapping").counted(count, "change")
        text = "the deployment runs your confirmed settings" + (
            f" ({counted})" if count else ""
        )
        after, nxt = self.state_now()
        text = self.lib("states").with_standby(text, after)
        return self.lib("outcome").finish("APPLIED", text, next=nxt)

    def apply_stopped(self, plan, restarts: bool) -> int:
        """apply on a stopped container (cmd_apply): steps 3, 4 (when the change restarts) and 5, through one-off
        containers of the image, then 9, as apply_running's: APPLIED, the container stays stopped, and the state's next
        line (12: start).
        """
        change = Change()
        ctrl_c_interrupts()
        try:
            rc = self.begin_change("apply", change)
            if rc is None and restarts:
                rc = self.install_code(plan.variables, change)
            if rc is None:
                rc = self.write_settings(plan, change)
            if rc is not None:
                return rc
            self.lib("records").clear_put_back(self.pkg)
            change.lease.applied()
        except KeyboardInterrupt:
            return self.interrupted(change)
        ctrl_c_ends()
        return self.lib("outcome").finish(
            "APPLIED",
            "your confirmed settings and this package's code are in place; the container stays stopped",
            next=self.state_next_line(),
        )

    # --- the first apply over an older package ------------------------------------------------------------------------
    def runs_older_code(self, ask) -> bool:
        """Whether the running container runs an older package's code: its rk has no `rk applied` (older_rk).
        ASK: what asks rk, a function of its words that returns (exit code, output): a state read's, which asks each
        question once (DockerAnswers.inside). Read-only, and not printed.
        """
        return older_rk(*ask("rk", "applied", "--json"))

    def older_stopped(self, facts) -> bool:
        """Whether this folder's container, of FACTS, the state's facts, is stopped and an older package made it:
        this package never delivered here, by the records (records.Written's layer, which this package's start, apply
        and rollback record as they write the settings volume, before they make the container) or in the settings
        volume (Facts' delivered_fingerprint), which no older package's compose file has. Read-only, and not printed.
        """
        if facts.container != self.lib("states").STOPPED or facts.delivered_fingerprint:
            return False
        written = self.lib("records").read(self.pkg).written
        return written is None or not written.layer

    def first_apply(self, plan, count: int, minutes, older: bool, running: bool) -> int:
        """The first apply over an older package (cmd_apply), its way by how
        the deployment stands. Over a running container that runs that package's code (OLDER), the seven steps: that
        package's doctor, shown and not compared (older_doctor), and its drain, for MINUTES at most (older_drain; None:
        no drain); over a RUNNING container of this package's own (a first apply run again once the new container
        runs), the new monitor's own drain (drain); over a stopped container, neither, since nothing runs. Then steps 3
        to 7: the record of the apply, marked as a first apply, with no baseline (begin_change); no release, since this
        package's image carries its code; the settings (write_settings, which keeps the older package's docker/.env and
        override); the container made from this package's compose file, on its image (restart); the load
        (wait_loaded), while the new monitor's start makes the one-time move and runs in standby; the drain
        lifted (undrain; an older package's goes with its container); the stop the older drain left cleared
        (clear_stop); and the doctor after, with no FAIL (doctor_after, against no baseline). Then the change is
        recorded as apply_running records it, and APPLIED (applied_outcome). A failure from the restart on never puts
        back the settings from before, which this package's compose file cannot run (end_first_apply).
        """
        rec = self.lib("records")
        change = Change(older=older, first=True)
        ctrl_c_interrupts()
        try:
            if older:
                self.older_doctor()
            rc = None
            if running and minutes is not None:
                # its stop or drain is set first: Ctrl-C meanwhile lifts it (interrupted)
                change.drained = True
                rc = (self.older_drain if older else self.drain)(minutes)
                change.drained = rc is None
            if rc is None:
                rc = self.begin_change("apply", change, ())
            if rc is None:
                rc = self.write_settings(plan, change)
            if rc is not None:
                return rc
            failure = self.restart()
            if older:
                # the older container is gone; the stop its drain left, the new container's start clears (its
                # docker/entrypoint.sh runs rk start), else clear_stop after the load
                change.drained = False
            if failure is None:
                failure = self.wait_loaded(plan.fingerprint)
            self.undrain(change)
            if failure is None:
                self.say_loaded()
                cleared = self.clear_stop("  ")
                if cleared:
                    what = f"rk start, which clears the stop left in the monitor, exited {cleared}"
                    failure = self.failed("stop cleared", what, self.logs_fix())
            if failure is None:
                failure = self.doctor_after(())
            if failure is not None:
                return self.end_first_apply(plan, change, failure)
            rec.clear_put_back(self.pkg)
            change.lease.applied()
        except KeyboardInterrupt:
            return self.interrupted(change)
        ctrl_c_ends()
        return self.applied_outcome(count)

    def older_doctor(self) -> None:
        """The doctor before the first apply over an older package: that package's own (doctor_now), shown and
        not compared with the doctor after, since the two doctors' rows differ: a row with the count of the checks that
        ran, PASS, or WARN when any fails, then each failing row as that doctor gives it, a FAIL as FAIL; or a WARN that
        says why it did not run. It judges nothing, so the rows show no fix.
        """
        ck = self.lib("checks")
        name, report = "doctor before", ck.Command((self.program, "doctor"))
        rows, why = self.doctor_now()
        if rows is None:
            found = f"the older package's doctor did not run ({why})"
            say(ck.render([ck.Check(name, ck.Status.WARN, found, report)], fixes=False))
            return
        ran = sum(1 for r in rows if r.status in ck.RAN)
        failing = [r for r in rows if r.status == ck.Status.FAIL]
        found = f"{ran} checks of the older package's own, not compared with the doctor after"
        if failing:
            row = ck.Check(name, ck.Status.WARN, f"{found}; failing:", report)
        else:
            row = ck.Check(name, ck.Status.PASS, found)
        say(ck.render([row, *failing], fixes=False))

    def older_drain(self, minutes: float):
        """The drain before the first apply over an older package: that package's own, `rk stop --drain --wait
        MINUTES` in the running container, its lines said as it gives them, then `rk stopped`, as that package's image
        swap drains: the monitor stops once the work in flight finishes, or once MINUTES pass, what is still in flight
        stopped (its OLDER_DRAIN_TIMEOUT line), which `drain: done` says. None once it is stopped; else, its stop lifted
        by its own rk start, ERROR, nothing changed, and the command again."""
        say(f"  drain: the older package's own, up to {minutes:g} minutes")
        limit = []

        def each(line: str) -> None:
            say(line)
            if line.startswith(OLDER_DRAIN_TIMEOUT):
                limit.append(line)

        rc = self.piped_inside(
            "rk", "stop", "--drain", "--wait", f"{minutes:g}", each=each
        )
        if rc == 0 and self.quiet_inside("rk", "stopped")[0] == 0:
            if limit:
                say(
                    f"  drain: done at its limit of {minutes:g} minutes: the work still in flight was stopped"
                )
            else:
                say("  drain: done")
            return None
        if rc:
            why = f"the older package's drain exited {rc}"
        else:
            why = "the older monitor was not stopped after its drain"
        started = self.quiet_inside("rk", "start")[0]
        if started:
            why += f", and rk start, which lifts its stop, exited {started}"
        else:
            why += "; the older monitor runs again"
        return self.lib("outcome").finish(
            "ERROR", f"{why}; nothing changed", next=self.again_line()
        )

    def end_first_apply(self, plan, change, failure) -> int:
        """The first apply over an older package, failed from the restart on (FAILURE: what failed and its fix,
        its FAIL row said). It cannot put the older monitor back, whose compose file and code are in the folder the
        package update moved it to: the new container is stopped (docker compose stop), and the records keep the
        change that failed (records.PutBack: FIRST_APPLY, what failed, and both ways forward, way_back), the record of
        the apply gone: state 10. ERROR, exit 1, with both ways forward and the state's next line.
        """
        rec = self.lib("records")
        what, fix = failure
        say("  stop: docker compose stop")
        rc = self.compose("stop")
        if rc:
            stopped = f"its container did not stop (docker compose stop exited {rc})"
        else:
            stopped = "its container is stopped"
        both = self.way_back(fix)
        record = rec.PutBack(
            plan.fingerprint, rec.FIRST_APPLY, rec.timestamp(), what, both
        )
        rec.put_back(self.pkg, record)
        change.lease.finish(code=False)
        return self.lib("outcome").finish(
            "ERROR",
            f"the new monitor failed its first load: {what}; {stopped}, and the older monitor's files are kept, so it "
            "can run again",
            fix=both,
            next=self.state_next_line(),
        )

    def way_back(self, fix):
        """FIX, the fix of what failed the first apply over an older package, then the way back to that package,
        as one fix (checks.Steps)."""
        ck = self.lib("checks")
        parts = fix.parts if isinstance(fix, ck.Steps) else (fix,)
        return ck.Steps(
            (*parts, f"; or go back to the earlier package: {EARLIER_PACKAGE}")
        )

    # --- rollback: the code and settings from before the last apply, put back -----------------------------------------
    def cmd_rollback(self, ns) -> int:
        """`rollback [--dry-run]`: the code and the settings from before the last apply put
        back, in its states (state_guard: 3 to 7 and 9 to 16), after check 15's volumes (volume_guard). REFUSED while
        another apply or rollback runs. NOTHING TO DO, with the state's next line, when no earlier version is kept:
        while the records keep a first apply over an older package, under way or failed (Facts' first_apply),
        with the way back to the earlier package, before anything else is read; apply kept nothing, or what it kept is
        in place (deliver.kept_differs), but after one stopped part-way (state 3); or the settings volume keeps no
        earlier layer (the first apply over an older package keeps none), which it reads before the doctor and the
        drain (layer_in_volume). REFUSED in state 6: it puts back through containers
        of the confirmed image (deployment_variables), which is not on this host. ERROR, nothing changed, when the
        settings volume cannot be read. The code goes back with the settings when the last apply put a release in, and
        after an apply or a rollback that stopped part-way, as its record says (records.code_back): the code kept is
        then the release that ran before it, whatever image that runs on (docker/rk_root.py code-back). On the running
        container, check 15's ports first, those of the settings it puts back
        (rollback_port_guard); then (rollback_running) the doctor, the drain, the record of the rollback, the put-back
        (put_back_now), the restart, the load and the doctor again; on a stopped container (rollback_stopped): the
        record and the put-back, through one-off containers. Either way the records keep the change it put back
        (restored: state 10). Under --dry-run, what it will do (confirm.rollback_lines), PASSED, and the command without
        --dry-run. Ctrl-C during the change, from the doctor before it: INTERRUPTED (interrupted); before it and once it
        has ended, Ctrl-C ends rollback by the signal (ctrl_c_ends).
        """
        st, sts, oc = self.lib("steps"), self.lib("states"), self.lib("outcome")
        dl, dp = self.lib("deliver"), self.lib("deploy_plan")
        say(st.command_banner("rollback", self.row.summary, self.dry == 1))
        facts = self.state_guard(host_check=self.volume_guard)
        state = sts.current(facts)
        if (
            state.n in sts.BEFORE_CONTAINER
        ):  # states 3 to 6: the state guard asked no container
            self.volume_guard()
        if facts.under_way_runs:
            busy = self.lib("records").Busy(facts.under_way)
            return oc.finish(
                "REFUSED", f"{busy}; nothing changed", next=self.again_line()
            )
        kept_text, why = None, ""
        # What a first apply over an older package kept is the older package's, which rollback never puts back
        if facts.first_apply:
            pass
        elif dl.kept(self.pkg) and (state.n == 3 or dl.kept_differs(self.pkg)):
            if state.n == 6:
                need = "rollback puts back through containers of the image your confirmed settings name"
                return self.refuse(
                    f"{need}, and {sts.sentence(state, facts)}", facts=facts
                )
            kept_text, why = self.layer_in_volume(kept=True)
        if kept_text is None and not why:
            text = "no earlier version of this package is kept"
            if facts.first_apply:
                text += f"; to go back to the earlier package, see {EARLIER_PACKAGE}"
            return oc.finish(
                "NOTHING TO DO",
                text,
                next=sts.next_line(state, facts, self.since_start(state, facts)),
            )
        if why:
            text = f"the settings volume could not be read ({why}); nothing changed"
            return oc.finish("ERROR", text, next=self.again_line())
        status = facts.container
        if state.n in sts.BEFORE_CONTAINER:
            status = DockerAnswers(self).container(self.project())[0]
        running = status == sts.RUNNING
        kept = dp.read_layer(kept_text)
        rec = self.lib("records")
        code = rec.code_back(rec.read(self.pkg))
        minutes = self.lib("commands").drain_timeout_minutes()
        if running:
            rc = self.rollback_port_guard()
            if rc:
                return rc
        if self.dry == 1:
            lines = self.lib("confirm").rollback_lines(
                code, minutes, stopped=not running
            )
            say("\n".join(lines))
            return self.dry_run_outcome(
                "the code and settings from before your last apply can be put back; nothing changed"
            )
        if running:
            return self.rollback_running(kept.get("fingerprint", ""), code, minutes)
        return self.rollback_stopped(code)

    def rollback_port_guard(self) -> int:
        """Check 15's ports for the settings rollback puts back, before the doctor and the drain, as apply's
        port_guard checks its own: a dashboard port the kept docker/.env publishes (deliver.kept_on_host) that another
        program or container uses refuses, each port a FAIL row whose fix is to stop what uses it, then rollback
        again; then REFUSED (refuse_rows) and rollback again. A port this deployment's container publishes is its own
        (busy_ports), in this deployment's compose project (deployment_variables), never one the kept docker/.env
        names. Its exit code: 0 when every port is free or this deployment's container's; else 4.
        """
        d, ck = self.lib("deployment"), self.lib("checks")
        env = self.lib("deliver").kept_on_host(self.pkg)[0]
        values = dict(
            self.lib("image").dotenv_text(env or ""),
            COMPOSE_PROJECT_NAME=self.deployment_variables()["COMPOSE_PROJECT_NAME"],
        )
        then = ck.Command((self.program, "rollback"))
        fix = ck.Steps(("stop the program or container that uses it, then", then))
        rows = [
            d.busy_port_row(host, port, fix)
            for host, port in self.busy_ports(values, True)
        ]
        if rows:
            return self.refuse_rows(
                rows, "a port the dashboards need is in use", self.again_line()
            )
        return 0

    def rollback_running(self, fingerprint: str, code: bool, minutes) -> int:
        """rollback on the running container (cmd_rollback): apply's steps 1 to 3 (begin_running, which records CODE),
        the put-back of the settings and, with CODE, the code (put_back_now), then apply's steps 6 and 7 for the layer
        put back, whose fingerprint is FINGERPRINT, and the end (restored). A container that does not start again ends
        short, the record of the rollback kept (state 3)."""
        change = Change()
        ctrl_c_interrupts()
        try:
            before, rc = self.begin_running(change, minutes, code)
            if rc is None:
                rc = self.put_back_now(code, change)
            if rc is not None:
                return rc
            down = self.restart()
            if down is not None:
                text = (
                    "the code and settings from before your last apply are back, but the container did not start "
                    f"again: {down[0]}"
                )
                return self.end_short(change, True, text, fix=down[1])
            failure = self.wait_loaded(fingerprint, "the settings put back")
            self.undrain(change)
            if failure is None:
                say(
                    "  loaded: the monitor runs the settings from before your last apply"
                )
                failure = self.doctor_after(before)
        except KeyboardInterrupt:
            return self.interrupted(change)
        ctrl_c_ends()
        return self.restored(change, failure, running=True)

    def rollback_stopped(self, code: bool) -> int:
        """rollback on a stopped container (cmd_rollback): the record of the rollback, with CODE, and the put-back
        (put_back_now), through one-off containers of the image, then the end (restored); the container stays stopped.
        """
        change = Change()
        ctrl_c_interrupts()
        try:
            rc = self.begin_change("rollback", change, code_back=code)
            if rc is None:
                rc = self.put_back_now(code, change)
            if rc is not None:
                return rc
        except KeyboardInterrupt:
            return self.interrupted(change)
        ctrl_c_ends()
        return self.restored(change, None, running=False)

    def put_back_now(self, code: bool, change):
        """rollback's put-back, CHANGE's phase WRITING: what deliver kept, back in place (deliver.put_back, in
        this deployment's compose project and image: deployment_variables), then, with CODE, the code kept (root_code:
        code-back, after the settings, so that it runs in a container of the image they name). None once both are,
        after the lines that say so; else ERROR (end_short): when nothing changed, the record of the rollback gone;
        else kept (state 3)."""
        dl = self.lib("deliver")
        change.phase = Change.WRITING
        try:
            done = dl.put_back(
                self.deployment_variables(),
                package_dir=self.pkg,
                compose=self.deliver_compose,
            )
        except (dl.Failed, OSError, ValueError) as exc:
            changed = isinstance(exc, dl.Failed) and bool(exc.changed)
            why = self.said_above(exc)
            if isinstance(exc, dl.Failed):
                text = f"the settings from before your last apply could not be put back: {why}"
            else:
                text = f"the settings from before your last apply could not be put back ({why}): nothing changed"
            return self.end_short(change, changed, text)
        if not done:
            text = "no settings from before your last apply are kept; nothing changed"
            return self.end_short(change, False, text)
        say(
            "  put back: the settings from before your last apply, docker/.env and the override"
        )
        if code:
            rc, lines = self.root_code("code-back")
            if rc != 0:
                why = lines[-1][:200] if lines else "no answer"
                text = (
                    "the settings from before your last apply are back, but not its code "
                    f"(code-back exited {rc}: {why})"
                )
                return self.end_short(change, True, text)
        return None

    def restored(self, change, failure, running: bool) -> int:
        """rollback's end: the change it put back kept in the records (records.PutBack: the confirmed change, put
        back by rollback: state 10), with what failed after it and its fix (FAILURE, from the load or the doctor; None
        when nothing did); the record of the rollback gone, and with it the record that the last apply put a release in
        (records.Installed): the code is back. RESTORED, the container RUNNING or stopped; after a failure, ERROR with
        what failed and its fix. Then the state's next line."""
        rec, oc = self.lib("records"), self.lib("outcome")
        what, fix = failure or ("", None)
        record = rec.PutBack(
            self.confirmed().fingerprint, "rollback", rec.timestamp(), what, fix
        )
        rec.put_back(self.pkg, record)
        change.lease.finish(code=False)
        if failure is not None:
            text = f"the code and settings from before your last apply are back, with a failure: {what}"
            return oc.finish("ERROR", text, fix=fix, next=self.state_next_line())
        if running:
            text = (
                "the deployment runs the code and settings from before your last apply"
            )
        else:
            text = "the code and settings from before your last apply are in place; the container stays stopped"
        return oc.finish("RESTORED", text, next=self.state_next_line())

    # --- building an image (the build path) and the deploy path's image step ---------------------------------------
    def build_file(self, file: str):
        """(the build plan, the file as the lines name it, the checks of the file, an exit code) of FILE, your build
        settings file as you typed it (--settings FILE). The file is read at its full path, and named as
        settings_file.shown names it (`~/…` in your home folder): in its own rows here, and, through the name this
        returns, in each fix, next line and outcome of the build path after them, which never read it again. The checks:
        the file is a private file (private_files.problems: yours only, outside the package, git and cloud-synced
        folders), then a build settings file in this package's layout, read once (settings_file.read: its syntax,
        header, kind and layout, rkmon migrate the fix of another layout's; a file in the layout before layout 1 is
        refused with migrate's row, migrate.before_layout_1), then each key against the build schema and the others
        (settings_file.validate). The plan (build_plan.plan, not resolved) is None when the file cannot be read; it is
        made even when a key fails, so that the check can show what the network gives too. The exit code is 2 for an
        empty FILE, else 0: the caller refuses on a failed check.
        """
        if not file:
            err(
                f"{self.program} {self.cmd}: --settings <your build settings file> ({self.program} template build "
                "FILE writes one to start from)"
            )
            return None, "", [], 2
        retry = self.again(file)
        path = self.abspath(file)
        ck, sf = self.lib("checks"), self.lib("settings_file")
        shown = sf.shown(path)
        checks = self.lib("private_files").problems(
            path, self.pkg, "settings file", retry=retry, shown=shown
        )
        if ck.failed(checks):
            return None, shown, checks, 0
        try:
            doc = sf.read(path, self.lib("file_types").BUILD)
        except sf.Refused as exc:
            row = None
            if (
                exc.reason == "header"
            ):  # the layout before layout 1: migrate's row, named as the reader names its own
                row = self.lib("migrate").before_layout_1(
                    exc.first_key, shown, exc.rows[0].name
                )
            return None, shown, checks + ([row] if row else list(exc.rows)), 0
        except OSError as exc:
            found = f"{shown}: {exc.strerror or exc}"
            fix = ck.Command(("ls", "-l", shown))
            return (
                None,
                shown,
                checks + [ck.Check("settings file", ck.Status.FAIL, found, fix)],
                0,
            )
        checks += sf.validate(doc)
        p = self.lib("build_plan").plan(
            doc,
            self.lib("image").package_version(self.pkg),
            datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            platform.machine(),
        )
        return p, shown, checks, 0

    def resolved(self, p):
        """P, a build plan, with what only the network gives (build_plan.resolve, through deploy.fetcher, which trusts
        the root certificates P names too); None for None."""
        if p is None:
            return None
        fetch = self.lib("deploy").fetcher(ca_files=p.ca_files)
        return self.lib("build_plan").resolve(p, fetch)

    def cmd_build(self, ns) -> int:
        """The build path's step 3: one docker build of your build settings (rkmon_lib/build_plan.py: the plan,
        resolved, and its command, with the flags that lists and no other; --no-cache: none of docker's build cache).
        Its guards are step 2's rows of the build settings file (outside the package and git, mode 600, readable, its
        syntax, header, kind and layout, each key against the build schema), the build's own rows once what only the
        network gives is read (deployment.plan_checks: a ROCm release AMD's public folder does not list is one), its
        root certificates' (deployment.ca_checks), and the package folder's (no private file in it but its own: the
        build would carry it into the image): FAILED, exit 4, with each FAIL row; each WARN row is shown, and the build
        goes on. A docker build that fails is an ERROR, exit 1. BUILT NAME:TAG, exit 0, then step 4; under --dry-run,
        PASSED once every guard has, the docker build shown and not run, nothing staged.
        """
        st, ck, d = self.lib("steps"), self.lib("checks"), self.lib("deployment")
        p, file, file_checks, rc = self.build_file(ns.settings)
        if rc:
            return rc
        say(st.banner(st.BUILD_STEPS[2], self.dry == 1))
        checks = list(file_checks)
        if not ck.failed(file_checks):
            p = self.resolved(p)
            here = self.image_labels(p.image.ref) is not None
            checks += d.ca_checks(p.ca_files, file) + d.plan_checks(
                p, file_checks, file, here
            )
        checks += d.stray_rows(self.pkg, self.again_command())
        if ck.failed(checks):
            return self.check_outcome(checks, False, rows="problems")
        shown = ck.render(checks, "problems")
        if shown:
            say(shown)
            say("")
        return self.build_image(p, file, ns.no_cache)

    def build_image(self, p, file: str, no_cache: bool) -> int:
        """cmd_build's docker build of P, the resolved build plan of FILE, once its guards passed (NO_CACHE:
        --no-cache). Its build contexts, copies of the root certificates P names (deployment.stage_ca) and its build
        record (build_plan.record, as build_plan.RECORD_FILE), go in a private folder that only a real build makes,
        removed after it; --dry-run shows the command and runs nothing.
        """
        bp, d, out = self.lib("build_plan"), self.lib("deployment"), self.lib("outcome")
        named = len(p.ca_files)
        if named:
            say(
                f"the image trusts the {named} root certificate{'s' if named > 1 else ''} {d.CA_KEY} names"
            )
        if self.dry == 1:
            c = bp.command(p, self.engine, no_cache=no_cache)
            self.show(*c.shown_env, *c.shown_argv)
            return self.dry_run_outcome(f"{c.ref} can be built")
        folder = tempfile.mkdtemp(prefix="rkmon-build-")
        try:
            ca_dir, record_dir = (os.path.join(folder, n) for n in ("ca", "record"))
            os.mkdir(ca_dir, 0o700)
            os.mkdir(record_dir, 0o700)
            d.stage_ca(p.ca_files, ca_dir)
            record = os.path.join(record_dir, bp.RECORD_FILE)
            with open(record, "w", encoding="utf-8") as f:
                f.write(json.dumps(bp.record(p), indent=2) + "\n")
            os.chmod(record, 0o644)
            c = bp.command(p, self.engine, ca_dir, record_dir, no_cache)
            self.show(*c.shown_env, *c.shown_argv)
            rc = self.run(list(c.argv), env=dict(os.environ, **c.env), cwd=self.pkg)
        finally:
            shutil.rmtree(folder, ignore_errors=True)
        if rc:
            return out.finish(
                "ERROR",
                f"the docker build exited {rc}, so {c.ref} was not built",
                next=self.again_line(),
            )
        say(f"{c.ref}: {self.lib('image').describe(self.image_labels(c.ref) or {})}")
        return out.finish("BUILT", c.ref, next=self.build_next(4, file))

    def cmd_image_ls(self, ns) -> int:
        """This package's images here, whatever their name: the ones with its title label (docker/Dockerfile). A line
        for each tag of each, with what its labels say (image.describe); an image with no tag has none. Docker is asked
        twice, whatever the number of images: their IDs, then each one's tags and labels.
        """
        rc, out = self.ask_docker(
            "image",
            "ls",
            "--quiet",
            "--no-trunc",
            "--filter",
            f"label=org.opencontainers.image.title={self.lib('image').TITLE}",
        )
        # docker lists an image once for each of its tags
        ids = list(dict.fromkeys(out.split())) if rc == 0 else []
        rc, out = self.ask_docker("image", "inspect", *ids) if ids else (0, "[]")
        try:
            found = json.loads(out) if rc == 0 else []
        except ValueError:
            found = []
        lines = [
            f"{tag}  {self.lib('image').describe((each.get('Config') or {}).get('Labels') or {})}"
            for each in (found if isinstance(found, list) else [])
            if isinstance(each, dict)
            for tag in each.get("RepoTags") or []
        ]
        for line in lines:
            say(line)
        if not lines:
            say("no image of this package here")
        return 0

    def built_ref(self, file, step):
        """(the image the build path's STEP acts on, the build plan of your build settings, an exit code), after STEP's
        banner: with FILE, your build settings file, the image they name (image.name and image.tag; nothing is read
        over the network); with none, this deployment's image (image_ref) and no plan, or REFUSED, exit 3, while it
        names none (no_image_named). A build settings file whose own rows fail: FAILED, exit 4, after its FAIL rows.
        """
        st = self.lib("steps")
        if not file:
            say(st.banner(step, self.dry == 1))
            ref = self.image_ref()
            if not ref:
                return "", None, self.no_image_named()
            return ref, None, 0
        p, file, checks, rc = self.build_file(file)
        if rc:
            return "", None, rc
        say(st.banner(step, self.dry == 1))
        if self.lib("checks").failed(checks):
            return "", None, self.check_outcome(checks, False, rows="problems")
        self.build_settings = file
        return p.image.ref, p, 0

    def no_image_named(self) -> int:
        """REFUSED, exit 3 (an earlier step is not done), for a command of the build path without --settings while
        this folder's deployment names no image (image_ref: no deploy settings are confirmed here): the command again
        with --settings FILE, your build settings, which name the image."""
        typed = [*self.typed_without("--settings"), "--settings", "FILE"]
        return self.lib("outcome").finish(
            "REFUSED",
            "no image is named: no build settings were given (--settings), and no deploy settings are confirmed in "
            "this package folder; nothing changed",
            next=self.again_line(typed),
            earlier_step=True,
        )

    def build_next(self, n: int, file: str) -> str:
        """The build path's next line: step N's command with your build settings FILE, which name the image the next
        step acts on."""
        st = self.lib("steps")
        return st.next_line(st.BUILD_STEPS[n - 1], FILE=file)

    def no_image(self, ref: str) -> int:
        """REFUSED, exit 3 (an earlier step is not done): no image REF on this machine; the build is the step
        before."""
        return self.lib("outcome").finish(
            "REFUSED",
            f"no image {ref} on this machine; nothing changed",
            next=self.build_next(3, self.build_settings or "FILE"),
            earlier_step=True,
        )

    def strays(self) -> int:
        """The guard of a command that carries the package folder, or an image built from it, off this machine (the
        image's save and push), or its code into the container's code volume (the release that apply or the start
        puts in): FAILED, exit 4, with the package folder's row when private files that are not its own are in it
        (deployment.stray_rows); else 0."""
        rows = self.lib("deployment").stray_rows(self.pkg, self.again_command())
        return self.check_outcome(rows, False, rows="problems") if rows else 0

    def ship_done(self, ref: str, image_file: str = "") -> str:
        """The build path's done line: where the image is, and what the deploy machine does with it
        (IMAGE_FILE: the file it was saved to; none: a push, to the registry)."""
        key = self.lib("deployment").image_key("tag")
        tag = self.lib("deploy_tree").image_parts(ref)[1]
        where, step = (
            (f"in {image_file}", f"step 4 loads {image_file}")
            if image_file
            else ("in the registry", "step 4 pulls it")
        )
        return self.lib("steps").done_line(
            f"{ref} is ready ({where}). On the deploy machine, follow QUICK_DEPLOY_GUIDE.md from step 1, with the "
            f'package of this version; set {key} to "{tag}" in your deploy settings, and {step}'
        )

    def cmd_image_save(self, ns) -> int:
        """The build path's step 5, to a file: the image your build settings name (without --settings, this
        deployment's) to IMAGE_FILE, compressed, written whole: into a new file of this save's own beside it, made new
        and never through a link (whole_file.beside, FLAGS), then renamed onto it. SAVED NAME:TAG to IMAGE_FILE (N GiB),
        exit 0, then the done line; no such image: REFUSED, exit 3; a private file in the package folder that is not
        its own (the image built from it may hold it): FAILED, exit 4 (strays); docker save or the compression fails:
        ERROR, exit 1; nothing written.
        """
        st, out = self.lib("steps"), self.lib("outcome")
        ref, _b, rc = self.built_ref(ns.settings, st.BUILD_STEPS[4])
        if rc:
            return rc
        dest = self.abspath(ns.image_file)
        if self.image_labels(ref) is None:
            return self.no_image(ref)
        rc = self.strays()
        if rc:
            return rc
        gz = shutil.which("pigz") or "gzip"
        self.show(self.engine, "save", ref, "|", os.path.basename(gz), "-c", ">", dest)
        if self.dry == 1:
            return self.dry_run_outcome(f"{ref} can be saved to {dest}")
        wf = self.lib("whole_file")
        part = wf.beside(dest)
        try:
            with os.fdopen(os.open(part, wf.FLAGS, 0o666), "wb") as f:
                a = subprocess.Popen([self.engine, "save", ref], stdout=subprocess.PIPE)
                b = subprocess.Popen([gz, "-c"], stdin=a.stdout, stdout=f)
                a.stdout.close()
                rc_b, rc_a = b.wait(), a.wait()
            if not (rc_a or rc_b):
                os.replace(part, dest)
        except OSError as exc:
            return out.finish(
                "ERROR",
                f"{ref} was not saved ({exc}); nothing written",
                next=self.again_line(),
            )
        finally:
            with contextlib.suppress(OSError):  # renamed already, or never made
                os.unlink(part)
        if rc_a or rc_b:
            return out.finish(
                "ERROR",
                f"docker save or {os.path.basename(gz)} failed; nothing written",
                next=self.again_line(),
            )
        size = os.path.getsize(dest) / 2**30
        return out.finish(
            "SAVED",
            f"{ref} to {dest} ({size:.1f} GiB)",
            next=self.ship_done(ref, dest),
        )

    def cmd_image_load(self, ns) -> int:
        """The deploy path's step 4, from a file: docker load of IMAGE_FILE, then the checks of image check on the
        image of the name your deploy settings give that the file brought (image_check). LOADED NAME:TAG, exit 0, then
        the state's next line (state_next_line), before any confirm too; no file at IMAGE_FILE: its FAIL row, then
        FAILED, exit 4, under --dry-run too; no image of that name in the file: FAILED, exit 4; docker load fails:
        ERROR, exit 1.
        """
        st, out, ck = self.lib("steps"), self.lib("outcome"), self.lib("checks")
        key = self.lib("deployment").image_key("name")
        src = self.abspath(ns.image_file)
        say(st.banner(st.DEPLOY_STEPS[3], self.dry == 1))
        if not os.path.isfile(src):
            shown = self.lib("settings_file").shown(src)
            fix = ck.Steps(
                (
                    self.again(ns.image_file)("IMAGE_FILE"),
                    ", IMAGE_FILE being the image's file the build path saved (QUICK_BUILD_GUIDE.md)",
                )
            )
            say(
                ck.render(
                    [
                        ck.Check(
                            "the image's file",
                            ck.Status.FAIL,
                            f"no file at {shown}",
                            fix,
                        )
                    ]
                )
                + "\n"
            )
            return out.finish(
                "FAILED",
                f"{shown} is not loaded; {out.FIX_EACH_FAIL}",
                next=self.again_line(),
            )
        self.show(self.engine, "load", "-i", src)
        if self.dry == 1:
            return self.dry_run_outcome(f"{src} can be loaded")
        try:
            p = subprocess.run(
                [self.engine, "load", "-i", src], stdout=subprocess.PIPE, text=True
            )
        except OSError as exc:
            return out.finish(
                "ERROR", f"docker load did not run ({exc})", next=self.again_line()
            )
        sys.stdout.write(p.stdout)
        if p.returncode:
            return out.finish(
                "ERROR",
                f"docker load exited {p.returncode} (the lines above say why)",
                next=self.again_line(),
            )
        loaded = re.findall(r"Loaded image: (\S+)", p.stdout)
        file = self.recorded()
        if not file or not os.path.isfile(file) or self.settings_cfg(file)[0] is None:
            # No deploy settings to read (none confirmed yet, or a file that cannot be read): none name an image, so
            # the load is all this step does, and the state says what comes next.
            return out.finish(
                "LOADED", ", ".join(loaded) or src, next=self.state_next_line()
            )
        name = self.settings_name()
        parts = self.lib("deploy_tree").image_parts
        ours = [x for x in loaded if parts(x)[0] == name]
        if ours:
            return self.image_check(ref=ours[0], word="LOADED")
        names = {parts(x)[0] for x in loaded}
        value = (
            names.pop()
            if len(names) == 1
            else ck.Described("the name of the image in the file")
        )
        fix = ck.Steps(
            (
                ck.Edit(key, self.lib("settings_file").shown(file), value),
                ", then run",
                st.command_line("confirm"),
                "; or load the file the build path saved (QUICK_BUILD_GUIDE.md)",
            )
        )
        return out.finish(
            "FAILED",
            f"{src} has no {name} image ({', '.join(loaded) or 'none'}): your deploy settings name {name} "
            f"({key})",
            fix=fix,
            next=self.again_line(),
        )

    def registry(self) -> str:
        """The registry the confirmed deploy settings pull from (image.registry), "" when none."""
        c = self.confirmed()
        return c.image.registry.strip() if c is not None else ""

    def cmd_image_push(self, ns) -> int:
        """The build path's step 5, to a registry: the image your build settings name to the registry they name
        (image.registry), the extra tag removed after. PUSHED, exit 0, then the done line; no such image:
        REFUSED, exit 3; a private file in the package folder that is not its own: FAILED, exit 4 (strays); no
        registry: REFUSED, exit 4; a docker command fails: ERROR, exit 1.
        """
        st, out, ck = self.lib("steps"), self.lib("outcome"), self.lib("checks")
        ref, p, rc = self.built_ref(ns.settings, st.BUILD_STEPS[4])
        if rc:
            return rc
        if self.image_labels(ref) is None:
            return self.no_image(ref)
        rc = self.strays()
        if rc:
            return rc
        reg = p.image.registry.rstrip("/")
        if not reg:
            fix = ck.Steps(
                (
                    ck.Edit(
                        "image.registry",
                        self.build_settings,
                        ck.Described("your registry's address"),
                    ),
                    ", or save the image to a file:",
                    st.command_line(
                        st.BUILD_STEPS[4].command, FILE=self.build_settings
                    ),
                )
            )
            return out.finish(
                "REFUSED",
                "your build settings name no registry (image.registry); nothing pushed",
                fix=fix,
                next=self.again_line(),
            )
        remote = f"{reg}/{ref}"
        for argv in (
            [self.engine, "tag", ref, remote],
            [self.engine, "push", remote],
            [self.engine, "image", "rm", remote],
        ):
            self.show(*argv)
            if self.dry != 1:
                rc = self.run(argv)
                if rc:
                    return out.finish(
                        "ERROR",
                        f"docker {argv[1]} exited {rc}, so {ref} was not pushed",
                        next=self.again_line(),
                    )
        if self.dry == 1:
            return self.dry_run_outcome(
                f"{ref} can be pushed to the registry image.registry names"
            )
        return out.finish(
            "PUSHED",
            f"{ref} to the registry image.registry names",
            next=self.ship_done(ref),
        )

    def cmd_image_pull(self, ns) -> int:
        """The deploy path's step 4, from a registry: the image your confirmed deploy settings name (settings_image)
        from the registry they name, tagged here as they name it, then the checks of image check (image_check).
        PULLED NAME:TAG, exit 0, then step 5; outside its states, the state's refusal (state_guard); no registry:
        REFUSED, exit 4; a docker command fails: ERROR, exit 1."""
        d, st = self.lib("deployment"), self.lib("steps")
        out, ck = self.lib("outcome"), self.lib("checks")
        say(st.banner(st.DEPLOY_STEPS[3], self.dry == 1))
        self.state_guard()
        file = self.recorded()
        cfg, problem = self.settings_cfg(file)
        if cfg is None:
            return self.refuse_unread(problem)
        reg = self.registry().rstrip("/")
        if not reg:
            key = d.N("deployment.pull_registry")
            fix = ck.Steps(
                (
                    ck.Edit(
                        key,
                        self.lib("settings_file").shown(file),
                        ck.Described("your registry's address"),
                    ),
                    ", then run",
                    st.command_line("confirm"),
                    "; or load the image from a file:",
                    st.command_line(st.DEPLOY_STEPS[3].command),
                )
            )
            return out.finish(
                "REFUSED",
                f"your deploy settings name no registry ({key}); nothing pulled",
                fix=fix,
                next=self.state_next_line(),
            )
        ref = self.settings_image()
        remote = f"{reg}/{ref}"
        for argv in (
            [self.engine, "pull", remote],
            [self.engine, "tag", remote, ref],
            [self.engine, "image", "rm", remote],
        ):
            self.show(*argv)
            if self.dry != 1:
                rc = self.run(argv)
                if rc:
                    what = " ".join(argv[1:3] if argv[1] == "image" else argv[1:2])
                    return out.finish(
                        "ERROR",
                        f"docker {what} exited {rc} (the lines above say why)",
                        next=self.again_line(),
                    )
        if self.dry == 1:
            key = d.N("deployment.pull_registry")
            return self.dry_run_outcome(
                f"{ref} can be pulled from the registry {key} names"
            )
        return self.image_check(ref, "PULLED")

    def cmd_image_test(self, ns) -> int:
        """The build path's step 4: tests/container/image.py --no-build on the image your build settings name (without
        --settings, this deployment's). PASSED: NAME:TAG, exit 0, then step 5; no such image: REFUSED, exit 3; a test
        fails: FAILED, exit 4; the tests do not start: ERROR, exit 1."""
        st, out = self.lib("steps"), self.lib("outcome")
        ref, _b, rc = self.built_ref(ns.settings, st.BUILD_STEPS[3])
        if rc:
            return rc
        if self.image_labels(ref) is None:
            return self.no_image(ref)
        argv = [
            sys.executable,
            "-B",
            os.path.join(self.pkg, "tests", "container", "image.py"),
            "--no-build",
            "--image",
            ref,
        ]
        self.show(*argv)
        if self.dry == 1:
            return self.dry_run_outcome(f"{ref} can be tested")
        rc = self.run(argv)
        if rc == 0:
            return out.finish(
                "PASSED",
                ref,
                next=self.build_next(5, self.build_settings or "FILE"),
            )
        if rc in (126, 127):
            return out.finish(
                "ERROR", f"the tests of {ref} did not start", next=self.again_line()
            )
        return out.finish(
            "FAILED",
            f"{ref}: its tests failed (each FAIL above)",
            next=self.again_line(),
        )

    def cmd_image_check(self, ns) -> int:
        """The deploy path's step 4, for an image already here (image_check), in its states (state_guard)."""
        st = self.lib("steps")
        say(st.banner(st.DEPLOY_STEPS[3], self.dry == 1))
        self.state_guard()
        return self.image_check()

    def image_check(self, ref: str = "", word: str = "PASSED") -> int:
        """The checks of the deploy path's step 4, once a deploy settings file is recorded: the image (REF, the one a
        load or a pull just brought, WORD its outcome word, LOADED or PULLED; else the one your confirmed settings
        name, settings_image) is here, it was built from this package's image recipe (confirm.image_rows, from its own
        copies: recipe_changes), and it trusts this network's TLS. Each FAIL: FAILED, exit 4, with the command again.
        It writes nothing: for the image your confirmed settings name, WORD with the state's next line
        (state_next_line); for another tag, a load's, WORD with image.tag to name it, then the confirm.
        """
        d, st, out = self.lib("deployment"), self.lib("steps"), self.lib("outcome")
        ck = self.lib("checks")
        file = self.recorded()
        cfg, problem = self.settings_cfg(file)
        if cfg is None:
            return self.refuse_unread(problem)
        named = self.settings_image()
        ref = ref or named
        labels = self.image_labels(ref)
        if labels is None:
            checks = [d.no_image_row(cfg, file)]
        else:
            say(f"{ref}: {self.lib('image').describe(labels)}")
            checks = self.lib("confirm").image_rows(
                ref, self.recipe_changes(ref), False
            )
            # A throwaway container of the image, with the compose file's limits (its capabilities, its process cap).
            _rc, probe = self.ask_docker(
                "run",
                "--rm",
                *self.lib("container_layout").RUN_LIMITS,
                "--entrypoint",
                "python3",
                ref,
                "-I",
                "-c",
                d.TLS_PROBE,
                timeout=120,
            )
            checks += d.image_tls_checks(probe)
        say(ck.render(checks))
        say("")
        text = ref if word != "PASSED" else f"{ref} suits this package"
        if ck.failed(checks):
            left = (
                "nothing changed"
                if word == "PASSED"
                else f"{ref} is here, and nothing else changed"
            )
            failed, why = out.tally(checks, left)
            return out.finish(failed, why, next=self.again_line())
        if ref != named:
            # Another tag than your confirmed settings name (a load brings the image of their name it finds): a new
            # image is a settings change, image.tag then the confirm, whose next line leads on.
            tag = ck.Edit(
                d.image_key("tag"),
                self.lib("settings_file").shown(file),
                self.lib("deploy_tree").image_parts(ref)[1],
            )
            then = ck.Steps((tag, ", then", ck.Command((self.program, "confirm"))))
            return out.finish(word, text, next=self.next_of(then))
        if self.dry == 1:
            return self.dry_run_outcome(text)
        return out.finish(word, text, next=self.state_next_line())

    # --- the logins -----------------------------------------------------------------------------------------------
    def token_input(self, what: str):
        """A token from stdin (not a terminal), else asked without echo (typed_without_echo); None when none was
        given."""
        if not os.isatty(0):
            value = sys.stdin.read().strip()
        else:
            value = typed_without_echo(f"{what} (not shown): ").strip()
        return value or None

    def cmd_login(self, ns) -> int:
        """`login NAME [--with-token]`: one login, by its own flow in a one-off container (the writer's, gh's write
        login and atlassian's, as the writer: as_writer; claude's, the key alone: claude_login; the read login's, a
        read-only token alone: read_login): SET, with when the monitor starts using it (LOGIN_IN_USE), then the
        deployment state's next line; ERROR, then the command again, when the flow fails; with --with-token, no token
        typed is CANCELLED and none on stdin FAILED (login_token); outside its states, once its usage errors are
        said, the state's refusal (state_guard). An older name of a login is refused, with its name now
        (secrets_registry.renamed). `login [--no-input]`, with no NAME, is the deploy path's step 5, the walk over each
        login and secret (logins_walk); --no-input goes with it alone.
        """
        sr, joined = self.lib("secrets_registry"), self.lib("wrapping").joined
        what, with_token, no_input = ns.name, ns.with_token, ns.no_input
        if not what:
            if with_token:
                err(f"{self.program} login: --with-token goes with a login's NAME")
                return 2
            return self.logins_walk(no_input)
        if no_input:
            err(
                f"{self.program} login: --no-input goes with the walk over each login ({self.program} login), with no "
                "NAME"
            )
            return 2
        logins = [e.name for e in sr.entries({}) if e.shape == sr.LOGIN]
        renamed = sr.renamed({}, what)
        if renamed is not None:
            err(f"{self.program} login: {sr.older_name_refusal(what, renamed)}")
            return 2
        if what not in logins:
            err(f"{self.program} login: {joined(logins, 'or')} ({self.program} help)")
            return 2
        side = sr.GH_SIDES.get(what)  # a GitHub login's side, "write" or "read"
        if with_token and not side:
            how = (
                "takes its key typed, or on stdin, with no flag"
                if what == sr.CLAUDE_LOGIN
                else "logs in with its own flow"
            )
            err(
                f"{self.program} login: --with-token goes with {joined(sr.GH_SIDES, 'or')}; {what} {how}"
            )
            return 2
        self.state_guard()
        if what == sr.CLAUDE_LOGIN:
            return self.claude_login(sr.entry({}, what))
        if side == "read":
            return self.read_login(what)
        if side == "write":
            # The write login: as the write user, into /secrets-write/gh (no other user reads it); with --with-token, a
            # token in place of gh's browser flow.
            token = ""
            if with_token and self.dry != 1:
                token, ended = self.login_token(
                    "the GitHub token for the write login", "token", what
                )
                if ended is not None:
                    return ended
            rc = self.as_writer(
                "gh-write",
                "auth",
                "login",
                *(
                    ["--hostname", "github.com", "--with-token"]
                    if with_token
                    else ["--scopes", "read:org,repo"]
                ),
                stdin=(token + "\n").encode() if token else None,
                tty="-T" if with_token else None,
            )
        elif what == "atlassian":
            # The atlassian login: as the writer, into /secrets-write/atlassian (no other user reads it).
            rc = self.as_writer("atlassian", "auth", "login")
        else:
            err(
                f"{self.program} login: {what} has no login command here ({self.program} help)"
            )
            return 2
        if self.dry == 1:
            return self.dry_run_outcome(f"the login {what} can be set")
        if rc != 0:
            return self.set_outcome(
                "ERROR",
                f"the login flow of {what} exited {rc} (the lines above say why)",
            )
        return self.set_outcome("SET", f"{what}; {LOGIN_IN_USE[what]}")

    def login_token(self, what: str, kind: str, name: str):
        """A login's token or key from token_input, asked for as WHAT: (it, None); with none given, ("", the outcome):
        CANCELLED for none typed, FAILED for none on stdin, naming KIND (a token, a key) and the login NAME.
        """
        typed = os.isatty(0)
        value = self.token_input(what)
        if value:
            return value, None
        return "", self.set_outcome(
            "CANCELLED" if typed else "FAILED",
            f"no {kind} {'typed' if typed else 'on stdin'} for {name}; nothing changed",
        )

    def read_login(self, name: str) -> int:
        """`login github_read [--with-token]`: the read login's token alone, a GitHub token that can only read, typed
        without echo or from stdin (login_token), with --with-token or without: the read login has no browser flow,
        whose token could write. Never from a flag, and never shown. rk read-login logs it in, in the walk's one-off
        container (walk_inside), as the monitor, whose login it is, and refuses one that can write: its probe asks, in
        a folder of its own, before the read login's folder changes. SET, and when the monitor uses it;
        rk read-login's own outcome line when it refuses the token or fails, then the command again; CANCELLED for no
        token typed, FAILED for none on stdin; ERROR when docker fails (secret_set_outcome).
        """
        token = ""
        if self.dry != 1:
            token, ended = self.login_token(
                "the GitHub token for the read login (read-only)", "token", name
            )
            if ended is not None:
                return ended
        rc, said = self.walk_inside(
            "rk",
            "read-login",
            stdin=(token + "\n").encode() if token else b"",
            read=True,
        )
        return self.secret_set_outcome(name, rc, said, when=LOGIN_IN_USE[name])

    def claude_login(self, entry) -> int:
        """`login claude`: the Claude session's key alone (an Anthropic API key, or your gateway's token), typed
        without echo or from stdin, never from a flag, and never shown; rk secret-set claude writes it into the
        monitor's secrets volume (mode 600: secret_set), then rk claude-test makes the login's one test call with it,
        sent as the session sends its requests, from the walk's one-off container on the deployment's network
        (walk_inside), and shows its row. Where the key is sent, and how, are integrations.claude_code's
        settings. SET, and when the session reads it: as it next starts, and while a session runs (session_runs), the
        steps that start it again (steps.restart_parts); ERROR, the key set, when the test call does not pass;
        CANCELLED for no key typed, FAILED for none on stdin; rk secret-set's own outcome line when it refuses the key;
        ERROR when docker fails (secret_set_outcome).
        """
        key = ""
        if self.dry != 1:
            key, ended = self.login_token(
                "The Claude session's key: an Anthropic API key, or your gateway's token",
                "key",
                entry.name,
            )
            if ended is not None:
                return ended
        rc, said = self.secret_set(
            entry, entry.name, stdin=(key + "\n").encode() if key else b""
        )
        if rc == 0 and self.dry != 1:
            tested = self.walk_inside("rk", "claude-test", stdin=b"")
            # it shows its row, which the walk does not show again (logins_walk)
            self.shown = True
            if tested != 0:
                return self.set_outcome(
                    "ERROR",
                    f"{entry.name} is set, but its test call did not pass (the lines above say why)",
                )
        when = LOGIN_IN_USE[entry.name]
        if rc == 0 and self.dry != 1 and self.session_runs():
            restart = self.lib("steps").restart_parts(self.program)
            when += f" ({self.lib('checks').Steps(restart)})"
        return self.secret_set_outcome(entry.name, rc, said, when=when)

    def set_outcome(self, word: str, text: str) -> int:
        """The outcome of `login NAME` or `secret NAME`: WORD and TEXT, then the command again after ERROR or
        FAILED, else the deployment state's next line. Inside the walk (logins_walk), which shows the entry's row again
        in its place (unless the command showed it: shown), the exit code alone, WORD kept for the walk (walked).
        """
        out = self.lib("outcome")
        if self.walking:
            self.walked = word
            return out.code(word)
        again = word in ("ERROR", "FAILED")
        return out.finish(
            word, text, next=self.again_line() if again else self.state_next_line()
        )

    def cmd_secret(self, ns) -> int:
        return self.secret(ns.name, ns.file, ns.generate, ns.remove)

    def secret(
        self, name: str, file=None, generate: bool = False, remove: bool = False
    ) -> int:
        """One secret the secrets registry lists, into its file in the container (rk secret-set NAME checks its shape
        and writes it, mode 600). Its value comes from FILE (a private file of yours), from stdin (`-`, or another
        command's output), or typed without echo; never from a flag's value, and it is never printed, nor its length.
        GENERATE makes the value of an entry the registry makes here and shows it once, on your terminal; REMOVE
        removes the secret's file (rk secret-set NAME --remove). NAME is the name of a secret among the entries your
        confirmed settings give (confirmed_values: a model binding's key among them); any other is a usage error, in
        secrets_registry.name_refusal's words: a login's name, or an older name, with the command that sets it. Before
        the first confirm only the fixed entries are known, and a name that reads as a secret's goes on to the state's
        refusal. A secret the writer keeps goes in as the writer, from here only (secret_set). The ssh key of a host is
        followed by the host's own keys, shown, and recorded once you accept them (host_key). Its outcome: SET,
        or REMOVED; FAILED for a file that breaks a private file's rule, or an empty value from stdin or a file;
        CANCELLED for none typed; rk secret-set's own outcome line when it refuses the value or fails, then the command
        again; host_key's, once an ssh key is set. Outside its states, once its usage errors are said, the state's
        refusal (state_guard), before any value is read.
        """
        sr, oc = self.lib("secrets_registry"), self.lib("outcome")

        def usage_error(what: str) -> int:
            """The command's usage error: what is wrong, then the table's usage and the names NAME takes."""
            cmds = self.lib("commands")
            names = ", ".join(e.name for e in sr.entries({}) if e.shape != sr.LOGIN)
            err(
                f"{self.program} secret: {what}; usage: {cmds.usage_line(cmds.find(('secret',), cmds.TABLE))} "
                f"(NAME: {names}, or the secret a model binding's api_key_secret_name names)"
            )
            return oc.USAGE

        if generate and remove:
            return usage_error("--generate and --remove go apart")
        if (generate or remove) and file is not None:
            return usage_error(
                f"{'--generate' if generate else '--remove'} takes no FILE"
            )
        values = self.confirmed_values()
        why = sr.name_refusal(values, name)
        if why:
            return usage_error(why)
        entry = sr.entry(values or {}, name)
        if generate and (entry is None or entry.made_by != sr.GENERATED):
            made_here = [e.name for e in sr.entries({}) if e.made_by == sr.GENERATED]
            err(
                f"{self.program} secret: --generate goes with {self.lib('wrapping').joined(made_here, 'or')}, whose "
                f"value is made here; give {name}'s from a file, from stdin (-) or typed"
            )
            return 2
        if generate and self.dry != 1 and not os.isatty(1):
            err(
                f"{self.program} secret {name} --generate: its value is shown once, on your terminal, and the output "
                "is no terminal: nothing made"
            )
            return 2
        self.state_guard()
        if remove:
            rc, said = self.secret_set(entry, name, "--remove")
            return self.secret_set_outcome(name, rc, said, removed=True)
        if generate:
            return self.generate_secret(name, entry)
        refused = ("FAILED", f"{name} is not set; {oc.FIX_EACH_FAIL}")
        value, source = None, ""
        if file == "-":
            if self.dry != 1:
                source = "typed" if os.isatty(0) else "stdin"
                value = (
                    self.token_input(name) or ""
                )  # stdin; on a terminal, asked without echo
        elif file is not None:
            src = self.abspath(file)
            retry = self.lib("private_files").again(
                (self.program, "secret", name, file), file
            )
            if self.refused_file(src, "the secret's file", retry):
                say("")
                return self.set_outcome(*refused)
            with open(src, encoding="utf-8") as f:
                value, source = f.read(), file
        elif not os.isatty(0) and self.dry != 1:
            value, source = sys.stdin.read(), "stdin"
        if value is None and self.dry != 1:
            value = typed_without_echo(
                f"{name} (not shown; for a key file, give its path instead): "
            )
            if value.strip().startswith(("/", "~")) and os.path.isfile(
                os.path.expanduser(value.strip())
            ):
                return self.secret(name, value.strip())
            source = "typed"
        if self.dry != 1 and not (value or "").strip():
            if source == "typed":
                return self.set_outcome(
                    "CANCELLED", f"no value typed for {name}; nothing changed"
                )
            return self.set_outcome(
                "FAILED", f"{source} has no value for {name}; nothing changed"
            )
        rc, said = self.secret_set(entry, name, stdin=(value or "").encode())
        if rc == 0 and self.dry != 1 and self.lib("host_keys").host(name):
            return self.host_key(name)
        return self.secret_set_outcome(name, rc, said)

    def host_key(self, name: str) -> int:
        """`secret NAME`'s last step once the ssh key of a host is set, and the walk's for one that is set while the
        host's own key is not recorded (logins_walk; rkmon_lib/host_keys.py: web_host_ssh_key, gpu_ssh_key): the
        host's own keys as `rk host-key NAME` reads them with ssh-keyscan, in the walk's
        one-off container on the deployment's network, where ssh reaches the host, shown by their fingerprints for you
        to compare with those its admin gives you. Once you accept them, on a terminal, `rk host-key NAME --record`
        records them in the internal state, and ssh trusts the host by them alone. SET when they are recorded, or were
        already, when your settings name no host yet, or when none is read while some are recorded (the outcome says
        which); CANCELLED, the key set, when you say no or there is no terminal; ERROR when rk fails, or when none is
        read and none is recorded.
        """
        h, w = self.lib("host_keys").host(name), self.lib("wrapping")
        rc, out = self.walk_inside("rk", "host-key", name, "--json", quiet=True)
        got = first_json(out, "{")
        if not isinstance(got, dict):  # rk says why
            say(out.rstrip("\n"))
            return self.set_outcome(
                "ERROR",
                f"{name} is set, but {h.words}'s own keys could not be read (the lines above say why)",
            )
        host, why = str(got.get("host") or ""), str(got.get("why") or "")
        lines, others = list(got.get("lines") or []), int(got.get("others") or 0)
        if not host:
            return self.secret_set_outcome(
                name, 0, when=f"{why}, so {h.words}'s own keys are not read yet"
            )
        if not lines and others:
            return self.secret_set_outcome(
                name,
                0,
                when=f"{h.words}'s own keys were not read ({why}), and those recorded for it "
                f"({w.counted(others, 'key')}) are kept",
            )
        if not lines:
            return self.set_outcome(
                "ERROR",
                f"{name} is set, but {h.words}'s own keys were not read from the container ({why}): until one is "
                f"recorded, ssh does not reach {host}",
            )
        if got.get("recorded"):
            return self.secret_set_outcome(
                name, 0, when=f"{h.words}'s own keys ({host}) are recorded already"
            )
        say(
            f"\n{h.words[:1].upper()}{h.words[1:]}'s own keys ({host}), as the container reads them; compare their "
            "fingerprints with those its admin gives you:"
        )
        for line in got.get("fingerprints") or lines:
            say(f"  {line}")
        if others:
            say(
                f"They replace the {w.counted(others, 'key')} recorded for it now: unless the host was set up anew, "
                "ask its admin why its keys changed before you accept them."
            )
        # the file's form: on a terminal, `secret NAME -` asks for the key on one line
        if not self.interactive():
            return self.set_outcome(
                "CANCELLED",
                f"{name} is set, but {h.words}'s own keys are recorded only once you accept them, on a terminal "
                f"({self.program} secret {name} FILE)",
            )
        if not self.confirm(
            f"Record them as {h.words}'s own keys, the only ones ssh trusts it by?",
            default=False,
        ):
            return self.set_outcome(
                "CANCELLED",
                f"you said no: {name} is set, and {h.words}'s own keys as the container reads them are not recorded",
            )
        rc = self.walk_inside(
            "rk",
            "host-key",
            name,
            "--record",
            stdin="".join(x + "\n" for x in lines).encode(),
        )
        if rc != 0:  # rk says why
            return self.set_outcome(
                "ERROR",
                f"{name} is set, but {h.words}'s own keys are not recorded (the lines above say why)",
            )
        return self.secret_set_outcome(
            name, 0, when=f"{h.words}'s own keys ({host}) are recorded"
        )

    def secret_set_outcome(
        self,
        name: str,
        rc: int,
        said: str = "",
        removed: bool = False,
        made: str = "",
        when: str = "",
    ) -> int:
        """`secret NAME`'s outcome once rk secret-set NAME ran in the container with exit code RC, SAID what it said
        (REMOVED: with --remove; MADE: the value --generate made, shown once before the outcome; WHEN: when the
        monitor starts using it, after the name): SET or REMOVED; under --dry-run, PASSED with what the real run would
        do. When rk secret-set refused the value (4), or failed with its own ERROR line (1, own_outcome), that line
        stands, and the command again follows it; so does its usage error (2), alone. Any other exit, or an exit 1
        with no ERROR line of rk's (a traceback, or docker's own failure): ERROR."""
        if self.dry == 1:
            did = "removed" if removed else "made and set" if made else "set"
            return self.dry_run_outcome(f"{name} can be {did}")
        if rc == 0:
            if made:
                say(
                    f"{name}, shown this once (keep it where you keep passwords; {self.program} secret {name} "
                    f"--generate makes another):\n  {made}"
                )
            if removed:
                return self.set_outcome(
                    "REMOVED", f"{name}: the container has no value for it"
                )
            return self.set_outcome("SET", f"{name}; {when}" if when else name)
        if rc in (2, 4) or rc == 1 and self.own_outcome(said, rc):
            # rk secret-set's own outcome line, or its usage error, said why
            if rc != 2 and not self.walking:
                self.say_next(self.again_line())
            return rc
        return self.set_outcome(
            "ERROR",
            f"docker exited {rc}, so {name} is {'not removed' if removed else 'not set'} (the lines above say why)",
        )

    def generate_secret(self, name: str, entry) -> int:
        """rkmon secret NAME --generate: a new value for ENTRY, an entry the secrets registry makes here (its made_by
        GENERATED), set in the container (rk secret-set NAME) and shown once, on your terminal, as you give it where it
        is asked for (the admin dashboard asks each browser for its access token). With no terminal, nothing is made:
        secret() says so, with its other usage errors.
        """
        sr = self.lib("secrets_registry")
        if self.dry == 1:
            rc, said = self.secret_set(entry, name, stdin=b"")
            return self.secret_set_outcome(name, rc, said, made="-")
        value = sr.generate(entry)
        rc, said = self.secret_set(entry, name, stdin=(value + "\n").encode())
        return self.secret_set_outcome(name, rc, said, made=value)

    def compose_config(self, *options: str):
        """docker compose config's answer for this deployment as JSON, OPTIONS given before --format: a mapping, or None
        when docker gives none that can be read. Read-only, and not printed."""
        rc, out = self.ask_docker("compose", "config", *options, "--format", "json")
        if rc != 0:
            return None
        try:
            doc = json.loads(out)
        except ValueError:
            return None
        return doc if isinstance(doc, dict) else None

    def volumes_here(self, names):
        """Those of the volumes NAMES that are on this host, each listed by its exact name (identity.exact_name); None
        when docker's answer cannot be read. Read-only, and not printed."""
        names = sorted(set(names))
        if not names:
            return set()
        exact = self.lib("identity").exact_name
        filters = [w for n in names for w in ("--filter", f"name={exact(n)}")]
        rc, out = self.ask_docker("volume", "ls", *filters, "--format", "{{.Name}}")
        if rc != 0:
            return None
        return set(names) & set(out.split())

    def own_volumes(self):
        """This deployment's volumes on this host, sorted, each found by its exact name, never by a pattern: those
        docker compose made for its compose project, the confirmed container.name, by their project label; and those
        the compose files declare for it, but one declared external, that are here. The files are read with
        docker/.env's variables put in (compose_config) whenever docker/.env is there: the override, which deliver
        writes only together with it, publishes the team dashboard's port on the address docker/.env gives, which
        docker compose cannot read with no variable put in. While there is no docker/.env, which is also while there is
        no override, they are read with none put in (--no-interpolate): the names need none, and before the first
        start, while your file changed after the confirm, the variables are not known. None when docker's answers
        cannot be read. Read-only, and not printed."""
        project = self.project()
        rc, out = self.ask_docker(
            "volume",
            "ls",
            "--filter",
            f"label={self.lib('identity').PROJECT}={project}",
            "--format",
            "{{.Name}}",
        )
        env_here = self.dotenv_there()
        options = () if env_here else ("--no-interpolate",)
        doc = self.compose_config(*options) if rc == 0 else None
        if doc is None:
            return None
        tops = doc.get("volumes") if isinstance(doc.get("volumes"), dict) else {}
        declared = self.volumes_here(
            volume_name(project, key, v)
            for key, v in tops.items()
            if not (isinstance(v, dict) and v.get("external"))
        )
        if declared is None:
            return None
        return sorted(set(out.split()) | declared)

    def secrets_volumes(self):
        """The volumes this deployment's container keeps its logins and secrets in that are on this host: {the folder
        it mounts each at, container_layout.SECRETS_DIR or WRITE_SECRETS_DIR: the volume}, each as docker compose config
        names it in this deployment's compose project; None when docker's answers cannot be read, or name no such
        volume. Read-only: it makes nothing."""
        cl = self.lib("container_layout")
        doc = self.compose_config()
        if doc is None:
            return None
        tops = doc.get("volumes") if isinstance(doc.get("volumes"), dict) else {}
        services = doc.get("services") if isinstance(doc.get("services"), dict) else {}
        mounts = [
            m
            for s in services.values()
            if isinstance(s, dict)
            for m in s.get("volumes") or ()
            if isinstance(m, dict) and m.get("type") == "volume" and m.get("source")
        ]
        project = self.project()
        want = {
            m["target"]: volume_name(project, m["source"], tops.get(m["source"]))
            for m in mounts
            if m.get("target") in (cl.SECRETS_DIR, cl.WRITE_SECRETS_DIR)
        }
        if not want:
            return None
        here = self.volumes_here(want.values())
        if here is None:
            return None
        return {folder: name for folder, name in want.items() if name in here}

    def logins_unset(self, image: str):
        """Before the first start, the names of the logins and secrets the confirmed settings need
        (confirm.login_places, read from them alone) that the volumes that keep them do not hold: every one while none
        of those volumes is on this host (secrets_volumes; `rkmon login` makes them), else as a one-off container of
        IMAGE reads them (confirm.HELD_PROBE), with no network and only those volumes, mounted read-only and never
        filled from the image: it makes no network and no volume. None when the confirmed settings or docker's answers
        cannot be read. Read-only, and not printed."""
        c = self.lib("confirm")
        values = self.confirmed_values()
        if values is None:
            return None
        places = c.login_places(values)
        volumes = self.secrets_volumes() if places else {}
        if volumes is None:
            return None
        if not volumes:
            return tuple(dict.fromkeys(p[0] for p in places))
        mounts = [
            w
            for folder, name in sorted(volumes.items())
            for w in (
                "--mount",
                f"type=volume,source={name},target={folder},readonly,volume-nocopy",
            )
        ]
        rc, answer = self.ask_docker(
            "run",
            "--rm",
            "--network",
            "none",
            *self.lib("container_layout").RUN_LIMITS,
            *mounts,
            "--entrypoint",
            "python3",
            image,
            "-I",
            "-c",
            c.HELD_PROBE,
            json.dumps(places),
            timeout=120,
        )
        try:
            return c.unheld(answer, places) if rc == 0 else None
        except ValueError:
            return None

    def own_secrets_volume(self, project: str) -> str:
        """The volume the deployment of the compose project PROJECT, a deploy settings file's container.name, keeps its
        logins and secrets in (container_layout.SECRETS_DIR): <PROJECT>_<container_layout.SECRETS_VOLUME>, as docker
        compose names it, while docker lists it among the volumes that compose project made (project_volumes) and the
        name is this folder's or no container's (whose); "" otherwise, and when docker gives no answer. Only read-only
        listings filtered on PROJECT's compose project label: before the first confirm, it reads no other deployment's
        object, and it makes none.
        """
        ident = self.lib("identity")
        if self.whose(project) not in (ident.OURS, ident.NONE):
            return ""
        name = f"{project}_{self.lib('container_layout').SECRETS_VOLUME}"
        return name if name in (self.project_volumes(project) or ()) else ""

    def claude_env_checks(self, doc, made, values: dict, *refs: str) -> list:
        """Check 16's rows (confirm.claude_env_rows) of the configuration VALUES, of DOC, the deploy settings
        document, as MADE, what it makes on this host (deploy_plan.plan): what the older Claude secret in this
        deployment's own secrets volume (own_secrets_volume, by MADE's container name) says against them, as a one-off
        container of the first of the images REFS on this host reads it (confirm.SHAPE_PROBE: names and settings, never
        a value), with no network and that volume alone, mounted read-only where the container mounts it and never
        filled from the image. No row while there is no such volume, as on a fresh deployment: then no container runs,
        for `docker run` makes a volume it is given that does not exist. A SKIP while none of REFS is here
        (confirm.claude_env_skip), or the container read nothing (confirm.claude_env_unread): each says what to do
        before rkmon confirm runs again. Read-only, and not printed."""
        c, cl = self.lib("confirm"), self.lib("container_layout")
        places = c.claude_env_places(values)
        if places is None:
            return []
        volume = self.own_secrets_volume(made.variables["COMPOSE_PROJECT_NAME"])
        if not volume:
            return []
        ref = next((r for r in refs if self.image_labels(r) is not None), "")
        if not ref:
            return c.claude_env_skip(places, f"{refs[0]} is not on this host")
        rc, out = self.ask_docker(
            "run",
            "--rm",
            "--network",
            "none",
            *cl.RUN_LIMITS,
            "--mount",
            f"type=volume,source={volume},target={cl.SECRETS_DIR},readonly,volume-nocopy",
            "--entrypoint",
            "python3",
            ref,
            "-I",
            "-c",
            c.SHAPE_PROBE,
            cl.IMAGE_CODE,
            places.older,
            places.login,
            timeout=120,
        )
        try:
            found = c.claude_env_answer(rc, out, places)
        except ValueError as exc:
            return c.claude_env_unread(places, ref, rc, str(exc))
        return c.claude_env_rows(values, doc, found)

    def logins_rows(self, walk: bool = False):
        """`rk logins --json` in the container (WALK: in the walk's one-off, for your confirmed settings: walk_inside):
        its rows, or None when it gave none (no configuration yet)."""
        words = ("rk", "logins", "--json")
        rc, out = (
            self.walk_inside(*words, quiet=True) if walk else self.quiet_inside(*words)
        )
        rows = first_json(out, "[")
        return rows if isinstance(rows, list) else None

    def login_check(self, row):
        """One entry of the login walk's list (confirm.walk_list) as its check row: SET is a PASS; MISSING and
        WRONG (confirm.UNSET) a FAIL, UNKNOWN a WARN, each with the command that sets it as its fix, or for the ssh key
        of a host whose own key is not recorded (its host_key), `login`, which shows that key and records it once you
        accept it (host_keys.record_fix). NOT NEEDED is OFF, naming the modes it waits for, but for one used
        meanwhile (its use: the atlassian login, while tickets are only prepared), a WARN with the command that sets
        it.
        """
        ck = self.lib("checks")
        state, found, what = row.get("state"), row.get("found") or "", row.get("what")
        name, waiting = row["name"], row.get("waiting") or ""
        if state == "SET":
            return ck.Check(name, ck.Status.PASS, found or "set")
        fix = (
            self.lib("host_keys").record_fix(self.program)
            if row.get("host_key")
            else ck.Command((self.program, *str(row.get("command") or "").split()))
        )
        if state == "NOT NEEDED":
            if row.get("use"):
                text = f"not set: {what}; {waiting}, so {row['use']}"
                return ck.Check(name, ck.Status.WARN, text, fix)
            off = f"{what}: nothing that is on needs it"
            return ck.Check(
                name, ck.Status.OFF, off + (f" yet ({waiting})" if waiting else "")
            )
        said = {"MISSING": "not set", "WRONG": "wrong", "UNKNOWN": "not checked"}
        text = said.get(state, str(state)) + (f" ({found})" if found else "")
        needs = ", ".join(row.get("needed_by") or ()) or "nothing that is on"
        unset = state in self.lib("confirm").UNSET
        return ck.Check(
            name,
            ck.Status.FAIL if unset else ck.Status.WARN,
            f"{text}: {what}, needed by {needs}",
            fix,
        )

    def logins_walk(self, no_input: bool = False) -> int:
        """The deploy path's step 5: each login and secret something that is on may need, as a check row with the
        command that sets it as its fix (login_check), from the login walk's list, which state 7 reads too
        (confirm.walk_list): what needs each one read from your confirmed settings, here on the host, and its state
        from rk logins in the walk's one-off container, which reads the volumes (walk_inside), before the first start
        too; when rk logins gives no rows, its own words, then ERROR. On a terminal, unless NO_INPUT (--no-input) or
        --dry-run, it offers to run each FAIL row's command in turn, and shows that row again after it, unless the
        command showed it itself (claude's test row: shown); for the ssh key of a host, set while the host's own key is
        not recorded (as one the one-time move copies), it asks nothing first: it shows that key, and records it once
        you accept it (host_key). Then, once the first start has made the container (deployed), the doctor's findings
        on them while the container runs your confirmed settings (confirm_applied); until you apply them, one line says
        that the doctor's findings on them come with apply: the container still runs your earlier ones. And one
        outcome: PASSED once no row fails, then the state's next line (state_next_line: step 6's before the first
        start); CANCELLED when you said no to each one left, at its question or at the command's own (an outcome
        CANCELLED: walked); else FAILED, then the command again. A row whose command failed counts as left, though it
        may pass now (claude's key is set when its test call fails). It runs once this deployment's image is here (step
        4): without it, REFUSED, with the state's fix and next line; as `login`, in that command's states
        (state_guard).
        """
        d, st, ck = self.lib("deployment"), self.lib("steps"), self.lib("checks")
        cf = self.lib("confirm")
        say(st.banner(st.DEPLOY_STEPS[4], self.dry == 1))
        self.probe_unknown("the logins")
        self.state_guard()
        c = self.confirmed()
        image = c.image.reference if c is not None else self.image_ref()
        if self.image_labels(image) is None:
            return self.refuse_without_image(image)
        rows = self.logins_rows(walk=True)
        if rows is None:  # rk logins says why
            say(self.walk_inside("rk", "logins", quiet=True)[1].rstrip("\n"))
            return self.lib("outcome").finish(
                "ERROR",
                "the logins could not be read (the lines above say why)",
                next=self.again_line(),
            )
        values = self.confirmed_values()
        listed = cf.walk_list(values, rows)
        checks = [self.login_check(r) for r in listed]
        if checks:
            say(ck.render(checks))
        declined, failed = set(), set()
        offers = [c for c in checks if c.status == ck.Status.FAIL]
        recording = {r["name"] for r in listed if r.get("host_key")}
        if offers and not no_input and self.dry != 1 and self.interactive():
            say("")
            for c in offers:
                # an ssh key that is set: host_key asks its own question, once it shows the host's keys
                if c.name not in recording:
                    verb = "make" if "--generate" in c.fix.argv else "set"
                    if not self.confirm(f"{c.name}: {verb} it now?"):
                        declined.add(c.name)
                        continue
                self.walking, self.walked, self.shown = True, "", False
                try:
                    if c.name in recording:
                        self.host_key(c.name)
                    else:
                        self.run_words(c.fix.argv[1:])
                finally:
                    self.walking = False
                # a no at the command's own question, or nothing given to it, is your no too; a command that failed
                # leaves its row, though the row may pass now
                if self.walked == "CANCELLED":
                    declined.add(c.name)
                elif self.walked in ("ERROR", "FAILED"):
                    failed.add(c.name)
                rows = self.logins_rows(walk=True) or rows
                listed = cf.walk_list(values, rows)
                checks = [self.login_check(r) for r in listed]
                if not self.shown:
                    say(ck.render([x for x in checks if x.name == c.name]))
        left = [c for c in checks if c.status == ck.Status.FAIL or c.name in failed]
        # the doctor runs once the first start has made the container, and checks the settings that run
        deployed = self.deployed() is not None
        if deployed and not self.confirm_applied():
            say(
                f"\nThe doctor's findings on these settings come with {self.program} apply: the container still "
                "runs your earlier ones."
            )
        elif deployed:
            say("\nThe doctor, on the logins:")
            rc, out = self.quiet_inside("rk", "doctor")
            shown = 0
            for status, _name, lines in d.doctor_rows(out):
                if status in self.lib("checks").PROBLEMS and re.search(
                    r"(?i)login|GitHub|gh |atlassian|Teams|web host|webhook|Claude session|Claude Code",
                    lines[0],
                ):
                    for line in lines:
                        say("  " + line)
                    shown += 1
            if not shown:
                say("  no login check fails")
        say("")
        oc, w = self.lib("outcome"), self.lib("wrapping")
        if not left:
            warned = sum(1 for c in checks if c.status == ck.Status.WARN)
            text = "every login and secret your settings need is set"
            if warned:
                text += f" ({w.counted(warned, 'warning')})"
            return oc.finish("PASSED", text, next=self.state_next_line())
        n, needed = len(left), sum(1 for r in listed if r.get("needed_by"))
        text = (
            f"of the logins and secrets your settings need, {n} of {needed} "
            f"{'is' if n == 1 else 'are'} missing or wrong"
        )
        if all(c.name in declined for c in left):
            return oc.finish(
                "CANCELLED", f"you said no; {text}", next=self.state_next_line()
            )
        return oc.finish("FAILED", oc.AFTER_FAILS.format(text), next=self.again_line())

    # --- 6 start, stop, status ------------------------------------------------------------------------------------
    def volume_guard(self) -> None:
        """Check 15's volumes, before anything asks the container, since a one-off container mounts them:
        each volume this deployment would use, as docker compose config names them in its compose project, is not
        another deployment's on this host (volume_owners). Else Stopped: their FAIL row, whose fix gives
        container.name a name of its own, then REFUSED (exit 4) and the state's next line as it is known before the
        container is asked. When docker gives no answer, or one that cannot be read, it stops as only_ours does
        (volume_rows). Read-only, and not printed.
        """
        ident, ck = self.lib("identity"), self.lib("checks")
        project = self.project()
        unchanged = "nothing changed"
        configs = self.volume_rows(unchanged, "compose", "config", "--format", "json")
        declared = [c.get("volumes") for c in configs]
        owners = self.volume_owners(
            (
                volume_name(project, key, v)
                for d in declared
                if isinstance(d, dict)
                for key, v in d.items()
            ),
            unchanged,
        )
        taken = sorted(n for n, owner in owners.items() if owner == ident.OTHER)
        if not taken:
            return
        many = len(taken) > 1
        shown = self.lib("settings_file").shown(self.recorded())
        row = ck.Check(
            "volumes" if many else "volume",
            ck.Status.FAIL,
            f"{self.lib('wrapping').joined(taken)} {'are' if many else 'is'} used by another deployment on this host",
            self.lib("states").name_fix(project, shown),
        )
        whose = (
            "volumes this deployment would use are"
            if many
            else "a volume this deployment would use is"
        )
        raise Stopped(
            self.refuse_rows(
                [row],
                f"{whose} another deployment's",
                next_line=self.state_next_line(ask=False),
            )
        )

    def start_guards(self, values: dict, recipe: bool = True) -> int:
        """What refuses a start in its states (state_guard), each as check rows with their fixes, then REFUSED (exit 4)
        and the state's next line, for VALUES, the variables docker compose reads for the start (compose_variables):
        the image they name, when it was not built from this package's image recipe (confirm.image_rows, from its own
        copies: recipe_changes), unless RECIPE is False (state 10: the release put back runs, which its
        id ties to its image); a dashboard port the start opens that another program or container uses (check 15).
        No image: state 6's sentence. Its exit code: 0 when nothing refuses.
        """
        ck = self.lib("checks")
        file = self.recorded()
        cfg = self.settings_cfg(file)[0]
        if cfg is None:
            return self.refuse()
        ref = self.image_ref(values["RKMON_TAG"], values["RKMON_IMAGE"])
        if self.image_labels(ref) is None:
            return self.refuse_without_image(ref)
        rows = []
        if recipe:
            rows = self.lib("confirm").image_rows(ref, self.recipe_changes(ref), False)
        if ck.failed(rows):
            return self.refuse_rows(
                rows, f"the image {ref} does not suit this package folder"
            )
        shown = self.lib("settings_file").shown(file)
        return self.port_guard(cfg, values, shown)

    def said_above(self, exc) -> str:
        """What an outcome line says of EXC, the failure of a delivery or a put back (deliver.Failed, OSError,
        ValueError), once what it shows above the outcome is said: a private file's refusal (private_files.Refused),
        deliver's own or carried by Failed (its `above`), shows itself, its rows then where the rules are, and the words
        say that the lines above say why; else EXC's own words."""
        if isinstance(exc, self.lib("private_files").Refused):
            say(str(exc))
            return "the lines above say why"
        if getattr(exc, "above", ""):
            say(exc.above)
        return str(exc)

    def port_guard(self, cfg, values: dict, shown: str) -> int:
        """Check 15's ports, before the container starts or is made again: a dashboard port it opens (VALUES: the
        variables docker compose reads for it) that another program or container uses refuses, each port a FAIL row
        whose fix is the key of the deploy settings file SHOWN (CFG: the configuration that file makes), then REFUSED
        (refuse_rows). Its exit code: 0 when every port is free or this folder's container's (busy_ports).
        """
        d = self.lib("deployment")
        # only_ours has run: the container name is this folder's, or no container's
        rows = d.busy_port_checks(cfg, self.busy_ports(values, True), shown)
        if rows:
            return self.refuse_rows(rows, "a port the dashboards need is in use")
        return 0

    def first_delivery(self, plan) -> int:
        """The first start's delivery: PLAN, the confirmed settings' (deploy_plan), into place by deliver
        (rkmon_lib/deliver.py), their one writer: docker/.env, the compose override and the settings volume's layer,
        what they replace kept for rollback as deliver decides (keep_previous: not when the layer in place is the
        plan's already, after a first start that stopped once it was in). Under --dry-run, nothing is written. Its exit
        code: 0 when the settings are in place; REFUSED (exit 3), nothing changed, and the state's next line (5: the
        confirm) when a team's skill changed since the confirm (deliver.SkillsChanged); else ERROR, nothing started,
        with what changed (a layer in place that cannot be read changes nothing) and the command again.
        """
        dl, oc = self.lib("deliver"), self.lib("outcome")
        say(f"your confirmed settings go into {self.lib('wrapping').joined(dl.WRITES)}")
        if self.dry == 1:
            return 0
        try:
            keep = self.keep_previous(plan)
            dl.deliver(plan, keep, package_dir=self.pkg, compose=self.deliver_compose)
        except dl.SkillsChanged as exc:
            return oc.finish(
                "REFUSED",
                f"{exc}; nothing started",
                next=self.state_next_line(),
                earlier_step=True,
            )
        except dl.Failed as exc:
            return oc.finish(
                "ERROR",
                f"{self.said_above(exc)}; nothing started",
                next=self.again_line(),
            )
        except OSError as exc:
            return oc.finish(
                "ERROR",
                f"your confirmed settings could not be put in place ({exc}); nothing changed",
                next=self.again_line(),
            )
        return 0

    def refuse_rows(self, rows: list, why: str, next_line: str = "") -> int:
        """REFUSED after ROWS, the FAIL rows that refuse the command, as checks.render prints them: WHY, then that
        nothing changed and each row has its fix, then the deployment state's next line; NEXT_LINE in its
        place, for a refusal that comes before the container may be asked. Its exit code: 4.
        """
        ck, oc = self.lib("checks"), self.lib("outcome")
        say(ck.render(rows))
        say("")
        return oc.finish(
            "REFUSED",
            f"{why}; {oc.FIX_EACH_FAIL}",
            next=next_line or self.state_next_line(),
        )

    def wait_running(self, seconds: int = 90) -> bool:
        end = time.monotonic() + seconds
        while time.monotonic() < end:
            if self.running():
                return True
            time.sleep(3)
        return self.running()

    def start_said(self, seconds: int = START_SAID_SECONDS) -> None:
        """What the container says as it starts, which a start that starts it shows above its outcome: the entry point
        (docker/entrypoint.sh) runs rk start at each start and says its lines in the container's log, the one-time
        move's report among them. They are read from the log as they come (docker compose logs --follow), from
        the container's start (container_started) up to rk start's last line, on the Claude side (control.CLAUDE_SIDE),
        for SECONDS at most: each line the entry point says, after its time and its name (control.ENTRY_POINT_SAYS),
        without them, under a line that says whose they are. A start whose time docker does not give, or a log that
        ends first, says no more; one that has not come to that last line in time says so, and names the command that
        shows the log. Read-only.
        """
        started = self.container_started()
        if started is None:
            return
        self.only_ours()
        control = self.lib("control")
        said = re.compile(rf"^\S+ {re.escape(control.ENTRY_POINT_SAYS)}(.*)$")
        since = started.strftime("%Y-%m-%dT%H:%M:%SZ")
        argv = [self.engine, "compose", "logs", "--follow", "--no-log-prefix"]
        argv += ["--since", since, SERVICE]
        sys.stdout.flush()
        sys.stderr.flush()
        try:
            p = subprocess.Popen(
                argv,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                errors="replace",
            )
        except OSError:
            return
        late = threading.Event()

        def time_up():
            late.set()
            p.kill()

        timer = threading.Timer(seconds, time_up)
        timer.start()
        shown = False
        try:
            for line in iter(p.stdout.readline, ""):
                m = said.match(line.rstrip("\n"))
                if not m:
                    continue
                if not shown:
                    say("what the container says as it starts:")
                    shown = True
                say(f"  {m.group(1)}")
                if m.group(1).startswith(control.CLAUDE_SIDE):
                    return
            if late.is_set() and shown:
                say(
                    f"  (the rest did not come within {seconds} seconds: {self.program} logs shows it)"
                )
            elif late.is_set():
                say(
                    f"the container said nothing of its start within {seconds} seconds: {self.program} logs shows "
                    "what it says"
                )
        finally:
            timer.cancel()
            if p.poll() is None:
                p.kill()
            p.wait()
            p.stdout.close()

    def stop_waiting(self):
        """Before the first start's one-offs, a container that waits for its first start (state 8: it was started some
        other way than start, and its work volume is not set up, Facts.not_set_up) stops: nothing runs in it yet, and
        a wait that ended between rk provision and rk init would start a monitor whose state rk init then keeps
        unseeded. Whether its volume is set up is asked again first, and a container whose volume is set up by now
        never stops: NOTHING TO DO, as while the container runs. It says so, in plain words. None once it is stopped;
        else the outcome's exit code: ERROR when it does not stop, nothing started, then the command again.
        """
        oc = self.lib("outcome")
        if DockerAnswers(self).set_up(self.project()):
            return oc.finish(
                "NOTHING TO DO",
                "the container is running",
                next=self.state_next_line(),
            )
        say(
            f"the container was started some other way than {self.program} start, and waits for its first start: it "
            "stops, then the first start runs"
        )
        rc = self.compose("stop")
        if rc:
            return oc.finish(
                "ERROR",
                "the container that waits for its first start did not stop (the lines above say why); nothing started",
                next=self.again_line(),
            )
        return None

    def start_code(self, values: dict) -> tuple:
        """The start's code (cmd_start): this package's code over the image VALUES name, the variables docker compose
        reads for the start (root_code: code-install, with release_archive and code_volume.LEAVE_KEPT, so that a
        rollback still goes back to the code from before the last apply), as apply puts it in, so that the monitor
        runs this package's code on any image built from its image recipe (start_guards); code-install has nothing to
        do while that code runs there already. (0, whether a release went in: went_in) once it is in place; else (the
        outcome's exit code, False), the monitor not started: REFUSED, exit 4, when the code needs a new image
        (new_image_needed), then the state's next line; ERROR, with what code-install said last (install_failed), then
        the command again."""
        cv, oc = self.lib("code_volume"), self.lib("outcome")
        archive = self.release_archive()
        rc, lines = self.root_code(
            "code-install", values, archive, options=(cv.LEAVE_KEPT,)
        )
        if rc == 0:
            return 0, self.went_in(lines)
        if rc == cv.NEW_IMAGE:
            what, fix = self.new_image_needed()
            text = f"{what}, so the monitor did not start"
            return (
                oc.finish("REFUSED", text, fix=fix, next=self.state_next_line()),
                False,
            )
        text = f"{self.install_failed(rc, lines)}, so the monitor did not start"
        return oc.finish("ERROR", text, next=self.again_line()), False

    def clear_stop(self, indent: str = "") -> int:
        """A stop or drain left behind in the monitor's state (an rk stop --drain before the container was made again,
        say) is cleared: rk start in the container. The line that says so starts with INDENT: inside apply, as its
        steps' lines do (first_apply)."""
        rc, out = self.quiet_inside("rk", "stopped")
        if rc == 0:
            say(
                f"{indent}the monitor was stopped ({out.strip()}): clearing it with rk start"
            )
            return self.inside("rk", "start")
        return 0

    def cmd_start(self, ns) -> int:
        """`start [--on]`, the deploy path's step 6, in its deployment states (state_guard: never started, put back, or
        stopped); while the container runs, NOTHING TO DO and the state's next line, except while it waits for its first
        start (state 8: it was started some other way, and its work volume is not set up). Before the container is
        asked, check 15's volumes (volume_guard); then the start's guards (start_guards; in state 10 not the image
        recipe's, since the release put back runs), under --dry-run too. Never started (state 8): your confirmed
        settings into place first (first_delivery); a container that waits for its first start then stops
        (stop_waiting), and the first start runs as for none. A later start starts what is in place and never applies
        a change: a change that waits is state 11's, which names apply. Then, but in state 10 (put back: its code is
        the one the rollback or the put-back put back), this package's code goes in
        (start_code), since an image passes the guards by its image recipe, so its own code may be an older package's;
        a private file in the package folder that is not its own, which the release would carry, refuses the start
        first, before anything is written, under --dry-run too (strays). Then rk provision runs its steps
        (rkmon_lib/provision.py): at the first start they set the work volume up from your confirmed settings; at a
        later one they put back what has gone missing, change nothing in place, and probe the local review loop's
        server again if provision._probes_again says so; rk init seeds the monitor's state the first time, the
        monitor on, and with --on rk resume ends a pause `pause` set (without --on it stays, as rk init says). Each
        runs in a one-off container, since after an image load the running container may still be the old image's;
        then the container starts (made again when it runs, a stop left in it, and a release went in: what runs in it
        runs that release only once it starts again), what it says as it starts is shown once it has started
        (start_said), and a stop or drain left in it is cleared. One outcome:
        STARTED, which says so while the monitor runs in standby (states.with_standby), then the state's next line
        (state_now: step 7's, the doctor, after a start; step 7's too while the monitor does not say yet which
        settings it runs, NoAnswer, which the doctor then says); NOTHING TO DO; a refusal; ERROR when a command fails
        on the way, which says what it left undone (an rk command, not one for you, by that alone), then the command
        again. Ctrl-C from the first change on: INTERRUPTED (start_interrupted).
        """
        st, oc, sts = self.lib("steps"), self.lib("outcome"), self.lib("states")
        say(st.banner(st.DEPLOY_STEPS[5], self.dry == 1))

        def while_running():
            if self.quiet_inside("rk", "stopped")[0] == 0:
                return None  # a stop that rk stop left in the running container: state 12's, which the start clears
            if not DockerAnswers(self).set_up(self.project()):
                return None  # it waits for its first start: state 8's, which the start makes
            return oc.finish(
                "NOTHING TO DO",
                "the container is running",
                next=self.state_next_line(),
            )

        facts = self.state_guard(running=while_running, host_check=self.volume_guard)
        state = sts.current(facts)
        plan = None
        if state.n == 8:
            plan = self.confirmed_plan()
            if plan is None:
                return self.refuse()
        values = self.compose_variables(plan.variables if plan is not None else None)
        # this package's code goes in, but in state 10, whose code is the one a rollback or a put-back put back: that
        # release's id ties its code to its image, so no image recipe is asked of the image either
        code = state.n != 10
        rc = self.start_guards(values, recipe=code)
        if rc:
            return rc
        if code:
            # root's code-install looks for no private file (docker/rk_root.py): one would go into the release
            rc = self.strays()
            if rc:
                return rc
        # Ctrl-C from the first change on ends the start in the outcome that says where it stopped (start_interrupted)
        ctrl_c_interrupts()
        doing = "putting your confirmed settings in place"
        try:
            if plan is not None:
                rc = self.first_delivery(plan)
                if rc:
                    return rc
            if facts.not_set_up:
                doing = "stopping the container that waits for its first start"
                rc = self.stop_waiting()
                if rc is not None:
                    return rc
            went_in = False
            if code:
                doing = "putting this package's code in"
                rc, went_in = self.start_code(values)
                if rc:
                    return rc
            # rk in a one-off container: after an image load, the running one may still be the old image's. Each run
            # with what it does, for an interrupt, and what its failure leaves undone: rk's commands are not for you,
            # so that line names what failed, never the command; the lines above it say why.
            rk = ("run", "--rm", self.tty, *self.envs(), SERVICE, "rk")
            runs = [
                (
                    (*rk, "provision"),
                    "setting up the work volume",
                    "the work volume is not set up in full (what was in place stays as it is)",
                ),
                (
                    (*rk, "init", "--if-new", "--on"),
                    "seeding the monitor's state",
                    "the monitor's state is not seeded",
                ),
            ]
            if ns.on:
                runs.append(
                    ((*rk, "resume"), "ending the pause", "the pause is not ended")
                )
            up = ("up", "-d")
            # the container starts when it does not run, or is made again: then its entry point says what it says as
            # it starts (start_said)
            starts = not self.running()
            if went_in and not starts:
                say(
                    "the container runs the code from before: it is made again, so that it runs the code that went in"
                )
                up += ("--force-recreate",)
                starts = True
            runs.append((up, "starting the container", "docker compose up exited {rc}"))
            for args, doing, undone in runs:
                rc = self.compose(*args)
                if rc:
                    return oc.finish(
                        "ERROR",
                        f"{undone.format(rc=rc)}, so the monitor did not start (the lines above say why)",
                        next=self.again_line(),
                    )
            if self.dry == 1:
                return self.dry_run_outcome("the monitor can start")
            if not self.wait_running():
                return oc.finish(
                    "ERROR",
                    f"the container did not stay up ({self.program} logs says why)",
                    next=self.again_line(),
                )
            if starts:
                doing = "reading what the container says as it starts"
                self.start_said()
            if self.clear_stop():
                return oc.finish(
                    "ERROR",
                    "the container runs, and the stop left in it is not cleared (the lines above say why)",
                    next=self.again_line(),
                )
            text = "the monitor runs your confirmed settings"
            if state.n == 10:
                # the state's words alone: with_standby says standby once, at the end; after a first apply over an older
                # package that failed, nothing was put back, and the new monitor runs what that apply delivered
                ran = "from before it"
                if facts.first_apply:
                    ran = "that apply put in place"
                text = f"{state.words(facts)}, and the monitor runs the settings {ran}"
            try:
                after, nxt = self.state_now()
                text = sts.with_standby(text, after)
            except (
                NoAnswer
            ):  # the monitor does not say yet which settings it runs: the doctor says why
                nxt = st.next_line(st.DEPLOY_STEPS[6], plain=sts.step_8_passed(facts))
        except KeyboardInterrupt as exc:
            return self.start_interrupted(doing, exc)
        return oc.finish("STARTED", text, next=nxt)

    def start_interrupted(self, doing: str, exc: KeyboardInterrupt) -> int:
        """Ctrl-C during the start, from its first change on: INTERRUPTED, exit 130, with what the
        start was DOING, and what changed when it stopped while putting your confirmed settings in place (EXC, deliver's
        Interrupted, says it), then the state's next line, which says what to run. A second Ctrl-C meanwhile ends the
        start by the signal (ctrl_c_ends)."""
        ctrl_c_ends()
        text = f"the start stopped while {doing}"
        changed = getattr(exc, "changed", "")
        if changed:
            text += f": {changed}"
        return self.lib("outcome").finish(
            "INTERRUPTED", text, next=self.state_next_line()
        )

    def cmd_stop(self, ns) -> int:
        """`stop [--drain [--timeout-minutes N]]`: this deployment's container stops (docker compose stop), in
        its states (state_guard); start brings it back. With --drain, the work in flight finishes first, for at most N
        minutes (stop_drained; commands.drain_timeout_minutes by default); --timeout-minutes without --drain is a usage
        error. One outcome: STOPPED, or NOTHING TO DO while it does not run, each with the deployment state's next line;
        ERROR when docker cannot stop it, then the command again."""
        oc = self.lib("outcome")
        minutes = self.lib("commands").drain_timeout_minutes()
        if ns.timeout_minutes is not None:
            if not ns.drain:
                err(f"{self.program} stop: --timeout-minutes goes with --drain")
                return 2
            minutes = self.minutes(ns.timeout_minutes)
            if minutes is None:
                return 2
        self.state_guard()
        if not self.running():
            return oc.finish(
                "NOTHING TO DO",
                "the container is not running",
                next=self.state_next_line(),
            )
        if ns.drain:
            return self.stop_drained(minutes)
        rc = self.compose("stop")
        if rc:
            return oc.finish(
                "ERROR",
                f"docker compose stop exited {rc} (the lines above say why)",
                next=self.again_line(),
            )
        if self.dry == 1:
            return self.dry_run_outcome("the container can stop")
        return oc.finish(
            "STOPPED", "the monitor's container", next=self.state_next_line()
        )

    def stop_drained(self, minutes: float) -> int:
        """stop --drain on the running container: the drain, for MINUTES at most (drain: when the work in
        flight does not finish in time, or another drain is on, its outcome, nothing stopped); then rk stop in the
        container, which records the stop and lifts the drain in one write, so that nothing starts in between
        (rkmon_lib/control.py); then docker compose stop. STOPPED, with the state's next line. ERROR, then the command
        again, when rk stop fails (its lines said; the drain lifted, the container running on) or docker compose stop
        does (the monitor in the container stopped). Ctrl-C during the drain lifts it (interrupted); rk stop and docker
        compose stop each run to their end whatever Ctrl-C does (run_whole), and a Ctrl-C meanwhile is taken then
        (stop_interrupted). Under --dry-run, the three commands shown."""
        oc = self.lib("outcome")
        change, stopping = Change(), False
        ctrl_c_interrupts()
        try:
            # rk drain sets it first: Ctrl-C meanwhile lifts it (interrupted)
            change.drained = True
            rc = self.drain(minutes, ("--drain",))
            change.drained = rc is None
            if rc is not None:
                return rc
            stopping = True
            rc, out = self.inside("rk", "stop", capture=True, whole=True)
            if rc:
                for line in out.splitlines():
                    say(f"  {line}")
                self.undrain(change)
                return oc.finish(
                    "ERROR",
                    f"rk stop in the container exited {rc}, so the container was not stopped (the lines above say "
                    "why)",
                    next=self.again_line(),
                )
            rc = self.compose("stop", whole=True)
            if rc:
                return oc.finish(
                    "ERROR",
                    f"docker compose stop exited {rc} (the lines above say why); the monitor in the container is "
                    "stopped, and the container runs on",
                    next=self.again_line(),
                )
        except KeyboardInterrupt:
            return self.stop_interrupted() if stopping else self.interrupted(change)
        ctrl_c_ends()
        if self.dry == 1:
            return self.dry_run_outcome(
                "the work in flight can finish, then the container can stop"
            )
        return oc.finish(
            "STOPPED", "the monitor's container", next=self.state_next_line()
        )

    def stop_interrupted(self) -> int:
        """Ctrl-C during stop --drain once its drain is done, taken once rk stop or docker compose
        stop has run to its end: while the container runs, rk start in it undoes the stop, and the drain with it:
        INTERRUPTED, nothing changed, then the command again; once the container has stopped, there is nothing to
        undo: INTERRUPTED, the container stopped, then the state's next line, as when rk start fails in it. Exit 130.
        A second Ctrl-C meanwhile ends the command by the signal (ctrl_c_ends)."""
        ctrl_c_ends()
        oc = self.lib("outcome")
        if not self.running():
            return oc.finish(
                "INTERRUPTED",
                "the container stopped before Ctrl-C was taken, so it stays stopped",
                next=self.state_next_line(),
            )
        rc, out = self.quiet_inside("rk", "start")
        if rc:
            last = (out.strip().splitlines() or ["no answer"])[-1]
            return oc.finish(
                "INTERRUPTED",
                f"rk start in the container exited {rc} ({last[:200]}), so the monitor in it stays stopped",
                next=self.state_next_line(),
            )
        return oc.finish(
            "INTERRUPTED", self.unchanged_words(True), next=self.again_line()
        )

    def cmd_pause(self, ns) -> int:
        """`pause`: the monitor starts no new work, and the work in flight finishes (pause_or_resume)."""
        return self.pause_or_resume(True)

    def cmd_resume(self, ns) -> int:
        """`resume`: the monitor starts new work again, after a pause (pause_or_resume)."""
        return self.pause_or_resume(False)

    def pause_or_resume(self, pause: bool) -> int:
        """pause (PAUSE) or resume: rk's command of the same name in the running container, in its states
        (state_guard). One outcome: PAUSED or RESUMED, or NOTHING TO DO when the monitor says it is paused, or not,
        already (rk applied --json); each with the deployment state's next line. ERROR when rk's command fails: what
        it said, then the command again."""
        oc = self.lib("outcome")
        self.state_guard()
        try:
            paused = self.monitor_answer().paused
        except NoAnswer:
            paused = None  # rk's own command says what is wrong
        if paused is pause:
            text = "the monitor is paused" if pause else "the monitor is not paused"
            return oc.finish("NOTHING TO DO", text, next=self.state_next_line())
        rc, out = self.inside("rk", self.cmd, capture=True)
        if rc:
            if out.strip():
                say(out.rstrip("\n"))
            return oc.finish(
                "ERROR",
                f"rk {self.cmd} exited {rc} (the lines above say why)",
                next=self.again_line(),
            )
        if self.dry == 1:
            return self.dry_run_outcome(f"the monitor can {self.cmd}")
        if pause:
            word, text = (
                "PAUSED",
                "the monitor starts no new work; the work in flight finishes",
            )
        else:
            word, text = "RESUMED", "the monitor starts new work again"
        return oc.finish(word, text, next=self.state_next_line())

    def cmd_standby_off(self, ns) -> int:
        """`standby off`: rk standby-off in the running container (rkmon_lib/standby.py), in state 14 alone
        (state_guard), once the monitor you moved from has stopped: the one-time move from an older install ended, if
        one is open, then standby, so that the monitor sends again, as your settings allow. What rk says stands: its
        RELEASED, or its REFUSED with the fix, nothing changed, each followed by the deployment state's next line; its
        ERROR, the end stopped part-way, followed by this command again. Any other exit, or an exit 1 with no ERROR line
        of rk's (a traceback: own_outcome): ERROR, and this command again. In any other state, standby_off_elsewhere.
        Nothing of any other deployment is asked.
        """
        oc = self.lib("outcome")
        self.state_guard(outside=self.standby_off_elsewhere)
        rc, out = self.inside("rk", "standby-off", capture=True)
        if self.dry == 1:
            return self.dry_run_outcome("the monitor can leave standby")
        if out.strip():
            say(out.rstrip("\n"))
        if rc in (0, 4):  # rk's own outcome line, RELEASED or REFUSED, said it
            self.say_next(self.state_next_line())
            return rc
        if rc == 1 and self.own_outcome(out, rc):
            # rk's own ERROR said what the end did, and why it stopped
            self.say_next(self.again_line())
            return rc
        return oc.finish(
            "ERROR",
            f"rk standby-off exited {rc} (the lines above say why)",
            next=self.again_line(),
        )

    def standby_off_elsewhere(self, state, facts) -> int:
        """standby off in STATE, one other than 14, of FACTS (state_guard's OUTSIDE): once the running
        monitor has said whether it is in standby (state_facts.monitor_asked), NOTHING TO DO while it is not
        (states.NOT_IN_STANDBY), else REFUSED: standby stays on, and the state's own words say why (states.stays_on),
        then the state's fix; each with the state's next line. Until the monitor has said, the state's refusal
        (refuse). Its exit code.
        """
        st = self.lib("states")
        if not self.lib("state_facts").monitor_asked(facts):
            return self.refuse(facts=facts)
        since = self.since_start(state, facts)
        if facts.standby:
            return st.refuse(state, facts, st.stays_on(state, facts), since=since)
        return self.lib("outcome").finish(
            "NOTHING TO DO", st.NOT_IN_STANDBY, next=st.next_line(state, facts, since)
        )

    def cmd_status(self, ns) -> int:
        """`status [--queue]`: the deployment's state first: the line that names this folder's deployment
        (status_head), the state's sentence with its note and fix (progress.state_lines), and the next line rkmon next
        ends with (where); then, while this folder's container runs, the monitor's own status from it (rk status, with
        --queue its queue). Read-only, but for the first tick since a start that it may be the first to see, which this
        folder's records keep (first_tick_seen), and exit 0 whatever docker or rk say: what cannot be read says
        unknown, and why; nothing of another deployment's container is asked, and nothing makes a Docker object
        (DockerAnswers).
        While the running monitor does not say which settings it runs (NoAnswer), the state is unknown, and why: rk's
        refusal as rk says it, with its fix.
        """
        pr, wrap = self.lib("progress"), self.lib("wrapping").wrap
        answers = DockerAnswers(self)
        try:
            here = self.where(answers=answers)
        except NoAnswer as exc:
            lines = self.status_head(answers)
            if exc.refused:
                lines += wrap(f"unknown ({exc.unknown})", pr.WIDTH, pr.STATE)
                lines += exc.lines
            else:
                lines += wrap(
                    f"unknown ({exc.unknown}; {exc.why()})", pr.WIDTH, pr.STATE
                )
        else:
            report = here.report
            lines = self.status_head(answers, here.facts)
            lines += pr.state_lines(here.facts, here.note, here.unknown_why)
            lines += [report.next] + ([report.also] if report.also else [])
        say("\n".join(lines))
        if self.whose() != self.lib("identity").OURS or not self.running():
            return 0
        say("")
        queue = ["--queue"] if ns.queue else []
        rc = self.inside("rk", "status", *queue)
        if rc != 0:
            say(
                f"the monitor's status: unknown (rk status exited {rc}: the lines above say why)"
            )
        return 0

    def status_head(self, answers, facts=None) -> list:
        """rkmon status's first line, wrapped: `deployment NAME (this package folder) · CONTAINER · FEATURES`:
        this folder's container name (project; before the first confirm, NO_NAME says there is none yet, and no
        container is asked); its container, as ANSWERS (DockerAnswers) has it or asks it: running
        since when it started, stopped, none, or unknown while its name is another deployment's or docker cannot say
        whose it is (nothing of it is then asked); and, while your file is as you confirmed it (FACTS, the state
        table's; None while they are not known), each feature the confirmed settings turn on, with its mode
        (features.on_words)."""
        st, ident, pr = self.lib("states"), self.lib("identity"), self.lib("progress")
        f = facts
        word = self.whose()
        status = st.NO_CONTAINER
        if word == ident.OURS:
            status = answers.status or answers.container(self.project())[0]
        if word not in (ident.NONE, ident.OURS):
            box = "container unknown"
        elif status == st.RUNNING:
            since = answers.started
            box = f"running since {pr.shown_time(since)}" if since else "running"
        else:
            box = "stopped" if status == st.STOPPED else "no container"
        name = self.project()
        head = f"deployment {name} (this package folder)" if name else NO_NAME
        parts = [head, box]
        same = (
            f is not None and not f.file_changed and f.file_layout == f.package_layout
        )
        if same and f.settings_file and f.file_exists:
            cfg = self.settings_cfg(self.recorded())[0]
            if cfg is not None:
                feats = self.lib("features")
                parts += feats.on_words(cfg) or [feats.NONE_ON]
        return self.lib("wrapping").wrap(" · ".join(parts), pr.WIDTH)

    # --- 7 doctor, 8 first tick, and where you are ------------------------------------------------------------------
    def where(self, file: str = "", answers=None):
        """Where this deployment is on the deploy path (rkmon_lib/progress.py), as rkmon next, status and doctor say it:
        a Where, from the state table's facts (state_facts: this folder's records, and what its own container says,
        through ANSWERS, a DockerAnswers, a new one when None), and what the container did since it started
        (after_start), once the container was asked, or when the state's next line reads it (states.reads_since); FILE,
        a deploy settings file as you typed it, is judged too: steps 1 and 2 are then its.
        Read-only, but for the first tick since a start that it may be the first to see, which this folder's records
        keep (first_tick_seen); nothing of another deployment's container is asked; while docker cannot say whose the
        container name is, nothing of the container is asked either: its steps read unknown, the note says why, and
        the next line is the state's only where the records decide it alone (progress.deploy).
        """
        pr, st = self.lib("progress"), self.lib("states")
        layout = self.lib("file_types").DEPLOY.version
        word, why, no_answer = self.owner_of()
        unknown = word == UNKNOWN
        answers = DockerAnswers(self) if answers is None else answers
        facts = self.state_facts(answers)
        started = doctor = tick = None
        if answers.status is not None or st.reads_since(st.current(facts), facts):
            started, doctor, tick = self.after_start(facts, answers)
        judged = None
        if file:
            path = self.abspath(file)
            exists = os.path.isfile(path)
            rec = self.recorded()
            judged = pr.Judged(
                self.lib("settings_file").shown(path),
                exists,
                self.file_layout(path) if exists else layout,
                tuple(self.deploy_checks(path, self.again(file))) if exists else (),
                bool(rec) and os.path.realpath(path) == os.path.realpath(rec),
            )
        # The note says why docker's answer is unknown.
        note = why if unknown else ""
        unknown_why = (NO_ANSWER if no_answer else UNREADABLE_ANSWER) if unknown else ""
        report = pr.deploy(
            facts,
            judged,
            confirmed_once=self.confirmed() is not None,
            logins_read=answers.logins_read,
            started=pr.shown_time(started) if started is not None else "",
            tick=tick,
            note=note,
            unknown_why=unknown_why,
            doctor=doctor,
        )
        return Where(facts, report, note, unknown_why)

    def after_start(self, facts, answers=None) -> tuple:
        """What this folder's container did since it started, as rkmon next reads deploy steps 7 and 8: (when it
        started; the doctor's last result since then, doctor_since; the last tick since then, last_tick_after_start,
        as rkmon next shows a time), while docker runs it, an rk stop left in it too: (None, None, None) while it does
        not, and, nothing asked, while docker is not asked about this folder's deployment (state_facts.asks_docker:
        FACTS' name_owner another deployment's or unknown), and for ANSWERS, a DockerAnswers, that asks no container.
        The start time is ANSWERS' once it asked the container."""
        if not self.lib("state_facts").asks_docker(facts.name_owner):
            return None, None, None
        if answers is not None and not answers.ask:
            return None, None, None
        if answers is not None and answers.status is not None:
            started = answers.started
        else:
            started = self.container_started() if self.running() else None
        if started is None:
            return None, None, None
        tick = self.last_tick_after_start(started)
        at = parse_time(tick or "")
        if at is not None:
            tick = self.lib("progress").shown_time(at)
        return started, self.doctor_since(started), tick

    def since_start(self, state, facts, answers=None):
        """What has passed since this folder's container started (progress.since_start, from after_start), when
        STATE's next line reads it (states.reads_since); else nothing is asked, and nothing has
        (states.NOT_STARTED)."""
        st = self.lib("states")
        if not st.reads_since(state, facts):
            return st.NOT_STARTED
        _started, doctor, tick = self.after_start(facts, answers)
        return self.lib("progress").since_start(doctor, tick)

    def doctor_since(self, started):
        """The doctor's last result that this folder's records keep (records.Doctor), when it came after STARTED, when
        the running container started; None for none, and while the container does not run.
        """
        rec = self.lib("records")
        doctor = rec.read(self.pkg).doctor
        at = rec.parsed(doctor.at) if doctor is not None else None
        if at is None or started is None or at < started:
            return None
        return doctor

    def build_progress(self, file: str) -> str:
        """Where FILE, a build settings file as you typed it, is on the build path (rkmon_lib/progress.py): its check's
        rows, as rkmon check --settings FILE finds them, and whether the image it builds is on this host. Read-only;
        what only the network gives is read (resolved) only when the file's own rows pass.
        """
        ck, pr = self.lib("checks"), self.lib("progress")
        p, shown, file_checks, _rc = self.build_file(file)
        p = None if ck.failed(file_checks) else self.resolved(p)
        checks = self.build_checks_of(p, file_checks, shown)
        ref = p.image.ref if p is not None and not ck.failed(checks) else ""
        here = bool(ref) and self.image_labels(ref) is not None
        return pr.render(pr.build(shown, tuple(checks), ref, here))

    def cmd_next(self, ns) -> int:
        """`next [--settings FILE]`: where this deployment is on the deploy path, and the one command to run next
        (where); with a build settings file, the build path's five steps of that file (build_progress). Read-only, but
        for the first tick since a start that it may be the first to see, which this folder's records keep
        (first_tick_seen); exit 0, but 2 for the command line."""
        file = ns.settings
        if file and self.lib("deployment").settings_kind(self.abspath(file)) == "build":
            say(self.build_progress(file))
        else:
            say(self.lib("progress").render(self.where(file or "").report))
        return 0

    def cmd_doctor(self, ns) -> int:
        """`doctor [--fresh] [--fails]`, the deploy path's step 7: its banner, then, in its states (state_guard), where
        this deployment is on the path (where, without its notes and next line) and the state's row, which says them
        (states.row: PASS while the monitor runs your confirmed settings); then rk doctor's report from the
        container, with those options, and one outcome over the rows, the state's first (deployment.doctor_rows):
        PASSED with their count, then the state's next line (state_next_line: step 8's while no tick has run since the
        start); FAILED, exit 3 when a prerequisite is missing (rk doctor's 3) or the state is an earlier step's
        (states.EARLIER_STEPS), else 4, then the command again; ERROR when rk doctor ends any other way. A whole
        report's result goes to this folder's records, which rkmon next reads (record_doctor: the count of the rows
        that ran and the names of those that failed), before the next line; not under --fails, whose report is the
        failing names alone.
        """
        st, oc, ck = self.lib("steps"), self.lib("outcome"), self.lib("checks")
        sts = self.lib("states")
        say(st.banner(st.DEPLOY_STEPS[6], self.dry == 1))
        self.state_guard()
        state = row = None
        if self.dry != 1:
            here = self.where()
            state = sts.current(here.facts)
            row = sts.row(state, here.facts)
            say(self.lib("progress").render(here.report, next=False, notes=False))
            say(ck.render([row]))
            say("")
        flags = ["--fresh"] if ns.fresh else []
        flags += ["--fails"] if ns.fails else []
        rc, out = self.inside("rk", "doctor", *flags, capture=True)
        if self.dry == 1:
            return self.dry_run_outcome("rk doctor can run in the container")
        if out.strip():
            say(out.rstrip("\n"))
            say("")
        # rk doctor's codes: no check fails (0), a prerequisite is missing (3), another check fails (4)
        if rc not in (0, 3, 4):
            return oc.finish(
                "ERROR",
                f"rk doctor in the container exited {rc} (the lines above say why)",
                next=self.again_line(),
            )
        rows = [row, *self.lib("deployment").doctor_rows(out)]
        word, text = oc.tally(rows)
        failing = [r.name for r in rows if r.status == ck.Status.FAIL]
        names_only = ns.fails or (rc != 0 and word != "FAILED")  # one name per line
        if names_only:
            failing += [x.strip() for x in out.splitlines() if x.strip()]
            text = f"{self.lib('wrapping').counted(len(failing), 'check')} failed; nothing changed"
        else:
            ran = sum(1 for r in rows if r.status in ck.RAN)
            self.record_doctor(ran, failing)
        if not failing:
            text = text if len(rows) > 1 else "no check fails"
            return oc.finish("PASSED", text, next=self.state_next_line())
        earlier = rc == 3 or (
            row.status == ck.Status.FAIL and state.n in sts.EARLIER_STEPS
        )
        return oc.finish("FAILED", text, next=self.again_line(), earlier_step=earlier)

    def container_started(self):
        rc, cid = self.ask_docker("compose", "ps", "-q", SERVICE)
        if rc != 0 or not cid.strip():
            return None
        rc, out = self.ask_docker(
            "inspect", "--format", "{{.State.StartedAt}}", cid.split()[0]
        )
        return parse_time(out.strip()) if rc == 0 else None

    def last_tick_after_start(self, started=None):
        """The last tick's time, as rk gives it, when it ran after the container started (STARTED: when it started,
        when the caller knows); "" when none has; None when the container gave no answer. A tick after the start is
        deploy step 8 passed, which the first command that sees one records (first_tick_seen).
        """
        started = started or self.container_started()
        rc, out = self.quiet_inside("rk", "tick-due", "--minutes", "0")
        m = re.search(r"last tick (\S+)", out)
        if not m:
            return None
        t = parse_time(m.group(1))
        if t and started and t >= started:
            self.first_tick_seen(t)
            return m.group(1).rstrip(",")
        return ""

    def ask_tick_now(self) -> tuple:
        """A tick at once, asked of the tick loop that runs in the container (rk tick-now), as first-tick
        and apply ask it while no tick has run since the start (last_tick_after_start): (its exit code, a line that
        says what came of it): 0, the loop starts it within seconds; 3, no tick loop runs now, and the next one to
        start takes it at once; 4, the monitor in the container is stopped, and nothing is asked; any other, nothing
        is asked, and the tick loop ticks at its own time."""
        rc, out = self.quiet_inside("rk", "tick-now")
        if rc == 0:
            line = "the tick loop starts it within seconds (after the one in progress, if any)"
            return rc, f"asked for a tick at once: {line}"
        if rc == 3:
            line = "no tick loop runs now; the next one to start takes it at once"
            return rc, f"asked for a tick at once: {line}"
        if rc == 4:
            return rc, "no tick asked: the monitor in the container is stopped"
        m = re.search(r"^ERROR: (.+); no tick asked$", out or "", re.M)
        why = m.group(1) if m else f"exit {rc}"
        return rc, f"no tick asked ({why}): the tick loop ticks at its own time"

    def first_tick_seen(self, at) -> None:
        """A tick ran AT, an aware time, after this folder's container started: deploy step 8 has passed. This
        folder's records keep the first one a command sees (records.first_tick; not under --dry-run), and from then on
        a next line names a deploy step's command without its step."""
        if self.dry == 1:
            return
        rec = self.lib("records")
        rec.first_tick(self.pkg, rec.FirstTick(rec.timestamp(at)))

    def first_tick_recorded(self) -> bool:
        """Whether this folder's records keep a first tick (first_tick_seen): the next lines that deploy steps 1 and 2
        end with then name the next step's command without its step."""
        return self.lib("records").read(self.pkg).first_tick is not None

    def minutes(self, given):
        """--timeout-minutes N as a number of minutes above 0; None, after the usage error, for anything else."""
        try:
            n = float(given)
        except (TypeError, ValueError):
            n = 0.0
        if 0 < n < float("inf"):
            return n
        err(
            f"{self.program} {self.cmd}: --timeout-minutes takes a number of minutes above 0, not {given}"
        )
        return None

    def deploy_done(self) -> str:
        """The deploy path's done line: the monitor runs, with each feature of the recorded settings that is on
        and its mode (features.on_line), and where your first day is described."""
        file = self.recorded()
        cfg = self.settings_cfg(file)[0] if file else None
        runs = f" ({self.lib('features').on_line(cfg)})" if cfg is not None else ""
        return self.lib("steps").done_line(
            f"the monitor runs{runs}. Your first day: QUICK_USER_GUIDE.md, Your first day"
        )

    def cmd_first_tick(self, ns) -> int:
        """`first-tick [--timeout-minutes N]`, the deploy path's step 8: it waits, N minutes at most, for the first tick
        after the container's start, which it asks the tick loop for at once while none has run since the start
        (ask_tick_now, once, with the line that says what came of it), then shows rk status. One outcome: PASSED with
        the tick's time, then in state 16 the deploy path's done line (deploy_done), in any other the state's next
        line, as standby's names standby off, and the done line while the monitor does not say yet which
        settings it runs; REFUSED outside its states, the container not running among them (state_guard), and while
        the monitor in the container is stopped, which no tick runs in; FAILED when no tick ran in time, with the
        commands that say why, then the command again."""
        st, oc, ck = self.lib("steps"), self.lib("outcome"), self.lib("checks")
        minutes = self.minutes(ns.timeout_minutes)
        if minutes is None:
            return 2
        say(st.banner(st.DEPLOY_STEPS[7], self.dry == 1))
        self.probe_unknown("the first tick")
        self.state_guard()
        if self.dry == 1:
            for words in (("tick-due", "--minutes", "0"), ("tick-now",)):
                self.show(self.engine, "compose", "exec", "-T", SERVICE, "rk", *words)
            return self.dry_run_outcome(
                "it asks for a tick at once while none has run since the start, then waits up to "
                f"{minutes:g} minutes for the first tick after the start"
            )
        end = time.monotonic() + 60 * minutes
        say(f"waiting for the first tick after the start, {minutes:g} minutes at most")
        asked = False
        while True:
            tick = self.last_tick_after_start()
            if tick:
                self.inside("rk", "status")
                try:
                    nxt = self.state_next_line(done=self.deploy_done)
                except NoAnswer:  # the monitor does not say yet which settings it runs
                    nxt = self.deploy_done()
                return oc.finish("PASSED", f"the first tick ran at {tick}", next=nxt)
            if (
                tick == "" and not asked
            ):  # none since the start: a tick at once, asked once
                asked = True
                rc, line = self.ask_tick_now()
                if rc == 4:
                    return self.refuse("the monitor in the container is stopped")
                say(line)
            left = end - time.monotonic()
            if left <= 0:
                why = ck.Steps(
                    (
                        ck.Command((self.program, "logs", "--tail", "50")),
                        "and",
                        ck.Command((self.program, "rk", "status")),
                        "say why",
                    )
                )
                return oc.finish(
                    "FAILED",
                    f"no tick in {minutes:g} minutes",
                    fix=why,
                    next=self.again_line(),
                )
            time.sleep(min(20, left))

    # --- the rest of the day-to-day commands ------------------------------------------------------------------------
    def cmd_logs(self, ns) -> int:
        """`logs [-f] [--tail N] [--since TIME]`: docker compose logs of this folder's container, the options docker
        compose's own, and its exit code; while the container's name is another deployment's, or whose it is is
        unknown, the log is unknown (probe_unknown); outside its states, the state's refusal (state_guard).
        """
        self.probe_unknown("the container's log")
        self.state_guard()
        follow = ["-f"] if ns.follow else []
        tail = ["--tail", ns.tail] if ns.tail else []
        since = ["--since", ns.since] if ns.since else []
        return self.compose("logs", *follow, *tail, *since, SERVICE)

    def cmd_shell(self, ns) -> int:
        """`shell`: a shell in the running container, as the monitor's user, in its states (state_guard)."""
        self.state_guard()
        return self.compose(
            "exec",
            self.tty,
            "--user",
            self.monitor_user,
            *self.envs(),
            SERVICE,
            self.entry,
            "shell",
        )

    def cmd_remove(self, ns) -> int:
        """`remove [--delete-data] [--yes]`: this deployment's container removed, with its network (docker
        compose down); with --delete-data its volumes too (own_volumes, by docker volume rm), its state, clone, secrets
        and logins, for good, asked first: with no terminal, only with --yes (else exit 2, nothing removed). A volume
        another deployment on this host uses (volume_owners, as check 15 reads it at the start) stays, and the
        outcome names it and why. Once --delete-data has removed what it removes, this folder's records forget the
        first tick (records.clear_first_tick), so the next start is a first start, and the next lines name each deploy
        step again. Before the first start there is no container, and there may be volumes: `rkmon login` makes
        the ones that keep the logins, and a start cut short may make the others. One outcome: REMOVED; NOTHING TO DO
        while there is nothing to remove, which, while there are volumes, says that the data stays and names
        --delete-data; CANCELLED when you say no; ERROR when docker cannot remove them, which says what is gone and
        what stays, or when its answer about the volumes cannot be read, then the command again; outside its states,
        the state's refusal (state_guard), before anything is asked. Its next line is the state's: once the container
        is gone, docker is asked again whose its name is (owner_of), so that the logins are read as before a first
        start, and no one-off container makes the volumes again.
        """
        oc, ck, ident = self.lib("outcome"), self.lib("checks"), self.lib("identity")
        joined = self.lib("wrapping").joined
        self.state_guard()
        container, volumes = self.made(), self.own_volumes()
        if volumes is None:
            return oc.finish(
                "ERROR",
                "docker's answer about this deployment's volumes cannot be read; nothing removed",
                next=self.again_line(),
            )
        shared = []
        if ns.delete_data and volumes:
            whose = self.volume_owners(volumes, "nothing removed")
            shared = [v for v in volumes if whose.get(v) == ident.OTHER]
            volumes = [v for v in volumes if v not in shared]
        delete = bool(ns.delete_data and volumes)
        if shared:
            many = len(shared) > 1
            stays = (
                f"{joined(shared)} {'stay' if many else 'stays'}, as another deployment on this host uses "
                f"{'them' if many else 'it'}"
            )
        elif volumes and not delete:
            stays = f"the data stays in this deployment's volumes ({self.program} remove --delete-data removes them)"
        else:
            stays = ""
        if not (container or delete):
            return oc.finish(
                "NOTHING TO DO",
                (
                    f"there is no container; {stays}"
                    if stays
                    else "this deployment has no container and no volume on this host"
                ),
                next=self.state_next_line(),
            )
        what = "the container"
        if delete:
            own = "other volumes" if shared else "volumes"
            what = (
                f"the container and its {own}"
                if container
                else f"this deployment's {own}"
            )
        if delete and self.dry != 1 and not ns.yes:
            data = f"{self.project()}'s volumes: its state, its clone, its secrets and its logins, for good"
            if container:
                data = f"the container and {data}"
            if not self.interactive():
                err(
                    f"{self.program} remove --delete-data: no terminal to ask on: {self.program} remove --delete-data "
                    f"--yes removes {data}"
                )
                return 2
            if not self.confirm(f"Remove {data}?", default=False):
                return oc.finish(
                    "CANCELLED", "nothing removed", next=self.state_next_line()
                )
        rc = self.compose("down")
        if rc:
            kept = (
                "; the data stays in this deployment's volumes"
                if volumes or shared
                else ""
            )
            return oc.finish(
                "ERROR",
                f"docker compose down exited {rc} (the lines above say why, and what it removed){kept}",
                next=self.again_line(),
            )
        if delete:
            argv = [self.engine, "volume", "rm", *volumes]
            self.show(*argv)
            rc = self.run(argv) if self.dry != 1 else 0
            if rc:
                gone = "the container is removed already, and " if container else ""
                text = (
                    f"docker volume rm exited {rc}: {gone}the data stays in the volumes it could not remove (the "
                    "lines above say which, and why)"
                )
                fix = ck.Steps(
                    (
                        "once what the lines above say is fixed,",
                        self.again_command(),
                        "removes them",
                    )
                )
                return oc.finish(
                    "ERROR",
                    f"{text}; {stays}" if shared else text,
                    fix=fix,
                    next=self.again_line(),
                )
        if self.dry == 1:
            text = f"{what} can be removed"
            return self.dry_run_outcome(f"{text}; {stays}" if shared else text)
        self.owners.pop(self.project(), None)  # the container is gone
        if ns.delete_data:
            self.lib("records").clear_first_tick(self.pkg)
        return oc.finish(
            "REMOVED",
            f"{what}; {stays}" if stays else what,
            next=self.state_next_line(),
        )

    def cmd_rk(self, ns) -> int:
        """`rk ARGS`: rk in the running container, in its states (state_guard), and its exit code."""
        self.state_guard()
        return self.inside("rk", *ns.args)

    def cmd_package_update(self, ns) -> int:
        """`package update [--from DIR|TARBALL] [--folder FOLDER]`: the package folder FOLDER,
        this one or --folder's, replaced on this host by a newer package (rkmon_lib/package_update.py, update; with
        --folder, each update its fixes and a dry run's next line name carries it, and FOLDER's own rkmon names each
        command after it). It runs in every state but 3 (state_guard), while it holds FOLDER's lock, which no
        other command of the package holds then (main: hold_lock), and in another folder not while a change stopped
        part-way there (under_way_in). It holds the lock of each folder it moves or makes beside FOLDER, exclusive,
        from before it moves it until the command ends (package_update.update's HOLD; hold_folder), and refuses as
        for FOLDER's while another command holds one. Run by FOLDER.prev's own rkmon, it holds that folder's lock
        itself: the refusal's next line names the update by FOLDER's own rkmon, without --folder (hold_folder's OWN).
        It prints the update's rows, then its outcome and its next line:
        the update's own, else FOLDER's state's (next_line_of); after a refusal or a failure, the rows that say why,
        then this command again. Ctrl-C: INTERRUPTED (update_interrupted); once the update has ended, a Ctrl-C ends
        the command by the signal (ctrl_c_ends), as its outcome is said."""
        st, oc = self.lib("steps"), self.lib("outcome")
        pu, pf, sf = (
            self.lib(m) for m in ("package_update", "private_files", "settings_file")
        )
        say(st.command_banner(self.row.name, self.row.summary, self.dry == 1))
        self.state_guard()
        folder = self.replaced_folder(ns)
        here = os.path.realpath(folder) == self.pkg
        refused = self.under_way_in(folder, here)
        if refused is not None:
            return refused
        source = self.abspath(ns.from_) if ns.from_ else None
        before = os.stat(folder) if os.path.isdir(folder) else None
        own = self.lib("checks").Command(
            (pu.rkmon_of(folder), *self.typed_without("--folder"))
        )
        # Ctrl-C ends the update in the outcome that says what changed: the update renames back what it renamed
        ctrl_c_interrupts()
        try:
            done = pu.update(
                folder,
                source,
                dry_run=self.dry == 1,
                named=ns.folder is not None,
                hold=lambda moved: self.hold_folder(moved, exclusive=True, own=own),
            )
        except KeyboardInterrupt:
            return self.update_interrupted(folder, before, here)
        except oc.Stopped as exc:
            ctrl_c_ends()
            return exc.finish(next=self.again_line())
        except (sf.Refused, pf.Refused) as exc:
            ctrl_c_ends()
            if isinstance(exc, sf.Refused):
                # the settings file the records name, read for its updates section
                what = (
                    f"there is no --from, and the settings file confirmed in {sf.shown(folder)} cannot be read for "
                    "its updates section"
                )
                shown = {"rows": exc.rows}
            else:
                # it shows itself: its rows, then where the rules are (private_files.RULES)
                what = "a private file the update reads or carries breaks a rule"
                shown = {"above": str(exc)}
            stop = oc.Stopped("REFUSED", f"{what}; {oc.FIX_EACH_FAIL}", **shown)
            return stop.finish(next=self.again_line())
        ctrl_c_ends()
        if done.rows:
            say(self.lib("checks").render(done.rows))
        return oc.finish(
            done.word, done.text, next=done.next or self.next_line_of(folder, here)
        )

    def next_line_of(self, folder, here: bool) -> str:
        """The next line of the state of FOLDER, the package folder an update replaced: this folder's (HERE), else
        FOLDER's, which FOLDER's own rkmon names (package_update.next_line)."""
        if here:
            return self.state_next_line()
        return self.lib("package_update").next_line(folder, named=True)

    def under_way_in(self, folder, here: bool):
        """package update's refusal while an apply, rollback or adopt stopped part-way in FOLDER, the package folder
        whose place the update takes, when it is not this one (HERE False: --folder's, whose state this folder's state
        guard does not read; state 3): REFUSED, nothing changed, then that command again, in its form
        (commands.form_of), by FOLDER's own rkmon. None for this folder, whose state guard refuses state 3, and when
        FOLDER's records keep no change under way or cannot be read, which the update's carry says. A change that runs
        in FOLDER holds its lock, so the update's own hold refuses it (hold_lock)."""
        if here:
            return None
        rec, oc, sf = (
            self.lib("records"),
            self.lib("outcome"),
            self.lib("settings_file"),
        )
        try:
            under_way = rec.read(folder, carried=True).under_way
        except (OSError, rec.Unreadable, self.lib("private_files").Refused):
            return None
        if under_way is None:
            return None
        own = self.lib("package_update").rkmon_of(folder)
        form = self.lib("commands").form_of(under_way.command)
        again = self.lib("checks").Command((own, *form.split()))
        text = f"the {under_way.command} in {sf.shown(folder)} stopped part-way; nothing changed"
        return oc.finish("REFUSED", text, next=self.next_of(again))

    def update_interrupted(self, folder, before, here: bool) -> int:
        """Ctrl-C during package update: INTERRUPTED, exit 130, with what changed, FOLDER's os.stat before the
        update being BEFORE (package_update.interrupted); then this command again, or, once the update is done, the
        next line of FOLDER's state, as after UPDATED. A second Ctrl-C meanwhile ends the command by the signal
        (ctrl_c_ends)."""
        ctrl_c_ends()
        text, done = self.lib("package_update").interrupted(folder, before)
        later = self.next_line_of(folder, here) if done else self.again_line()
        return self.lib("outcome").finish("INTERRUPTED", text, next=later)

    def cmd_migrate(self, ns) -> int:
        """`migrate --settings FILE`: a settings file in an earlier layout, rewritten on this host
        (rkmon_lib/migrate.py); no docker."""
        return self.lib("migrate").run(
            (self.program, *self.typed),
            ns.settings,
            self.abspath(ns.settings),
            self.dry == 1,
        )

    # --- moving from an existing monitor ----------------------------------------------------------------------------
    def cmd_adopt(self, ns) -> int:
        """`adopt --from DIR [--map OLD=NEW]... [--dry-run] [--yes]`: an earlier monitor's state, staged from
        DIR, a copy of its /work (read only), with its config.json and standby set in it (adopt.stage), its plan shown
        from a one-off container of this deployment, then applied once you say yes (or with --yes), this deployment's
        own copies set aside first and the one-time move made due again when config.json came, so that the next start
        splits it. It runs in its deployment states (state_guard), before the first start too (the start then
        sets the work volume up around what it adopted), and refuses, as the deployment's state does (refuse), while the
        container runs (its ticks would race the move; one that waits for its first start, state 8, has the start's
        line), and without the image (refuse_without_image). The apply is recorded as under way in this folder's
        records (records.begin), so that one that stops part-way, however it stops, leaves state 3, whose next line is
        adopt again, from the same copy; adopt runs there too, as the command that finishes it (states.runs_here). One
        outcome: ADOPTED, which says that the deployment starts in standby (states.in_standby), then the deployment
        state's next line; PASSED for the plan alone (--dry-run); CANCELLED when you say no; REFUSED, with its fix and
        the state's next line, when adopt refuses the copy (adopt.AdoptError: an earlier internal state it cannot
        read); ERROR when the copy cannot be read or a step fails, then the command again: rk's own outcome when the
        plan refuses or apply stops (an exit 1 with its ERROR line alone: own_outcome), after what it did, with where
        that leaves the state and its fix (REFUSED when nothing changed). With no terminal and no --yes, exit 2 and
        nothing applied. Of another monitor, it reads DIR alone.
        """
        adopt, oc, ck = self.lib("adopt"), self.lib("outcome"), self.lib("checks")
        root = self.abspath(ns.from_)
        try:
            pairs = adopt.parse_maps(ns.map or [])
        except adopt.AdoptError as exc:
            err(f"{self.program} adopt: {exc}")
            return 2

        def races() -> int:
            if not DockerAnswers(self).set_up(self.project()):
                # it waits for its first start (state 8): no tick runs yet, and the state's line leads on (start)
                return self.refuse(
                    "the container is running: it waits for its first start"
                )
            return self.refuse(
                "the monitor's container is running, and its ticks would race the move",
                fix=ck.Command((self.program, "stop", "--drain")),
            )

        self.state_guard(running=races)
        config_file = os.path.join(root, "monitor", "config.json")
        old_cfg = {}
        if os.path.isfile(config_file):
            try:
                with open(config_file, encoding="utf-8") as f:
                    old_cfg = json.load(f)
                old_cfg, renamed = self.lib("renames").migrate(old_cfg, config_file)
                for line in renamed:
                    say(f"   {line}")
            except (OSError, ValueError) as exc:
                return oc.finish(
                    "ERROR",
                    f"{config_file} cannot be read ({exc}); nothing changed",
                    next=self.again_line(),
                )
        image = self.image_ref()
        if self.image_labels(image) is None:
            return self.refuse_without_image(image)
        old = adopt.old_folders(root, old_cfg)
        stage = tempfile.mkdtemp(prefix="rkmon-adopt-")
        try:
            say(f"1. staging the old monitor's state from {root} (reads it only)")
            try:
                m = adopt.stage(old, stage, pairs)
            except adopt.AdoptError as exc:
                # adopt again refuses the copy the same way until its fix is made: the state's line leads on
                return oc.finish(
                    "REFUSED",
                    f"{exc}; nothing changed",
                    fix=exc.fix(self.program),
                    next=self.state_next_line(),
                )
            except OSError as exc:
                return oc.finish(
                    "ERROR", f"{exc}; nothing changed", next=self.again_line()
                )
            say("\n".join("   " + x for x in adopt.stage_report(m)))
            # a one-off container of this deployment, the staged copy read-only in it; the plan only reads (only_reads)
            one_off = ("run", "--rm", "-T", *self.envs(), "-v", f"{stage}:/adopt:ro")
            rk = (SERVICE, "rk", "adopt")
            say(
                "2. the plan (in a one-off container of this deployment; nothing written)"
            )
            rc = self.compose(
                *one_off, *self.only_reads(), *rk, "plan", "--stage", "/adopt"
            )
            if rc == 4:  # rk's own REFUSED said why, nothing changed, and the fix
                self.say_next(self.again_line())
                return rc
            if rc:
                return oc.finish(
                    "ERROR",
                    f"rk adopt plan exited {rc} (the lines above say why); nothing changed",
                    next=self.again_line(),
                )
            if ns.plan or self.dry == 1:
                return self.dry_run_outcome("the plan can be applied")
            if not ns.yes:
                if not self.interactive():
                    yes = self.again_command([*self.typed, "--yes"])
                    err(
                        f"{self.program} adopt: no terminal to ask on: {yes} applies the plan shown above"
                    )
                    return 2
                if not self.confirm(
                    "Apply this plan (this deployment's copies are set aside first)?",
                    False,
                ):
                    return oc.finish(
                        "CANCELLED", "nothing changed", next=self.state_next_line()
                    )
            say("3. applying")
            rec = self.lib("records")
            try:
                lease = rec.begin(self.pkg, "adopt")
            except rec.Busy as exc:
                return oc.finish(
                    "REFUSED", f"{exc}; nothing changed", next=self.again_line()
                )
            except rec.PartWay:
                return self.refuse()
            with lease:
                rc, said = self.compose(
                    *one_off, *rk, "apply", "--stage", "/adopt", kept=True
                )
                # the record goes once apply finished, or changed nothing where nothing was part-way (Lease.stop)
                if rc:
                    lease.stop(changed=rc != 4)
                else:
                    lease.finish()
            # rk's own outcome said what it did, why it stopped, and the fix: its exit 1 with its ERROR line alone
            if rc == 4 or rc == 1 and self.own_outcome(said, rc):
                self.say_next(self.again_line())
                return rc
            if rc:
                return oc.finish(
                    "ERROR",
                    f"rk adopt apply exited {rc} (the lines above say why)",
                    next=self.again_line(),
                )
            text = "the earlier monitor's state, its logins and secrets left behind; the deployment starts "
            return oc.finish(
                "ADOPTED",
                text + self.lib("states").in_standby(),
                next=self.state_next_line(),
            )
        finally:
            shutil.rmtree(stage, ignore_errors=True)

    def cmd_web_host_install(self, ns) -> int:
        """`web-host install`: the request service on the team dashboard's web host, installed by `rk
        web-host-install` as the writer, the keeper of the web host's key (its rk is its broker), in a one-off
        container as the logins' walk runs one (walk_inside: the image your confirmed settings name, handed those
        settings, from which it reads the web host, its login and its paths). It runs in its deployment states
        (state_guard), which leave standby's out (14: the monitor you moved from may still use the web host); where
        the state does not show standby (the container stopped, or an earlier state first), rk web-host-install
        refuses it. Its outcome is rk web-host-install's own line, then the deployment state's next line after
        INSTALLED or NOTHING TO DO, and after its refusal in standby (exit 4, once the monitor says it is in standby:
        says_standby), else the command again (after its INTERRUPTED too, whose line says what is left on the web
        host); ERROR when docker fails, or rk exits 1 with no ERROR line of its own (a traceback: own_outcome, which
        reads what it said: walk_inside's KEPT); under --dry-run, PASSED, and nothing runs. Ctrl-C that reaches rkmon
        itself, rather than rk in the container's terminal: INTERRUPTED, exit 130, with what may be
        left on the web host, then the command again.
        """
        self.state_guard()
        oc = self.lib("outcome")
        ctrl_c_interrupts()
        try:
            rc, said = self.walk_inside(
                "rk",
                "web-host-install",
                user=self.lib("container_layout").WRITER.name,
                kept=True,
            )
        except KeyboardInterrupt:
            rc, said = None, ""
        finally:
            ctrl_c_ends()
        if rc is None:
            return oc.finish(
                "INTERRUPTED",
                "the install was stopped: the web host may have some of its new copies, and its request service may "
                "not run",
                next=self.again_line(),
            )
        if self.dry == 1:
            return self.dry_run_outcome(
                "the writer can install the request service from a one-off container of the image your confirmed "
                "settings name"
            )
        if rc == 0 or rc == 4 and self.says_standby():
            # INSTALLED or NOTHING TO DO; or the refusal in standby, which the state's next line leads out of
            self.say_next(self.state_next_line())
            return rc
        # rk web-host-install's own outcome line said why (its exit 1 with its ERROR line alone: own_outcome), or,
        # after a Ctrl-C (130), what is left on the web host
        if rc in (3, 4, 130) or rc == 1 and self.own_outcome(said, rc):
            self.say_next(self.again_line())
            return rc
        return oc.finish(
            "ERROR",
            f"docker exited {rc}, so the request service is not installed (the lines above say why)",
            next=self.again_line(),
        )


def main() -> int:
    for sig in (
        signal.SIGINT,
        signal.SIGPIPE,
    ):  # die of the signal as the shell would, with no traceback
        signal.signal(sig, signal.SIG_DFL)
    drop_shell_variables(os.environ)
    return Wrapper(sys.argv[0]).main(sys.argv[1:])


if __name__ == "__main__":
    sys.exit(main())
