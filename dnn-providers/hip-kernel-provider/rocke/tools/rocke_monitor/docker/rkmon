    """Where this folder's deployment is (Wrapper.where): the state table's facts (rkmon_lib/states.py), the deploy
    path's report (rkmon_lib/progress.py), what this folder is told beside its state (`note`), and why docker cannot
    say whose the container name is (`unknown_why`, "" when it can)."""

    facts: object
    report: object
    note: str
    unknown_why: str


@dataclasses.dataclass
class Change:
    """An apply or a rollback as it goes (Wrapper.cmd_apply, cmd_rollback), and stop --drain's drain (stop_drained,
    which uses `drained` alone): the lease of the records once it is taken (records.begin), whether the monitor is
    drained, and by an older package's drain (`older`), whether the change is a first apply over an older package
    (`first`), as the record of the change says (begin_change), whether a release went into the code volume in
    this run (the lease says whether one did during the change, by an apply that stopped part-way before it too:
    records.Lease.installed), and how far it got (`phase`): "" while nothing has changed, INSTALLING while this
    package's code goes in, WRITING once the settings are being written or put back, PUTTING_BACK once apply puts back
    what ran before it."""

    INSTALLING = "installing"
    WRITING = "writing"
    PUTTING_BACK = "putting back"

    lease: object = None
    drained: bool = False
    older: bool = False
    first: bool = False
    installed: bool = False
    phase: str = ""


class Wrapper:
    def __init__(self, argv0: str):
        self.argv0 = argv0
        self.here = os.path.dirname(os.path.realpath(argv0)) or "."
        self.pkg = os.path.realpath(os.path.join(self.here, ".."))
        try:  # the package folder as this command started, which its lock is held on after (hold_lock)
            self.started = os.stat(self.pkg)
        except OSError:
            self.started = None
        self.held = None  # the stack of this command's holds of a lock, which main lets go of (hold_folder)
        # the real path of each folder whose lock this command holds (hold_folder)
        self.held_folders = set()
        self.engine = os.environ.get("CONTAINER_ENGINE") or "docker"
        self.dry = 0
        self.tty = "-T"
        self.typed = []  # the command line as you typed it, after the program (again)
        self.cwd = ""
        self.image_code = False
        self.cmd = ""  # the command's name, as its row in the command table names it
        self.row = None  # that row (rkmon_lib/commands.py)
        self.guarded = False  # the command has passed its state guard (state_guard)
        # a login or secret's command runs inside the logins' walk, which shows its entry's row in its outcome's place
        self.walking = False
        self.walked = ""  # that command's outcome word (set_outcome): the walk counts CANCELLED as your no
        self.shown = False  # that command showed its entry's row itself (claude's test row): the walk shows it once
        # whose each container name is on this host (owner_of): docker is asked once for each
        self.owners = {}
        # the build settings file image test, save or push was given (--settings), as the lines name it (build_file)
        self.build_settings = ""
        self.problems = (
            []
        )  # the last settings file read's FAIL and WARN rows, with check 7's PASS row (settings_cfg)
        self.answers = None  # the last state read's DockerAnswers (state_facts)

    @property
    def program(self) -> str:
        """The name rkmon was run by (rkmon_lib/program.py): every message, fix and next line names it so, and each
        command in the container gets it as RKMON_WRAPPER."""
        return self.lib("program").name()

    @property
    def entry(self) -> str:
        """The container's entry point, in the image's own code (container_layout.IMAGE_CODE, where docker/Dockerfile
        copies the package)."""
        return f"{self.lib('container_layout').IMAGE_CODE}/docker/entrypoint.sh"

    @property
    def monitor_user(self) -> str:
        """The monitor's user in the container (container_layout.MONITOR): a command there runs as it, but the
        writer's (as_writer) and root's (root_code)."""
        return self.lib("container_layout").MONITOR.name

    # --- the package's own modules (the standard library only) ---------------------------------------------------
    def lib(self, name: str):
        if self.pkg not in sys.path:
            sys.path.insert(0, self.pkg)
        sys.dont_write_bytecode = True
        import importlib

        return importlib.import_module(f"rkmon_lib.{name}")

    # --- printing and running ---------------------------------------------------------------------------------
    def show(self, *words: str) -> None:
        """One command as one line, dim on a terminal (stdout under --dry-run, else stderr)."""
        line = " ".join(quote(w) for w in words)
        fd = 1 if self.dry == 1 else 2
        stream = sys.stdout if fd == 1 else sys.stderr
        sys.stdout.flush()
        sys.stderr.flush()
        if os.isatty(fd) and not os.environ.get("NO_COLOR"):
            stream.write("\033[2m" + line + "\033[0m\n")
        else:
            stream.write(line + "\n")
        stream.flush()

    def run(self, argv: list, **kw) -> int:
        sys.stdout.flush()
        sys.stderr.flush()
        try:
            return subprocess.run(argv, **kw).returncode
        except FileNotFoundError:
            err(f"{self.program}: {argv[0]}: not found")
            return 127
        except PermissionError:
            err(f"{self.program}: {argv[0]}: Permission denied")
            return 126

    def ask_docker(self, *args: str, timeout: int = 60, variables=None):
        """A read-only docker question, not printed, with no input (none of yours reaches docker): (its exit code, its
        output); (127, why) when docker cannot start, and (confirm.TIMED_OUT, `timed out after TIMEOUT seconds`) when it
        gives no answer in TIMEOUT seconds. A docker compose question about this folder's compose project, which is each
        one but `docker compose version`, is asked only of this folder's own container (only_ours). `variables`: NAME ->
        text, set in its environment over this process's.
        """
        if args[:1] == ("compose",) and args[1:2] != ("version",):
            self.only_ours()
        try:
            p = subprocess.run(
                [self.engine, *args],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                timeout=timeout,
                env=dict(os.environ, **variables) if variables else None,
            )
        except OSError as exc:
            return 127, str(exc)
        except subprocess.TimeoutExpired:
            return self.lib("confirm").TIMED_OUT, f"timed out after {timeout} seconds"
        return p.returncode, (p.stdout or "") + (
            "" if p.returncode == 0 else (p.stderr or "")
        )

    def compose(
        self,
        *args: str,
        stdin=None,
        capture: bool = False,
        variables=None,
        whole: bool = False,
        kept: bool = False,
    ):
        """docker compose ARGS: printed, then run (under --dry-run, printed only); `stdin`: bytes for its input (a
        secret, or a program: never printed); `capture`: (exit code, output) instead of the code; `kept`: (exit code,
        what it said), what it says said as it comes and kept, for its outcome line (own_outcome): on a terminal of its
        own that rkmon relays when ARGS ask docker for one (-it) and your input and output are terminals (relayed),
        else through a pipe, its errors going on to yours as they come (streamed); `variables`: NAME -> text, set in its
        environment over this process's
        (deliver's); `whole`: run to its end whatever Ctrl-C does, a Ctrl-C meanwhile taken once it has ended
        (run_whole). Only of this folder's own container (only_ours).
        """
        self.only_ours()
        self.show(self.engine, "compose", *args)
        if self.dry == 1:
            return (0, "") if capture or kept else 0
        env = dict(os.environ, **variables) if variables else None
        if kept:
            how = relayed if "-it" in args and self.interactive() else streamed
            return how([self.engine, "compose", *args], env)
        if capture or stdin is not None or whole:
            sys.stdout.flush()
            sys.stderr.flush()
            try:
                p = (run_whole if whole else subprocess.run)(
                    [self.engine, "compose", *args],
                    input=stdin,
                    stdout=subprocess.PIPE if capture else None,
                    env=env,
                )
            except FileNotFoundError:
                err(f"{self.program}: {self.engine}: not found")
                return (127, "") if capture else 127
            if capture:
                return p.returncode, (p.stdout or b"").decode("utf-8", "replace")
            return p.returncode
        return self.run([self.engine, "compose", *args], env=env)

    def running(self) -> bool:
        """This folder's container is up (read-only, and not printed; only_ours first)."""
        self.only_ours()
        try:
            p = subprocess.run(
                [
                    self.engine,
                    "compose",
                    "ps",
                    "--status",
                    "running",
                    "--quiet",
                    SERVICE,
                ],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
            )
        except OSError:
            return False
        return p.stdout.rstrip(b"\n") != b""

    def made(self) -> bool:
        """The deployment's container exists, running or not (read-only, and not printed): by docker's answer alone,
        never by the error of a question it does not answer."""
        rc, out = self.ask_docker("compose", "ps", "-a", "-q", SERVICE)
        return rc == 0 and out.strip() != ""

    def envs(self) -> list:
        """The variables every command in the container gets: how it was called (called), and with --image-code,
        the image's own code (RKMON_CODE=image)."""
        return self.called() + (["-e", "RKMON_CODE=image"] if self.image_code else [])

    def called(self) -> list:
        """How rkmon was called (RKMON_WRAPPER), for the fixes a command in the container shows: the writer's rk gets
        it too, which its broker passes on only when it is a path that ends in rkmon (container_layout.shown_wrapper).
        """
        return ["-e", f"RKMON_WRAPPER={self.program}"]

    def inside(
        self, *args: str, capture: bool = False, stdin=None, tty=None, whole=False
    ):
        """A command in the container: the running one, else a one-off; `whole`: run to its end whatever Ctrl-C does
        (compose), with no terminal."""
        t = tty or ("-T" if capture or stdin is not None or whole else self.tty)
        how = {"capture": capture, "stdin": stdin, "whole": whole}
        if (
            self.running()
        ):  # as the monitor's user (a one-off's entry point drops to it by itself)
            user = self.monitor_user
            return self.compose(
                "exec", t, "--user", user, *self.envs(), SERVICE, *args, **how
            )
        return self.compose("run", "--rm", t, *self.envs(), SERVICE, *args, **how)

    def session_runs(self) -> bool:
        """A Claude session runs in this folder's container now (rk orchestrate --running there; read-only, and not
        printed). One that has not started yet reads what was set as it starts, with no restart.
        """
        return (
            self.running()
            and self.quiet_inside("rk", "orchestrate", "--running")[0] == 0
        )

    def piped_inside(self, *words: str, each) -> int:
        """WORDS, a command, in the running container as the monitor's user, shown, then run (under --dry-run, shown
        only: 0), each line it says handed to EACH as it comes (piped; PYTHONUNBUFFERED: rk's lines through a pipe as
        it says them): its exit code. A drain, whose lines come over minutes."""
        self.only_ours()
        argv = [self.engine, "compose", "exec", "-T", "--user", self.monitor_user]
        argv += self.envs()
        argv += ["-e", "PYTHONUNBUFFERED=1", SERVICE, *words]
        self.show(*argv)
        if self.dry == 1:
            return 0
        return piped(argv, each)

    def quiet_inside(self, *args: str, timeout: int = 300):
        """A command in the container, with the variables every command there gets (envs: its texts name the program
        as you ran it), not printed: (exit code, output); TIMEOUT seconds at most. In the running container; with none
        running, a question alone, in a one-off container whose command only reads (only_reads).
        """
        if self.running():
            return self.ask_docker(
                "compose",
                "exec",
                "-T",
                "--user",
                self.monitor_user,
                *self.envs(),
                SERVICE,
                *args,
                timeout=timeout,
            )
        return self.ask_docker(
            "compose",
            "run",
            "--rm",
            "-T",
            *self.envs(),
            *self.only_reads(),
            SERVICE,
            *args,
            timeout=timeout,
        )

    def only_reads(self) -> list:
        """What a one-off container whose command only reads gets (a question, adopt's plan): the variable that tells
        its entry point so, whose root phase then walks no file of the volumes and writes no ids record
        (container_layout LEAVE_VOLUMES_VARIABLE). A one-off whose command may write goes without it (adopt's apply).
        """
        return ["-e", f"{self.lib('container_layout').LEAVE_VOLUMES_VARIABLE}=1"]

    def as_writer(self, *args: str, stdin=None, tty=None):
        """A command of the container's entry point as the writer, its own user, never through sudo: in the running
        container (exec --user), else in a one-off, whose entry point maps the ids and drops to it (RKMON_AS). The
        writer's logins are set so, from the host only, as its secrets are (walk_inside, as the writer): the monitor's
        user is the Claude session's too.
        """
        t = tty or ("-T" if stdin is not None else self.tty)
        user = self.lib("container_layout").WRITER.name
        if self.running():
            return self.compose(
                "exec", t, "--user", user, SERVICE, self.entry, *args, stdin=stdin
            )
        return self.compose(
            "run", "--rm", t, "-e", f"RKMON_AS={user}", SERVICE, *args, stdin=stdin
        )

    def writer_quiet(self, *args: str, timeout: int = 300):
        """A read-only command of the container's entry point as the writer, as as_writer runs it (in the running
        container, else in a one-off, whose command only reads: only_reads), not printed: (exit code, output); TIMEOUT
        seconds at most.
        """
        user = self.lib("container_layout").WRITER.name
        if self.running():
            words = ("exec", "-T", "--user", user, SERVICE, self.entry)
        else:
            words = (
                "run",
                "--rm",
                "-T",
                "-e",
                f"RKMON_AS={user}",
                *self.only_reads(),
                SERVICE,
            )
        return self.ask_docker("compose", *words, *args, timeout=timeout)

    def asked_quietly(self) -> bool:
        """Whether docker compose may be asked about this folder's deployment with no refusal said (only_ours says one
        as it stops): once a confirm is recorded (project), while this folder's container name is no other
        deployment's and whose it is is known (unknown)."""
        return bool(self.project()) and not self.unknown()

    def writer_volume(self) -> bool:
        """Whether this host has the volume the writer's logins go to (secrets_volumes; the login walk makes it): from
        then on the deployment can have the atlassian login. False, docker asked nothing more, while docker compose
        would refuse (asked_quietly): before the first confirm, the deployment has no volume.
        """
        if not self.asked_quietly():
            return False
        volumes = self.secrets_volumes() or {}
        return self.lib("container_layout").WRITE_SECRETS_DIR in volumes

    def writer_holds(self, name: str) -> bool:
        """Whether the writer keeps the login NAME, as `rk writer-secrets --json` says as the writer (writer_quiet): in
        the running container, else in a one-off container (writer_login says where that may run).
        """
        rc, out = self.writer_quiet("rk", "writer-secrets", "--json")
        held = first_json(out, "{")
        return (
            rc == 0
            and isinstance(held, dict)
            and (held.get(name) or {}).get("set") is True
        )

    def writer_login(self, name: str):
        """Check 6's question of the writer (ticket_fields.checked's LOGIN): whether it keeps the login NAME
        (writer_holds), asked only where that says nothing and makes no Docker object: in the running container, else
        in a one-off container of the image while it is here and this host has the volume the writer's logins go to.
        False, docker asked nothing more, where no login can be yet: while docker compose would refuse (asked_quietly:
        before the first confirm too), and without that volume (writer_volume). Else, why the writer cannot be asked
        yet, the words of check 6's SKIP, which name when it is: the image is not on this host (deploy step 4 puts it
        there), or --dry-run, which starts no one-off container."""
        if not self.asked_quietly():
            return False
        if not self.running():
            if not self.writer_volume():
                return False
            if self.dry == 1:
                return (
                    "the atlassian login is read through a one-off container, which --dry-run does not start: checked "
                    "when you run the command without --dry-run"
                )
            ref = self.image_ref()
            if self.image_labels(ref) is None:
                st, w = self.lib("steps"), self.program
                pull = self.confirmed().image.registry  # deploy step 4 pulls it then
                step = st.step_command(
                    st.DEPLOY_STEPS[3],
                    "image pull" if pull else None,
                    plain=self.first_tick_recorded(),
                )
                return (
                    f"the atlassian login is read through the image {ref}, which is not on this host yet: checked "
                    f"again at {w} confirm and by {w} doctor, once {step} has put it here"
                )
        return self.writer_holds(name)

    def writer_read(self, words: list) -> tuple:
        """Check 6's read, the atlassian CLI's WORDS (ticket_fields.rest_words: JIRA's create metadata), through the
        writer, the atlassian login's one keeper: `rk atlassian` runs only the commands it lists. (exit code, answer).
        """
        return self.writer_quiet("rk", "atlassian", *words, timeout=120)

    def ticket_rows(self, cfg, file: str) -> list:
        """Check 6 with its read (ticket_fields.checked) for the configuration CFG the deploy settings file FILE makes,
        at rkmon check and rkmon confirm: the writer asked only where that says nothing and makes no Docker object
        (writer_login), and no FAIL for the login before the deployment can have one (writer_volume). Its rows; the
        check itself, with the fields its question asks for, kept in self.ticket (offer_lines).
        """
        tf = self.lib("ticket_fields")
        self.ticket = tf.checked(
            cfg,
            self.lib("settings_file").shown(file),
            self.writer_read,
            lambda: self.writer_login("atlassian"),
            self.program,
            self.writer_volume,
        )
        return self.ticket.rows

    def offer_lines(self, file: str, retry, checks: list):
        """On a terminal and without --dry-run (it changes nothing), check 6's question (ticket_fields.offer) for
        the fields its read found missing (ticket_rows). Once a yes added their lines to FILE, FILE as written is read
        again and check 6 checked again on it, from the read in hand: CHECKS with check 6's rows for the file as it now
        is in place of its rows; else None, nothing written. A write that fails (a folder you cannot write, a full
        disk) ends the command: ERROR, the file as it was.
        """
        ticket = getattr(self, "ticket", None)
        if (
            ticket is None
            or not ticket.offered
            or self.dry == 1
            or not self.interactive()
        ):
            return None

        def answer(prompt: str):
            sys.stdout.write(prompt)
            sys.stdout.flush()
            line = sys.stdin.readline()
            if not line:  # the input's end: what follows starts a line of its own
                sys.stdout.write("\n")
                return None
            return line.rstrip("\n")

        tf, sf, out = (
            self.lib("ticket_fields"),
            self.lib("settings_file"),
            self.lib("outcome"),
        )
        shown = sf.shown(file)

        def recheck() -> list:
            try:
                cfg = self.lib("deployment").read(file)[0]
            except (sf.Refused, OSError):  # changed since the write
                bak = sf.shown(tf.kept(file))
                text = (
                    f"the lines were added to {shown}, but the file cannot be read again; the file as it was "
                    f"is {bak}"
                )
                raise Stopped(
                    out.finish("ERROR", text, next=self.again_line())
                ) from None
            return ticket.rows_for(cfg)

        try:
            rows = tf.offer(ticket.offered, file, retry, self.pkg, answer, say, recheck)
        except OSError as exc:  # FILE.bak is written first: FILE is as it was
            why = exc.strerror or str(exc)
            text = f"the lines could not be added to {shown} ({why}); the file is as it was"
            raise Stopped(out.finish("ERROR", text, next=self.again_line())) from None
        if rows is None:
            return None
        old = [i for i, c in enumerate(checks) if any(c is r for r in ticket.rows)]
        at = old[0] if old else len(checks)
        kept = [c for i, c in enumerate(checks) if i not in old]
        return kept[:at] + rows + kept[at:]

    def walk_inside(
        self,
        *args: str,
        user: str = "",
        stdin=None,
        quiet: bool = False,
        read: bool = False,
        kept: bool = False,
    ):
        """A command of the logins' walk (deploy step 5: rk logins, rk secret-set, rk read-login, rk claude-test,
        rk host-key), or rk web-host-install, which reads the web host from the same settings, in a one-off container,
        while the container runs too, handed the layer your confirmed settings make (handed): the variable's name alone
        on docker's command line, its value in docker compose's environment. The one-off's entry point writes it where
        rk reads it in place of the delivered layer (rkmon_lib/runtime_config.py handed_layer), so that each command
        answers for your confirmed settings, before the first start too; and it runs the image they name (walk_image),
        beside a running container of another image too (confirm, image, login, then apply). As USER
        (RKMON_AS: the writer, whose rk is its broker) when given, with how rkmon was called (called), else as the
        monitor, with the variables every command there gets (envs). QUIET: not printed, (exit code, output), as
        quiet_inside asks; READ: printed and run with no terminal, STDIN its input, what it says read, then said once it
        ends, its errors going on to yours as they come: (exit code, what it said), for its outcome line (own_outcome);
        KEPT: printed and run as compose runs it, on your terminal when you have one, what it says said as it comes
        and kept (compose's `kept`): (exit code, what it said), for the same; else printed and run as compose runs
        it, STDIN its input. With no confirmed settings to hand (the confirmed file changed or went once the state
        guard passed): Stopped, with the state's refusal (refuse), before any one-off container, so that none runs
        without your confirmed settings' layer.
        """
        plan = self.confirmed_plan()
        if plan is None:
            raise Stopped(self.refuse())
        handed = self.handed(plan)
        words = [
            "run",
            "--rm",
            "-T" if quiet or read or stdin is not None else self.tty,
            *(w for name in handed for w in ("-e", name)),
            *([*self.called(), "-e", f"RKMON_AS={user}"] if user else self.envs()),
            SERVICE,
            *args,
        ]
        variables = dict(self.walk_image(plan), **handed)
        if quiet:
            return self.ask_docker("compose", *words, timeout=300, variables=variables)
        if read:
            rc, said = self.compose(
                *words, stdin=stdin, capture=True, variables=variables
            )
            if said.strip():
                say(said.rstrip("\n"))
            return rc, said
        if kept:
            return self.compose(*words, variables=variables, kept=True)
        return self.compose(*words, stdin=stdin, variables=variables)

    def walk_image(self, plan) -> dict:
        """The image a one-off container of the logins' walk runs (walk_inside): the one PLAN names, what your
        confirmed settings make (confirmed_plan), by its RKMON_IMAGE and RKMON_TAG in docker compose's environment,
        over docker/.env's, as before the first start (compose_env)."""
        return {
            k: v for k, v in plan.variables.items() if k in ("RKMON_IMAGE", "RKMON_TAG")
        }

    def handed(self, plan) -> dict:
        """What a one-off container of the logins' walk is handed (walk_inside): the layer PLAN makes, what your
        confirmed settings make (confirmed_plan), the text the first start delivers (deliver.texts), by
        container_layout's HANDED_LAYER_VARIABLE. A layer longer than one variable carries (HANDED_LAYER_MAX bytes):
        Stopped, REFUSED, with the fix, before any one-off container.
        """
        layout, ck = self.lib("container_layout"), self.lib("checks")
        text = self.lib("deliver").texts(plan)[2]
        size = len(text.encode("utf-8"))
        if size > layout.HANDED_LAYER_MAX:
            shown = self.lib("settings_file").shown(self.recorded())
            raise Stopped(
                self.lib("outcome").finish(
                    "REFUSED",
                    f"your confirmed settings make a layer of {size} bytes, more than the {layout.HANDED_LAYER_MAX} "
                    "that one variable hands a one-off container; nothing changed",
                    fix=ck.Steps(
                        (
                            f"shorten {shown} (its longest lists)",
                            ", then",
                            ck.Command((self.program, "confirm")),
                        )
                    ),
                    next=self.again_line(),
                )
            )
        return {layout.HANDED_LAYER_VARIABLE: text}

    def secret_set(self, entry, name: str, *words: str, stdin=None) -> tuple:
        """`rk secret-set NAME WORDS` in the walk's one-off container (walk_inside), as the secret's keeper: the writer
        itself for one it keeps (its rk is its broker), else the monitor; what it says read, then said: (exit code,
        what it said), for secret_set_outcome."""
        sr = self.lib("secrets_registry")
        writer = entry is not None and entry.keeper == sr.WRITER
        user = self.lib("container_layout").WRITER.name if writer else ""
        return self.walk_inside(
            "rk", "secret-set", name, *words, user=user, stdin=stdin, read=True
        )

    def own_outcome(self, said: str, code: int) -> bool:
        """Whether SAID, what an rk command in the container said, holds rk's own outcome line for its exit code CODE:
        a line that starts as outcome.line starts one with a word of that code (outcome.WORDS). An exit 1 with none is
        not rk's ERROR: Python ends a traceback with exit 1 too, and docker some of its own failures.
        """
        oc = self.lib("outcome")
        words = [w for w, c in oc.WORDS.items() if c == code]
        # each word's start of a line, as outcome.line makes it: "ERROR: "
        heads = tuple(oc.line(w, "-")[:-1] for w in words)
        return any(x in words or x.startswith(heads) for x in said.splitlines())

    # --- whose this folder's container name and volumes are (rkmon_lib/identity.py) ----------------------------------
    def project(self) -> str:
        """This folder's compose project, which is container.name: the one the last confirm recorded (confirmed); ""
        before the first confirm, for no project is this folder's until then (only_ours).
        """
        c = self.confirmed()
        return c.container_name if c is not None else ""

    def owner_of(self, project: str = "") -> tuple:
        """(whose the container name PROJECT, this folder's by default, is on this host, why it is UNKNOWN, docker gave
        no answer): identity's NONE, OURS or OTHER from its containers' labels (rkmon_lib/identity.py); UNKNOWN when
        docker gives no answer, or one that cannot be read. Read-only, and docker is asked once for each name; with no
        name (this folder's, before the first confirm), NONE, and docker is not asked.
        """
        project = project or self.project()
        if not project:
            return self.lib("identity").NONE, "", False
        if project not in self.owners:
            ident = self.lib("identity")
            rc, out = self.ask_docker(*ident.question(project), timeout=30)
            if rc != 0:
                last = (out.strip().splitlines() or ["no answer"])[-1][:200]
                self.owners[project] = (
                    UNKNOWN,
                    f"{NO_ANSWER} ({last})",
                    True,
                )
            else:
                try:
                    self.owners[project] = (
                        ident.identity(project, self.here, out),
                        "",
                        False,
                    )
                except ValueError as exc:
                    self.owners[project] = (UNKNOWN, str(exc), False)
        return self.owners[project]

    def whose(self, project: str = "") -> str:
        """NONE, OURS, OTHER or UNKNOWN: owner_of's first answer."""
        return self.owner_of(project)[0]

    def unknown(self, project: str = "") -> str:
        """Why nothing of PROJECT's container (this folder's by default) may be asked: its name is another deployment's,
        or whose it is is unknown; "" when no container has it, or this folder's has."""
        project = project or self.project()
        word, why, _none = self.owner_of(project)
        if word == self.lib("identity").OTHER:
            return self.lib("states").name_taken(project)
        return why

    def volume_rows(self, left: str, *args: str) -> list:
        """docker's answer to ARGS, a question about the volumes this deployment would use, as identity.rows reads it.
        When docker gives no answer, Stopped as only_ours stops: REFUSED, an earlier step (exit 3), with what docker
        said; when its answer cannot be read, Stopped: ERROR. Each says LEFT, what that leaves as it was, then gives the
        command again. Read-only, and not printed."""
        ident, oc = self.lib("identity"), self.lib("outcome")
        rc, out = self.ask_docker(*args)
        if rc == 0:
            try:
                return ident.rows(out)
            except ValueError:
                why = (
                    "docker's answer about the volumes this deployment would use cannot be read, so whose they are "
                    "is unknown"
                )
        else:
            why = (
                f"{NO_ANSWER} ({(out.strip().splitlines() or ['no answer'])[-1][:200]})"
            )
        raise Stopped(
            oc.finish(
                "REFUSED" if rc else "ERROR",
                f"{why}; {left}",
                next=self.again_line(),
                earlier_step=bool(rc),
            )
        )

    def volume_owners(self, names, left: str) -> dict:
        """{volume: whose it is, identity.volume_owner's answer} for each of the volumes NAMES that is on this host, as
        this deployment would use it: each listed by its exact name (identity.exact_name), with the containers that
        mount it, running or not. docker's answers are read as volume_rows reads them (LEFT). Read-only, and not
        printed."""
        ident = self.lib("identity")
        names = sorted(set(names))
        if not names:
            return {}
        filters = [
            w for n in names for w in ("--filter", f"name={ident.exact_name(n)}")
        ]
        listed = self.volume_rows(
            left, "volume", "ls", *filters, "--format", "{{json .}}"
        )
        found = {str(r.get("Name")): r for r in listed}
        return {
            n: ident.volume_owner(
                self.project(),
                self.here,
                found[n],
                self.volume_rows(
                    left,
                    *(
                        "ps",
                        "--all",
                        "--filter",
                        f"volume={n}",
                        "--format",
                        "{{json .}}",
                    ),
                ),
            )
            for n in names
            if n in found
        }

    def only_ours(self) -> None:
        """Under every docker call of this folder's compose project, printed or not, under --dry-run too: before the
        first confirm, when this folder has no compose project, the command refuses as the state does (refuse), and
        docker is not asked; while its container name is another deployment's, it refuses (refuse_taken); while whose
        it is is unknown, it stops: REFUSED (an earlier step, docker) when docker gives no answer, else ERROR. Nothing
        has changed, and nothing of the other deployment's container was asked. Then docker compose's environment is
        this folder's deployment's (compose_env)."""
        if not self.project():
            raise Stopped(self.refuse())
        word, why, no_answer = self.owner_of()
        if word == self.lib("identity").OTHER:
            raise Stopped(self.refuse_taken())
        if word == UNKNOWN:
            raise Stopped(
                self.lib("outcome").finish(
                    "REFUSED" if no_answer else "ERROR",
                    f"{why}; nothing changed",
                    next=self.again_line(),
                    earlier_step=no_answer,
                )
            )
        self.compose_env()

    def compose_env(self) -> None:
        """docker compose's environment for this folder's deployment, once a confirm is recorded: its compose project,
        the confirmed container.name, over the environment's and docker/.env's; and the other variables the confirmed
        settings make there (confirmed_plan). While there is no docker/.env this package's deliver wrote (the first
        start writes it: rkmon_lib/deliver.py; dotenv_delivered), each of them, so that a one-off container before the
        first start (the logins) runs the confirmed image, with the confirmed ids and limits. After it, docker/.env's,
        but for each one the file lacks that every deploy settings make (dotenv_lacks): a variable a later package
        adds, which the docker/.env an earlier package wrote does not have until the next apply writes this one's.
        """
        c = self.confirmed()
        if c is None:
            return
        os.environ["COMPOSE_PROJECT_NAME"] = c.container_name
        if self.dotenv_delivered():
            wanted = self.dotenv_lacks()
            if not wanted:
                return
        else:
            wanted = self.lib("deploy_plan").ENV_KEYS
        plan = self.confirmed_plan()
        if plan is not None:
            os.environ.update({k: v for k, v in plan.variables.items() if k in wanted})

    def refuse_taken(self) -> int:
        """The refusal while this folder's container name, the confirmed one, is another deployment's: the state
        table's (rkmon_lib/states.py) state 1, with its fix. Its exit code."""
        return self.refuse(facts=self.state_facts())

    def refuse(self, need: str = "", fix=None, facts=None) -> int:
        """A command that does not run in the deployment's state (rkmon_lib/states.py): REFUSED with the state's
        sentence (NEED, what the command itself needs, in its place), the state's fix (FIX, the need's own, in its
        place) and its next line (since_start). FACTS: the state's facts, when the caller has them. Its exit code: 3
        when an earlier step is not done, else 4."""
        st = self.lib("states")
        facts = facts or self.state_facts()
        state = st.current(facts)
        return st.refuse(
            state, facts, need, fix=fix, since=self.since_start(state, facts)
        )

    def refuse_without_image(self, image: str) -> int:
        """REFUSED while IMAGE, the image a command runs (the logins' walk, start), is not on this host: state 6's
        sentence as what the command needs, with the deployment state's fix and next line (refuse).
        """
        no_image = self.lib("states").TABLE[6 - 1]  # state 6, "No image"
        facts = self.state_facts()
        return self.refuse(
            no_image.words(dataclasses.replace(facts, image=image)), facts=facts
        )

    def probe_unknown(self, what: str) -> None:
        """Before a probe (logs, logins, first-tick) asks anything of this folder's container: while its name is
        another deployment's, or whose it is is unknown, WHAT is unknown; it says so, and refuses as every command
        does (only_ours)."""
        if self.unknown():
            say(f"{what}: unknown")
            self.only_ours()

    def state_guard(self, running=None, host_check=None, outside=None):
        """A command of the deploy side runs only in the deployment states its row names (commands.Row.states; in
        state 3, a command the records keep as under way only where it finishes the one
        that stopped part-way: states.runs_here), and only while this folder's container exists or runs, as its row
        needs (Row.container): else Stopped, with the state's refusal (rkmon_lib/states.py, refuse): REFUSED with the
        state's sentence, or, in one of the row's states, the need's when that is what fails (commands.NEEDS), and the
        state's next line; exit 3 in an earlier step's state, else 4. RUNNING, for a command with its own word while
        the container runs, whatever the state after 6 (start has nothing to do then; adopt refuses): a function that
        says it and returns the exit code, which Stopped carries, or None to run on as the state decides (start, while
        an rk stop keeps the monitor stopped). HOST_CHECK, for a command that checks this host first (start: check 15,
        the volumes): a function run once the state is after 6, before the container is asked (a one-off container
        mounts the volumes), that raises Stopped to refuse. Its handler calls it once the banner and its own usage
        errors are said; once for each command, so not for a command the logins' walk runs. OUTSIDE, for a command
        with its own word in a state its row leaves out (standby off: standby_off_elsewhere): a function of that state
        and its facts that says it and returns the exit code, which Stopped carries, in the place of the state's
        refusal. The facts ask no container first (DockerAnswers, ask False): they tell each state before the
        container's (states.BEFORE_CONTAINER), and read every later one as state 8. The container is asked only as the
        row's states and need require; for a command that needs it, while there is none, a state after 6 reads as 8,
        its logins unasked (a one-off container would make the volumes). While whose the container name is is unknown,
        a command that runs in each state it may be in runs, and any other stops (only_ours). It returns the facts the
        command runs on: every one when the state needed the container's, else those that ask no container; None when
        it guards nothing.
        """
        row = self.row
        if self.guarded or self.walking or row is None or not row.states:
            return None
        self.guarded = True
        st, cmds = self.lib("states"), self.lib("commands")
        runs_in = set(row.states)

        def stop(facts, need: str = ""):
            state = st.current(facts)
            if not st.runs_here(row.name, runs_in, state.n, facts.under_way):
                raise Stopped(
                    outside(state, facts) if outside else self.refuse(facts=facts)
                )
            if need:
                raise Stopped(self.refuse(need, facts=facts))
            return facts

        facts = self.state_facts(DockerAnswers(self, ask=False))
        state = st.current(facts)
        if facts.name_owner == UNKNOWN and state.n not in st.RECORDS_ONLY:
            # the state is 1, or one of 6 to 16
            if not {1, *range(6, 17)} <= runs_in:
                self.only_ours()
            return facts
        if state.n in st.BEFORE_CONTAINER:
            need = row.container if state.n in runs_in else ""
            there = (
                need not in cmds.NEEDS
                or self.running()
                or need == cmds.EXISTS
                and self.made()
            )
            return stop(facts, "" if there else cmds.NEEDS[need])
        if running is not None and self.running():
            code = running()
            if code is not None:
                raise Stopped(code)
        if host_check is not None:
            host_check()
        if row.container in cmds.NEEDS:
            up = self.running()
            if not (up or self.made()):
                # state 7 or 8, whose sentence refuses
                raise Stopped(self.refuse(facts=self.state_facts()))
            elif row.container == cmds.RUNS and not up:
                stop(self.state_facts(), cmds.NEEDS[cmds.RUNS])
            elif (
                not {7, *range(9, 17)} <= runs_in
            ):  # the states a container that exists is in
                facts = stop(self.state_facts())
        elif not set(range(7, 17)) <= runs_in:
            facts = stop(self.state_facts())
        return facts

    def file_layout(self, path: str) -> int:
        """The layout of PATH, a deploy settings file, as its header gives it (schema_version); a header that does not
        say reads as this package's layout (the file is then not readable as settings, which its own checks say).
        """
        deploy = self.lib("file_types").DEPLOY
        try:
            head = self.lib("image").load(path)
        except (OSError, ValueError, SyntaxError):
            return deploy.version
        if (
            isinstance(head, dict)
            and head.get("kind") == deploy.kind
            and isinstance(head.get("schema_version"), int)
        ):
            return head["schema_version"]
        return deploy.version

    def state_facts(self, answers=None):
        """The state table's facts (rkmon_lib/state_facts.py gathers them): this folder's records, the settings file
        the last confirm recorded and this package, then, only while the state is not decided before them and the
        container name is this folder's or no container's, what docker says: ANSWERS, a DockerAnswers (one that asks
        every question by default), kept as `answers`: a command reuses them after its state guard (cmd_apply).
        """
        self.answers = answers or DockerAnswers(self)
        return self.lib("state_facts").gather(self.pkg, self.answers)

    def layer_in_volume(self, kept: bool = False, variables=None) -> tuple:
        """The delivered layer in the settings volume: deliver.LAYER_FILE (rkmon_lib/deliver.py writes it), read by a
        one-off container that mounts that volume read-only where deliver's mounts it, in this deployment's compose
        project and of its image (deployment_variables; VARIABLES, docker compose's variables, in their place); KEPT:
        the layer a delivery kept, deliver.LAYER_KEPT. (its text, ""); (None, "") when none is there, as cat says;
        else (None, why it cannot be read). Read-only, and not printed."""
        dl = self.lib("deliver")
        path = f"{dl.LAYER_WRITE_DIR}/{dl.LAYER_KEPT if kept else dl.LAYER_FILE}"
        rc, out = self.ask_docker(
            "compose",
            "run",
            "--rm",
            "-T",
            "--no-deps",
            "-v",
            f"{dl.SETTINGS_VOLUME}:{dl.LAYER_WRITE_DIR}:ro",
            "--entrypoint",
            "cat",
            SERVICE,
            path,
            variables=variables or self.deployment_variables(),
        )
        if rc == 0:
            return out, ""
        if f"{path}: No such file or directory" in out:
            return None, ""
        lines = [x for x in out.splitlines() if x.strip()]
        why = lines[-1].strip()[:200] if lines else "no answer"
        return None, f"docker compose run exited {rc}: {why}"

    def delivered_layer(self, kept: bool = False, variables=None):
        """The delivered layer's text (layer_in_volume, KEPT and VARIABLES as it takes them): None when none is there
        or it cannot be read."""
        return self.layer_in_volume(kept, variables)[0]

    def keep_previous(self, plan) -> bool:
        """Whether deliver keeps what is in place as it puts PLAN in (deliver.keep_previous, the rule), the layer in
        place read in the plan's compose project and with its image (layer_in_volume) when the records do not say;
        deliver.Failed, nothing changed, when it cannot be read."""
        dl = self.lib("deliver")
        return dl.keep_previous(
            self.pkg, plan, lambda: self.layer_in_volume(variables=plan.variables)
        )

    def kept_fingerprint(self) -> str:
        """The fingerprint the layer the settings volume keeps (deliver.LAYER_KEPT) was made from
        (state_facts.layer_fingerprint); "" when none is kept, it cannot be read, or it does not say.
        """
        sf = self.lib("state_facts")
        return sf.layer_fingerprint(self.delivered_layer(kept=True))

    def confirm_applied(self) -> bool:
        """Whether the layer delivered in the settings volume (delivered_layer), the settings the container runs, is
        the one your last confirm makes: their fingerprints agree (state_facts.layer_fingerprint), as state 11, "A
        change waits", reads them. False before the first confirm. Read-only, and not printed.
        """
        c = self.confirmed()
        if c is None:
            return False
        delivered = self.delivered_layer()
        return self.lib("state_facts").layer_fingerprint(delivered) == c.fingerprint

    def monitor_answer(self, ask=None):
        """What the running monitor says it runs (state_facts.Monitor), as `rk applied --json` answers: the
        fingerprint of its applied record, whether it is in standby, and whether a pause you set is on. An older
        package's rk, which has no such command (older_rk), runs none of your confirmed settings, and has no
        standby: ("", False, False). NoAnswer when rk refuses (its applied record cannot be read) or gives no answer it
        can read. ASK: what asks rk, a function of its words that returns (exit code, output); quiet_inside by default.
        """
        rc, out = (ask or self.quiet_inside)("rk", "applied", "--json")
        if older_rk(rc, out):
            return self.lib("state_facts").Monitor("", False, False)
        said = first_json(out, "{") if rc in (0, 1) else None
        if not isinstance(said, dict):
            raise NoAnswer(rc, out)
        applied = said.get("applied") if isinstance(said.get("applied"), dict) else {}
        return self.lib("state_facts").Monitor(
            str(applied.get("fingerprint") or ""),
            bool(said.get("standby")),
            bool(said.get("paused")),
        )

    def says_standby(self) -> bool:
        """Whether the monitor says it is in standby (monitor_answer), asked in a one-off container of the logins'
        walk (walk_inside), as rk web-host-install runs: before the first start too, and with the container stopped,
        where the deployment's state does not show standby. False with no answer it can read. Read-only, and not
        printed.
        """
        try:
            answer = self.monitor_answer(lambda *a: self.walk_inside(*a, quiet=True))
        except NoAnswer:
            return False
        return answer.standby

    def abspath(self, path: str) -> str:
        path = os.path.expanduser(path)
        return path if path.startswith("/") else f"{self.cwd}/{path}"

    def again(self, given: str = ""):
        """A fix's command that names another file (private_files.again): this command as you typed it, that file in
        the place of GIVEN (the one you named, as you typed it); with none named, --settings and that file after it.
        """
        return self.lib("private_files").again((self.program, *self.typed), given)

    def again_command(self, typed=None):
        """This command again as you typed it (TYPED: those words instead), as a fix's command (checks.Command)."""
        words = self.typed if typed is None else typed
        return self.lib("checks").Command((self.program, *words))

    def typed_without(self, option: str) -> list:
        """The command line as you typed it (`typed`) without OPTION and its value, typed as OPTION VALUE or
        OPTION=VALUE (the parser takes no shorter form of an option)."""
        words, value = [], False
        for word in self.typed:
            if value:
                value = False
            elif word == option:
                value = True
            elif not word.startswith(f"{option}="):
                words.append(word)
        return words

    def next_of(self, words) -> str:
        """A next line: its label (steps.NEXT_LABEL), then WORDS, a command and the words that may follow it."""
        return f"{self.lib('steps').NEXT_LABEL}{words}"

    def again_line(self, typed=None) -> str:
        """A failure's next line (next_of): this command again as you typed it (TYPED: those words instead)."""
        return self.next_of(self.again_command(typed))

    def dry_run_outcome(self, text: str) -> int:
        """Under --dry-run, once every guard has passed: PASSED with TEXT, what the real run would do, then the command
        without --dry-run. Exit 0, as the real run's success."""
        typed = [w for w in self.typed if w != "--dry-run"]
        return self.lib("outcome").finish("PASSED", text, next=self.again_line(typed))

    def say_next(self, line: str) -> None:
        """LINE, a next line, alone: after the outcome line rk said in the container, or a path step's rows and
        outcome; as outcome.finish prints one (outcome.next_lines), at most as wide as a check row.
        """
        say("\n".join(self.lib("outcome").next_lines(line)))

    def interactive(self) -> bool:
        return os.isatty(0) and os.isatty(1)

    def confirm(self, question: str, default: bool = True) -> bool:
        if not self.interactive():
            return False
        sys.stdout.write(f"{question} [{'Y/n' if default else 'y/N'}] ")
        sys.stdout.flush()
        try:
            a = sys.stdin.readline().strip().lower()
        except (EOFError, KeyboardInterrupt):
            return False
        return default if not a else a in ("y", "yes")

    def state_next_line(self, ask: bool = True, done=None) -> str:
        """The deployment's state's next line (rkmon_lib/states.py), as rkmon next gives it, with what has passed since
        the start (since_start): the next line of every command on the deploy side but a path step that succeeds
        before any state. ASK False: no container asked (DockerAnswers), for a refusal before the container may
        be asked (volume_guard: a one-off container mounts the volumes). DONE, a function, gives the line in state 16
        in its place: first-tick's, the deploy path's done line (deploy_done).
        """
        return self.state_now(ask, done)[1]

    def state_now(self, ask: bool = True, done=None) -> tuple:
        """(the facts, the next line) of the deployment's state, that line as state_next_line gives it: for an outcome
        that says what those facts say (start's and apply's standby: states.with_standby).
        """
        st = self.lib("states")
        answers = DockerAnswers(self, ask)
        facts = self.state_facts(answers)
        state = st.current(facts)
        if done is not None and state.n == st.TABLE[-1].n:
            return facts, done()
        return facts, st.next_line(
            state, facts, self.since_start(state, facts, answers)
        )

    # --- the deployment's local files -----------------------------------------------------------------------------
    @property
    def dotenv_file(self) -> str:
        """docker/.env, the variables docker compose reads for this folder's deployment, which deliver writes."""
        return os.path.join(self.here, ".env")

    def dotenv(self) -> dict:
        return self.lib("image").dotenv(self.dotenv_file)

    def dotenv_there(self) -> bool:
        """Whether docker/.env is there (a link counts, whatever it points at): the one test of it, which
        dotenv_delivered and own_volumes read."""
        return os.path.lexists(self.dotenv_file)

    def dotenv_delivered(self) -> bool:
        """Whether docker/.env is the one this package's deliver wrote for this folder's deployment: the file is there,
        and the records, read as confirmed reads them, keep the fingerprint of the docker/.env deliver wrote
        (records.Written's env). False before the first start, and for an older package's docker/.env, which a move in
        place carries and which lacks this package's variables until the first apply writes its own.
        """
        written = self.lib("records").read(self.pkg).written
        return self.dotenv_there() and bool(written is not None and written.env)

    def dotenv_lacks(self) -> list:
        """The variables docker/.env lacks of those every deploy settings make: deploy_plan.ENV_KEYS but the team
        dashboard's two, there only while it is served (the keys that decide it, deploy_plan.TEAM_SWITCH, among those
        they are made from), which stay as docker/.env has them, so that a change that waits for apply never reaches
        what runs."""
        dp, on_file = self.lib("deploy_plan"), self.dotenv()
        switch = set(dp.TEAM_SWITCH)
        return [
            k
            for k, keys in dp.ENV_KEYS.items()
            if k not in on_file and not switch & set(keys)
        ]

    def compose_variables(self, on_file=None) -> dict:
        """The variables the deploy settings make for docker/.env (deploy_plan.ENV_KEYS), as docker compose reads them
        for this deployment: each as rkmon set it in this process's environment (compose_env; your shell's are
        dropped as rkmon starts: drop_shell_variables), else the file's, as tag reads RKMON_TAG. ON_FILE: the file's
        values, when not the file in place (the first start's variables, before it writes them there).
        """
        on_file = self.dotenv() if on_file is None else on_file
        return {
            k: os.environ.get(k) or on_file.get(k, "")
            for k in self.lib("deploy_plan").ENV_KEYS
        }

    def deployment_variables(self) -> dict:
        """The variables docker compose takes for this deployment's one-off containers in apply and rollback, and for
        the delivered layer's reads: the confirmed plan's (confirmed_plan), as deliver takes them; while the
        confirmed settings cannot be read (changed or gone since the confirm), docker/.env's (compose_variables) with
        the confirmed compose project and image over them (records.Confirmed). Never docker/.env's own project or
        image, which a hand edit may have changed (state 9)."""
        plan = self.confirmed_plan()
        if plan is not None:
            return dict(plan.variables)
        variables, c = self.compose_variables(), self.confirmed()
        if c is not None:
            variables.update(
                COMPOSE_PROJECT_NAME=c.container_name,
                RKMON_IMAGE=c.image.name,
                RKMON_TAG=c.image.tag,
            )
        return variables

    def settings_variables(self, file: str) -> dict:
        """The variables the deploy settings file FILE makes for docker/.env on this host, as deliver writes them once
        it is confirmed (deploy_plan.env_values, on your user's and group's ids). FILE reads as deploy settings, and its
        own rows pass."""
        dp = self.lib("deploy_plan")
        doc = self.lib("settings_file").read(file, self.lib("file_types").DEPLOY)
        return dp.env_values(dp.settings(doc), dp.Host(os.getuid(), os.getgid(), ""))

    def confirmed(self):
        """The last confirm this folder's records keep (rkmon_lib/records.py: records.Confirmed); None before the first.
        private_files.Refused or records.Unreadable when the records cannot be read: main() says why, with the fix.
        """
        return self.lib("records").read(self.pkg).confirmed

    def recorded(self) -> str:
        """The deploy settings file the last confirm recorded, as a full path; "" before the first confirm."""
        c = self.confirmed()
        return os.path.expanduser(c.settings_file) if c is not None else ""

    def confirmed_document(self):
        """The deploy settings document the last confirm recorded (settings_file.read): None before the first confirm,
        and while the confirmed file is gone, cannot be read as settings in this package's layout, or changed after the
        confirm."""
        c = self.confirmed()
        if c is None:
            return None
        try:
            doc = self.lib("settings_file").read(
                os.path.expanduser(c.settings_file), self.lib("file_types").DEPLOY
            )
        except (OSError, ValueError):
            return None
        return (
            doc if self.lib("deploy_plan").file_sha256(doc) == c.file_sha256 else None
        )

    def confirmed_plan(self, doc=None):
        """What the confirmed settings make on this host (deploy_plan.plan, with the package's version, its code's
        SHA-256 and the time the confirm recorded, on your user's and group's ids): None while there is no confirmed
        document (confirmed_document; DOC, when the caller has it)."""
        if doc is None:
            doc = self.confirmed_document()
        if doc is None:
            return None
        c, dp = self.confirmed(), self.lib("deploy_plan")
        host = dp.Host(os.getuid(), os.getgid(), c.at)
        return dp.plan(doc, c.package_version, c.code_sha256, host)

    def confirmed_values(self):
        """The configuration the confirmed settings make (runtime_config.from_settings, of confirmed_plan's layer):
        what the secrets registry reads for the secrets and logins they name. None while confirmed_plan gives none.
        """
        made = self.confirmed_plan()
        if made is None:
            return None
        return self.lib("runtime_config").from_settings(made.layer["settings"]).values

    def tag(self) -> str:
        """The image tag the deployment runs: RKMON_TAG (as rkmon set it in this process's environment, else
        docker/.env's), else the confirmed settings' (image.tag); "" while none names one, before the first confirm,
        as docker compose takes none (compose.yaml gives RKMON_TAG no default)."""
        c = self.confirmed()
        return (
            os.environ.get("RKMON_TAG")
            or self.dotenv().get("RKMON_TAG")
            or (c.image.tag if c is not None else "")
        )

    def image_name(self) -> str:
        """The image name the deployment runs: RKMON_IMAGE (as rkmon set it in this process's environment, else
        docker/.env's), else the confirmed settings' (image.name); "" while none names one, as `tag`.
        """
        c = self.confirmed()
        return (
            os.environ.get("RKMON_IMAGE")
            or self.dotenv().get("RKMON_IMAGE")
            or (c.image.name if c is not None else "")
        )

    def image_ref(self, tag: str = "", name: str = "") -> str:
        """The deployment's image, <name>:<tag> (another tag or name when given); "" while no image is named (`tag`,
        `image_name`)."""
        name, tag = name or self.image_name(), tag or self.tag()
        return f"{name}:{tag}" if name and tag else ""

    def settings_name(self) -> str:
        """The image name the confirmed deploy settings name (image.name): the one a load looks for. The deployment's
        own name before the first confirm.
        """
        c = self.confirmed()
        return c.image.name if c is not None else self.image_name()

    def settings_image(self) -> str:
        """The image the confirmed deploy settings name, <image.name>:<image.tag> (records.Image): the one a pull
        brings and a check checks, and the one a loaded image is compared with. The
        deployment's own (image_ref) before the first confirm."""
        c = self.confirmed()
        return c.image.reference if c is not None else self.image_ref()

    def image_labels(self, ref: str):
        """The image's labels, or None when there is no such image (read-only)."""
        rc, out = self.ask_docker(
            "image", "inspect", "--format", "{{json .Config.Labels}}", ref
        )
        if rc != 0:
            return None
        try:
            v = json.loads(out.strip() or "{}")
        except ValueError:
            return {}
        return v if isinstance(v, dict) else {}

    def settings_cfg(self, file: str):
        """(the configuration a deploy settings file makes, ""), or (None, what is wrong with the file, without its
        fix): deployment.read. The file's FAIL and WARN rows, with check 7's PASS row, land in self.problems: a refused
        file's rows, or the row of a file that cannot be opened; each keeps its fix, which refuse_unread shows. What is
        wrong is the one row's found text, or, for several rows, that the file cannot be read.
        """
        ck, sf = self.lib("checks"), self.lib("settings_file")
        self.problems = []
        try:
            cfg, self.problems = self.lib("deployment").read(file)
        except sf.Refused as exc:
            self.problems = exc.rows
            if len(exc.rows) == 1:
                return None, exc.rows[0].found
            return None, f"{sf.shown(file)} cannot be read"
        except OSError as exc:
            found = f"{file}: {exc.strerror or exc}"
            fix = ck.Command(("ls", "-l", file))
            self.problems = [ck.Check("your settings file", ck.Status.FAIL, found, fix)]
            return None, found
        return cfg, ""

    def refuse_unread(self, problem: str) -> int:
        """The refusal of a command whose recorded settings file cannot be read (settings_cfg: PROBLEM, and its rows in
        self.problems), each fix on a line of its own, as migrate shows a settings file's refusal: the one FAIL row as
        the refusal itself, its fix after the outcome line in the place of the state's (refuse); several rows printed
        first, each with its fix, then the refusal. Each with the state's next line. Its exit code.
        """
        ck, oc = self.lib("checks"), self.lib("outcome")
        rows = [r for r in self.problems if r.status == ck.Status.FAIL]
        if len(rows) > 1:
            say(ck.render(rows, "problems"))
            return oc.finish(
                "REFUSED",
                f"{problem}; {oc.FIX_EACH_FAIL}",
                next=self.state_next_line(),
            )
        return self.refuse(problem, fix=rows[0].fix if rows else None)

    # --- host facts (read-only) -----------------------------------------------------------------------------------
    def facts(self, cfg, tls_cafiles=None, ref: str = "", variables=None) -> object:
        """What the deploy path's check (cfg: the deploy settings; VARIABLES: docker/.env's variables they make,
        settings_variables, or None while they are not known: then the dashboards' ports are not asked) and the build
        path's (cfg None, tls_cafiles: the build settings' root certificates, for the TLS probe of a public site; REF,
        the image the build makes: whether it is on this machine already) look at, asked read-only.
        """
        d = self.lib("deployment")
        f = d.Facts()
        rc, out = self.ask_docker(
            "version", "--format", "{{.Server.Version}}", timeout=30
        )
        if rc == 0 and out.strip():
            f.docker = out.strip()
        else:
            f.docker_error = (out.strip().splitlines() or ["docker does not answer"])[
                -1
            ][:200]
        if f.docker:
            rc, out = self.ask_docker("compose", "version", "--short", timeout=30)
            f.compose = out.strip() if rc == 0 else ""
            rc, out = self.ask_docker("buildx", "version", timeout=30)
            f.buildx = out.strip().splitlines()[0] if rc == 0 and out.strip() else ""
        f.python = tuple(sys.version_info[:3])
        f.host_gb, f.host_cpus = d.host_size()
        where = self.here
        if f.docker:
            rc, out = self.ask_docker(
                "info", "--format", "{{.DockerRootDir}}", timeout=30
            )
            if rc == 0 and os.path.isdir(out.strip()):
                where = out.strip()
        try:
            f.disk_free_gb = shutil.disk_usage(where).free / 2**30
            f.disk_where = where
        except OSError:
            pass
        if tls_cafiles is not None:
            f.tls = d.tls_probe(tls_cafiles)
        if ref and f.docker:
            f.image_here = self.image_labels(ref) is not None
        if cfg is None:
            return f
        # Whose the file's own container name is, and its volumes; a blank name is none, which the file's check
        # refuses, and docker is not asked about it.
        project = d.project(cfg)
        if f.docker and project:
            word, why, _none = self.owner_of(project)
            f.name_owner, f.name_unknown = ("", why) if word == UNKNOWN else (word, "")
        f.busy_ports = (
            None
            if variables is None
            else self.busy_ports(variables, f.name_owner == self.lib("identity").OURS)
        )
        if f.docker and project:
            f.project_volumes = self.project_volumes(project) or []
        f.first_settings = not self.recorded()
        return f

    def project_volumes(self, project: str):
        """The names of the volumes docker lists as the compose project PROJECT's, by its compose project label (one a
        removed deployment of that name left included); None when docker gives no answer. Read-only, and not printed:
        a listing filtered on that label, which reads no other deployment's object (the deploy path's check, facts, and
        check 16's, own_secrets_volume)."""
        rc, out = self.ask_docker(
            "volume",
            "ls",
            "--filter",
            f"label={self.lib('identity').PROJECT}={project}",
            "--format",
            "{{.Name}}",
        )
        return out.split() if rc == 0 else None

    def busy_ports(self, values: dict, ours: bool) -> list:
        """The dashboards' ports .env publishes (VALUES: the .env values the deploy settings make) that another program
        or container uses, as (address, port). A port counts as this deployment's only when this folder's own
        container uses it (OURS: the container name is this folder's). Read-only.
        """
        d = self.lib("deployment")
        held = set()
        if ours:
            rc, out = self.ask_docker(
                "ps",
                "--filter",
                f"label=com.docker.compose.project={values['COMPOSE_PROJECT_NAME']}",
                "--format",
                "{{.Ports}}",
            )
            held = {
                int(m.group(1))
                for m in re.finditer(r":(\d+)->", out if rc == 0 else "")
            }
        return [
            (h, p)
            for h, p in d.ports(values)
            if p not in held and not d.port_free(h, p)
        ]

    # --- the commands ---------------------------------------------------------------------------------------------
    def main(self, args: list) -> int:
        """One command line: read by the command table's parser (rkmon_lib/commands.py), which prints the help, the
        version and each usage error itself (exit 2 for a usage error); then, in docker/, the handler of the command's
        row (handler), with what the parser read, while the command holds the package folder's lock as its row says
        (hold_lock); a handler that ends on an exception ends with an outcome line all the same (ended_on). With no
        command, the overview, as `help` prints it.
        """
        self.typed = list(args)
        cmds = self.lib("commands")
        try:
            ns = cmds.table_parser(
                self.lib("image").package_version(self.pkg)
            ).parse_args(args)
        except SystemExit as exc:
            return int(exc.code or 0)
        self.dry = 1 if ns.dry_run else 0
        self.image_code = ns.image_code
        if ns.row is None:
            sys.stdout.write(cmds.table_help())
            return 0
        self.tty = "-it" if os.isatty(0) and os.isatty(1) else "-T"
        self.cwd = logical_pwd()
        try:
            os.chdir(self.here)
        except OSError as exc:
            err(f"{self.program}: cannot cd to {self.here}: {exc.strerror}")
            return 2
        os.environ["PWD"] = self.here
        self.cmd, self.row = ns.row.name, ns.row
        try:
            with contextlib.ExitStack() as held:
                self.hold_lock(ns, held)
                return self.handler(ns.row)(ns)
        except Stopped as exc:
            return exc.code
        except NoAnswer as exc:
            return self.no_answer(exc)
        except Exception as exc:
            # every command ends with its outcome line: ended_on says it
            return self.ended_on(exc)

    def ended_on(self, exc: Exception) -> int:
        """The outcome of a command its handler leaves on EXC (main), then this command again: this folder's records
        that cannot be read (unreadable_records); a private file the command reads or writes that breaks a rule, which
        shows itself, its rows then where the rules are, then REFUSED, nothing written there, exit 4; any other, an
        error the command does not handle: its traceback, on stderr, then ERROR with what it is, exit 1.
        """
        records = sys.modules.get("rkmon_lib.records")
        if records is not None and isinstance(exc, records.Unreadable):
            return self.unreadable_records(exc)
        oc, pf = self.lib("outcome"), sys.modules.get("rkmon_lib.private_files")
        if pf is not None and isinstance(exc, pf.Refused):
            what = f"a private file {self.program} {self.cmd} reads or writes breaks a rule"
            done = oc.AFTER_FAILS.format("nothing is written there")
            stop = oc.Stopped("REFUSED", f"{what}; {done}", above=str(exc))
            return stop.finish(next=self.again_line())
        sys.stdout.flush()
        traceback.print_exception(type(exc), exc, exc.__traceback__)
        sys.stderr.flush()
        what = f"{type(exc).__name__}: {exc}" if str(exc) else type(exc).__name__
        return oc.finish(
            "ERROR",
            f"{self.program} {self.cmd} stopped on an error it does not handle ({what}); the traceback above "
            "says where",
            next=self.again_line(),
        )

    def hold_lock(self, ns, held) -> None:
        """The package folder's lock, held for the whole run as the command's row says (commands.Row.lock;
        rkmon_lib/package_lock.py), each hold entered into HELD (a contextlib.ExitStack), which lets it go, and which
        is kept (`held`) for the holds the command takes as it runs (hold_folder): this folder's, shared; or the one
        of the folder the command replaces (replaced_folder), exclusive, and this folder's shared too when that is
        another. Each hold names the command as you typed it. A hold refused is the command's refusal (lock_refused):
        Stopped, nothing changed. So is this folder once it is not the one the command started in (`started`): a
        package update replaced it before the lock was held.
        """
        self.held, cmds = held, self.lib("commands")
        if ns.row.lock == cmds.NO_LOCK:
            return
        exclusive = ns.row.lock == cmds.EXCLUSIVE
        folder = os.path.realpath(self.replaced_folder(ns)) if exclusive else self.pkg
        if folder != self.pkg:
            self.hold_folder(self.pkg)
        self.hold_folder(folder, exclusive)
        if self.started is None:
            return
        try:
            same = os.path.samestat(self.started, os.stat(self.pkg))
        except OSError:
            same = False
        if not same:
            text = (
                "a package update replaced this package folder as the command started"
            )
            raise Stopped(
                self.lib("outcome").finish(
                    "REFUSED", f"{text}; nothing changed", next=self.again_line()
                )
            )

    def hold_folder(self, folder, exclusive: bool = False, own=None) -> None:
        """The lock of the package folder FOLDER (rkmon_lib/package_lock.py), held shared, or EXCLUSIVE, until the
        command ends (main lets go of the stack hold_lock keeps, `held`), its hold naming the command as you typed it.
        A hold refused is the command's refusal (lock_refused): Stopped, nothing changed. When this command holds
        FOLDER's lock already (`held_folders`), the same command again could only be refused again: the refusal's next
        line names OWN instead, when given, the command to run in its place (cmd_package_update's).
        """
        pl = self.lib("package_lock")
        typed, real = str(self.again_command()), os.path.realpath(folder)
        try:
            self.held.enter_context(pl.hold(folder, typed, exclusive=exclusive))
        except pl.Taken as exc:
            again = own if real in self.held_folders else None
            raise Stopped(self.lock_refused(exc, folder, again)) from None
        self.held_folders.add(real)

    def replaced_folder(self, ns) -> str:
        """The package folder the command replaces (package update): --folder's, from the folder you ran this in, else
        this one."""
        return self.abspath(ns.folder) if getattr(ns, "folder", None) else self.pkg

    def lock_refused(self, exc, folder, again=None) -> int:
        """A hold of the package folder's lock refused (hold_folder; package_lock.Taken), for any command while a
        package update runs; for a package update, while other commands run in FOLDER, the folder it replaces or one
        it moves beside it: each as its hold names it, since when (progress.shown_time), else another command, and
        `in FOLDER` when that is not this folder or AGAIN is given. Then nothing changed, and this command again, else
        AGAIN: the command to run in its place, as this command holds FOLDER's lock itself (hold_folder). REFUSED,
        exit 4.
        """
        if exc.update:
            text = "a package update runs"
        else:
            where = ""
            if again is not None or os.path.realpath(folder) != self.pkg:
                where = f" in {self.lib('settings_file').shown(folder)}"
            shown = self.lib("progress").shown_time
            runs = []
            for h in exc.holders:
                since = f", since {shown(h.since)}" if h.since else ""
                runs.append(f"{h.command} runs{where}{since}")
            text = "; ".join(runs) or f"another {self.program} command runs{where}"
        line = self.again_line() if again is None else self.next_of(again)
        return self.lib("outcome").finish(
            "REFUSED", f"{text}; nothing changed", next=line
        )

    def unreadable_records(self, exc) -> int:
        """REFUSED while this folder's records are none this package reads (records.Unreadable): why, the fix (the
        records moved aside, then the confirm again), then this command again. Exit 4.
        """
        ck, oc = self.lib("checks"), self.lib("outcome")
        text, fix = str(exc), f" ({ck.FIX_LABEL}{exc.fix})"
        if text.endswith(fix):
            text = text[: -len(fix)]
        return oc.finish(
            "REFUSED", f"{text}; nothing changed", fix=exc.fix, next=self.again_line()
        )

    def no_answer(self, exc) -> int:
        """The outcome while the running monitor does not say what it runs (NoAnswer): rk's refusal as rk says it, its
        REFUSED line and its fix, then this command again, exit 4; any other answer, or none, ERROR with what rk or
        docker said, exit 1."""
        if exc.refused:
            for line in exc.lines:
                say(line)
            self.say_next(self.again_line())
            return 4
        return self.lib("outcome").finish(
            "ERROR", f"{exc.unknown} ({exc.why()})", next=self.again_line()
        )

    def handler(self, row):
        """The method that runs ROW, a row of the command table: cmd_ and the command's words, each space and - an _
        (`image load`: cmd_image_load; `first-tick`: cmd_first_tick). It takes what the parser read.
        """
        return getattr(self, "cmd_" + row.name.replace(" ", "_").replace("-", "_"))

    def run_words(self, words) -> int:
        """Another command, as the logins' walk runs the one a row names: WORDS, the words after the program's name,
        read by the command table's parser (a usage error is said, and is the exit code), then that command's handler.
        This command's words as you typed them, its dry run and its folder stay."""
        try:
            ns = self.lib("commands").table_parser().parse_args(list(words))
        except SystemExit as exc:
            return int(exc.code or 0)
        return self.handler(ns.row)(ns)

    def cmd_help(self, ns) -> int:
        """`help [COMMAND | TOPIC]`: the overview, a command's help or a topic, from the command table; anything else
        is a usage error, the table's (commands.help_for): a replaced command's names the one that replaces it.
        """
        cmds = self.lib("commands")
        try:
            sys.stdout.write(cmds.table_help(ns.command))
        except KeyError as exc:
            err(f"{self.program} help{exc.args[0]}")
            return self.lib("outcome").USAGE
        return 0

    def refused_file(self, path: str, what: str, retry) -> bool:
        """Whether the private file PATH breaks a rule (private_files.checked: yours only, outside the package, git
        and cloud-synced folders), each one said with its fix (RETRY names another file): its contents are not to be
        used then.
        """
        pf = self.lib("private_files")
        try:
            pf.checked(path, self.pkg, what, retry=retry)
        except pf.Refused as exc:
            say(str(exc))
            return True
        return False

    # --- step 1 of each path: a settings file to fill in; a section of the deploy file in full ------------------
    def cmd_template_build(self, ns) -> int:
        """`template build FILE`, the build path's step 1 (template_file)."""
        return self.template_file("build", None, ns.file)

    def cmd_template_deploy(self, ns) -> int:
        """`template deploy [--profile PROFILE] FILE`, the deploy path's step 1 (template_file). A profile the deploy
        schema does not have is a usage error, which names the ones it has."""
        types = self.lib("file_types")
        names = [p.name for p in self.lib("settings_file").profiles(types.DEPLOY)]
        if ns.profile is not None and ns.profile not in names:
            err(
                f"{self.program} template deploy: no profile {ns.profile}; the profiles are {', '.join(names)}"
            )
            return 2
        return self.template_file("deploy", ns.profile, ns.file)

    def cmd_template_section(self, ns) -> int:
        """`template section [KEY]`: one section of the deploy file in full, or the list of sections
        (settings_templates.section_command)."""
        return self.lib("settings_templates").section_command(ns.key)

    def template_file(self, kind: str, profile, file: str) -> int:
        """Step 1 of the build path (KIND "build") or the deploy path ("deploy", with its PROFILE): the step's banner,
        then settings_templates.write, which writes the template as FILE, a new private file, or prints it alone, with
        no banner, for FILE `-`; on the deploy side, a refusal's next line and a dry run's are the deployment state's,
        and the one after WROTE names the check without its step once this folder's records keep a first tick
        (first_tick_recorded).
        Every line names FILE as settings_file.shown does (`~/…` in your home folder), your command again (a refusal's
        fix and, on the build side, its next line) included: a name from the folder you ran this in, and the home
        folder your shell wrote out in full, read as the lines after them name the file.
        """
        t, types, st = (
            self.lib("settings_templates"),
            self.lib("file_types"),
            self.lib("steps"),
        )
        template = t.Template(types.BUILD if kind == "build" else types.DEPLOY, profile)
        typed = list(self.typed)
        if file == "-":
            return t.write(template, file, [self.program, *typed], self.pkg)
        say(st.banner(st.PATHS[kind][0], self.dry == 1))
        shown = self.lib("settings_file").shown(self.abspath(file))
        typed[len(typed) - 1 - typed[::-1].index(file)] = shown
        deploy = kind == "deploy"
        return t.write(
            template,
            shown,
            [self.program, *typed],
            self.pkg,
            next_line=self.state_next_line() if deploy else None,
            dry_run=self.dry == 1,
            plain=deploy and self.first_tick_recorded(),
        )

    # --- step 2 of each path, the check ---------------------------------------------------------------------------
    def settings_file_checks(self, file: str, retry) -> list:
        """The deploy settings file's checks as a private file (private_files.problems; RETRY names another file in a
        fix). Its header, its layout and its keys are the reader's (settings_cfg)."""
        return self.lib("private_files").problems(
            file, self.pkg, "your settings file", retry=retry
        )

    def cmd_check(self, ns) -> int:
        """`check [--settings FILE]`: this machine and a settings file, each check a row with its fix, read-only but for
        check 6's lines, which it adds to a deploy settings file on your yes at its question (offer_lines). A
        build settings file gets the build path's checks, then the build's parameters; any other file, or none named
        (the deploy settings file this deployment recorded), the deploy path's. PASSED, exit 0; FAILED, exit 4, or 3
        when docker (its compose for a deploy settings file, its buildx for a build settings file) is missing, or no
        settings file is named.
        """
        file = ns.settings
        if file and self.lib("deployment").settings_kind(self.abspath(file)) == "build":
            return self.check_build(file)
        return self.check_deploy(file or "")

    def check_outcome(
        self,
        checks: list,
        earlier_step: bool,
        rows: str = "all",
        unchanged: str = "nothing changed",
        between=None,
    ) -> int:
        """The check rows (ROWS: "all", or "problems", the WARN and FAIL rows only), then their outcome: PASSED, or
        FAILED with what the failure left as it was (UNCHANGED) and the command again as you typed it (EARLIER_STEP: a
        prerequisite, an earlier step, is missing). BETWEEN, a question asked between the two, gives the rows for what
        its answer changed (offer_lines), whose outcome it then is, the change said by the question, or None. Its exit
        code."""
        ck, out = self.lib("checks"), self.lib("outcome")
        shown = ck.render(checks, rows)
        if shown:
            say(shown)
            say("")
        changed = between() if between is not None else None
        if changed is not None:
            checks, unchanged = changed, "nothing else changed"
        word, text = out.tally(checks, unchanged)
        if word == "PASSED":
            return out.finish(word, text)
        return out.finish(word, text, next=self.again_line(), earlier_step=earlier_step)

    @staticmethod
    def missing(checks: list, *names: str) -> bool:
        """A row of NAMES, a prerequisite, failed."""
        return any(c.name in names and c.status == "FAIL" for c in checks)

    def check_build(self, file: str) -> int:
        """The build path's step 2, the check of FILE, a build settings file (as you typed it): its rows and outcome,
        then the build's parameters (build_plan.parameter_lines) and the build as the next step. What only the network
        gives is read (resolved) whenever the file can be read, so that its rows are there beside the file's own.
        """
        st = self.lib("steps")
        p, file, file_checks, rc = self.build_file(file)
        if rc:
            return rc
        say(st.banner(st.BUILD_STEPS[1]))
        p = self.resolved(p)
        checks = self.build_checks_of(p, file_checks, file)
        rc = self.check_outcome(checks, self.missing(checks, "docker", "docker buildx"))
        if rc:
            return rc
        say("The build's parameters:")
        for line in self.lib("build_plan").parameter_lines(p):
            say(line)
        self.say_next(st.next_line(st.BUILD_STEPS[2], FILE=file))
        return 0

    def build_checks_of(self, p, file_checks: list, file: str) -> list:
        """The build path's check rows of FILE, a build settings file as the lines name it (build_file): FILE_CHECKS,
        the file's own, then this machine's, and those of P, the build plan the file makes, resolved (None when the
        file cannot be read, which is then not read further, nor this network's TLS asked; whether its image is on
        this machine already is asked only when the file's own rows pass), then the package folder's
        (deployment.stray_rows). Read-only.
        """
        d, ck = self.lib("deployment"), self.lib("checks")
        ref = p.image.ref if p is not None and not ck.failed(file_checks) else ""
        facts = self.facts(None, list(p.ca_files) if p is not None else None, ref=ref)
        return d.build_checks(p, facts, file_checks, file) + d.stray_rows(
            self.pkg, self.again_command()
        )

    def check_deploy(self, file: str) -> int:
        """The deploy path's step 2, the check of FILE, as you typed it ("": the deploy settings file this deployment
        recorded): its rows and outcome, then the confirm as the next step, without its step once this folder's
        records keep a first tick (first_tick_recorded)."""
        st = self.lib("steps")
        retry = self.again(file)
        file = self.abspath(file) if file else self.recorded()
        say(st.banner(st.DEPLOY_STEPS[1], self.dry == 1))
        checks = self.deploy_checks(file, retry)
        rc = self.check_outcome(
            checks,
            not file or self.missing(checks, "docker", "docker compose"),
            between=lambda: self.offer_lines(file, retry, checks),
        )
        if rc:
            return rc
        shown = self.lib("settings_file").shown(file)
        self.say_next(
            st.next_line(
                st.DEPLOY_STEPS[2], FILE=shown, plain=self.first_tick_recorded()
            )
        )
        return 0

    def deploy_checks(self, file: str, retry) -> list:
        """The deploy path's check rows of FILE, a deploy settings file's full path ("": none named), asked read-only:
        the file and its settings, the team's skills folder they name once the file's own rows pass (skills_rows), the
        package folder, this host (deployment.preflight), with the container's share of it once the file's own rows
        pass (resources_rows), and the logins while this folder's container exists (deployed) and its image is here.
        RETRY names another file in a fix.
        """
        d, ck, st = self.lib("deployment"), self.lib("checks"), self.lib("steps")
        cfg, checks = None, []
        if not file:
            checks.append(
                ck.Check(
                    "your settings file",
                    ck.Status.FAIL,
                    "none named",
                    ck.Steps(
                        (
                            st.command_line("check --settings FILE"),
                            ", FILE being your deploy settings file (",
                            st.command_line("template deploy FILE"),
                            "writes one to start from)",
                        )
                    ),
                )
            )
        else:
            checks += self.settings_file_checks(file, retry)
            if os.path.isfile(file):
                cfg = self.settings_cfg(file)[0]
                checks += self.problems
                if cfg is not None and not ck.failed(self.problems):
                    checks += self.skills_rows(file)
        checks += d.stray_rows(self.pkg, self.again_command())
        # the ports the file makes are known once its own rows pass, and so is the container's share of this host
        known = cfg is not None and not ck.failed(self.problems)
        f = self.facts(cfg, variables=self.settings_variables(file) if known else None)
        share = self.resources_rows(file, f.host_gb, f.host_cpus) if known else []
        checks = d.preflight(
            cfg, f, checks, file or self.lib("deploy_tree").FILE, share
        )
        # The logins (step 5 sets them), as this folder's container reads them, while it exists and its image is here:
        # before the first start, a one-off container would make the deployment's network and volumes.
        if (
            cfg is not None
            and f.docker
            and self.deployed() is not None
            and self.image_labels(self.image_ref()) is not None
        ):
            rows = self.logins_rows()
            if rows is not None:
                unset = self.lib("confirm").UNSET
                left = [r["name"] for r in rows if r["state"] in unset]
                checks.append(
                    ck.Check(
                        "logins",
                        ck.Status.WARN if left else ck.Status.PASS,
                        (
                            ("to do: " + ", ".join(left))
                            if left
                            else "every login your settings need is in"
                        ),
                        st.command_line(st.DEPLOY_STEPS[4].command) if left else None,
                    )
                )
        if known and f.docker:  # check 6's read, through the writer
            checks += self.ticket_rows(cfg, file)
        return checks

    def skills_rows(self, file: str) -> list:
        """Check 18 of FILE, the full path of a deploy settings file the reader takes: the team's skills folder
        it names, on this host, against this package folder (coherence.skills). Read-only.
        """
        doc = self.lib("settings_file").read(file, self.lib("file_types").DEPLOY)
        return self.lib("coherence").skills(doc, self.pkg)

    def resources_rows(self, file: str, host_gb: float, host_cpus: int) -> list:
        """Checks 8 and 9 of FILE, the full path of a deploy settings file the reader takes: the container's share
        of this host, which has HOST_GB GiB of memory and HOST_CPUS CPUs (coherence.resources), as rkmon check judges
        it (rkmon confirm's are deployment.confirm_rows'). Read-only.
        """
        doc = self.lib("settings_file").read(file, self.lib("file_types").DEPLOY)
        return self.lib("coherence").resources(doc, host_gb, host_cpus)

