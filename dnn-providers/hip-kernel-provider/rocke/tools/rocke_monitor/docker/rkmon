def quote(word: str) -> str:
    """One word, quoted for a shell when it needs it ('' for an empty one, '\\'' for a quote inside)."""
    if word == "":
        return "''"
    if SAFE.fullmatch(word):
        return word
    return "'" + word.replace("'", "'\\''").rstrip("\n") + "'"


def err(text: str) -> None:
    sys.stdout.flush()
    sys.stderr.write(text + "\n")
    sys.stderr.flush()


def say(text: str) -> None:
    sys.stdout.write(text + "\n")
    sys.stdout.flush()


def typed_without_echo(prompt: str) -> str:
    """What is typed at PROMPT on the terminal, without echo (getpass); "" for nothing typed or an end of input. Ctrl-C
    ends the command as at any other question, by the signal (exit 130; main), once getpass has given the
    terminal its echo back. What follows starts on a line of its own."""
    before, stopped = signal.signal(signal.SIGINT, signal.default_int_handler), False
    try:
        return getpass.getpass(prompt)
    except EOFError:
        pass
    except KeyboardInterrupt:
        stopped = True
    finally:
        signal.signal(signal.SIGINT, before)
    sys.stderr.write("\n")
    sys.stderr.flush()
    if stopped:
        signal.signal(signal.SIGINT, signal.SIG_DFL)
        signal.raise_signal(signal.SIGINT)
    return ""


def ctrl_c_interrupts() -> None:
    """From here on, Ctrl-C raises KeyboardInterrupt, which the change under way catches to end with INTERRUPTED and say
    where it stopped. Before a command's change, Ctrl-C ends it by the signal (main).
    """
    signal.signal(signal.SIGINT, signal.default_int_handler)


def ctrl_c_ends() -> None:
    """From here on, Ctrl-C ends the command by the signal (exit 130 in the shell), with no traceback, as before its
    change (main): once the change has ended, or Ctrl-C has stopped it, what is left is to say its outcome.
    """
    signal.signal(signal.SIGINT, signal.SIG_DFL)


@contextlib.contextmanager
def ctrl_c_waits():
    """What runs inside it runs to its end whatever Ctrl-C does: a Ctrl-C meanwhile is said to wait, and is taken once
    it has ended, as SIGINT's handler before it takes it: KeyboardInterrupt after ctrl_c_interrupts, the end by the
    signal after ctrl_c_ends. A second one ends this command by the signal at once. Inside another one it adds nothing,
    so that all of the outer one runs first: apply's code-install and the record that says what went in
    (Wrapper.install_code)."""
    if getattr(signal.getsignal(signal.SIGINT), "waits", False):
        yield
        return
    pressed = []

    def wait(signum, frame):
        if pressed:
            signal.signal(signal.SIGINT, signal.SIG_DFL)
            signal.raise_signal(signal.SIGINT)
        pressed.append(signum)
        err("Ctrl-C: the command above runs to its end first")

    wait.waits = True
    before = signal.signal(signal.SIGINT, wait)
    try:
        yield
    finally:
        signal.signal(signal.SIGINT, before)
        if pressed:
            signal.raise_signal(signal.SIGINT)


def run_whole(argv: list, **kw) -> subprocess.CompletedProcess:
    """ARGV run to its end whatever Ctrl-C does (subprocess.run with KW; its input none unless KW gives one), in a
    session of its own, so that the terminal's Ctrl-C does not reach it, and in ctrl_c_waits, which takes a Ctrl-C
    meanwhile once ARGV has ended: for a step that an interrupt must not cut in two, such as stop --drain's rk stop,
    which goes on in the container when docker's client is stopped. A second Ctrl-C ends this command by the signal at
    once, ARGV going on to its end."""
    if kw.get("input") is None:
        kw.pop("input", None)
        kw.setdefault("stdin", subprocess.DEVNULL)
    with ctrl_c_waits():
        return subprocess.run(argv, start_new_session=True, **kw)


def piped(argv: list, each, env=None, merged: bool = True) -> int:
    """ARGV run with its output through a pipe, and its errors too while MERGED (else they go on to yours as they
    come), each line handed to EACH as it comes, without its newline, ENV its environment (None: this process's):
    its exit code; 127, why handed to EACH, when it does not start. A Ctrl-C meanwhile (KeyboardInterrupt) kills it
    on its way to the caller."""
    sys.stdout.flush()
    sys.stderr.flush()
    try:
        p = subprocess.Popen(
            argv,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT if merged else None,
            text=True,
            errors="replace",
            env=env,
        )
    except OSError as exc:
        each(str(exc))
        return 127
    try:
        for line in iter(p.stdout.readline, ""):
            each(line.rstrip("\n"))
        return p.wait()
    finally:
        if p.poll() is None:
            p.kill()
            p.wait()


def streamed(argv: list, env=None) -> tuple:
    """ARGV run with its output through a pipe (piped), each line said as it comes and kept, its errors going on to
    yours as they come, ENV its environment (None: this process's): (its exit code, what it said).
    """
    said = []

    def each(line: str) -> None:
        say(line)
        said.append(line + "\n")

    return piped(argv, each, env=env, merged=False), "".join(said)


def relayed(argv: list, env=None) -> tuple:
    """ARGV run on a terminal of its own, as large as yours as it starts, which this process relays both ways, ENV its
    environment (None: this process's), with your input and output terminals (Wrapper.compose runs it only then,
    interactive): what you type goes to it as you type it, your terminal raw meanwhile, so a Ctrl-C goes to it as on
    yours (docker's -it takes it on to the container's terminal); what it says comes to yours as it
    says it, and is kept: (its exit code, what it said, each line ended by a newline alone); 127, why said, when it
    does not start. A Ctrl-C that reaches this process meanwhile (KeyboardInterrupt) ends it on its way to the caller,
    your terminal set back as it was."""
    sys.stdout.flush()
    sys.stderr.flush()
    try:
        size = fcntl.ioctl(1, termios.TIOCGWINSZ, bytes(8))
    except OSError:
        size = None
    try:
        pid, fd = pty.fork()
    except OSError as exc:
        say(str(exc))
        return 127, f"{exc}\n"
    if pid == 0:  # the child, on its terminal: as large as yours, then ARGV
        try:
            if size:
                fcntl.ioctl(1, termios.TIOCSWINSZ, size)
            os.execvpe(argv[0], argv, os.environ if env is None else env)
        except OSError as exc:
            os.write(2, f"{argv[0]}: {exc.strerror or exc}\n".encode())
        finally:
            os._exit(127)  # never back into rkmon's own code
    kept, status, mode = [], None, None

    def write_all(to: int, data: bytes) -> None:
        while data:
            data = data[os.write(to, data) :]

    try:
        mode = termios.tcgetattr(0)
        setraw(0)
        while True:
            ready = select.select([fd, 0], [], [])[0]
            if fd in ready:
                try:
                    data = os.read(fd, 4096)
                except OSError:
                    data = b""  # its terminal closed (Linux says so by EIO): it is done
                if not data:
                    break
                kept.append(data)
                write_all(1, data)
            if 0 in ready:
                write_all(fd, os.read(0, 4096))
        status = os.waitpid(pid, 0)[1]
    finally:
        if mode is not None:
            termios.tcsetattr(0, termios.TCSAFLUSH, mode)
        os.close(fd)
        if status is None:  # stopped short: it ends too
            with contextlib.suppress(OSError):
                os.kill(pid, signal.SIGKILL)
            os.waitpid(pid, 0)
    text = b"".join(kept).decode("utf-8", "replace").replace("\r\n", "\n")
    return os.waitstatus_to_exitcode(status), text


def logical_pwd() -> str:
    """The folder as `pwd` names it: $PWD when it is this folder, else the physical path."""
    pwd = os.environ.get("PWD", "")
    try:
        if (
            pwd.startswith("/")
            and "/./" not in pwd + "/"
            and "/../" not in pwd + "/"
            and os.path.samefile(pwd, ".")
        ):
            return pwd
    except OSError:
        pass
    return os.getcwd()


def drop_shell_variables(environ) -> None:
    """Take your shell's variables SHELL_DROPPED names out of ENVIRON, this process's environment, which every command
    rkmon runs gets: all but SHELL_KEPT's."""
    for name in [
        n for n in environ if n.startswith(SHELL_DROPPED) and n not in SHELL_KEPT
    ]:
        del environ[name]


def parse_time(text: str):
    """A docker or rk timestamp (2026-01-01T00:00:00[.fraction]Z) as an aware datetime, None when it is not one."""
    m = re.match(r"(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)", text or "")
    if not m:
        return None
    return datetime.datetime.strptime(m.group(1), "%Y-%m-%dT%H:%M:%S").replace(
        tzinfo=datetime.timezone.utc
    )


def first_json(text: str, opener: str):
    """The JSON value an rk command printed in a container (TEXT, its output), from the first OPENER of it ("{" or
    "["), whatever docker printed after it; None when there is none."""
    start = (text or "").find(opener)
    if start < 0:
        return None
    try:
        return json.JSONDecoder().raw_decode(text[start:])[0]
    except ValueError:
        return None


def volume_name(project: str, key: str, declared) -> str:
    """The name on this host of the volume KEY that docker compose config declares in the compose project PROJECT,
    DECLARED its declaration: its `name`, else PROJECT_KEY, as docker compose names it.
    """
    if isinstance(declared, dict) and declared.get("name"):
        return str(declared["name"])
    return f"{project}_{key}"


class Stopped(Exception):
    """A command that stopped before it acted, its outcome printed: main() returns its `code`."""

    def __init__(self, code: int):
        super().__init__(code)
        self.code = code


class NoAnswer(Exception):
    """A running container's answer to a question the state table reads that is no answer: `code`, its exit code;
    `lines`, what rk or docker said; `unknown`, what it leaves unknown (UNANSWERED by default, the monitor's answer to
    `rk applied --json`; UNSAID_SET_UP, its answer to `rk provision --check`); `asked`, the command its words name
    ("" for one not for you). Exit 4 with a REFUSED line is rk's refusal (`refused`): what rk reads cannot be
    read (its applied record, its internal state), and its lines say why, then the fix (rkmon_lib/applied.py); `why()`
    says any other answer in short. Never taken for an empty record, nor for a volume set up or not: main() says it,
    and so does rkmon status.
    """

    def __init__(
        self,
        code: int,
        said: str,
        unknown: str = UNANSWERED,
        asked: str = "rk applied --json",
    ):
        super().__init__(code)
        self.code, self.unknown, self.asked = code, unknown, asked
        self.lines = [x for x in said.strip().splitlines() if x.strip()]
        self.refused = (
            code == 4 and bool(self.lines) and self.lines[0].startswith("REFUSED: ")
        )

    def why(self) -> str:
        """The exit code, with the command asked when it is one for you, and the last thing rk or docker said."""
        said = self.lines[-1][:200] if self.lines else "no answer"
        exited = (
            f"{self.asked} exited {self.code}"
            if self.asked
            else f"exit code {self.code}"
        )
        return f"{exited}: {said}"


def older_rk(code: int, said: str) -> bool:
    """Whether CODE and SAID, the exit code and the output of an rk command in the container, are an older package's
    rk's answer to a command it does not have: a usage error, exit 2, that calls the command an invalid choice.
    """
    return code == 2 and "invalid choice" in said


class DockerAnswers:
    """docker's answers about this folder's deployment, as rkmon_lib/state_facts.py asks them (its DOCKER), through
    WRAPPER, each read-only and not printed, of this folder's own container only (Wrapper.only_ours); none makes a
    Docker object before the first start. ASK False asks no container, running or one-off (while there is no container,
    a one-off would make the volumes): no login reads as missing, and there is no container. What it learns besides, for
    rkmon next and status: whether the logins were read (`logins_read`), the container's status once asked (`status`:
    states.NO_CONTAINER, STOPPED or RUNNING; None until then), and when the running container started (`started`, None
    while it does not run). Each rk question in the container is asked once (inside).
    """

    def __init__(self, wrapper, ask: bool = True):
        self.w, self.ask = wrapper, ask
        self.logins_read, self.status, self.started = False, None, None
        self.said = {}  # rk's answers in the container, by their words (inside)

    def inside(self, *words: str) -> tuple:
        """rk's answer to WORDS in the container (Wrapper.quiet_inside), asked once: whether the running container runs
        an older package's code (runs_older) and what it runs (monitor) share `rk applied --json`'s.
        """
        if words not in self.said:
            self.said[words] = self.w.quiet_inside(*words)
        return self.said[words]

    def runs_older(self) -> bool:
        """Whether this folder's container runs, and runs an older package's code (Wrapper.runs_older_code)."""
        return self.w.running() and self.w.runs_older_code(self.inside)

    def owner(self, project: str) -> str:
        return self.w.whose(project)

    def image_here(self, image: str) -> bool:
        return self.w.image_labels(image) is not None

    def logins_missing(self, image: str) -> tuple:
        """The logins and secrets the confirmed settings need that are missing or wrong (state 7): while this folder's
        container exists (Wrapper.deployed), those the login walk's list, which deploy step 5 shows, gives as such
        (confirm.walk_list, confirm.UNSET: what needs each one read from the confirmed settings, here on the host, and
        its state from `rk logins --json` in the container, running, else in a one-off of the deployment's image:
        Wrapper.compose_env; while the running container runs an older package's code, whose rk lists that package's
        logins (runs_older), in the walk's one-off, as step 5 reads it: Wrapper.walk_inside, and none while your
        confirmed settings cannot be read); before, those the volumes that keep them do not hold, every one while there
        is no such volume yet, read with no Docker object made (Wrapper.logins_unset).
        """
        if not self.ask:
            return ()
        if self.w.deployed() is None:
            unset = self.w.logins_unset(image)
            self.logins_read = unset is not None
            return unset or ()
        walk = self.runs_older()
        if walk and self.w.confirmed_plan() is None:
            return ()
        rows = self.w.logins_rows(walk=walk)
        self.logins_read = rows is not None
        if rows is None:
            return ()
        c = self.w.lib("confirm")
        listed = c.walk_list(self.w.confirmed_values(), rows)
        return tuple(r["name"] for r in listed if r["state"] in c.UNSET)

    def set_up(self, project: str) -> bool:
        """Whether the running container's work volume is set up, as `rk provision --check` in it says: exit 0, set
        up; 1, not yet: it was started some other way than rkmon start, and waits for its first start; an older
        package's rk, which lacks that command (older_rk), set up by its own start (a package update not applied yet).
        Any other answer: NoAnswer (UNSAID_SET_UP)."""
        if not self.ask:
            return True
        rc, out = self.w.quiet_inside("rk", "provision", "--check")
        if rc == 1:
            return False
        if rc == 0 or older_rk(rc, out):
            return True
        raise NoAnswer(rc, out, UNSAID_SET_UP, asked="")

    def container(self, project: str) -> tuple:
        """A stop that rk stop left in a running container reads as stopped: rkmon start clears it."""
        st = self.w.lib("states")
        if not self.ask:
            return st.NO_CONTAINER, None
        if self.w.running():
            self.started = self.w.container_started()
            stopped = self.w.quiet_inside("rk", "stopped")[0] == 0
            self.status = st.STOPPED if stopped else st.RUNNING
        else:
            self.status = st.STOPPED if self.w.made() else st.NO_CONTAINER
        return self.status, (self.started if self.status == st.RUNNING else None)

    def layer(self, project: str):
        return self.w.delivered_layer()

    def monitor(self, project: str):
        return self.w.monitor_answer(self.inside)


