    def summary_inputs(self, ref: str) -> tuple:
        """(the labels of the image REF, the one the settings name, or None when it is not here; the logins' rows as
        this folder's container reads them, or None: while it does not exist (deployed), for before the first start a
        one-off container would make the deployment's network and volumes, and the summary's logins then come from
        the settings alone (confirm.login_rows); while either image is not here; and under --dry-run, which makes no
        one-off container) for the confirm step's summary. Read-only."""
        labels = self.image_labels(ref)
        rows = None
        if (
            self.dry != 1
            and labels is not None
            and self.deployed() is not None
            and self.image_labels(self.image_ref()) is not None
        ):
            rows = self.logins_rows()
        return labels, rows

    def recipe_changes(self, ref: str) -> tuple:
        """The image REF's own copies of the files an image keeps whatever release runs (code_volume.IMAGE_BOUND), by
        the fingerprints a one-off container of it with no network prints (confirm.CODE_PROBE): (the files whose copies
        are not this package's, confirm.changed_copies, ""), or (None, why its copies could not be read). Read-only.
        """
        c, volume = self.lib("confirm"), self.lib("code_volume")
        rc, answer = self.ask_docker(
            "run",
            "--rm",
            "--network",
            "none",
            *self.lib("container_layout").RUN_LIMITS,
            "--entrypoint",
            "python3",
            ref,
            "-I",
            "-c",
            c.CODE_PROBE,
            self.lib("container_layout").IMAGE_CODE,
            *volume.IMAGE_BOUND,
            timeout=120,
        )
        if rc != 0:
            lines = answer.strip().splitlines()
            return None, lines[-1] if lines else f"docker exited {rc}"
        try:
            return c.changed_copies(answer, self.pkg), ""
        except ValueError as exc:
            return None, str(exc)

    def deployment_network(self, project: str) -> str:
        """The docker network the container of the compose project PROJECT runs on, PROJECT_default, which docker
        compose makes at the project's first one-off container or start (rkmon remove removes it), while docker has it
        for that project and the container name is this folder's or no one's; "" while not. Read-only.
        """
        ident = self.lib("identity")
        if self.whose(project) not in (ident.OURS, ident.NONE):
            return ""
        name = f"{project}_default"
        rc, out = self.ask_docker(
            "network",
            "inspect",
            "--format",
            '{{index .Labels "com.docker.compose.project"}}',
            name,
            timeout=30,
        )
        return name if rc == 0 and out.strip() == project else ""

    def model_answers(self, ref: str, network: str, urls: list) -> dict:
        """Whether each model address of URLS answers a one-off container of the image REF on the docker network
        NETWORK, as the container will call it (confirm.MODEL_PROBE): each address -> "" when it answered, else why
        not (confirm.model_answers). The one-off container mounts nothing and reads no secret.
        """
        c = self.lib("confirm")
        if not urls:
            return {}
        rc, out = self.ask_docker(
            "run",
            "--rm",
            "--network",
            network,
            *self.lib("container_layout").RUN_LIMITS,
            "--entrypoint",
            "python3",
            ref,
            "-I",
            "-c",
            c.MODEL_PROBE,
            str(c.REACH_TIMEOUT_S),
            *urls,
            timeout=c.REACH_TIMEOUT_S * len(urls) + 60,
        )
        return c.model_answers(rc, out, urls)

    def made_image(self, made):
