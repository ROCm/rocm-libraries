"""The fake Slurm's sinfo (tests/fakes/gpu/slurm.py)."""

import os
import sys

slurm = os.path.join(os.path.dirname(sys.argv[0]), "..", "slurm.py")
os.execv(sys.executable, [sys.executable, slurm, "sinfo", *sys.argv[1:]])
