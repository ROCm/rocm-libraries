{
  "about": "Three deploy settings files in layout 1 (samples; the header's two keys left out), with the values a sample sets on its file once rkmon migrate has written it in layout 2, which migrate cannot write (set_after_migrate: layout 1 had no mode for alerts, the team dashboard or ticket creation, which sent whenever they were on); and the configuration (config.json) the layout 1 carry made: its defaults, and each sample's keys laid over them (layout_1_config). tests/test_deploy_tree.py migrates each file as rkmon migrate does (rkmon_lib/migrate.py, whose step from layout 1 is rkmon_lib/from_layout1.py), sets set_after_migrate on the file it writes, and checks that rkmon_lib/deploy_tree.py makes the same configuration from it, but for the differences tests/data/deploy_tree_differences.json lists.",
  "samples": {
    "full": {
      "layout_1": {
        "container": {
          "name": "acme-monitor",
          "image": {
            "name": "acme-rkmon",
            "tag": "2.0.1",
            "pull_registry": "registry.example.com/team"
          }
        },
        "repository": {
          "name": "example-org/example-repo",
          "path": "projects/sample",
          "scope_labels": [
            "team: sample",
            "area: tools"
          ],
          "path_labels": [
            "shared: ci"
          ]
        },
        "host": {
          "resources": {
            "cpus": 8,
            "memory_gb": 20,
            "ramdisk_gb": 12
          },
          "users": {
            "monitor_uid": 1234,
            "monitor_gid": 1235,
            "github_writer_uid": 2999,
            "pr_runner_uid": 2998
          },
          "mounts": [
            "/srv/sample-data:/data:ro"
          ]
        },
        "monitor": {
          "tick_min": 7,
          "full_tick_min": 45,
          "orchestrator": {
            "model": "sonnet",
            "effort": "xhigh"
          }
        },
        "features": {
          "review_automation": {
            "enabled": true,
            "mode": "live",
            "schedule": {
              "push_cooldown_min": 20,
              "follow_up_cooldown_min": 90
            },
            "capacity": {
              "parallel_reviews": 5,
              "parallel_heavy_checks": 2
            },
            "large_prs": {
              "manual_review_over_lines": 20000,
              "split_part_lines": 6000
            },
            "passes": {
              "verify": {
                "model": "sonnet",
                "effort": "max"
              },
              "quality": {
                "model": "custom-claude",
                "effort": "low"
              },
              "first_pass": {
                "model": "worker",
                "effort": "default"
              },
              "ci_triage": {
                "model": "drafter",
                "effort": "default"
              },
              "quality_draft": {
                "model": "haiku",
                "effort": "low"
              },
              "notice_draft": {
                "model": "default",
                "effort": "default"
              }
            }
          },
          "merge_queue": {
            "enabled": true,
            "mode": "live",
            "auto_merge": "enabled",
            "auto_hold": false,
            "develop_guard": true
          },
          "dashboards": {
            "admin": {
              "enabled": true,
              "port": 18700,
              "bind": "127.0.0.1"
            },
            "team": {
              "enabled": true,
              "delivery": "publish"
            }
          },
          "alerts": {
            "enabled": true,
            "teams_channel": "team-alerts",
            "message_cooldown_min": 15
          },
          "ticket_creation": {
            "enabled": true,
            "jira_project": "SAMPLE",
            "default_epic": "",
            "triggers": {
              "review_follow_up": true,
              "out_of_scope_issue": false
            }
          }
        },
        "integrations": {
          "github_cli": {
            "account": "sample-bot"
          },
          "atlassian_cli": {
            "jira_site": "https://jira.example.com",
            "confluence_site": "https://wiki.example.com"
          },
          "claude_code": {
            "gateway": "https://llm-gateway.example.com"
          }
        },
        "model_bindings": {
          "worker": {
            "provider": "ollama",
            "model_id": "sample-model:7b",
            "endpoint": "http://ollama.example.com:11434",
            "limits": {
              "max_parallel": 2
            }
          },
          "drafter": {
            "provider": "openai-compatible",
            "model_id": "drafter-7b",
            "endpoint": "https://llm.example.com/v1",
            "api_key_secret": "drafter_api_key",
            "limits": {
              "requests_per_min": 60,
              "tokens_per_min": 100000,
              "max_parallel": 4,
              "timeout_min": 5
            }
          },
          "custom-claude": {
            "provider": "claude",
            "model_id": "claude-opus-custom"
          }
        },
        "advanced": {
          "update": {
            "repo": "https://github.com/ROCm/example-monitor",
            "branch": "main"
          },
          "automerge_guard_own": true,
          "weekly_report": {
            "enabled": true
          },
          "incident_issue": {
            "repo": "example-org/example-issues",
            "labels": [
              "ci-red",
              "develop-break"
            ],
            "stability_label": "stability"
          },
          "publish": {
            "html": {
              "host": "web.example.com",
              "user": "sample-web",
              "url": "http://web.example.com:8080/",
              "site": "public_html/sample",
              "dest": "public_html/sample/index.html",
              "requests": "sample-requests.jsonl"
            }
          },
          "jira": {
            "issue_type": "Story",
            "component": "Tools, CI",
            "labels": [
              "rkmon"
            ],
            "extra_fields": {
              "customfield_100": "sample"
            }
          },
          "prices": {
            "claude-sonnet-5-5": {
              "in": 3,
              "out": 15,
              "cache_read": 0.3,
              "cache_write_5m": 3.75,
              "cache_write_1h": 6
            }
          },
          "gpu": {
            "enabled": true,
            "login_host": "gpu-login.example.com",
            "ssh_port": 2222,
            "ssh_user": "svc-sample",
            "partition": "gpu",
            "accounts": [
              "acct-a"
            ],
            "constraint": "fast",
            "gres": {
              "gfx90a": "type-a"
            },
            "default_arch": "gfx90a",
            "exclude": [
              "node-9"
            ],
            "time_limit": "02:00:00",
            "remote_dir": "rk-sample",
            "remote_python": "/usr/bin/python3",
            "setup": "module load sample",
            "env": {
              "SAMPLE_FLAG": "1"
            },
            "clone_url": "https://git.example.com/example-org/example-repo.git",
            "max_jobs_per_pr": 3,
            "pending_report_min": 120,
            "resubmits": 2
          }
        }
      }
    },
