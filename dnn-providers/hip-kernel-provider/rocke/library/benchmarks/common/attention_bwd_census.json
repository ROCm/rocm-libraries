 "mask_semantics": {
  "none": "no mask",
  "causal_tl": "causal, top-left aligned (torch is_causal=True): key j allowed iff j <= i",
  "causal_br": "causal, bottom-right aligned: key j allowed iff j <= i + (s_kv - s_q)",
  "swa": "causal bottom-right + left window W: allowed iff 0 <= (i + s_kv - s_q) - j < W"
 },
 "weight_rule": "weight = 1.0 for primary entries (each public head config x seq len, its natural mask, bf16, BSHD); 0.5 for dtype / layout / mask variants of a primary shape; 0.25 for probe entries (batch-cliff probes, s_q != s_kv chunked shapes, equal-length bottom-right path probes); varlen entries 0.5. Weights are a heuristic prioritisation, NOT call-frequency data.",
