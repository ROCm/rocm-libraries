// The body of a saved ingestor plan. A 48-byte header precedes it; see IngestorPlanPayload.hpp.
// Regenerate ingestor_plan_generated.h after each edit, and keep it in the same commit.
// A minor format version adds only optional fields. Any other change is a major version.

namespace hip_kernel_provider.kernel_ingestor_engine.serialization.fb;

enum SourceKind : ubyte { UNSET = 0, EMBEDDED_SOURCE = 1, KPACK = 2, HSACO_FILE = 3, ROCKE_BUILDER = 4 }

struct Uuid { bytes: [ubyte:16]; }

table KernelArgument { kind: string (required); size: uint; offset: uint; name: string; }

table BoolValue      { value: bool; }
table Int64Value     { value: long; }
table DoubleValue    { value: double; }
table StringValue    { value: string (required); }
table Int64ListValue { values: [long] (required); }
union LaunchValueData { BoolValue, Int64Value, DoubleValue, StringValue, Int64ListValue }

table LaunchValue  { name: string (required); value: LaunchValueData; }
table DispatchData { dispatch_symbol: string (required); values: [LaunchValue] (required); }

table KernelImage {
  source_kind: SourceKind;
  symbol: string (required);
  target: string (required);
  sha256: string (required);
  // The kernel's argument list.
  signature: [KernelArgument] (required);
  code_object: [ubyte] (required, force_align: 16);
}

table ExecutionPlan {
  engine_name: string (required);
  kernel_descriptor_id: Uuid (required);
  workspace_bytes: ulong = null;
  runtime_pass_by_value_uids: [long] (required);
  dispatch_data: DispatchData (required);
  kernel_image: KernelImage (required);
  provider_version: string (required);
}

root_type ExecutionPlan;
file_identifier "HKSP";
