include_guard(GLOBAL)

# cmake-lint: disable=E1126
# cmake-lint has no form spec for file(CONFIGURE); it is valid CMake.

# ============================================================================
# miopen_write_shipped_models_header(OUTPUT <header> NAMESPACE <ns>)
# ============================================================================
# Writes <header> with `<ns>::MODELS`: one row per `.uhd.json` under descriptors/ -- the
# files the provider stages and installs -- holding its path relative to the provider
# directory, its top-level `id`, and `trained_against.selector_revision` ("" when absent).
# A unit test checks the models this source tree ships against it, and reads them here, at
# configure time, because the binary may run where no checkout exists (an installed or
# repackaged layout). An edit to a model, or a new one, reconfigures.
function(miopen_write_shipped_models_header)
    cmake_parse_arguments(PARSE_ARGV 0 _arg "" "OUTPUT;NAMESPACE" "")
    file(GLOB_RECURSE _models CONFIGURE_DEPENDS RELATIVE "${PROJECT_SOURCE_DIR}"
         "${PROJECT_SOURCE_DIR}/descriptors/*.uhd.json")
    list(SORT _models)

    set(_rows "")
    foreach(_model IN LISTS _models)
        # The calling directory's property: a function runs in its caller's directory.
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
                     "${PROJECT_SOURCE_DIR}/${_model}")
        file(READ "${PROJECT_SOURCE_DIR}/${_model}" _json)
        string(JSON _id ERROR_VARIABLE _error GET "${_json}" id)
        if(_error)
            message(FATAL_ERROR
                "miopen: shipped model ${_model} has no readable `id`: ${_error}")
        endif()
        string(JSON _revision ERROR_VARIABLE _error GET "${_json}" trained_against
               selector_revision)
        if(_error)
            set(_revision "")
        endif()
        foreach(_value _model _id _revision)
            string(REPLACE "\\" "\\\\" ${_value} "${${_value}}")
            string(REPLACE "\"" "\\\"" ${_value} "${${_value}}")
        endforeach()
        string(APPEND _rows "    Model{\"${_model}\", \"${_id}\", \"${_revision}\"},\n")
    endforeach()

    list(LENGTH _models _count)
    string(CONCAT _text
        "// Generated by ${CMAKE_CURRENT_LIST_FILE}. Do not edit.\n"
        "#pragma once\n\n"
        "#include <array>\n\n"
        "namespace ${_arg_NAMESPACE}\n{\n\n"
        "struct Model\n{\n    const char* path;\n    const char* id;\n    const char* revision;\n};\n\n"
        "inline constexpr std::array<Model, ${_count}> MODELS{{\n${_rows}}};\n\n"
        "} // namespace ${_arg_NAMESPACE}\n")
    # Rewritten only when content changes, so a no-op reconfigure recompiles nothing.
    file(CONFIGURE OUTPUT "${_arg_OUTPUT}" CONTENT "${_text}" @ONLY)
endfunction()
