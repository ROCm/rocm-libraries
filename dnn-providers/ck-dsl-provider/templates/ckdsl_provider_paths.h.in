#ifndef CK_DSL_PROVIDER_PATHS_H
#define CK_DSL_PROVIDER_PATHS_H

#include <string_view>

namespace ck_dsl_provider {

// Absolute path of the directory that *contains* the in-tree ck_dsl
// Python package (i.e. projects/composablekernel/python/). Baked in by
// CMake so the embedded interpreter can prepend it to sys.path before
// importing ck_dsl_provider.compile_service. See PREP_FINDINGS §P-4.
inline constexpr std::string_view kCkDslPythonPackagePath =
    "@CK_DSL_PYTHON_PACKAGE_PATH@";

// Absolute path of the directory that *contains* this provider's
// ck_dsl_provider Python package
// (i.e. dnn-providers/ck-dsl-provider/python/).
inline constexpr std::string_view kCkDslProviderPythonPackagePath =
    "@CK_DSL_PROVIDER_PYTHON_PACKAGE_PATH@";

// Absolute path of the in-tree LightGBM model the FMHA-forward scorer
// (SdpaScorer) loads, resolved at configure time
// (projects/composablekernel/dispatcher/heuristics/models/
//  fmha_fwd_gfx950/model_tflops.lgbm).
//
// NOTE: this points into the SOURCE tree for the POC -- the model is
// not installed beside the .so. A productised build would stage the
// model into the install tree and resolve a runtime-relative path.
inline constexpr std::string_view kCkDslFmhaFwdModelPath =
    "@CK_DSL_FMHA_FWD_MODEL_PATH@";

// Absolute path of the in-tree LightGBM model the implicit-GEMM
// conv-forward scorer (ConvImplicitGemmScorer) loads for bf16/gfx950,
// resolved at configure time
// (projects/composablekernel/dispatcher/heuristics/models/
//  grouped_conv_forward_2d3d_suffix_bf16_gfx950/model_tflops.lgbm).
inline constexpr std::string_view kCkDslGroupedConvFwdModelPath =
    "@CK_DSL_GROUPED_CONV_FWD_MODEL_PATH@";

// Absolute path of the in-tree LightGBM model the implicit-GEMM
// conv-forward scorer loads for fp16/gfx942, resolved at configure time
// (projects/composablekernel/dispatcher/heuristics/models/
//  grouped_conv_forward_fp16_gfx942/model_tflops.lgbm).
inline constexpr std::string_view kCkDslGroupedConvFwdFp16Gfx942ModelPath =
    "@CK_DSL_GROUPED_CONV_FWD_FP16_GFX942_MODEL_PATH@";

}  // namespace ck_dsl_provider

#endif  // CK_DSL_PROVIDER_PATHS_H
