#ifndef CK_DSL_PROVIDER_PATHS_H
#define CK_DSL_PROVIDER_PATHS_H

#include <string_view>

namespace ck_dsl_provider {

// Absolute path of the directory that *contains* the in-tree ck_dsl
// Python package (i.e. projects/composablekernel/python/). Baked in by
// CMake so the embedded interpreter can prepend it to sys.path before
// importing ck_dsl_provider.compile_service. See PREP_FINDINGS §P-4.
inline constexpr std::string_view kCkDslPythonPackagePath =
    "@CK_DSL_PYTHON_PACKAGE_PATH@";

// Absolute path of the directory that *contains* this provider's
// ck_dsl_provider Python package
// (i.e. dnn-providers/ck-dsl-provider/python/).
inline constexpr std::string_view kCkDslProviderPythonPackagePath =
    "@CK_DSL_PROVIDER_PYTHON_PACKAGE_PATH@";

}  // namespace ck_dsl_provider

#endif  // CK_DSL_PROVIDER_PATHS_H
