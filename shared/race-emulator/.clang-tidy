Checks: >
  -*,
  clang-analyzer-*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-misplaced-widening-cast,
  -bugprone-multi-level-implicit-pointer-conversion,
  -bugprone-throwing-static-initialization,
  readability-braces-around-statements,
  clang-diagnostic-documentation

# These exclusions may be worth re-enabling as the codebase matures.
# They are currently disabled to reduce noise from the emulator's
# register-width integer conversions and multi-parameter functions.

WarningsAsErrors: '*'

# -Wdocumentation makes clang warn on malformed doxygen comments (e.g. @param
# name mismatches, @return on void). ExtraArgs passes the flag to clang so it
# generates the diagnostic; clang-diagnostic-documentation (in the check list
# above) tells clang-tidy to surface it (the leading -* would otherwise
# suppress it). Both parts are needed.
ExtraArgs: ['-Wdocumentation']


# Only analyze project code, not system or third-party headers.
HeaderFilterRegex: 'src/|include/'
