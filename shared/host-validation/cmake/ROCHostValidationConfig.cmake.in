@PACKAGE_INIT@

if(@HOST_VALIDATION_PACKAGE_HAS_BLAS@)
    find_package(BLAS QUIET)
endif()
if(@HOST_VALIDATION_PACKAGE_HAS_OPENMP@)
    find_package(OpenMP QUIET COMPONENTS CXX)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ROCHostValidationTargets.cmake")

check_required_components(ROCHostValidation)
