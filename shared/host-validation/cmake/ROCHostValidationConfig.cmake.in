@PACKAGE_INIT@

# Installed component contract:
#
# Component      Imported target                         Component requirements
# Core           roc::host-validation-core               none
# Operations     roc::host-validation                    Core
# Tiled          roc::host-validation-tiled              Operations
# BLAS           roc::host-validation-blas               Operations
# MX             roc::host-validation-mx                 Core
# AMDGPULayout   roc::host-validation-amd-gpu-layout     none
#
# Component requirements are transitive. For example, requesting Tiled loads
# Operations and Core, while requesting BLAS loads Operations and Core. The
# *_TARGET and *_COMPONENT_DEPENDENCIES variables below expose this mapping to
# consumers that need to inspect it. BLAS also requires the BLAS package.
# Operations, MX, and AMDGPULayout require OpenMP CXX only when their installed
# targets were built with OpenMP support; Tiled and BLAS inherit the Operations
# requirement. A lookup without COMPONENTS preserves the historical behavior
# by loading every component present in the installation.

set(
    ROCHostValidation_SUPPORTED_COMPONENTS
    Core
    Operations
    Tiled
    BLAS
    MX
    AMDGPULayout
)

set(ROCHostValidation_Core_TARGET roc::host-validation-core)
set(ROCHostValidation_Core_COMPONENT_DEPENDENCIES)
set(ROCHostValidation_Core_AVAILABLE ON)

set(ROCHostValidation_Operations_TARGET roc::host-validation)
set(ROCHostValidation_Operations_COMPONENT_DEPENDENCIES Core)
set(ROCHostValidation_Operations_AVAILABLE ON)

set(ROCHostValidation_Tiled_TARGET roc::host-validation-tiled)
set(ROCHostValidation_Tiled_COMPONENT_DEPENDENCIES Operations)
set(ROCHostValidation_Tiled_AVAILABLE ON)

set(ROCHostValidation_BLAS_TARGET roc::host-validation-blas)
set(ROCHostValidation_BLAS_COMPONENT_DEPENDENCIES Operations)
set(ROCHostValidation_BLAS_AVAILABLE @HOST_VALIDATION_PACKAGE_HAS_BLAS@)

set(ROCHostValidation_MX_TARGET roc::host-validation-mx)
set(ROCHostValidation_MX_COMPONENT_DEPENDENCIES Core)
set(ROCHostValidation_MX_AVAILABLE ON)

set(
    ROCHostValidation_AMDGPULayout_TARGET
    roc::host-validation-amd-gpu-layout
)
set(ROCHostValidation_AMDGPULayout_COMPONENT_DEPENDENCIES)
set(ROCHostValidation_AMDGPULayout_AVAILABLE ON)

set(
    _ROCHostValidation_Core_targets_file
    ROCHostValidationCoreTargets.cmake
)
set(
    _ROCHostValidation_Operations_targets_file
    ROCHostValidationOperationsTargets.cmake
)
set(
    _ROCHostValidation_Tiled_targets_file
    ROCHostValidationTiledTargets.cmake
)
set(
    _ROCHostValidation_BLAS_targets_file
    ROCHostValidationBLASTargets.cmake
)
set(
    _ROCHostValidation_MX_targets_file
    ROCHostValidationMXTargets.cmake
)
set(
    _ROCHostValidation_AMDGPULayout_targets_file
    ROCHostValidationAMDGPULayoutTargets.cmake
)

set(_ROCHostValidation_Core_uses_openmp OFF)
set(
    _ROCHostValidation_Operations_uses_openmp
    @HOST_VALIDATION_PACKAGE_OPERATIONS_HAS_OPENMP@
)
set(_ROCHostValidation_Tiled_uses_openmp OFF)
set(_ROCHostValidation_BLAS_uses_openmp OFF)
set(
    _ROCHostValidation_MX_uses_openmp
    @HOST_VALIDATION_PACKAGE_MX_HAS_OPENMP@
)
set(
    _ROCHostValidation_AMDGPULayout_uses_openmp
    @HOST_VALIDATION_PACKAGE_AMD_GPU_LAYOUT_HAS_OPENMP@
)

foreach(_ROCHostValidation_component
        IN LISTS ROCHostValidation_SUPPORTED_COMPONENTS)
    set(ROCHostValidation_${_ROCHostValidation_component}_FOUND FALSE)
endforeach()
set(ROCHostValidation_FOUND TRUE)
unset(ROCHostValidation_NOT_FOUND_MESSAGE)

set(
    _ROCHostValidation_requested_components
    "${ROCHostValidation_FIND_COMPONENTS}"
)
set(_ROCHostValidation_legacy_all_components OFF)
if(NOT _ROCHostValidation_requested_components)
    set(_ROCHostValidation_legacy_all_components ON)
    set(
        _ROCHostValidation_requested_components
        Core
        Operations
        Tiled
        AMDGPULayout
    )
    if(ROCHostValidation_BLAS_AVAILABLE)
        list(APPEND _ROCHostValidation_requested_components BLAS)
    endif()
    if(ROCHostValidation_MX_AVAILABLE)
        list(APPEND _ROCHostValidation_requested_components MX)
    endif()
endif()
list(REMOVE_DUPLICATES _ROCHostValidation_requested_components)

set(_ROCHostValidation_errors)
set(_ROCHostValidation_supported_requests)
set(_ROCHostValidation_components_to_load)
foreach(_ROCHostValidation_component
        IN LISTS _ROCHostValidation_requested_components)
    if(NOT _ROCHostValidation_component
       IN_LIST ROCHostValidation_SUPPORTED_COMPONENTS)
        set(ROCHostValidation_${_ROCHostValidation_component}_FOUND FALSE)
        if(_ROCHostValidation_legacy_all_components
           OR ROCHostValidation_FIND_REQUIRED_${_ROCHostValidation_component})
            string(
                CONCAT
                _ROCHostValidation_unsupported_message
                "ROCHostValidation does not support component "
                "\"${_ROCHostValidation_component}\". Supported components: "
                "Core, Operations, Tiled, BLAS, MX, AMDGPULayout."
            )
            list(
                APPEND
                _ROCHostValidation_errors
                "${_ROCHostValidation_unsupported_message}"
            )
        endif()
        continue()
    endif()

    list(
        APPEND
        _ROCHostValidation_supported_requests
        "${_ROCHostValidation_component}"
    )
    set(
        _ROCHostValidation_available_variable
        "ROCHostValidation_${_ROCHostValidation_component}_AVAILABLE"
    )
    if(NOT "${${_ROCHostValidation_available_variable}}")
        if(_ROCHostValidation_component STREQUAL "BLAS")
            string(
                CONCAT
                _ROCHostValidation_reason_BLAS
                "this installation was built without "
                "HOST_VALIDATION_BUILD_BLAS_BACKEND"
            )
        else()
            set(
                _ROCHostValidation_reason_${_ROCHostValidation_component}
                "the component is not present in this installation"
            )
        endif()
        continue()
    endif()

    list(
        APPEND
        _ROCHostValidation_components_to_load
        "${_ROCHostValidation_component}"
    )
endforeach()

# Expand direct requirements into a transitive component closure.
set(_ROCHostValidation_closure_changed ON)
while(_ROCHostValidation_closure_changed)
    set(_ROCHostValidation_closure_changed OFF)
    set(
        _ROCHostValidation_current_closure
        "${_ROCHostValidation_components_to_load}"
    )
    foreach(_ROCHostValidation_component
            IN LISTS _ROCHostValidation_current_closure)
        set(
            _ROCHostValidation_dependencies_variable
            "ROCHostValidation_${_ROCHostValidation_component}_COMPONENT_DEPENDENCIES"
        )
        foreach(
            _ROCHostValidation_dependency
            IN LISTS ${_ROCHostValidation_dependencies_variable}
        )
            if(NOT _ROCHostValidation_dependency
               IN_LIST _ROCHostValidation_components_to_load)
                list(
                    APPEND
                    _ROCHostValidation_components_to_load
                    "${_ROCHostValidation_dependency}"
                )
                set(_ROCHostValidation_closure_changed ON)
            endif()
        endforeach()
    endforeach()
endwhile()

set(_ROCHostValidation_needs_blas OFF)
if("BLAS" IN_LIST _ROCHostValidation_components_to_load)
    set(_ROCHostValidation_needs_blas ON)
endif()

set(_ROCHostValidation_needs_openmp OFF)
foreach(_ROCHostValidation_component
        IN LISTS _ROCHostValidation_components_to_load)
    set(
        _ROCHostValidation_openmp_variable
        "_ROCHostValidation_${_ROCHostValidation_component}_uses_openmp"
    )
    if("${${_ROCHostValidation_openmp_variable}}")
        set(_ROCHostValidation_needs_openmp ON)
    endif()
endforeach()

set(_ROCHostValidation_blas_dependency_found ON)
if(_ROCHostValidation_needs_blas)
    find_package(BLAS QUIET)
    if(NOT BLAS_FOUND OR NOT TARGET BLAS::BLAS)
        set(_ROCHostValidation_blas_dependency_found OFF)
    endif()
endif()

set(_ROCHostValidation_openmp_dependency_found ON)
if(_ROCHostValidation_needs_openmp)
    find_package(OpenMP QUIET COMPONENTS CXX)
    if(NOT OpenMP_CXX_FOUND OR NOT TARGET OpenMP::OpenMP_CXX)
        set(_ROCHostValidation_openmp_dependency_found OFF)
    endif()
endif()

# Load targets in dependency order and retain a reason for every component that
# cannot be loaded. This makes failures deterministic even when more than one
# requested component is unavailable.
foreach(_ROCHostValidation_component
        Core
        Operations
        Tiled
        BLAS
        MX
        AMDGPULayout)
    if(NOT _ROCHostValidation_component
       IN_LIST _ROCHostValidation_components_to_load)
        continue()
    endif()

    set(_ROCHostValidation_component_reason)
    set(
        _ROCHostValidation_available_variable
        "ROCHostValidation_${_ROCHostValidation_component}_AVAILABLE"
    )
    if(NOT "${${_ROCHostValidation_available_variable}}")
        set(
            _ROCHostValidation_component_reason
            "${_ROCHostValidation_reason_${_ROCHostValidation_component}}"
        )
    endif()

    set(
        _ROCHostValidation_dependencies_variable
        "ROCHostValidation_${_ROCHostValidation_component}_COMPONENT_DEPENDENCIES"
    )
    if(NOT _ROCHostValidation_component_reason)
        foreach(
            _ROCHostValidation_dependency
            IN LISTS ${_ROCHostValidation_dependencies_variable}
        )
            if(NOT ROCHostValidation_${_ROCHostValidation_dependency}_FOUND)
                string(
                    CONCAT
                    _ROCHostValidation_component_reason
                    "required component ${_ROCHostValidation_dependency} is "
                    "unavailable"
                )
                if(_ROCHostValidation_reason_${_ROCHostValidation_dependency})
                    string(
                        APPEND
                        _ROCHostValidation_component_reason
                        " (${_ROCHostValidation_reason_${_ROCHostValidation_dependency}})"
                    )
                endif()
                break()
            endif()
        endforeach()
    endif()

    if(NOT _ROCHostValidation_component_reason
       AND _ROCHostValidation_component STREQUAL "BLAS"
       AND NOT _ROCHostValidation_blas_dependency_found)
        string(
            CONCAT
            _ROCHostValidation_component_reason
            "the BLAS component requires BLAS::BLAS, but CMake could not find "
            "the BLAS package and imported target"
        )
    endif()

    set(
        _ROCHostValidation_openmp_variable
        "_ROCHostValidation_${_ROCHostValidation_component}_uses_openmp"
    )
    if(NOT _ROCHostValidation_component_reason
       AND "${${_ROCHostValidation_openmp_variable}}"
       AND NOT _ROCHostValidation_openmp_dependency_found)
        string(
            CONCAT
            _ROCHostValidation_component_reason
            "the installed ${_ROCHostValidation_component} target requires "
            "OpenMP::OpenMP_CXX, but CMake could not find the OpenMP CXX "
            "component"
        )
    endif()

    set(
        _ROCHostValidation_target_variable
        "ROCHostValidation_${_ROCHostValidation_component}_TARGET"
    )
    set(
        _ROCHostValidation_targets_file_variable
        "_ROCHostValidation_${_ROCHostValidation_component}_targets_file"
    )
    set(
        _ROCHostValidation_targets_file
        "${CMAKE_CURRENT_LIST_DIR}/${${_ROCHostValidation_targets_file_variable}}"
    )
    if(NOT _ROCHostValidation_component_reason
       AND NOT TARGET "${${_ROCHostValidation_target_variable}}")
        if(NOT EXISTS "${_ROCHostValidation_targets_file}")
            string(
                CONCAT
                _ROCHostValidation_component_reason
                "the installation is incomplete; expected target file "
                "${_ROCHostValidation_targets_file} is missing"
            )
        else()
            include("${_ROCHostValidation_targets_file}")
        endif()
    endif()

    if(NOT _ROCHostValidation_component_reason
       AND NOT TARGET "${${_ROCHostValidation_target_variable}}")
        string(
            CONCAT
            _ROCHostValidation_component_reason
            "the installation target file did not define "
            "${${_ROCHostValidation_target_variable}}"
        )
    endif()

    if(_ROCHostValidation_component_reason)
        set(
            _ROCHostValidation_reason_${_ROCHostValidation_component}
            "${_ROCHostValidation_component_reason}"
        )
    else()
        set(ROCHostValidation_${_ROCHostValidation_component}_FOUND TRUE)
    endif()
endforeach()

foreach(_ROCHostValidation_component
        IN LISTS _ROCHostValidation_supported_requests)
    if(_ROCHostValidation_legacy_all_components
       OR ROCHostValidation_FIND_REQUIRED_${_ROCHostValidation_component})
        if(NOT ROCHostValidation_${_ROCHostValidation_component}_FOUND)
            string(
                CONCAT
                _ROCHostValidation_component_error
                "ROCHostValidation component "
                "\"${_ROCHostValidation_component}\" is unavailable: "
                "${_ROCHostValidation_reason_${_ROCHostValidation_component}}."
            )
            list(
                APPEND
                _ROCHostValidation_errors
                "${_ROCHostValidation_component_error}"
            )
        endif()
    endif()
endforeach()

check_required_components(ROCHostValidation)
if(_ROCHostValidation_errors)
    set(ROCHostValidation_FOUND FALSE)
    list(JOIN _ROCHostValidation_errors "\n  " _ROCHostValidation_error_text)
    string(
        CONCAT
        ROCHostValidation_NOT_FOUND_MESSAGE
        "ROCHostValidation component resolution failed:\n  "
        "${_ROCHostValidation_error_text}"
    )
endif()
