#===----------------------------------------------------------------------===#
# A CSMACC producer issued before the first matrix op is judged by the form rules once one is latched (as if the form were known from the start): 9 matrix ops meet the 8-pass form's pure 9.
#===----------------------------------------------------------------------===#
# CHECK-LABEL: @capacity_prelatch_csmacc_judged_by_form_after_latch
# CHECK-NOT: s_wait_alu{{.*}}va_vdst
# CHECK: v300 = "st.ds_load_b32"
st.func @capacity_prelatch_csmacc_judged_by_form_after_latch() {
