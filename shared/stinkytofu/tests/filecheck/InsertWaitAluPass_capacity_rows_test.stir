#===----------------------------------------------------------------------===#
# 6 scaled matrix ops (12 tickets) and no VALU: still waits.
#===----------------------------------------------------------------------===#
# CHECK-LABEL: @capacity_f64_src_matrix_ops_count_nothing
# CHECK: s_wait_alu
# CHECK-SAME: va_vdst = 0
# CHECK-NEXT: v[2:3] = "st.ds_load_b64"
st.func @capacity_f64_src_matrix_ops_count_nothing() {
^entry:
  v[0:1] = "st.v_fma_f64"(v[2:3], v[4:5], v[0:1]) { issueCycles = 1, latencyCycles = 32 }
  v[32:39] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[400:415], v[416:431], v[32:39], v290, v291) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
  v[40:47] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[400:415], v[416:431], v[40:47], v290, v291) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
  v[48:55] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[400:415], v[416:431], v[48:55], v290, v291) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
  v[56:63] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[400:415], v[416:431], v[56:63], v290, v291) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
  v[64:71] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[400:415], v[416:431], v[64:71], v290, v291) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
  v[72:79] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[400:415], v[416:431], v[72:79], v290, v291) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
  v[2:3] = "st.ds_load_b64"(v250) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
}

