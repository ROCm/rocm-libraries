# RUN: %stinkytofu-opt --arch gfx1250 %s --vgpr-msb-mode=msb16 --remarks --CoissueRepairPass=mode=apply,margin=0,radius=0 --print-output 2>&1
#
# ClearSlot: two LDS loads and the wait take cycles 1-3 of window 0, so the VALU loses slot 3
# and slips to slot 6, pushing the two SALUs after it out of the window. With search radius 0
# only same-window moves are tried: the VALU goes to the end of its window, behind the SALUs.

# CHECK: move 1: clear-slot window 0 -> 0 (end) gains [2, 0, 0, 0, 0]
# CHECK-SAME: v_add_nc_u32 v30, v31, v32
# CHECK: loop label_LoopBeginL: moves 1
# CHECK-SAME: -> apply;
# CHECK: ^label_LoopBeginL:
# CHECK: "st.s_wait_dscnt"(4)
# CHECK-NEXT: "st.s_add_u32"
# CHECK-NEXT: "st.s_addc_u32"
# CHECK-NEXT: v30 = "st.v_add_nc_u32"(v31, v32)
# CHECK-NEXT: v_wmma_scale_f32_16x16x128_f8f6f4"(v[100:115], v[132:147]

st.func @clear_slot() {
^entry:
  s10 = "st.s_mov_b32"(8)
  Successors: ^label_LoopBeginL
^label_LoopBeginL:
  v[0:7] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[100:115], v[116:131], v[0:7], v20, v21) { mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" } }
  v[60:63] = "st.ds_load_b128"(v38) { mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  v[64:67] = "st.ds_load_b128"(v38) { mod.ds = { na = 1, offset = 16, gds = false }, mod.memtoken = { tokens = [0] } }
  "st.s_wait_dscnt"(4)
  v30 = "st.v_add_nc_u32"(v31, v32)
  s30, SCC0 = "st.s_add_u32"(s30, s8)
  s31, SCC0 = "st.s_addc_u32"(s31, 0, SCC0)
  v[8:15] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[100:115], v[132:147], v[8:15], v20, v21) { mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" } }
  s40 = "st.s_mov_b32"(0)
  s41 = "st.s_mov_b32"(1)
  s42 = "st.s_mov_b32"(2)
  s43 = "st.s_mov_b32"(3)
  s44 = "st.s_mov_b32"(4)
  s45 = "st.s_mov_b32"(5)
  v[16:23] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[100:115], v[148:163], v[16:23], v20, v21) { mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" } }
  s50 = "st.s_mov_b32"(0)
  s51 = "st.s_mov_b32"(1)
  s52 = "st.s_mov_b32"(2)
  s53 = "st.s_mov_b32"(3)
  s54 = "st.s_mov_b32"(4)
  s55 = "st.s_mov_b32"(5)
  s10, SCC0 = "st.s_add_i32"(s10, -1)
  SCC0 = "st.s_cmp_eq_u32"(s10, 0)
  "st.s_cbranch_scc0"(label_LoopBeginL, SCC0)
  Successors: ^label_LoopBeginL, ^label_end
^label_end:
  "st.s_endpgm"()
}
