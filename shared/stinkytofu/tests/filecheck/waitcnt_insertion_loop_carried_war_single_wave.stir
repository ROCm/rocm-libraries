# RUN: %stinkytofu-opt --arch gfx1250 %s --NumWaves=1 --StinkyBuildImplicitDependencyPass --StinkyWaitCntInsertionPass --print-output
#
# Loop-carried WAR with NO barrier: the annotation rides the tensor_load itself.
#
# At NumWaves=1 there is no cross-wave hazard, so TensileLite emits no barrier and
# postMainLoopBarrierCheckAndReset bails out (it requires numWaves > 1). The
# rotation is still there, though, and the fill still lands on a buffer the
# previous trip was reading -- so the same-wave WAR survives with nothing to hang
# the annotation on.
#
# Nothing in WaitDataflow gates the loop-carried scan on isBarrier: it fires for
# whichever instruction carries mod.loopcarriedwar. Putting it on the fill needs
# no backend change, and is arguably better than the barrier even in multi-wave --
# the drain lands immediately before the write instead of ahead of the barrier,
# leaving more in flight.
#
# Shape (ring 3, one step per trip):
#
#   A1  ds_load [0]   consumed by the wmma this trip
#   A2  ds_load [0]   NOT consumed -- survives to the back edge
#   B   ds_load [1]   next trip's data, prefetched
#   fill tensor_load [2], guarding the buffer A-tagged reads used one trip ago
#
# Steady state at the fill, oldest first:
#
#   [ A2(k-1), B(k-1), A1(k), A2(k), B(k) ]
#     ^^^^^^^ carried in, tagged [0] -- the only true partner
#
# A2(k-1) sits 5 from the tail, so the wait is 4: it retires the previous trip's
# surviving read while leaving all three of this trip's in flight. B(k-1) is
# carried in too but tagged [1], so it does not match.
#
# CHECK-LABEL: @waitcnt_insertion_loop_carried_war_single_wave
# CHECK: ^loop:
# CHECK-NEXT: ds_load_b64{{.*}}tokens = [0]
# CHECK-NEXT: ds_load_b64{{.*}}tokens = [0]
# CHECK-NEXT: ds_load_b64{{.*}}tokens = [1]
# The loop-carried drain, with no barrier anywhere in the block.
# CHECK-NEXT: s_wait_dscnt{{.*}}dlcnt = 4
# CHECK-NEXT: tensor_load_to_lds{{.*}}tokens = [2]
# CHECK-NEXT: s_wait_dscnt{{.*}}dlcnt = 2
# CHECK-NEXT: v_wmma_f32_16x16x32_bf16
# CHECK-NOT: s_barrier

st.func @waitcnt_insertion_loop_carried_war_single_wave() {
^entry:
  "st.s_branch"("loop")
  Successors: ^loop
^loop:
  v[20:21] = "st.ds_load_b64"(v10) { mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  v[40:41] = "st.ds_load_b64"(v10) { mod.ds = { na = 1, offset = 16, gds = false }, mod.memtoken = { tokens = [0] } }
  v[60:61] = "st.ds_load_b64"(v11) { mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [1] } }
  "st.tensor_load_to_lds"(s[0:3], s[8:15]) { mod.memtoken = { tokens = [2] }, mod.loopcarriedwar = { tokens = [0], distance = 1 } }
  a[10:17] = "st.v_wmma_f32_16x16x32_bf16"(v[20:27], v[30:37], a[10:17])
  SCC0 = "st.s_cmp_eq_u32"(s60, 0x1)
  "st.s_cbranch_scc1"("loop", SCC0)
  Successors: ^loop, ^exit
^exit:
}
