# RUN: %stinkytofu-opt --arch gfx1250 %s --StinkyBuildImplicitDependencyPass --StinkyWaitCntInsertionPass --print-output
#
# StinkyWaitCntInsertionPass (gfx1250): s_wait_asynccnt insertion for the async
# global->LDS loads (global_load_async_to_lds_*), the load direction of
# waitcnt_insertion_async.stir. An async load writes LDS and has no register dest;
# StinkyBuildImplicitDependencyPass gives it an LDS<token> dest like tensor_load_to_lds.
# Async loads complete in order with other loads and stores with other stores, but
# loads and stores complete out of order with each other, so a wait counts only the
# ops of the direction it waits for.

##===----------------------------------------------------------------------===##
# 1. RAW: a ds_load of the buffer an async load writes waits for the load.
##===----------------------------------------------------------------------===##
#
# CHECK-LABEL: @waitcnt_insertion_async_load_raw
# CHECK: global_load_async_to_lds_b64
# CHECK-NEXT: s_wait_asynccnt
# CHECK-SAME: asynccnt = 0
# CHECK-NEXT: ds_load_b64

st.func @waitcnt_insertion_async_load_raw() {
^entry:
  "st.global_load_async_to_lds_b64"(v0, v2, s[30:31]) { mod.memtoken = { tokens = [0] } }
  v4 = "st.ds_load_b64"(v10) { mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
}

##===----------------------------------------------------------------------===##
# 2. WAW across two LDS buffers: per-buffer FIFO drain values.
##===----------------------------------------------------------------------===##
#
# The async FIFO holds [AL0(tok0), AL1(tok1)] at the first refill: refilling buffer 0
# waits for AL0 (asynccnt = 1); refilling buffer 1 waits for AL1 (asynccnt = 0).
#
# CHECK-LABEL: @waitcnt_insertion_async_load_waw
# CHECK: global_load_async_to_lds_b64
# CHECK-NEXT: global_load_async_to_lds_b64
# CHECK-NEXT: s_wait_asynccnt
# CHECK-SAME: asynccnt = 1
# CHECK-NEXT: ds_store_b64
# CHECK-NEXT: s_wait_asynccnt
# CHECK-SAME: asynccnt = 0
# CHECK-NEXT: ds_store_b64

st.func @waitcnt_insertion_async_load_waw() {
^entry:
  "st.global_load_async_to_lds_b64"(v0, v2, s[30:31]) { mod.memtoken = { tokens = [0] } }
  "st.global_load_async_to_lds_b64"(v4, v6, s[32:33]) { mod.memtoken = { tokens = [1] } }
  "st.ds_store_b64"(v0, v[20:21]) { mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  "st.ds_store_b64"(v4, v[22:23]) { mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [1] } }
}

##===----------------------------------------------------------------------===##
# 3. Mixed directions: an op of the other direction issued later is not counted.
##===----------------------------------------------------------------------===##
#
# Reusing buffer 0 waits for SA0 (resp. AL0) alone. The async FIFO holds two ops, but
# the later op of the other direction may complete first, so the wait is
# asynccnt = 0, not 1.
#
# CHECK-LABEL: @waitcnt_insertion_async_mixed_store_first
# CHECK: global_store_async_from_lds_b64
# CHECK-NEXT: global_load_async_to_lds_b64
# CHECK-NEXT: s_wait_asynccnt
# CHECK-SAME: asynccnt = 0
# CHECK-NEXT: ds_store_b64

st.func @waitcnt_insertion_async_mixed_store_first() {
^entry:
  "st.global_store_async_from_lds_b64"(v0, v2, s[30:31]) { mod.memtoken = { tokens = [0] } }
  "st.global_load_async_to_lds_b64"(v4, v6, s[32:33]) { mod.memtoken = { tokens = [2] } }
  "st.ds_store_b64"(v0, v[20:21]) { mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
}

# CHECK-LABEL: @waitcnt_insertion_async_mixed_load_first
# CHECK: global_load_async_to_lds_b64
# CHECK-NEXT: global_store_async_from_lds_b64
# CHECK-NEXT: s_wait_asynccnt
# CHECK-SAME: asynccnt = 0
# CHECK-NEXT: ds_store_b64

st.func @waitcnt_insertion_async_mixed_load_first() {
^entry:
  "st.global_load_async_to_lds_b64"(v0, v2, s[30:31]) { mod.memtoken = { tokens = [0] } }
  "st.global_store_async_from_lds_b64"(v4, v6, s[32:33]) { mod.memtoken = { tokens = [2] } }
  "st.ds_store_b64"(v0, v[20:21]) { mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
}
