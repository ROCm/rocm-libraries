# RUN: %stinkytofu-opt --arch gfx1250 %s --CFGBuilderPass --InsertWaitAluPass=enableESM2TrackValuVsrc --print-output
#
# A join keeps, per role stamp, the smaller of each age the rules read (matrix ops since the
# producer, VALUs since it, VALUs after a mixed rule's lead). Form 8/8: pure 12, mixed 5 + 7.

#===----------------------------------------------------------------------===#
# Lead met on both paths (6 W + 3 V / 7 W + 4 V): the join keeps 6 matrix ops and 3 VALUs after
# the lead; 3 more matrix ops make (9 - 5) + 3 = 7 tail slots, no wait.
#===----------------------------------------------------------------------===#
# CHECK-LABEL: @join_lead_met_on_both_paths_keeps_min_tail
# CHECK-NOT: s_wait_alu{{.*}}va_vdst
# CHECK: "st.ds_store_b32"
st.func @join_lead_met_on_both_paths_keeps_min_tail() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[300:315], v[316:331], v[0:7]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  "st.s_cbranch_scc1"("label_b_k", SCC0)
  Successors: ^bb_a_k, ^label_b_k
^bb_a_k:
  v[8:15] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[300:315], v[316:331], v[8:15]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[16:23] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[300:315], v[316:331], v[16:23]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[24:31] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[300:315], v[316:331], v[24:31]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[32:39] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[300:315], v[316:331], v[32:39]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[40:47] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[300:315], v[316:331], v[40:47]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[48:55] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[300:315], v[316:331], v[48:55]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v200 = "st.v_add_f32"(v220, v220) { issueCycles = 1, latencyCycles = 5 }
  v201 = "st.v_add_f32"(v221, v221) { issueCycles = 1, latencyCycles = 5 }
  v202 = "st.v_add_f32"(v222, v222) { issueCycles = 1, latencyCycles = 5 }
  "st.s_branch"("label_j_k")
  Successors: ^label_j_k
^label_b_k:
  v[56:63] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[300:315], v[316:331], v[56:63]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[64:71] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[300:315], v[316:331], v[64:71]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[72:79] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[300:315], v[316:331], v[72:79]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[80:87] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[300:315], v[316:331], v[80:87]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[88:95] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[300:315], v[316:331], v[88:95]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[96:103] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[300:315], v[316:331], v[96:103]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[104:111] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[300:315], v[316:331], v[104:111]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v210 = "st.v_add_f32"(v230, v230) { issueCycles = 1, latencyCycles = 5 }
  v211 = "st.v_add_f32"(v231, v231) { issueCycles = 1, latencyCycles = 5 }
  v212 = "st.v_add_f32"(v232, v232) { issueCycles = 1, latencyCycles = 5 }
  v213 = "st.v_add_f32"(v233, v233) { issueCycles = 1, latencyCycles = 5 }
  Successors: ^label_j_k
^label_j_k:
  v[112:119] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[300:315], v[316:331], v[112:119]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[120:127] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[300:315], v[316:331], v[120:127]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[128:135] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[300:315], v[316:331], v[128:135]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  "st.ds_store_b32"(v250, v0) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
}

#===----------------------------------------------------------------------===#
