# RUN: %stinkytofu-opt --arch gfx1250 %s --CFGBuilderPass --DsRefillSinkPass --enable-esm2-track-valu-vsrc --debug-pass DsRefillSinkPass 2>&1
#
# Report mode: for each ds_load InsertWaitAlu would give a va_vdst wait, its refill window and the
# slot the policy picks. A slot counts the block's WMMAs before a node. The refill overwrites
# v[200:203], which WMMA 0 read; the v_wmma_f32_16x16x32_bf16 form needs 12 WMMAs after that
# read to hide the wait. Its data is due 3 WMMAs (16 cycles of latency at 8 per WMMA, plus one)
# before the WMMA that reads it again. The IR is not changed.

#===----------------------------------------------------------------------===#
# 4 WMMAs after the read, so 8 to go: the wait is hidden at slot 13, inside [13, 14].
#===----------------------------------------------------------------------===#
# CHECK: [DsRefillSink] bb="entry" slot 5 ds_load_b128 v[200:203] N=4 D=8 window=[13,14] stage-end=18 -> slot 13 (wait hidden)
# CHECK: [DsRefillSink] bb="entry" va_vdst waits=1 deficit=8 unhideable=0 ds_load waits=1 movable=1

st.func @refill_wait_hidden() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[0:7]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[8:15] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[8:15]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[16:23] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[16:23]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[24:31] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[24:31]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[32:39] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[32:39]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[200:203] = "st.ds_load_b128"(v300, LDS0) { issueCycles = 1, latencyCycles = 16, mod.ds = { na = 1, offset = 0, gds = false } }
  v[40:47] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[40:47]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[48:55] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[48:55]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[56:63] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[56:63]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[64:71] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[64:71]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[72:79] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[72:79]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[80:87] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[80:87]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[88:95] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[88:95]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[96:103] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[96:103]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[104:111] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[104:111]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[112:119] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[112:119]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[120:127] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[120:127]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[128:135] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[128:135]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[140:147] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[140:147]) { mod.mfma = { reuseA = false, reuseB = false } }
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#===----------------------------------------------------------------------===#
# The data is due at slot 9, before the wait is hidden: the refill goes as late as its data
# allows and its wait gets weaker.
#===----------------------------------------------------------------------===#
# CHECK: [DsRefillSink] bb="entry" slot 5 ds_load_b128 v[200:203] N=4 D=8 window=[13,9] stage-end=13 -> slot 9 (weaker wait)

st.func @refill_weaker_wait() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[0:7]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[8:15] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[8:15]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[16:23] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[16:23]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[24:31] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[24:31]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[32:39] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[32:39]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[200:203] = "st.ds_load_b128"(v300, LDS0) { issueCycles = 1, latencyCycles = 16, mod.ds = { na = 1, offset = 0, gds = false } }
  v[40:47] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[40:47]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[48:55] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[48:55]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[56:63] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[56:63]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[64:71] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[64:71]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[72:79] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[72:79]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[80:87] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[80:87]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[88:95] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[88:95]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[140:147] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[140:147]) { mod.mfma = { reuseA = false, reuseB = false } }
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#===----------------------------------------------------------------------===#
# The barrier after the refill counts its threshold from the last ds_load before it.
#===----------------------------------------------------------------------===#
# CHECK: [DsRefillSink] bb="entry" slot 5 ds_load_b128 v[200:203] N=4 D=8 window=[13,-] stage-end=5 -> stays (last ds_load before a barrier)

st.func @refill_last_before_barrier() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[0:7]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[8:15] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[8:15]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[16:23] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[16:23]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[24:31] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[24:31]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[32:39] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[32:39]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[200:203] = "st.ds_load_b128"(v300, LDS0) { issueCycles = 1, latencyCycles = 16, mod.ds = { na = 1, offset = 0, gds = false } }
  "st.s_barrier_signal"(-1) { issueCycles = 1, latencyCycles = 1 }
  v[40:47] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[40:47]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[48:55] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[48:55]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[56:63] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[56:63]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[64:71] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[64:71]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[72:79] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[72:79]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[80:87] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[80:87]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[88:95] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[88:95]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[96:103] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[96:103]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[104:111] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[104:111]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[112:119] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[112:119]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[120:127] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[120:127]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[128:135] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[128:135]) { mod.mfma = { reuseA = false, reuseB = false } }
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#===----------------------------------------------------------------------===#
# The read is in the block before the loop exit. The scoreboard is seeded from that block,
# so the refill at the top of the next block still sees 3 WMMAs since the read.
#===----------------------------------------------------------------------===#
# CHECK: [DsRefillSink] bb="next" slot 0 ds_load_b128 v[200:203] N=3 D=9 window=[9,-] stage-end=12 -> slot 9 (wait hidden)

st.func @refill_after_a_block_boundary() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[0:7]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[8:15] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[8:15]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[16:23] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[16:23]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[24:31] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[24:31]) { mod.mfma = { reuseA = false, reuseB = false } }
  "st.s_cbranch_scc1"("exit", SCC0) { issueCycles = 1, latencyCycles = 1 }
  Successors: ^next, ^exit
^next:
  v[200:203] = "st.ds_load_b128"(v300, LDS0) { issueCycles = 1, latencyCycles = 16, mod.ds = { na = 1, offset = 0, gds = false } }
  v[40:47] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[40:47]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[48:55] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[48:55]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[56:63] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[56:63]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[64:71] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[64:71]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[72:79] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[72:79]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[80:87] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[80:87]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[88:95] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[88:95]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[96:103] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[96:103]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[104:111] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[104:111]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[112:119] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[112:119]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[120:127] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[120:127]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[128:135] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[232:239], v[128:135]) { mod.mfma = { reuseA = false, reuseB = false } }
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
^exit:
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}
