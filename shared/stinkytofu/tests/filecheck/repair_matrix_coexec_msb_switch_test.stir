# RUN: %stinkytofu-opt --arch gfx1250 %s --debug-pass RepairMatrixCoexecPass --RepairMatrixCoexecPass --print-output 2>&1
#
# The bank switches InsertVgprMsbPass will add count against a window's room.
#
# The matrix ops keep every operand below v256 and the v_add every operand above
# it, so the v_add needs an s_set_vgpr_msb in front of it and the second matrix
# op another to switch back. Counting only issue cycles, the two SALU ops, the
# v_add and the wait fit in the six free cycles of the first window. Counting
# the switches they do not: the switch in pushes the v_add past its co-execution
# slot at cycle 3 to the one at 6, and the switch back lands after the wait. So
# the v_add goes into the second window, which has room for it and its switch.
#
# CHECK: [MatrixCoexecReadyQueue] defer 1 past matrix
# CHECK: [RepairMatrixCoexec] deferred 1, hoisted 0
# CHECK-LABEL: @repair_matrix_coexec_msb_switch
# CHECK: v[0:7] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"
# CHECK-NEXT: s10 = "st.s_mov_b32"
# CHECK-NEXT: s11 = "st.s_mov_b32"
# CHECK-NEXT: s_wait_dscnt
# CHECK-NEXT: v[8:15] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"
# CHECK-NEXT: v300 = "st.v_add_f32"

st.func @repair_matrix_coexec_msb_switch() {
^entry:
  v[0:7] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[100:115], v[200:215], v[0:7], v20, v21) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
  s10 = "st.s_mov_b32"(s30) { issueCycles = 1, latencyCycles = 1 }
  s11 = "st.s_mov_b32"(s31) { issueCycles = 1, latencyCycles = 1 }
  v300 = "st.v_add_f32"(v301, v302) { issueCycles = 1, latencyCycles = 5 }
  "st.s_wait_dscnt"(0) { issueCycles = 1, latencyCycles = 1, mod.swaitcnt = { vlcnt = -1, vscnt = -1, dlcnt = 0, dscnt = -1, kmcnt = -1 } }
  v[8:15] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[116:131], v[200:215], v[8:15], v20, v21) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
}
