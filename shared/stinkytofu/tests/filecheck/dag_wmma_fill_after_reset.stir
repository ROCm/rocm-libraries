# RUN: %stinkytofu-opt --arch gfx1250 %s --StinkyBuildImplicitDependencyPass --StinkyDAGSchedulerPass --wmma-queue-cover-cycles=16 --ds-spread --print-output
#
# s_barrier_wait resets the WMMA queue, but the first consumer is too close to the DS issue plan
# after a full queue burst. The consumer-distance gate disables that burst, and normal scheduling
# interleaves the released ds_loads with the WMMAs instead of holding all loads until queue-full.
#
# CHECK-LABEL: @wmma_fill_after_reset
# CHECK: s_barrier_wait
# CHECK-NEXT: v[244:251] = "st.v_wmma_f32_16x16x16_bf16"
# CHECK-NEXT: v[20:23] = "st.ds_load_b128"
# CHECK-NEXT: v[252:259] = "st.v_wmma_f32_16x16x16_bf16"
# CHECK-NEXT: v[260:267] = "st.v_wmma_f32_16x16x16_bf16"
# CHECK-NEXT: v[268:275] = "st.v_wmma_f32_16x16x16_bf16"
# CHECK-NEXT: v[24:27] = "st.ds_load_b128"

st.func @wmma_fill_after_reset() {
^entry:
  v[50:53] = "st.buffer_load_b128"(v8, s[0:3], 0) { issueCycles = 12, latencyCycles = 116, mod.mubuf = { offen = true, offset12 = 0, glc = false, slc = false, nt = false, lds = false } }
  v[54:57] = "st.buffer_load_b128"(v8, s[0:3], s0) { issueCycles = 12, latencyCycles = 116, mod.mubuf = { offen = true, offset12 = 0, glc = false, slc = false, nt = false, lds = false } }
