# RUN: %stinkytofu-opt --arch gfx1250 %s --StinkyBuildImplicitDependencyPass --StinkyDAGSchedulerPass --wait-alu-scoreboard --enable-esm2-track-valu-vsrc --ds-address-plan --print-output
#
# dagFeatures.dsAddressPlan: a ds_load's address filler takes the load's pacer window less the
# scoreboard gap as its need-by and is promoted when it comes (DsPacer level). The first load is
# planned at window 0, so its v_xor goes before the first WMMA; without the option it is an
# ordinary filler and issues after it.

# CHECK-LABEL: @ds_address_valu_issues_at_its_need_by
# CHECK: v400 = "st.v_xor_b32"
# CHECK-NEXT: v[0:7] = "st.v_wmma_f32_16x16x32_bf16"
st.func @ds_address_valu_issues_at_its_need_by() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[200:207], v[0:7]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[8:15] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[200:207], v[8:15]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[16:23] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[200:207], v[16:23]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[24:31] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[200:207], v[24:31]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[32:39] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[200:207], v[32:39]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[40:47] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[200:207], v[40:47]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[48:55] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[200:207], v[48:55]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[56:63] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[200:207], v[56:63]) { mod.mfma = { reuseA = false, reuseB = false } }
  v400 = "st.v_xor_b32"(v400, v401) { issueCycles = 1, latencyCycles = 5 }
  v[104:107] = "st.ds_load_b128"(v400) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  v400 = "st.v_xor_b32"(v400, v401) { issueCycles = 1, latencyCycles = 5 }
  v[108:111] = "st.ds_load_b128"(v400) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  v[64:71] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[200:207], v[64:71]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[72:79] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[200:207], v[72:79]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[80:87] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[200:207], v[80:87]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[88:95] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[200:207], v[88:95]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[96:103] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[200:207], v[96:103]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[104:111] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[200:207], v[104:111]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[112:119] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[200:207], v[112:119]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[120:127] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[200:207], v[120:127]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[128:135] = "st.v_wmma_f32_16x16x32_bf16"(v[104:111], v[200:207], v[128:135]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[136:143] = "st.v_wmma_f32_16x16x32_bf16"(v[104:111], v[200:207], v[136:143]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[144:151] = "st.v_wmma_f32_16x16x32_bf16"(v[104:111], v[200:207], v[144:151]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[152:159] = "st.v_wmma_f32_16x16x32_bf16"(v[104:111], v[200:207], v[152:159]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[160:167] = "st.v_wmma_f32_16x16x32_bf16"(v[104:111], v[200:207], v[160:167]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[168:175] = "st.v_wmma_f32_16x16x32_bf16"(v[104:111], v[200:207], v[168:175]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[176:183] = "st.v_wmma_f32_16x16x32_bf16"(v[104:111], v[200:207], v[176:183]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[184:191] = "st.v_wmma_f32_16x16x32_bf16"(v[104:111], v[200:207], v[184:191]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[192:199] = "st.v_wmma_f32_16x16x32_bf16"(v[108:115], v[200:207], v[192:199]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[200:207] = "st.v_wmma_f32_16x16x32_bf16"(v[108:115], v[200:207], v[200:207]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[208:215] = "st.v_wmma_f32_16x16x32_bf16"(v[108:115], v[200:207], v[208:215]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[216:223] = "st.v_wmma_f32_16x16x32_bf16"(v[108:115], v[200:207], v[216:223]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[224:231] = "st.v_wmma_f32_16x16x32_bf16"(v[108:115], v[200:207], v[224:231]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[232:239] = "st.v_wmma_f32_16x16x32_bf16"(v[108:115], v[200:207], v[232:239]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[240:247] = "st.v_wmma_f32_16x16x32_bf16"(v[108:115], v[200:207], v[240:247]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[248:255] = "st.v_wmma_f32_16x16x32_bf16"(v[108:115], v[200:207], v[248:255]) { mod.mfma = { reuseA = false, reuseB = false } }
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}
