# RUN: %stinkytofu-opt --arch gfx1250 %s --RegionClonePass --print-output 2>&1
#
# The init clone runs for every wave, so RegionClonePass puts each bare
# s_barrier_signal -3 behind an s_cmp_eq_u32 sgprWaveIdx, 0 gate. Here SCC is
# set before the signal and read after it, so the gate compare would hand
# s_cselect the wrong SCC: the job is skipped before anything changes.
# Before: the clone was made with the gate between s_cmp and s_cselect.

# CHECK:     [RegionClonePass] InitCIterWmma at label_LoopBeginL: SCC is live at a cluster-signal gate; region not cloned
# CHECK-NOT: InitCIterWmma
# CHECK-LABEL: ^label_LoopBeginL:
# CHECK-NEXT:  "st.s_cmp_eq_u32"(s0, 0)
# CHECK-NEXT:  "st.s_barrier_signal"(-3)
# CHECK-NEXT:  "st.s_cselect_b32"(s5, s6)
# CHECK-NOT: InitCIterWmma

st.func @clone_scc_live_gate() {
^pre_loop:
  v0 = "st.s_mov_b32"(0) { issueCycles = 1, latencyCycles = 1 }
^label_LoopBeginL:
  "st.s_cmp_eq_u32"(s0, 0) { issueCycles = 1, latencyCycles = 1 }
  "st.s_barrier_signal"(-3) { issueCycles = 1, latencyCycles = 1 }
  s4 = "st.s_cselect_b32"(s5, s6) { issueCycles = 1, latencyCycles = 1 }
  v[0:7] = "st.v_wmma_f32_16x16x16_bf16"(v[8:15], v[16:23], v[0:7]) { mod.mfma = { reuseA = false, reuseB = false } }
  "st.s_branch"(label_LoopBeginL) { issueCycles = 1, latencyCycles = 1 }
^label_post:
  v[16:23] = "st.v_wmma_f32_16x16x16_bf16"(v[24:31], v[32:39], v[16:23]) { mod.mfma = { reuseA = false, reuseB = false } }
}
