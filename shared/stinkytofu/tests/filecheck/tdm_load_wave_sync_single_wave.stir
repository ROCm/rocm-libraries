# RUN: %stinkytofu-opt --arch gfx1250 %s --NumWaves=1 --TDMLoadWaveSyncPass --print-output 2>&1
#
# TDMLoadWaveSyncPass no-ops when NumWaves == 1: with a single wave there is nothing
# to separate across waves, so no barrier is needed. This is the same A(tok0);
# B(tok0); C(tok1); wait stream that Case 1 of tdm_load_wave_sync.stir splits with a
# barrier under NumWaves=2 — here, with NumWaves=1, NO barrier is inserted.
#
# CHECK-LABEL: @tdm_single_wave_noop
# CHECK: tensor_load_to_lds
# CHECK-SAME: tokens = [0]
# CHECK: tensor_load_to_lds
# CHECK-SAME: tokens = [0]
# CHECK: tensor_load_to_lds
# CHECK-SAME: tokens = [1]
# CHECK: s_wait_tensorcnt
# CHECK-NOT: s_barrier_signal

st.func @tdm_single_wave_noop() {
^entry:
  "st.tensor_load_to_lds"(s[0:3], s[4:11]) { issueCycles = 1, latencyCycles = 1, mod.memtoken = { tokens = [0] } }
  "st.tensor_load_to_lds"(s[12:15], s[16:23]) { issueCycles = 1, latencyCycles = 1, mod.memtoken = { tokens = [0] } }
  "st.tensor_load_to_lds"(s[24:27], s[28:35]) { issueCycles = 1, latencyCycles = 1, mod.memtoken = { tokens = [1] } }
  "st.s_wait_tensorcnt"() { issueCycles = 1, latencyCycles = 1, mod.swaittensorcnt = { tlcnt = 1 }, mod.memtoken = { tokens = [0] } }
}
