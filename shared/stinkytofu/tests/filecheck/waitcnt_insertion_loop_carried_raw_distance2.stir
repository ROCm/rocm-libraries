# RUN: %stinkytofu-opt --arch gfx1250 %s --NumWaves=1 --StinkyBuildImplicitDependencyPass --StinkyWaitCntInsertionPass --print-output
#
# Loop-carried RAW at distance 2, the mirror of the WAR tests: the reads consume
# a fill from TWO trips back, so the wait lands on tensorcnt rather than dscnt.
#
# Ring 3, one step per trip, Read(k) = blk(k) and Write(k) = blk(k+2):
#
#                           prologue   iter 0   iter 1   iter 2   iter 3
#   ds_load     (Read,  [0])     -      LDS0     LDS1     LDS2     LDS0
#   tensor_load (Write, [2]) LDS0,LDS1  LDS2     LDS0     LDS1     LDS2
#
# Read(k) = Write(k-d) gives d = 2: iter 2 reads what iter 0 wrote, iter 3 what
# iter 1 wrote, and the two prologue fills cover iters 0 and 1. The tags [0] and
# [2] never move while the buffer under each shifts every column, which is why
# token overlap compares [0] against [2] and misses a dependence that is real in
# every iteration.
#
# This is the PGR2 software-pipeline depth, and the case that needs
# QueuedOp::tripsBack. A single "came from an earlier trip" flag would match the
# fill from one trip back as well -- a different buffer under rotation -- take
# the nearer of the two, and collapse to tlcnt = 0. Selecting entries at
# distance >= 2 picks the right instance and leaves the newer fill in flight.
#
# Steady state at the read, oldest first:
#
#   [ fill(k-2), fill(k-1) ]
#     ^^^^^^^^^ tripsBack 2 -- the only match
#
# 2 from the tail, so tlcnt = 1: trip k-2's fill retires and trip k-1's keeps
# going, which is the overlap the third buffer exists to provide.
#
# CHECK-LABEL: @waitcnt_insertion_loop_carried_raw_distance2
# CHECK: ^loop:
# CHECK-NEXT: s_wait_tensorcnt{{.*}}tlcnt = 1
# CHECK-NEXT: ds_load_b64{{.*}}tokens = [0]
# CHECK-NEXT: ds_load_b64{{.*}}tokens = [0]
# CHECK: tensor_load_to_lds{{.*}}tokens = [2]
# CHECK-NOT: s_wait_tensorcnt

st.func @waitcnt_insertion_loop_carried_raw_distance2() {
^entry:
  "st.tensor_load_to_lds"(s[0:3], s[8:15]) { mod.memtoken = { tokens = [0] } }
  "st.tensor_load_to_lds"(s[0:3], s[16:23]) { mod.memtoken = { tokens = [1] } }
  "st.s_branch"("loop")
  Successors: ^loop
^loop:
  v[20:21] = "st.ds_load_b64"(v10) { mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] }, mod.loopcarriedraw = { tokens = [2], distance = 2 } }
  v[40:41] = "st.ds_load_b64"(v10) { mod.ds = { na = 1, offset = 16, gds = false }, mod.memtoken = { tokens = [0] } }
  a[10:17] = "st.v_wmma_f32_16x16x32_bf16"(v[20:27], v[30:37], a[10:17])
  a[18:25] = "st.v_wmma_f32_16x16x32_bf16"(v[40:47], v[30:37], a[18:25])
  "st.tensor_load_to_lds"(s[0:3], s[24:31]) { mod.memtoken = { tokens = [2] } }
  SCC0 = "st.s_cmp_eq_u32"(s60, 0x1)
  "st.s_cbranch_scc1"("loop", SCC0)
  Successors: ^loop, ^exit
^exit:
}
