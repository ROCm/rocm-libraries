# RUN: %stinkytofu-opt --arch gfx1250 %s --debug-pass RepairMatrixCoexecPass --RepairMatrixCoexecPass --print-output 2>&1
#
# Independent matrix ops issued back to back stay back to back.
#
# Three independent matrix ops come first, then the work for the window of the
# third. Independent matrix ops back to back run at full matrix rate, so the
# empty windows between them cost nothing and are left empty. The work fits in
# the window it is in, so nothing moves.
#
# CHECK: [RepairMatrixCoexec] deferred 0, hoisted 0
# CHECK-LABEL: @repair_matrix_coexec_interleave
# CHECK: v_wmma_scale_f32_16x16x128_f8f6f4
# CHECK-NEXT: v_wmma_scale_f32_16x16x128_f8f6f4
# CHECK-NEXT: v_wmma_scale_f32_16x16x128_f8f6f4
# CHECK-NEXT: v_add_f32
# CHECK-NEXT: s_mov_b32
# CHECK-NEXT: s_wait_dscnt
# CHECK-NEXT: v_wmma_scale_f32_16x16x128_f8f6f4

st.func @repair_matrix_coexec_interleave() {
^entry:
  v[0:7] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[100:115], v[200:215], v[0:7], v20, v21) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
  v[8:15] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[116:131], v[200:215], v[8:15], v20, v21) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
  v[16:23] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[132:147], v[200:215], v[16:23], v20, v21) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
  v40 = "st.v_add_f32"(v41, v42) { issueCycles = 1, latencyCycles = 5 }
  s10 = "st.s_mov_b32"(s11) { issueCycles = 1, latencyCycles = 1 }
  "st.s_wait_dscnt"(0) { issueCycles = 1, latencyCycles = 1, mod.swaitcnt = { vlcnt = -1, vscnt = -1, dlcnt = 0, dscnt = -1, kmcnt = -1 } }
  v[24:31] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[148:163], v[200:215], v[24:31], v20, v21) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
}
