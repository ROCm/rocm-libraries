# RUN: %stinkytofu-opt --arch gfx1250 %s --StinkyBuildImplicitDependencyPass --StinkyDAGSchedulerPass --barrier-tail-back-to-back --wmma-queue-cover-cycles=16 --ds-spread --hold-between-close-barriers --wmma-queue-depth=8 --print-output
