# RUN: %stinkytofu-opt --arch gfx1250 %s --BuildUseDefChainPass --PeepholeOptimizationPass --print-output
#
# A three-deep MUL chain fuses twice. The second fusion's producer is the instruction the first
# one rewrote, not the one it erased (the erased one used to be matched, written through,
# and freed, leaving v3 unwritten).

# CHECK-LABEL: @mul_chain
# CHECK: v_mul_f32
# CHECK-SAME: v3
# CHECK-SAME: 30
# CHECK-SAME: v0
# CHECK-NOT: v_mul_f32
# CHECK: v_add_f32
# CHECK-SAME: v9
# CHECK-SAME: v3

st.func @mul_chain() {
^entry:
  v1 = "st.v_mul_f32"(2.0, v0) { issueCycles = 1, latencyCycles = 5 }
  v2 = "st.v_mul_f32"(3.0, v1) { issueCycles = 1, latencyCycles = 5 }
  v3 = "st.v_mul_f32"(5.0, v2) { issueCycles = 1, latencyCycles = 5 }
  v9 = "st.v_add_f32"(v3, v9) { issueCycles = 1, latencyCycles = 5 }
}
