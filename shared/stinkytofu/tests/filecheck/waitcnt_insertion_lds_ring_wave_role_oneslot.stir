# RUN: %stinkytofu-opt --arch gfx1250 %s --NumWaves=4 --StinkyBuildImplicitDependencyPass --StinkyWaitCntInsertionPass --print-output
#
# Wave-separated LDS ring, (PGRA, PGRB) = (4, 1), two-barrier fence (protect,
# fill, publish): the one-slot side B (odd waves) waits for every fill, the
# deep side A (even waves) keeps three in flight: prologue and main A/B 3/0.
#
# CHECK-LABEL: @waitcnt_insertion_lds_ring_wave_role_oneslot
# CHECK-LABEL: ^pro_even:
# CHECK-NEXT: s_wait_tensorcnt
# CHECK-SAME: tlcnt = 3
# CHECK-LABEL: ^pro_odd:
# CHECK-NEXT: s_wait_tensorcnt
# CHECK-SAME: tlcnt = 0
# CHECK-LABEL: ^pro_pub:
# CHECK-NEXT: s_barrier_signal
# CHECK-LABEL: ^fence_even:
# CHECK-NEXT: s_branch
# CHECK-LABEL: ^fence_odd:
# CHECK-NEXT: s_wait_tensorcnt
# CHECK-SAME: tlcnt = 0
# CHECK-LABEL: ^fence:
# CHECK-NEXT: s_wait_tensorcnt
# CHECK-SAME: tlcnt = 3
# CHECK-NEXT: s_barrier_signal

st.func @waitcnt_insertion_lds_ring_wave_role_oneslot() {
^entry:
  "st.tensor_load_to_lds"(s[0:3], s[8:15]) { mod.memtoken = { tokens = [0,4] }, mod.lds_ring = { accesses = [0,0,4,0,1,1,0,1,0,1], advances = [], waves = [5,10] } }
  SCC0 = "st.s_cmp_eq_u32"(s50, 0x1)
  "st.s_cbranch_scc1"("pro_join", SCC0) { mod.wave_role = { taken = 10, fallthrough = 5 } }
  Successors: ^pro_join, ^pro_deep
^pro_deep:
  "st.tensor_load_to_lds"(s[0:3], s[8:15]) { mod.memtoken = { tokens = [1] }, mod.lds_ring = { accesses = [0,0,4,1,1], advances = [], waves = [5] } }
  "st.tensor_load_to_lds"(s[0:3], s[8:15]) { mod.memtoken = { tokens = [2] }, mod.lds_ring = { accesses = [0,0,4,2,1], advances = [], waves = [5] } }
  "st.tensor_load_to_lds"(s[0:3], s[8:15]) { mod.memtoken = { tokens = [3] }, mod.lds_ring = { accesses = [0,0,4,3,1], advances = [], waves = [5] } }
  Successors: ^pro_join
^pro_join:
  SCC1 = "st.s_cmp_eq_u32"(s50, 0x1)
  "st.s_cbranch_scc1"("pro_odd", SCC1) { mod.wave_role = { taken = 10, fallthrough = 5 } }
  Successors: ^pro_odd, ^pro_even
^pro_even:
  "st.s_branch"("pro_pub")
  Successors: ^pro_pub
^pro_odd:
  Successors: ^pro_pub
^pro_pub:
  "st.s_barrier_signal"(-1) { mod.memtoken = { tokens = [0,4] }, mod.lds_ring = { accesses = [0,0,4,0,2,1,0,1,0,2], advances = [], waves = [5,10] } }
  "st.s_barrier_wait"(-1) { mod.memtoken = { tokens = [0,4] } }
  "st.s_branch"("loop")
  Successors: ^loop
^loop:
  "st.s_barrier_signal"(-1) { mod.memtoken = { tokens = [0,4] }, mod.lds_ring = { accesses = [0,0,4,0,3,1,0,1,0,3], advances = [], waves = [5,10] } }
  "st.s_barrier_wait"(-1) { mod.memtoken = { tokens = [0,4] } }
  "st.tensor_load_to_lds"(s[0:3], s[8:15]) { mod.memtoken = { tokens = [0,4] }, mod.lds_ring = { accesses = [0,0,4,4,1,1,0,1,1,1], advances = [], waves = [5,10] } }
  SCC2 = "st.s_cmp_eq_u32"(s50, 0x1)
  "st.s_cbranch_scc1"("fence_odd", SCC2) { mod.wave_role = { taken = 10, fallthrough = 5 } }
  Successors: ^fence_odd, ^fence_even
^fence_even:
  "st.s_branch"("fence")
  Successors: ^fence
^fence_odd:
  Successors: ^fence
^fence:
  "st.s_barrier_signal"(-1) { mod.memtoken = { tokens = [1,4] }, mod.lds_ring = { accesses = [0,0,4,1,2,1,0,1,1,2], advances = [], waves = [5,10] } }
  "st.s_barrier_wait"(-1) { mod.memtoken = { tokens = [1,4] } }
  SCC3 = "st.s_cmp_eq_u32"(s60, 0x1)
  "st.s_cbranch_scc1"("loop", SCC3) { mod.lds_ring = { accesses = [], advances = [0,1] } }
  Successors: ^loop, ^exit
^exit:
}
