# RUN: %stinkytofu-opt --arch gfx1250 %s --LiftAsmRegistersToSSAPass=classes=v --RegisterAllocationPass=allocator=greedy-compact,classes=v,report,apply,noRule=ProducerPinMatrix --InsertVgprMsbPass --remarks --vgpr-msb-mode=msb16 --print-output 2>&1
#
# The allocation report's s_set_vgpr_msb prediction, against what
# InsertVgprMsbPass then emits for the same colouring.
#
# As written, the loop's three WMMAs read src1 from bank 2, bank 2 and bank 3:
# one switch to set the word at the top of the block and one when src1 moves,
# so the producer's colouring costs 2. Compaction without ProducerPinMatrix
# packs every operand into bank 0, where all three need one word, so the
# colouring that is applied costs 1. The report says 2->1 before anything is
# written, and the pass, running on the applied registers, emits exactly that
# one switch.
#
# CHECK: msb[loop=2->1]
# CHECK-LABEL: ^loop:
# CHECK-NEXT: "st.s_set_vgpr_msb"(0)
# CHECK-NEXT: "st.v_wmma_f32_16x16x32_bf16"
# CHECK-NEXT: "st.v_wmma_f32_16x16x32_bf16"
# CHECK-NEXT: "st.v_wmma_f32_16x16x32_bf16"
# CHECK-NEXT: "st.s_cbranch_scc1"

st.func @vgpr_msb_prediction() {
^entry:
  "st.s_branch"("loop")
  Successors: ^loop
^loop:
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[256:263], v[512:519], v[0:7])
  v[8:15] = "st.v_wmma_f32_16x16x32_bf16"(v[264:271], v[520:527], v[8:15])
  v[16:23] = "st.v_wmma_f32_16x16x32_bf16"(v[272:279], v[768:775], v[16:23])
  "st.s_cbranch_scc1"("loop", SCC0)
  Successors: ^loop, ^exit
^exit:
  "st.s_endpgm"()
}
