# RUN: %stinkytofu-opt --arch gfx1250 %s --InsertInitialUnclausedVmemPass --print-output
#
# InsertInitialUnclausedVmemPass: gfx1250 hardware entrypoints must begin with
#   global_prefetch_b8 v0, [s0, s1] scope:SCOPE_SE th:TH_LOAD_RT
#   v_nop
# so the kernel's first VMEM instruction is not in a clause (global_prefetch_b8
# is a VMEM op that ignores EXEC) and the first VALU instruction is a safe
# v_nop. The pass prepends this sequence before the first real (non-pseudo)
# instruction of the entry function.

#--- Prologue is inserted, in order, ahead of the first real instruction.
# CHECK-LABEL: @simple_kernel
# CHECK: "st.global_prefetch_b8"(v0, s[0:1])
# CHECK-SAME: th = "TH_LOAD_RT"
# CHECK-SAME: scope = "SCOPE_SE"
# CHECK-NEXT: "st.v_nop"()
# CHECK-NEXT: "st.v_add_f32"
# CHECK: s_endpgm

st.func @simple_kernel() {
^entry:
  v0 = "st.v_add_f32"(v1, v2) { issueCycles = 1, latencyCycles = 5 }
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- The first three instructions are exactly global_prefetch_b8, v_nop, then
#--- the original first instruction, with nothing inserted between them.
# CHECK-LABEL: @order_kernel
# CHECK: "st.global_prefetch_b8"(v0, s[0:1])
# CHECK-SAME: th = "TH_LOAD_RT"
# CHECK-SAME: scope = "SCOPE_SE"
# CHECK-NEXT: "st.v_nop"()
# CHECK-NEXT: "st.v_mul_f32"

st.func @order_kernel() {
^entry:
  v0 = "st.v_mul_f32"(v1, v2) { issueCycles = 1, latencyCycles = 5 }
}
