# RUN: %stinkytofu-opt --arch gfx1250 %s --InsertInitialUnclausedVmemPass --print-output
#
# InsertInitialUnclausedVmemPass: gfx1250 hardware entrypoints must begin with
#   global_wb SCOPE:SCOPE_CU
#   v_nop
# so the kernel's first VMEM instruction is not in a clause (global_wb is a VMEM
# op that ignores EXEC) and the first VALU instruction is a safe v_nop. The pass
# prepends this sequence before the first real (non-pseudo) instruction of the
# entry function.

#--- Prologue is inserted, in order, ahead of the first real instruction.
# CHECK-LABEL: @simple_kernel
# CHECK: "st.global_wb"()
# CHECK-SAME: scope = "SCOPE_CU"
# CHECK-NEXT: "st.v_nop"()
# CHECK-NEXT: "st.v_add_f32"
# CHECK: s_endpgm

st.func @simple_kernel() {
^entry:
  v0 = "st.v_add_f32"(v1, v2) { issueCycles = 1, latencyCycles = 5 }
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- global_wb comes before v_nop (exact order), and v_nop is not emitted
#--- before global_wb.
# CHECK-LABEL: @order_kernel
# CHECK: "st.global_wb"()
# CHECK-NOT: "st.v_add_f32"
# CHECK: "st.v_nop"()

st.func @order_kernel() {
^entry:
  v0 = "st.v_add_f32"(v1, v2) { issueCycles = 1, latencyCycles = 5 }
}
