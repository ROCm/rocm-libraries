# RUN: %stinkytofu-opt --arch gfx1250 %s --EpilogueStoreSinkPass --print-output
#
# Store grouping at the shipping defaults (maxStoreGroupSize=4, msb guard on). The
# interleaved VALU use high VGPRs, so they carry a different required msb than
# the stores; packing a store up must still hop them.

#--- Four stores pack together; the trailing pair is already adjacent.
# CHECK-LABEL: @group_gc4_msb_interleaved
# CHECK: buffer_store_b32
# CHECK-NEXT: buffer_store_b32
# CHECK-NEXT: buffer_store_b32
# CHECK-NEXT: buffer_store_b32
# CHECK-NEXT: v_add_f32
# CHECK: buffer_store_b32
# CHECK-NEXT: buffer_store_b32

st.func @group_gc4_msb_interleaved() {
^entry:
  "st.buffer_store_b32"(v12, off, s[60:63], s46) { issueCycles = 1, latencyCycles = 1 }
  v300 = "st.v_add_f32"(v301, v302) { issueCycles = 1, latencyCycles = 5 }
  "st.buffer_store_b32"(v13, off, s[60:63], s46) { issueCycles = 1, latencyCycles = 1 }
  v303 = "st.v_add_f32"(v304, v305) { issueCycles = 1, latencyCycles = 5 }
  "st.buffer_store_b32"(v14, off, s[60:63], s46) { issueCycles = 1, latencyCycles = 1 }
  v306 = "st.v_add_f32"(v307, v308) { issueCycles = 1, latencyCycles = 5 }
  "st.buffer_store_b32"(v15, off, s[60:63], s46) { issueCycles = 1, latencyCycles = 1 }
  v309 = "st.v_add_f32"(v310, v311) { issueCycles = 1, latencyCycles = 5 }
  "st.buffer_store_b32"(v16, off, s[60:63], s46) { issueCycles = 1, latencyCycles = 1 }
  "st.buffer_store_b32"(v17, off, s[60:63], s46) { issueCycles = 1, latencyCycles = 1 }
}
