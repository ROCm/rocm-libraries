# RUN: %stinkytofu-opt --arch gfx1250 %s --StinkyBuildImplicitDependencyPass --StinkyDAGSchedulerPass --wait-alu-hold-strict-count=2 --wmma-queue-cover-cycles=16 --ds-spread --print-output
#
# WaitAluHoldStrictCount, crossing a barrier wait: the v_xor overwriting v400, which an LDS0
# ds_load just read, needs a strict s_wait_alu vm_vsrc. Its consumers are the v_add (no
# consumer in the region) and LDS1 ds_loads behind the LDS1 barrier wait, planned after the
# LDS0 one, so holding it past the LDS0 wait delays nothing: it issues after that wait instead
# of in its two-window run-up.
#
# When the LDS1 loads feed no WMMA the LDS1 barrier has no planned window, nothing proves the
# consumers are gated, and the v_xor keeps the run-up of the LDS0 wait.

# CHECK-LABEL: @wait_alu_hold_cross_barrier
# CHECK-NOT: v400 = "st.v_xor_b32"
# CHECK: LDS0 = "st.s_barrier_wait"
# CHECK: v400 = "st.v_xor_b32"
# CHECK: "st.ds_load_b128"(v400, LDS1)

# CHECK-LABEL: @wait_alu_hold_no_planned_gate
# CHECK: v400 = "st.v_xor_b32"
# CHECK: LDS0 = "st.s_barrier_wait"
st.func @wait_alu_hold_cross_barrier() {
^entry:
  v[600:603] = "st.ds_load_b128"(v400, LDS0) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
