# RUN: %stinkytofu-opt --arch gfx1250 %s --vgpr-msb-mode=msb16 --remarks --CoissueRepairPass=mode=apply,margin=0 --print-output 2>&1
#
# MakeRoom: window 0 holds six SALUs and a wait, more than its eight cycles, so the next
# v_wmma issues late under the compiler profile. One s_mov moves into window 1, which has
# room; no profile gets worse, so the move is accepted and written back (margin 0).

# CHECK: move 1: make-room window 0 -> 1 (start) gains [1, 0, 0, 0, 0]
# CHECK-SAME: s_mov_b32 s1, 1
# CHECK: loop label_LoopBeginL: moves 1
# CHECK-SAME: -> apply;
# CHECK: ^label_LoopBeginL:
# CHECK-NEXT: v_wmma_scale_f32_16x16x128_f8f6f4"(v[100:115], v[116:131]
# CHECK-NEXT: s2 = "st.s_mov_b32"(2)
# CHECK: "st.s_wait_dscnt"(0)
# CHECK-NEXT: v_wmma_scale_f32_16x16x128_f8f6f4"(v[100:115], v[132:147]
# CHECK-NEXT: s1 = "st.s_mov_b32"(1)
# CHECK-NEXT: v_wmma_scale_f32_16x16x128_f8f6f4"(v[100:115], v[148:163]

st.func @make_room() {
^entry:
  s10 = "st.s_mov_b32"(8)
  Successors: ^label_LoopBeginL
^label_LoopBeginL:
  v[0:7] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[100:115], v[116:131], v[0:7], v20, v21) { mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" } }
  s1 = "st.s_mov_b32"(1)
  s2 = "st.s_mov_b32"(2)
  s3 = "st.s_mov_b32"(3)
  s4 = "st.s_mov_b32"(4)
  s5 = "st.s_mov_b32"(5)
  s6 = "st.s_mov_b32"(6)
  "st.s_wait_dscnt"(0)
  v[8:15] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[100:115], v[132:147], v[8:15], v20, v21) { mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" } }
  v[16:23] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[100:115], v[148:163], v[16:23], v20, v21) { mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" } }
  s10, SCC0 = "st.s_add_i32"(s10, -1)
  SCC0 = "st.s_cmp_eq_u32"(s10, 0)
  "st.s_cbranch_scc0"(label_LoopBeginL, SCC0)
  Successors: ^label_LoopBeginL, ^label_end
^label_end:
  "st.s_endpgm"()
}
