# RUN: %stinkytofu-opt --arch gfx1250 %s --EpilogueStoreSinkPass=noGuard --print-output
#
# Epilogue store-sink rules with the msb guard off, isolating the bulk sink.
# Guard cases live in epilogue_store_sink_msb_guard.stir.
# Store grouping stays on (default 4) but only acts on runs of >=2 stores, so the
# single-store cases are unaffected.

#--- Store sinks past following VALU (no hazard between).
# CHECK-LABEL: @sink_past_valu
# CHECK: v_add_f32
# CHECK: v_add_f32
# CHECK: buffer_store_b32

st.func @sink_past_valu() {
^entry:
  "st.buffer_store_b32"(v12, off, s[60:63], s46) { issueCycles = 1, latencyCycles = 1 }
  v20 = "st.v_add_f32"(v21, v22) { issueCycles = 1, latencyCycles = 5 }
  v23 = "st.v_add_f32"(v24, v25) { issueCycles = 1, latencyCycles = 5 }
}

#--- Store does NOT sink past a writer of its data reg (WAR).
# CHECK-LABEL: @stop_at_war
# CHECK: buffer_store_b32
# CHECK: v_add_f32

st.func @stop_at_war() {
^entry:
  "st.buffer_store_b32"(v12, off, s[60:63], s46) { issueCycles = 1, latencyCycles = 1 }
  v12 = "st.v_add_f32"(v24, v25) { issueCycles = 1, latencyCycles = 5 }
}

#--- Store sinks across a pure s_wait_loadcnt (it bumps storecnt, not loadcnt).
# CHECK-LABEL: @cross_loadcnt
# CHECK: s_wait_loadcnt
# CHECK: v_add_f32
# CHECK: buffer_store_b32

st.func @cross_loadcnt() {
^entry:
  "st.buffer_store_b32"(v12, off, s[60:63], s46) { issueCycles = 1, latencyCycles = 1 }
  "st.s_wait_loadcnt"() { issueCycles = 1, latencyCycles = 1, mod.waitcnt = { vlcnt = 0 } }
  v20 = "st.v_add_f32"(v21, v22) { issueCycles = 1, latencyCycles = 5 }
}

#--- Store does NOT cross s_wait_storecnt (gates its own counter).
# CHECK-LABEL: @stop_at_storecnt
# CHECK: buffer_store_b32
# CHECK: s_wait_storecnt
# CHECK: v_add_f32

st.func @stop_at_storecnt() {
^entry:
  "st.buffer_store_b32"(v12, off, s[60:63], s46) { issueCycles = 1, latencyCycles = 1 }
  "st.s_wait_storecnt"() { issueCycles = 1, latencyCycles = 1, mod.waitcnt = { vscnt = 0 } }
  v20 = "st.v_add_f32"(v21, v22) { issueCycles = 1, latencyCycles = 5 }
}

#--- Store does NOT sink past the SRD row advance (WAR on its address SGPR).
# CHECK-LABEL: @stop_at_srd_advance
# CHECK: buffer_store_b32
# CHECK: s_add_u32
# CHECK: v_add_f32

st.func @stop_at_srd_advance() {
^entry:
  "st.buffer_store_b32"(v12, off, s[60:63], s46) { issueCycles = 1, latencyCycles = 1 }
  s60 = "st.s_add_u32"(s60, s70) { issueCycles = 1, latencyCycles = 1 }
  v20 = "st.v_add_f32"(v21, v22) { issueCycles = 1, latencyCycles = 5 }
}

#--- Store grouping: two stores separated by VALU are packed back-to-back.
# CHECK-LABEL: @group_two_stores
# CHECK: v_add_f32
# CHECK: v_add_f32
# CHECK: buffer_store_b32
# CHECK-NEXT: buffer_store_b32

st.func @group_two_stores() {
^entry:
  "st.buffer_store_b32"(v12, off, s[60:63], s46) { issueCycles = 1, latencyCycles = 1 }
  v20 = "st.v_add_f32"(v21, v22) { issueCycles = 1, latencyCycles = 5 }
  "st.buffer_store_b32"(v13, off, s[60:63], s46) { issueCycles = 1, latencyCycles = 1 }
  v23 = "st.v_add_f32"(v24, v25) { issueCycles = 1, latencyCycles = 5 }
}

#--- buffer_store crosses s_wait_asynccnt.
# CHECK-LABEL: @cross_asynccnt
# CHECK: s_wait_asynccnt
# CHECK: v_add_f32
# CHECK: buffer_store_b32

st.func @cross_asynccnt() {
^entry:
  "st.buffer_store_b32"(v12, off, s[60:63], s46) { issueCycles = 1, latencyCycles = 1 }
  "st.s_wait_asynccnt"() { issueCycles = 1, latencyCycles = 1, mod.swaitasynccnt = { asynccnt = 0 } }
  v20 = "st.v_add_f32"(v21, v22) { issueCycles = 1, latencyCycles = 5 }
}

#--- global_store_async_from_lds crosses s_wait_storecnt.
# CHECK-LABEL: @async_store_cross_storecnt
# CHECK: s_wait_storecnt
# CHECK: v_add_f32
# CHECK: global_store_async_from_lds_b64

st.func @async_store_cross_storecnt() {
^entry:
  "st.global_store_async_from_lds_b64"(v[0:1], v2, s[30:31]) { issueCycles = 1, latencyCycles = 1 }
  "st.s_wait_storecnt"() { issueCycles = 1, latencyCycles = 1, mod.waitcnt = { vscnt = 0 } }
  v20 = "st.v_add_f32"(v21, v22) { issueCycles = 1, latencyCycles = 5 }
}

#--- global_store_async_from_lds crosses s_wait_loadcnt.
# CHECK-LABEL: @async_store_cross_loadcnt
# CHECK: s_wait_loadcnt
# CHECK: v_add_f32
# CHECK: global_store_async_from_lds_b64

st.func @async_store_cross_loadcnt() {
^entry:
  "st.global_store_async_from_lds_b64"(v[0:1], v2, s[30:31]) { issueCycles = 1, latencyCycles = 1 }
  "st.s_wait_loadcnt"() { issueCycles = 1, latencyCycles = 1, mod.waitcnt = { vlcnt = 0 } }
  v20 = "st.v_add_f32"(v21, v22) { issueCycles = 1, latencyCycles = 5 }
}
