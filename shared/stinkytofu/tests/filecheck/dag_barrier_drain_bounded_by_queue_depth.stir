  a[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[108:115], a[0:7]) { mod.mfma = { reuseA = false, reuseB = false } }
  a[8:15] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[108:115], a[8:15]) { mod.mfma = { reuseA = false, reuseB = false } }
  a[16:23] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[108:115], a[16:23]) { mod.mfma = { reuseA = false, reuseB = false } }
  a[24:31] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[108:115], a[24:31]) { mod.mfma = { reuseA = false, reuseB = false } }
  a[32:39] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[108:115], a[32:39]) { mod.mfma = { reuseA = false, reuseB = false } }
  a[40:47] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[108:115], a[40:47]) { mod.mfma = { reuseA = false, reuseB = false } }
  a[48:55] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[108:115], a[48:55]) { mod.mfma = { reuseA = false, reuseB = false } }
  a[56:63] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[108:115], a[56:63]) { mod.mfma = { reuseA = false, reuseB = false } }
  a[64:71] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[108:115], a[64:71]) { mod.mfma = { reuseA = false, reuseB = false } }
  a[72:79] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[108:115], a[72:79]) { mod.mfma = { reuseA = false, reuseB = false } }
  a[80:87] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[108:115], a[80:87]) { mod.mfma = { reuseA = false, reuseB = false } }
  a[88:95] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[108:115], a[88:95]) { mod.mfma = { reuseA = false, reuseB = false } }
  a[96:103] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[108:115], a[96:103]) { mod.mfma = { reuseA = false, reuseB = false } }
  a[104:111] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[108:115], a[104:111]) { mod.mfma = { reuseA = false, reuseB = false } }
  a[112:119] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[108:115], a[112:119]) { mod.mfma = { reuseA = false, reuseB = false } }
  a[120:127] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[108:115], a[120:127]) { mod.mfma = { reuseA = false, reuseB = false } }
  a[128:135] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[108:115], a[128:135]) { mod.mfma = { reuseA = false, reuseB = false } }
  a[136:143] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[108:115], a[136:143]) { mod.mfma = { reuseA = false, reuseB = false } }
  a[144:151] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[108:115], a[144:151]) { mod.mfma = { reuseA = false, reuseB = false } }
  a[152:159] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[108:115], a[152:159]) { mod.mfma = { reuseA = false, reuseB = false } }
  "st.s_barrier_signal"(-1) { issueCycles = 1, latencyCycles = 1, mod.memtoken = { tokens = [0] } }
  "st.s_barrier_wait"(-1) { issueCycles = 1, latencyCycles = 1, mod.memtoken = { tokens = [0] } }
  "st.tensor_load_to_lds"(s[0:3], s[4:11]) { issueCycles = 1, latencyCycles = 1, mod.memtoken = { tokens = [0] } }
