  v[32:35] = "st.ds_load_b128"(v80) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 256, gds = false }, mod.memtoken = { tokens = [0] } }
  v[36:39] = "st.ds_load_b128"(v80) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 288, gds = false }, mod.memtoken = { tokens = [0] } }
  v[40:43] = "st.ds_load_b128"(v80) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 320, gds = false }, mod.memtoken = { tokens = [0] } }
