# RUN: %stinkytofu-opt --arch gfx1250 %s --InsertWaitAluPass=enableESM2TrackValuVsrc --print-output
#
# Mixed va_vdst hide (WaitHide::Form xdlMixLead/xdlMixTail, csmaccMixLead/csmaccMixTail): after
# the producer, `lead` matrix ops first, then `tail` more ops that are matrix ops or VALUs in any
# order. The latency-8 / 8-VGPR form (v_wmma_f32_16x16x128_fp8_fp8) has lead 5, tail 7, so
# matrix ops alone still need 5 + 7 = 12. The scaled (MX) latency-8 / 8-VGPR form has lead 4, tail
# 6, and a scaled matrix op fills 2 tail slots: alone they need 4 + 3 = 7.

#===----------------------------------------------------------------------===#
# 5 matrix ops, then 7 VALUs: the mixed hide is met, no wait.
#===----------------------------------------------------------------------===#
# CHECK-LABEL: @gfx1250_mix_xdl_5w_7v
# CHECK-NOT: s_wait_alu{{.*}}va_vdst
# CHECK: ds_load_b32

st.func @gfx1250_mix_xdl_5w_7v() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[300:315], v[316:331], v[0:7]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[8:15] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[300:315], v[316:331], v[8:15]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[16:23] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[300:315], v[316:331], v[16:23]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[24:31] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[300:315], v[316:331], v[24:31]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[32:39] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[300:315], v[316:331], v[32:39]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[40:47] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[300:315], v[316:331], v[40:47]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v200 = "st.v_add_f32"(v220, v220) { issueCycles = 1, latencyCycles = 5 }
  v201 = "st.v_add_f32"(v221, v221) { issueCycles = 1, latencyCycles = 5 }
  v202 = "st.v_add_f32"(v222, v222) { issueCycles = 1, latencyCycles = 5 }
  v203 = "st.v_add_f32"(v223, v223) { issueCycles = 1, latencyCycles = 5 }
  v204 = "st.v_add_f32"(v224, v224) { issueCycles = 1, latencyCycles = 5 }
  v205 = "st.v_add_f32"(v225, v225) { issueCycles = 1, latencyCycles = 5 }
  v206 = "st.v_add_f32"(v226, v226) { issueCycles = 1, latencyCycles = 5 }
  v260 = "st.ds_load_b32"(v0) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
}

