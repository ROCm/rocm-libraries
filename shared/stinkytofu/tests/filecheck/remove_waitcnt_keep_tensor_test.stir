# RUN: %stinkytofu-opt --arch gfx1250 %s --StinkyRemoveWaitCntPass=keepTensor --print-output
#
# removeTensorWaitCnt=false leaves s_wait_tensorcnt for a subsequent insertion
# pass to reuse. s_wait_tensorcnt carries IF_WaitTensorCnt, a flag disjoint from
# IF_WaitCnt, so it is gated by its own branch in the pass; the stripped dscnt
# drain alongside it is what shows only that branch was disabled.
#
# The default policy (tensor stripped) is in remove_waitcnt_test.stir.

# CHECK-LABEL: @keeps_tensorcnt_still_strips_dscnt
# CHECK: s_wait_tensorcnt
# CHECK-NEXT: v_add_f32
# CHECK-NOT: s_wait_dscnt

st.func @keeps_tensorcnt_still_strips_dscnt() {
^entry:
  "st.s_wait_dscnt"(0)
  "st.s_wait_tensorcnt"(0)
  "st.s_wait_dscnt"(0)
  v0 = "st.v_add_f32"(v1, v2)
}
