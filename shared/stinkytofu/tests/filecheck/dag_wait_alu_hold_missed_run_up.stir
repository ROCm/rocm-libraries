# RUN: %stinkytofu-opt --arch gfx1250 %s --StinkyBuildImplicitDependencyPass --StinkyDAGSchedulerPass --wait-alu-hold-strict-count=2 --wait-alu-hold-first-wait-only --barrier-tail-back-to-back --wmma-queue-depth=8 --wmma-queue-cover-cycles=16 --ds-spread --print-output
#
# WaitAluHoldStrictCount with WaitAluHoldFirstWaitOnly, a filler that misses its run-up: the
# v_add overwriting v400, which a ds_load just read, needs a strict s_wait_alu vm_vsrc. It is
# ready at the top, so it is held for the two windows before the first s_barrier_wait (LDS0).
# The WMMAs before that wait run back to back (BarrierTailBackToBack), so it misses them; it then
# stays free and issues right after the wait instead of being held again for the LDS1 wait's
# run-up.

# CHECK-LABEL: @wait_alu_hold_missed_run_up
# CHECK-NOT: v400 = "st.v_add_nc_u32"
# CHECK: LDS0 = "st.s_barrier_wait"
# CHECK-NOT: v[8:15] = "st.v_wmma_scale
# CHECK: v400 = "st.v_add_nc_u32"
# CHECK: LDS1 = "st.s_barrier_wait"
st.func @wait_alu_hold_missed_run_up() {
^entry:
  v[600:603] = "st.ds_load_b128"(v400, LDS1) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [1] } }
  v400 = "st.v_add_nc_u32"(v400, v410) { issueCycles = 1, latencyCycles = 5 }
  v[0:7] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[100:115], v[116:131], v[0:7]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP8, fmtB = MATRIX_FMT_FP8 } }
