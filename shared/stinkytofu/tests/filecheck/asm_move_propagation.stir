# RUN: %stinkytofu-opt --arch gfx1250 %s --AsmMovePropagationPass --print-output
#
# AsmMovePropagationPass: conservative basic-block-local move propagation.
#--- Propagate through single move and erase it after later redefinition.
# CHECK-LABEL: @propagate_and_erase_redefined_move
# CHECK-NOT: v_mov_b32
# CHECK: v2 = "st.v_add_f32"(v1, v3)
# CHECK: v0 = "st.v_sub_f32"(v4, v5)

st.func @propagate_and_erase_redefined_move() {
^entry:
  v0 = "st.v_mov_b32"(v1) { issueCycles = 1, latencyCycles = 1 }
  v2 = "st.v_add_f32"(v0, v3) { issueCycles = 1, latencyCycles = 5 }
  v0 = "st.v_sub_f32"(v4, v5) { issueCycles = 1, latencyCycles = 5 }
  "st.buffer_store_b32"(v40, v2) { issueCycles = 1, latencyCycles = 1 }
}

#--- Propagate transitively through move chain and erase chain moves.
# CHECK-LABEL: @propagate_through_move_chain
# CHECK-NOT: v_mov_b32
# CHECK: v3 = "st.v_add_f32"(v1, v4)
# CHECK: v2 = "st.v_sub_f32"(v5, v6)

st.func @propagate_through_move_chain() {
^entry:
  v0 = "st.v_mov_b32"(v1) { issueCycles = 1, latencyCycles = 1 }
  v2 = "st.v_mov_b32"(v0) { issueCycles = 1, latencyCycles = 1 }
  v3 = "st.v_add_f32"(v2, v4) { issueCycles = 1, latencyCycles = 5 }
  v2 = "st.v_sub_f32"(v5, v6) { issueCycles = 1, latencyCycles = 5 }
  v0 = "st.v_sub_f32"(v7, v8) { issueCycles = 1, latencyCycles = 5 }
  "st.buffer_store_b32"(v40, v3) { issueCycles = 1, latencyCycles = 1 }
}

#--- Stop propagation after source redefinition and keep the move.
# CHECK-LABEL: @stop_after_source_redefined
# CHECK: v0 = "st.v_mov_b32"(v1)
# CHECK: v2 = "st.v_add_f32"(v1, v3)
# CHECK: v1 = "st.v_sub_f32"(v6, v7)
# CHECK: v4 = "st.v_mul_f32"(v0, v5)

st.func @stop_after_source_redefined() {
^entry:
  v0 = "st.v_mov_b32"(v1) { issueCycles = 1, latencyCycles = 1 }
  v2 = "st.v_add_f32"(v0, v3) { issueCycles = 1, latencyCycles = 5 }
  v1 = "st.v_sub_f32"(v6, v7) { issueCycles = 1, latencyCycles = 5 }
  v4 = "st.v_mul_f32"(v0, v5) { issueCycles = 1, latencyCycles = 5 }
  v0 = "st.v_add_f32"(v8, v9) { issueCycles = 1, latencyCycles = 5 }
  "st.buffer_store_b32"(v40, v4) { issueCycles = 1, latencyCycles = 1 }
}

#--- Keep move when it may be live-out of the block.
# CHECK-LABEL: @keep_move_when_potentially_liveout
# CHECK: v0 = "st.v_mov_b32"(v1)
# CHECK: v2 = "st.v_add_f32"(v3, v4)

st.func @keep_move_when_potentially_liveout() {
^entry:
  v0 = "st.v_mov_b32"(v1) { issueCycles = 1, latencyCycles = 1 }
  v2 = "st.v_add_f32"(v3, v4) { issueCycles = 1, latencyCycles = 5 }
}

#--- Do not propagate across register classes (v<-s).
# CHECK-LABEL: @do_not_propagate_cross_class_move
# CHECK: v0 = "st.v_mov_b32"(s1)
# CHECK: v2 = "st.v_add_f32"(v0, v3)

st.func @do_not_propagate_cross_class_move() {
^entry:
  v0 = "st.v_mov_b32"(s1) { issueCycles = 1, latencyCycles = 1 }
  v2 = "st.v_add_f32"(v0, v3) { issueCycles = 1, latencyCycles = 5 }
  v0 = "st.v_sub_f32"(v4, v5) { issueCycles = 1, latencyCycles = 5 }
}

#--- Remove identity move.
# CHECK-LABEL: @remove_identity_move
# CHECK-NOT: v_mov_b32
# CHECK: v2 = "st.v_add_f32"(v3, v4)

st.func @remove_identity_move() {
^entry:
  v0 = "st.v_mov_b32"(v0) { issueCycles = 1, latencyCycles = 1 }
  v2 = "st.v_add_f32"(v3, v4) { issueCycles = 1, latencyCycles = 5 }
}

#--- Do not optimize away mov writes to exec/vcc/scc-style control registers.
# CHECK-LABEL: @keep_exec_write_move
# CHECK: exec_lo0 = "st.s_mov_b32"(vcc_lo0)
# CHECK: v2 = "st.v_add_f32"(v1, v3)
# CHECK: exec_lo0 = "st.s_mov_b32"(s5)
st.func @keep_exec_write_move() {
^entry:
  exec_lo0 = "st.s_mov_b32"(vcc_lo0) { issueCycles = 1, latencyCycles = 2 }
  v0 = "st.v_mov_b32"(v1) { issueCycles = 1, latencyCycles = 1 }
  v2 = "st.v_add_f32"(v0, v3) { issueCycles = 1, latencyCycles = 5 }
  exec_lo0 = "st.s_mov_b32"(s5) { issueCycles = 1, latencyCycles = 2 }
  v0 = "st.v_sub_f32"(v4, v5) { issueCycles = 1, latencyCycles = 5 }
  "st.buffer_store_b32"(v40, v2) { issueCycles = 1, latencyCycles = 1 }
}

#--- Conservative mode: keep source-modifier uses untouched.
# CHECK-LABEL: @preserve_negated_source_after_propagation
# CHECK: v0 = "st.v_mov_b32"(v1)
# CHECK: v2 = "st.v_add_f32"(-v0, v3)
st.func @preserve_negated_source_after_propagation() {
^entry:
  v0 = "st.v_mov_b32"(v1) { issueCycles = 1, latencyCycles = 1 }
  v2 = "st.v_add_f32"(-v0, v3) { issueCycles = 1, latencyCycles = 5 }
  v0 = "st.v_sub_f32"(v4, v5) { issueCycles = 1, latencyCycles = 5 }
  "st.buffer_store_b32"(v40, v2) { issueCycles = 1, latencyCycles = 1 }
}

#--- Conservative mode: keep VOP3 source-modifier uses untouched.
# CHECK-LABEL: @compose_vop3_neg_with_mapped_neg
# CHECK: v0 = "st.v_mov_b32"(-v1)
# CHECK: v2 = "st.v_add_f32"(v0, v3)
# CHECK-SAME: mod.vop3 = { neg_src0 = true }
st.func @compose_vop3_neg_with_mapped_neg() {
^entry:
  v0 = "st.v_mov_b32"(-v1) { issueCycles = 1, latencyCycles = 1 }
  v2 = "st.v_add_f32"(v0, v3) {
    issueCycles = 1, latencyCycles = 5, mod.vop3 = { neg_src0 = true }
  }
  v0 = "st.v_sub_f32"(v4, v5) { issueCycles = 1, latencyCycles = 5 }
  "st.buffer_store_b32"(v40, v2) { issueCycles = 1, latencyCycles = 1 }
}
