# RUN: %stinkytofu-opt --arch gfx1250 %s --CFGBuilderPass --InsertWaitAluPass --print-output
#
# An op holding an ordinal in BOTH order FIFOs anchors them to each other. Once enough
# reads follow it in either FIFO to prove it drained, every op older than it in either
# FIFO drained too -- so their vm_vsrc waits need not be emitted either.
#
# This is what lets one flat_prefetch_b8 discharge a whole run of global_prefetch_b8:
# only the last of the run has to be rewritten, because TEX order puts it behind the rest.

#--- global_prefetch reads v[0:1] (TEX only, and only 1 TEX follower -- far short of the
#--- 11 needed on its own). The flat right after it is the anchor, and 11 ds_loads follow
#--- the anchor, so both the anchor and the older prefetch are proven drained.
# CHECK-LABEL: @anchor_discharges_older_prefetch
# CHECK: "st.global_prefetch_b8"
# CHECK-NOT: vm_vsrc
# CHECK: v0 = "st.v_mov_b32"
st.func @anchor_discharges_older_prefetch() {
^entry:
  "st.global_prefetch_b8"(v[0:1], off) { issueCycles = 1, latencyCycles = 1 }
  "st.flat_prefetch_b8"(v[2:3], s[64:65]) { issueCycles = 1, latencyCycles = 1 }
  v100 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v101 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v102 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v103 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v104 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v105 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v106 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v107 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v108 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v109 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v110 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v0 = "st.v_mov_b32"(v41) { issueCycles = 1, latencyCycles = 1 }
}

#--- Only 10 ds_loads follow the anchor: below the threshold, so the anchor is not proven
#--- drained and the older prefetch keeps its wait.
# CHECK-LABEL: @anchor_below_threshold_keeps_wait
# CHECK: "st.s_wait_alu"
# CHECK-SAME: vm_vsrc
# CHECK-NEXT: v0 = "st.v_mov_b32"
st.func @anchor_below_threshold_keeps_wait() {
^entry:
  "st.global_prefetch_b8"(v[0:1], off) { issueCycles = 1, latencyCycles = 1 }
  "st.flat_prefetch_b8"(v[2:3], s[64:65]) { issueCycles = 1, latencyCycles = 1 }
  v100 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v101 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v102 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v103 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v104 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v105 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v106 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v107 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v108 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v109 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v0 = "st.v_mov_b32"(v41) { issueCycles = 1, latencyCycles = 1 }
}

#--- The anchor is issued in one block and consumed in another. The anchor travels with the
#--- producer it anchors, so it has to be carried into the successor's entry state -- not
#--- just merged when the successor already has one.
# CHECK-LABEL: @anchor_survives_block_entry
# CHECK: "st.global_prefetch_b8"
# CHECK-NOT: vm_vsrc
# CHECK: v0 = "st.v_mov_b32"
st.func @anchor_survives_block_entry() {
^entry:
  "st.global_prefetch_b8"(v[0:1], off) { issueCycles = 1, latencyCycles = 1 }
  "st.flat_prefetch_b8"(v[2:3], s[64:65]) { issueCycles = 1, latencyCycles = 1 }
  Successors: ^body
^body:
  v100 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v101 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v102 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v103 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v104 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v105 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v106 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v107 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v108 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v109 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v110 = "st.ds_load_b32"(v40) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
  v0 = "st.v_mov_b32"(v41) { issueCycles = 1, latencyCycles = 1 }
}
