# RUN: %stinkytofu-opt --arch gfx1250 %s --StinkyBuildImplicitDependencyPass --StinkyWaitCntInsertionPass --print-output
#
# StinkyWaitCntInsertionPass (gfx1250): s_wait_asynccnt insertion for the async
# LDS->global store family (global_store_async_from_lds_*). The async store reads
# an LDS buffer asynchronously (tracked by asynccnt) and has no register dest, so
# the SSA chain never orders a later LDS writer after it. The pass models the WAR
# hazard: an LDS writer / barrier reusing a buffer an async store is still
# reading must drain asynccnt first.

##===----------------------------------------------------------------------===##
# 1. WAR across two LDS buffers: per-buffer FIFO drain values.
##===----------------------------------------------------------------------===##
#
# Two buffers (tokens 0 and 1) are each filled by a tensor_load_to_lds, read by
# an async store, then refilled by a second tensor_load_to_lds. Each refill is a
# WAR hazard on the async store still reading the same buffer. The async FIFO
# holds [SA0(tok0), SA1(tok1)] at the first refill: refilling buffer 0 waits for
# SA0 (index 0 of the depth-2 queue -> asynccnt = 2 - 0 - 1 = 1); refilling
# buffer 1 waits for SA1 (asynccnt = 0).
#
# CHECK-LABEL: @waitcnt_insertion_async_lds_war
# CHECK: tensor_load_to_lds
# CHECK-NEXT: tensor_load_to_lds
# CHECK: global_store_async_from_lds_b64
# CHECK-NEXT: global_store_async_from_lds_b64
# CHECK-NEXT: s_wait_asynccnt
# CHECK-SAME: asynccnt = 1
# CHECK-NEXT: tensor_load_to_lds
# CHECK-NEXT: s_wait_asynccnt
# CHECK-SAME: asynccnt = 0
# CHECK-NEXT: tensor_load_to_lds

st.func @waitcnt_insertion_async_lds_war() {
^entry:
  "st.tensor_load_to_lds"(s[0:3], s[10:17]) { mod.memtoken = { tokens = [0] } }
  "st.tensor_load_to_lds"(s[4:7], s[18:25]) { mod.memtoken = { tokens = [1] } }
  "st.global_store_async_from_lds_b64"(v[0:1], v2, s[30:31]) { mod.memtoken = { tokens = [0] } }
  "st.global_store_async_from_lds_b64"(v[4:5], v6, s[32:33]) { mod.memtoken = { tokens = [1] } }
  "st.tensor_load_to_lds"(s[0:3], s[10:17]) { mod.memtoken = { tokens = [0] } }
  "st.tensor_load_to_lds"(s[4:7], s[18:25]) { mod.memtoken = { tokens = [1] } }
}

##===----------------------------------------------------------------------===##
# 2. Realistic store-back with a per-buffer barrier as the sync point.
##===----------------------------------------------------------------------===##
#
# Each buffer is produced in LDS by a ds_store, then drained to global by an
# async store, so the async FIFO holds [SA0(tok0), SA1(tok1)]. Buffer 0 is fenced
# by barrier A (token 0), buffer 1 by barrier B (token 1) -- one barrier per
# buffer, not one covering both:
#   * barrier A (token 0) conflicts only with SA0 (index 0 of depth 2) -> drains
#     s_wait_asynccnt 1, leaving SA1 (disjoint buffer) in flight.
#   * the buffer-0 reuse ds_store after barrier A needs no async wait.
#   * barrier B (token 1) conflicts only with SA1 (now sole in-flight) ->
#     s_wait_asynccnt 0.
# Each async store is also preceded by s_wait_dscnt 0 (cross-pipeline RAW on the
# ds_store that produced the LDS it reads).
#
# CHECK-LABEL: @waitcnt_insertion_async_barrier_sync
# CHECK: ds_store_b64
# CHECK: s_wait_dscnt
# CHECK-SAME: dlcnt = 0
# CHECK-NEXT: global_store_async_from_lds_b64
# CHECK: ds_store_b64
# CHECK: s_wait_dscnt
# CHECK-SAME: dlcnt = 0
# CHECK-NEXT: global_store_async_from_lds_b64
# CHECK: s_wait_asynccnt
# CHECK-SAME: asynccnt = 1
# CHECK-NEXT: s_barrier
# CHECK-NEXT: ds_store_b64
# CHECK: s_wait_asynccnt
# CHECK-SAME: asynccnt = 0
# CHECK-NEXT: s_barrier
# CHECK-NEXT: ds_store_b64

st.func @waitcnt_insertion_async_barrier_sync() {
^entry:
  "st.ds_store_b64"(v100, v[20:21]) { mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  "st.global_store_async_from_lds_b64"(v[0:1], v2, s[30:31]) { mod.memtoken = { tokens = [0] } }
  "st.ds_store_b64"(v101, v[22:23]) { mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [1] } }
  "st.global_store_async_from_lds_b64"(v[4:5], v6, s[32:33]) { mod.memtoken = { tokens = [1] } }
  "st.s_barrier"() { mod.memtoken = { tokens = [0] } }
  "st.ds_store_b64"(v102, v[24:25]) { mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  "st.s_barrier"() { mod.memtoken = { tokens = [1] } }
  "st.ds_store_b64"(v103, v[26:27]) { mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [1] } }
}

##===----------------------------------------------------------------------===##
# 3. Negative: disjoint tokens emit no wait.
##===----------------------------------------------------------------------===##
#
# Two async stores read token 1; a following tensor_load_to_lds writes token 0.
# The writer shares no token with the in-flight async readers, so the WAR set is
# empty and NO s_wait_asynccnt is emitted.
#
# CHECK-LABEL: @waitcnt_insertion_async_war_disjoint_tokens
# CHECK: global_store_async_from_lds_b64
# CHECK-NEXT: global_store_async_from_lds_b64
# CHECK-NEXT: tensor_load_to_lds
# CHECK-NOT: s_wait_asynccnt

st.func @waitcnt_insertion_async_war_disjoint_tokens() {
^entry:
  "st.global_store_async_from_lds_b64"(v[0:1], v2, s[30:31]) { mod.memtoken = { tokens = [1] } }
  "st.global_store_async_from_lds_b64"(v[4:5], v6, s[32:33]) { mod.memtoken = { tokens = [1] } }
  "st.tensor_load_to_lds"(s[0:3], s[10:17]) { mod.memtoken = { tokens = [0] } }
}
