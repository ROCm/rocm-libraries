# RUN: %stinkytofu-opt --arch gfx1250 %s --EpilogueStoreSinkPass --print-output
#
# Epilogue store-sink msb guard (avoidMsbXcntDrain, on by default). The guard
# reads VGPR numbers, not s_set_vgpr_msb, so no msb pass is needed here: v300 is
# bank 1, everything else bank 0.

#--- Store sinks past the same-bank VALU but stops before the bank flip.
# CHECK-LABEL: @msb_guard_stops_at_flip
# CHECK: v20 = "st.v_add_f32"
# CHECK: v23 = "st.v_add_f32"
# CHECK: buffer_store_b32
# CHECK: v300 = "st.v_add_f32"
# CHECK: v26 = "st.v_add_f32"

st.func @msb_guard_stops_at_flip() {
^entry:
  v20 = "st.v_add_f32"(v21, v22) { issueCycles = 1, latencyCycles = 5 }
  "st.buffer_store_b32"(v12, off, s[60:63], s46) { issueCycles = 1, latencyCycles = 1 }
  v23 = "st.v_add_f32"(v24, v25) { issueCycles = 1, latencyCycles = 5 }
  v300 = "st.v_add_f32"(v301, v302) { issueCycles = 1, latencyCycles = 5 }
  v26 = "st.v_add_f32"(v27, v28) { issueCycles = 1, latencyCycles = 5 }
}

#--- Same shape with no bank flip: the store sinks the whole way. Pairs with the
#--- case above to show the stop is the flip, not the guard blocking everything.
# CHECK-LABEL: @msb_guard_no_flip_sinks
# CHECK: v20 = "st.v_add_f32"
# CHECK: v23 = "st.v_add_f32"
# CHECK: v26 = "st.v_add_f32"
# CHECK: buffer_store_b32

st.func @msb_guard_no_flip_sinks() {
^entry:
  v20 = "st.v_add_f32"(v21, v22) { issueCycles = 1, latencyCycles = 5 }
  "st.buffer_store_b32"(v12, off, s[60:63], s46) { issueCycles = 1, latencyCycles = 1 }
  v23 = "st.v_add_f32"(v24, v25) { issueCycles = 1, latencyCycles = 5 }
  v26 = "st.v_add_f32"(v27, v28) { issueCycles = 1, latencyCycles = 5 }
}
