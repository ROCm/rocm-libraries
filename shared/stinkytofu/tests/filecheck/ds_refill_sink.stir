#===----------------------------------------------------------------------===#
# WMMA 12 reads the refilled data, so it is due at slot 9, before the wait is hidden. The refill
# goes to slot 9 and its wait gets weaker: 8 WMMAs, not 4.
#===----------------------------------------------------------------------===#
# CHECK-LABEL: @sink_takes_a_weaker_wait_when_the_data_is_due
# CHECK: v[64:71] = "st.v_wmma_f32_16x16x32_bf16"
# CHECK-NEXT: s_wait_alu
# CHECK-SAME: va_vdst = 8
