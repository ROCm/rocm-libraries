# RUN: %stinkytofu-opt --arch gfx1250 %s --InsertCoexecHazardPass=reportOnly 2>&1
#
# gfx1250 requires a WMMA that takes the previous WMMA's D through the C
# fast-forward path to write a different accumulator (d1 = A*B + d0), unless its
# type allows the same one (d0 = A*B + d0):
#   - K=128 f8xf8, f8xf4, f4xf8, f6xf4, f4xf6: neighbors use different A and B.
#   - f16, bf16, iu8, 16x16x128 f4xf4: WMMAs pair up (one 2xK tile each), with
#     different A and B within a pair and from the previous pair.
#   - 32x16x128 f4: no requirement.
# Where the same accumulator is allowed, A and B of one WMMA must not overlap.
# Only WMMAs count toward "previous": any other instruction in between, including
# a branch, does not break the chain. Non-XDL WMMAs (FP32 input, gfx12-era
# 16x16x16) follow the same rules but only warn: the rule is unconfirmed for them.
#
# reportOnly reports a broken rule as a violation and goes on, so every case runs in
# one file; wmma_accum_in_place_abort.stir covers the default, which stops codegen.
# A paired chain that continues from another block cannot be checked and is only
# a warning.

#===----------------------------------------------------------------------===#
# Rule 1: no exception, switch the accumulator.
#===----------------------------------------------------------------------===#

#--- f8 K=64 has no exception.
# CHECK: violation: WMMA in function "f8_k64_same_acc" block "entry"
# CHECK-SAME: switch the accumulator
st.func @f8_k64_same_acc() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x64_fp8_fp8"(v[20:27], v[30:37], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x64_fp8_fp8"(v[40:47], v[50:57], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- A VALU in between does not break the chain.
# CHECK: violation: WMMA in function "f8_k64_valu_between" block "entry"
# CHECK-SAME: switch the accumulator
st.func @f8_k64_valu_between() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x64_fp8_fp8"(v[20:27], v[30:37], v[0:7]) {}
  v100 = "st.v_add_f32"(v200, v201) { issueCycles = 1, latencyCycles = 5 }
  v[0:7] = "st.v_wmma_f32_16x16x64_fp8_fp8"(v[40:47], v[50:57], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- Nor does a loop backedge: no pairing to follow, so this is an error.
# CHECK: violation: WMMA in function "f8_k64_across_backedge" block "loop"
# CHECK-SAME: switch the accumulator
st.func @f8_k64_across_backedge() {
^entry:
  "st.s_branch"("loop")
  Successors: ^loop
^loop:
  v[0:7] = "st.v_wmma_f32_16x16x64_fp8_fp8"(v[20:27], v[30:37], v[0:7]) {}
  "st.s_cbranch_scc1"("loop", SCC0)
  Successors: ^loop, ^exit
^exit:
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- f6xf6 has no exception.
# CHECK: violation: WMMA in function "f6xf6_same_acc" block "entry"
# CHECK-SAME: switch the accumulator
st.func @f6xf6_same_acc() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[20:31], v[36:47], v[0:7]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP6, fmtB = MATRIX_FMT_FP6 } }
  v[0:7] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[52:63], v[68:79], v[0:7]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP6, fmtB = MATRIX_FMT_FP6 } }
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- f8xf6 has no exception.
# CHECK: violation: WMMA in function "f8xf6_same_acc" block "entry"
# CHECK-SAME: switch the accumulator
st.func @f8xf6_same_acc() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[20:35], v[36:47], v[0:7]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP8, fmtB = MATRIX_FMT_FP6 } }
  v[0:7] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[52:67], v[68:79], v[0:7]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP8, fmtB = MATRIX_FMT_FP6 } }
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- SWMMAC accumulates into its own D, so a matching D alone is the chain.
# CHECK: violation: WMMA in function "swmmac_same_acc" block "entry"
# CHECK-SAME: switch the accumulator
st.func @swmmac_same_acc() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[20:27], v[30:37], v[0:7]) {}
  v[0:7] = "st.v_swmmac_f32_16x16x64_f16"(v[40:47], v[50:65], v80) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- Two types with different rules in one chain.
# CHECK: violation: WMMA in function "bf16_then_f8_k128" block "entry"
# CHECK-SAME: switch the accumulator
st.func @bf16_then_f8_k128() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[20:27], v[30:37], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[40:55], v[56:71], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- Switched accumulator, d1 = A*B + d0, then d0 again.
# CHECK-NOT: "switched_accumulator"
st.func @switched_accumulator() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x64_fp8_fp8"(v[20:27], v[30:37], v[0:7]) {}
  v[40:47] = "st.v_wmma_f32_16x16x64_fp8_fp8"(v[50:57], v[60:67], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x64_fp8_fp8"(v[70:77], v[80:87], v[40:47]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- Same D, but C comes from elsewhere, so nothing is forwarded.
# CHECK-NOT: "same_d_other_c"
st.func @same_d_other_c() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x64_fp8_fp8"(v[20:27], v[30:37], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x64_fp8_fp8"(v[50:57], v[60:67], v[100:107]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- An independent WMMA in between breaks the chain.
# CHECK-NOT: "independent_wmma_between"
st.func @independent_wmma_between() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x64_fp8_fp8"(v[20:27], v[30:37], v[0:7]) {}
  v[40:47] = "st.v_wmma_f32_16x16x64_fp8_fp8"(v[50:57], v[60:67], v[40:47]) {}
  v[0:7] = "st.v_wmma_f32_16x16x64_fp8_fp8"(v[70:77], v[80:87], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#===----------------------------------------------------------------------===#
# Rule 2a: K=128 f8xf8, f8xf4, f4xf8, f6xf4, f4xf6 need different A and B.
#===----------------------------------------------------------------------===#

#--- Same A.
# CHECK: violation: WMMA in function "f8_k128_same_a" block "entry"
# CHECK-SAME: needs different A and B
st.func @f8_k128_same_a() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[20:35], v[36:51], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[20:35], v[68:83], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- Same B.
# CHECK: violation: WMMA in function "f8_k128_same_b" block "entry"
# CHECK-SAME: needs different A and B
st.func @f8_k128_same_b() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[20:35], v[36:51], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[52:67], v[36:51], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- The two A ranges partly overlap.
# CHECK: violation: WMMA in function "f8_k128_a_partly_overlaps" block "entry"
# CHECK-SAME: needs different A and B
st.func @f8_k128_a_partly_overlaps() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[20:35], v[36:51], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[28:43], v[68:83], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- A and B of the second WMMA overlap.
# CHECK: violation: WMMA in function "f8_k128_ab_overlap" block "entry"
# CHECK-SAME: A and B of one WMMA must not overlap
st.func @f8_k128_ab_overlap() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[20:35], v[36:51], v[0:7]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP8, fmtB = MATRIX_FMT_FP8 } }
  v[0:7] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[52:67], v[60:75], v[0:7]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP8, fmtB = MATRIX_FMT_FP8 } }
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- Every 2a type, one chain each, with different A and B.
# CHECK-NOT: "k128_different_ab"
st.func @k128_different_ab() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[20:35], v[36:51], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[52:67], v[68:83], v[0:7]) {}
  v[8:11] = "st.v_wmma_f16_16x16x128_bf8_fp8"(v[20:35], v[36:51], v[8:11]) {}
  v[8:11] = "st.v_wmma_f16_16x16x128_bf8_fp8"(v[52:67], v[68:83], v[8:11]) {}
  v[12:19] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[20:35], v[36:51], v[12:19]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP8, fmtB = MATRIX_FMT_BF8 } }
  v[12:19] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[52:67], v[68:83], v[12:19]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP8, fmtB = MATRIX_FMT_BF8 } }
  v[100:107] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[20:35], v[36:43], v[100:107]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP8, fmtB = MATRIX_FMT_FP4 } }
  v[100:107] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[52:67], v[68:75], v[100:107]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP8, fmtB = MATRIX_FMT_FP4 } }
  v[108:115] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[20:27], v[36:51], v[108:115]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP4, fmtB = MATRIX_FMT_FP8 } }
  v[108:115] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[52:59], v[68:83], v[108:115]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP4, fmtB = MATRIX_FMT_FP8 } }
  v[116:123] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[20:31], v[36:43], v[116:123]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP6, fmtB = MATRIX_FMT_FP4 } }
  v[116:123] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[52:63], v[68:75], v[116:123]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP6, fmtB = MATRIX_FMT_FP4 } }
  v[124:131] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[20:27], v[36:47], v[124:131]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP4, fmtB = MATRIX_FMT_BF6 } }
  v[124:131] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[52:59], v[68:79], v[124:131]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP4, fmtB = MATRIX_FMT_BF6 } }
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#===----------------------------------------------------------------------===#
# Rule 2b: f16, bf16, iu8 pair up.
#===----------------------------------------------------------------------===#

#--- Same B inside a pair.
# CHECK: violation: WMMA in function "bf16_same_b_in_pair" block "entry"
# CHECK-SAME: needs different A and B from its pair and the previous pair
st.func @bf16_same_b_in_pair() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[20:27], v[30:37], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[40:47], v[30:37], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- Same A inside a pair, f16.
# CHECK: violation: WMMA in function "f16_same_a_in_pair" block "entry"
# CHECK-SAME: needs different A and B from its pair and the previous pair
st.func @f16_same_a_in_pair() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x32_f16"(v[20:27], v[30:37], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x32_f16"(v[20:27], v[50:57], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- The second pair reuses the A of the previous pair's second WMMA, iu8.
# CHECK: violation: WMMA in function "iu8_reuses_previous_pair" block "entry"
# CHECK-SAME: needs different A and B from its pair and the previous pair
# CHECK: "st.v_wmma_i32_16x16x64_iu8"(v[40:47], v[90:97]
st.func @iu8_reuses_previous_pair() {
^entry:
  v[0:7] = "st.v_wmma_i32_16x16x64_iu8"(v[20:27], v[30:37], v[0:7]) {}
  v[0:7] = "st.v_wmma_i32_16x16x64_iu8"(v[40:47], v[50:57], v[0:7]) {}
  v[0:7] = "st.v_wmma_i32_16x16x64_iu8"(v[60:67], v[70:77], v[0:7]) {}
  v[0:7] = "st.v_wmma_i32_16x16x64_iu8"(v[40:47], v[90:97], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- An odd chain leaves its third WMMA unpaired.
# CHECK: violation: WMMA in function "bf16_odd_chain" block "entry"
# CHECK-SAME: must be paired with the next WMMA
# CHECK: "st.v_wmma_f32_16x16x32_bf16"(v[60:67]
st.func @bf16_odd_chain() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[20:27], v[30:37], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[40:47], v[50:57], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[60:67], v[70:77], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- A and B of the second WMMA overlap.
# CHECK: violation: WMMA in function "bf16_ab_overlap" block "entry"
# CHECK-SAME: A and B of one WMMA must not overlap
st.func @bf16_ab_overlap() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[20:27], v[30:37], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[40:47], v[44:51], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- Two pairs, every A and B different. The chain head's C is not forwarded;
#--- it still counts as the first half of the first pair.
# CHECK-NOT: "bf16_two_pairs"
st.func @bf16_two_pairs() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[20:27], v[30:37], v[100:107]) {}
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[40:47], v[50:57], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[60:67], v[70:77], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[80:87], v[90:97], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- A VALU inside the second pair does not split it.
# CHECK-NOT: "bf16_two_pairs_valu_inside"
st.func @bf16_two_pairs_valu_inside() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[20:27], v[30:37], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[40:47], v[50:57], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[60:67], v[70:77], v[0:7]) {}
  v100 = "st.v_add_f32"(v200, v201) { issueCycles = 1, latencyCycles = 5 }
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[80:87], v[90:97], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- One f16 pair and one iu8 pair.
# CHECK-NOT: "f16_and_iu8_pairs"
st.func @f16_and_iu8_pairs() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x32_f16"(v[20:27], v[30:37], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x32_f16"(v[40:47], v[50:57], v[0:7]) {}
  v[8:15] = "st.v_wmma_i32_16x16x64_iu8"(v[20:27], v[30:37], v[8:15]) {}
  v[8:15] = "st.v_wmma_i32_16x16x64_iu8"(v[40:47], v[50:57], v[8:15]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- A legal second pair in the next block: the check cannot see the first pair.
# CHECK: warning: WMMA in function "bf16_pair_across_blocks" block "next"
# CHECK-SAME: the pairs continue from another block and cannot be checked
st.func @bf16_pair_across_blocks() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[20:27], v[30:37], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[40:47], v[50:57], v[0:7]) {}
  "st.s_branch"("next")
  Successors: ^next
^next:
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[60:67], v[70:77], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[80:87], v[90:97], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- One bf16 accumulator per loop trip: the chain crosses the backedge.
# CHECK: warning: WMMA in function "bf16_loop_self_chain" block "loop"
# CHECK-SAME: the pairs continue from another block and cannot be checked
st.func @bf16_loop_self_chain() {
^entry:
  "st.s_branch"("loop")
  Successors: ^loop
^loop:
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[20:27], v[30:37], v[0:7]) {}
  "st.s_cbranch_scc1"("loop", SCC0)
  Successors: ^loop, ^exit
^exit:
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#===----------------------------------------------------------------------===#
# Rule 2c: 32x16x128 f4 has no requirement; 16x16x128 f4xf4 pairs up.
#===----------------------------------------------------------------------===#

#--- Same A.
# CHECK-NOT: "f4_32x16_same_a"
st.func @f4_32x16_same_a() {
^entry:
  v[0:7] = "st.v_wmma_scale_f32_32x16x128_f4"(v[20:27], v[30:37], v[0:7]) {}
  v[0:7] = "st.v_wmma_scale_f32_32x16x128_f4"(v[20:27], v[40:47], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- A and B of one WMMA overlap.
# CHECK-NOT: "f4_32x16_ab_overlap"
st.func @f4_32x16_ab_overlap() {
^entry:
  v[0:7] = "st.v_wmma_scale_f32_32x16x128_f4"(v[20:27], v[30:37], v[0:7]) {}
  v[0:7] = "st.v_wmma_scale_f32_32x16x128_f4"(v[40:47], v[44:51], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- Same B inside an f4xf4 pair.
# CHECK: violation: WMMA in function "f4xf4_same_b_in_pair" block "entry"
# CHECK-SAME: needs different A and B from its pair and the previous pair
st.func @f4xf4_same_b_in_pair() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[20:27], v[30:37], v[0:7]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP4, fmtB = MATRIX_FMT_FP4 } }
