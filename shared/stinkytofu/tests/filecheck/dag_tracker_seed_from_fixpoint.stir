# RUN: %stinkytofu-opt --arch gfx1250 %s --CFGBuilderPass --StinkyBuildImplicitDependencyPass --StinkyDAGSchedulerPass --wait-alu-scoreboard --enable-esm2-track-valu-vsrc --war-gate-via-tracker --no-ds-spread --tracker-seed-from-fixpoint --print-output
#
# dagFeatures.trackerSeedFromFixpoint: the loop top's tracker knows the previous iteration's last
# WMMA read v[100:107], so the WAR gate holds the ds_load for the src rule (9 WMMAs); unseeded it goes first.

# CHECK-LABEL: @seeded_loop_top_sees_the_back_edge
# CHECK: ^loop:
# CHECK: v[64:71] = "st.v_wmma_f32_16x16x32_bf16"
# CHECK-NOT: v_wmma
# CHECK: v[100:103] = "st.ds_load_b128"
# CHECK: v[72:79] = "st.v_wmma_f32_16x16x32_bf16"
st.func @seeded_loop_top_sees_the_back_edge() {
^entry:
  s0 = "st.s_mov_b32"(0) { issueCycles = 1, latencyCycles = 1 }
  Successors: ^loop
^loop:
  v[100:103] = "st.ds_load_b128"(v400) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[300:307], v[200:207], v[0:7]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[8:15] = "st.v_wmma_f32_16x16x32_bf16"(v[300:307], v[200:207], v[8:15]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[16:23] = "st.v_wmma_f32_16x16x32_bf16"(v[300:307], v[200:207], v[16:23]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[24:31] = "st.v_wmma_f32_16x16x32_bf16"(v[300:307], v[200:207], v[24:31]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[32:39] = "st.v_wmma_f32_16x16x32_bf16"(v[300:307], v[200:207], v[32:39]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[40:47] = "st.v_wmma_f32_16x16x32_bf16"(v[300:307], v[200:207], v[40:47]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[48:55] = "st.v_wmma_f32_16x16x32_bf16"(v[300:307], v[200:207], v[48:55]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[56:63] = "st.v_wmma_f32_16x16x32_bf16"(v[300:307], v[200:207], v[56:63]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[64:71] = "st.v_wmma_f32_16x16x32_bf16"(v[300:307], v[200:207], v[64:71]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[72:79] = "st.v_wmma_f32_16x16x32_bf16"(v[300:307], v[200:207], v[72:79]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[80:87] = "st.v_wmma_f32_16x16x32_bf16"(v[100:107], v[200:207], v[80:87]) { mod.mfma = { reuseA = false, reuseB = false } }
  "st.s_cbranch_scc1"("label_loop", SCC0)
  Successors: ^loop, ^exit
^exit:
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}
