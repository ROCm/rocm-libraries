# RUN: %stinkytofu-opt --arch gfx1250 %s --InsertWaitAluPass --print-output
#
# InsertWaitAluPass must disable SCHED_MODE=2 before s_swappc_b64 and then leave
# the remainder of the same block in mode0. In mode0 the hardware auto-stalls on
# GPR hazards, so an otherwise identical post-call VALU->VMEM RAW must not get a
# redundant s_wait_alu.

# CHECK-LABEL: @call_disables_mode2_and_suppresses_same_block_wait
# CHECK: hwreg(26,0,2) = "st.s_setreg_IMM32_b32"(2)
# CHECK: v_add_f32
# CHECK: s_wait_alu
# CHECK-SAME: va_vdst
# CHECK: buffer_load_b32
# CHECK: hwreg(26,0,2) = "st.s_setreg_IMM32_b32"(0)
# CHECK-NEXT: s_swappc_b64
# CHECK-NEXT: v_add_f32
# CHECK-NOT: s_wait_alu
# CHECK: buffer_load_b32

st.func @call_disables_mode2_and_suppresses_same_block_wait() {
^entry:
  v0 = "st.v_add_f32"(v1, v2) { issueCycles = 1, latencyCycles = 5 }
  v10 = "st.buffer_load_b32"(v0) { issueCycles = 1, latencyCycles = 100 }
  s[26:27] = "st.s_swappc_b64"(s[12:13]) { issueCycles = 1, latencyCycles = 2 }
  v3 = "st.v_add_f32"(v4, v5) { issueCycles = 1, latencyCycles = 5 }
  v11 = "st.buffer_load_b32"(v3) { issueCycles = 1, latencyCycles = 100 }
}
