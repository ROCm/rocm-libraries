# RUN: %stinkytofu-opt --arch gfx1250 %s --print-output
#
# Matrix-data-format-keyed hardware overrides for v_wmma_f32_16x16x128_f8f6f4.
#
# This instruction carries two format-dependent hardware properties (from the
# Gfx1250 .def):
#   .cost          = {1, 8}   .costOverride     = { {FP4,FP4}, 1, 4 }
#   .coissue       = 0x00C8   .coissueOverride  = { {FP4,FP4}, 0x0008 }
#
# When both matrix operands are FP4, the op is cheaper (latency 8 -> 4) and its
# VALU co-issue window shrinks (X X X I X X I I -> X X X I). These are hardware
# facts of the instruction, so they must be resolved onto the instruction at
# construction time and visible to every pass. The latency is observable in the
# printed IR; assert both the FP4xFP4 (overridden) and FP8xFP8 (default) forms.
#
# CHECK-LABEL: @override
#
# FP4xFP4: cost override applies -> latencyCycles = 4
# CHECK: v_wmma_f32_16x16x128_f8f6f4
# CHECK-SAME: latencyCycles = 4
# CHECK-SAME: fmtA = "MATRIX_FMT_FP4"
# CHECK-SAME: fmtB = "MATRIX_FMT_FP4"
#
# FP8xFP8: no override -> default latencyCycles = 8
# CHECK: v_wmma_f32_16x16x128_f8f6f4
# CHECK-SAME: latencyCycles = 8
# CHECK-SAME: fmtA = "MATRIX_FMT_FP8"
# CHECK-SAME: fmtB = "MATRIX_FMT_FP8"

st.func @override() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[20:35], v[30:45], v[0:7]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP4, fmtB = MATRIX_FMT_FP4 } }
  v[8:15] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[20:35], v[30:45], v[8:15]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP8, fmtB = MATRIX_FMT_FP8 } }
}
