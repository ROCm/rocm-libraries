# RUN: %stinkytofu-opt --arch gfx1250 %s --InsertClusterBarrierPass=streamKMulticast --print-output
#
# Multicast ON: the paired positive control for
# cluster_barrier_multicast_off_no_cooperative_drain.stir. Same input, same
# pass, one pass argument different -- so the pair proves the multicast
# predicate actually discriminates instead of a single fixture passing for
# whatever reason the pass happens to have.
#
# With multicast on, the TDM broadcast is real and both drains are owed:
#   1. prologue TDM drain before the LDS ping-pong s_xor_b32
#   2. producer drain after the cooperative tensor_load group, so the async load
#      is retired before the back edge republishes LDS
# and the Rule 1/2/3 handshakes are suppressed instead: the multicast kernel
# does its own prologue -3 wait, and an arrive emitted here would unbalance it.
# Hence the -3 CHECK-NOTs -- a lone half of a signal/wait pair leaking through
# this gate is a deadlock, not a slowdown.

# CHECK-LABEL: @cluster_barrier_multicast_on_cooperative_drain

# CHECK-NOT: "st.s_barrier_signal"(-3)
# CHECK-NOT: "st.s_barrier_wait"(-3)

# Drain site 1: prologue TDM retired before the ping-pong XOR.
# CHECK: "st.tensor_load_to_lds"(s[60:63]
# CHECK-NEXT: s_wait_tensorcnt
# CHECK-SAME: tlcnt = 0
# CHECK-NEXT: s_xor_b32

# CHECK-NOT: "st.s_barrier_signal"(-3)
# CHECK-NOT: "st.s_barrier_wait"(-3)

# Drain site 2: cooperative group retired before the back edge.
# CHECK: "st.tensor_load_to_lds"(s[0:3]
# CHECK-NEXT: s_wait_tensorcnt
# CHECK-SAME: tlcnt = 0

# CHECK-NOT: "st.s_barrier_signal"(-3)
# CHECK-NOT: "st.s_barrier_wait"(-3)

st.func @cluster_barrier_multicast_on_cooperative_drain() {
^entry:
label_GSU_1:
  a[24:31] = "st.v_wmma_f32_16x16x32_bf16"(v[0:7], v[8:15], a[24:31]) { mod.mfma = { reuseA = false, reuseB = false } }
  "st.tensor_load_to_lds"(s[60:63], s[64:71]) { issueCycles = 1, latencyCycles = 1, mod.memtoken = { tokens = [0] } }
  s1 = "st.s_xor_b32"(s1, 65536) { issueCycles = 1, latencyCycles = 1 }
label_PreLoopJoin:
  a[32:39] = "st.v_wmma_f32_16x16x32_bf16"(v[8:15], v[16:23], a[32:39]) { mod.mfma = { reuseA = false, reuseB = false } }
label_TestLoop:
  a[40:47] = "st.v_wmma_f32_16x16x32_bf16"(v[0:7], v[8:15], a[40:47]) { mod.mfma = { reuseA = false, reuseB = false } }
  "st.s_barrier_signal"(-1) { issueCycles = 1, latencyCycles = 1 }
  "st.s_barrier_wait"(-1) { issueCycles = 1, latencyCycles = 1 }
  "st.tensor_load_to_lds"(s[0:3], s[4:11]) { issueCycles = 1, latencyCycles = 1, mod.memtoken = { tokens = [0] } }
  a[48:55] = "st.v_wmma_f32_16x16x32_bf16"(v[8:15], v[0:7], a[48:55]) { mod.mfma = { reuseA = false, reuseB = false } }
  SCC0 = "st.s_cmp_eq_u32"(s91, 0) { issueCycles = 1, latencyCycles = 1 }
  "st.s_cbranch_scc1"(label_TestLoopEnd, SCC0) { issueCycles = 1, latencyCycles = 1 }
  SCC0 = "st.s_cmp_eq_u32"(s92, 0) { issueCycles = 1, latencyCycles = 1 }
  "st.s_cbranch_scc0"(label_TestLoop, SCC0) { issueCycles = 1, latencyCycles = 1 }
label_TestLoopEnd:
  a[8:15] = "st.v_wmma_f32_16x16x32_bf16"(v[0:7], v[8:15], a[8:15]) { mod.mfma = { reuseA = false, reuseB = false } }
}
