# RUN: %stinkytofu-opt --arch gfx1250 %s --StinkyRemoveWaitCntPass=removeXcnt --print-output
#
# removeXcnt is the O3 policy in Gfx1250Backend, where the hazard pass owns xcnt
# placement and hand-authored drains should not survive.
#
# kmcnt stays kept, pinning the two exemptions as independent.
#
# Default policy: remove_waitcnt_test.stir.

# CHECK-LABEL: @strips_xcnt_keeps_kmcnt
# CHECK: s_wait_kmcnt
# CHECK-NEXT: v_add_f32
# CHECK-NOT: s_wait_xcnt

st.func @strips_xcnt_keeps_kmcnt() {
^entry:
  "st.s_wait_xcnt"(0)
  "st.s_wait_kmcnt"(0)
  "st.s_wait_xcnt"(0)
  v0 = "st.v_add_f32"(v1, v2)
}
