# RUN: %stinkytofu-opt --arch gfx1250 %s --InsertWaitAluPass=enableESM2TrackValuVsrc --print-output
#
# The dst (writeback) rules of every gfx1250 form, from the user's table. Per form three rules
# may hide a RAW / WAW consumer's va_vdst: matrix ops alone (pure), a lead of matrix ops then a
# tail of slots (mix; a VALU fills one, a scaled matrix op two, an unscaled one one), or VALUs
# with no order (valu, 21 for every form; a matrix op never fills one of its slots, so a mixed
# sequence is judged by the pure and mixed rules only).
#   4/8/no  13 (6,7) 21 | 4/8/MX 8 (5,6) 21 s2 | 8/8/no 12 (5,7) 21 | 8/8/MX 7 (4,6) 21 s2
#   8/16/MX 7 (3,8) 21 s2 | 16/8/no 12 (5,7) 21
# The waits here count the producer's own pipe only (no shared-order option on the RUN line).

#===----------------------------------------------------------------------===#
# 21 VALUs after a v_mov hide its writeback for the store, no matrix op needed past the latch.
#===----------------------------------------------------------------------===#
# CHECK-LABEL: @vdst_valu_only_21_hides
# CHECK-NOT: s_wait_alu{{.*}}va_vdst
# CHECK: ds_store_b32
st.func @vdst_valu_only_21_hides() {
^entry:
  v[88:95] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[300:315], v[316:331], v[88:95]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v0 = "st.v_mov_b32"(v5) { issueCycles = 1, latencyCycles = 1 }
  v200 = "st.v_add_f32"(v230, v230) { issueCycles = 1, latencyCycles = 5 }
  v201 = "st.v_add_f32"(v231, v231) { issueCycles = 1, latencyCycles = 5 }
  v202 = "st.v_add_f32"(v232, v232) { issueCycles = 1, latencyCycles = 5 }
  v203 = "st.v_add_f32"(v233, v233) { issueCycles = 1, latencyCycles = 5 }
  v204 = "st.v_add_f32"(v234, v234) { issueCycles = 1, latencyCycles = 5 }
  v205 = "st.v_add_f32"(v235, v235) { issueCycles = 1, latencyCycles = 5 }
  v206 = "st.v_add_f32"(v236, v236) { issueCycles = 1, latencyCycles = 5 }
  v207 = "st.v_add_f32"(v237, v237) { issueCycles = 1, latencyCycles = 5 }
  v208 = "st.v_add_f32"(v238, v238) { issueCycles = 1, latencyCycles = 5 }
  v209 = "st.v_add_f32"(v239, v239) { issueCycles = 1, latencyCycles = 5 }
  v210 = "st.v_add_f32"(v240, v240) { issueCycles = 1, latencyCycles = 5 }
  v211 = "st.v_add_f32"(v241, v241) { issueCycles = 1, latencyCycles = 5 }
  v212 = "st.v_add_f32"(v242, v242) { issueCycles = 1, latencyCycles = 5 }
  v213 = "st.v_add_f32"(v243, v243) { issueCycles = 1, latencyCycles = 5 }
  v214 = "st.v_add_f32"(v244, v244) { issueCycles = 1, latencyCycles = 5 }
  v215 = "st.v_add_f32"(v245, v245) { issueCycles = 1, latencyCycles = 5 }
  v216 = "st.v_add_f32"(v246, v246) { issueCycles = 1, latencyCycles = 5 }
  v217 = "st.v_add_f32"(v247, v247) { issueCycles = 1, latencyCycles = 5 }
  v218 = "st.v_add_f32"(v248, v248) { issueCycles = 1, latencyCycles = 5 }
  v219 = "st.v_add_f32"(v249, v249) { issueCycles = 1, latencyCycles = 5 }
  v220 = "st.v_add_f32"(v250, v250) { issueCycles = 1, latencyCycles = 5 }
  "st.ds_store_b32"(v7, v0) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
}

