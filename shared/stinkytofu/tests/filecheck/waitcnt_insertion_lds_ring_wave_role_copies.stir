# RUN: %stinkytofu-opt --arch gfx1250 %s --NumWaves=4 --StinkyBuildImplicitDependencyPass --StinkyWaitCntInsertionPass --print-output
#
# The (4, 2) wave-separated ring with the main-loop fence repeated three times
# per trip and the frame advanced by three on the back edge, the shape a
# three-way loop copy (HalfPLR) gives the ring. Every copy waits A/B 2/0.
#
# CHECK-LABEL: @waitcnt_insertion_lds_ring_wave_role_copies
# CHECK-LABEL: ^fence0_even:
# CHECK-NEXT: s_branch
# CHECK-LABEL: ^fence0_odd:
# CHECK-NEXT: s_wait_tensorcnt
# CHECK-SAME: tlcnt = 0
# CHECK-LABEL: ^fence0:
# CHECK-NEXT: s_wait_tensorcnt
# CHECK-SAME: tlcnt = 2
# CHECK-NEXT: s_barrier_signal
# CHECK-LABEL: ^fence1_even:
# CHECK-NEXT: s_branch
# CHECK-LABEL: ^fence1_odd:
# CHECK-NEXT: s_wait_tensorcnt
# CHECK-SAME: tlcnt = 0
# CHECK-LABEL: ^fence1:
# CHECK-NEXT: s_wait_tensorcnt
# CHECK-SAME: tlcnt = 2
# CHECK-NEXT: s_barrier_signal
# CHECK-LABEL: ^fence2_even:
# CHECK-NEXT: s_branch
# CHECK-LABEL: ^fence2_odd:
# CHECK-NEXT: s_wait_tensorcnt
# CHECK-SAME: tlcnt = 0
# CHECK-LABEL: ^fence2:
# CHECK-NEXT: s_wait_tensorcnt
# CHECK-SAME: tlcnt = 2
# CHECK-NEXT: s_barrier_signal

st.func @waitcnt_insertion_lds_ring_wave_role_copies() {
^entry:
  "st.tensor_load_to_lds"(s[0:3], s[8:15]) { mod.memtoken = { tokens = [0,4] }, mod.lds_ring = { accesses = [0,0,4,0,1,1,0,2,0,1], advances = [], waves = [5,10] } }
  "st.tensor_load_to_lds"(s[0:3], s[8:15]) { mod.memtoken = { tokens = [1,5] }, mod.lds_ring = { accesses = [0,0,4,1,1,1,0,2,1,1], advances = [], waves = [5,10] } }
  SCC0 = "st.s_cmp_eq_u32"(s50, 0x1)
  "st.s_cbranch_scc1"("pro_join", SCC0) { mod.wave_role = { taken = 10, fallthrough = 5 } }
  Successors: ^pro_join, ^pro_deep
^pro_deep:
  "st.tensor_load_to_lds"(s[0:3], s[8:15]) { mod.memtoken = { tokens = [2] }, mod.lds_ring = { accesses = [0,0,4,2,1], advances = [], waves = [5] } }
  "st.tensor_load_to_lds"(s[0:3], s[8:15]) { mod.memtoken = { tokens = [3] }, mod.lds_ring = { accesses = [0,0,4,3,1], advances = [], waves = [5] } }
  Successors: ^pro_join
^pro_join:
  SCC1 = "st.s_cmp_eq_u32"(s50, 0x1)
  "st.s_cbranch_scc1"("pro_odd", SCC1) { mod.wave_role = { taken = 10, fallthrough = 5 } }
  Successors: ^pro_odd, ^pro_even
^pro_even:
  "st.s_branch"("pro_pub")
  Successors: ^pro_pub
^pro_odd:
  Successors: ^pro_pub
^pro_pub:
  "st.s_barrier_signal"(-1) { mod.memtoken = { tokens = [0,4] }, mod.lds_ring = { accesses = [0,0,4,0,2,1,0,2,0,2], advances = [], waves = [5,10] } }
  "st.s_barrier_wait"(-1) { mod.memtoken = { tokens = [0,4] } }
  "st.s_branch"("loop")
  Successors: ^loop
^loop:
  SCC2 = "st.s_cmp_eq_u32"(s50, 0x1)
  "st.s_cbranch_scc1"("fence0_odd", SCC2) { mod.wave_role = { taken = 10, fallthrough = 5 } }
  Successors: ^fence0_odd, ^fence0_even
^fence0_even:
  "st.s_branch"("fence0")
  Successors: ^fence0
^fence0_odd:
  Successors: ^fence0
^fence0:
  "st.s_barrier_signal"(-1) { mod.memtoken = { tokens = [0,1,4,5] }, mod.lds_ring = { accesses = [0,0,4,1,2,1,0,2,1,2,0,0,4,0,3,1,0,2,0,3], advances = [], waves = [5,10,5,10] } }
  "st.s_barrier_wait"(-1) { mod.memtoken = { tokens = [0,1,4,5] } }
  "st.tensor_load_to_lds"(s[0:3], s[8:15]) { mod.memtoken = { tokens = [0,4] }, mod.lds_ring = { accesses = [0,0,4,4,1,1,0,2,2,1], advances = [], waves = [5,10] } }
  SCC3 = "st.s_cmp_eq_u32"(s50, 0x1)
  "st.s_cbranch_scc1"("fence1_odd", SCC3) { mod.wave_role = { taken = 10, fallthrough = 5 } }
  Successors: ^fence1_odd, ^fence1_even
^fence1_even:
  "st.s_branch"("fence1")
  Successors: ^fence1
^fence1_odd:
  Successors: ^fence1
^fence1:
  "st.s_barrier_signal"(-1) { mod.memtoken = { tokens = [1,2,4,5] }, mod.lds_ring = { accesses = [0,0,4,2,2,1,0,2,2,2,0,0,4,1,3,1,0,2,1,3], advances = [], waves = [5,10,5,10] } }
  "st.s_barrier_wait"(-1) { mod.memtoken = { tokens = [1,2,4,5] } }
  "st.tensor_load_to_lds"(s[0:3], s[8:15]) { mod.memtoken = { tokens = [1,5] }, mod.lds_ring = { accesses = [0,0,4,5,1,1,0,2,3,1], advances = [], waves = [5,10] } }
  SCC4 = "st.s_cmp_eq_u32"(s50, 0x1)
  "st.s_cbranch_scc1"("fence2_odd", SCC4) { mod.wave_role = { taken = 10, fallthrough = 5 } }
  Successors: ^fence2_odd, ^fence2_even
^fence2_even:
  "st.s_branch"("fence2")
  Successors: ^fence2
^fence2_odd:
  Successors: ^fence2
^fence2:
  "st.s_barrier_signal"(-1) { mod.memtoken = { tokens = [2,3,4,5] }, mod.lds_ring = { accesses = [0,0,4,3,2,1,0,2,3,2,0,0,4,2,3,1,0,2,2,3], advances = [], waves = [5,10,5,10] } }
  "st.s_barrier_wait"(-1) { mod.memtoken = { tokens = [2,3,4,5] } }
  "st.tensor_load_to_lds"(s[0:3], s[8:15]) { mod.memtoken = { tokens = [2,4] }, mod.lds_ring = { accesses = [0,0,4,6,1,1,0,2,4,1], advances = [], waves = [5,10] } }
  SCC5 = "st.s_cmp_eq_u32"(s60, 0x1)
  "st.s_cbranch_scc1"("loop", SCC5) { mod.lds_ring = { accesses = [], advances = [0,3] } }
  Successors: ^loop, ^ngll0
^ngll0:
  SCC6 = "st.s_cmp_eq_u32"(s50, 0x1)
  "st.s_cbranch_scc1"("ngll0_odd", SCC6) { mod.wave_role = { taken = 10, fallthrough = 5 } }
  Successors: ^ngll0_odd, ^ngll0_even
^ngll0_even:
  "st.s_branch"("ngll0_pub")
  Successors: ^ngll0_pub
^ngll0_odd:
  Successors: ^ngll0_pub
^ngll0_pub:
  "st.s_barrier_signal"(-1) { mod.memtoken = { tokens = [0,4] }, mod.lds_ring = { accesses = [0,0,4,4,2,1,0,2,4,2], advances = [], waves = [5,10] } }
  "st.s_barrier_wait"(-1) { mod.memtoken = { tokens = [0,4] } }
  Successors: ^exit
^exit:
}
