# RUN: %stinkytofu-opt --arch gfx1250 %s --InsertWaitAluPass=enableESM2TrackValuVsrc --print-output
#
# Enough matrix ops between a VA producer and its consumer satisfy the va_vdst wait, so
# none is emitted. The counts come from the arch's WaitHide rows.

#===----------------------------------------------------------------------===#
# 12 matrix ops after a matrix producer: hidden, no wait.
#===----------------------------------------------------------------------===#
# CHECK-LABEL: @gfx1250_xdl_hidden_12_wmma_no_wait
# CHECK: v_wmma_f32_16x16x32_bf16
# CHECK-NOT: s_wait_alu{{.*}}va_vdst
# CHECK: ds_load_b32

st.func @gfx1250_xdl_hidden_12_wmma_no_wait() {
^entry:
  v[0:7]    = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[0:7]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[8:15]   = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[8:15]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[16:23]  = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[16:23]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[24:31]  = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[24:31]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[32:39]  = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[32:39]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[40:47]  = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[40:47]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[48:55]  = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[48:55]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[56:63]  = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[56:63]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[64:71]  = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[64:71]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[72:79]  = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[72:79]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[80:87]  = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[80:87]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[88:95]  = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[88:95]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[96:103] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[96:103]) { mod.mfma = { reuseA = false, reuseB = false } }
  v110 = "st.ds_load_b32"(v0) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
}

