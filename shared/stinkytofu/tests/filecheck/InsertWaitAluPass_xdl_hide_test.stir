#===----------------------------------------------------------------------===#
# CSMACC (plain VALU) producer, hidden by WMMA rather than by its own pipe. It needs
# kCsmaccVaVdstHideWmmas (13) intervening WMMA -- one more than an XDL producer.
# 12 WMMA is one short, so the wait IS emitted.
#===----------------------------------------------------------------------===#
# CHECK-LABEL: @csmacc_hidden_12_wmma_waits
# CHECK: v_add_f32
# CHECK: s_wait_alu
# CHECK-SAME: va_vdst
# CHECK: ds_load_b32

st.func @csmacc_hidden_12_wmma_waits() {
^entry:
