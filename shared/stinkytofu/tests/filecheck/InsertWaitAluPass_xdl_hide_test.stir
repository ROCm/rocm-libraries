#===----------------------------------------------------------------------===#
# Non-XDL producer is unaffected: a CSMACC (v_add_f32) producer with 12 later
# CSMACC still gets its normal va_vdst wait -- the skip is XDL-only.
#===----------------------------------------------------------------------===#
# CHECK-LABEL: @csmacc_producer_not_skipped
# CHECK: v_add_f32
# CHECK: s_wait_alu
# CHECK-SAME: va_vdst
# CHECK: ds_load_b32

st.func @csmacc_producer_not_skipped() {
^entry:
  v0  = "st.v_add_f32"(v1, v2) { issueCycles = 1, latencyCycles = 5 }
  v3  = "st.v_add_f32"(v4, v5) { issueCycles = 1, latencyCycles = 5 }
  v6  = "st.v_add_f32"(v7, v8) { issueCycles = 1, latencyCycles = 5 }
  v9  = "st.v_add_f32"(v10, v11) { issueCycles = 1, latencyCycles = 5 }
  v12 = "st.v_add_f32"(v13, v14) { issueCycles = 1, latencyCycles = 5 }
  v15 = "st.v_add_f32"(v16, v17) { issueCycles = 1, latencyCycles = 5 }
  v18 = "st.v_add_f32"(v19, v20) { issueCycles = 1, latencyCycles = 5 }
  v21 = "st.v_add_f32"(v22, v23) { issueCycles = 1, latencyCycles = 5 }
  v24 = "st.v_add_f32"(v25, v26) { issueCycles = 1, latencyCycles = 5 }
  v27 = "st.v_add_f32"(v28, v29) { issueCycles = 1, latencyCycles = 5 }
  v30 = "st.v_add_f32"(v31, v32) { issueCycles = 1, latencyCycles = 5 }
  v33 = "st.v_add_f32"(v34, v35) { issueCycles = 1, latencyCycles = 5 }
  v36 = "st.v_add_f32"(v37, v38) { issueCycles = 1, latencyCycles = 5 }
  v110 = "st.ds_load_b32"(v0) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
}

#===----------------------------------------------------------------------===#
# Scale-pair producer. MC_VOP3PX2/PX3 step the XDL ordinal by 2, so the threshold
# is a count of instructions and scales with it. 6 scale WMMA after the producer
# are 12 ordinal but only 6 instructions -- below the 12 the rule asks for, so the
# wait IS emitted (va_vdst = 12, the raw ordinal distance).
#===----------------------------------------------------------------------===#
# CHECK-LABEL: @xdl_scale_pair_6_wmma_waits
# CHECK: v_wmma_scale_f32_16x16x128_f8f6f4
# CHECK: s_wait_alu
# CHECK-SAME: va_vdst = 12
# CHECK: ds_load_b32

st.func @xdl_scale_pair_6_wmma_waits() {
^entry:
  v[0:7] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[300:315], v[316:331], v[0:7], v220, v221) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
  v[8:15] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[300:315], v[316:331], v[8:15], v220, v221) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
  v[16:23] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[300:315], v[316:331], v[16:23], v220, v221) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
  v[24:31] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[300:315], v[316:331], v[24:31], v220, v221) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
  v[32:39] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[300:315], v[316:331], v[32:39], v220, v221) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
  v[40:47] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[300:315], v[316:331], v[40:47], v220, v221) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
  v[48:55] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[300:315], v[316:331], v[48:55], v220, v221) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
  v340 = "st.ds_load_b32"(v0) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
}

