#===----------------------------------------------------------------------===#
# The CSMACC rule infers completion order across pipes, which only holds while XDL
# and CSMACC are the only pipes in flight. A live TRANS op (v_rcp_f32, never waited
# on) breaks that, so the wait IS emitted despite 13 intervening WMMA.
#===----------------------------------------------------------------------===#
# CHECK-LABEL: @csmacc_not_hidden_when_trans_inflight
# CHECK: v_add_f32
# CHECK: s_wait_alu
# CHECK-SAME: va_vdst
# CHECK: ds_load_b32

st.func @csmacc_not_hidden_when_trans_inflight() {
^entry:
  v0 = "st.v_add_f32"(v1, v2) { issueCycles = 1, latencyCycles = 5 }
  v191 = "st.v_rcp_f32"(v192) { issueCycles = 1, latencyCycles = 10 }
  v[8:15] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[8:15]) { mod.mfma = { reuseA = false, reuseB = false } }
