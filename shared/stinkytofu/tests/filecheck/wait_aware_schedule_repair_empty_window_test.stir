# RUN: %stinkytofu-opt --arch gfx1250 %s --WaitAwareScheduleRepairPass --print-output
#
# A wait-less WMMA whose window the DAG left empty takes one carried
# instruction, so the carry drains through empty windows instead of being
# forwarded to the end of the segment.
#
# WMMA1 carries a wait and gives up one slot, so s61 is carried. WMMA2 has no
# wait and an empty window: it takes s61. WMMA3 then has neither a wait nor any
# carry and keeps its original, empty window.
#
# CHECK-LABEL: @wait_aware_schedule_repair_empty_window
# CHECK: v_wmma_f32_16x16x32_bf16
# CHECK-NEXT: ds_load_b128
# CHECK-NEXT: ds_load_b128
# CHECK-NEXT: s60 = "st.s_mov_b32"
# CHECK-NEXT: s_wait_dscnt
# CHECK-NEXT: v_wmma_f32_16x16x32_bf16
# CHECK-NEXT: s61 = "st.s_mov_b32"
# CHECK-NEXT: v_wmma_f32_16x16x32_bf16
# CHECK-NEXT: v_wmma_f32_16x16x32_bf16
# CHECK-NOT: s_mov_b32

st.func @wait_aware_schedule_repair_empty_window() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[400:407], v[0:7]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }

  v[100:103] = "st.ds_load_b128"(v50, LDS0) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  v[104:107] = "st.ds_load_b128"(v50, LDS0) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 16, gds = false }, mod.memtoken = { tokens = [0] } }
  s60 = "st.s_mov_b32"(60) { issueCycles = 1, latencyCycles = 2 }
  s61 = "st.s_mov_b32"(61) { issueCycles = 1, latencyCycles = 2 }
  "st.s_wait_dscnt"(1) { issueCycles = 1, latencyCycles = 1, mod.swaitcnt = { vlcnt = -1, vscnt = -1, dlcnt = 1, dscnt = -1, kmcnt = -1 } }
  v[8:15] = "st.v_wmma_f32_16x16x32_bf16"(v[208:215], v[400:407], v[8:15]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }

  v[16:23] = "st.v_wmma_f32_16x16x32_bf16"(v[216:223], v[400:407], v[16:23]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }

  v[24:31] = "st.v_wmma_f32_16x16x32_bf16"(v[224:231], v[400:407], v[24:31]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
}
