#===----------------------------------------------------------------------===#
# A scaled matrix op past the lead fills more than one tail slot, so fewer VALUs are needed.
#===----------------------------------------------------------------------===#
# CHECK-LABEL: @gfx1250_mix_mx_matrix_op_fills_more_slots
# CHECK-NOT: s_wait_alu{{.*}}va_vdst
# CHECK: ds_load_b32

st.func @gfx1250_mix_mx_matrix_op_fills_more_slots() {
^entry:
  v[0:7] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[300:315], v[316:331], v[0:7], v290, v291) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
  v[8:15] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[300:315], v[316:331], v[8:15], v290, v291) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
  v[16:23] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[300:315], v[316:331], v[16:23], v290, v291) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
  v[24:31] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[300:315], v[316:331], v[24:31], v290, v291) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
  v[32:39] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[300:315], v[316:331], v[32:39], v290, v291) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
  v[40:47] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[300:315], v[316:331], v[40:47], v290, v291) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
  v200 = "st.v_add_f32"(v220, v220) { issueCycles = 1, latencyCycles = 5 }
  v201 = "st.v_add_f32"(v221, v221) { issueCycles = 1, latencyCycles = 5 }
  v202 = "st.v_add_f32"(v222, v222) { issueCycles = 1, latencyCycles = 5 }
  v203 = "st.v_add_f32"(v223, v223) { issueCycles = 1, latencyCycles = 5 }
  v260 = "st.ds_load_b32"(v0) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
}

#===----------------------------------------------------------------------===#
# A transcendental and an f64 FMA between the producer and the wmma count of matrix ops: the
# matrix count still hides.
#===----------------------------------------------------------------------===#
# CHECK-LABEL: @dp_trans_do_not_block_matrix_hide
# CHECK-NOT: s_wait_alu{{.*}}va_vdst
# CHECK: ds_load_b32
st.func @dp_trans_do_not_block_matrix_hide() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[300:315], v[316:331], v[0:7]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v240 = "st.v_rcp_f32"(v241) { issueCycles = 1, latencyCycles = 8 }
  v[242:243] = "st.v_fma_f64"(v[244:245], v[246:247], v[248:249]) { issueCycles = 1, latencyCycles = 32 }
