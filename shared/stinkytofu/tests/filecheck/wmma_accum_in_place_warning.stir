# RUN: %stinkytofu-opt --arch gfx1250 %s --InsertCoexecHazardPass 2>&1
#
# gfx1250 requires a WMMA that takes the previous WMMA's D through the C
# fast-forward path to write a different accumulator (d1 = A*B + d0), unless its
# type allows the same one (d0 = A*B + d0):
#   - K=128 f8xf8, f8xf4, f4xf8, f6xf4, f4xf6: neighbors use different A and B.
#   - f16, bf16, iu8, 16x16x128 f4xf4: WMMAs pair up (one 2xK tile each), with
#     different A and B within a pair and from the previous pair.
#   - 32x16x128 f4: no requirement.
# Where the same accumulator is allowed, A and B of one WMMA must not overlap.
# Only WMMAs count toward "previous". InsertCoexecHazardPass warns on a violation
# and leaves the code alone.
#
# Functions that warn come first; the trailing CHECK-NOT covers the safe ones.

# CHECK: function "f8_k64_valu_between" block "entry" accumulates the previous WMMA's D in place: switch the accumulator
# CHECK: function "f6xf6" block "entry" accumulates the previous WMMA's D in place: switch the accumulator
# CHECK: function "swmmac" block "entry" accumulates the previous WMMA's D in place: switch the accumulator
# CHECK: function "f8_k128_same_a" block "entry" accumulates the previous WMMA's D in place: needs different A and B
# CHECK: function "f8_k128_ab_overlap" block "entry" accumulates the previous WMMA's D in place: A and B of one WMMA must not overlap
# CHECK: function "bf16_same_b_in_pair" block "entry" accumulates the previous WMMA's D in place: needs different A and B from its pair and the previous pair
# CHECK: function "bf16_reuses_previous_pair" block "entry" accumulates the previous WMMA's D in place: needs different A and B from its pair and the previous pair
# CHECK: function "bf16_odd_chain" block "entry" accumulates the previous WMMA's D in place: must be paired with the next WMMA
# CHECK: function "f4xf4_16x16_odd_chain" block "entry" accumulates the previous WMMA's D in place: must be paired with the next WMMA
# CHECK: function "bf16_loop_self_chain" block "loop" accumulates the previous WMMA's D in place: the pairs continue from another block and cannot be checked
# CHECK-NOT: warning:

#--- K=64 f8 has no allowance. A VALU in between does not separate the WMMAs.
st.func @f8_k64_valu_between() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x64_fp8_fp8"(v[20:27], v[30:37], v[0:7]) {}
  v100 = "st.v_add_f32"(v200, v201) { issueCycles = 1, latencyCycles = 5 }
  v[0:7] = "st.v_wmma_f32_16x16x64_fp8_fp8"(v[40:47], v[50:57], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- f6xf6 has no allowance.
st.func @f6xf6() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[20:31], v[36:47], v[0:7]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP6, fmtB = MATRIX_FMT_FP6 } }
  v[0:7] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[52:63], v[68:79], v[0:7]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP6, fmtB = MATRIX_FMT_FP6 } }
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- SWMMAC accumulates into its own D, so a matching D alone is the chain.
st.func @swmmac() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[20:27], v[30:37], v[0:7]) {}
  v[0:7] = "st.v_swmmac_f32_16x16x64_f16"(v[40:47], v[50:65], v80) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- K=128 f8xf8 reuses A.
st.func @f8_k128_same_a() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[20:35], v[36:51], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[20:35], v[68:83], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- K=128 f8xf8 with different A and B, but A and B of the second WMMA overlap.
st.func @f8_k128_ab_overlap() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[20:35], v[36:51], v[0:7]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP8, fmtB = MATRIX_FMT_FP8 } }
  v[0:7] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[52:67], v[60:75], v[0:7]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP8, fmtB = MATRIX_FMT_FP8 } }
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- bf16 pair reuses B.
st.func @bf16_same_b_in_pair() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[20:27], v[30:37], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[40:47], v[30:37], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- The second pair's last WMMA reuses A from the first pair.
st.func @bf16_reuses_previous_pair() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[20:27], v[30:37], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[40:47], v[50:57], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[60:67], v[70:77], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[20:27], v[90:97], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- Three bf16 WMMAs: the third has no partner.
st.func @bf16_odd_chain() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[20:27], v[30:37], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[40:47], v[50:57], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[60:67], v[70:77], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- 16x16x128 f4xf4 pairs like bf16: the third has no partner.
st.func @f4xf4_16x16_odd_chain() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[20:27], v[30:37], v[0:7]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP4, fmtB = MATRIX_FMT_FP4 } }
  v[0:7] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[40:47], v[50:57], v[0:7]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP4, fmtB = MATRIX_FMT_FP4 } }
  v[0:7] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[60:67], v[70:77], v[0:7]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP4, fmtB = MATRIX_FMT_FP4 } }
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- One bf16 accumulator per loop trip: the chain crosses the backedge.
st.func @bf16_loop_self_chain() {
^entry:
  "st.s_branch"("loop")
  Successors: ^loop
^loop:
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[20:27], v[30:37], v[0:7]) {}
  "st.s_cbranch_scc1"("loop", SCC0)
  Successors: ^loop, ^exit
^exit:
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- Safe: switched accumulator, d1 = A*B + d0.
st.func @switched_accumulator() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x64_fp8_fp8"(v[20:27], v[30:37], v[0:7]) {}
  v[40:47] = "st.v_wmma_f32_16x16x64_fp8_fp8"(v[50:57], v[60:67], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x64_fp8_fp8"(v[70:77], v[80:87], v[40:47]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- Safe: same D, but C comes from elsewhere, so nothing is forwarded.
st.func @same_d_other_c() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x64_fp8_fp8"(v[20:27], v[30:37], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x64_fp8_fp8"(v[50:57], v[60:67], v[100:107]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- Safe: an independent WMMA separates the two d0 WMMAs.
st.func @independent_wmma_between() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x64_fp8_fp8"(v[20:27], v[30:37], v[0:7]) {}
  v[40:47] = "st.v_wmma_f32_16x16x64_fp8_fp8"(v[50:57], v[60:67], v[40:47]) {}
  v[0:7] = "st.v_wmma_f32_16x16x64_fp8_fp8"(v[70:77], v[80:87], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- Safe: K=128 f8xf8, then f6xf4, each with different A and B.
st.func @k128_different_ab() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[20:35], v[36:51], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[52:67], v[68:83], v[0:7]) {}
  v[8:15] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[20:31], v[36:43], v[8:15]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP6, fmtB = MATRIX_FMT_FP4 } }
  v[8:15] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[52:63], v[68:75], v[8:15]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP6, fmtB = MATRIX_FMT_FP4 } }
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- Safe: two bf16 pairs, every A and B different. The chain head's C is not
#--- forwarded; it still counts as the first half of the first pair.
st.func @bf16_two_pairs() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[20:27], v[30:37], v[100:107]) {}
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[40:47], v[50:57], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[60:67], v[70:77], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[80:87], v[90:97], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}

#--- Safe: 32x16x128 f4 has no requirement, even with the same A.
st.func @f4_32x16_same_a() {
^entry:
  v[0:7] = "st.v_wmma_scale_f32_32x16x128_f4"(v[20:27], v[30:37], v[0:7]) {}
  v[0:7] = "st.v_wmma_scale_f32_32x16x128_f4"(v[20:27], v[40:47], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}
