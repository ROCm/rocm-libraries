# RUN: %stinkytofu-opt --arch gfx1250 %s --print-output 2>&1; echo "exit=$?"
#
# an unknown mnemonic in .stir input is an error, not a silently dropped
# instruction with exit 0; the message names the arch.

# CHECK:     Error: No ISA opcode found for mnemonic v_bogus_op in arch gfx1250
# CHECK-NOT: gfx0
# CHECK-NOT: v_add_f32
# CHECK:     exit=1

st.func @unknown_mnemonic() {
^entry:
  v0 = "st.v_bogus_op"(v0, v1) { issueCycles = 1, latencyCycles = 1 }
  v2 = "st.v_add_f32"(v0, v1) { issueCycles = 1, latencyCycles = 5 }
}
