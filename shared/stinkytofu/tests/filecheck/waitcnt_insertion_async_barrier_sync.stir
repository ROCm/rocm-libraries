# RUN: %stinkytofu-opt --arch gfx1250 %s --StinkyBuildImplicitDependencyPass --StinkyWaitCntInsertionPass --print-output
#
# StinkyWaitCntInsertionPass (gfx1250): async store-back with a per-buffer
# barrier as the sync point, proving the reuse hazard is realized by
# s_wait_asynccnt and that each barrier only waits for its OWN buffer.
#
# Realistic store-back shape: each buffer is first produced in LDS by a
# ds_store, then drained to global by global_store_async_from_lds_* (asynccnt /
# s_wait_asynccnt). The async read has no register dest, so nothing in the SSA
# chain orders a later writer after it -- a barrier is the sync primitive that
# makes the async read provably complete before the buffer is reused.
#
# Two buffers (tokens 0 and 1) each go through (ds_store -> async store), so the
# async FIFO holds [SA0(tok0), SA1(tok1)]. Buffer 0 is fenced by barrier A
# (token 0) and buffer 1 by barrier B (token 1) -- one barrier per buffer, not
# one barrier covering both:
#
#   * barrier A (token 0) only conflicts with SA0. SA0 is at index 0 of the
#     depth-2 async queue, so it drains with s_wait_asynccnt 1 (leave SA1 in
#     flight). It does NOT wait for SA1, which reads a disjoint buffer.
#   * after barrier A the buffer-0 reuse ds_store needs no async wait: the
#     sync already happened at the barrier.
#   * barrier B (token 1) then conflicts only with SA1 (now the sole in-flight
#     async op), draining with s_wait_asynccnt 0.
#
# Each async store is also preceded by s_wait_dscnt 0: the async read of a
# buffer must wait for the ds_store that produced it (cross-pipeline RAW on the
# LDS token).
#
# CHECK-LABEL: @waitcnt_insertion_async_barrier_sync
# CHECK: ds_store_b64
# CHECK: s_wait_dscnt
# CHECK-SAME: dlcnt = 0
# CHECK-NEXT: global_store_async_from_lds_b64
# CHECK: ds_store_b64
# CHECK: s_wait_dscnt
# CHECK-SAME: dlcnt = 0
# CHECK-NEXT: global_store_async_from_lds_b64
# CHECK: s_wait_asynccnt
# CHECK-SAME: asynccnt = 1
# CHECK-NEXT: s_barrier
# CHECK-NEXT: ds_store_b64
# CHECK: s_wait_asynccnt
# CHECK-SAME: asynccnt = 0
# CHECK-NEXT: s_barrier
# CHECK-NEXT: ds_store_b64

st.func @waitcnt_insertion_async_barrier_sync() {
^entry:
  "st.ds_store_b64"(v100, v[20:21]) { mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  "st.global_store_async_from_lds_b64"(v[0:1], v2, s[30:31]) { mod.memtoken = { tokens = [0] } }
  "st.ds_store_b64"(v101, v[22:23]) { mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [1] } }
  "st.global_store_async_from_lds_b64"(v[4:5], v6, s[32:33]) { mod.memtoken = { tokens = [1] } }
  "st.s_barrier"() { mod.memtoken = { tokens = [0] } }
  "st.ds_store_b64"(v102, v[24:25]) { mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  "st.s_barrier"() { mod.memtoken = { tokens = [1] } }
  "st.ds_store_b64"(v103, v[26:27]) { mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [1] } }
}
