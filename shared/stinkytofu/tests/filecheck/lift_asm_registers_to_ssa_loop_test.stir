# RUN: %stinkytofu-opt --arch gfx1250 %s --LiftAsmRegistersToSSAPass --DumpStinkyModulePass=ssaForm,stdout
#
# LiftAsmRegistersToSSAPass: a loop-carried register becomes a header argument.
#
# v5 is defined before the loop and again in the body, so the header merges the
# incoming value with the one arriving on the back edge. That header argument is
# what makes the loop-carried dependence explicit: reads inside the loop see the
# merged value, not the physical register name.
#
#   ^entry:  v5 = ...
#      |
#   ^header: phi(v5) <-------+
#      |                     |
#   ^body:   v5 = f(v5) -----+
#      |
#   ^exit:   uses v5
#
# CHECK-LABEL: st.func @lift_asm_registers_to_ssa_loop
#
# CHECK-NEXT: ^entry(%1:v, %2:v, %3:v, %4:v, %5:v, %6:v):
# CHECK-NEXT: %8:v = "st.v_add_f32"(%4:v, %5:v)
#
# The header merges the entry value with the body's redefinition. The back-edge
# input is defined later in program order, which is legal: it dominates the end
# of the latch.
# CHECK: ^header(%7:v):
# CHECK-NEXT: %7:v = phi(^entry: %8:v, ^body: %11:v)
#
# Reads in the loop resolve to the merged value.
# CHECK-NEXT: %9:v = "st.v_add_f32"(%7:v, %6:v)
#
# The body reads the merged value and defines the value the back edge carries.
# CHECK: ^body:
# CHECK-NEXT: %11:v = "st.v_add_f32"(%7:v, %1:v)
#
# The exit is dominated by the header, so it reads the merged value too, and
# takes no argument of its own.
# CHECK: ^exit:
# CHECK-NEXT: %10:v = "st.v_add_f32"(%7:v, %1:v)

st.func @lift_asm_registers_to_ssa_loop() {
^entry:
  v5 = "st.v_add_f32"(v20, v21)
  Successors: ^header
^header:
  v6 = "st.v_add_f32"(v5, v22)
  SCC0 = "st.v_cmp_eq_u32"(v10, v11)
  "st.s_cbranch_scc1"("exit", SCC0)
  Successors: ^body, ^exit
^body:
  v5 = "st.v_add_f32"(v5, v1)
  "st.s_branch"("header")
  Successors: ^header
^exit:
  v7 = "st.v_add_f32"(v5, v1)
}
