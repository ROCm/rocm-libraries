# RUN: %stinkytofu-opt --arch gfx1250 %s --NumWaves=4 --StinkyBuildImplicitDependencyPass --StinkyWaitCntInsertionPass --print-output
#
# Ring 3, frame K advances once per backedge. The publishing barrier consumes
# phase 0. At steady state the matching producer is oldest in
# [phase 0, phase 1], so tlcnt=1 retires it and leaves the newer fill live.
#
# CHECK-LABEL: @waitcnt_insertion_lds_ring_raw
# CHECK: ^loop:
# CHECK-NEXT: s_wait_tensorcnt
# CHECK-SAME: tlcnt = 1
# CHECK-NEXT: s_barrier_signal
# CHECK-SAME: accesses = [0,0,3,0,2]
# CHECK: tensor_load_to_lds
# CHECK-SAME: accesses = [0,0,3,2,1]
# CHECK: s_cbranch_scc1
# CHECK-SAME: advances = [0,1]

st.func @waitcnt_insertion_lds_ring_raw() {
^entry:
  "st.tensor_load_to_lds"(s[0:3], s[8:15]) { mod.memtoken = { tokens = [0] }, mod.lds_ring = { accesses = [0,0,3,0,1], advances = [] } }
  "st.tensor_load_to_lds"(s[0:3], s[16:23]) { mod.memtoken = { tokens = [1] }, mod.lds_ring = { accesses = [0,0,3,1,1], advances = [] } }
  "st.s_branch"("loop")
  Successors: ^loop
^loop:
  "st.s_barrier_signal"(-1) { mod.memtoken = { tokens = [0] }, mod.lds_ring = { accesses = [0,0,3,0,2], advances = [] } }
  "st.s_barrier_wait"(-1) { mod.memtoken = { tokens = [0] } }
  "st.tensor_load_to_lds"(s[0:3], s[24:31]) { mod.memtoken = { tokens = [2] }, mod.lds_ring = { accesses = [0,0,3,2,1], advances = [] } }
  SCC0 = "st.s_cmp_eq_u32"(s60, 0x1)
  "st.s_cbranch_scc1"("loop", SCC0) { mod.lds_ring = { accesses = [], advances = [0,1] } }
  Successors: ^loop, ^exit
^exit:
}
