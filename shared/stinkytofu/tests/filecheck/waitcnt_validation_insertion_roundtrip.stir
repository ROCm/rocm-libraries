# RUN: %stinkytofu-opt --arch gfx1250 %s --StinkyBuildImplicitDependencyPass --StinkyWaitCntInsertionPass --WaitCntValidationCheckPass --print-output
#
# WaitCntValidationCheckPass (gfx1250): read-only checker that verifies the
# s_wait_* instructions present in the IR satisfy every register / LDS data
# dependency. Here we run the *insertion* pass first (which produces a correct
# wait plan) and then the validator: the validator must accept the freshly
# inserted waits and leave the IR untouched (no abort, output prints normally).
#
# Pattern (single-block):
#   ds_load_b64 v[20:21], v0        (ds_load 0)
#   ds_load_b64 v[30:31], v0        (ds_load 1)
#   ds_load_b64 v[40:41], v0        (ds_load 2)
#   ds_load_b64 v[50:51], v0        (ds_load 3)
#   v_wmma_f32_16x16x32_bf16        (uses v[20:27], v[30:37] -> needs ds_load 0,1)
#   v_wmma_f32_16x16x32_bf16        (uses v[40:47], v[50:57] -> needs ds_load 2,3)
#
# The insertion pass emits s_wait_dscnt 2 before WMMA1 and s_wait_dscnt 0 before
# WMMA2; the validator confirms those waits cover the ds_load -> WMMA RAW deps.
#
# CHECK-LABEL: @waitcnt_validation_insertion_roundtrip
# CHECK: ds_load_b64
# CHECK-NEXT: ds_load_b64
# CHECK-NEXT: ds_load_b64
# CHECK-NEXT: ds_load_b64
# CHECK-NEXT: s_wait_dscnt
# CHECK-SAME: dlcnt = 2
# CHECK-NEXT: v_wmma_f32_16x16x32_bf16
# CHECK-NEXT: s_wait_dscnt
# CHECK-SAME: dlcnt = 0
# CHECK-NEXT: v_wmma_f32_16x16x32_bf16

st.func @waitcnt_validation_insertion_roundtrip() {
^entry:
  v[20:21] = "st.ds_load_b64"(v0) { mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  v[30:31] = "st.ds_load_b64"(v0) { mod.ds = { na = 1, offset = 16, gds = false }, mod.memtoken = { tokens = [0] } }
  v[40:41] = "st.ds_load_b64"(v0) { mod.ds = { na = 1, offset = 32, gds = false }, mod.memtoken = { tokens = [0] } }
  v[50:51] = "st.ds_load_b64"(v0) { mod.ds = { na = 1, offset = 48, gds = false }, mod.memtoken = { tokens = [0] } }
  a[10:17] = "st.v_wmma_f32_16x16x32_bf16"(v[20:27], v[30:37], a[10:17]) { mod.mfma = { reuseA = false, reuseB = false } }
  a[10:17] = "st.v_wmma_f32_16x16x32_bf16"(v[40:47], v[50:57], a[10:17]) { mod.mfma = { reuseA = false, reuseB = false } }
}
