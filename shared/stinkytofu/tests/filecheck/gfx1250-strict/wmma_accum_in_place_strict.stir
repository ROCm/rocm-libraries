# RUN: %stinkytofu-opt --arch gfx1250-strict %s --InsertCoexecHazardPass=reportOnly 2>&1
#
# The in-place WMMA accumulation check covers the whole gfx12.5 family, so the
# gfx1250-strict stepping is checked too.

#--- f8 K=64 has no exception.
# CHECK: error: WMMA in function "f8_k64_same_acc" block "entry"
# CHECK-SAME: switch the accumulator
st.func @f8_k64_same_acc() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x64_fp8_fp8"(v[20:27], v[30:37], v[0:7]) {}
  v[0:7] = "st.v_wmma_f32_16x16x64_fp8_fp8"(v[40:47], v[50:57], v[0:7]) {}
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}
