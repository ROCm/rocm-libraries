# RUN: %stinkytofu-opt --arch gfx1250 %s --InsertWaitAluPass --print-output
#
# InsertWaitAluPass: after an s_swappc call the rest of the block runs in mode0
# (SCHED_MODE=0 is set before the call and not re-enabled in-block), where the
# hardware auto-stalls on all hazards. So s_wait_alu is only needed *before* the
# call (mode2) — the identical VALU->VMEM RAW *after* the call must NOT get one.
# This is a per-block decision: no cross-block propagation.

# CHECK-LABEL: @call_suppresses_mode0_wait
# --- before the call (mode2): VALU->VMEM RAW gets a va_vdst wait.
# CHECK: v_add_f32
# CHECK: s_wait_alu
# CHECK-SAME: va_vdst
# CHECK: buffer_load_b32
# --- the call switches to mode0.
# CHECK: s_swappc_b64
# --- after the call (mode0): same hazard, but no s_wait_alu is emitted.
# CHECK: v_add_f32
# CHECK-NOT: s_wait_alu
# CHECK: buffer_load_b32

st.func @call_suppresses_mode0_wait() {
^entry:
  v0 = "st.v_add_f32"(v1, v2) { issueCycles = 1, latencyCycles = 5 }
  v10 = "st.buffer_load_b32"(v0) { issueCycles = 1, latencyCycles = 100 }
  s[26:27] = "st.s_swappc_b64"(s[12:13]) { issueCycles = 1, latencyCycles = 2 }
  v3 = "st.v_add_f32"(v4, v5) { issueCycles = 1, latencyCycles = 5 }
  v11 = "st.buffer_load_b32"(v3) { issueCycles = 1, latencyCycles = 100 }
}
