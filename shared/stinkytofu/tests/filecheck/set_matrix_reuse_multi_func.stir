# RUN: %stinkytofu-opt --arch gfx1250 %s --SetMatrixReusePass --print-output
#
# Multi-function coverage for SetMatrixReusePass. Single-function correctness
# (reuse set on matching pairs, chain broken by a call) is checked elsewhere;
# here we only verify that every function in the module is transformed
# independently rather than just the first one.

# CHECK-LABEL: @func0
# CHECK: v_wmma_f32_16x16x16_bf16{{.*}}reuseA = true, reuseB = true
# CHECK: v_wmma_f32_16x16x16_bf16{{.*}}reuseA = false, reuseB = false

st.func @func0() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x16_bf16"(v[8:15], v[24:31], v[0:7]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[0:7] = "st.v_wmma_f32_16x16x16_bf16"(v[8:15], v[24:31], v[0:7]) { mod.mfma = { reuseA = false, reuseB = false } }
}

# CHECK-LABEL: @func1
# CHECK: v_wmma_f32_16x16x16_bf16{{.*}}reuseA = true, reuseB = true
# CHECK: v_wmma_f32_16x16x16_bf16{{.*}}reuseA = false, reuseB = false

st.func @func1() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x16_bf16"(v[16:23], v[40:47], v[0:7]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[0:7] = "st.v_wmma_f32_16x16x16_bf16"(v[16:23], v[40:47], v[0:7]) { mod.mfma = { reuseA = false, reuseB = false } }
}
