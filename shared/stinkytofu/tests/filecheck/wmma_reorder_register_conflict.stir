# RUN: %stinkytofu-opt --arch gfx1250 %s --StinkyWmmaReorderPass=reverse,distance=1 --print-output
#
# StinkyWmmaReorderPass: a wmma order can force two different producers of the
# same physical register to have overlapping live windows -- the reorder is
# free to place any two ds_loads in any relative order, but it cannot invent
# extra physical registers. When that happens the later (by new schedule
# position) producer is retargeted to a placeholder virtual register instead
# of silently clobbering the earlier value; final physical assignment is left
# to register allocation.
#
# Two A tiles (v[20:23], v[28:31]) each feed one wmma. The B operand
# double-buffers within a single iteration on one register, v[60:63]: loadB0
# (offset 32) feeds wmma0/wmma1, loadB1 (offset 80) feeds wmma2/wmma3 --
# ordinary software pipelining, not a back-edge crossing.
#
# `reverse` flips the wmma pattern to (wmma3, wmma2, wmma1, wmma0). At
# distance 1 that lands loadB0's new slot inside loadB1's now-earlier occupied
# window, so the same physical register can no longer hold both live ranges.
# loadB0 loses the register: its def and both its own consumers (wmma0, wmma1)
# move to the same placeholder register together. loadB1 and its consumers
# (wmma2, wmma3) are untouched.

# CHECK-LABEL: @wmma_reorder_register_conflict
# CHECK-LABEL: ^label_LoopBeginL:

# loadB1 keeps the physical register.
# CHECK: v[60:63] = "st.ds_load_b128"{{.*}}offset = 80

# wmma3 (loadB1's own consumer) reads the physical register.
# CHECK: "st.v_wmma_f32_16x16x32_bf16"(v[44:47], v[60:63], v[124:127])

# loadB0 is retargeted to a placeholder register: kVirtualBit (1u<<31) set on
# an otherwise-fresh index, not a real VGPR -- register allocation resolves it
# later. This is the first (and only) conflict in the run, so the index is 0.
# CHECK: v[2147483648:2147483651] = "st.ds_load_b128"{{.*}}offset = 32

# wmma2 (loadB1's other consumer) still reads the physical register.
# CHECK: "st.v_wmma_f32_16x16x32_bf16"(v[36:39], v[60:63], v[116:119])

# wmma1 and wmma0 (loadB0's own consumers) followed it to the same
# placeholder register, not the stale physical one.
# CHECK: "st.v_wmma_f32_16x16x32_bf16"(v[28:31], v[2147483648:2147483651], v[108:111])
# CHECK: "st.v_wmma_f32_16x16x32_bf16"(v[20:23], v[2147483648:2147483651], v[100:103])

st.func @wmma_reorder_register_conflict() {
^preheader:
  "st.s_branch"("label_LoopBeginL")
^label_LoopBeginL:
  v[20:23] = "st.ds_load_b128"(v10) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 0, gds = false } }
  v[28:31] = "st.ds_load_b128"(v10) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 16, gds = false } }
  v[60:63] = "st.ds_load_b128"(v10) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 32, gds = false } }
  v[100:103] = "st.v_wmma_f32_16x16x32_bf16"(v[20:23], v[60:63], v[100:103]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[108:111] = "st.v_wmma_f32_16x16x32_bf16"(v[28:31], v[60:63], v[108:111]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[36:39] = "st.ds_load_b128"(v10) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 48, gds = false } }
  v[44:47] = "st.ds_load_b128"(v10) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 64, gds = false } }
  v[60:63] = "st.ds_load_b128"(v10) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 80, gds = false } }
  v[116:119] = "st.v_wmma_f32_16x16x32_bf16"(v[36:39], v[60:63], v[116:119]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[124:127] = "st.v_wmma_f32_16x16x32_bf16"(v[44:47], v[60:63], v[124:127]) { mod.mfma = { reuseA = false, reuseB = false } }
  "st.s_branch"("label_LoopBeginL")
}
