# RUN: %stinkytofu-opt --arch gfx1250 %s --StinkyBuildImplicitDependencyPass --StinkyDAGSchedulerPass --print-output
#
# Option off (dag_wait_alu_aware.stir has it on): the DAG only spaces each pair by its own
# cycle model, so both consumers issue well inside the window InsertWaitAlu needs to drop
# the wait.

# CHECK-LABEL: @prefetch_waits_out_va_vdst
# CHECK: v301 = "st.v_add_f32"
# CHECK: "st.global_prefetch_b8"(v[300:301]
# CHECK: v_wmma_scale
# CHECK: v_wmma_scale
# CHECK: v_wmma_scale
# CHECK: v_wmma_scale
# CHECK: v_wmma_scale
# CHECK: v_wmma_scale
# CHECK: v_wmma_scale
# CHECK: v_wmma_scale
# CHECK: v_wmma_scale
# CHECK: v_wmma_scale
# CHECK: v_wmma_scale

# CHECK-LABEL: @valu_overwrite_waits_out_vm_vsrc
# CHECK: v[500:503] = "st.ds_load_b128"(v400
# CHECK: v400 = "st.v_add_nc_u32"
# CHECK: v[516:519] = "st.ds_load_b128"(v401
# CHECK: v[520:523] = "st.ds_load_b128"(v401
# CHECK: v[524:527] = "st.ds_load_b128"(v401
# CHECK: v[528:531] = "st.ds_load_b128"(v401
# CHECK: v[532:535] = "st.ds_load_b128"(v401
# CHECK: v[536:539] = "st.ds_load_b128"(v401
# CHECK: v[540:543] = "st.ds_load_b128"(v401
# CHECK: v[544:547] = "st.ds_load_b128"(v401
# CHECK: v[548:551] = "st.ds_load_b128"(v401
# CHECK: v[552:555] = "st.ds_load_b128"(v401
# CHECK: v[556:559] = "st.ds_load_b128"(v401

st.func @prefetch_waits_out_va_vdst() {
^entry:
  v300 = "st.v_add_f32"(v310, v311) { issueCycles = 1, latencyCycles = 5 }
  v301 = "st.v_add_f32"(v312, v313) { issueCycles = 1, latencyCycles = 5 }
  "st.global_prefetch_b8"(v[300:301], off) { issueCycles = 1, latencyCycles = 1, mod.global = { offset = 0, th = "TH_LOAD_NT", scope = "SCOPE_SE" } }
  v[0:7] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[100:115], v[116:131], v[0:7]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP8, fmtB = MATRIX_FMT_FP8 } }
  v[8:15] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[100:115], v[116:131], v[8:15]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP8, fmtB = MATRIX_FMT_FP8 } }
  v[16:23] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[100:115], v[116:131], v[16:23]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP8, fmtB = MATRIX_FMT_FP8 } }
