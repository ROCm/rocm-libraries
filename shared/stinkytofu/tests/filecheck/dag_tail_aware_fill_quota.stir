# RUN: %stinkytofu-opt --arch gfx1250 %s --StinkyBuildImplicitDependencyPass --StinkyDAGSchedulerPass --wait-alu-scoreboard --enable-esm2-track-valu-vsrc --even-spread-fillers --no-ds-spread --tail-aware-fill-quota --print-output
#
# dagFeatures.tailAwareFillQuota: the second load's address v_xor has its mixed-rule tail in windows
# 3..5 (need-by + lead 5 to the load's window 6), so the fillers go there, four a window, not one.

# CHECK-LABEL: @fillers_go_to_the_tail_windows
# CHECK: v[24:31] = "st.v_wmma_f32_16x16x32_bf16"
# CHECK-NEXT: {{.*}}"st.v_add_f32"
# CHECK-NEXT: {{.*}}"st.v_add_f32"
# CHECK-NEXT: {{.*}}"st.v_add_f32"
# CHECK-NEXT: {{.*}}"st.v_add_f32"
# CHECK-NEXT: v[32:39] = "st.v_wmma_f32_16x16x32_bf16"
st.func @fillers_go_to_the_tail_windows() {
^entry:
  v400 = "st.v_xor_b32"(v401, v402) { issueCycles = 1, latencyCycles = 5 }
  v[100:103] = "st.ds_load_b128"(v400) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  v410 = "st.v_xor_b32"(v411, v412) { issueCycles = 1, latencyCycles = 5 }
  v[104:107] = "st.ds_load_b128"(v410) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  v320 = "st.v_add_f32"(v341, v342) { issueCycles = 1, latencyCycles = 5 }
  v321 = "st.v_add_f32"(v342, v343) { issueCycles = 1, latencyCycles = 5 }
  v322 = "st.v_add_f32"(v343, v344) { issueCycles = 1, latencyCycles = 5 }
  v323 = "st.v_add_f32"(v344, v345) { issueCycles = 1, latencyCycles = 5 }
  v324 = "st.v_add_f32"(v345, v346) { issueCycles = 1, latencyCycles = 5 }
  v325 = "st.v_add_f32"(v346, v347) { issueCycles = 1, latencyCycles = 5 }
  v326 = "st.v_add_f32"(v347, v348) { issueCycles = 1, latencyCycles = 5 }
  v327 = "st.v_add_f32"(v348, v349) { issueCycles = 1, latencyCycles = 5 }
  v328 = "st.v_add_f32"(v349, v350) { issueCycles = 1, latencyCycles = 5 }
  v329 = "st.v_add_f32"(v350, v351) { issueCycles = 1, latencyCycles = 5 }
  v[0:7] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[0:7]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[8:15] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[8:15]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[16:23] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[16:23]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[24:31] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[24:31]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[32:39] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[32:39]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[40:47] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[40:47]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[48:55] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[48:55]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[56:63] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[56:63]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[64:71] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[64:71]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[72:79] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[72:79]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[80:87] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[80:87]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[88:95] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[88:95]) { mod.mfma = { reuseA = false, reuseB = false } }
  "st.s_endpgm"() { issueCycles = 1, latencyCycles = 1 }
}
