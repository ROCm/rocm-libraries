# RUN: %stinkytofu-opt --arch gfx1250 %s --LiftAsmRegistersToSSAPass --DumpCanonicalSSAPass
#
# LiftAsmRegistersToSSAPass: values merging at a join become canonical PHIs.
#
# v5 is defined on both arms of the branch, so the join needs a PHI. v9 is
# defined only in the entry, which dominates the join, so it needs none. PHIs
# live in the graph; no GFX::PHI instruction is added to the stream.
#
#   ^entry:  v9 = ...            (dominates everything, no PHI)
#          /        \.
#   ^left: v5 = ...   ^right: v5 = ...
#          \        /
#   ^join:  PHI(v5); uses v5 and v9
#
# CHECK-LABEL: ssa.func @lift_asm_registers_to_ssa_diamond
#
# The entry defines v9 once; it dominates the join, so no PHI is placed for it.
# CHECK: ^entry:
# CHECK-NEXT: %10:v = "st.v_add_f32"(src0 = [%3:v], src1 = [%4:v]) { inst = #0, origin = [v9] }
#
# The branch operands are a label and SCC, neither of which is allocatable, so
# they bind nothing.
# CHECK: "st.s_cbranch_scc1"(src0 = [], src1 = []) { inst = #2 }
#
# CHECK: ^left:
# CHECK-NEXT: %12:v = "st.v_add_f32"(src0 = [%5:v], src1 = [%6:v]) { inst = #3, origin = [v5] }
# CHECK: ^right:
# CHECK-NEXT: %11:v = "st.v_add_f32"(src0 = [%7:v], src1 = [%8:v]) { inst = #5, origin = [v5] }
#
# The PHI's inputs follow predecessor order, each carrying the value defined on
# that arm.
# CHECK: ^join:
# CHECK-NEXT: %9:v = phi(^left: %12:v, ^right: %11:v) { origin = v5 }
#
# The join reads the PHI result for v5, and the entry's definition for v9.
# CHECK-NEXT: %13:v = "st.v_add_f32"(src0 = [%9:v], src1 = [%10:v]) { inst = #6, origin = [v6] }
# CHECK-NEXT: // physical: v6 = "st.v_add_f32"(v5, v9)
#
# A canonical PHI lives in the graph, never in the instruction stream.
# CHECK-NOT: st.PHI
# CHECK-NOT: unprinted_values

st.func @lift_asm_registers_to_ssa_diamond() {
^entry:
  v9 = "st.v_add_f32"(v20, v21)
  SCC0 = "st.v_cmp_eq_u32"(v10, v11)
  "st.s_cbranch_scc1"("right", SCC0)
  Successors: ^left, ^right
^left:
  v5 = "st.v_add_f32"(v22, v23)
  "st.s_branch"("join")
  Successors: ^join
^right:
  v5 = "st.v_add_f32"(v24, v25)
  Successors: ^join
^join:
  v6 = "st.v_add_f32"(v5, v9)
}
