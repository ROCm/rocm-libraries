# RUN: %stinkytofu-opt --arch gfx1250 %s --StinkyBuildImplicitDependencyPass --StinkyDAGSchedulerPass --print-output
#
# Parent-VALU (feedsWmma / wmmaParentValuQueue) input families issue their
# ds_loads first. Remaining families keep the default A→B→MXSA→MXSB order.
# gfx1250 MX WMMA srcs: B, A, C, MXSB, MXSA.
#
# Program order of the loads is always A, B, MXSA, MXSB.
# VGPR families (disjoint): A=v[8:11], B=v[60:63], MXSA=v0, MXSB=v20.

#===----------------------------------------------------------------------===#
# Example 1: v_perm MXSA only → MXSA, then A, B, MXSB.
#===----------------------------------------------------------------------===#

# CHECK-LABEL: @parent_mxsa_only
# CHECK: v0 = {{.*}}ds_load_b32
# CHECK: v[8:11]{{.*}}ds_load_b128
# CHECK: v[60:63]{{.*}}ds_load_b128
# CHECK: v20 = {{.*}}ds_load_b32
st.func @parent_mxsa_only() {
^entry:
  v[8:11] = "st.ds_load_b128"(v100) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  v[60:63] = "st.ds_load_b128"(v101) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  v0 = "st.ds_load_b32"(v102) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  v20 = "st.ds_load_b32"(v103) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  v0 = "st.v_perm_b32"(v0, v0, 0) { issueCycles = 1, latencyCycles = 5 }
  v[80:87] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[60:63], v[8:11], v[80:87], v20, v0) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
}

#===----------------------------------------------------------------------===#
# Example 2: v_perm MXSA then MXSB → MXSA, MXSB, then A, B.
#===----------------------------------------------------------------------===#

# CHECK-LABEL: @parent_mxsa_mxsb
# CHECK: v0 = {{.*}}ds_load_b32
# CHECK: v20 = {{.*}}ds_load_b32
# CHECK: v[8:11]{{.*}}ds_load_b128
# CHECK: v[60:63]{{.*}}ds_load_b128
st.func @parent_mxsa_mxsb() {
^entry:
  v[8:11] = "st.ds_load_b128"(v100) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  v[60:63] = "st.ds_load_b128"(v101) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  v0 = "st.ds_load_b32"(v102) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  v20 = "st.ds_load_b32"(v103) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  v0 = "st.v_perm_b32"(v0, v0, 0) { issueCycles = 1, latencyCycles = 5 }
  v20 = "st.v_perm_b32"(v20, v20, 0) { issueCycles = 1, latencyCycles = 5 }
  v[80:87] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[60:63], v[8:11], v[80:87], v20, v0) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
}

#===----------------------------------------------------------------------===#
# Example 3: v_perm MXSA then A → A, MXSA, then B, MXSB.
# Parent VALU program order is MXSA then A; within the parent tier the existing
# A < MXSA affinity/srcReg order still wins.
#===----------------------------------------------------------------------===#

# CHECK-LABEL: @parent_mxsa_then_a
# CHECK: v[8:11]{{.*}}ds_load_b128
# CHECK: v0 = {{.*}}ds_load_b32
# CHECK: v[60:63]{{.*}}ds_load_b128
# CHECK: v20 = {{.*}}ds_load_b32
st.func @parent_mxsa_then_a() {
^entry:
  v[8:11] = "st.ds_load_b128"(v100) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  v[60:63] = "st.ds_load_b128"(v101) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  v0 = "st.ds_load_b32"(v102) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  v20 = "st.ds_load_b32"(v103) { issueCycles = 1, latencyCycles = 56, mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  v0 = "st.v_perm_b32"(v0, v0, 0) { issueCycles = 1, latencyCycles = 5 }
  v8 = "st.v_perm_b32"(v8, v8, 0) { issueCycles = 1, latencyCycles = 5 }
  v[80:87] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[60:63], v[8:11], v[80:87], v20, v0) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
}
