# RUN: %stinkytofu-opt %s --print-output
#
# Default architecture path: with no --arch flag, stinkytofu-opt keeps the {12,5,0}
# triple and resolves the GfxArchID by triple (first-match). Every test build includes
# the Gfx1250 (v1) stepping (enforced in CMakeLists), and it registers first, so the
# default must resolve to v1 costs -- NOT v0. This guards the `resolvedArchName.empty()`
# branch of the --arch resolution, which the --arch-carrying tests never exercise.
#
# v1 costs for v_wmma_f32_16x16x128_f8f6f4: FP4xFP4 override latency 4, FP8xFP8 base 8.
# (The v0 stepping would be 8 and 16; see filecheck/v0/coissue_matrix_fmt_override_v0.stir.)
#
# CHECK-LABEL: @override
#
# CHECK: v_wmma_f32_16x16x128_f8f6f4
# CHECK-SAME: latencyCycles = 4
# CHECK-SAME: fmtA = "MATRIX_FMT_FP4"
# CHECK-SAME: fmtB = "MATRIX_FMT_FP4"
#
# CHECK: v_wmma_f32_16x16x128_f8f6f4
# CHECK-SAME: latencyCycles = 8
# CHECK-SAME: fmtA = "MATRIX_FMT_FP8"
# CHECK-SAME: fmtB = "MATRIX_FMT_FP8"

st.func @override() {
^entry:
  v[0:7] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[20:35], v[30:45], v[0:7]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP4, fmtB = MATRIX_FMT_FP4 } }
  v[8:15] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[20:35], v[30:45], v[8:15]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP8, fmtB = MATRIX_FMT_FP8 } }
}
