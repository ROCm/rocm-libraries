# RUN: %stinkytofu-opt --arch gfx1250 %s --CFGBuilderPass --InsertWaitAluPass=enableESM2TrackValuVsrc,sharedOrderCountFollowers --print-output
#
# A CSMACC producer's wait counts everything issued after its own ticket, as the worst case.

#===----------------------------------------------------------------------===#
# One CSMACC and one matrix op follow the producer. Its own unit sees 1 follower;
# the shared order sees 2.
#===----------------------------------------------------------------------===#
# CHECK-LABEL: @gfx1250_shared_order_counts_both_units
# CHECK: s_wait_alu
# CHECK-SAME: va_vdst = 2
# CHECK: ds_load_b32

st.func @gfx1250_shared_order_counts_both_units() {
^entry:
  v0 = "st.v_add_f32"(v1, v2) { issueCycles = 1, latencyCycles = 5 }
  v3 = "st.v_add_f32"(v4, v5) { issueCycles = 1, latencyCycles = 5 }
  v[8:15] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[8:15]) { mod.mfma = { reuseA = false, reuseB = false } }
  v190 = "st.ds_load_b32"(v0) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
}

#===----------------------------------------------------------------------===#
# Interleaved vadd/wmma: 3 ops follow the producer, all counted.
#===----------------------------------------------------------------------===#
# CHECK-LABEL: @gfx1250_shared_order_interleaved
# CHECK: s_wait_alu
# CHECK-SAME: va_vdst = 3
# CHECK: ds_load_b32

st.func @gfx1250_shared_order_interleaved() {
^entry:
  v0 = "st.v_add_f32"(v1, v2) { issueCycles = 1, latencyCycles = 5 }
  v[8:15] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[8:15]) { mod.mfma = { reuseA = false, reuseB = false } }
  v3 = "st.v_add_f32"(v4, v5) { issueCycles = 1, latencyCycles = 5 }
  v[16:23] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[16:23]) { mod.mfma = { reuseA = false, reuseB = false } }
  v190 = "st.ds_load_b32"(v0) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
}

#===----------------------------------------------------------------------===#
# A CSMACC producer live across a join. One path issues 2 matrix ops after it, the other
# issues none, so the merged state must carry the fewer followers: va_vdst(0), not 2.
#===----------------------------------------------------------------------===#
# CHECK-LABEL: @gfx1250_csmacc_live_across_join
# CHECK: s_wait_alu
# CHECK-SAME: va_vdst = 0
# CHECK: ds_load_b32

st.func @gfx1250_csmacc_live_across_join() {
^entry:
  v0 = "st.v_add_f32"(v1, v2) { issueCycles = 1, latencyCycles = 5 }
  "st.s_cbranch_scc1"("label_join", SCC0)
  Successors: ^bb_many, ^label_join
^bb_many:
  v[8:15] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[8:15]) { mod.mfma = { reuseA = false, reuseB = false } }
  v[16:23] = "st.v_wmma_f32_16x16x32_bf16"(v[200:207], v[208:215], v[16:23]) { mod.mfma = { reuseA = false, reuseB = false } }
  Successors: ^label_join
^label_join:
  v190 = "st.ds_load_b32"(v0) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
}
