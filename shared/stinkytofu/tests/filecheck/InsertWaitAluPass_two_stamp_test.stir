#===----------------------------------------------------------------------===#
# No matrix op in the kernel: the set's VALU count after a CSMACC producer that read v300 frees it.
#===----------------------------------------------------------------------===#
# CHECK-LABEL: @capacity_nolatch_csmacc_src_valus_hide
# CHECK-NOT: s_wait_alu{{.*}}va_vdst
# CHECK: v300 = "st.ds_load_b32"
st.func @capacity_nolatch_csmacc_src_valus_hide() {
^entry:
  v9 = "st.v_add_f32"(v300, v301) { issueCycles = 1, latencyCycles = 5 }
  v200 = "st.v_add_f32"(v230, v230) { issueCycles = 1, latencyCycles = 5 }
  v201 = "st.v_add_f32"(v231, v231) { issueCycles = 1, latencyCycles = 5 }
  v202 = "st.v_add_f32"(v232, v232) { issueCycles = 1, latencyCycles = 5 }
  v203 = "st.v_add_f32"(v233, v233) { issueCycles = 1, latencyCycles = 5 }
  v204 = "st.v_add_f32"(v234, v234) { issueCycles = 1, latencyCycles = 5 }
  v205 = "st.v_add_f32"(v235, v235) { issueCycles = 1, latencyCycles = 5 }
  v206 = "st.v_add_f32"(v236, v236) { issueCycles = 1, latencyCycles = 5 }
  v207 = "st.v_add_f32"(v237, v237) { issueCycles = 1, latencyCycles = 5 }
  v208 = "st.v_add_f32"(v238, v238) { issueCycles = 1, latencyCycles = 5 }
  v209 = "st.v_add_f32"(v239, v239) { issueCycles = 1, latencyCycles = 5 }
  v210 = "st.v_add_f32"(v240, v240) { issueCycles = 1, latencyCycles = 5 }
  v211 = "st.v_add_f32"(v241, v241) { issueCycles = 1, latencyCycles = 5 }
  v300 = "st.ds_load_b32"(v250) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
}

#===----------------------------------------------------------------------===#
# A CSMACC producer issued before the first matrix op is judged by the form rules once one is
# latched, as if known from the start: the fp8 16x16x128 form's wmma count frees its source.
#===----------------------------------------------------------------------===#
# CHECK-LABEL: @capacity_prelatch_csmacc_judged_by_form_after_latch
# CHECK-NOT: s_wait_alu{{.*}}va_vdst
# CHECK: v300 = "st.ds_load_b32"
st.func @capacity_prelatch_csmacc_judged_by_form_after_latch() {
^entry:
  v9 = "st.v_add_f32"(v300, v301) { issueCycles = 1, latencyCycles = 5 }
  v[32:39] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[400:415], v[416:431], v[32:39]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[40:47] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[400:415], v[416:431], v[40:47]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[48:55] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[400:415], v[416:431], v[48:55]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[56:63] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[400:415], v[416:431], v[56:63]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[64:71] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[400:415], v[416:431], v[64:71]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[72:79] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[400:415], v[416:431], v[72:79]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[80:87] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[400:415], v[416:431], v[80:87]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[88:95] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[400:415], v[416:431], v[88:95]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[96:103] = "st.v_wmma_f32_16x16x128_fp8_fp8"(v[400:415], v[416:431], v[96:103]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v300 = "st.ds_load_b32"(v250) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
}

#===----------------------------------------------------------------------===#
# Two forms in one kernel switch the form rules off; a CSMACC producer falls back to this set.
#===----------------------------------------------------------------------===#
# CHECK-LABEL: @capacity_two_forms_csmacc_falls_back_to_capacity_set
# CHECK-NOT: s_wait_alu{{.*}}va_vdst
# CHECK: v300 = "st.ds_load_b32"
st.func @capacity_two_forms_csmacc_falls_back_to_capacity_set() {
^entry:
  v[32:39] = "st.v_wmma_f32_16x16x32_bf16"(v[400:407], v[408:415], v[32:39]) { issueCycles = 1, latencyCycles = 8, mod.mfma = { reuseA = false, reuseB = false } }
  v[40:47] = "st.v_wmma_scale_f32_16x16x128_f8f6f4"(v[400:415], v[416:431], v[40:47], v290, v291) { issueCycles = 1, latencyCycles = 8, mod.matrix_fmt = { fmtA = "MATRIX_FMT_FP8", fmtB = "MATRIX_FMT_FP8" }, mod.mfma = { reuseA = false, reuseB = false } }
  v9 = "st.v_add_f32"(v300, v301) { issueCycles = 1, latencyCycles = 5 }
  v200 = "st.v_add_f32"(v230, v230) { issueCycles = 1, latencyCycles = 5 }
  v201 = "st.v_add_f32"(v231, v231) { issueCycles = 1, latencyCycles = 5 }
  v202 = "st.v_add_f32"(v232, v232) { issueCycles = 1, latencyCycles = 5 }
  v203 = "st.v_add_f32"(v233, v233) { issueCycles = 1, latencyCycles = 5 }
  v204 = "st.v_add_f32"(v234, v234) { issueCycles = 1, latencyCycles = 5 }
  v205 = "st.v_add_f32"(v235, v235) { issueCycles = 1, latencyCycles = 5 }
  v206 = "st.v_add_f32"(v236, v236) { issueCycles = 1, latencyCycles = 5 }
  v207 = "st.v_add_f32"(v237, v237) { issueCycles = 1, latencyCycles = 5 }
  v208 = "st.v_add_f32"(v238, v238) { issueCycles = 1, latencyCycles = 5 }
  v209 = "st.v_add_f32"(v239, v239) { issueCycles = 1, latencyCycles = 5 }
  v210 = "st.v_add_f32"(v240, v240) { issueCycles = 1, latencyCycles = 5 }
  v211 = "st.v_add_f32"(v241, v241) { issueCycles = 1, latencyCycles = 5 }
  v300 = "st.ds_load_b32"(v250) { issueCycles = 1, latencyCycles = 52, mod.ds = { na = 1, offset = 0, gds = false } }
}
