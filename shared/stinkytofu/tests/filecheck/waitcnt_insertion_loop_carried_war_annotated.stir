# RUN: %stinkytofu-opt --arch gfx1250 %s --NumWaves=2 --StinkyBuildImplicitDependencyPass --StinkyWaitCntInsertionPass --print-output
#
# Loop-carried WAR named by mod.loopcarriedwar. Canonical case; the other
# waitcnt_insertion_loop_carried_war_* tests refer back here.
#
# Reduced from the gfx1250 TDM+LDS main loop: ring 3, one step per trip, with
# Read(k) = blk(k) and Write(k) = blk(k+2):
#
#                           iter 0   iter 1   iter 2   iter 3
#   ds_load     (Read,  [0])  LDS0     LDS1     LDS2     LDS0
#   tensor_load (Write, [2])  LDS2     LDS0     LDS1     LDS2
#
# Write(k) = Read(k-d) gives d = 1: iter 1 fills LDS0, which iter 0 was reading.
# The tags [0] and [2] never move while the buffer under each shifts every
# column, so plain token overlap compares [0] against [2], finds nothing, and
# misses a hazard that is real in every iteration -- a memtoken names a physical
# buffer only for the trip it was emitted from. mod.loopcarriedwar supplies the
# missing tag, which TensileLite derives from _ldsTokenBackEdgeMap.
#
# Steady state at the barrier, oldest first:
#
#   [ R2(k-1), R1(k), R2(k) ]
#     ^^^^^^^ carried in over the back edge, and the only entry that aliases
#
# R2(k-1) sits 3 from the tail, so the wait is 2: the previous trip's read
# retires and both of this trip's stay in flight. A wait of 0 would drain the
# pipeline the third buffer exists to fill.
#
# R1 is consumed by the wmma each trip and R2 is not, so R2 survives the back
# edge and gives the next trip something to find.
#
# CHECK-LABEL: @waitcnt_insertion_loop_carried_war_annotated
# CHECK: ^loop:
# CHECK-NEXT: ds_load_b64{{.*}}tokens = [0]
# CHECK-NEXT: ds_load_b64{{.*}}tokens = [0]
# The annotated drain: previous trip's read only.
# CHECK-NEXT: s_wait_dscnt{{.*}}dlcnt = 2
# CHECK-NEXT: s_barrier_signal{{.*}}tokens = [2]
# CHECK-NEXT: s_barrier_wait{{.*}}tokens = [2]
# CHECK-NEXT: tensor_load_to_lds{{.*}}tokens = [2]
# CHECK-NEXT: s_wait_dscnt{{.*}}dlcnt = 1
# CHECK-NEXT: v_wmma_f32_16x16x32_bf16
# CHECK-NOT: s_wait_loadcnt

st.func @waitcnt_insertion_loop_carried_war_annotated() {
^entry:
  "st.s_branch"("loop")
  Successors: ^loop
^loop:
  # trip k on entry: WP=blk(k+1)%3  RP=blk(k)%3
  v[20:21] = "st.ds_load_b64"(v10) { mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] } }
  v[40:41] = "st.ds_load_b64"(v10) { mod.ds = { na = 1, offset = 16, gds = false }, mod.memtoken = { tokens = [0] } }
  # ROTATE WP / RP are plain address arithmetic; elided. The tags below are
  # already post-rotate, which is why the fill says [2] and the reads say [0].
  "st.s_barrier_signal"(-1) { mod.memtoken = { tokens = [2] }, mod.loopcarriedwar = { tokens = [0], distance = 1 } }
  "st.s_barrier_wait"(-1) { mod.memtoken = { tokens = [2] } }
  "st.tensor_load_to_lds"(s[0:3], s[8:15]) { mod.memtoken = { tokens = [2] } }
  # consumes the first read only; the second stays in flight across the back edge
  a[10:17] = "st.v_wmma_f32_16x16x32_bf16"(v[20:27], v[30:37], a[10:17])
  SCC0 = "st.s_cmp_eq_u32"(s60, 0x1)
  "st.s_cbranch_scc1"("loop", SCC0)
  Successors: ^loop, ^exit
^exit:
}
