# RUN: %stinkytofu-opt --arch gfx1250 %s --NumWaves=4 --StinkyBuildImplicitDependencyPass --StinkyWaitCntInsertionPass --print-output
#
# Wave-separated MX ring, (PGRA, PGRB) = (3, 2): the scale fills (classes 3 and
# 4) are never named by a publishing barrier, so nothing can match them to a
# publish by class and every publishing barrier retires them, in the loop as
# well as in the prologue and NGLL.
#
# CHECK-LABEL: @waitcnt_insertion_lds_ring_unpublished_class
# CHECK-LABEL: ^pro_odd:
# CHECK-NEXT: Successors
# CHECK-LABEL: ^pro_pub:
# CHECK-NEXT: s_wait_tensorcnt
# CHECK-SAME: tlcnt = 0
# CHECK-NEXT: s_barrier_signal
# CHECK-LABEL: ^fence:
# CHECK-NEXT: s_wait_tensorcnt
# CHECK-SAME: tlcnt = 0
# CHECK-NEXT: s_barrier_signal
# CHECK-LABEL: ^ngll0_pub:
# CHECK-NEXT: s_wait_tensorcnt
# CHECK-SAME: tlcnt = 0
# CHECK-NEXT: s_barrier_signal

st.func @waitcnt_insertion_lds_ring_unpublished_class() {
^entry:
  "st.tensor_load_to_lds"(s[0:3], s[8:15]) { mod.memtoken = { tokens = [0,3] }, mod.lds_ring = { accesses = [0,0,3,0,1,1,0,2,0,1], advances = [], waves = [5,10] } }
  "st.tensor_load_to_lds"(s[0:3], s[8:15]) { mod.memtoken = { tokens = [0,3] }, mod.lds_ring = { accesses = [3,0,3,0,1,4,0,2,0,1], advances = [], waves = [5,10] } }
  "st.tensor_load_to_lds"(s[0:3], s[8:15]) { mod.memtoken = { tokens = [1,4] }, mod.lds_ring = { accesses = [0,0,3,1,1,1,0,2,1,1], advances = [], waves = [5,10] } }
  "st.tensor_load_to_lds"(s[0:3], s[8:15]) { mod.memtoken = { tokens = [1,4] }, mod.lds_ring = { accesses = [3,0,3,1,1,4,0,2,1,1], advances = [], waves = [5,10] } }
  SCC0 = "st.s_cmp_eq_u32"(s50, 0x1)
  "st.s_cbranch_scc1"("pro_join", SCC0) { mod.wave_role = { taken = 10, fallthrough = 5 } }
  Successors: ^pro_join, ^pro_deep
^pro_deep:
  "st.tensor_load_to_lds"(s[0:3], s[8:15]) { mod.memtoken = { tokens = [2] }, mod.lds_ring = { accesses = [0,0,3,2,1], advances = [], waves = [5] } }
  "st.tensor_load_to_lds"(s[0:3], s[8:15]) { mod.memtoken = { tokens = [2] }, mod.lds_ring = { accesses = [3,0,3,2,1], advances = [], waves = [5] } }
  Successors: ^pro_join
^pro_join:
  SCC1 = "st.s_cmp_eq_u32"(s50, 0x1)
  "st.s_cbranch_scc1"("pro_odd", SCC1) { mod.wave_role = { taken = 10, fallthrough = 5 } }
  Successors: ^pro_odd, ^pro_even
^pro_even:
  "st.s_branch"("pro_pub")
  Successors: ^pro_pub
^pro_odd:
  Successors: ^pro_pub
^pro_pub:
  "st.s_barrier_signal"(-1) { mod.memtoken = { tokens = [0,3] }, mod.lds_ring = { accesses = [0,0,3,0,2,1,0,2,0,2], advances = [], waves = [5,10] } }
  "st.s_barrier_wait"(-1) { mod.memtoken = { tokens = [0,3] } }
  "st.s_branch"("loop")
  Successors: ^loop
^loop:
  SCC2 = "st.s_cmp_eq_u32"(s50, 0x1)
  "st.s_cbranch_scc1"("fence_odd", SCC2) { mod.wave_role = { taken = 10, fallthrough = 5 } }
  Successors: ^fence_odd, ^fence_even
^fence_even:
  "st.s_branch"("fence")
  Successors: ^fence
^fence_odd:
  Successors: ^fence
^fence:
  "st.s_barrier_signal"(-1) { mod.memtoken = { tokens = [0,1,3,4] }, mod.lds_ring = { accesses = [0,0,3,1,2,1,0,2,1,2,0,0,3,0,3,1,0,2,0,3], advances = [], waves = [5,10,5,10] } }
  "st.s_barrier_wait"(-1) { mod.memtoken = { tokens = [0,1,3,4] } }
  "st.tensor_load_to_lds"(s[0:3], s[8:15]) { mod.memtoken = { tokens = [0,3] }, mod.lds_ring = { accesses = [0,0,3,3,1,1,0,2,2,1], advances = [], waves = [5,10] } }
  "st.tensor_load_to_lds"(s[0:3], s[8:15]) { mod.memtoken = { tokens = [0,3] }, mod.lds_ring = { accesses = [3,0,3,3,1,4,0,2,2,1], advances = [], waves = [5,10] } }
  SCC3 = "st.s_cmp_eq_u32"(s60, 0x1)
  "st.s_cbranch_scc1"("loop", SCC3) { mod.lds_ring = { accesses = [], advances = [0,1] } }
  Successors: ^loop, ^ngll0
^ngll0:
  SCC4 = "st.s_cmp_eq_u32"(s50, 0x1)
  "st.s_cbranch_scc1"("ngll0_odd", SCC4) { mod.wave_role = { taken = 10, fallthrough = 5 } }
  Successors: ^ngll0_odd, ^ngll0_even
^ngll0_even:
  "st.s_branch"("ngll0_pub")
  Successors: ^ngll0_pub
^ngll0_odd:
  Successors: ^ngll0_pub
^ngll0_pub:
  "st.s_barrier_signal"(-1) { mod.memtoken = { tokens = [2,3] }, mod.lds_ring = { accesses = [0,0,3,2,2,1,0,2,2,2], advances = [], waves = [5,10] } }
  "st.s_barrier_wait"(-1) { mod.memtoken = { tokens = [2,3] } }
  Successors: ^exit
^exit:
}
