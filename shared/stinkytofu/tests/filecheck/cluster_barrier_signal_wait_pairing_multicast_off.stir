# RUN: %stinkytofu-opt --arch gfx1250 %s --InsertClusterBarrierPass --print-output
#
# The signal/wait pairing invariant, machine-checked.
#
# Both halves of a cluster-barrier handshake must be emitted under the SAME
# predicate. A half-emitted pair is not a codegen wart: a signal with no wait
# leaks a token into the next phase, and a wait with no signal hangs the
# cluster. The two halves live in separate `if` bodies in the pass
# (insertRule1ClusterBarrierSignalBefore vs the Rule 2 wait, and the signal and
# wait inside insertRule3HandshakeBefore), so nothing but a test stops a future
# predicate edit from moving one and not the other.
#
# This is the multicast-off (gfx1250 v0) side, where all the handshakes are
# emitted. The multicast-on side of the same invariant -- zero cluster barriers
# of either kind -- is pinned by
# cluster_barrier_multicast_on_cooperative_drain.stir.
#
# The CHECK/CHECK-NOT alternation below is an exact transcript of every
# s_barrier_*(-3) in the output, in order:
#
#     signal (Rule 1, below label_GSU_1)
#     wait   (Rule 2, before the run-up's first tensor load)
#     signal (Rule 3, in the loop body)
#     wait   (Rule 3, before the workgroup publish barrier)
#
# Each CHECK-NOT closes the gap to the next CHECK, so an extra, missing, or
# out-of-order half fails: two signals in a row, a leading wait, or anything
# dangling after the final wait all go red.

# CHECK-LABEL: @cluster_barrier_signal_wait_pairing_multicast_off

# A handshake opens with an arrive, never with a wait.
# CHECK-NOT: "st.s_barrier_wait"(-3)
# CHECK: "st.s_barrier_signal"(-3)

# CHECK-NOT: "st.s_barrier_signal"(-3)
# CHECK: "st.s_barrier_wait"(-3)

# CHECK-NOT: "st.s_barrier_wait"(-3)
# CHECK: "st.s_barrier_signal"(-3)

# CHECK-NOT: "st.s_barrier_signal"(-3)
# CHECK: "st.s_barrier_wait"(-3)

# Nothing dangles past the last wait.
# CHECK-NOT: "st.s_barrier_signal"(-3)
# CHECK-NOT: "st.s_barrier_wait"(-3)

st.func @cluster_barrier_signal_wait_pairing_multicast_off() {
^entry:
label_GSU_1:
  a[24:31] = "st.v_wmma_f32_16x16x32_bf16"(v[0:7], v[8:15], a[24:31]) { mod.mfma = { reuseA = false, reuseB = false } }
  "st.tensor_load_to_lds"(s[60:63], s[64:71]) { issueCycles = 1, latencyCycles = 1, mod.memtoken = { tokens = [0] } }
label_PreLoopJoin:
  a[32:39] = "st.v_wmma_f32_16x16x32_bf16"(v[8:15], v[16:23], a[32:39]) { mod.mfma = { reuseA = false, reuseB = false } }
label_TestLoop:
  a[40:47] = "st.v_wmma_f32_16x16x32_bf16"(v[0:7], v[8:15], a[40:47]) { mod.mfma = { reuseA = false, reuseB = false } }
  "st.s_barrier_signal"(-1) { issueCycles = 1, latencyCycles = 1 }
  "st.s_barrier_wait"(-1) { issueCycles = 1, latencyCycles = 1 }
  "st.tensor_load_to_lds"(s[0:3], s[4:11]) { issueCycles = 1, latencyCycles = 1, mod.memtoken = { tokens = [0] } }
  a[48:55] = "st.v_wmma_f32_16x16x32_bf16"(v[8:15], v[0:7], a[48:55]) { mod.mfma = { reuseA = false, reuseB = false } }
  SCC0 = "st.s_cmp_eq_u32"(s91, 0) { issueCycles = 1, latencyCycles = 1 }
  "st.s_cbranch_scc1"(label_TestLoopEnd, SCC0) { issueCycles = 1, latencyCycles = 1 }
  SCC0 = "st.s_cmp_eq_u32"(s92, 0) { issueCycles = 1, latencyCycles = 1 }
  "st.s_cbranch_scc0"(label_TestLoop, SCC0) { issueCycles = 1, latencyCycles = 1 }
label_TestLoopEnd:
  a[8:15] = "st.v_wmma_f32_16x16x32_bf16"(v[0:7], v[8:15], a[8:15]) { mod.mfma = { reuseA = false, reuseB = false } }
}
