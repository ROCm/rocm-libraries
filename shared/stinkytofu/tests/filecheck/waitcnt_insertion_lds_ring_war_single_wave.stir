# RUN: %stinkytofu-opt --arch gfx1250 %s --NumWaves=1 --StinkyBuildImplicitDependencyPass --StinkyWaitCntInsertionPass --print-output
#
# A single-wave kernel needs no workgroup barrier. The current gdelta-2 tensor
# write aliases the previous trip's gdelta-0 read, so dscnt=1 drains only that
# older read and preserves this trip's read.
#
# CHECK-LABEL: @waitcnt_insertion_lds_ring_war_single_wave
# CHECK: ^loop:
# CHECK: ds_load_b64
# CHECK-NEXT: s_wait_dscnt
# CHECK-SAME: dlcnt = 1
# CHECK-NEXT: tensor_load_to_lds

st.func @waitcnt_insertion_lds_ring_war_single_wave() {
^entry:
  "st.s_branch"("loop")
  Successors: ^loop
^loop:
  v[20:21] = "st.ds_load_b64"(v10) { mod.ds = { na = 1, offset = 0, gds = false }, mod.memtoken = { tokens = [0] }, mod.lds_ring = { accesses = [0,0,3,0,0], advances = [] } }
  "st.tensor_load_to_lds"(s[0:3], s[8:15]) { mod.memtoken = { tokens = [2] }, mod.lds_ring = { accesses = [0,0,3,2,1], advances = [] } }
  SCC0 = "st.s_cmp_eq_u32"(s60, 0x1)
  "st.s_cbranch_scc1"("loop", SCC0) { mod.lds_ring = { accesses = [], advances = [0,1] } }
  Successors: ^loop, ^exit
^exit:
}
