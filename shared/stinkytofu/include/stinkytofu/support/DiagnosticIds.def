// X-macro list of diagnostic ids, one per kind of failure.
// Usage: DIAGNOSTIC_ID(EnumName, "spelling", "Description")
//
// The spelling is what Diagnostic::format() prints in brackets and what tools
// match on, so an id keeps its spelling once released. docs/user/error-codes.md
// lists every id.

#ifndef DIAGNOSTIC_ID
#error "DIAGNOSTIC_ID must be defined before including DiagnosticIds.def"
#endif

// Reading STIR, assembly, or pattern text.
DIAGNOSTIC_ID(Syntax,                "syntax",                  "The text does not follow the grammar")
DIAGNOSTIC_ID(UnknownRegisterType,   "unknown-register-type",   "A register names no register class")
DIAGNOSTIC_ID(OutOfRange,            "out-of-range",            "A number does not fit its field, or a register range is reversed")
DIAGNOSTIC_ID(AlignmentWithoutLabel, "alignment-without-label", "A block header sets alignment but not label")
DIAGNOSTIC_ID(MissingAttributes,     "missing-attributes",      "An instruction has no issueCycles or latencyCycles")
DIAGNOSTIC_ID(UnknownAttribute,      "unknown-attribute",       "An instruction or label attribute is not one StinkyTofu reads")
DIAGNOSTIC_ID(UnknownMnemonic,       "unknown-mnemonic",        "The arch has no instruction of that name")
DIAGNOSTIC_ID(UnreadableOperands,    "unreadable-operands",     "The operands of a known instruction could not be read")
DIAGNOSTIC_ID(NoHardwareDescriptor,  "no-hardware-descriptor",  "An instruction has no hardware descriptor for the arch")
DIAGNOSTIC_ID(UnknownSuccessor,      "unknown-successor",       "A successor names no block in the function")
DIAGNOSTIC_ID(CannotReadFile,        "cannot-read-file",        "An input file could not be opened")

// Verifying a built function.
DIAGNOSTIC_ID(EmptyFunction,         "empty-function",          "A function has no blocks or no instructions")
DIAGNOSTIC_ID(LogicalIR,             "logical-ir",              "A function still holds Logical IR")
DIAGNOSTIC_ID(MissingOperand,        "missing-operand",         "An instruction lacks an operand its encoding needs")
DIAGNOSTIC_ID(RegisterWidth,         "register-width",          "A register operand has the wrong width")
DIAGNOSTIC_ID(RegisterType,          "register-type",           "A register operand has the wrong register class")
DIAGNOSTIC_ID(ReadWriteOperand,      "read-write-operand",      "A read-write register is missing from the defs or the uses")
DIAGNOSTIC_ID(UndefinedLabel,        "undefined-label",         "A branch targets a label the function does not define")
DIAGNOSTIC_ID(InvalidSSA,            "invalid-ssa",             "Attached SSA breaks an invariant")

#undef DIAGNOSTIC_ID
