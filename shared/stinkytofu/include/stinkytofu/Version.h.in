#pragma once

#include "stinkytofu/Export.hpp"

#define STINKYTOFU_VERSION_MAJOR @STINKYTOFU_VERSION_MAJOR@
#define STINKYTOFU_VERSION_MINOR @STINKYTOFU_VERSION_MINOR@
#define STINKYTOFU_VERSION_PATCH @STINKYTOFU_VERSION_PATCH@
#define STINKYTOFU_VERSION_TWEAK "@STINKYTOFU_VERSION_TWEAK@"

// Exact-match build identity used by PassBuilder::loadPlugin() and rocisa's
// import-time check. Deliberately just MAJOR.MINOR.PATCH plus the git commit
// hash as one opaque string — nothing that consumes this does semver-range
// comparison, only exact string equality. StinkyTofu does not support loading
// a plugin, or linking rocisa, against a different build.
#define STINKYTOFU_FULL_VERSION "@STINKYTOFU_VERSION@-@STINKYTOFU_VERSION_TWEAK@"

namespace stinkytofu {
// Returns the STINKYTOFU_FULL_VERSION of whichever stinkytofu binary this
// function's definition actually executes in — not the caller's own
// compile-time view. Compare this against the caller's own STINKYTOFU_FULL_VERSION
// macro to detect a different stinkytofu build than the one the caller was
// compiled against actually being loaded/linked at runtime.
STINKYTOFU_EXPORT const char* getRuntimeVersion();

// Exact string comparison, no semver-range logic — the whole "cross-version
// support" contract lives in this one function. Pulled out of loadPlugin()/
// rocisa's import-time check so both can be unit-tested with two literal
// strings, without needing to actually build stinkytofu twice.
STINKYTOFU_EXPORT bool versionsMatch(const char* expected, const char* actual);
}  // namespace stinkytofu
