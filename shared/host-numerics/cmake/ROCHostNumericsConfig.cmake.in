@PACKAGE_INIT@

# Installed component contract:
#
# Component      Imported target                         Component requirements
# Core           roc::host-numerics-core               none
# Operations     roc::host-numerics                    Core
# BLAS           roc::host-numerics-blas               Operations, LP64 CBLAS
# AMDGPULayout   roc::host-numerics-amd-gpu-layout     none
#
# Component requirements are transitive. For example, requesting BLAS loads
# Operations and Core. The
# *_TARGET and *_COMPONENT_DEPENDENCIES variables below expose this mapping to
# consumers that need to inspect it. BLAS also requires a conforming LP64 CBLAS
# implementation.
# Operations and AMDGPULayout require OpenMP CXX only when their installed
# targets were built with OpenMP support; BLAS inherits the Operations
# requirement. A component-less lookup loads Operations and Core.

set(
    ROCHostNumerics_SUPPORTED_COMPONENTS
    Core
    Operations
    BLAS
    AMDGPULayout
)

set(ROCHostNumerics_Core_TARGET roc::host-numerics-core)
set(ROCHostNumerics_Core_COMPONENT_DEPENDENCIES)
set(ROCHostNumerics_Core_AVAILABLE ON)

set(ROCHostNumerics_Operations_TARGET roc::host-numerics)
set(ROCHostNumerics_Operations_COMPONENT_DEPENDENCIES Core)
set(ROCHostNumerics_Operations_AVAILABLE ON)

set(ROCHostNumerics_BLAS_TARGET roc::host-numerics-blas)
set(ROCHostNumerics_BLAS_COMPONENT_DEPENDENCIES Operations)
set(ROCHostNumerics_BLAS_AVAILABLE @HOST_NUMERICS_PACKAGE_HAS_BLAS@)

set(
    ROCHostNumerics_AMDGPULayout_TARGET
    roc::host-numerics-amd-gpu-layout
)
set(ROCHostNumerics_AMDGPULayout_COMPONENT_DEPENDENCIES)
set(ROCHostNumerics_AMDGPULayout_AVAILABLE ON)

set(
    _ROCHostNumerics_Core_targets_file
    ROCHostNumericsCoreTargets.cmake
)
set(
    _ROCHostNumerics_Operations_targets_file
    ROCHostNumericsOperationsTargets.cmake
)
set(
    _ROCHostNumerics_BLAS_targets_file
    ROCHostNumericsBLASTargets.cmake
)
set(
    _ROCHostNumerics_AMDGPULayout_targets_file
    ROCHostNumericsAMDGPULayoutTargets.cmake
)

set(_ROCHostNumerics_Core_uses_openmp OFF)
set(
    _ROCHostNumerics_Operations_uses_openmp
    @HOST_NUMERICS_PACKAGE_OPERATIONS_HAS_OPENMP@
)
set(_ROCHostNumerics_BLAS_uses_openmp OFF)
set(
    _ROCHostNumerics_AMDGPULayout_uses_openmp
    @HOST_NUMERICS_PACKAGE_AMD_GPU_LAYOUT_HAS_OPENMP@
)

foreach(_ROCHostNumerics_component
        IN LISTS ROCHostNumerics_SUPPORTED_COMPONENTS)
    set(ROCHostNumerics_${_ROCHostNumerics_component}_FOUND FALSE)
endforeach()
set(ROCHostNumerics_FOUND TRUE)
unset(ROCHostNumerics_NOT_FOUND_MESSAGE)

set(
    _ROCHostNumerics_requested_components
    "${ROCHostNumerics_FIND_COMPONENTS}"
)
if(NOT _ROCHostNumerics_requested_components)
    set(_ROCHostNumerics_requested_components Operations)
    set(ROCHostNumerics_FIND_REQUIRED_Operations TRUE)
endif()
list(REMOVE_DUPLICATES _ROCHostNumerics_requested_components)

set(_ROCHostNumerics_errors)
set(_ROCHostNumerics_supported_requests)
set(_ROCHostNumerics_components_to_load)
foreach(_ROCHostNumerics_component
        IN LISTS _ROCHostNumerics_requested_components)
    if(NOT _ROCHostNumerics_component
        IN_LIST ROCHostNumerics_SUPPORTED_COMPONENTS)
        set(ROCHostNumerics_${_ROCHostNumerics_component}_FOUND FALSE)
        if(ROCHostNumerics_FIND_REQUIRED_${_ROCHostNumerics_component})
            string(
                CONCAT
                _ROCHostNumerics_unsupported_message
                "ROCHostNumerics does not support component "
                "\"${_ROCHostNumerics_component}\". Supported components: "
                "Core, Operations, BLAS, AMDGPULayout."
            )
            list(
                APPEND
                _ROCHostNumerics_errors
                "${_ROCHostNumerics_unsupported_message}"
            )
        endif()
        continue()
    endif()

    list(
        APPEND
        _ROCHostNumerics_supported_requests
        "${_ROCHostNumerics_component}"
    )
    set(
        _ROCHostNumerics_available_variable
        "ROCHostNumerics_${_ROCHostNumerics_component}_AVAILABLE"
    )
    if(NOT "${${_ROCHostNumerics_available_variable}}")
        if(_ROCHostNumerics_component STREQUAL "BLAS")
            string(
                CONCAT
                _ROCHostNumerics_reason_BLAS
                "this installation was built without "
                "HOST_NUMERICS_BUILD_BLAS_BACKEND"
            )
        else()
            set(
                _ROCHostNumerics_reason_${_ROCHostNumerics_component}
                "the component is not present in this installation"
            )
        endif()
        continue()
    endif()

    list(
        APPEND
        _ROCHostNumerics_components_to_load
        "${_ROCHostNumerics_component}"
    )
endforeach()

# Expand direct requirements into a transitive component closure.
set(_ROCHostNumerics_closure_changed ON)
while(_ROCHostNumerics_closure_changed)
    set(_ROCHostNumerics_closure_changed OFF)
    set(
        _ROCHostNumerics_current_closure
        "${_ROCHostNumerics_components_to_load}"
    )
    foreach(_ROCHostNumerics_component
            IN LISTS _ROCHostNumerics_current_closure)
        set(
            _ROCHostNumerics_dependencies_variable
            "ROCHostNumerics_${_ROCHostNumerics_component}_COMPONENT_DEPENDENCIES"
        )
        foreach(
            _ROCHostNumerics_dependency
            IN LISTS ${_ROCHostNumerics_dependencies_variable}
        )
            if(NOT _ROCHostNumerics_dependency
               IN_LIST _ROCHostNumerics_components_to_load)
                list(
                    APPEND
                    _ROCHostNumerics_components_to_load
                    "${_ROCHostNumerics_dependency}"
                )
                set(_ROCHostNumerics_closure_changed ON)
            endif()
        endforeach()
    endforeach()
endwhile()

set(_ROCHostNumerics_needs_cblas OFF)
if("BLAS" IN_LIST _ROCHostNumerics_components_to_load)
    set(_ROCHostNumerics_needs_cblas ON)
endif()

set(_ROCHostNumerics_needs_openmp OFF)
foreach(_ROCHostNumerics_component
        IN LISTS _ROCHostNumerics_components_to_load)
    set(
        _ROCHostNumerics_openmp_variable
        "_ROCHostNumerics_${_ROCHostNumerics_component}_uses_openmp"
    )
    if("${${_ROCHostNumerics_openmp_variable}}")
        set(_ROCHostNumerics_needs_openmp ON)
    endif()
endforeach()

set(_ROCHostNumerics_cblas_dependency_found ON)
if(_ROCHostNumerics_needs_cblas)
    set(_ROCHostNumerics_saved_module_path "${CMAKE_MODULE_PATH}")
    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_package(CBLAS QUIET MODULE)
    set(CMAKE_MODULE_PATH "${_ROCHostNumerics_saved_module_path}")
    if(NOT CBLAS_FOUND OR NOT TARGET CBLAS::CBLAS)
        set(_ROCHostNumerics_cblas_dependency_found OFF)
    endif()
endif()

set(_ROCHostNumerics_openmp_dependency_found ON)
if(_ROCHostNumerics_needs_openmp)
    find_package(OpenMP QUIET COMPONENTS CXX)
    if(NOT OpenMP_CXX_FOUND OR NOT TARGET OpenMP::OpenMP_CXX)
        set(_ROCHostNumerics_openmp_dependency_found OFF)
    endif()
endif()

# Load targets in dependency order and retain a reason for every component that
# cannot be loaded. This makes failures deterministic even when more than one
# requested component is unavailable.
foreach(_ROCHostNumerics_component
        Core
        Operations
        BLAS
        AMDGPULayout)
    if(NOT _ROCHostNumerics_component
       IN_LIST _ROCHostNumerics_components_to_load)
        continue()
    endif()

    set(_ROCHostNumerics_component_reason)
    set(
        _ROCHostNumerics_available_variable
        "ROCHostNumerics_${_ROCHostNumerics_component}_AVAILABLE"
    )
    if(NOT "${${_ROCHostNumerics_available_variable}}")
        set(
            _ROCHostNumerics_component_reason
            "${_ROCHostNumerics_reason_${_ROCHostNumerics_component}}"
        )
    endif()

    set(
        _ROCHostNumerics_dependencies_variable
        "ROCHostNumerics_${_ROCHostNumerics_component}_COMPONENT_DEPENDENCIES"
    )
    if(NOT _ROCHostNumerics_component_reason)
        foreach(
            _ROCHostNumerics_dependency
            IN LISTS ${_ROCHostNumerics_dependencies_variable}
        )
            if(NOT ROCHostNumerics_${_ROCHostNumerics_dependency}_FOUND)
                string(
                    CONCAT
                    _ROCHostNumerics_component_reason
                    "required component ${_ROCHostNumerics_dependency} is "
                    "unavailable"
                )
                if(_ROCHostNumerics_reason_${_ROCHostNumerics_dependency})
                    string(
                        APPEND
                        _ROCHostNumerics_component_reason
                        " (${_ROCHostNumerics_reason_${_ROCHostNumerics_dependency}})"
                    )
                endif()
                break()
            endif()
        endforeach()
    endif()

    if(NOT _ROCHostNumerics_component_reason
       AND _ROCHostNumerics_component STREQUAL "BLAS"
       AND NOT _ROCHostNumerics_cblas_dependency_found)
        string(
            CONCAT
            _ROCHostNumerics_component_reason
            "the BLAS component requires CBLAS::CBLAS with cblas.h, "
            "cblas_sgemm/cblas_dgemm/cblas_cgemm/cblas_zgemm, and the LP64 "
            "(32-bit integer) ABI"
        )
    endif()

    set(
        _ROCHostNumerics_openmp_variable
        "_ROCHostNumerics_${_ROCHostNumerics_component}_uses_openmp"
    )
    if(NOT _ROCHostNumerics_component_reason
       AND "${${_ROCHostNumerics_openmp_variable}}"
       AND NOT _ROCHostNumerics_openmp_dependency_found)
        string(
            CONCAT
            _ROCHostNumerics_component_reason
            "the installed ${_ROCHostNumerics_component} target requires "
            "OpenMP::OpenMP_CXX, but CMake could not find the OpenMP CXX "
            "component"
        )
    endif()

    set(
        _ROCHostNumerics_target_variable
        "ROCHostNumerics_${_ROCHostNumerics_component}_TARGET"
    )
    set(
        _ROCHostNumerics_targets_file_variable
        "_ROCHostNumerics_${_ROCHostNumerics_component}_targets_file"
    )
    set(
        _ROCHostNumerics_targets_file
        "${CMAKE_CURRENT_LIST_DIR}/${${_ROCHostNumerics_targets_file_variable}}"
    )
    if(NOT _ROCHostNumerics_component_reason
       AND NOT TARGET "${${_ROCHostNumerics_target_variable}}")
        if(NOT EXISTS "${_ROCHostNumerics_targets_file}")
            string(
                CONCAT
                _ROCHostNumerics_component_reason
                "the installation is incomplete; expected target file "
                "${_ROCHostNumerics_targets_file} is missing"
            )
        else()
            include("${_ROCHostNumerics_targets_file}")
        endif()
    endif()

    if(NOT _ROCHostNumerics_component_reason
       AND NOT TARGET "${${_ROCHostNumerics_target_variable}}")
        string(
            CONCAT
            _ROCHostNumerics_component_reason
            "the installation target file did not define "
            "${${_ROCHostNumerics_target_variable}}"
        )
    endif()

    if(_ROCHostNumerics_component_reason)
        set(
            _ROCHostNumerics_reason_${_ROCHostNumerics_component}
            "${_ROCHostNumerics_component_reason}"
        )
    else()
        set(ROCHostNumerics_${_ROCHostNumerics_component}_FOUND TRUE)
    endif()
endforeach()

foreach(_ROCHostNumerics_component
        IN LISTS _ROCHostNumerics_supported_requests)
    if(ROCHostNumerics_FIND_REQUIRED_${_ROCHostNumerics_component})
        if(NOT ROCHostNumerics_${_ROCHostNumerics_component}_FOUND)
            string(
                CONCAT
                _ROCHostNumerics_component_error
                "ROCHostNumerics component "
                "\"${_ROCHostNumerics_component}\" is unavailable: "
                "${_ROCHostNumerics_reason_${_ROCHostNumerics_component}}."
            )
            list(
                APPEND
                _ROCHostNumerics_errors
                "${_ROCHostNumerics_component_error}"
            )
        endif()
    endif()
endforeach()

check_required_components(ROCHostNumerics)
if(_ROCHostNumerics_errors)
    set(ROCHostNumerics_FOUND FALSE)
    list(JOIN _ROCHostNumerics_errors "\n  " _ROCHostNumerics_error_text)
    string(
        CONCAT
        ROCHostNumerics_NOT_FOUND_MESSAGE
        "ROCHostNumerics component resolution failed:\n  "
        "${_ROCHostNumerics_error_text}"
    )
endif()
