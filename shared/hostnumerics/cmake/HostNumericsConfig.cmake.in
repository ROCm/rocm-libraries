@PACKAGE_INIT@

# Installed component contract:
#
# Component      Imported target                         Component requirements
# Core           roc::hostnumerics-core               none
# Operations     roc::hostnumerics                    Core
# BLAS           roc::hostnumerics-blas               Operations, LP64 CBLAS
# AMDGPULayout   roc::hostnumerics-amd-gpu-layout     none
#
# Component requirements are transitive. For example, requesting BLAS loads
# Operations and Core. The
# *_TARGET and *_COMPONENT_DEPENDENCIES variables below expose this mapping to
# consumers that need to inspect it. BLAS also requires a conforming LP64 CBLAS
# implementation.
# Operations and AMDGPULayout require OpenMP CXX only when their installed
# targets were built with OpenMP support; BLAS inherits the Operations
# requirement. A component-less lookup loads Operations and Core.

set(
    HostNumerics_SUPPORTED_COMPONENTS
    Core
    Operations
    BLAS
    AMDGPULayout
)

set(HostNumerics_Core_TARGET roc::hostnumerics-core)
set(HostNumerics_Core_COMPONENT_DEPENDENCIES)
set(HostNumerics_Core_AVAILABLE ON)

set(HostNumerics_Operations_TARGET roc::hostnumerics)
set(HostNumerics_Operations_COMPONENT_DEPENDENCIES Core)
set(HostNumerics_Operations_AVAILABLE ON)

set(HostNumerics_BLAS_TARGET roc::hostnumerics-blas)
set(HostNumerics_BLAS_COMPONENT_DEPENDENCIES Operations)
set(HostNumerics_BLAS_AVAILABLE @HOSTNUMERICS_PACKAGE_HAS_BLAS@)

set(
    HostNumerics_AMDGPULayout_TARGET
    roc::hostnumerics-amd-gpu-layout
)
set(HostNumerics_AMDGPULayout_COMPONENT_DEPENDENCIES)
set(HostNumerics_AMDGPULayout_AVAILABLE ON)

set(
    _HostNumerics_Core_targets_file
    HostNumericsCoreTargets.cmake
)
set(
    _HostNumerics_Operations_targets_file
    HostNumericsOperationsTargets.cmake
)
set(
    _HostNumerics_BLAS_targets_file
    HostNumericsBLASTargets.cmake
)
set(
    _HostNumerics_AMDGPULayout_targets_file
    HostNumericsAMDGPULayoutTargets.cmake
)

set(_HostNumerics_Core_uses_openmp OFF)
set(
    _HostNumerics_Operations_uses_openmp
    @HOSTNUMERICS_PACKAGE_OPERATIONS_HAS_OPENMP@
)
set(_HostNumerics_BLAS_uses_openmp OFF)
set(
    _HostNumerics_AMDGPULayout_uses_openmp
    @HOSTNUMERICS_PACKAGE_AMD_GPU_LAYOUT_HAS_OPENMP@
)

foreach(_HostNumerics_component
        IN LISTS HostNumerics_SUPPORTED_COMPONENTS)
    set(HostNumerics_${_HostNumerics_component}_FOUND FALSE)
endforeach()
set(HostNumerics_FOUND TRUE)
unset(HostNumerics_NOT_FOUND_MESSAGE)

set(
    _HostNumerics_requested_components
    "${HostNumerics_FIND_COMPONENTS}"
)
if(NOT _HostNumerics_requested_components)
    set(_HostNumerics_requested_components Operations)
    set(HostNumerics_FIND_REQUIRED_Operations TRUE)
endif()
list(REMOVE_DUPLICATES _HostNumerics_requested_components)

set(_HostNumerics_errors)
set(_HostNumerics_supported_requests)
set(_HostNumerics_components_to_load)
foreach(_HostNumerics_component
        IN LISTS _HostNumerics_requested_components)
    if(NOT _HostNumerics_component
        IN_LIST HostNumerics_SUPPORTED_COMPONENTS)
        set(HostNumerics_${_HostNumerics_component}_FOUND FALSE)
        if(HostNumerics_FIND_REQUIRED_${_HostNumerics_component})
            string(
                CONCAT
                _HostNumerics_unsupported_message
                "HostNumerics does not support component "
                "\"${_HostNumerics_component}\". Supported components: "
                "Core, Operations, BLAS, AMDGPULayout."
            )
            list(
                APPEND
                _HostNumerics_errors
                "${_HostNumerics_unsupported_message}"
            )
        endif()
        continue()
    endif()

    list(
        APPEND
        _HostNumerics_supported_requests
        "${_HostNumerics_component}"
    )
    set(
        _HostNumerics_available_variable
        "HostNumerics_${_HostNumerics_component}_AVAILABLE"
    )
    if(NOT "${${_HostNumerics_available_variable}}")
        if(_HostNumerics_component STREQUAL "BLAS")
            string(
                CONCAT
                _HostNumerics_reason_BLAS
                "this installation was built without "
                "HOSTNUMERICS_BUILD_BLAS_BACKEND"
            )
        else()
            set(
                _HostNumerics_reason_${_HostNumerics_component}
                "the component is not present in this installation"
            )
        endif()
        continue()
    endif()

    list(
        APPEND
        _HostNumerics_components_to_load
        "${_HostNumerics_component}"
    )
endforeach()

# Expand direct requirements into a transitive component closure.
set(_HostNumerics_closure_changed ON)
while(_HostNumerics_closure_changed)
    set(_HostNumerics_closure_changed OFF)
    set(
        _HostNumerics_current_closure
        "${_HostNumerics_components_to_load}"
    )
    foreach(_HostNumerics_component
            IN LISTS _HostNumerics_current_closure)
        set(
            _HostNumerics_dependencies_variable
            "HostNumerics_${_HostNumerics_component}_COMPONENT_DEPENDENCIES"
        )
        foreach(
            _HostNumerics_dependency
            IN LISTS ${_HostNumerics_dependencies_variable}
        )
            if(NOT _HostNumerics_dependency
               IN_LIST _HostNumerics_components_to_load)
                list(
                    APPEND
                    _HostNumerics_components_to_load
                    "${_HostNumerics_dependency}"
                )
                set(_HostNumerics_closure_changed ON)
            endif()
        endforeach()
    endforeach()
endwhile()

set(_HostNumerics_needs_cblas OFF)
if("BLAS" IN_LIST _HostNumerics_components_to_load)
    set(_HostNumerics_needs_cblas ON)
endif()

set(_HostNumerics_needs_openmp OFF)
foreach(_HostNumerics_component
        IN LISTS _HostNumerics_components_to_load)
    set(
        _HostNumerics_openmp_variable
        "_HostNumerics_${_HostNumerics_component}_uses_openmp"
    )
    if("${${_HostNumerics_openmp_variable}}")
        set(_HostNumerics_needs_openmp ON)
    endif()
endforeach()

set(_HostNumerics_cblas_dependency_found ON)
if(_HostNumerics_needs_cblas)
    set(_HostNumerics_saved_module_path "${CMAKE_MODULE_PATH}")
    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_package(CBLAS QUIET MODULE)
    set(CMAKE_MODULE_PATH "${_HostNumerics_saved_module_path}")
    if(NOT CBLAS_FOUND OR NOT TARGET CBLAS::CBLAS)
        set(_HostNumerics_cblas_dependency_found OFF)
    endif()
endif()

set(_HostNumerics_openmp_dependency_found ON)
if(_HostNumerics_needs_openmp)
    find_package(OpenMP QUIET COMPONENTS CXX)
    if(NOT OpenMP_CXX_FOUND OR NOT TARGET OpenMP::OpenMP_CXX)
        set(_HostNumerics_openmp_dependency_found OFF)
    endif()
endif()

# Load targets in dependency order and retain a reason for every component that
# cannot be loaded. This makes failures deterministic even when more than one
# requested component is unavailable.
foreach(_HostNumerics_component
        Core
        Operations
        BLAS
        AMDGPULayout)
    if(NOT _HostNumerics_component
       IN_LIST _HostNumerics_components_to_load)
        continue()
    endif()

    set(_HostNumerics_component_reason)
    set(
        _HostNumerics_available_variable
        "HostNumerics_${_HostNumerics_component}_AVAILABLE"
    )
    if(NOT "${${_HostNumerics_available_variable}}")
        set(
            _HostNumerics_component_reason
            "${_HostNumerics_reason_${_HostNumerics_component}}"
        )
    endif()

    set(
        _HostNumerics_dependencies_variable
        "HostNumerics_${_HostNumerics_component}_COMPONENT_DEPENDENCIES"
    )
    if(NOT _HostNumerics_component_reason)
        foreach(
            _HostNumerics_dependency
            IN LISTS ${_HostNumerics_dependencies_variable}
        )
            if(NOT HostNumerics_${_HostNumerics_dependency}_FOUND)
                string(
                    CONCAT
                    _HostNumerics_component_reason
                    "required component ${_HostNumerics_dependency} is "
                    "unavailable"
                )
                if(_HostNumerics_reason_${_HostNumerics_dependency})
                    string(
                        APPEND
                        _HostNumerics_component_reason
                        " (${_HostNumerics_reason_${_HostNumerics_dependency}})"
                    )
                endif()
                break()
            endif()
        endforeach()
    endif()

    if(NOT _HostNumerics_component_reason
       AND _HostNumerics_component STREQUAL "BLAS"
       AND NOT _HostNumerics_cblas_dependency_found)
        string(
            CONCAT
            _HostNumerics_component_reason
            "the BLAS component requires CBLAS::CBLAS with cblas.h, "
            "cblas_sgemm/cblas_dgemm/cblas_cgemm/cblas_zgemm, and the LP64 "
            "(32-bit integer) ABI"
        )
    endif()

    set(
        _HostNumerics_openmp_variable
        "_HostNumerics_${_HostNumerics_component}_uses_openmp"
    )
    if(NOT _HostNumerics_component_reason
       AND "${${_HostNumerics_openmp_variable}}"
       AND NOT _HostNumerics_openmp_dependency_found)
        string(
            CONCAT
            _HostNumerics_component_reason
            "the installed ${_HostNumerics_component} target requires "
            "OpenMP::OpenMP_CXX, but CMake could not find the OpenMP CXX "
            "component"
        )
    endif()

    set(
        _HostNumerics_target_variable
        "HostNumerics_${_HostNumerics_component}_TARGET"
    )
    set(
        _HostNumerics_targets_file_variable
        "_HostNumerics_${_HostNumerics_component}_targets_file"
    )
    set(
        _HostNumerics_targets_file
        "${CMAKE_CURRENT_LIST_DIR}/${${_HostNumerics_targets_file_variable}}"
    )
    if(NOT _HostNumerics_component_reason
       AND NOT TARGET "${${_HostNumerics_target_variable}}")
        if(NOT EXISTS "${_HostNumerics_targets_file}")
            string(
                CONCAT
                _HostNumerics_component_reason
                "the installation is incomplete; expected target file "
                "${_HostNumerics_targets_file} is missing"
            )
        else()
            include("${_HostNumerics_targets_file}")
        endif()
    endif()

    if(NOT _HostNumerics_component_reason
       AND NOT TARGET "${${_HostNumerics_target_variable}}")
        string(
            CONCAT
            _HostNumerics_component_reason
            "the installation target file did not define "
            "${${_HostNumerics_target_variable}}"
        )
    endif()

    if(_HostNumerics_component_reason)
        set(
            _HostNumerics_reason_${_HostNumerics_component}
            "${_HostNumerics_component_reason}"
        )
    else()
        set(HostNumerics_${_HostNumerics_component}_FOUND TRUE)
    endif()
endforeach()

foreach(_HostNumerics_component
        IN LISTS _HostNumerics_supported_requests)
    if(HostNumerics_FIND_REQUIRED_${_HostNumerics_component})
        if(NOT HostNumerics_${_HostNumerics_component}_FOUND)
            string(
                CONCAT
                _HostNumerics_component_error
                "HostNumerics component "
                "\"${_HostNumerics_component}\" is unavailable: "
                "${_HostNumerics_reason_${_HostNumerics_component}}."
            )
            list(
                APPEND
                _HostNumerics_errors
                "${_HostNumerics_component_error}"
            )
        endif()
    endif()
endforeach()

check_required_components(HostNumerics)
if(_HostNumerics_errors)
    set(HostNumerics_FOUND FALSE)
    list(JOIN _HostNumerics_errors "\n  " _HostNumerics_error_text)
    string(
        CONCAT
        HostNumerics_NOT_FOUND_MESSAGE
        "HostNumerics component resolution failed:\n  "
        "${_HostNumerics_error_text}"
    )
endif()
