// ╔═══════════════════════════════════════════════════════════════╗
// ║ Auto-generated by pymosaic._jit (dynamic route)              ║
// ║   key         = $key                                          ║
// ║   layout_type = $layout_type                                  ║
// ║                                                               ║
// ║ DO NOT EDIT — regenerate by clearing the cache entry and      ║
// ║ re-creating a Python Layout with this structure.              ║
// ║ See python_repr.txt next to this file for a representative    ║
// ║ originating call.                                             ║
// ╚═══════════════════════════════════════════════════════════════╝
//
// This module is keyed on layout *structure* (nesting profile), not on
// shape/stride values. Every leaf of the layout type is ::std::size_t, so a
// single .so serves every layout sharing this nesting profile. The concrete
// shape/stride values are supplied from Python at construction time and
// stored in the typed Layout instance.

#include <nanobind/nanobind.h>
#include <nanobind/stl/pair.h>
#include <nanobind/stl/string.h>
#include <nanobind/stl/vector.h>

#include <cstddef>
#include <mosaic/mosaic.hpp>
#include <sstream>
#include <stdexcept>
#include <string>
#include <tuple>
#include <type_traits>
#include <vector>

namespace nb = nanobind;
using namespace mosaic;
using namespace nb::literals;

// === The typed layout this module represents ============================
// L_t is Layout<Shape<size_t, ...>, Stride<size_t, ...>> — structure fixed
// at compile time, values runtime. Generated by
// python/mosaic/_render.py::render_layout_type.
using L_t = $layout_type;
using S_t = std::remove_cvref_t<decltype(std::declval<L_t>().shape())>;
using D_t = std::remove_cvref_t<decltype(std::declval<L_t>().stride())>;

namespace mosaic_jit_detail {

// count_leaves<T>() — number of scalar leaves in a (possibly nested) tuple
// type. Used to validate the flat shape/stride vectors handed in from Python.
template <class T>
constexpr std::size_t count_leaves() {
    if constexpr (mosaic::is_tuple_v<T>) {
        return [&]<std::size_t... I>(std::index_sequence<I...>) {
            return (count_leaves<std::tuple_element_t<I, T>>() + ... + std::size_t{0});
        }(std::make_index_sequence<std::tuple_size_v<T>>{});
    } else {
        return 1;
    }
}

// fill_from_flat — populate a (possibly nested) tuple `out` from a flat
// pointer, advancing it left-to-right across the leaves. The fold over the
// comma operator is sequenced, so leaf order matches mosaic::flatten / the
// Python-side flatten() the values were produced by.
template <class T>
void fill_from_flat(T& out, const std::size_t*& p) {
    if constexpr (mosaic::is_tuple_v<T>) {
        std::apply([&](auto&... elems) { (fill_from_flat(elems, p), ...); }, out);
    } else {
        out = *p++;
    }
}

// Convert a (possibly nested) C++ tuple of integral leaves — exactly what
// mosaic::idx2crd returns — into a Python nb::object preserving the nesting
// profile. Scalars become Python ints; nested tuples recurse.
template <class T>
nb::object to_py(T const& val) {
    if constexpr (mosaic::is_tuple_v<T>) {
        constexpr std::size_t N = std::tuple_size_v<std::remove_cvref_t<T>>;
        nb::list lst;
        if constexpr (N > 0) {
            std::apply([&](auto const&... args) { (lst.append(to_py(args)), ...); }, val);
        }
        return nb::tuple(lst);
    } else {
        return nb::int_(static_cast<long long>(val));
    }
}

// Convert a Python nb::handle (int or possibly-nested tuple) into a typed
// C++ coord matching the shape type S. Used by crd2idx to support the
// L(tuple<...>) overload from mosaic/layout.hpp for arbitrarily nested coords.
//
// Nesting must match S exactly: if S is a tuple type, the handle must be a
// Python tuple of the same length, each element matching the corresponding
// sub-shape recursively. Scalar-on-tuple-mode coords are NOT supported here —
// use the flat-int eval(i) path on the Python side for that case.
template <class S>
auto from_py(nb::handle h) {
    if constexpr (mosaic::is_tuple_v<S>) {
        if (!nb::isinstance<nb::tuple>(h)) {
            throw nb::value_error(
                "crd2idx: expected a Python tuple at a hierarchical mode "
                "(scalar-on-tuple-mode coords go through eval(i) instead)");
        }
        nb::tuple t = nb::cast<nb::tuple>(h);
        constexpr std::size_t N = std::tuple_size_v<std::remove_cvref_t<S>>;
        if (nb::len(t) != N) {
            throw nb::value_error(
                "crd2idx: coord tuple rank does not match the corresponding "
                "mode of the layout's shape");
        }
        return [&]<std::size_t... I>(std::index_sequence<I...>) {
            return std::make_tuple(
                from_py<std::tuple_element_t<I, std::remove_cvref_t<S>>>(t[I])...);
        }(std::make_index_sequence<N>{});
    } else {
        return static_cast<std::size_t>(nb::cast<std::size_t>(h));
    }
}

// make_L — build the typed layout from flat shape/stride leaf vectors. The
// structure is fixed by L_t at compile time; only the values come from
// Python. Cheap (a handful of size_t copies), so we rebuild per call rather
// than registering a nanobind class — that keeps the module purely
// free-function based and avoids nanobind's process-global type registry,
// which otherwise collides when the test harness reloads a freshly-compiled
// .so of the same structure into one process ("type already registered").
inline L_t make_L(const std::vector<std::size_t>& shape, const std::vector<std::size_t>& stride) {
    constexpr std::size_t n_shape = count_leaves<S_t>();
    constexpr std::size_t n_stride = count_leaves<D_t>();
    if (shape.size() != n_shape) {
        throw nb::value_error("shape leaf count does not match this module's structure");
    }
    if (stride.size() != n_stride) {
        throw nb::value_error("stride leaf count does not match this module's structure");
    }
    S_t s{};
    D_t d{};
    const std::size_t* sp = shape.data();
    const std::size_t* dp = stride.data();
    fill_from_flat(s, sp);
    fill_from_flat(d, dp);
    return L_t{s, d};
}

// coalesce_flat — runtime coalesce on already-flattened leaf vectors.
//
// Mirrors the *runtime* path of mosaic::coalesce (algebra.hpp): walk the
// flat (shape, stride) leaves left-to-right and greedily merge an adjacent
// pair (s_prev, d_prev), (s, d) whenever  s_prev * d_prev == d, folding it
// into (s_prev * s, d_prev). This is exactly the left-fold the compile-time
// header performs for flat ranks 2-4 — but as a loop it has no rank ceiling,
// so it also coalesces the flat-rank > 4 layouts the header leaves merged-
// but-uncoalesced.
//
// Deliberately does NOT special-case size-1 modes: for runtime size_t leaves
// the header's static size-1 absorption (is_constant_v<1, ...>) never fires,
// so dropping them here would diverge from the C++ ground truth.
//
// Structure-agnostic (operates on the runtime vectors, not L_t), so this is
// identical in every generated module. Result is always a flat layout.
inline std::pair<std::vector<std::size_t>, std::vector<std::size_t>> coalesce_flat(
    const std::vector<std::size_t>& shape, const std::vector<std::size_t>& stride) {
    std::vector<std::size_t> rs, rd;
    const std::size_t n = shape.size();
    rs.reserve(n);
    rd.reserve(n);
    for (std::size_t k = 0; k < n; ++k) {
        const std::size_t s = shape[k];
        const std::size_t d = stride[k];
        if (!rs.empty() && rs.back() * rd.back() == d) {
            rs.back() *= s;  // merge: shape grows, inner stride (rd.back()) kept
        } else {
            rs.push_back(s);
            rd.push_back(d);
        }
    }
    return {rs, rd};
}

}  // namespace mosaic_jit_detail

// === nanobind module ====================================================
// Module name MUST match the filename stem so importlib + dlopen agree.
// _jit.py spells the module name as mosaic_jit_<key>; we honour that here.
NB_MODULE(mosaic_jit_$key, m) {
    m.doc() =
        "mosaic JIT-compiled layout module (dynamic route, key=$key). "
        "Keyed on layout structure; shape/stride values are runtime, passed "
        "to each function as flat leaf vectors. See python_repr.txt for a "
        "representative originating call.";

    using mosaic_jit_detail::make_L;
    using vec = std::vector<std::size_t>;

    m.def(
        "size",
        [](const vec& sh, const vec& st) {
            return static_cast<std::size_t>(make_L(sh, st).size());
        },
        "shape"_a, "stride"_a, "Total number of elements in the layout's domain (== len(L)).");

    m.def(
        "cosize",
        [](const vec& sh, const vec& st) {
            return static_cast<std::size_t>(mosaic::cosize(make_L(sh, st)));
        },
        "shape"_a, "stride"_a, "Codomain size: maximum offset + 1 (assumes positive strides).");

    m.def(
        "rank", [] { return static_cast<int>(L_t::rank); },
        "Top-level mode count (fixed by structure).");

    m.def(
        "eval",
        [](std::size_t i, const vec& sh, const vec& st) {
            return static_cast<std::size_t>(make_L(sh, st)(i));
        },
        "i"_a, "shape"_a, "stride"_a, "Evaluate the layout at a flat (linearised) coordinate.");

    m.def(
        "eval_coord",
        [](const vec& coords, const vec& sh, const vec& st) -> std::size_t {
            if constexpr (L_t::rank == 0) {
                throw nb::value_error("eval_coord: rank-0 layout has no coordinates");
            } else {
                if (coords.size() != static_cast<std::size_t>(L_t::rank)) {
                    throw nb::value_error(
                        "eval_coord: number of coordinates does not match layout rank");
                }
                auto L = make_L(sh, st);
                return [&]<std::size_t... I>(std::index_sequence<I...>) {
                    return static_cast<std::size_t>(L(coords[I]...));
                }(std::make_index_sequence<static_cast<std::size_t>(L_t::rank)>{});
            }
        },
        "coords"_a, "shape"_a, "stride"_a,
        "Evaluate the layout at a top-level coordinate (one int per mode).");

    m.def(
        "enumerate",
        [](const vec& sh, const vec& st) {
            auto L = make_L(sh, st);
            const std::size_t n = static_cast<std::size_t>(L.size());
            vec out;
            out.reserve(n);
            for (std::size_t i = 0; i < n; ++i) {
                out.push_back(static_cast<std::size_t>(L(i)));
            }
            return out;
        },
        "shape"_a, "stride"_a,
        "Eagerly return all offsets [L(0), L(1), ..., L(size-1)] as a list.");

    m.def(
        "repr",
        [](const vec& sh, const vec& st) {
            std::ostringstream ss;
            ss << make_L(sh, st);
            return ss.str();
        },
        "shape"_a, "stride"_a, "C++-style compact representation: \"(shape):(stride)\".");

    m.def(
        "idx2crd",
        [](std::size_t i, const vec& sh, const vec& st) {
            return mosaic_jit_detail::to_py(mosaic::idx2crd(i, make_L(sh, st)));
        },
        "i"_a, "shape"_a, "stride"_a,
        "Convert a flat index in [0, size(L)) to a coordinate matching "
        "L.shape's nesting profile (column-major convention). Returns a "
        "(possibly nested) Python tuple of ints.");

    m.def(
        "crd2idx",
        [](nb::object coord, const vec& sh, const vec& st) {
            auto L = make_L(sh, st);
            auto typed = mosaic_jit_detail::from_py<S_t>(coord);
            return static_cast<std::size_t>(L(typed));
        },
        "coord"_a, "shape"_a, "stride"_a,
        "Evaluate the layout at a Python coord tuple matching L.shape's "
        "nesting. Strict: nesting must match exactly.");

    m.def(
        "coalesce",
        [](const vec& sh, const vec& st) { return mosaic_jit_detail::coalesce_flat(sh, st); },
        "shape"_a, "stride"_a,
        "Coalesce the (already-flattened) layout: greedily merge adjacent "
        "modes where prev_shape*prev_stride == stride. Returns the flat "
        "(shape, stride) leaf vectors of the minimal-rank equivalent. "
        "Mirrors mosaic::coalesce's runtime path (no size-1 special case).");
}
