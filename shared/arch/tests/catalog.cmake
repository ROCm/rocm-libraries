cmake_minimum_required(VERSION 3.25.2)
include("${CATALOG}")
include("${FUNCTIONS}")
rocm_arch_list(processors KIND PROCESSOR)
rocm_arch_list(generics KIND GENERIC)
if(NOT "gfx1250-strict" IN_LIST processors OR NOT "gfx1250" IN_LIST processors)
    message(FATAL_ERROR "Missing distinct stepping identity")
endif()
if("gfx11-generic" IN_LIST processors OR NOT "gfx11-generic" IN_LIST generics)
    message(FATAL_ERROR "Processor and generic lists must be separate")
endif()
foreach(name gfx942 gfx1250-strict gfx11-generic)
    rocm_arch_is_known(known ID "${name}")
    if(NOT known)
        message(FATAL_ERROR "Missing identity: ${name}")
    endif()
endforeach()
foreach(name gfx94 gfx942:xnack+ GFX942 all)
    rocm_arch_is_known(known ID "${name}")
    if(known)
        message(FATAL_ERROR "Accepted non-identity: ${name}")
    endif()
endforeach()
