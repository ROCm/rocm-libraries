# Queries must also work in the parent directory of an add_subdirectory consumer.
set_property(GLOBAL PROPERTY ROCM_ARCH_PROCESSORS "${_ROCM_ARCH_PROCESSORS}")
set_property(GLOBAL PROPERTY ROCM_ARCH_GENERICS "${_ROCM_ARCH_GENERICS}")

set_property(GLOBAL PROPERTY ROCM_ARCH_PROCESSORS_BY_RELEASE "${_ROCM_ARCH_PROCESSORS_BY_RELEASE}")
foreach(_arch_release IN LISTS _ROCM_ARCH_RELEASE_YEARS)
    string(REPLACE "=" ";" _arch_release_parts "${_arch_release}")
    list(GET _arch_release_parts 0 _arch_name)
    list(GET _arch_release_parts 1 _arch_year)
    set_property(GLOBAL PROPERTY "ROCM_ARCH_RELEASE_YEAR_${_arch_name}" "${_arch_year}")
endforeach()
unset(_arch_release)
unset(_arch_release_parts)
unset(_arch_name)
unset(_arch_year)

# Return sorted registered names to output; KIND defaults to PROCESSOR.
function(rocm_arch_list output)
    cmake_parse_arguments(PARSE_ARGV 1 ARG "" "KIND;MIN_YEAR;MAX_YEAR;ORDER" "")
    if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "rocm_arch_list: expected KIND, MIN_YEAR, MAX_YEAR, or ORDER")
    endif()
    if(NOT DEFINED ARG_KIND OR ARG_KIND STREQUAL "PROCESSOR")
        get_property(names GLOBAL PROPERTY ROCM_ARCH_PROCESSORS)
    elseif(ARG_KIND STREQUAL "GENERIC")
        get_property(names GLOBAL PROPERTY ROCM_ARCH_GENERICS)
    else()
        message(FATAL_ERROR "rocm_arch_list: unknown kind ${ARG_KIND}")
    endif()
    if(DEFINED ARG_ORDER AND NOT ARG_ORDER STREQUAL "NAME" AND NOT ARG_ORDER STREQUAL "RELEASE")
        message(FATAL_ERROR "rocm_arch_list: ORDER must be NAME or RELEASE")
    endif()
    if(ARG_ORDER STREQUAL "RELEASE" AND NOT ARG_KIND STREQUAL "GENERIC")
        get_property(names GLOBAL PROPERTY ROCM_ARCH_PROCESSORS_BY_RELEASE)
    endif()
    foreach(_bound MIN_YEAR MAX_YEAR)
        if(DEFINED ARG_${_bound})
            if(NOT ARG_${_bound} MATCHES "^[0-9][0-9][0-9][0-9]$" OR ARG_${_bound} LESS 1900)
                message(FATAL_ERROR "rocm_arch_list: ${_bound} must be a year from 1900 to 9999")
            endif()
        endif()
    endforeach()
    if(DEFINED ARG_MIN_YEAR OR DEFINED ARG_MAX_YEAR)
        if(ARG_KIND STREQUAL "GENERIC")
            message(FATAL_ERROR "rocm_arch_list: release years apply to PROCESSOR targets")
        endif()
        if(DEFINED ARG_MIN_YEAR AND DEFINED ARG_MAX_YEAR AND ARG_MIN_YEAR GREATER ARG_MAX_YEAR)
            message(FATAL_ERROR "rocm_arch_list: minimum release year exceeds maximum")
        endif()
        set(filtered "")
        foreach(name IN LISTS names)
            get_property(year GLOBAL PROPERTY "ROCM_ARCH_RELEASE_YEAR_${name}")
            if(year AND (NOT DEFINED ARG_MIN_YEAR OR year GREATER_EQUAL ARG_MIN_YEAR)
                    AND (NOT DEFINED ARG_MAX_YEAR OR year LESS_EQUAL ARG_MAX_YEAR))
                list(APPEND filtered "${name}")
            endif()
        endforeach()
        set(names "${filtered}")
    endif()
    set(${output} "${names}" PARENT_SCOPE)
endfunction()

# Return whether ID exactly matches a registered processor or generic target.
function(rocm_arch_is_known output)
    cmake_parse_arguments(PARSE_ARGV 1 ARG "" "ID" "")
    if(NOT DEFINED ARG_ID OR ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "rocm_arch_is_known: expected ID <target-name>")
    endif()
    get_property(processors GLOBAL PROPERTY ROCM_ARCH_PROCESSORS)
    get_property(generics GLOBAL PROPERTY ROCM_ARCH_GENERICS)
    if(ARG_ID IN_LIST processors OR ARG_ID IN_LIST generics)
        set(${output} TRUE PARENT_SCOPE)
    else()
        set(${output} FALSE PARENT_SCOPE)
    endif()
endfunction()
